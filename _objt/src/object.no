# /_objt/src/util
# /_objt/src/zlib
# /_objt/src/oid

tree-entry {
    mode i64
    name str
    id oid
}

person-info {
    name str
    email str
    time i64
    tz str
}

commit-info {
    tree-oid oid
    parents []oid
    author person-info
    committer person-info
    message str
}

tag-info {
    object oid
    obj-type str
    tag str
    tagger person-info
    message str
}

i64-to-octal = (n i64) (out str) {
    n == 0 -> {
        out = '0'
        return
    }
    tmp []byte = with-cap(16)
    x = n
    {
        tmp.push(48 + (x % 8))
        x = x / 8
        x == 0 -> break
    } ()
    L = tmp.len
    out = with-len(L)
    i <- [0..L): {
        out[i] = tmp[L - 1 - i]
    }
}

octal-to-i64 = (s str) (out i64) {
    out = 0
    i <- [0..s.len): {
        out = out * 8 + (s[i] - 48)
    }
}

mode-is-dir = (m i64) (yes bool) {
    yes = m == 16384
}

cmp-entry = (a tree-entry, b tree-entry) (r i64) {
    n1 = a.name
    n2 = b.name
    l1 = n1.len
    l2 = n2.len
    len = l1
    l2 < len -> len = l2
    r = 0
    i = 0
    {
        c1 = n1[i]
        c2 = n2[i]
        c1 < c2 -> { r = -1  return }
        c1 > c2 -> { r = 1  return }
        i = i + 1
    } (i < len)
    c1 = 0
    c2 = 0
    l1 > len -> c1 = n1[len]
    l2 > len -> c2 = n2[len]
    c1 == 0 && mode-is-dir(a.mode) -> c1 = 47
    c2 == 0 && mode-is-dir(b.mode) -> c2 = 47
    c1 < c2 -> r = -1
    c1 > c2 -> r = 1
}

tree-sort = (entries []tree-entry) (out []tree-entry) {
    out = with-cap(entries.len)
    i <- [0..entries.len): {
        e = entries[i]
        pos = out.len
        j <- [0..out.len): {
            cmp-entry(e, out[j]) < 0 -> { pos = j  break }
        }
        out.push(out[out.len - 1])
        k = out.len - 1
        {
            k > pos -> { out[k] = out[k - 1]  k = k - 1 }
        } (k > pos)
        out[pos] = e
    }
}

tree-encode = (entries []tree-entry) (out []byte) {
    sorted = tree-sort(entries)
    out = with-cap(256)
    i <- [0..sorted.len): {
        e = sorted[i]
        ms = i64-to-octal(e.mode)
        j <- [0..ms.len): { out.push(ms[j]) }
        out.push(32)
        nb = e.name.to-bytes()
        j <- [0..nb.len): { out.push(nb[j]) }
        out.push(0)
        k <- [0..20): { out.push(e.id.id[k]) }
    }
}

tree-decode = (data []byte) (entries []tree-entry, ok bool) {
    entries = with-cap(64)
    pos = 0
    {
        pos >= data.len -> break
        ms = with-cap(8)
        {
            data[pos] != 32 -> { ms.push(data[pos])  pos = pos + 1 }
        } (pos < data.len)
        pos = pos + 1
        ns = with-cap(64)
        {
            data[pos] != 0 -> { ns.push(data[pos])  pos = pos + 1 }
        } (pos < data.len)
        pos = pos + 1
        o oid
        k <- [0..20): { o.id[k] = data[pos + k] }
        pos = pos + 20
        e tree-entry
        ms2 str = util.bytes-to-str(ms)
        e.mode = octal-to-i64(ms2)
        ns2 str = util.bytes-to-str(ns)
        e.name = ns2
        e.id = o
        entries.push(e)
    } (true)
    ok = true
}
