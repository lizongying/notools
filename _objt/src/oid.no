// oid — Git object identifiers (SHA-1) and object hashing
//
// A Git object id is the SHA-1 (20 bytes) of the bytes:
//   "<type> <size>\0<payload>"
// We model it as a struct wrapping [20]byte so we can attach methods and keep
// it distinct from a plain byte array.

// oid: a 20-byte Git object identifier
oid {
    id [20]byte
}

// oid.to-hex: render the object id as a 40-character lowercase hex string
// returns out str: hex digest
oid.to-hex = () (out str) {
    out = with-len(40)
    hex-chars = '0123456789abcdef'
    i <- [0..20): {
        b = .id[i]
        out[i * 2] = hex-chars[(b >> 4) & 15]
        out[i * 2 + 1] = hex-chars[b & 15]
    }
}

// oid.eq: byte-wise equality with another oid
// o oid: the other id
// returns yes bool
oid.eq = (o oid) (yes bool) {
    yes = true
    i <- [0..20): {
        .id[i] != o.id[i] -> {
            yes = false
            return
        }
    }
}

// oid.is-zero: true when the id is all zeros (unused / unknown)
// returns yes bool
oid.is-zero = () (yes bool) {
    yes = true
    i <- [0..20): {
        .id[i] != 0 -> {
            yes = false
            return
        }
    }
}

// oid-from-hex: parse a 40-char hex string into an oid
// s str: hex digest
// returns o oid, ok bool: the id, ok=false if not exactly 40 valid hex chars
oid-from-hex = (s str) (o oid, ok bool) {
    s.len != 40 -> return
    i <- [0..20): {
        hi = util.hexdigit(s[i * 2])
        lo = util.hexdigit(s[i * 2 + 1])
        hi < 0 || lo < 0 -> return
        o.id[i] = (hi << 4) | lo
    }
    ok = true
}

// object-header: build the "<type> <size>\0" header bytes for an object
// kind str: one of blob/tree/commit/tag
// size i64: payload byte length
// returns out []byte: header bytes (no payload appended)
object-header = (kind str, size i64) (out []byte) {
    kb = kind.to-bytes()
    sb = util.i64-to-str(size).to-bytes()
    out = with-cap(kb.len + 1 + sb.len + 1)
    i <- [0..kb.len): {
        out.push(kb[i])
    }
    out.push(32)
    i <- [0..sb.len): {
        out.push(sb[i])
    }
    out.push(0)
}

// hash-object: compute the object id of (kind, data)
// kind str: object type
// data []byte: payload
// returns o oid: SHA-1 of header + payload
hash-object = (kind str, data []byte) (o oid) {
    hdr = object-header(kind, data.len)
    buf []byte = with-cap(hdr.len + data.len)
    i <- [0..hdr.len): {
        buf.push(hdr[i])
    }
    i <- [0..data.len): {
        buf.push(data[i])
    }
    h = sha1.sha1(buf)
    i <- [0..20): {
        o.id[i] = h[i]
    }
}

// empty-tree-oid: the well-known id of the empty tree object
// returns o oid
empty-tree-oid = () (o oid) {
    o = hash-object('tree', [])
}

