; nosync 的标量模型。容器与路径列表保持分离，避免含 slice 结构体按值拷贝。

KIND-FILE = 1
KIND-DIR = 2
KIND-LINK = 3
KIND-OTHER = 4

ACTION-NONE = 0
ACTION-CREATE-DIR = 1
ACTION-COPY-FILE = 2
ACTION-UPDATE-FILE = 3
ACTION-METADATA = 4
ACTION-CREATE-LINK = 5
ACTION-UPDATE-LINK = 6
ACTION-DELETE-FILE = 7
ACTION-DELETE-LINK = 8
ACTION-DELETE-DIR = 9
ACTION-RESTORE-DIR = 10

FLAG-PROTECTED = 1
FLAG-ROOT = 2
FLAG-DELETE = 4
FLAG-METADATA = 8

options {
    recursive bool
    links bool
    perms bool
    times bool
    group bool
    owner bool
    dry-run bool
    verbose bool
    delete bool
    checksum bool
    whole-file bool
    stats bool
    help bool
    version bool
    block-size i64
    memory-limit i64
    src str
    dst str
    code i64
    message str
}

stat-info {
    kind i64
    size i64
    mtime i64
    mode i64
    uid i64
    gid i64
    flags i64
    link-directory bool
}

manifest-entry {
    path-index i64
    parent-index i64
    kind i64
    size i64
    mtime i64
    mode i64
    uid i64
    gid i64
    depth i64
    source-index i64
    flags i64
    link-directory bool
}

action {
    kind i64
    path-index i64
    source-index i64
    destination-index i64
    depth i64
}

signature-entry {
    weak u32
    offset i64
    length i64
    next i64
    strong [32]byte
}

signature-data {
    weak []u32
    strong []byte
    offsets []i64
    lengths []i64
    next []i64
    buckets []i64
    count i64
    capacity i64
    block-size i64
    fallback-reason i64
    memory-cost i64
    target-digest [32]byte
    source-digest [32]byte
}

sync-stats {
    files i64
    source-bytes i64
    target-bytes i64
    literal-bytes i64
    reused-bytes i64
    matched-blocks i64
    weak-hits i64
    false-alarms i64
    fallbacks i64
    fallback-missing i64
    fallback-small i64
    fallback-memory i64
    fallback-low-reuse i64
    fallback-io i64
    created i64
    updated i64
    deleted i64
    metadata-only i64
}

run-state {
    src-paths []str
    dst-paths []str
    src-entries []manifest-entry
    dst-entries []manifest-entry
    src-links []str
    dst-links []str
    scratch-names []str
    scratch-rel str
    scratch-mapped str
    scratch-link-target str
    scratch-source-link str
    scratch-destination-link str
    scratch-source-path str
    scratch-destination-path str
    scratch-canonical str
    scratch-resolved str
    src-table []i64
    dst-table []i64
    src-hash-cap i64
    dst-hash-cap i64
    actions []action
    action-paths []str
    src-root str
    dst-root str
    src-real str
    dst-real str
    source-directory bool
    content-mode bool
    destination-directory bool
    completed-actions i64
    memory-used i64
    error-stage str
    error-path str
    error-message str
}

STATE = run-state{}
STATS = sync-stats{}
SIGNATURE = signature-data{}

reset-state = () {
    STATE.src-paths = []
    STATE.dst-paths = []
    STATE.src-entries = []
    STATE.dst-entries = []
    STATE.src-links = []
    STATE.dst-links = []
    STATE.scratch-names = []
    STATE.scratch-rel = ''
    STATE.scratch-mapped = ''
    STATE.scratch-link-target = ''
    STATE.scratch-source-link = ''
    STATE.scratch-destination-link = ''
    STATE.scratch-source-path = ''
    STATE.scratch-destination-path = ''
    STATE.scratch-canonical = ''
    STATE.scratch-resolved = ''
    STATE.src-table = []
    STATE.dst-table = []
    STATE.actions = []
    STATE.action-paths = []
    STATE.src-root = ''
    STATE.dst-root = ''
    STATE.src-real = ''
    STATE.dst-real = ''
    STATE.source-directory = false
    STATE.content-mode = false
    STATE.destination-directory = false
    STATE.completed-actions = 0
    STATE.memory-used = 0
    STATE.src-hash-cap = 0
    STATE.dst-hash-cap = 0
    STATE.error-stage = ''
    STATE.error-path = ''
    STATE.error-message = ''
    STATS.files = 0
    STATS.source-bytes = 0
    STATS.target-bytes = 0
    STATS.literal-bytes = 0
    STATS.reused-bytes = 0
    STATS.matched-blocks = 0
    STATS.weak-hits = 0
    STATS.false-alarms = 0
    STATS.fallbacks = 0
    STATS.fallback-missing = 0
    STATS.fallback-small = 0
    STATS.fallback-memory = 0
    STATS.fallback-low-reuse = 0
    STATS.fallback-io = 0
    STATS.created = 0
    STATS.updated = 0
    STATS.deleted = 0
    STATS.metadata-only = 0
    SIGNATURE.weak = []
    SIGNATURE.strong = []
    SIGNATURE.offsets = []
    SIGNATURE.lengths = []
    SIGNATURE.next = []
    SIGNATURE.buckets = []
    SIGNATURE.count = 0
    SIGNATURE.capacity = 0
    SIGNATURE.block-size = 0
    SIGNATURE.fallback-reason = 0
    SIGNATURE.memory-cost = 0
}
