}

#{win-amd64, win-arm64}
platform-read-link = (path str) (target str, ok bool) {
    target, _, ok = windows-read-link(path)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-create-link = (target str, path str, directory bool) (ok bool) {
    ok = posix-create-link(target, path)
}

#{win-amd64, win-arm64}
platform-create-link = (target str, path str, directory bool) (ok bool) {
    ok = windows-create-link(target, path, directory)
}

