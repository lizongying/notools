; 平台选择层：目标平台只保留对应实现的调用链。

# /nosync/src/model
# /nosync/src/platform-posix
# /nosync/src/platform-windows

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-normalize-cli-path = (path str) (normalized str) {
    normalized = path
}

#{win-amd64, win-arm64}
platform-normalize-cli-path = (path str) (normalized str) {
    normalized = path.replace-str('\\', '/')
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-valid-cli-path = (path str) (ok bool) {
    ! path.starts-with('\\\\') && ! path.contains(':') -> ok = true
}

#{win-amd64, win-arm64}
platform-valid-cli-path = (path str) (ok bool) {
    path.starts-with('\\\\') -> return
    colon = path.rindex(':')
    colon < 0 -> {
        ok = true
        return
    }
    colon != 1 || path.len-bytes() < 3 -> return
    first = path.byte(0)
    separator = path.byte(2)
    first: {
        ok -> {
            it >= 65 && it <= 90 -> {
                separator: {
                    ok -> ok = it == 47 || it == 92

                    -> return
                }
            }

            it >= 97 && it <= 122 -> {
                separator: {
                    ok -> ok = it == 47 || it == 92

                    -> return
                }
            }

            -> return
        }

        -> return
    }
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-supported = () (ok bool) {
    ok = true
}

#{win-amd64, win-arm64}
platform-supported = () (ok bool) {
    ok = windows-supported()
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-error = (stage str, path str) (message str) {
    message = posix-error(stage, path)
}

#{win-amd64, win-arm64}
platform-error = (stage str, path str) (message str) {
    message = windows-error(stage, path)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-open = (path str, write bool) (fd i64) {
    fd = posix-open(path, write)
}

#{win-amd64, win-arm64}
platform-open = (path str, write bool) (fd i64) {
    fd = windows-open(path, write)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-read = (fd i64, buf []byte, count i64) (got i64) {
    got = posix-read(fd, buf, count)
}

#{win-amd64, win-arm64}
platform-read = (fd i64, buf []byte, count i64) (got i64) {
    got = windows-read(fd, buf, count)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-write = (fd i64, buf []byte, count i64) (written i64) {
    written = posix-write(fd, buf, count)
}

#{win-amd64, win-arm64}
platform-write = (fd i64, buf []byte, count i64) (written i64) {
    written = windows-write(fd, buf, count)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-close = (fd i64) (ok bool) {
    ok = posix-close(fd)
}

#{win-amd64, win-arm64}
platform-close = (fd i64) (ok bool) {
    ok = windows-close(fd)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-seek = (fd i64, offset i64) (ok bool) {
    ok = posix-seek(fd, offset)
}

#{win-amd64, win-arm64}
platform-seek = (fd i64, offset i64) (ok bool) {
    ok = windows-seek(fd, offset)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-stat = (path str) (info stat-info, ok bool) {
    info, ok = posix-stat(path)
}

#{win-amd64, win-arm64}
platform-stat = (path str) (info stat-info, ok bool) {
    info, ok = windows-stat(path)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-list-dir = (path str) (names []str, ok bool) {
    names, ok = posix-list-dir(path)
}

#{win-amd64, win-arm64}
platform-list-dir = (path str) (names []str, ok bool) {
    names, ok = windows-list-dir(path)
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
platform-mkdir = (path str, mode i64) (ok bool) {
    ok = posix-mkdir(path, mode)
}

#{win-amd64, win-arm64}
platform-mkdir = (path str, mode i64) (ok bool) {
