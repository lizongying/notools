; 标量算术助手：显式消费 option，并区分索引回绕与校验和回绕。

add-index = (a i64, b i64) (result i64) {
    result = a + b: {
        ok -> it

        -> 0
    }
}

sub-index = (a i64, b i64) (result i64) {
    result = a - b: {
        ok -> it

        -> 0
    }
}

mul-index = (a i64, b i64) (result i64) {
    result = a * b: {
        ok -> it

        -> 0
    }
}

div-index = (a i64, b i64) (result i64) {
    b == 0 -> return
    result = a / b: {
        ok -> it

        -> 0
    }
}

wrap-u32 = (value u32) (result u32) {
    result = value
}

byte-to-u32 = (value byte) (result u32) {
    result = value
}

i64-to-u32 = (value i64) (result u32) {
    result = value & 4294967295
}

u32-to-i64 = (value u32) (result i64) {
    result = value
}

to-byte = (value i64) (result byte) {
    encoded = value.to-bytes-le()
    encoded[0]: {
        ok -> result = it

        -> return
    }
}
