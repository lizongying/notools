; 大目录稳定 bottom-up merge sort 回归。
# /nosync/src/sort

sort-check = (condition bool, name str) {
    ! condition -> {
        eprint('FAIL: ' - name)
        exit(1)
    }
}

run-sort-tests = () () {
    names []str = []
    i <- [0..10000): {
        names.push('entry-' - (9999 - i).to-str())
    }
    order = sort-indices(names)
    sort-check(order.len() == names.len(), 'sorted length')
    i <- [0..order.len()): {
        order[i]: {
            ok -> {
                index = it
                sort-check(index >= 0 && index < names.len(), 'permutation range')
                i > 0 -> {
                    previous = sub-index(i, 1)
                    order[previous]: {
                        ok -> {
                            previous-index = it
                            names[previous-index]: {
                                ok -> {
                                    previous-name = it
                                    names[index]: {
                                        ok -> sort-check(previous-name.compare(it) <= 0, 'sorted order')
                                        -> exit(1)
                                    }
                                }
                                -> exit(1)
                            }
                        }
                        -> exit(1)
                    }
                }
            }
            -> exit(1)
        }
    }
}

run-sort-tests()
print('ALL SORT TESTS PASSED')
