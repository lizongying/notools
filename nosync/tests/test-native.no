}

#{win-amd64, win-arm64}
native-test-link-type-update = (source str, destination str, type-target str, opts options) {
    native-check(platform-remove-file(source - '/type-link'), 'remove source directory symlink before type update')
    native-check(platform-create-link(type-target, source - '/type-link', false), 'replace source directory symlink with file symlink')
    native-check(native-run(opts), 'update symlink type with unchanged target text')
    type-info, type-exists = platform-stat(destination - '/type-link')
    native-check(type-exists && type-info.kind == KIND-LINK && ! type-info.link-directory, 'symlink type update replaces directory link with file link')
    native-check(STATS.updated == 1, 'symlink type update counted once')
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
native-test-link-type-update = (source str, destination str, type-target str, opts options) {
}

test-native-links = (root str) {
    native-check(platform-mkdir(root, 448), 'create link case root')
    source = root - '/link-src'
    destination = root - '/link-dst'
    outside = root - '/outside'
    native-check(platform-mkdir(source, 448), 'create link source')
    native-check(platform-mkdir(destination, 448), 'create link destination')
    native-check(platform-mkdir(outside, 448), 'create link outside directory')
    native-check(native-write(outside - '/sentinel', 'outside'), 'write link sentinel')
    file-name = '链接-😀.txt'
    native-check(native-write(join-path(source, file-name), 'linked-content'), 'write Unicode link target')
    native-check(platform-create-link(file-name, source - '/file-link', false), 'create Unicode file symlink')
    native-check(platform-create-link('missing-目标', source - '/broken-link', false), 'create dangling Unicode symlink')
    native-check(platform-create-link('../outside', source - '/dir-link', true), 'create directory symlink')
    type-target = 'missing-type-target'
    native-check(platform-create-link(type-target, source - '/type-link', true), 'create dangling directory symlink')

    opts = native-options(source - '/', destination)
    opts.links = false
    native-check(native-run(opts), 'sync without following source links')
    skipped, skipped-exists = platform-stat(destination - '/file-link')
    native-check(! skipped-exists, 'skipped link creates no destination')
    opts.links = true
    native-check(native-run(opts), 'copy source links themselves')
    target, read = platform-read-link(destination - '/file-link')
    native-check(read && STATE.scratch-link-target.compare(file-name) == 0, 'copy Unicode link target')
    target, read = platform-read-link(destination - '/broken-link')
    native-check(read && STATE.scratch-link-target.compare('missing-目标') == 0, 'copy dangling Unicode link')
    file-info, file-exists = platform-stat(destination - '/file-link')
    native-check(file-exists && file-info.kind == KIND-LINK && ! file-info.link-directory, 'file symlink keeps file type')
    broken-info, broken-exists = platform-stat(destination - '/broken-link')
    native-check(broken-exists && broken-info.kind == KIND-LINK && ! broken-info.link-directory, 'dangling file symlink keeps file type')
    link-info, link-exists = platform-stat(destination - '/dir-link')
    native-check(link-exists && link-info.kind == KIND-LINK, 'directory symlink is not traversed')
    native-check(link-info.link-directory == native-directory-link-expected(), 'directory symlink keeps platform directory type')
    type-info, type-exists = platform-stat(destination - '/type-link')
    native-check(type-exists && type-info.kind == KIND-LINK && type-info.link-directory == native-directory-link-expected(), 'dangling directory symlink keeps platform directory type')
    copied, copied-exists = platform-stat(destination - '/sentinel')
    native-check(! copied-exists, 'directory symlink target is not enumerated into destination')
    native-check(native-content-equal(outside - '/sentinel', outside - '/sentinel'), 'outside link sentinel remains intact')

    native-test-link-type-update(source, destination, type-target, opts)

    native-check(platform-remove-file(source - '/dir-link'), 'remove source directory symlink before delete')
    opts.delete = true
    native-check(native-run(opts), 'delete stale directory symlink')
    deleted-link, deleted-link-exists = platform-stat(destination - '/dir-link')
    native-check(! deleted-link-exists, 'directory symlink itself is deleted')
    outside-info, outside-exists = platform-stat(outside)
    native-check(outside-exists && outside-info.kind == KIND-DIR, 'directory symlink target directory is preserved')
    native-check(native-content-equal(outside - '/sentinel', outside - '/sentinel'), 'directory symlink target content is preserved')
    native-check(STATS.deleted == 1, 'directory symlink deletion counted once')
}

#{win-amd64, win-arm64}
test-native-case-insensitive = (root str) {
    native-check(platform-mkdir(root, 448), 'create case-insensitive case root')
    source = root - '/case-src'
    destination = root - '/case-dst'
    native-check(platform-mkdir(source, 448), 'create case source')
    native-check(platform-mkdir(destination, 448), 'create case destination')
    native-check(native-write(join-path(source, 'Case-Ä.txt'), 'new-case-content'), 'write mixed-case Unicode source')
    native-check(native-write(join-path(destination, 'case-ä.txt'), 'old'), 'write case-variant Unicode destination')
    opts = native-options(source - '/', destination)
    opts.delete = true
    native-check(native-run(opts), 'match Unicode paths case-insensitively')
    native-check(native-content-equal(source - '/Case-Ä.txt', destination - '/case-ä.txt'), 'case-variant destination updated in place')
    native-check(STATS.updated == 1 && STATS.deleted == 0, 'case-variant destination is not deleted')

    reset-state()
    opts.src = source
    opts.dst = root - '/CASE-SRC'
    ok = preflight(opts)
    native-check(! ok && STATE.error-message.compare('source and destination overlap') == 0, 'case-insensitive overlap rejected')
}

#{mac-amd64, mac-arm64, linux-amd64, linux-arm64}
test-native-case-insensitive = (root str) {
}

run-native-tests = () {
    eprint('MARK: run-native-tests start')
    ensure-test-tmp()
    eprint('MARK: temp ready')
    run-checksum-tests()
    eprint('MARK: checksum done')
    run-cli-tests()
    eprint('MARK: cli done')
    run-delta-tests()
    eprint('MARK: delta done')
    run-file-io-tests()
    eprint('MARK: file-io done')
    run-sort-tests()
    eprint('MARK: sort done')
    root = 'tmp/nosync-native-' - os.get-pid().to-str()
    native-cleanup(root)
    eprint('MARK: cleanup done')
    native-check(platform-mkdir(root, 448), 'create native test root')
    eprint('MARK: root created')
    test-native-unicode(root - '/unicode')
    eprint('MARK: unicode done')
    test-native-long-path(root - '/long')
    eprint('MARK: long done')
    test-native-links(root - '/links')
    eprint('MARK: links done')
    test-native-case-insensitive(root - '/case')
    eprint('MARK: case done')
    native-cleanup(root)
    eprint('MARK: final cleanup done')
}

run-native-tests()
print('ALL NATIVE TESTS PASSED')
