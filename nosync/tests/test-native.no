native-check = (condition bool, name str) {
    ! condition -> {
        eprint('FAIL: ' - name)
        exit(1)
    }
}

ensure-test-tmp = () {
    info, exists = platform-stat('tmp')
    exists && info.kind == KIND-DIR -> return
    created = platform-mkdir('tmp', 448)
    native-check(created, 'create test tmp directory')
}

native-options = (source str, destination str) (opts options) {
    opts.recursive = true
    opts.links = true
    opts.perms = true
    opts.times = true
    opts.owner = true
    opts.group = true
    opts.block-size = 4096
    opts.memory-limit = 16777216
    opts.src = source
    opts.dst = destination
}

native-write = (path str, text str) (ok bool) {
    data = text.to-bytes()
    fd = platform-open(path, true)
    fd < 0 -> return
    written, complete = write-all(fd, data, data.len())
    closed = platform-close(fd)
    ok = complete && closed && written == data.len()
}

native-cleanup = (path str) {
    info, exists = platform-stat(path)
    ! exists -> return
    info.kind != KIND-DIR -> {
        platform-remove-file(path)
        return
    }
    names, listed = platform-list-dir(path)
    listed -> {
        name <- names: {
            ! valid-relative-path(name) -> return
            native-cleanup(join-path(path, name))
        }
    }
    platform-remove-dir(path)
}

native-content-equal = (a str, b str) (same bool) {
    a-info, a-exists = platform-stat(a)
    b-info, b-exists = platform-stat(b)
    ! a-exists || ! b-exists || a-info.kind != KIND-FILE || b-info.kind != KIND-FILE -> return
    a-info.size != b-info.size -> return
    a-digest, a-ok = file-digest(a, a-info.size)
    b-digest, b-ok = file-digest(b, b-info.size)
    same = a-ok && b-ok && checksum.sha256-equal(a-digest, b-digest)
}

native-run = (opts options) (ok bool) {
    code = run-sync(opts, [])
    code != 0 -> eprint('native sync: ' - STATE.error-stage - ' ' - STATE.error-path - ' ' - STATE.error-message)
    ok = code == 0
}

test-native-unicode = (root str) {
    native-check(platform-mkdir(root, 448), 'create Unicode case root')
    source = root - '/源 目录'
    destination = root - '/目标 目录'
    native-check(platform-mkdir(source, 448), 'create Unicode source')
    native-check(platform-mkdir(destination, 448), 'create Unicode destination')
    source-file = source - '/文件-😀.txt'
    destination-file = destination - '/文件-😀.txt'
    native-check(native-write(source-file, '新内容-😀'), 'write Unicode source')
    native-check(native-write(destination-file, 'old'), 'write Unicode destination')
    native-check(platform-set-time(source-file, 1700000123), 'set Unicode source mtime')
    opts = native-options(source - '/', destination)
    native-check(native-run(opts), 'sync Unicode file')
    native-check(native-content-equal(source-file, destination-file), 'Unicode replacement content')
    target-info, target-exists = platform-stat(destination-file)
    native-check(target-exists && target-info.mtime == 1700000123, 'Unicode replacement mtime')

    opts.dry-run = true
    opts.checksum = true
    opts.delete = true
    stale = destination - '/stale'
    native-check(native-write(stale, 'keep during dry-run'), 'write native dry-run stale file')
    native-check(native-write(source-file, 'dry-run source'), 'change native dry-run source')
    before, before-exists = platform-stat(destination-file)
    expected = root - '/expected-content'
    native-check(native-write(expected, '新内容-😀'), 'save native dry-run expected content')
    native-check(native-run(opts), 'native dry-run')
    after, after-exists = platform-stat(destination-file)
    native-check(before-exists && after-exists && before.size == after.size && before.mtime == after.mtime, 'native dry-run metadata unchanged')
    native-check(native-content-equal(expected, destination-file), 'native dry-run content unchanged')
    stale-info, stale-exists = platform-stat(stale)
    native-check(stale-exists, 'native dry-run preserves deletion candidate')
}

test-native-long-path = (root str) {
    native-check(platform-mkdir(root, 448), 'create long-path case root')
    source = root - '/long-src'
    destination = root - '/long-dst'
    native-check(platform-mkdir(source, 448), 'create long-path source')
    native-check(platform-mkdir(destination, 448), 'create long-path destination')
    source-current = source
    destination-current = destination
    i <- [0..24): {
        component = 'segment-' - i.to-str() - '-abcdefghij'
        source-current = join-path(source-current, component)
        destination-current = join-path(destination-current, component)
        native-check(platform-mkdir(source-current, 448), 'create deep source component')
        native-check(platform-mkdir(destination-current, 448), 'create deep destination component')
    }
    native-check(source-current.len-bytes() > 260, 'test path exceeds legacy Windows MAX_PATH')
    source-file = join-path(source-current, '深层-😀.bin')
    destination-file = join-path(destination-current, '深层-😀.bin')
    native-check(native-write(source-file, 'long-path-new-content'), 'write deep Unicode source')
    native-check(native-write(destination-file, 'old'), 'write deep Unicode destination')
    opts = native-options(source-file, destination-file)
    native-check(native-run(opts), 'replace deep Unicode file')
    native-check(native-content-equal(source-file, destination-file), 'deep Unicode replacement content')
    native-check(platform-set-time(source-file, 1700000456), 'set deep source mtime')
    native-check(native-run(opts), 'apply deep source metadata')
    target-info, target-exists = platform-stat(destination-file)
    native-check(target-exists && target-info.mtime == 1700000456, 'deep Unicode mtime preserved')
}

