; nosync 统一回归入口。

# /nosync/tests/test-checksum
# /nosync/tests/test-cli
# /nosync/tests/test-delta
# /nosync/tests/test-e2e
# /nosync/tests/test-file-io
# /nosync/tests/test-plan
# /nosync/tests/test-sort
# /nosync/src/model
# /nosync/src/platform

ensure-test-tmp = () {
    info, exists = platform-stat('tmp')
    exists && info.kind == KIND-DIR -> return
    created = platform-mkdir('tmp', 448)
    ! created -> {
        eprint('FAIL: create test tmp directory')
        exit(1)
    }
}

ensure-test-tmp()
run-checksum-tests()
run-cli-tests()
run-delta-tests()
run-e2e-tests()
run-file-io-tests()
run-plan-tests()
run-sort-tests()
print('ALL TESTS PASSED')
