; nosync — 本地 rsync 风格增量同步 CLI。

# /nosync/src/cli
# /nosync/src/sync

VERSION = 'dev'

; str.pretty: v0.4.34 routes print/eprint arguments and bare format fields
; through .pretty(), which single-quotes str values. nosync emits raw Unix
; output where that quoting breaks the contract, so override the std method
; once here to keep print writing plain text. Spec-based fmt-* fields bypass
; pretty and are unaffected.
str.pretty = () (out str) {
    {
        out = .
    }
}

args = os.args()
opts, rules = parse-cli(args)
opts.code != 0 -> {
    eprint(opts.message)
    exit(opts.code)
}
opts.help -> {
    io.out(HELP-TEXT)
    io.out('\n')
}
opts.version -> {
    io.out('nosync ' - VERSION)
    io.out('\n')
}
! opts.help && ! opts.version -> {
    code = run-sync(opts, rules)
    code != 0 -> exit(code)
}
