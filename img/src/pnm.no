; pnm.no — PPM/PGM (Netpbm) format read/write
; Supports:
;   P5 — binary PGM (grayscale, 8-bit)
;   P6 — binary PPM (RGB, 8-bit)
;   P2 — ASCII PGM (grayscale)
;   P3 — ASCII PPM (RGB)
;
; Usage as module:
;   img = pnm.load(path)      ; returns ?image
;   pnm.save(path, img)        ; saves as P6/P5

; pnm.load: load a PNM file
; path str: file path
; returns img ?image: loaded image, nil on error

# /img/src/image.new
# /img/src/image.new-from-data
# /img/src/image.copy
# /img/src/image.fill
# /img/src/image.invert
# /img/src/image.add-const
# /img/src/image.avg
# /img/src/image.min-val
# /img/src/image.max-val
# /img/src/image.get-pixel
# /img/src/image.set-pixel

load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len == 0 -> {
        img = nil
        return
    }

    ; parse magic number — PNM files start with 'P' followed by a digit
    ; Skip the 'P' character first
    p = 0
    c0 = data[0] & 255
    c0 == 80 -> {

        ; 'P' found, skip it
        p = 1
    }
    magic = 0
    magic, p = pnm-read-int(data, p)
    {
        magic == 5 -> {
            img = pnm-load-binary(data, p, 1)
        }
        magic == 6 -> {
            img = pnm-load-binary(data, p, 3)
        }
        magic == 2 -> {
            img = pnm-load-ascii(data, p, 1)
        }
        magic == 3 -> {
            img = pnm-load-ascii(data, p, 3)
        }
        -> {
            img = nil
        }
    }
}

; pnm-load-binary: load binary PGM (P5) or PPM (P6)
; data str: file content
; pos i64: current parse position (after magic)
; bands i64: 1 for PGM, 3 for PPM
; returns img ?image
pnm-load-binary = (data str, pos i64, bands i64) (img ?image) {
    w = 0
    h = 0
    maxval = 0
    w, pos = pnm-read-int(data, pos)
    h, pos = pnm-read-int(data, pos)
    maxval, pos = pnm-read-int(data, pos)

    ; single whitespace after maxval, then binary data
    pos = pos + 1
    {
        w <= 0 || h <= 0 || maxval <= 0 -> {
            img = nil
            return
        }
        maxval > 255 -> {
            img = nil
            return
        }
    }
    n = w * h * bands
    _d str = with-len(n)
    tmp = image.new-from-data(w, h, bands, _d)
    tmp.data.len >= n -> {
        i <- [0..n): {
            tmp.data[i] = data[pos + i] & 255
        }
    }
    img = tmp
}

; pnm-load-ascii: load ASCII PGM (P2) or PPM (P3)
; data str: file content
; pos i64: current parse position
; bands i64: 1 or 3
; returns img ?image
pnm-load-ascii = (data str, pos i64, bands i64) (img ?image) {
    w = 0
    h = 0
    maxval = 0
    w, pos = pnm-read-int(data, pos)
    h, pos = pnm-read-int(data, pos)
    maxval, pos = pnm-read-int(data, pos)
    {
        w <= 0 || h <= 0 || maxval <= 0 -> {
            img = nil
            return
        }
    }
    n = w * h * bands
    _d str = with-len(n)
    tmp = image.new-from-data(w, h, bands, _d)
    i <- [0..n): {
        v, pos = pnm-read-int(data, pos)
        v > 255 -> v = 255
        tmp.data[i] = v
    }
    img = tmp
}

; pnm-read-int: read an integer from PNM data, skipping whitespace and comments
; data str: file content
; pos i64: starting position
; returns val i64, new-pos i64
pnm-read-int = (data str, pos i64) (val i64, new-pos i64) {
    val = 0
    new-pos = pos
    data.len == 0 -> return

    ; skip whitespace and comments
    {
        new-pos < data.len -> {
            c = data[new-pos] & 255
            {
                c == 32 || c == 10 || c == 13 || c == 9 -> {
                    new-pos = new-pos + 1
                }
                c == 35 -> {

                    ; comment — skip to end of line
                    {
                        new-pos = new-pos + 1
                    } (new-pos < data.len && (data[new-pos] & 255) != 10)
                    new-pos < data.len -> new-pos = new-pos + 1
                }
                -> break
            }
        }
    } (new-pos < data.len)

    ; read digits
    {
        new-pos < data.len -> {
            c = data[new-pos] & 255
            c >= 48 && c <= 57 -> {
                val = val * 10 + (c - 48)
                new-pos = new-pos + 1
            }
            -> break
        }
    } (new-pos < data.len && (data[new-pos] & 255) >= 48 && (data[new-pos] & 255) <= 57)
}

; pnm.save: save an image as binary PNM
; path str: output file path
; img image: image to save
; returns ok bool: success
save = (path str, img image) (ok bool) {
    ok = save-binary(path, img)
}

; pnm.save-binary: save as P6 (RGB) or P5 (grayscale)
; path str: output path
; img image: image
; returns ok bool
save-binary = (path str, img image) (ok bool) {
    {
        img.bands >= 3 -> {
            ok = pnm-write-p6(path, img)
        }
        img.bands == 1 -> {
            ok = pnm-write-p5(path, img)
        }
        -> {

            ; For other band counts, save as P6 with first 3 bands
            ok = pnm-write-p6(path, img)
        }
    }
}

; pnm-write-p6: write PPM binary (P6)
; path str: path
; img image: RGB image
; returns ok bool
pnm-write-p6 = (path str, img image) (ok bool) {

    ; Build header: "P6\n{w} {h}\n255\n"
    hdr = 'P6\n' - img.width.to-str() - ' ' - img.height.to-str() - '\n255\n'
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    hdr-bytes = hdr
    fs.write(wfd, hdr-bytes, hdr-bytes.len)

    ; Write pixel data
    n = img.width * img.height * img.bands
    {
        img.bands >= 3 -> {

            ; Write directly (RGB data)
            fs.write(wfd, img.data, n)
        }
        img.bands == 1 -> {

            ; Grayscale -> R=G=B=gray
            pix = with-len(img.width * img.height * 3)
            i <- [0..img.width * img.height): {
                pix[i * 3] = img.data[i]
                pix[i * 3 + 1] = img.data[i]
                pix[i * 3 + 2] = img.data[i]
            }
            fs.write(wfd, pix, pix.len)
        }
        img.bands == 2 -> {

            ; Gray + Alpha -> RGB with gray
            pix = with-len(img.width * img.height * 3)
            i <- [0..img.width * img.height): {
                pix[i * 3] = img.data[i * 2]
                pix[i * 3 + 1] = img.data[i * 2]
                pix[i * 3 + 2] = img.data[i * 2]
            }
            fs.write(wfd, pix, pix.len)
        }
        img.bands >= 4 -> {

            ; RGBA -> RGB (drop alpha)
            pix = with-len(img.width * img.height * 3)
            i <- [0..img.width * img.height): {
                pix[i * 3] = img.data[i * 4]
                pix[i * 3 + 1] = img.data[i * 4 + 1]
                pix[i * 3 + 2] = img.data[i * 4 + 2]
            }
            fs.write(wfd, pix, pix.len)
        }
    }
    fs.close(wfd)
    ok = true
}

; pnm-write-p5: write PGM binary (P5)
; path str: path
; img image: grayscale image
; returns ok bool
pnm-write-p5 = (path str, img image) (ok bool) {
    hdr = 'P5\n' - img.width.to-str() - ' ' - img.height.to-str() - '\n255\n'
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    hdr-bytes = hdr
    fs.write(wfd, hdr-bytes, hdr-bytes.len)
    {
        img.bands == 1 -> {

            ; Direct grayscale
            fs.write(wfd, img.data, img.width * img.height)
        }
        -> {

            ; Convert to grayscale using luminance
            npix = img.width * img.height
            gray = with-len(npix)
            i <- [0..npix): {
                {
                    img.bands >= 3 -> {
                        r = img.data[i * img.bands]
                        g = img.data[i * img.bands + 1]
                        b = img.data[i * img.bands + 2]
                        gray[i] = (r * 299 + g * 587 + b * 114) / 1000
                    }
                    -> {
                        gray[i] = img.data[i * img.bands]
                    }
                }
            }
            fs.write(wfd, gray, npix)
        }
    }
    fs.close(wfd)
    ok = true
}

; pnm.save-ascii: save as ASCII PNM (P2/P3)
; path str: output path
; img image: image
; returns ok bool
save-ascii = (path str, img image) (ok bool) {
    {
        img.bands >= 3 -> {
            ok = pnm-write-p3(path, img)
        }
        -> {
            ok = pnm-write-p2(path, img)
        }
    }
}

; pnm-write-p3: write ASCII PPM (P3)
; path str: path
; img image: image
; returns ok bool
pnm-write-p3 = (path str, img image) (ok bool) {
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    hdr = 'P3\n' - img.width.to-str() - ' ' - img.height.to-str() - '\n255\n'
    hdr-bytes = hdr
    fs.write(wfd, hdr-bytes, hdr-bytes.len)
    npix = img.width * img.height
    i <- [0..npix): {
        {
            img.bands >= 3 -> {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]
                line = r.to-str() - ' ' - g.to-str() - ' ' - b.to-str() - '\n'
                lb = line.to-bytes()
                fs.write(wfd, lb, lb.len)
            }
            img.bands == 1 -> {
                v = img.data[i]
                line = v.to-str() - ' ' - v.to-str() - ' ' - v.to-str() - '\n'
                lb = line.to-bytes()
                fs.write(wfd, lb, lb.len)
            }
            -> {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]
                line = r.to-str() - ' ' - g.to-str() - ' ' - b.to-str() - '\n'
                lb = line.to-bytes()
                fs.write(wfd, lb, lb.len)
            }
        }
    }
    fs.close(wfd)
    ok = true
}

; pnm-write-p2: write ASCII PGM (P2)
; path str: path
; img image: image
; returns ok bool
pnm-write-p2 = (path str, img image) (ok bool) {
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    hdr = 'P2\n' - img.width.to-str() - ' ' - img.height.to-str() - '\n255\n'
    hdr-bytes = hdr
    fs.write(wfd, hdr-bytes, hdr-bytes.len)
    npix = img.width * img.height
    i <- [0..npix): {
        {
            img.bands == 1 -> {
                v = img.data[i]
                line = v.to-str() - '\n'
            }
            -> {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]
                v = (r * 299 + g * 587 + b * 114) / 1000
                line = v.to-str() - '\n'
            }
        }
        lb = line.to-bytes()
        fs.write(wfd, lb, lb.len)
    }
    fs.close(wfd)
    ok = true
}
