; colour.no — Color space conversions
; Implements RGB <-> sRGB <-> Grayscale <-> HSV/HSL conversions
; Inspired by libvips colour operations

; ── RGB <-> Grayscale ──

; colour.rgb2gray: convert RGB image to grayscale
; img image: input RGB image
; returns out image: grayscale (1-band) image

# /img/src/image.new
# /img/src/image.new-from-data
# /img/src/image.copy
# /img/src/image.fill
# /img/src/image.invert
# /img/src/image.add-const
# /img/src/image.avg
# /img/src/image.min-val
# /img/src/image.max-val
# /img/src/image.get-pixel
# /img/src/image.set-pixel

rgb2gray = (img image) (out image) {
    {
        img.bands >= 3 -> {
            npix = img.width * img.height
            _d str = with-len(npix)
            out = image.new-from-data(img.width, img.height, 1, _d)
            i <- [0..npix): {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]

                ; ITU-R BT.601 luma
                v = (r * 299 + g * 587 + b * 114) / 1000
                out.data[i] = v
            }
        }
        -> {

            ; Already grayscale or unknown — just copy
            out = image.copy(img)
        }
    }
}

; colour.gray2rgb: convert grayscale to RGB
; img image: grayscale image
; returns out image: RGB image
gray2rgb = (img image) (out image) {
    {
        img.bands == 1 -> {
            npix = img.width * img.height
            _d str = with-len(npix * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
            i <- [0..npix): {
                v = img.data[i]
                out.data[i * 3] = v
                out.data[i * 3 + 1] = v
                out.data[i * 3 + 2] = v
            }
        }
        -> {
            out = image.copy(img)
        }
    }
}

; ── RGB <-> HSV ──

; colour.rgb2hsv: convert RGB to HSV
; img image: RGB image
; returns out image: HSV image (H: 0-255, S: 0-255, V: 0-255)
rgb2hsv = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        r = img.data[i * img.bands]
        g = img.data[i * img.bands + 1]
        b = img.data[i * img.bands + 2]
        h = 0
        s = 0
        v = 0
        mx = r
        mx < g -> mx = g
        mx < b -> mx = b
        mn = r
        mn > g -> mn = g
        mn > b -> mn = b
        delta = mx - mn
        v = mx
        {
            mx == 0 -> {
                s = 0
            }
            -> {
                s = (delta * 255) / mx
            }
        }
        delta == 0 -> {
            h = 0
        }
        mx == r -> {
            h = (g - b) * 255 / (delta)
            h < 0 -> h = h + 255
        }
        mx == g -> {
            h = 85 + (b - r) * 255 / (delta)
        }
        mx == b -> {
            h = 170 + (r - g) * 255 / (delta)
        }
        out.data[i * 3] = h
        out.data[i * 3 + 1] = s
        out.data[i * 3 + 2] = v
    }
}

; colour.hsv2rgb: convert HSV to RGB
; img image: HSV image
; returns out image: RGB image
hsv2rgb = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        h = img.data[i * img.bands]
        s = img.data[i * img.bands + 1]
        v = img.data[i * img.bands + 2]
        r = 0
        g = 0
        b = 0
        {
            s == 0 -> {
                r = v
                g = v
                b = v
            }
            -> {

                ; h is 0-255, convert to sector 0-5
                hi = h * 6 / 256
                f = (h * 6 - hi * 256) / 256
                p = v * (255 - s) / 255
                q = v * (255 - (s * f) / 255) / 255
                t = v * (255 - (s * (255 - f)) / 255) / 255
                {
                    hi == 0 -> {
                        r = v
                        g = t
                        b = p
                    }
                    hi == 1 -> {
                        r = q
                        g = v
                        b = p
                    }
                    hi == 2 -> {
                        r = p
                        g = v
                        b = t
                    }
                    hi == 3 -> {
                        r = p
                        g = q
                        b = v
                    }
                    hi == 4 -> {
                        r = t
                        g = p
                        b = v
                    }
                    -> {
                        r = v
                        g = p
                        b = q
                    }
                }
            }
        }
        out.data[i * 3] = r
        out.data[i * 3 + 1] = g
        out.data[i * 3 + 2] = b
    }
}

; ── RGB <-> HSL ──

; colour.rgb2hsl: convert RGB to HSL
; img image: RGB image
; returns out image: HSL image
rgb2hsl = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        r = img.data[i * img.bands]
        g = img.data[i * img.bands + 1]
        b = img.data[i * img.bands + 2]
        h = 0
        s = 0
        l = 0
        mx = r
        mx < g -> mx = g
        mx < b -> mx = b
        mn = r
        mn > g -> mn = g
        mn > b -> mn = b
        l = (mx + mn) / 2
        delta = mx - mn
        {
            delta == 0 -> {
                h = 0
                s = 0
            }
            -> {
                {
                    l < 128 -> {
                        s = delta * 255 / (mx + mn)
                    }
                    -> {
                        sum = 510 - mx - mn
                        sum == 0 -> {
                            s = 0
                        }
                        -> {
                            s = delta * 255 / sum
                        }
                    }
                }
                mx == r -> {
                    h = (g - b) * 255 / delta
                    h < 0 -> h = h + 255
                }
                mx == g -> {
                    h = 85 + (b - r) * 255 / delta
                }
                mx == b -> {
                    h = 170 + (r - g) * 255 / delta
                }
            }
        }
        out.data[i * 3] = h
        out.data[i * 3 + 1] = s
        out.data[i * 3 + 2] = l
    }
}

; ── RGB <-> YCbCr ──

; colour.rgb2ycbcr: convert RGB to YCbCr (JPEG JFIF)
; img image: RGB image
; returns out image: YCbCr image
rgb2ycbcr = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        r = img.data[i * img.bands]
        g = img.data[i * img.bands + 1]
        b = img.data[i * img.bands + 2]
        y = (r * 77 + g * 150 + b * 29) >> 8
        cb = ((b - y) * 128) / 255 + 128
        cr = ((r - y) * 128) / 255 + 128
        {
            y < 0 -> y = 0
            y > 255 -> y = 255
        }
        {
            cb < 0 -> cb = 0
            cb > 255 -> cb = 255
        }
        {
            cr < 0 -> cr = 0
            cr > 255 -> cr = 255
        }
        out.data[i * 3] = y
        out.data[i * 3 + 1] = cb
        out.data[i * 3 + 2] = cr
    }
}

; colour.ycbcr2rgb: convert YCbCr to RGB
; img image: YCbCr image
; returns out image: RGB image
ycbcr2rgb = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        y = img.data[i * img.bands]
        cb = img.data[i * img.bands + 1]
        cr = img.data[i * img.bands + 2]
        r = y + (cr * 255) / 128
        b = y + (cb * 255) / 128
        g = (y * 255 - r * 77 - b * 29) / 150
        {
            r < 0 -> r = 0
            r > 255 -> r = 255
        }
        {
            g < 0 -> g = 0
            g > 255 -> g = 255
        }
        {
            b < 0 -> b = 0
            b > 255 -> b = 255
        }
        out.data[i * 3] = r
        out.data[i * 3 + 1] = g
        out.data[i * 3 + 2] = b
    }
}

; ── Threshold / Binarize ──

; colour.threshold: binary threshold on grayscale or RGB
; img image: input image
; t i64: threshold value
; returns out image: binary (0 or 255) image
threshold = (img image, t i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    i <- [0..n): {
        img.data[i] >= t -> {
            out.data[i] = 255
        }
        -> {
            out.data[i] = 0
        }
    }
}

; colour.otsu-threshold: compute Otsu's threshold
; img image: input image
; returns t i64: computed threshold
otsu-threshold = (img image) (t i64) {

    ; Build histogram
    hist = with-len(256)
    i <- [0..256): {
        hist[i] = 0
    }
    n = img.width * img.height * img.bands
    i <- [0..n): {
        v = img.data[i]
        hist[v] = hist[v] + 1
    }

    ; Total pixels
    total = n
    sum = 0
    i <- [0..256): {
        sum = sum + i * hist[i]
    }
    sum-b = 0
    w-b = 0
    max-var = 0
    t = 0
    i <- [0..256): {
        w-b = w-b + hist[i]
        w-b == 0 -> {
            i <- [0..0): {
            }
        }
        w-f = total - w-b
        w-f == 0 -> break
        sum-b = sum-b + i * hist[i]
        m-b = sum-b / w-b
        m-f = (sum - sum-b) / w-f
        var = w-b * w-f * (m-b - m-f) * (m-b - m-f)
        var > max-var -> {
            max-var = var
            t = i
        }
    }
}

; ── Brightness / Contrast / Gamma ──

; colour.brightness: adjust brightness
; img image: input image
; b i64: brightness adjustment (-255 to 255)
; returns out image: adjusted image
brightness = (img image, b i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    i <- [0..n): {
        v = img.data[i] + b
        v > 255 -> v = 255
        v < 0 -> v = 0
        out.data[i] = v
    }
}

; colour.contrast: adjust contrast
; img image: input image
; c i64: contrast factor (-100 to 100, percentage)
; returns out image: adjusted image
contrast = (img image, c i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    factor = (259 * (c + 255)) / (255 * (259 - c))
    i <- [0..n): {
        v = factor * (img.data[i] - 128) + 128
        v > 255 -> v = 255
        v < 0 -> v = 0
        out.data[i] = v
    }
}

; colour.gamma: apply gamma correction
; img image: input image
; g i64: gamma * 100 (e.g. 220 = 2.2)
; returns out image: corrected image
gamma = (img image, g i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    g == 0 -> return

    ; Build lookup table for speed
    lut = with-len(256)
    i <- [0..256): {

        ; gamma = g / 100
        ; lut[i] = 255 * (i/255)^(g/100)
        ; Approximate with integer math
        norm = i * 1000 / 255

        ; norm^gamma * 255 / 1000^gamma
        result = 0
        {
            g == 100 -> {
                result = i
            }
            g > 100 -> {

                ; gamma > 1: darker
                ; approximate: i^gamma = i * i^(g-100)/100
                exp = g - 100
                tmp = norm
                j <- [0..exp / 10): {
                    tmp = tmp * norm / 1000
                }
                result = tmp * 255 / 1000
            }
            -> {

                ; gamma < 1: brighter
                exp = 100 - g
                tmp = norm
                j <- [0..exp / 10): {
                    tmp = (tmp * 1000) / (norm > 0 ? norm : 1)
                }
                result = tmp * 255 / 1000
            }
        }
        result > 255 -> result = 255
        result < 0 -> result = 0
        lut[i] = result
    }
    i <- [0..n): {
        out.data[i] = lut[img.data[i]]
    }
}

; ── Posterize ──

; colour.posterize: reduce the number of color levels
; img image: input image
; levels i64: number of levels per channel (2-256)
; returns out image: posterized image
posterize = (img image, levels i64) (out image) {
    out = image.copy(img)
    {
        levels <= 0 || levels > 256 -> return
    }
    step = 256 / levels
    n = img.width * img.height * img.bands
    i <- [0..n): {
        v = img.data[i]
        out.data[i] = (v / step) * step + step / 2
    }
}

; ── Solarize ──

; colour.solarize: invert pixels above threshold
; img image: input image
; t i64: threshold
; returns out image: solarized image
solarize = (img image, t i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    i <- [0..n): {
        img.data[i] >= t -> {
            out.data[i] = 255 - img.data[i]
        }
    }
}
