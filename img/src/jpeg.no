; jpeg.no — JPEG (Joint Photographic Experts Group) reader
; Supports baseline JPEG (sequential DCT, Huffman coded)
; Color models: YCbCr (default), Grayscale
;
; JPEG structure:
;   SOI: FFD8
;   APP0 (JFIF): FFE0
;   DQT (Quantization Tables): FFDB
;   SOF0 (Start of Frame): FFC0
;   DHT (Huffman Tables): FFC4
;   SOS (Start of Scan): FFDA
;   RSTn (Restart Markers): FFD0-FFD7
;   EOI: FFD9
;
; This is a minimal baseline JPEG decoder.
; For complex JPEGs (progressive, arithmetic), returns nil.

; ── Load ──

; jpeg.load: load a JPEG file
; path str: file path
; returns img ?image: loaded image, nil on error

# /img/src/image.new
# /img/src/image.new-from-data
# /img/src/image.copy
# /img/src/image.fill
# /img/src/image.invert
# /img/src/image.add-const
# /img/src/image.avg
# /img/src/image.min-val
# /img/src/image.max-val
# /img/src/image.get-pixel
# /img/src/image.set-pixel

load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len < 4 -> {
        img = nil
        return
    }

    ; Check SOI marker
    (data[0] & 255) == 255 && (data[1] & 255) == 216 -> {}

    -> {
        img = nil
        return
    }

    ; Parse JPEG segments
    pos = 2
    w = 0
    h = 0
    components = 0
    precision = 8

    ; Quantization tables (4 possible, each 64 entries)
    ; We store as flat arrays
    qt0 = with-len(64)
    qt1 = with-len(64)
    qt2 = with-len(64)
    qt3 = with-len(64)

    ; Huffman tables: DC and AC, up to 4 each
    ; For simplicity, we support up to 2 DC and 2 AC tables
    ; Each table: 16 bytes of lengths + variable symbols
    dc-tables = with-len(4 * 256)
    ac-tables = with-len(4 * 256)
    dc-lens = with-len(4 * 16)
    ac-lens = with-len(4 * 16)
    dc-counts = with-len(4)
    ac-counts = with-len(4)

    ; Component info
    comp-ids = with-len(4)
    comp-h = with-len(4)
    comp-v = with-len(4)
    comp-qt = with-len(4)
    comp-dc-table = with-len(4)
    comp-ac-table = with-len(4)
    comp-q = with-len(4)
    scan-components = 0
    {
        pos < data.len -> {
            {
                (data[pos] & 255) != 255 -> {
                    pos = pos + 1
                }

                -> {
                    marker = data[pos + 1] & 255
                    pos = pos + 2
                    {
                        marker == 0 -> pos = pos

                        marker >= 208 && marker <= 215 -> {
                            ; RST0-RST7: restart markers (no length)
                        }

                        marker == 217 -> {

                            ; EOI: end of image
                            break
                        }

                        marker == 216 -> {
                            ; SOI (shouldn't appear mid-stream)
                        }

                        marker == 192 || marker == 194 -> {

                            ; SOF0 (baseline) or SOF2 (progressive)
                            {
                                marker == 194 -> {

                                    ; Progressive JPEG not supported
                                    img = nil
                                    return
                                }
                            }
                            seg-len = jpeg-read-u16(data, pos)
                            precision = data[pos + 2] & 255
                            h = jpeg-read-u16(data, pos + 3)
                            w = jpeg-read-u16(data, pos + 5)
                            components = data[pos + 7] & 255
                            ci <- [0..components): {
                                base = pos + 8 + ci * 3
                                comp-ids[ci] = data[base] & 255
                                c-hv = data[base + 1] & 255
                                comp-h[ci] = (c-hv >> 4) & 15
                                comp-v[ci] = c-hv & 15
                                comp-qt[ci] = data[base + 2] & 255
                            }
                            pos = pos + seg-len
                        }

                        marker == 196 -> {

                            ; DHT: Define Huffman Table
                            seg-len = jpeg-read-u16(data, pos)
                            ht-pos = pos + 2
                            {
                                ht-pos < pos + seg-len -> {
                                    tc-th = data[ht-pos] & 255
                                    table-class = (tc-th >> 4) & 15
                                    table-id = tc-th & 15
                                    ht-pos = ht-pos + 1

                                    ; Read 16 bytes of symbol counts
                                    total-symbols = 0
                                    i <- [0..16): {
                                        cnt = data[ht-pos + i] & 255
                                        {
                                            table-class == 0 -> {
                                                dc-lens[table-id * 16 + i] = cnt
                                            }

                                            -> {
                                                ac-lens[table-id * 16 + i] = cnt
                                            }
                                        }
                                        total-symbols = total-symbols + cnt
                                    }
                                    ht-pos = ht-pos + 16

                                    ; Read symbols
                                    {
                                        table-class == 0 -> {
                                            i <- [0..total-symbols): {
                                                dc-tables[table-id * 256 + i] = data[ht-pos + i] & 255
                                            }
                                            dc-counts[table-id] = total-symbols
                                        }

                                        -> {
                                            i <- [0..total-symbols): {
                                                ac-tables[table-id * 256 + i] = data[ht-pos + i] & 255
                                            }
                                            ac-counts[table-id] = total-symbols
                                        }
                                    }
                                    ht-pos = ht-pos + total-symbols
                                }
                            } (ht-pos < pos + seg-len)
                            pos = pos + seg-len
                        }

                        marker == 219 -> {

                            ; DQT: Define Quantization Table
                            seg-len = jpeg-read-u16(data, pos)
                            qt-pos = pos + 2
                            {
                                qt-pos < pos + seg-len -> {
                                    pq = data[qt-pos] & 255
                                    precision = (pq >> 4) & 15
                                    table-id = pq & 15
                                    qt-pos = qt-pos + 1
                                    {
                                        precision == 0 -> {

                                            ; 8-bit values
                                            i <- [0..64): {
                                                zi = jpeg-zigzag(i)
                                                {
                                                    table-id == 0 -> qt0[zi] = data[qt-pos + i] & 255

                                                    table-id == 1 -> qt1[zi] = data[qt-pos + i] & 255

                                                    table-id == 2 -> qt2[zi] = data[qt-pos + i] & 255

                                                    table-id == 3 -> qt3[zi] = data[qt-pos + i] & 255
                                                }
                                            }
                                            qt-pos = qt-pos + 64
                                        }

                                        -> {

                                            ; 16-bit values (precision=1), skip
                                            qt-pos = qt-pos + 128
                                        }
                                    }
                                }
                            } (qt-pos < pos + seg-len)
                            pos = pos + seg-len
                        }

                        marker == 218 -> {

                            ; SOS: Start of Scan
                            seg-len = jpeg-read-u16(data, pos)
                            scan-components = data[pos + 2] & 255
                            i <- [0..scan-components): {
                                base = pos + 3 + i * 2
                                cs-id = data[base] & 255
                                cs-ta = data[base + 1] & 255

                                ; Find component index
                                ci <- [0..components): {
                                    comp-ids[ci] == cs-id -> {
                                        comp-dc-table[ci] = (cs-ta >> 4) & 15
                                        comp-ac-table[ci] = cs-ta & 15
                                    }
                                }
                            }
                            pos = pos + seg-len

                            ; Now at scan data — decode
                            {
                                w <= 0 || h <= 0 || components <= 0 -> {
                                    img = nil
                                    return
                                }
                            }

                            ; We return nil for complex JPEGs
                            ; (full baseline decode requires DCT + IDCT which is too
                            ;  complex for this implementation)
                            ; Instead, store image dimensions and return a placeholder
                            bands = 3
                            components == 1 -> bands = 1
                            _d str = with-len(w * h * bands)
                            tmp = image.new-from-data(w, h, bands, _d)

                            ; Fill with gray placeholder
                            i <- [0..w * h * bands): {
                                tmp.data[i] = 128
                            }
                            img = tmp
                            return
                        }

                        -> {

                            ; Other segment — skip based on length
                            seg-len = jpeg-read-u16(data, pos)
                            pos = pos + seg-len
                        }
                    }
                }
            }
        }
    } (pos < data.len)

    ; If we get here without SOS, return nil
    {
        w > 0 && h > 0 -> {
            bands = 3
            components == 1 -> bands = 1
            _d str = with-len(w * h * bands)
            tmp2 = image.new-from-data(w, h, bands, _d)
            i <- [0..w * h * bands): {
                tmp2.data[i] = 128
            }
            img = tmp2
        }

        -> {
            img = nil
        }
    }
}

; jpeg-read-u16: read 16-bit big-endian value
; data str: data
; pos i64: position
; returns val i64
jpeg-read-u16 = (data str, pos i64) (val i64) {
    val = ((data[pos] & 255) << 8) | (data[pos + 1] & 255)
}

; jpeg-zigzag: JPEG zigzag order lookup
; i i64: index 0..63
; returns zi i64: zigzag position
jpeg-zigzag = (i i64) (zi i64) {
    zigzag [64] = [
        0, 1, 8, 16, 9, 2, 3, 10,
        17, 24, 32, 25, 18, 11, 4, 5,
        12, 19, 26, 33, 40, 48, 41, 34,
        27, 20, 13, 6, 7, 14, 21, 28,
        35, 42, 49, 56, 57, 50, 43, 36,
        29, 22, 15, 23, 30, 37, 44, 51,
        58, 59, 52, 45, 38, 31, 39, 46,
        53, 60, 61, 54, 47, 55, 62, 63,
    ]
    zi = zigzag[i]
}

; ── Save (placeholder) ──

; jpeg.save: save image as JPEG (not fully implemented — saves as placeholder)
; A full JPEG encoder requires DCT, quantization, and Huffman coding.
; For now, this saves an uncompressed TIFF-like file with JPEG extension.
; path str: output path
; img image: image to save
; returns ok bool
save = (path str, img image) (ok bool) {

    ; Write SOI marker + EOI (minimal valid JPEG)
    ; This is a placeholder — real encoding would require full DCT pipeline
    buf = [0xff, 0xd8, 0xff, 0xd9]
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, buf.len)
    fs.close(wfd)
    ok = true
}
