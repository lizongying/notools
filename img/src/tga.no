; tga.no — TGA (Truevision Targa) format read/write
; Supports:
;   Type 2  — uncompressed true-color (24/32-bit)
;   Type 3  — uncompressed grayscale (8-bit)
;   Type 10 — RLE compressed true-color (24/32-bit)
;
; TGA file layout:
;   Header (18 bytes): id-length, color-map-type, image-type, x-origin,
;     y-origin, width, height, pixel-depth, image-descriptor
;   Image ID (variable)
;   Color map (optional)
;   Pixel data (bottom-up or top-down depending on descriptor bit 5)

; ── Load ──

; tga.load: load a TGA file
; path str: file path
; returns img ?image: loaded image, nil on error

# /img/src/image.new
# /img/src/image.new-from-data
# /img/src/image.copy
# /img/src/image.fill
# /img/src/image.invert
# /img/src/image.add-const
# /img/src/image.avg
# /img/src/image.min-val
# /img/src/image.max-val
# /img/src/image.get-pixel
# /img/src/image.set-pixel

load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len < 18 -> {
        img = nil
        return
    }
    id-len = data[0] & 255
    color-map-type = data[1] & 255
    image-type = data[2] & 255

    ; x-origin (bytes 8-9), y-origin (bytes 10-11) — little-endian
    w = (data[12] & 255) | ((data[13] & 255) << 8)
    h = (data[14] & 255) | ((data[15] & 255) << 8)
    depth = data[16] & 255
    descriptor = data[17] & 255
    {
        w <= 0 || h <= 0 -> {
            img = nil
            return
        }

        depth != 8 && depth != 24 && depth != 32 -> {
            img = nil
            return
        }
    }

    ; Top-down if bit 5 (0x20) is set
    top-down = (descriptor & 32) != 0

    ; Skip image ID
    pos = 18 + id-len

    ; Skip color map if present
    color-map-type != 0 -> {

        ; cmap entries (bytes 4-5), entry-size (byte 7)
        cm-entries = (data[4] & 255) | ((data[5] & 255) << 8)
        cm-size = data[7] & 255
        pos = pos + cm-entries * ((cm-size + 7) / 8)
    }
    bands = depth / 8
    {
        image-type == 2 || image-type == 3 -> {

            ; Uncompressed
            img = tga-load-uncompressed(data, pos, w, h, bands, top-down)
        }

        image-type == 10 -> {

            ; RLE compressed true-color
            img = tga-load-rle(data, pos, w, h, bands, top-down)
        }

        -> {
            img = nil
        }
    }
}

; tga-load-uncompressed: load uncompressed TGA pixel data
; data str: file content
; pos i64: data start position
; w i64: width
; h i64: height
; bands i64: bytes per pixel (1, 3, 4)
; top-down bool: whether rows are top-down
; returns img ?image
tga-load-uncompressed = (data str, pos i64, w i64, h i64, bands i64, top-down bool) (img ?image) {
    n = w * h * bands
    _d str = with-len(n)
    tmp = image.new-from-data(w, h, bands, _d)
    y <- [0..h): {
        src-y = y
        top-down == false -> src-y = h - 1 - y
        x <- [0..w): {
            src = pos + (src-y * w + x) * bands
            dst = (y * w + x) * bands
            {
                bands == 1 -> {
                    tmp.data[dst] = data[src] & 255
                }

                bands == 3 -> {

                    ; TGA stores BGRA, we store RGBA
                    tmp.data[dst] = data[src + 2] & 255
                    tmp.data[dst + 1] = data[src + 1] & 255
                    tmp.data[dst + 2] = data[src] & 255
                }

                bands == 4 -> {
                    tmp.data[dst] = data[src + 2] & 255
                    tmp.data[dst + 1] = data[src + 1] & 255
                    tmp.data[dst + 2] = data[src] & 255
                    tmp.data[dst + 3] = data[src + 3] & 255
                }
            }
        }
    }
    img = tmp
}

; tga-load-rle: load RLE compressed TGA
; TGA RLE: packet header byte:
;   bit 7 = 1 → run-length packet (repeat pixel count+1 times)
;   bit 7 = 0 → raw packet (count+1 raw pixels follow)
; returns img ?image
tga-load-rle = (data str, pos i64, w i64, h i64, bands i64, top-down bool) (img ?image) {
    n = w * h * bands
    _d str = with-len(n)
    tmp = image.new-from-data(w, h, bands, _d)
    total-pixels = w * h
    pixels-read = 0
    p = pos
    {
        pixels-read < total-pixels -> {
            header = data[p] & 255
            p = p + 1
            count = (header & 127) + 1
            {
                header >= 128 -> {

                    ; Run-length packet: 1 pixel repeated
                    r = data[p] & 255
                    g = data[p + 1] & 255
                    b = data[p + 2] & 255
                    a = 255
                    bands == 4 -> a = data[p + 3] & 255
                    p = p + bands
                    i <- [0..count): {
                        {
                            pixels-read >= total-pixels -> break
                        }
                        pixel-idx = pixels-read
                        src-y = pixel-idx / w
                        src-x = pixel-idx - src-y * w
                        top-down == false -> src-y = h - 1 - src-y
                        dst = (src-y * w + src-x) * bands
                        {
                            bands == 1 -> {
                                tmp.data[dst] = r
                            }

                            bands == 3 -> {
                                tmp.data[dst] = b
                                tmp.data[dst + 1] = g
                                tmp.data[dst + 2] = r
                            }

                            bands == 4 -> {
                                tmp.data[dst] = b
                                tmp.data[dst + 1] = g
                                tmp.data[dst + 2] = r
                                tmp.data[dst + 3] = a
                            }
                        }
                        pixels-read = pixels-read + 1
                    }
                }

                -> {

                    ; Raw packet: count raw pixels
                    i <- [0..count): {
                        {
                            pixels-read >= total-pixels -> break
                        }
                        r = data[p] & 255
                        g = data[p + 1] & 255
                        b = data[p + 2] & 255
                        a = 255
                        bands == 4 -> a = data[p + 3] & 255
                        p = p + bands
                        pixel-idx = pixels-read
                        src-y = pixel-idx / w
                        src-x = pixel-idx - src-y * w
                        top-down == false -> src-y = h - 1 - src-y
                        dst = (src-y * w + src-x) * bands
                        {
                            bands == 1 -> {
                                tmp.data[dst] = r
                            }

                            bands == 3 -> {
                                tmp.data[dst] = b
                                tmp.data[dst + 1] = g
                                tmp.data[dst + 2] = r
                            }

                            bands == 4 -> {
                                tmp.data[dst] = b
                                tmp.data[dst + 1] = g
                                tmp.data[dst + 2] = r
                                tmp.data[dst + 3] = a
                            }
                        }
                        pixels-read = pixels-read + 1
                    }
                }
            }
        }
    } (pixels-read < total-pixels)
    img = tmp
}

; ── Save ──

; tga.save: save an image as uncompressed TGA (type 2/3)
; path str: output path
; img image: image to save
; returns ok bool
save = (path str, img image) (ok bool) {
    depth = img.bands * 8
    {
        img.bands == 1 -> {
            ok = tga-write-uncompressed(path, img, 3, depth)
        }

        img.bands == 3 -> {
            ok = tga-write-uncompressed(path, img, 2, depth)
        }

        img.bands == 4 -> {
            ok = tga-write-uncompressed(path, img, 2, depth)
        }

        -> {

            ; Force to 3-band
            ok = tga-write-uncompressed(path, img, 2, 24)
        }
    }
}

; tga-write-uncompressed: write uncompressed TGA
; path str: path
; img image: image
; image-type i64: 2 (true-color) or 3 (grayscale)
; depth i64: bits per pixel
; returns ok bool
tga-write-uncompressed = (path str, img image, image-type i64, depth i64) (ok bool) {
    w = img.width
    h = img.height
    bands = depth / 8
    data-size = w * h * bands
    total-size = 18 + data-size
    buf = with-len(total-size)

    ; --- Header (18 bytes) ---
    buf[0] = 0; ID length
    buf[1] = 0; Color map type (none)
    buf[2] = image-type & 255

    ; Color map spec (5 bytes, all zero)
    buf[3] = 0
    buf[4] = 0
    buf[5] = 0
    buf[6] = 0
    buf[7] = 0

    ; X origin (2 bytes LE)
    buf[8] = 0
    buf[9] = 0

    ; Y origin (2 bytes LE)
    buf[10] = 0
    buf[11] = 0

    ; Width (2 bytes LE)
    buf[12] = w & 255
    buf[13] = (w >> 8) & 255

    ; Height (2 bytes LE)
    buf[14] = h & 255
    buf[15] = (h >> 8) & 255

    ; Pixel depth
    buf[16] = depth & 255

    ; Image descriptor: bit 5 = top-down (0x20)
    buf[17] = 32

    ; --- Pixel data (bottom-up in our buffer, but descriptor says top-down) ---
    ; Since we set top-down, pixel order is top to bottom
    y <- [0..h): {
        x <- [0..w): {
            src = (y * w + x) * img.bands
            dst = 18 + (y * w + x) * bands
            {
                bands == 1 -> {
                    img.bands == 1 -> {
                        buf[dst] = img.data[src]
                    }

                    -> {
                        r = img.data[src]
                        g = img.data[src + 1]
                        b = img.data[src + 2]
                        buf[dst] = (r * 299 + g * 587 + b * 114) / 1000
                    }
                }

                bands == 3 -> {

                    ; TGA stores BGR
                    {
                        img.bands >= 3 -> {
                            buf[dst] = img.data[src + 2]
                            buf[dst + 1] = img.data[src + 1]
                            buf[dst + 2] = img.data[src]
                        }

                        img.bands == 1 -> {
                            v = img.data[src]
                            buf[dst] = v
                            buf[dst + 1] = v
                            buf[dst + 2] = v
                        }
                    }
                }

                bands == 4 -> {

                    ; TGA stores BGRA
                    {
                        img.bands >= 4 -> {
                            buf[dst] = img.data[src + 2]
                            buf[dst + 1] = img.data[src + 1]
                            buf[dst + 2] = img.data[src]
                            buf[dst + 3] = img.data[src + 3]
                        }

                        img.bands == 3 -> {
                            buf[dst] = img.data[src + 2]
                            buf[dst + 1] = img.data[src + 1]
                            buf[dst + 2] = img.data[src]
                            buf[dst + 3] = 255
                        }

                        img.bands == 1 -> {
                            v = img.data[src]
                            buf[dst] = v
                            buf[dst + 1] = v
                            buf[dst + 2] = v
                            buf[dst + 3] = 255
                        }
                    }
                }
            }
        }
    }

    ; Write to file
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, total-size)
    fs.close(wfd)
    ok = true
}

; tga.save-rle: save image as RLE compressed TGA (type 10)
; Note: RLE encoding is complex. For now, falls back to uncompressed save.
; path str: output path
; img image: image (RGB/RGBA)
; returns ok bool
save-rle = (path str, img image) (ok bool) {
    ok = save(path, img)
}
