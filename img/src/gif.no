; gif.no — GIF (Graphics Interchange Format) reader
; Supports GIF89a with:
;   - Global and local color tables
;   - LZW compressed image data
;   - Interlaced images (de-interlacing)
;   - Transparent color (GCE extension)
;
; GIF file layout:
;   Header: 'GIF89a' or 'GIF87a' (6 bytes)
;   Logical screen descriptor (7 bytes): width, height, packed, bgcolor, aspect
;   Global color table (optional)
;   Blocks: extensions (0x21), image descriptors (0x2C), trailer (0x3B)

; ── Load ──

; gif.load: load a GIF file (first frame)
; path str: file path
; returns img ?image: loaded image (RGBA, first frame), nil on error

# /img/src/image.new
# /img/src/image.new-from-data
# /img/src/image.copy
# /img/src/image.fill
# /img/src/image.invert
# /img/src/image.add-const
# /img/src/image.avg
# /img/src/image.min-val
# /img/src/image.max-val
# /img/src/image.get-pixel
# /img/src/image.set-pixel

load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len < 13 -> {
        img = nil
        return
    }

    ; Check GIF signature
    gif-ok = false
    (data[0] & 255) == 71 && (data[1] & 255) == 73 && (data[2] & 255) == 70 -> {
        gif-ok = true
    }
    gif-ok == false -> {
        img = nil
        return
    }

    ; Logical screen descriptor
    w = (data[6] & 255) | ((data[7] & 255) << 8)
    h = (data[8] & 255) | ((data[9] & 255) << 8)
    packed = data[10] & 255
    bg-color = data[11] & 255
    {
        w <= 0 || h <= 0 -> {
            img = nil
            return
        }
    }

    ; Global color table
    gct str = with-len(768)
    pos = 13
    has-gct = (packed & 128) != 0
    gct-size = 0
    has-gct == true -> {
        gct-bits = packed & 7
        gct-size = 1 << (gct-bits + 1)
        i <- [0..gct-size * 3): {
            gct[i] = data[pos + i] & 255
        }
        pos = pos + gct-size * 3
    }

    ; Parse blocks
    transparency = -1
    _d str = with-len(w * h * 4)
    tmp = image.new-from-data(w, h, 4, _d)

    ; Fill with transparent black
    i <- [0..w * h * 4): {
        tmp.data[i] = 0
    }
    {
        pos < data.len -> {
            block = data[pos] & 255
            {
                block == 44 -> {

                    ; Image descriptor (0x2C)
                    ; Process image
                    transparency, pos = gif-process-image(data, pos + 1, tmp, gct, has-gct, transparency)
                }

                block == 33 -> {

                    ; Extension (0x21)
                    pos = pos + 1
                    label = data[pos] & 255
                    pos = pos + 1
                    {
                        label == 249 -> {

                            ; Graphic Control Extension
                            gce-size = data[pos] & 255
                            pos = pos + 1
                            gce-packed = data[pos] & 255
                            has-transp = (gce-packed & 1) != 0
                            pos = pos + 1

                            ; delay time (2 bytes)
                            pos = pos + 2
                            {
                                has-transp == true -> {
                                    transparency = data[pos] & 255
                                }
                            }
                            pos = pos + 1

                            ; block terminator
                            pos = gif-skip-subblocks(data, pos)
                        }

                        -> {

                            ; Other extensions — skip
                            pos = gif-skip-subblocks(data, pos)
                        }
                    }
                }

                block == 59 -> {

                    ; Trailer (0x3B)
                    break
                }

                -> {
                    pos = pos + 1
                }
            }
        }
    } (pos < data.len)
    img = tmp
}

; gif-process-image: process one image descriptor + data
; data str: file content
; pos i64: position after 0x2C marker
; img image: output image (RGBA)
; gct []byte: global color table
; has-gct bool: whether gct is valid
; transp i64: transparent color index (or -1)
; returns new-transp i64, new-pos i64
gif-process-image = (data str, pos i64, img image, gct []byte, has-gct bool, transp i64) (new-transp i64, new-pos i64) {
    new-transp = transp
    new-pos = pos

    ; Image descriptor fields
    left = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    top = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    iw = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    ih = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    packed = data[new-pos] & 255
    new-pos = new-pos + 1

    ; Local color table
    lct str = with-len(768)
    use-lct = false
    {
        (packed & 128) != 0 -> {
            lct-bits = packed & 7
            lct-size = 1 << (lct-bits + 1)
            i <- [0..lct-size * 3): {
                lct[i] = data[new-pos + i] & 255
            }
            new-pos = new-pos + lct-size * 3
            use-lct = true
        }
    }

    ; LZW minimum code size
    min-code = data[new-pos] & 255
    new-pos = new-pos + 1

    ; Collect sub-block data
    block-data []byte = with-cap(65536)
    {
        new-pos < data.len -> {
            block-size = data[new-pos] & 255
            block-size == 0 -> break
            new-pos = new-pos + 1
            i <- [0..block-size): {
                block-data.push(data[new-pos + i] & 255)
            }
            new-pos = new-pos + block-size
        }
    } (new-pos < data.len)

    ; LZW decode
    decoded = gif-lzw-decode(block-data, min-code, iw * ih)

    ; Interlacing
    interlaced = (packed & 64) != 0

    ; Write pixels to image
    {
        decoded.len > 0 -> {
            y <- [0..ih): {
                {
                    interlaced == true -> {

                        ; De-interlace: passes 1-4
                        ; Pass 1: rows 0,8,16,...
                        ; Pass 2: rows 4,12,20,...
                        ; Pass 3: rows 2,6,10,14,...
                        ; Pass 4: rows 1,3,5,7,...
                        actual-y = gif-deinterlace-y(y, ih)
                    }

                    -> {
                        actual-y = y
                    }
                }

                {
                    actual-y < ih -> {
                        x <- [0..iw): {
                            idx = y * iw + x
                            {
                                idx < decoded.len -> {
                                    color-idx = decoded[idx]
                                    dst-y = actual-y + top
                                    dst-x = x + left
                                    {
                                        dst-x >= 0 && dst-x < img.width && dst-y >= 0 && dst-y < img.height -> {
                                            color-idx == new-transp && new-transp >= 0 -> {

                                                ; Transparent
                                                dst = (dst-y * img.width + dst-x) * 4
                                                img.data[dst] = 0
                                                img.data[dst + 1] = 0
                                                img.data[dst + 2] = 0
                                                img.data[dst + 3] = 0
                                            }

                                            -> {

                                                ; Use color table
                                                tbl = gct
                                                use-lct == true -> tbl = lct
                                                r = tbl[color-idx * 3]
                                                g = tbl[color-idx * 3 + 1]
                                                b = tbl[color-idx * 3 + 2]
                                                dst = (dst-y * img.width + dst-x) * 4
                                                img.data[dst] = r
                                                img.data[dst + 1] = g
                                                img.data[dst + 2] = b
                                                img.data[dst + 3] = 255
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; gif-deinterlace-y: map sequential row to actual row for interlaced GIF
; seq-y i64: sequential y (0..height-1)
; h i64: image height
; returns actual-y i64
gif-deinterlace-y = (seq-y i64, h i64) (actual-y i64) {

    ; Count rows per pass
    pass1 = (h + 7) / 8
    pass2 = (h + 3 - 4 + 7) / 8
    {
        h > 4 -> pass2 = (h - 4 + 7) / 8
    }
    {
        seq-y < pass1 -> {
            actual-y = seq-y * 8
            return
        }

        seq-y < pass1 + pass2 -> {
            actual-y = 4 + (seq-y - pass1) * 8
            return
        }
    }

    ; Count pass3 and pass4
    pass3count = (h - 2 + 3) / 4
    {
        h <= 2 -> pass3count = 0
    }
    {
        seq-y < pass1 + pass2 + pass3count -> {
            actual-y = 2 + (seq-y - pass1 - pass2) * 4
            return
        }
    }
    pass4count = (h - 1 + 1) / 2
    {
        h <= 1 -> pass4count = 0
    }
    actual-y = 1 + (seq-y - pass1 - pass2 - pass3count) * 2
}

; gif-skip-subblocks: skip all sub-blocks starting at pos
; data str: data
; pos i64: starting position (at first sub-block size byte)
; returns new-pos i64: position after all sub-blocks
gif-skip-subblocks = (data str, pos i64) (new-pos i64) {
    new-pos = pos
    {
        new-pos < data.len -> {
            block-size = data[new-pos] & 255
            new-pos = new-pos + 1
            block-size == 0 -> break
            new-pos = new-pos + block-size
        }
    } (new-pos < data.len && (data[new-pos] & 255) != 0)
}

; ── LZW decoder ──

; gif-lzw-decode: decode LZW compressed data
; data []byte: compressed data
; min-code i64: minimum code size (2-12)
; expected-len i64: expected decoded length
; returns decoded []byte
gif-lzw-decode = (data []byte, min-code i64, expected-len i64) (decoded []byte) {
    {
        min-code < 2 || min-code > 12 -> {
            decoded str = with-len(0)
            return
        }
    }
    clear-code = 1 << min-code
    end-code = clear-code + 1
    code-size = min-code + 1

    ; Initialize dictionary (max 4096 entries)
    dict-prefix str = with-len(4096)
    dict-suffix str = with-len(4096)
    dict-len = 0

    ; Initialize with base codes
    i <- [0..clear-code): {
        dict-prefix[i] = -1
        dict-suffix[i] = i
    }
    dict-len = end-code + 1

    ; Bit reader state
    bit-buf = 0
    bit-count = 0
    byte-pos = 0
    decoded []byte = with-cap(expected-len)
    prev-code = -1
    {
        byte-pos < data.len -> {

            ; Read bits from data
            {
                bit-count < code-size -> {
                    byte-pos < data.len -> {
                        bit-buf = bit-buf | ((data[byte-pos] & 255) << bit-count)
                        bit-count = bit-count + 8
                        byte-pos = byte-pos + 1
                    }
                }
            } (bit-count < code-size && byte-pos < data.len)
            bit-count < code-size -> break

            ; Extract code
            code = bit-buf & ((1 << code-size) - 1)
            bit-buf = bit-buf >> code-size
            bit-count = bit-count - code-size
            {
                code == clear-code -> {

                    ; Reset
                    code-size = min-code + 1
                    dict-len = end-code + 1
                    prev-code = -1
                }

                code == end-code -> {
                    break
                }

                -> {
                    code < dict-len -> {

                        ; Code in dictionary — output string
                        entry-buf []byte = with-cap(4096)
                        c = code
                        {
                            c >= 0 -> {
                                entry-buf.push(dict-suffix[c])
                                c = dict-prefix[c]
                            }
                        } (c >= 0)

                        ; Reverse entry-buf
                        entry-len = entry-buf.len
                        j <- [0..entry-buf.len / 2): {
                            tmp = entry-buf[j]
                            entry-buf[j] = entry-buf[entry-len - 1 - j]
                            entry-buf[entry-len - 1 - j] = tmp
                        }

                        ; Output
                        j <- [0..entry-buf.len): {
                            decoded.push(entry-buf[j])
                        }

                        ; Add to dictionary
                        {
                            prev-code >= 0 && dict-len < 4096 -> {
                                dict-prefix[dict-len] = prev-code
                                dict-suffix[dict-len] = entry-buf[0]
                                dict-len = dict-len + 1
                                {
                                    dict-len == (1 << code-size) && code-size < 12 -> {
                                        code-size = code-size + 1
                                    }
                                }
                            }
                        }
                        prev-code = code
                    }

                    -> {

                        ; Code not in dictionary yet
                        {
                            code == dict-len && prev-code >= 0 -> {

                                ; Output prev + first of prev
                                entry-buf []byte = with-cap(4096)
                                c = prev-code
                                {
                                    c >= 0 -> {
                                        entry-buf.push(dict-suffix[c])
                                        c = dict-prefix[c]
                                    }
                                } (c >= 0)
                                entry-len = entry-buf.len
                                j <- [0..entry-buf.len / 2): {
                                    tmp = entry-buf[j]
                                    entry-buf[j] = entry-buf[entry-len - 1 - j]
                                    entry-buf[entry-len - 1 - j] = tmp
                                }

                                ; The new entry-buf's first char is same as output's first
                                first-char = entry-buf[0]
                                j <- [0..entry-buf.len): {
                                    decoded.push(entry-buf[j])
                                }

                                ; Add to dictionary
                                {
                                    dict-len < 4096 -> {
                                        dict-prefix[dict-len] = prev-code
                                        dict-suffix[dict-len] = first-char
                                        dict-len = dict-len + 1
                                        {
                                            dict-len == (1 << code-size) && code-size < 12 -> {
                                                code-size = code-size + 1
                                            }
                                        }
                                    }
                                }
                                prev-code = code
                            }
                        }
                    }
                }
            }
        }
    } (byte-pos < data.len)
}

; ── Save (simple) ──

; gif.save: save as GIF89a with global color table (no LZW, uses uncompressed data)
; Note: GIF requires LZW compression. This writes a minimal valid GIF with
; a global color table and LZW-encoded data.
; path str: output path
; img image: image to save (will be quantized to 256 colors)
; returns ok bool
save = (path str, img image) (ok bool) {
    w = img.width
    h = img.height

    ; Build 256-color palette by simple quantization
    palette str = with-len(768)
    used str = with-len(256)
    i <- [0..256): {
        used[i] = 0
    }

    ; Simple 3-3-2 quantization
    npix = w * h
    indexed str = with-len(npix)
    i <- [0..npix): {
        {
            img.bands >= 3 -> {
                r = img.data[i * img.bands] & 248
                g = img.data[i * img.bands + 1] & 248
                b = img.data[i * img.bands + 2] & 192
                idx = (r >> 3) | ((g >> 3) << 3) | ((b >> 6) << 6)
            }

            -> {
                v = img.data[i * img.bands] & 248
                idx = (v >> 3) | (0 << 3) | (0 << 6)
            }
        }
        indexed[i] = idx
        used[idx] = 1
    }

    ; Build palette
    j <- [0..256): {
        palette[j * 3] = (j & 7) << 3
        palette[j * 3 + 1] = ((j >> 3) & 7) << 3
        palette[j * 3 + 2] = ((j >> 6) & 3) << 6
    }

    ; Build output
    buf []byte = with-cap(13 + 768 + 10 + npix * 2)

    ; Header
    buf.push(71); G
    buf.push(73); I
    buf.push(70); F
    buf.push(56); 8
    buf.push(57); 9
    buf.push(97); a

    ; Logical screen descriptor
    buf.push(w & 255)
    buf.push((w >> 8) & 255)
    buf.push(h & 255)
    buf.push((h >> 8) & 255)
    buf.push(247); packed: GCT present, 256 colors
    buf.push(0); background color index
    buf.push(0); pixel aspect ratio

    ; Global color table (256 entries * 3 = 768 bytes)
    i <- [0..768): {
        buf.push(palette[i])
    }

    ; Image descriptor
    buf.push(44); 0x2C
    buf.push(0); left LE
    buf.push(0)
    buf.push(0); top LE
    buf.push(0)
    buf.push(w & 255)
    buf.push((w >> 8) & 255)
    buf.push(h & 255)
    buf.push((h >> 8) & 255)
    buf.push(0); no local color table, not interlaced

    ; LZW minimum code size
    buf.push(8)

    ; LZW encode
    lzw-data = gif-lzw-encode(indexed, npix, 8)

    ; Write in sub-blocks (max 255 bytes each)
    i = 0
    {
        i < lzw-data.len -> {
            block-size = lzw-data.len - i
            block-size > 255 -> block-size = 255
            buf.push(block-size)
            j <- [0..block-size): {
                buf.push(lzw-data[i + j])
            }
            i = i + block-size
        }
    } (i < lzw-data.len)
    buf.push(0); block terminator
    buf.push(59); trailer 0x3B

    ; Write file
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, buf.len)
    fs.close(wfd)
    ok = true
}

; gif-lzw-encode: simple LZW encoder
; data []byte: input data (indexed pixels)
; data-len i64: data length
; min-code i64: minimum code size
; returns encoded []byte
gif-lzw-encode = (data []byte, data-len i64, min-code i64) (encoded []byte) {
    clear-code = 1 << min-code
    end-code = clear-code + 1
    code-size = min-code + 1

    ; Initialize dictionary
    dict-prefix str = with-len(4096)
    dict-key str = with-len(4096)
    dict-len = end-code + 1

    ; Bit writer state
    bit-buf = 0
    bit-count = 0
    encoded []byte = with-cap(data.len)

    ; Output clear code
    bit-buf = bit-buf | (clear-code << bit-count)
    bit-count = bit-count + code-size
    {
        bit-count >= 8 -> {
            encoded.push(bit-buf & 255)
            bit-buf = bit-buf >> 8
            bit-count = bit-count - 8
        }
    } (bit-count >= 8)

    ; LZW encode
    i = 0
    {
        i < data.len -> {
            cur = data[i]

            ; Try to find cur in dictionary starting from end-code+1
            found = -1
            j <- [end-code + 1..dict-len): {
                {
                    dict-prefix[j] == -1 -> {
                        ; Check if this matches the last code + cur
                        ; Simplified: just use single-char codes
                    }
                }
            }

            ; Simplified LZW: always output single char + add to dict
            {
                cur < clear-code -> {
                    code = cur
                }

                -> {
                    code = 0
                }
            }
            bit-buf = bit-buf | (code << bit-count)
            bit-count = bit-count + code-size
            {
                bit-count >= 8 -> {
                    encoded.push(bit-buf & 255)
                    bit-buf = bit-buf >> 8
                    bit-count = bit-count - 8
                }
            } (bit-count >= 8)
            {
                dict-len < 4096 -> {
                    dict-len = dict-len + 1
                    {
                        dict-len == (1 << code-size) && code-size < 12 -> {
                            code-size = code-size + 1
                        }
                    }
                }

                -> {

                    ; Reset
                    bit-buf = bit-buf | (clear-code << bit-count)
                    bit-count = bit-count + code-size
                    {
                        bit-count >= 8 -> {
                            encoded.push(bit-buf & 255)
                            bit-buf = bit-buf >> 8
                            bit-count = bit-count - 8
                        }
                    } (bit-count >= 8)
                    dict-len = end-code + 1
                    code-size = min-code + 1
                }
            }

            i = i + 1
        }
    } (i < data.len)

    ; Output end code
    bit-buf = bit-buf | (end-code << bit-count)
    bit-count = bit-count + code-size
    {
        bit-count >= 8 -> {
            encoded.push(bit-buf & 255)
            bit-buf = bit-buf >> 8
            bit-count = bit-count - 8
        }
    } (bit-count >= 8)
    {
        bit-count > 0 -> {
            encoded.push(bit-buf & 255)
        }
    }
}
