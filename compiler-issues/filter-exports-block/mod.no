; Repro for Issue 7: filterByExports drops helpers whose ONLY call site is
; inside a nested `{ ... }` group. `lib.no` exports just `public-fn`, so the
; compiler has to discover `nested-helper` transitively by walking public-fn's body.
public-fn = (x i64) (r i64) {
    {
        x > 0 -> {
            {
                x > 1 -> {
                    r = nested-helper(x)
                }

                -> {
                    r = 0
                }
            }
        }

        -> {
            r = 0
        }
    }
    return
}

nested-helper = (x i64) (r i64) {
    r = x + 1
    return
}
