; probe module: three neighbouring read-block helpers.
; -420 / -444 have IDENTICAL parameter signatures, read-block does not.
read-block = (ox i64, oy i64, band i64, w i64, h i64, mode i64) (block i64) {
    block = ox + oy + band + w + h + mode
    return
}

read-block-420 = (ox i64, oy i64, w i64, h i64, cbcr i64) (block i64) {
    block = ox + oy + w + h + cbcr
    return
}

read-block-444 = (ox i64, oy i64, w i64, h i64, cbcr i64) (block i64) {
    block = ox + oy + w + h + cbcr + 1
    return
}

dct-8x8 = (v i64) (out i64) {
    out = v * 2
    return
}
