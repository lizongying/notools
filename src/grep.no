// grep.no — grep utility
// Search for patterns in files or stdin
// Usage: grep [-n] pattern [files...]
//   -n: show line numbers

grep-run = () {
    argc = args()

    show-line-num = false
    pattern = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-n' -> show-line-num = true
        !a.starts-with('-') -> {
            pattern.len == 0 -> pattern = a
            -> files.push(a)
        }
    }

    pattern.len == 0 -> {
        print('grep: no pattern specified')
        os.exit(1)
    }

    files.len == 0 -> {
        grep-stdin(pattern, show-line-num)
    }
    files.len > 0 -> {
        i <- [0..files.len): {
            grep-file(files[i], pattern, show-line-num, files.len > 1)
        }
    }
}

grep-stdin = (pattern str, show-line-num bool) {
    line-num = 0
    !! {
        line, ok = fs.get-line()
        ok == false -> return
        line-num = line-num + 1
        pos = line.index(pattern)
        pos >= 0 -> {
            show-line-num -> printf('%d:', line-num)
            print(line)
        }
    }
}

grep-file = (file str, pattern str, show-line-num bool, show-filename bool) {
    content = fs.read-file(file)
    lines = content.split('\n')
    i <- [0..lines.len): {
        line = lines[i]
        pos = line.index(pattern)
        pos >= 0 -> {
            show-filename -> printf('%s:', file)
            show-line-num -> printf('%d:', i + 1)
            print(line)
        }
    }
}