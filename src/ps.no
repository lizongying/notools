// ps.no — process status utility
// List running processes
// Usage: ps [options]
//   No options: simple list of processes
//   -e: show all processes
//   -f: full format

ps-run = () {
    argc = args()

    all = false
    full = false

    i <- [2..argc): {
        a = arg(i)
        a == '-e' -> all = true
        a == '-f' -> full = true
    }

    ps-list(all, full)
}

ps-list = (all bool, full bool) {
    proc-dir = '/proc'
    entries = fs.list-dir(proc-dir)

    full -> {
        print('UID        PID  PPID  C STIME TTY          TIME CMD')
    }
    -> {
        print('  PID TTY          TIME CMD')
    }

    i <- [0..entries.len): {
        name = entries[i]
        is-num = true
        j <- [0..name.len): {
            c = name[j]
            c < '0' || c > '9' -> is-num = false
        }
        !is-num -> continue

        pid = 0
        j <- [0..name.len): {
            pid = pid * 10 + (name[j] - '0')
        }

        cmdline-path = proc-dir - '/' - name - '/cmdline'
        stat-path = proc-dir - '/' - name - '/status'

        cmd = ''
        cmdline-content = fs.read-file(cmdline-path)
        k <- [0..cmdline-content.len): {
            c = cmdline-content[k]
            c == 0 -> break
            cmd = cmd + c
        }
        cmd.len == 0 -> cmd = '[unknown]'

        full -> {
            uid = '0'
            ppid = '0'
            c = '0'
            stime = '?'
            tty = '?'
            time = '00:00:00'

            stat-content = fs.read-file(stat-path)
            lines []str
            current-line = ''
            m <- [0..stat-content.len): {
                ch = stat-content[m]
                ch == '\n' -> {
                    lines.push(current-line)
                    current-line = ''
                }
                -> current-line = current-line + ch
            }
            lines.push(current-line)

            n <- [0..lines.len): {
                line = lines[n]
                idx = line.index('Uid:')
                idx >= 0 -> {
                    uid = ps-parse-value(line)
                }
                idx = line.index('PPid:')
                idx >= 0 -> {
                    ppid = ps-parse-value(line)
                }
            }

            printf('%s %8d %5s %2s %5s %s %10s %s\n', uid, pid, ppid, c, stime, tty, time, cmd)
        }
        !full -> {
            printf(' %5d %s %10s %s\n', pid, 'pts/0', '00:00:00', cmd)
        }
    }
}

ps-parse-value = (line str) (val str) {
    colon = line.index(':')
    colon < 0 -> return ''
    start = colon + 1
    i <- [start..line.len): {
        c = line[i]
        c != ' ' && c != '\t' -> break
        start = start + 1
    }
    end = start
    i <- [end..line.len): {
        c = line[i]
        c == ' ' || c == '\t' || c == '\n' -> break
        end = end + 1
    }
    val = ''
    i <- [start..end): {
        val = val + line[i]
    }
}