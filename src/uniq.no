// uniq.no — uniq utility
// Remove duplicate consecutive lines
// Usage: uniq [-c] [-d] [files...]
//   -c: count occurrences
//   -d: show only duplicates
//   files: files to process (read from stdin if none)

uniq-run = () {
    argc = args()

    count = false
    duplicates-only = false
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-c' -> count = true
        a == '-d' -> duplicates-only = true
        !a.starts-with('-') -> files.push(a)
    }

    lines []str

    files.len == 0 -> {
        read-stdin-lines(lines)
    }
    files.len > 0 -> {
        i <- [0..files.len): {
            read-file-lines(files[i], lines)
        }
    }

    uniq-lines(lines, count, duplicates-only)
}

read-stdin-lines = (lines []str) {
    !! {
        line, ok = fs.get-line()
        ok == false -> return
        lines.push(line)
    }
}

read-file-lines = (file str, lines []str) {
    content = fs.read-file(file)
    file-lines = content.split('\n')
    i <- [0..file-lines.len): {
        lines.push(file-lines[i])
    }
}

uniq-lines = (lines []str, count bool, duplicates-only bool) {
    lines.len == 0 -> return

    prev = lines[0]
    cnt = 1

    i <- [1..lines.len): {
        curr = lines[i]
        curr == prev -> {
            cnt = cnt + 1
        }
        curr != prev -> {
            print-entry(prev, cnt, count, duplicates-only)
            prev = curr
            cnt = 1
        }
    }
    print-entry(prev, cnt, count, duplicates-only)
}

print-entry = (line str, cnt i64, show-count bool, duplicates-only bool) {
    duplicates-only && cnt == 1 -> return
    show-count -> printf('%d ', cnt)
    print(line)
}