// unzip.no — unzip utility
// List and extract zip archives
// Usage: unzip [-l] archive.zip [files...]
//   -l: list contents only
//   archive.zip: zip archive to extract
//   files: optional files to extract

unzip-run = () {
    argc = args()

    list-only = false
    filename = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-l' -> list-only = true
        !a.starts-with('-') -> {
            filename.len == 0 -> filename = a
            -> files.push(a)
        }
    }

    filename.len == 0 -> {
        print('unzip: no archive specified')
        os.exit(1)
    }

    list-only -> {
        unzip-list(filename)
    }
    -> {
        unzip-extract(filename, files)
    }
}

unzip-list = (filename str) {
    raw = fs.read-file(filename)
    data []byte
    i <- [0..raw.len): {
        data[i] = raw[i]
    }

    archive = zip{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        sz = archive.size(i)
        method = archive.method(i)
        print(name)
    }
}

unzip-extract = (filename str, wanted []str) {
    raw = fs.read-file(filename)
    data []byte
    i <- [0..raw.len): {
        data[i] = raw[i]
    }

    archive = zip{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        typ = archive.type(i)

        wanted.len > 0 -> {
            found = false
            j <- [0..wanted.len): {
                wanted[j] == name -> found = true
            }
            !found -> continue
        }

        name.ends-with('/') -> {
            os.mkdir(name, 493)
        }
        -> {
            content = archive.extract(i)
            fs.write-file(name, content)
        }
    }
}