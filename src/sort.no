// sort.no — sort utility
// Sort lines alphabetically
// Usage: sort [-r] [files...]
//   -r: reverse order
//   files: files to sort (read from stdin if none)

sort-run = () {
    argc = args()

    reverse = false
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-r' -> reverse = true
        !a.starts-with('-') -> files.push(a)
    }

    lines []str

    files.len == 0 -> {
        read-stdin-lines(lines)
    }
    files.len > 0 -> {
        i <- [0..files.len): {
            read-file-lines(files[i], lines)
        }
    }

    sort-lines(lines, reverse)

    print-lines(lines)
}

read-stdin-lines = (lines []str) {
    content = fs.read-file('/dev/stdin')
    file-lines = content.split('\n')
    i <- [0..file-lines.len): {
        lines.push(file-lines[i])
    }
}

read-file-lines = (file str, lines []str) {
    content = fs.read-file(file)
    file-lines = content.split('\n')
    i <- [0..file-lines.len): {
        lines.push(file-lines[i])
    }
}

sort-lines = (lines []str, reverse bool) {
    n = lines.len
    i <- [0..n): {
        j <- [0..n - i - 1): {
            cmp = lines[j].compare(lines[j + 1])
            swap = false
            reverse -> swap = cmp < 0
            !reverse -> swap = cmp > 0
            swap -> {
                temp = lines[j]
                lines[j] = lines[j + 1]
                lines[j + 1] = temp
            }
        }
    }
}

print-lines = (lines []str) {
    i <- [0..lines.len): {
        s = lines[i]
        print(s)
    }
}