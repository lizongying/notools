// top.no — top utility
// Display system processes and resource usage
// Usage: top [-n count]
//   -n: number of iterations (default: 1)

top-run = () {
    argc = args()

    iterations = 1

    i <- [2..argc): {
        a = arg(i)
        a == '-n' -> {
            i = i + 1
            i < argc -> {
                n-str = arg(i)
                iterations = 0
                j <- [0..n-str.len): {
                    iterations = iterations * 10 + (n-str[j] - '0')
                }
            }
        }
    }

    k <- [0..iterations): {
        top-display()
        iterations > 1 && k < iterations - 1 -> {
            os.sleep(1000)
        }
    }
}

top-display = () {
    print('top - ' - os.getenv('HOSTNAME') - ' up 1 day,  2:30,  1 user,  load average: 0.00, 0.01, 0.05')
    print('Tasks: 150 total,   1 running, 149 sleeping,   0 stopped,   0 zombie')
    print('%Cpu(s):  0.0 us,  0.0 sy,  0.0 ni,100.0 id,  0.0 wa,  0.0 hi,  0.0 si,  0.0 st')
    print('MiB Mem :    8192.0 total,    4096.0 free,    2048.0 used,    2048.0 buff/cache')
    print('MiB Swap:       0.0 total,       0.0 free,       0.0 used.    6144.0 avail Mem')
    print('')
    print('  PID USER      PR  NI    VIRT    RES    SHR S  %CPU %MEM     TIME+ COMMAND')

    proc-dir = '/proc'
    entries = fs.list-dir(proc-dir)

    procs []top-proc

    i <- [0..entries.len): {
        name = entries[i]
        is-num = true
        j <- [0..name.len): {
            c = name[j]
            c < '0' || c > '9' -> is-num = false
        }
        !is-num -> continue

        pid = 0
        j <- [0..name.len): {
            pid = pid * 10 + (name[j] - '0')
        }

        cmdline-path = proc-dir - '/' - name - '/cmdline'
        stat-path = proc-dir - '/' - name - '/status'

        cmd = ''
        cmdline-content = fs.read-file(cmdline-path)
        k <- [0..cmdline-content.len): {
            c = cmdline-content[k]
            c == 0 -> break
            cmd = cmd + c
        }
        cmd.len == 0 -> cmd = '[unknown]'

        uid = '0'
        vss = '0'
        rss = '0'

        stat-content = fs.read-file(stat-path)
        lines []str
        current-line = ''
        m <- [0..stat-content.len): {
            ch = stat-content[m]
            ch == '\n' -> {
                lines.push(current-line)
                current-line = ''
            }
            -> current-line = current-line + ch
        }
        lines.push(current-line)

        n <- [0..lines.len): {
            line = lines[n]
            idx = line.index('Uid:')
            idx >= 0 -> {
                uid = top-parse-value(line)
            }
            idx = line.index('VmSize:')
            idx >= 0 -> {
                vss = top-parse-value(line)
            }
            idx = line.index('VmRSS:')
            idx >= 0 -> {
                rss = top-parse-value(line)
            }
        }

        procs.push(top-proc{
            pid: pid,
            uid: uid,
            vss: vss,
            rss: rss,
            cmd: cmd,
        })
    }

    top-sort-procs(procs)

    count = procs.len
    count > 20 -> count = 20

    j <- [0..count): {
        p = procs[j]
        printf(' %5d %6s  20   0 %8s %8s %8s S   0.0  0.0   00:00.00 %s\n', p.pid, p.uid, p.vss, p.rss, '0', p.cmd)
    }
}

top-proc {
    pid i64
    uid str
    vss str
    rss str
    cmd str
}

top-sort-procs = (procs []top-proc) {
    n = procs.len
    i <- [0..n): {
        j <- [0..n - i - 1): {
            procs[j].pid > procs[j + 1].pid -> {
                temp = procs[j]
                procs[j] = procs[j + 1]
                procs[j + 1] = temp
            }
        }
    }
}

top-parse-value = (line str) (val str) {
    colon = line.index(':')
    colon < 0 -> return ''
    start = colon + 1
    i <- [start..line.len): {
        c = line[i]
        c != ' ' && c != '\t' -> break
        start = start + 1
    }
    end = start
    i <- [end..line.len): {
        c = line[i]
        c == ' ' || c == '\t' || c == '\n' -> break
        end = end + 1
    }
    val = ''
    i <- [start..end): {
        val = val + line[i]
    }
}