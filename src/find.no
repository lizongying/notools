// find.no — find utility
// Recursively search for files by name
// Usage: find [path] [-name pattern] [-type f|d]
//   path: starting directory (default: '.')
//   -name pattern: filter by filename containing pattern
//   -type f: only files
//   -type d: only directories

find-run = () {
    argc = args()

    path = '.'
    name-pattern = ''
    type-filter = ''

    i <- [2..argc): {
        a = arg(i)
        a == '-name' -> {
            i = i + 1
            i < argc -> name-pattern = arg(i)
        }
        a == '-type' -> {
            i = i + 1
            i < argc -> type-filter = arg(i)
        }
        !a.starts-with('-') -> path = a
    }

    find-path(path, name-pattern, type-filter)
}

find-path = (dir str, pattern str, type str) {
    entries = fs.list-dir(dir)
    i <- [0..entries.len): {
        name = entries[i]
        name == '.' || name == '..' -> continue

        full = dir - '/' - name
        is-dir = fs.is-dir(full)

        match-type = true
        type == 'f' -> match-type = !is-dir
        type == 'd' -> match-type = is-dir

        match-name = true
        pattern.len > 0 -> match-name = name.contains(pattern)

        match-type && match-name -> print(full)

        is-dir -> find-path(full, pattern, type)
    }
}
