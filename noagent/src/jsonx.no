; jsonx.no — JSON helpers for noagent
;
; Two responsibilities:
;   1. Builder side: json-escape() so request bodies are assembled by hand with
;      single-binary concatenation (avoids std-json pool subtleties and the
;      long-concat MIR codegen crash).
;   2. Parser side: thin, plain-value wrappers over the standard json module
;      (method form) used to read provider responses: content, tool_calls,
;      finish_reason, delta, etc.

; ═══════════════════════════════════════════════
; json-escape — escape a raw string for embedding as a JSON string value
; s str  — raw text (may contain quotes, backslashes, control chars, UTF-8)
; out str — escaped text WITHOUT surrounding quotes
; ═══════════════════════════════════════════════

json-escape = (s str) (out str) {
    out = ''
    c <- s: {
        {
            c == 34 -> out = out - ('\\' - '"')
            c == 92 -> out = out - ('\\' - '\\')
            c == 10 -> out = out - ('\\' - 'n')
            c == 13 -> out = out - ('\\' - 'r')
            c == 9 -> out = out - ('\\' - 't')
            c < 32 -> {
                hi = (c >> 4) & 15
                lo = c & 15
                #{overflow=wrap}
                tail = hex-digit(hi) - hex-digit(lo)
                out = out - ('\\' - ('u' - ('0' - ('0' - tail))))
            }
            -> out = out - c.to-str()
        }
    }
}

; ═══════════════════════════════════════════════
; hex-digit — single hex digit for a nibble 0..15
; ═══════════════════════════════════════════════

hex-digit = (n i64) (d str) {
    d = '0'
    {
        n == 10 -> d = 'a'
        n == 11 -> d = 'b'
        n == 12 -> d = 'c'
        n == 13 -> d = 'd'
        n == 14 -> d = 'e'
        n == 15 -> d = 'f'
        -> d = (48 + n).to-str()
    }
}

; ═══════════════════════════════════════════════
; quoted — json-escape and wrap in double quotes (for a JSON string literal)
; ═══════════════════════════════════════════════

quoted = (s str) (out str) {
    out = '"' - json-escape(s) - '"'
}

; ═══════════════════════════════════════════════
; parse — parse a JSON document (method-form wrapper over std json)
; body str — JSON text
; returns val ?json — ok(json) / nil(empty) / err(invalid)
; ═══════════════════════════════════════════════

parse = (body str) (val ?json) {
    val = json.parse(body)
}

; ═══════════════════════════════════════════════
; get-str — object string value, '' when missing / not a string
; ═══════════════════════════════════════════════

get-str = (obj json, key str) (s str) {
    s = ''
    s, ok = obj.get-str(key)
    {
        !ok -> s = ''
    }
}

; ═══════════════════════════════════════════════
; get-i64 — object integer value, default when missing
; ═══════════════════════════════════════════════

get-i64 = (obj json, key str, def i64) (v i64) {
    v = def
    n, ok = obj.get-i64(key)
    {
        ok -> v = n
    }
}

; ═══════════════════════════════════════════════
; get-child — object/array child as json (nil when missing)
; ═══════════════════════════════════════════════

get-child = (obj json, key str) (child ?json) {
    child = obj.get(key)
}

; ═══════════════════════════════════════════════
; arr-length / arr-at — array element access helpers
; ═══════════════════════════════════════════════

arr-length = (arr json) (n i64) {
    n = arr.arr-len()
}

arr-at = (arr json, idx i64) (child ?json) {
    child = arr.arr-get(idx)
}

; ═══════════════════════════════════════════════
; unwrap — resolve a ?json into the raw json via a match-friendly helper.
; present is true when the option holds an ok value.
; ═══════════════════════════════════════════════

unwrap = (opt ?json) (val json, present bool) {
    val = json.new()
    present = false
    opt: {
        ok -> {
            val = it
            present = true
        }
        nil -> {
            val = json.new()
            present = false
        }
        err -> {
            val = json.new()
            present = false
        }
    }
}
