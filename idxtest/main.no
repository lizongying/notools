# /git/src/util
zclike = (data str) (out str) {
    nblocks = 1
    data.len > 0 -> nblocks = (data.len + 65534) / 65535
    total = 2 + nblocks * 5 + data.len + 4
    out = with-len(total)
    out[0] = 0x78
    out[1] = 0x9c
    pos = 2
    remaining = data.len
    off = 0
    {
        remaining <= 0 -> break
        chunk = remaining
        chunk > 65535 -> chunk = 65535
        last = (chunk == remaining)
        hdr = 0
        last == true -> hdr = 1
        out[pos] = hdr
        pos = pos + 1
        out[pos] = chunk & 0xff
        pos = pos + 1
        out[pos] = (chunk >> 8) & 0xff
        pos = pos + 1
        nlen = (~chunk) & 0xffff
        out[pos] = nlen & 0xff
        pos = pos + 1
        out[pos] = (nlen >> 8) & 0xff
        pos = pos + 1
        i <- [0..chunk): {
            out[pos + i] = data[off + i]
        }
        pos = pos + chunk
        off = off + chunk
        remaining = remaining - chunk
    } (true)
    ; SECOND loop reading data (like z-adler32) — the suspected trigger
    a = 1
    b = 0
    j <- [0..data.len): {
        a = (a + data[j]) % 65521
        b = (b + a) % 65521
    }
    s = ((b << 16) | a) & 0xffffffff
    out[pos] = (s >> 24) & 0xff
    pos = pos + 1
    out[pos] = (s >> 16) & 0xff
    pos = pos + 1
    out[pos] = (s >> 8) & 0xff
    pos = pos + 1
    out[pos] = s & 0xff
}

main = () () {
    hdr str = 'blob' - ' ' - '5' - '\0'
    content str = 'hello'
    full str = with-len(hdr.len + content.len)
    i <- [0..hdr.len): { full[i] = hdr[i] }
    i <- [0..content.len): { full[hdr.len + i] = content[i] }
    comp = zclike(full)
    fd = fs.open-write('/tmp/idxtest_h.bin')
    j <- [0..comp.len): {
        cs str = with-len(1)
        cs[0] = comp[j]
        fs.write(fd, cs, 1)
    }
    fs.close(fd)
    print('done')
}
