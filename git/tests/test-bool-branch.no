; Test bool variable in branch selection

# /git/src/util

main = () {
    print('--- Test bool in branch ---')

    content = 'line1\nline2\nline3'
    pos = 0
    result = ''

    {
        pos >= content.len -> break
        nl = util.find-byte-str(content, 10, pos)
        end = content.len
        nl >= 0 -> end = nl
        line = util.str-range(content, pos, end)

        is-sec = line.starts-with('line')
        is-sec -> {
            print('matched: ')
            print(line)
            result = result - line - '\n'
        }
        is-sec == false -> {
            print('not matched: ')
            print(line)
            result = result - line - '\n'
        }

        pos = nl + 1
        nl < 0 -> break
    } (true)

    print('result:')
    print(result)

    0
}
