; Test 6b: repository module — path helpers and discover

# /git/src/util
# /git/src/repository

main = () {
    print('--- Testing repository: paths & discover ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-repo-paths'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    ; path helpers
    objects-dir = repository.git-objects-dir(git-dir)
    {
        objects-dir == (git-dir - '/objects/') -> print('PASS: git-objects-dir')

        -> print('FAIL: git-objects-dir')
    }
    refs-dir = repository.git-refs-dir(git-dir)
    {
        refs-dir == (git-dir - '/refs/') -> print('PASS: git-refs-dir')

        -> print('FAIL: git-refs-dir')
    }
    heads-dir = repository.git-heads-dir(git-dir)
    {
        heads-dir == (git-dir - '/refs/heads/') -> print('PASS: git-heads-dir')

        -> print('FAIL: git-heads-dir')
    }
    tags-dir = repository.git-tags-dir(git-dir)
    {
        tags-dir == (git-dir - '/refs/tags/') -> print('PASS: git-tags-dir')

        -> print('FAIL: git-tags-dir')
    }
    head-path = repository.git-head-path(git-dir)
    {
        head-path == (git-dir - '/HEAD') -> print('PASS: git-head-path')

        -> print('FAIL: git-head-path')
    }
    config-path = repository.git-config-path(git-dir)
    {
        config-path == (git-dir - '/config') -> print('PASS: git-config-path')

        -> print('FAIL: git-config-path')
    }
    index-path = repository.git-index-path(git-dir)
    {
        index-path == (git-dir - '/index') -> print('PASS: git-index-path')

        -> print('FAIL: git-index-path')
    }
    ; repo-discover
    d-git-dir, d-work-tree, d-ok = repository.repo-discover(test-dir)
    {
        d-ok == true -> print('PASS: repo-discover ok')

        -> print('FAIL: repo-discover ok')
    }
    {
        d-git-dir == git-dir -> print('PASS: repo-discover git-dir')

        -> print('FAIL: repo-discover git-dir')
    }
    {
        d-work-tree == test-dir -> print('PASS: repo-discover work-tree')

        -> print('FAIL: repo-discover work-tree')
    }
    ; bare repo init
    bare-dir = cwd - '/tests/tmp-bare-test'
    bare-gd, bare-ok = repository.repo-init(bare-dir, true)
    {
        bare-ok == true -> print('PASS: bare repo-init')

        -> print('FAIL: bare repo-init')
    }
    {
        bare-gd == bare-dir -> print('PASS: bare git-dir')

        -> print('FAIL: bare git-dir')
    }
    {
        fs.is-dir(bare-dir - '/objects') -> print('PASS: bare objects dir')

        -> print('FAIL: bare objects dir')
    }
    {
        fs.is-file(bare-dir - '/HEAD') -> print('PASS: bare HEAD')

        -> print('FAIL: bare HEAD')
    }
    ; discover bare repo
    bd-gd, bd-wt, bd-ok = repository.repo-discover(bare-dir)
    {
        bd-ok == true -> print('PASS: discover bare ok')

        -> print('FAIL: discover bare ok')
    }
    {
        bd-gd == bare-dir -> print('PASS: discover bare git-dir')

        -> print('FAIL: discover bare git-dir')
    }
    {
        bd-wt == '' -> print('PASS: discover bare work-tree')

        -> print('FAIL: discover bare work-tree')
    }
    0
}
