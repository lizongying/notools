; Test 5b: config module — config-set with subsections and case-insensitivity

# /git/src/util
# /git/src/config
# /git/src/repository

main = () {
    print('--- Testing config: advanced ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-cfg-adv'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    ; config-set user.name and email
    config.config-set(git-dir, 'user', 'name', 'Updated User')
    config.config-set(git-dir, 'user', 'email', 'test@example.com')

    ; config-set with subsection (remote.origin.url)
    config.config-set(git-dir, 'remote.origin', 'url', 'git@example.com:repo.git')
    config.config-set(git-dir, 'remote.origin', 'fetch', '+refs/heads/*:refs/remotes/origin/*')

    ; Test subsection lookup
    ru, ru-ok = config.config-get(git-dir, 'remote.origin', 'url')
    {
        ru-ok == true -> print('PASS: subsection url ok')

        -> print('FAIL: subsection url ok')
    }
    ru == 'git@example.com:repo.git' -> print('PASS: subsection url value') -> print('FAIL: subsection url value: ' - ru)

    ; Test subsection fetch
    rf, rf-ok = config.config-get(git-dir, 'remote.origin', 'fetch')
    {
        rf-ok == true -> print('PASS: subsection fetch ok')

        -> print('FAIL: subsection fetch ok')
    }
    {
        rf == '+refs/heads/*:refs/remotes/origin/*' -> print('PASS: subsection fetch value')

        -> print('FAIL: subsection fetch value')
    }
    ; Test case-insensitive section
    cu, cu-ok = config.config-get(git-dir, 'CORE', 'BARE')
    {
        cu-ok == true -> print('PASS: case-insensitive core ok')

        -> print('FAIL: case-insensitive core ok')
    }
    {
        cu == 'false' -> print('PASS: case-insensitive core value')

        -> print('FAIL: case-insensitive core value')
    }
    ; Test get-user-name from config
    un, un-ok = config.get-user-name(git-dir)
    {
        un-ok == true -> print('PASS: get-user-name ok')

        -> print('FAIL: get-user-name ok')
    }
    {
        un == 'Updated User' -> print('PASS: get-user-name value')

        -> print('FAIL: get-user-name value')
    }
    ; Test get-user-email from config
    ue, ue-ok = config.get-user-email(git-dir)
    {
        ue-ok == true -> print('PASS: get-user-email ok')

        -> print('FAIL: get-user-email ok')
    }
    {
        ue == 'test@example.com' -> print('PASS: get-user-email value')

        -> print('FAIL: get-user-email value')
    }
    0
}
