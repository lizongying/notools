; Test 7b: refs module — branch and tag management

# /git/src/util
# /git/src/oid
# /git/src/refs
# /git/src/repository

main = () {
    print('--- Testing refs: branches & tags ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-refs-br'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    ; set up main branch
    main-oid = oid.hash-object('blob', 'main data')
    refs.write-ref(git-dir, 'refs/heads/main', main-oid)

    ; create-branch
    branch2-oid = oid.hash-object('blob', 'branch2')
    refs.write-ref(git-dir, 'refs/heads/main', branch2-oid)
    cb-ok = refs.create-branch(git-dir, 'dev', branch2-oid)
    {
        cb-ok == true -> print('PASS: create-branch dev')

        -> print('FAIL: create-branch dev')
    }
    ; create-branch again should fail
    cb-ok2 = refs.create-branch(git-dir, 'dev', branch2-oid)
    {
        cb-ok2 == false -> print('PASS: duplicate branch fails')

        -> print('FAIL: duplicate branch should fail')
    }
    ; list-branches
    bnames, bcount = refs.list-branches(git-dir)
    {
        bcount == 2 -> print('PASS: list-branches count = 2')

        -> print('FAIL: list-branches count should be 2')
    }
    ; delete-branch
    db-ok = refs.delete-branch(git-dir, 'dev')
    {
        db-ok == true -> print('PASS: delete-branch')

        -> print('FAIL: delete-branch dev')
    }
    junk-bn str
    junk-bn, bcount2 = refs.list-branches(git-dir)
    {
        bcount2 == 1 -> print('PASS: count after delete = 1')

        -> print('FAIL: count after delete should be 1')
    }
    ; tag management
    tag-oid = oid.hash-object('blob', 'tag test')
    ct-ok = refs.create-tag(git-dir, 'v1.0', tag-oid)
    {
        ct-ok == true -> print('PASS: create-tag v1.0')

        -> print('FAIL: create-tag v1.0')
    }
    ; create-tag again should fail
    ct-ok2 = refs.create-tag(git-dir, 'v1.0', tag-oid)
    {
        ct-ok2 == false -> print('PASS: duplicate tag fails')

        -> print('FAIL: duplicate tag should fail')
    }
    ; list-tags
    tnames, tcount = refs.list-tags(git-dir)
    {
        tcount == 1 -> print('PASS: list-tags count = 1')

        -> print('FAIL: list-tags count should be 1')
    }
    ; delete-tag
    dt-ok = refs.delete-tag(git-dir, 'v1.0')
    {
        dt-ok == true -> print('PASS: delete-tag')

        -> print('FAIL: delete-tag v1.0')
    }
    junk-tn str
    junk-tn, tcount2 = refs.list-tags(git-dir)
    {
        tcount2 == 0 -> print('PASS: tags after delete = 0')

        -> print('FAIL: tags after delete should be 0')
    }
    0
}
