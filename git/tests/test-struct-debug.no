; Debug: test struct literal with nested struct

# /git/src/util

person-info {
    name str
    email str
    time i64
    tz str
}

outer {
    author person-info
    message str
}

main = () () {
    a-name = 'Author Name'
    a-email = 'author@test.com'
    a-time = 1112911993
    a-tz = '+0000'
    
    o = outer {
        author: person-info { name: a-name, email: a-email, time: a-time, tz: a-tz }
        message: 'test'
    }
    
    print('author name:')
    print(o.author.name)
    print('author email:')
    print(o.author.email)
    print('author time:')
    print(o.author.time)
    print('author tz:')
    print(o.author.tz)
    print('message:')
    print(o.message)
    0
}
