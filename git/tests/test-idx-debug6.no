; Debug: is it the second index-add call?

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    ; read before second add
    nm1, oid1, mode1, ok1 = index.read-index-entry-at(git-dir, 0)
    print('before 2nd add nm:')
    print(nm1)

    ; Now call index-add again (this calls read-index internally)
    blob2 = object.write-blob(git-dir, 'content2')
    index.index-add(git-dir, 'file2.txt', blob2, 33188)

    ; read after second add
    nm2, oid2, mode2, ok2 = index.read-index-entry-at(git-dir, 0)
    print('after 2nd add nm:')
    print(nm2)
    print('after 2nd add len:')
    print(nm2.len)

    ; read-index to verify
    names, hexoids, modes, count, ok = index.read-index(git-dir)
    print('read-index count:')
    print(count)
    print('read-index names:')
    print(names)

    0
}
