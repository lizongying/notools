; Test 8a: index module — add and read

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () () {
    print('--- Testing index: add & read ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-add'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')
        -> print('FAIL: repo-init')
    }
    ; read-index on empty repo should fail (no index file)
    junk-n str
    junk-h str
    junk-m str
    junk-c i64
    junk-n, junk-h, junk-m, junk-c, empty-ok = index.read-index(git-dir)
    {
        empty-ok == false -> print('PASS: empty index fails')
        -> print('FAIL: read-index on empty should fail')
    }
    ; write a blob and add to index
    blob1 = object.write-blob(git-dir, 'content1')
    ia-ok = index.index-add(git-dir, 'file1.txt', blob1, 33188)
    {
        ia-ok == true -> print('PASS: index-add')
        -> print('FAIL: index-add file1 ok')
    }
    ; read-index should now work
    names, hexoids, modes, count, ri-ok = index.read-index(git-dir)
    {
        ri-ok == true -> print('PASS: read-index ok')
        -> print('FAIL: read-index ok after add')
    }
    {
        count == 1 -> print('PASS: count = 1')
        -> print('FAIL: read-index count should be 1')
    }
    ; verify name
    nl = util.find-byte-str(names, 10, 0)
    end = names.len
    nl >= 0 -> end = nl
    nm = util.str-range(names, 0, end)
    {
        nm == 'file1.txt' -> print('PASS: entry name')
        -> print('FAIL: index entry name should be file1.txt')
    }
    ; verify oid hex
    expected-hex = oid.oid-hex-str(blob1)
    actual-hex = util.str-range(hexoids, 0, 40)
    {
        actual-hex == expected-hex -> print('PASS: entry oid hex')
        -> print('FAIL: index entry oid hex')
    }
    0
}
