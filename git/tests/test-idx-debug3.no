; Debug: test after remove

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () () {
    print('--- Debug: after remove ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    blob2 = object.write-blob(git-dir, 'content2')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)
    index.index-add(git-dir, 'file2.txt', blob2, 33188)

    ; replace first file
    blob1b = object.write-blob(git-dir, 'content1-updated')
    index.index-add(git-dir, 'file1.txt', blob1b, 33188)

    ; read before remove
    nm-before, oid-before, mode-before, ok-before = index.read-index-entry-at(git-dir, 0)
    print('before remove - nm:')
    print(nm-before)
    print('before remove - len:')
    print(nm-before.len)

    ; index-remove
    index.index-remove(git-dir, 'file2.txt')

    ; read after remove
    nm-after, oid-after, mode-after, ok-after = index.read-index-entry-at(git-dir, 0)
    print('after remove - nm:')
    print(nm-after)
    print('after remove - len:')
    print(nm-after.len)
    print('after remove - ok:')
    print(ok-after)

    ; read-index after remove
    names, hexoids, modes, count, ok = index.read-index(git-dir)
    print('after remove - read-index count:')
    print(count)
    print('after remove - read-index names:')
    print(names)
    print('after remove - read-index names len:')
    print(names.len)

    0
}
