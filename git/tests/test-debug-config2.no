; Debug test for config-set crash

# /git/src/util
# /git/src/config
# /git/src/repository

main = () () {
    print('--- Debug config-set ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-cfg2'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    print('repo-init done')

    ; read config file
    p = git-dir - '/config'
    content, file-ok = util.read-file-str(p)
    print('read config: ok=')
    print(file-ok)
    print('content len=')
    print(content.len)
    print('content:')
    print(content)

    ; try to-lower-local directly
    print('before to-lower-local')
    lower = config.to-lower-local('USER')
    print('after to-lower-local: ')
    print(lower)

    0
}
