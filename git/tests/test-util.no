; Test 1: util module — comprehensive tests

# /git/src/util

main = () {
    print('--- Testing util module ---')

    passed = 0
    failed = 0

    cs = util.char-str(65)
    {
        cs == 'A' -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: char-str(65) should be A')
        }
    }

    cs0 = util.char-str(0)
    {
        cs0.len == 1 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: char-str(0) should have len 1')
        }
    }

    data []byte = with-len(5)
    data[0] = 72
    data[1] = 101
    data[2] = 108
    data[3] = 108
    data[4] = 111
    br = util.bytes-range(data, 0, 5)
    {
        br.len == 5 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: bytes-range len should be 5')
        }
    }
    {
        br[0] == 72 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: bytes-range[0] should be 72')
        }
    }

    s = 'hello world'
    sr = util.str-range(s, 0, 5)
    {
        sr == 'hello' -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: str-range should be hello')
        }
    }
    sr2 = util.str-range(s, 6, 11)
    {
        sr2 == 'world' -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: str-range should be world')
        }
    }

    buf []byte = with-len(4)
    util.write-u32-be(buf, 0, 305419896)
    {
        buf[0] == 18 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: write-u32-be byte 0')
        }
    }
    v = util.read-u32-be(buf, 0)
    {
        v == 305419896 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: read-u32-be round trip')
        }
    }

    buf16 []byte = with-len(2)
    util.write-u16-be(buf16, 0, 4660)
    v16 = util.read-u16-be(buf16, 0)
    {
        v16 == 4660 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: read-u16-be round trip')
        }
    }

    fb-data []byte = with-len(5)
    fb-data[0] = 65
    fb-data[1] = 66
    fb-data[2] = 67
    fb-data[3] = 66
    fb-data[4] = 68
    p1 = util.find-byte(fb-data, 66, 0)
    {
        p1 == 1 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: find-byte should find at 1')
        }
    }
    p3 = util.find-byte(fb-data, 90, 0)
    {
        p3 == -1 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: find-byte should return -1')
        }
    }

    tn1 = util.trim-newline('hello\n')
    {
        tn1 == 'hello' -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: trim-newline LF')
        }
    }

    {
        util.hexdigit(48) == 0 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: hexdigit 0')
        }
    }
    {
        util.hexdigit(71) == -1 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: hexdigit invalid G')
        }
    }

    raw []byte = with-len(4)
    raw[0] = 0xab
    raw[1] = 0xcd
    raw[2] = 0xef
    raw[3] = 0x01
    encoded = util.hex-encode(raw)
    {
        encoded == 'abcdef01' -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: hex-encode')
        }
    }
    decoded, dec-ok = util.hex-decode('abcdef01')
    {
        dec-ok == true -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: hex-decode ok')
        }
    }
    {
        decoded.len == 4 -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: hex-decode len')
        }
    }

    junk-buf []byte
    junk-buf, odd-ok = util.hex-decode('abc')
    {
        odd-ok == false -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: hex-decode odd length should fail')
        }
    }

    {
        util.i64-to-str(0) == '0' -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: i64-to-str 0')
        }
    }
    {
        util.i64-to-str(123) == '123' -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: i64-to-str 123')
        }
    }

    {
        util.str-eq('hello', 'hello') == true -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: str-eq same')
        }
    }
    {
        util.str-eq('hello', 'world') == false -> passed = passed + 1
        -> {
            failed = failed + 1
            print('FAIL: str-eq different')
        }
    }

    tp = util.i64-to-str(passed)
    tf = util.i64-to-str(failed)
    print('')
    print('Passed: ' - tp - ', Failed: ' - tf)
    failed > 0 -> 1
    0
}
