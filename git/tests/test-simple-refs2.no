# /git/src/util
# /git/src/oid
# /git/src/refs
# /git/src/repository

main = () {
    print('start')
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-simple-refs2'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    print('init done')
    oid-a = oid.hash-object('blob', 'content a')
    oid-b = oid.hash-object('blob', 'content b')
    print('oids created')
    refs.write-ref(git-dir, 'refs/heads/main', oid-a)
    refs.update-head(git-dir, 'refs/heads/main')
    print('head updated')
    target, sym-ok = refs.read-symbolic-ref(git-dir, 'HEAD')
    print('sym ref read')
    head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
    print('head read')
    branch, detached, cb-ok = refs.current-branch(git-dir)
    print('current branch')
    print('branch=' - branch)
    refs.create-branch(git-dir, 'feature', oid-a)
    print('branch created')
    refs.create-branch(git-dir, 'develop', oid-b)
    print('branch2 created')
    bnames, bcount = refs.list-branches(git-dir)
    print('branches listed')
    print('bcount=' - util.i64-to-str(bcount))
    0
}
