; Test if -> else executes both arms

# /git/src/util

main = () () {
    print('--- Test -> else ---')

    flag = true
    a = 0
    b = 0

    {
        flag -> {
            a = 1
            print('true branch executed')
        }
        -> {
            b = 1
            print('else branch executed')
        }
    }

    print('a=')
    print(a)
    print('b=')
    print(b)

    ; Test with false
    flag2 = false
    c = 0
    d = 0

    {
        flag2 -> {
            c = 1
            print('true branch2 executed')
        }
        -> {
            d = 1
            print('else branch2 executed')
        }
    }

    print('c=')
    print(c)
    print('d=')
    print(d)

    0
}
