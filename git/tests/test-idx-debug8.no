; Debug: check raw index file content

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

print-hex = (content str) {
    hc = '0123456789abcdef'
    i <- [0..content.len): {
        b = content[i]
        h1 str = with-len(1)
        h1[0] = hc[(b >> 4) & 15]
        h2 str = with-len(1)
        h2[0] = hc[b & 15]
        print(h1 - h2 - ' ')
    }
}

main = () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    p = git-dir - '/index'
    content = fs.read-file(p)
    print('after 1st add - raw content len:')
    print(content.len)
    print-hex(content)

    blob2 = object.write-blob(git-dir, 'content2')
    index.index-add(git-dir, 'file2.txt', blob2, 33188)

    content2 = fs.read-file(p)
    print('after 2nd add - raw content len:')
    print(content2.len)
    print-hex(content2)

    0
}
