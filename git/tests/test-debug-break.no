; Debug test - test break in nested branches inside infinite loop

# /git/src/util

main = () () {
    print('--- Debug break in nested branches ---')

    content = 'line1\nline2\nline3'
    pos = 0
    count = 0
    {
        pos >= content.len -> break
        count = count + 1
        print('iter ')
        print(count)
        nl = util.find-byte-str(content, 10, pos)
        print('nl=')
        print(nl)

        end = content.len
        nl >= 0 -> end = nl
        line = util.str-range(content, pos, end)
        print('line=')
        print(line)

        ; nested branches like config-set
        line.starts-with('[') -> {
            print('section header')
        }
        -> {
            true -> {
                print('key=value or other')
                true -> {
                    print('deeply nested')
                }
            }
        }

        pos = nl + 1
        nl < 0 -> break
    } (true)

    print('done, count=')
    print(count)

    0
}
