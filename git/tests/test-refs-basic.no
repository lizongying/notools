; Test 7a: refs module — basic ref read/write

# /git/src/util
# /git/src/oid
# /git/src/refs
# /git/src/repository

main = () {
    print('--- Testing refs: basic ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-refs-basic'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')
        -> print('FAIL: repo-init')
    }
    ; write-ref / read-ref round trip
    test-ref-oid = oid.hash-object('blob', 'ref test data')
    w-ok = refs.write-ref(git-dir, 'refs/heads/main', test-ref-oid)
    {
        w-ok == true -> print('PASS: write-ref')
        -> print('FAIL: write-ref')
    }
    read-oid, r-ok = refs.read-ref(git-dir, 'refs/heads/main')
    {
        r-ok == true -> print('PASS: read-ref ok')
        -> print('FAIL: read-ref ok')
    }
    {
        read-oid.eq(test-ref-oid) == true -> print('PASS: read-ref oid match')
        -> print('FAIL: read-ref oid match')
    }
    ; HEAD should be symbolic ref to refs/heads/main
    target, sym-ok = refs.read-symbolic-ref(git-dir, 'HEAD')
    {
        sym-ok == true -> print('PASS: read-symbolic-ref ok')
        -> print('FAIL: read-symbolic-ref ok')
    }
    {
        target == 'refs/heads/main' -> print('PASS: HEAD target')
        -> print('FAIL: HEAD target')
    }
    ; read-ref HEAD should resolve through symbolic ref
    head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
    {
        head-ok == true -> print('PASS: read-ref HEAD ok')
        -> print('FAIL: read-ref HEAD ok')
    }
    {
        head-oid.eq(test-ref-oid) == true -> print('PASS: HEAD oid match')
        -> print('FAIL: HEAD oid match')
    }
    ; current-branch should return main
    branch, detached, cb-ok = refs.current-branch(git-dir)
    {
        cb-ok == true -> print('PASS: current-branch ok')
        -> print('FAIL: current-branch ok')
    }
    {
        branch == 'main' -> print('PASS: current-branch name')
        -> print('FAIL: current-branch name')
    }
    {
        detached == false -> print('PASS: not detached')
        -> print('FAIL: not detached')
    }
    ; read-ref for nonexistent ref
    junk-ro oid
    junk-ro, missing-ok = refs.read-ref(git-dir, 'refs/heads/nonexistent')
    {
        missing-ok == false -> print('PASS: nonexistent ref fails')
        -> print('FAIL: nonexistent ref should fail')
    }
    0
}
