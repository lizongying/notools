; Test 10a: integration — init, config, blob, index

# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
# /git/src/config
# /git/src/index
# /git/src/repository

main = () () {
    print('--- Testing integration: init & index ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-e2e-init'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')
        -> print('FAIL: e2e: repo-init')
    }
    ; set config
    config.config-set(git-dir, 'user', 'name', 'Integration Tester')
    config.config-set(git-dir, 'user', 'email', 'integration@test.com')

    cfg-name, junk-ok = config.config-get(git-dir, 'user', 'name')
    {
        cfg-name == 'Integration Tester' -> print('PASS: config name')
        -> print('FAIL: e2e: config name')
    }
    ; create and store a blob
    blob-content = 'integration test content'
    blob-oid = object.write-blob(git-dir, blob-content)

    ; add to index
    index.index-add(git-dir, 'test.txt', blob-oid, 33188)
    junk-n str
    junk-h str
    junk-m str
    junk-n, junk-h, junk-m, idx-count, junk-iok = index.read-index(git-dir)
    {
        idx-count == 1 -> print('PASS: index count = 1')
        -> print('FAIL: e2e: index has 1 entry')
    }
    0
}
