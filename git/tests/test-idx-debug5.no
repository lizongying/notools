; Debug: is it the index-add or read-index call that corrupts?

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    ; First read - works
    nm1, oid1, mode1, ok1 = index.read-index-entry-at(git-dir, 0)
    print('first read nm:')
    print(nm1)
    print('first read len:')
    print(nm1.len)

    ; Call read-index (5 returns) - does this corrupt something?
    names, hexoids, modes, count, ok = index.read-index(git-dir)
    print('read-index count:')
    print(count)
    print('read-index names:')
    print(names)

    ; Second read - does it still work?
    nm2, oid2, mode2, ok2 = index.read-index-entry-at(git-dir, 0)
    print('second read nm:')
    print(nm2)
    print('second read len:')
    print(nm2.len)

    0
}
