; Debug: test read-index directly after index-add

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    ; read-index directly after first add
    n1, h1, m1, c1, ok1 = index.read-index(git-dir)
    print('after 1st add - count:')
    print(c1)
    print('after 1st add - names:')
    print(n1)
    print('after 1st add - names len:')
    print(n1.len)

    ; second add
    blob2 = object.write-blob(git-dir, 'content2')
    index.index-add(git-dir, 'file2.txt', blob2, 33188)

    ; read-index directly after second add
    n2, h2, m2, c2, ok2 = index.read-index(git-dir)
    print('after 2nd add - count:')
    print(c2)
    print('after 2nd add - names:')
    print(n2)
    print('after 2nd add - names len:')
    print(n2.len)

    ; third read
    n3, h3, m3, c3, ok3 = index.read-index(git-dir)
    print('3rd read - count:')
    print(c3)
    print('3rd read - names:')
    print(n3)
    print('3rd read - names len:')
    print(n3.len)

    0
}
