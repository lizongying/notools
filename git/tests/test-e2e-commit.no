; Test 10b: integration — commit, refs, log

# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
# /git/src/config
# /git/src/refs
# /git/src/index
# /git/src/repository
# /git/src/revwalk

main = () {
    print('--- Testing integration: commit & log ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-e2e-commit'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')
        -> print('FAIL: e2e: repo-init')
    }
    config.config-set(git-dir, 'user', 'name', 'Integration Tester')
    config.config-set(git-dir, 'user', 'email', 'integration@test.com')

    ; create blob, tree, commit
    blob-oid = object.write-blob(git-dir, 'integration test content')
    index.index-add(git-dir, 'test.txt', blob-oid, 33188)

    ; build tree from index
    names, hexoids, modes-str, count, junk-idx-ok = index.read-index(git-dir)
    tree-raw = ''
    i <- [0..count): {
        name-pos = 0
        j <- [0..i): {
            nlt = util.find-byte-str(names, 10, name-pos)
            name-pos = nlt + 1
        }
        nlt2 = util.find-byte-str(names, 10, name-pos)
        nlt-end = names.len
        nlt2 >= 0 -> nlt-end = nlt2
        nm = util.str-range(names, name-pos, nlt-end)
        mode-pos = 0
        j2 <- [0..i): {
            mnt = util.find-byte-str(modes-str, 10, mode-pos)
            mode-pos = mnt + 1
        }
        mnt2 = util.find-byte-str(modes-str, 10, mode-pos)
        mnt-end = modes-str.len
        mnt2 >= 0 -> mnt-end = mnt2
        ms = util.str-range(modes-str, mode-pos, mnt-end)
        mode-val i64 = 0
        k <- [0..ms.len): {
            mode-val = mode-val * 10 + (ms[k] - 48)
        }
        hx = util.str-range(hexoids, i * 40, i * 40 + 40)
        entry-oid oid
        k <- [0..20): {
            c0 = hx[k * 2]
            c1 = hx[k * 2 + 1]
            hi = util.hexdigit(c0)
            lo = util.hexdigit(c1)
            entry-oid.id[k] = (hi << 4) | lo
        }
        tree-raw = object.tree-add-raw(tree-raw, mode-val, nm, entry-oid)
    }
    tree-oid = object.tree-write-raw(git-dir, tree-raw)

    ; create initial commit
    now = os.now()
    commit-oid = object.write-commit-full(git-dir, tree-oid, '', 'Integration Tester', 'integration@test.com', now, '+0000', 'Integration Tester', 'integration@test.com', now, '+0000', 'initial integration commit')

    ; update refs
    refs.write-ref(git-dir, 'refs/heads/main', commit-oid)
    refs.update-head(git-dir, 'refs/heads/main')
    refs.write-reflog(git-dir, 'HEAD', oid.zero-oid(), commit-oid, 'Integration Tester', 'integration@test.com', now, '+0000', 'commit (initial): initial integration commit')

    ; verify HEAD resolves to commit
    head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
    {
        head-ok == true -> print('PASS: HEAD resolves')
        -> print('FAIL: e2e: HEAD resolves ok')
    }
    {
        head-oid.eq(commit-oid) == true -> print('PASS: HEAD = commit')
        -> print('FAIL: e2e: HEAD resolves to commit')
    }
    ; verify commit can be read back
    k, d, c-ok = object.read-loose(git-dir, commit-oid)
    {
        c-ok == true -> print('PASS: commit read ok')
        -> print('FAIL: e2e: commit read ok')
    }
    ; verify current-branch
    junk-det bool
    cur-branch, junk-det, cur-ok = refs.current-branch(git-dir)
    {
        cur-ok == true -> print('PASS: current-branch ok')
        -> print('FAIL: e2e: current-branch ok')
    }
    {
        cur-branch == 'main' -> print('PASS: branch = main')
        -> print('FAIL: e2e: current-branch is main')
    }
    ; create second commit with parent
    blob2-oid = object.write-blob(git-dir, 'second file content')
    index.index-add(git-dir, 'file2.txt', blob2-oid, 33188)

    ; rebuild tree
    names2, hexoids2, modes2, count2, junk-idx-ok2 = index.read-index(git-dir)
    tree-raw2 = ''
    i <- [0..count2): {
        name-pos = 0
        j <- [0..i): {
            nlt = util.find-byte-str(names2, 10, name-pos)
            name-pos = nlt + 1
        }
        nlt2 = util.find-byte-str(names2, 10, name-pos)
        nlt-end = names2.len
        nlt2 >= 0 -> nlt-end = nlt2
        nm = util.str-range(names2, name-pos, nlt-end)
        mode-pos = 0
        j2 <- [0..i): {
            mnt = util.find-byte-str(modes2, 10, mode-pos)
            mode-pos = mnt + 1
        }
        mnt2 = util.find-byte-str(modes2, 10, mode-pos)
        mnt-end = modes2.len
        mnt2 >= 0 -> mnt-end = mnt2
        ms = util.str-range(modes2, mode-pos, mnt-end)
        mode-val = 0
        k <- [0..ms.len): {
            mode-val = mode-val * 10 + (ms[k] - 48)
        }
        hx = util.str-range(hexoids2, i * 40, i * 40 + 40)
        entry-oid2 oid
        k <- [0..20): {
            c0 = hx[k * 2]
            c1 = hx[k * 2 + 1]
            hi = util.hexdigit(c0)
            lo = util.hexdigit(c1)
            entry-oid2.id[k] = (hi << 4) | lo
        }
        tree-raw2 = object.tree-add-raw(tree-raw2, mode-val, nm, entry-oid2)
    }
    tree-oid2 = object.tree-write-raw(git-dir, tree-raw2)

    commit2-oid = object.write-commit-full(git-dir, tree-oid2, oid.oid-hex-str(commit-oid), 'Integration Tester', 'integration@test.com', now, '+0000', 'Integration Tester', 'integration@test.com', now, '+0000', 'second commit')
    refs.write-ref(git-dir, 'refs/heads/main', commit2-oid)
    refs.write-reflog(git-dir, 'HEAD', commit-oid, commit2-oid, 'Integration Tester', 'integration@test.com', now, '+0000', 'commit: second commit')

    ; verify log walk
    log-hex, log-count, log-ok = revwalk.revwalk-first-parent(git-dir, commit2-oid, 0)
    {
        log-ok == true -> print('PASS: log walk ok')
        -> print('FAIL: e2e: log walk ok')
    }
    {
        log-count == 2 -> print('PASS: log count = 2')
        -> print('FAIL: e2e: log walk count should be 2')
    }
    ; create a branch
    refs.create-branch(git-dir, 'feature', commit2-oid)
    bnames, bcount = refs.list-branches(git-dir)
    {
        bcount == 2 -> print('PASS: branch count = 2')
        -> print('FAIL: e2e: branch count should be 2')
    }
    ; create a tag
    refs.create-tag(git-dir, 'v1.0', commit2-oid)
    tnames, tcount = refs.list-tags(git-dir)
    {
        tcount == 1 -> print('PASS: tag count = 1')
        -> print('FAIL: e2e: tag count should be 1')
    }
    ; is-ancestor
    is-anc = revwalk.is-ancestor(git-dir, commit-oid, commit2-oid)
    {
        is-anc == true -> print('PASS: is-ancestor')
        -> print('FAIL: e2e: is-ancestor commit1 of commit2')
    }
    ; verify reflog
    rl-content, rl-ok = refs.read-reflog(git-dir, 'HEAD')
    {
        rl-ok == true -> print('PASS: reflog exists')
        -> print('FAIL: e2e: reflog exists')
    }
    {
        rl-content.len > 0 -> print('PASS: reflog has content')
        -> print('FAIL: e2e: reflog has content')
    }
    0
}
