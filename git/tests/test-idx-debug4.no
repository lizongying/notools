; Debug: minimal test

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    ; Test 1: add single file, then read
    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    nm1, oid1, mode1, ok1 = index.read-index-entry-at(git-dir, 0)
    print('test1 nm:')
    print(nm1)
    print('test1 len:')
    print(nm1.len)

    ; Test 2: add second file, then read
    blob2 = object.write-blob(git-dir, 'content2')
    index.index-add(git-dir, 'file2.txt', blob2, 33188)

    nm2, oid2, mode2, ok2 = index.read-index-entry-at(git-dir, 0)
    print('test2 nm:')
    print(nm2)
    print('test2 len:')
    print(nm2.len)

    0
}
