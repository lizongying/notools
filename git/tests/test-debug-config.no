; Debug test for config crash

# /git/src/util
# /git/src/config
# /git/src/repository

main = () {
    print('--- Debug config ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-cfg'
    git-dir = test-dir - '/.git'
    print('before repo-init')
    gd, init-ok = repository.repo-init(test-dir, false)
    print('after repo-init')
    {
        init-ok == true -> print('PASS: repo-init')
        -> print('FAIL: repo-init')
    }
    print('before config-set')
    set-ok = config.config-set(git-dir, 'user', 'name', 'Test User')
    print('after config-set')
    {
        set-ok == true -> print('PASS: config-set')
        -> print('FAIL: config-set')
    }
    0
}
