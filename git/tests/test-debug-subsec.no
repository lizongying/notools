; Debug test for config-set with subsection

# /git/src/util
# /git/src/config
# /git/src/repository

main = () {
    print('--- Debug config-set subsection ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-sub'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    ; basic config-set works
    config.config-set(git-dir, 'user', 'name', 'Test User')
    print('user.name set')

    ; config-set with subsection
    print('before remote.origin url set')
    config.config-set(git-dir, 'remote.origin', 'url', 'git@example.com:repo.git')
    print('after remote.origin url set')

    0
}
