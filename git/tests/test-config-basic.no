; Test 5a: config module — basic get/set

# /git/src/util
# /git/src/config
# /git/src/repository

main = () {
    print('--- Testing config: basic ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-cfg-basic'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    ; config-set user.name
    set-ok = config.config-set(git-dir, 'user', 'name', 'Test User')
    {
        set-ok == true -> print('PASS: config-set name')

        -> print('FAIL: config-set name')
    }
    ; config-set user.email
    set-ok2 = config.config-set(git-dir, 'user', 'email', 'test@example.com')
    {
        set-ok2 == true -> print('PASS: config-set email')

        -> print('FAIL: config-set email')
    }
    ; config-get should find user.name
    val, get-ok = config.config-get(git-dir, 'user', 'name')
    {
        get-ok == true -> print('PASS: config-get ok')

        -> print('FAIL: config-get ok')
    }
    val == 'Test User' -> print('PASS: config-get value') -> print('FAIL: config-get value: ' - val)

    ; config-get email
    eval, eval-ok = config.config-get(git-dir, 'user', 'email')
    {
        eval-ok == true -> print('PASS: config-get email ok')

        -> print('FAIL: config-get email ok')
    }
    eval == 'test@example.com' -> print('PASS: config-get email value') -> print('FAIL: config-get email value: ' - eval)

    ; config-get nonexistent key
    junk-cv str
    junk-cv, missing-ok = config.config-get(git-dir, 'user', 'nonexistent')
    {
        missing-ok == false -> print('PASS: nonexistent key fails')

        -> print('FAIL: nonexistent key should fail')
    }
    ; config-get nonexistent section
    junk-cv2 str
    junk-cv2, missing-sec-ok = config.config-get(git-dir, 'nonexistent', 'key')
    {
        missing-sec-ok == false -> print('PASS: nonexistent section fails')

        -> print('FAIL: nonexistent section should fail')
    }
    ; config-get from core section
    core-val, core-ok = config.config-get(git-dir, 'core', 'bare')
    {
        core-ok == true -> print('PASS: core.bare ok')

        -> print('FAIL: core.bare ok')
    }
    core-val == 'false' -> print('PASS: core.bare value') -> print('FAIL: core.bare value: ' - core-val)

    ; case-insensitive
    ru, ru-ok = config.config-get(git-dir, 'USER', 'NAME')
    {
        ru-ok == true -> print('PASS: case-insensitive ok')

        -> print('FAIL: case-insensitive ok')
    }
    {
        ru == 'Test User' -> print('PASS: case-insensitive value')

        -> print('FAIL: case-insensitive value')
    }
    ; get-user-name / get-user-email
    un, un-ok = config.get-user-name(git-dir)
    {
        un-ok == true -> print('PASS: get-user-name ok')

        -> print('FAIL: get-user-name ok')
    }
    {
        un == 'Test User' -> print('PASS: get-user-name value')

        -> print('FAIL: get-user-name value')
    }
    ue, ue-ok = config.get-user-email(git-dir)
    {
        ue-ok == true -> print('PASS: get-user-email ok')

        -> print('FAIL: get-user-email ok')
    }
    {
        ue == 'test@example.com' -> print('PASS: get-user-email value')

        -> print('FAIL: get-user-email value')
    }
    0
}
