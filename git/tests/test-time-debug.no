; Debug: test author time parsing

# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
# /git/src/repository

main = () () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-obj-commit'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    b-oid = object.write-blob(git-dir, 'commit test data')
    bp = object.object-path(git-dir, b-oid)
    braw = fs.read-file(bp)
    warmup-out, warmup-ok = zlib.zlib-decompress(braw)

    traw = object.tree-add-raw('', 33188, 'test.txt', b-oid)
    tree-oid = object.tree-write-raw(git-dir, traw)

    commit-oid = object.write-commit-full(git-dir, tree-oid, '',
        'Author Name', 'author@test.com', 1112911993, '+0000',
        'Committer Name', 'committer@test.com', 1112911993, '+0000',
        'test commit message')

    cp = object.object-path(git-dir, commit-oid)
    craw = fs.read-file(cp)
    cout, cdec-ok = zlib.zlib-decompress(craw)
    
    ; find author line
    idx = cout.index('author ')
    nl = util.find-byte-str(cout, 10, idx)
    line = util.str-range(cout, idx, nl)
    print('author line:')
    print(line)
    
    ; extract after 'author '
    ap = util.str-range(line, 7, line.len)
    print('ap:')
    print(ap)
    
    gt = ap.index('>')
    print('gt:')
    print(gt)
    
    rest = util.str-range(ap, gt + 1, ap.len)
    print('rest:')
    print(rest)
    print('rest.len:')
    print(rest.len)
    
    sp = util.find-byte-str(rest, 32, 0)
    print('sp:')
    print(sp)
    
    {
        sp < 0 -> sp = rest.len
    }
    ts = util.str-range(rest, 0, sp)
    print('ts:')
    print(ts)
    print('ts.len:')
    print(ts.len)
    
    ; try to parse
    ti ?i64 = ts.to-i64()
    ti: {
        ok -> {
            print('parsed ok, value:')
            print(it)
        }
        nil -> print('nil')
        err -> print('err')
    }
    
    0
}
