; Test 4d: object module — tag and helpers

# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
# /git/src/repository

main = () {
    print('--- Testing object module: tag & helpers ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-obj-tag'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    ; create a blob for the tag
    b-oid = object.write-blob(git-dir, 'tag test data')

    ; zlib warmup (Bug 18: read-loose needs prior zlib-decompress call)
    bp = object.object-path(git-dir, b-oid)
    braw = fs.read-file(bp)
    warmup-out, warmup-ok = zlib.zlib-decompress(braw)

    ; tag round trip
    tag-oid = object.write-tag-full(git-dir, b-oid, 'blob', 'v1.0', 'Tagger Name', 'tagger@test.com', 1112911993, '+0000', 'tag message')

    to, tty, tt, tnm, tem, ttm, ttz, tmsg, tag-ok = object.read-tag-full(git-dir, tag-oid)
    {
        tag-ok == true -> print('PASS: read-tag-full ok')

        -> print('FAIL: read-tag-full ok')
    }
    {
        tt == 'v1.0' -> print('PASS: tag name')

        -> print('FAIL: tag name')
    }
    {
        tmsg == 'tag message' -> print('PASS: tag message')

        -> print('FAIL: tag message')
    }
    {
        tty == 'blob' -> print('PASS: tag obj-type')

        -> print('FAIL: tag obj-type')
    }
    {
        tnm == 'Tagger Name' -> print('PASS: tagger name')

        -> print('FAIL: tagger name')
    }
    ; octal helpers
    {
        object.i64-to-octal(0) == '0' -> print('PASS: octal 0')

        -> print('FAIL: octal 0')
    }
    {
        object.i64-to-octal(33188) == '100644' -> print('PASS: octal 33188')

        -> print('FAIL: octal 33188')
    }
    {
        object.octal-to-i64('100644') == 33188 -> print('PASS: octal-to-i64')

        -> print('FAIL: octal-to-i64')
    }
    ; name-cmp
    {
        object.name-cmp('a', false, 'b', false) == -1 -> print('PASS: name-cmp a<b')

        -> print('FAIL: name-cmp a<b')
    }
    {
        object.name-cmp('b', false, 'a', false) == 1 -> print('PASS: name-cmp b>a')

        -> print('FAIL: name-cmp b>a')
    }
    {
        object.name-cmp('a', false, 'a', false) == 0 -> print('PASS: name-cmp a==a')

        -> print('FAIL: name-cmp a==a')
    }
    0
}
