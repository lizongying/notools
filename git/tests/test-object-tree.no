; Test 4b: object module — tree operations

# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
# /git/src/repository

main = () () {
    print('--- Testing object module: tree ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-obj-tree'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')
        -> print('FAIL: repo-init')
    }
    ; create blobs for tree entries
    b-oid = object.write-blob(git-dir, 'file1 content')
    b2-oid = object.write-blob(git-dir, 'file2 content')

    ; zlib warmup (Bug 18: read-loose needs prior zlib-decompress call)
    bp = object.object-path(git-dir, b-oid)
    braw = fs.read-file(bp)
    warmup-out, warmup-ok = zlib.zlib-decompress(braw)

    ; tree operations — build tree raw
    traw = object.tree-add-raw('', 33188, 'file1.txt', b-oid)
    traw2 = object.tree-add-raw(traw, 33188, 'file2.txt', b2-oid)

    ; Verify tree count
    tcount = object.tree-count-raw(traw2)
    {
        tcount == 2 -> print('PASS: tree-count-raw = 2')
        -> print('FAIL: tree-count-raw')
    }
    ; Verify tree name 0 (uses tree struct — Bug 19 fix)
    tname0 = object.tree-name-raw(traw2, 0)
    {
        tname0 == 'file1.txt' -> print('PASS: tree name 0')
        -> print('FAIL: tree name 0')
    }
    ; Verify tree name 1
    tname1 = object.tree-name-raw(traw2, 1)
    {
        tname1 == 'file2.txt' -> print('PASS: tree name 1')
        -> print('FAIL: tree name 1')
    }
    ; Verify tree mode
    tmode0 = object.tree-mode-raw(traw2, 0)
    {
        tmode0 == 33188 -> print('PASS: tree mode 0')
        -> print('FAIL: tree mode 0')
    }
    ; Verify tree id
    tid0 = object.tree-id-raw(traw2, 0)
    {
        tid0.eq(b-oid) == true -> print('PASS: tree id 0')
        -> print('FAIL: tree id 0')
    }
    ; tree write/read round trip
    tw-oid = object.tree-write-raw(git-dir, traw2)
    twhex = oid.oid-hex-str(tw-oid)
    print('tree oid: ' - twhex)

    back-raw, back-ok = object.tree-read-raw(git-dir, tw-oid)
    {
        back-ok == true -> print('PASS: tree-read-raw ok')
        -> print('FAIL: tree-read-raw ok')
    }
    {
        object.tree-count-raw(back-raw) == 2 -> print('PASS: tree round trip count')
        -> print('FAIL: tree round trip count')
    }
    {
        object.tree-name-raw(back-raw, 0) == 'file1.txt' -> print('PASS: tree round trip name 0')
        -> print('FAIL: tree round trip name 0')
    }
    ; object-roundtrip-test (built-in test in object module)
    ; Note: this test calls read-loose internally without zlib warmup,
    ; so it may fail due to Bug 18 in no-run/no-test context.
    ; It works correctly in the built git binary (no build).

    0
}
