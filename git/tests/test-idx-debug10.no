; Debug: test write-index directly

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    ; Manually call write-index with known good values
    names = 'file1.txt\nfile2.txt\n'
    oids = 'dd954e7a4e1a62ff90c5a0709dce5928716535c1db00fd65b218578127ea51f3dffac701f12f486a'
    modes = '33188\n33188\n'
    count = 2

    wok = index.write-index(git-dir, names, oids, modes, count)
    print('write-index ok:')
    print(wok)

    ; Now read back
    nm, oid-at, mode-at, at-ok = index.read-index-entry-at(git-dir, 0)
    print('entry 0 name:')
    print(nm)
    print('entry 0 name len:')
    print(nm.len)

    nm2, oid2, mode2, at-ok2 = index.read-index-entry-at(git-dir, 1)
    print('entry 1 name:')
    print(nm2)
    print('entry 1 name len:')
    print(nm2.len)

    0
}
