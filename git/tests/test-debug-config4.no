; Debug test for config-set crash - inline the function

# /git/src/util
# /git/src/config
# /git/src/repository

main = () () {
    print('--- Debug config-set inline ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-cfg4'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    p = git-dir - '/config'
    content, file-ok = util.read-file-str(p)
    print('content len=')
    print(content.len)

    ; inline parts of config-set to find crash
    sect-upper = config.to-lower-local('user')
    target-key-upper = config.to-lower-local('name')
    print('sect-upper=')
    print(sect-upper)
    print('target-key-upper=')
    print(target-key-upper)

    new-content = ''
    pos = 0
    in-section = false
    current-section str = ''
    found-and-replaced = false
    section-found = false
    last-section-end i64 = 0

    ; first iteration of the loop
    print('before first iteration')
    nl = util.find-byte-str(content, 10, pos)
    print('nl=')
    print(nl)
    end = content.len
    nl >= 0 -> end = nl
    print('end=')
    print(end)
    line = util.str-range(content, pos, end)
    print('line=')
    print(line)
    trimmed = config.trim-ws(line)
    print('trimmed=')
    print(trimmed)
    print('trimmed.len=')
    print(trimmed.len)

    ; test starts-with
    print('before starts-with')
    starts = trimmed.starts-with('[')
    print('starts-with [ =')
    print(starts)
    print('after starts-with')

    0
}
