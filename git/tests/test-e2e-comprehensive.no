; Comprehensive E2E test: full git workflow — init, config, add, commit, log, branch
;
; Tests the full CLI workflow by calling the same APIs that main.no uses.
; Simulates: git init, git config, git add, git commit, git log, git branch,
;            git tag, git status, git ls-files, git write-tree, git rev-parse.

# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
# /git/src/config
# /git/src/refs
# /git/src/index
# /git/src/repository
# /git/src/revwalk

; helper: build tree from index (same logic as main.no)
build-tree-from-index = (gd str) (tree-oid oid, ok bool) {
    ok = false
    names, hexoids, modes-str, count, index-ok = index.read-index(gd)
    {
        index-ok == false -> return

        count == 0 -> return
    }
    tree-raw = ''
    i <- [0..count): {
        name-pos = 0
        j <- [0..i): {
            nl = util.find-byte-str(names, 10, name-pos)
            name-pos = nl + 1
        }
        nl = util.find-byte-str(names, 10, name-pos)
        end = names.len
        nl >= 0 -> end = nl
        nm = util.str-range(names, name-pos, end)
        mode-pos = 0
        j2 <- [0..i): {
            mnl = util.find-byte-str(modes-str, 10, mode-pos)
            mode-pos = mnl + 1
        }
        mnl2 = util.find-byte-str(modes-str, 10, mode-pos)
        mend = modes-str.len
        mnl2 >= 0 -> mend = mnl2
        ms = util.str-range(modes-str, mode-pos, mend)
        mode-val = 0
        k <- [0..ms.len): {
            mode-val = mode-val * 10 + (ms[k] - 48)
        }
        hx = util.str-range(hexoids, i * 40, i * 40 + 40)
        entry-oid oid
        k <- [0..20): {
            c0 = hx[k * 2]
            c1 = hx[k * 2 + 1]
            hi = util.hexdigit(c0)
            lo = util.hexdigit(c1)
            entry-oid.id[k] = (hi << 4) | lo
        }
        tree-raw = object.tree-add-raw(tree-raw, mode-val, nm, entry-oid)
    }
    tree-oid = object.tree-write-raw(gd, tree-raw)
    ok = true
}

main = () {
    print('--- Comprehensive E2E Test ---')

    passed = 0
    failed = 0

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-e2e-comp'
    git-dir = test-dir - '/.git'

    ; 1. git init
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> {
            passed = passed + 1
            print('PASS: git init')
        }

        -> {
            failed = failed + 1
            print('FAIL: git init')
        }
    }

    ; 2. git config
    config.config-set(git-dir, 'user', 'name', 'E2E Tester')
    config.config-set(git-dir, 'user', 'email', 'e2e@test.com')
    cfg-n, cfg-n-ok = config.config-get(git-dir, 'user', 'name')
    {
        cfg-n == 'E2E Tester' -> {
            passed = passed + 1
            print('PASS: git config name')
        }

        -> {
            failed = failed + 1
            print('FAIL: git config name')
        }
    }

    ; 3. git add (first file)
    blob1-oid = object.write-blob(git-dir, 'file1 content')
    index.index-add(git-dir, 'file1.txt', blob1-oid, 33188)
    jn, jh, jm, jc, jok = index.read-index(git-dir)
    {
        jc == 1 -> {
            passed = passed + 1
            print('PASS: git add file1')
        }

        -> {
            failed = failed + 1
            print('FAIL: git add file1')
        }
    }

    ; 4. git commit (initial)
    tree-oid1, tree-ok1 = build-tree-from-index(git-dir)
    {
        tree-ok1 == true -> {
            passed = passed + 1
            print('PASS: write-tree from index')
        }

        -> {
            failed = failed + 1
            print('FAIL: write-tree from index')
        }
    }

    now = os.now()
    commit1 = object.write-commit-full(git-dir, tree-oid1, '', 'E2E Tester', 'e2e@test.com', now, '+0000', 'E2E Tester', 'e2e@test.com', now, '+0000', 'initial commit')
    refs.write-ref(git-dir, 'refs/heads/main', commit1)
    refs.update-head(git-dir, 'refs/heads/main')
    refs.write-reflog(git-dir, 'HEAD', oid.zero-oid(), commit1, 'E2E Tester', 'e2e@test.com', now, '+0000', 'commit (initial): initial commit')

    ; verify HEAD resolves
    head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
    {
        head-oid.eq(commit1) == true -> {
            passed = passed + 1
            print('PASS: HEAD = commit1')
        }

        -> {
            failed = failed + 1
            print('FAIL: HEAD = commit1')
        }
    }

    ; 5. git add (second file) + second commit
    blob2-oid = object.write-blob(git-dir, 'file2 content')
    index.index-add(git-dir, 'file2.txt', blob2-oid, 33188)
    tree-oid2, tree-ok2 = build-tree-from-index(git-dir)
    commit2 = object.write-commit-full(git-dir, tree-oid2, oid.oid-hex-str(commit1), 'E2E Tester', 'e2e@test.com', now + 100, '+0000', 'E2E Tester', 'e2e@test.com', now + 100, '+0000', 'second commit')
    refs.write-ref(git-dir, 'refs/heads/main', commit2)
    refs.write-reflog(git-dir, 'HEAD', commit1, commit2, 'E2E Tester', 'e2e@test.com', now + 100, '+0000', 'commit: second commit')

    ; 6. git log
    log-output, log-ok = revwalk.revwalk-format-log(git-dir, 'HEAD', 0)
    {
        log-ok == true -> {
            passed = passed + 1
            print('PASS: git log ok')
        }

        -> {
            failed = failed + 1
            print('FAIL: git log ok')
        }
    }

    ; log should have 2 commits
    log-hex, log-count, log-walk-ok = revwalk.revwalk-first-parent(git-dir, commit2, 0)
    {
        log-count == 2 -> {
            passed = passed + 1
            print('PASS: log has 2 commits')
        }

        -> {
            failed = failed + 1
            print('FAIL: log has 2 commits')
        }
    }

    ; 7. git branch
    refs.create-branch(git-dir, 'feature', commit2)
    bnames, bcount = refs.list-branches(git-dir)
    {
        bcount == 2 -> {
            passed = passed + 1
            print('PASS: branch count = 2')
        }

        -> {
            failed = failed + 1
            print('FAIL: branch count = 2')
        }
    }

    ; 8. git checkout (switch branch)
    refs.update-head(git-dir, 'refs/heads/feature')
    branch, detached, cb-ok = refs.current-branch(git-dir)
    {
        branch == 'feature' -> {
            passed = passed + 1
            print('PASS: checkout feature')
        }

        -> {
            failed = failed + 1
            print('FAIL: checkout feature')
        }
    }

    ; switch back to main
    refs.update-head(git-dir, 'refs/heads/main')
    branch2, detached2, cb-ok2 = refs.current-branch(git-dir)
    {
        branch2 == 'main' -> {
            passed = passed + 1
            print('PASS: checkout main')
        }

        -> {
            failed = failed + 1
            print('FAIL: checkout main')
        }
    }

    ; 9. git tag
    refs.create-tag(git-dir, 'v1.0', commit2)
    tnames, tcount = refs.list-tags(git-dir)
    {
        tcount == 1 -> {
            passed = passed + 1
            print('PASS: tag count = 1')
        }

        -> {
            failed = failed + 1
            print('FAIL: tag count = 1')
        }
    }

    ; resolve tag
    tag-oid, tag-ok = revwalk.resolve-ref(git-dir, 'v1.0')
    {
        tag-oid.eq(commit2) == true -> {
            passed = passed + 1
            print('PASS: resolve tag = commit2')
        }

        -> {
            failed = failed + 1
            print('FAIL: resolve tag = commit2')
        }
    }

    ; 10. git rev-parse
    rp-head, rp-ok = revwalk.resolve-ref(git-dir, 'HEAD')
    {
        rp-head.eq(commit2) == true -> {
            passed = passed + 1
            print('PASS: rev-parse HEAD')
        }

        -> {
            failed = failed + 1
            print('FAIL: rev-parse HEAD')
        }
    }

    rp-main, rp-ok2 = revwalk.resolve-ref(git-dir, 'main')
    {
        rp-main.eq(commit2) == true -> {
            passed = passed + 1
            print('PASS: rev-parse main')
        }

        -> {
            failed = failed + 1
            print('FAIL: rev-parse main')
        }
    }

    ; 11. git ls-files
    ls-names, ls-hexoids, ls-modes, ls-count, ls-ok = index.read-index(git-dir)
    {
        ls-count == 2 -> {
            passed = passed + 1
            print('PASS: ls-files count = 2')
        }

        -> {
            failed = failed + 1
            print('FAIL: ls-files count = 2')
        }
    }

    ; 12. git cat-file
    cf-k, cf-d, cf-ok = object.read-loose(git-dir, blob1-oid)
    {
        cf-k == 'blob' -> {
            passed = passed + 1
            print('PASS: cat-file type')
        }

        -> {
            failed = failed + 1
            print('FAIL: cat-file type')
        }
    }
    {
        cf-d == 'file1 content' -> {
            passed = passed + 1
            print('PASS: cat-file content')
        }

        -> {
            failed = failed + 1
            print('FAIL: cat-file content')
        }
    }

    ; 13. is-ancestor
    is-anc = revwalk.is-ancestor(git-dir, commit1, commit2)
    {
        is-anc == true -> {
            passed = passed + 1
            print('PASS: commit1 is ancestor of commit2')
        }

        -> {
            failed = failed + 1
            print('FAIL: commit1 is ancestor of commit2')
        }
    }

    ; 14. reflog
    rl-content, rl-ok2 = refs.read-reflog(git-dir, 'HEAD')
    {
        rl-ok2 == true -> {
            passed = passed + 1
            print('PASS: reflog exists')
        }

        -> {
            failed = failed + 1
            print('FAIL: reflog exists')
        }
    }
    {
        rl-content.len > 0 -> {
            passed = passed + 1
            print('PASS: reflog has content')
        }

        -> {
            failed = failed + 1
            print('FAIL: reflog has content')
        }
    }

    ; 15. repo-discover
    d-gd, d-wt, d-ok = repository.repo-discover(test-dir)
    {
        d-ok == true -> {
            passed = passed + 1
            print('PASS: repo-discover ok')
        }

        -> {
            failed = failed + 1
            print('FAIL: repo-discover ok')
        }
    }
    {
        d-gd == git-dir -> {
            passed = passed + 1
            print('PASS: repo-discover git-dir')
        }

        -> {
            failed = failed + 1
            print('FAIL: repo-discover git-dir')
        }
    }

    tp = util.i64-to-str(passed)
    tf = util.i64-to-str(failed)
    print('')
    print('Passed: ' - tp - ', Failed: ' - tf)
    failed > 0 -> 1
    0
}
