; Debug: test cross-module multi-return string

# /git/src/util
# /git/src/oid
# /git/src/object
# /git/src/zlib
# /git/src/index
# /git/src/repository

main = () {
    print('--- Debug: cross-module string return ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    ; Test read-index (5 returns including strings)
    names, hexoids, modes, count, ok = index.read-index(git-dir)
    print('count:')
    print(count)
    print('ok:')
    print(ok)
    print('names:')
    print(names)
    print('names len:')
    print(names.len)
    print('hexoids:')
    print(hexoids)
    print('modes:')
    print(modes)

    ; Test read-index-entry-at (4 returns including string)
    nm-at, oid-at, mode-at, at-ok = index.read-index-entry-at(git-dir, 0)
    print('at-ok:')
    print(at-ok)
    print('nm-at:')
    print(nm-at)
    print('nm-at len:')
    print(nm-at.len)
    print('mode-at:')
    print(mode-at)

    0
}
