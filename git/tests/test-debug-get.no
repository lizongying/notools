; Test config-get after config-set

# /git/src/util
# /git/src/config
# /git/src/repository

main = () {
    print('--- Test config-get directly ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-get'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    ; Read config directly
    p = git-dir - '/config'
    content, file-ok = util.read-file-str(p)
    print('direct read: len=')
    print(content.len)
    print('direct read: ok=')
    print(file-ok)

    ; Call config-get (cross-module)
    val, gok = config.config-get(git-dir, 'core', 'bare')
    print('config-get ok=')
    print(gok)
    print('config-get val=')
    print(val)

    0
}
