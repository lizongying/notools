; Test cross-module branch with trim-ws

# /git/src/util
# /git/src/config
# /git/src/test-xmod

main = () () {
    print('--- Test cross-module branch with trim ---')

    ; Test trim-ws result
    line = '\thello'
    trimmed = config.trim-ws(line)
    print('trimmed: ')
    print(trimmed)
    print('trimmed.len: ')
    print(trimmed.len)
    print('trimmed[0]: ')
    print(trimmed[0])

    ; Test find-byte-str on trimmed
    hb = util.find-byte-str(trimmed, 91, 0)
    print('find [: ')
    print(hb)

    ; Test find-byte-str on line  
    hb2 = util.find-byte-str(line, 91, 0)
    print('find [ in line: ')
    print(hb2)

    ; Now test with [core]
    line2 = '[core]'
    trimmed2 = config.trim-ws(line2)
    hb3 = util.find-byte-str(trimmed2, 91, 0)
    print('find [ in [core]: ')
    print(hb3)

    0
}
