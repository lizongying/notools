# /git/src/util
# /git/src/oid
# /git/src/refs
# /git/src/repository

main = () {
    print('start')
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-simple-refs4'
    git-dir = test-dir - '/.git'
    print('calling repo-init')
    gd, init-ok = repository.repo-init(test-dir, false)
    print('init done')
    oid-a = oid.hash-object('blob', 'content a')
    oid-b = oid.hash-object('blob', 'content b')
    refs.write-ref(git-dir, 'refs/heads/main', oid-a)
    refs.update-head(git-dir, 'refs/heads/main')
    refs.create-branch(git-dir, 'feature', oid-a)
    refs.create-branch(git-dir, 'develop', oid-b)
    bnames, bcount = refs.list-branches(git-dir)
    print('branches: ' - util.i64-to-str(bcount))
    dup-ok = refs.create-branch(git-dir, 'feature', oid-b)
    print('dup ok')
    del-ok = refs.delete-branch(git-dir, 'feature')
    print('del ok')
    bnames2, bcount2 = refs.list-branches(git-dir)
    print('after del: ' - util.i64-to-str(bcount2))
    refs.create-tag(git-dir, 'v1.0', oid-a)
    refs.create-tag(git-dir, 'v2.0', oid-b)
    tnames, tcount = refs.list-tags(git-dir)
    print('tags: ' - util.i64-to-str(tcount))
    print('DONE')
    0
}
