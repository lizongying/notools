; Test 2: oid module — SHA-1 hashing, oid parsing, equality

# /git/src/util
# /git/src/oid

main = () {
    print('--- Testing oid module ---')

    passed = 0
    failed = 0

    z = oid.zero-oid()
    {
        z.is-zero() == true -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: zero-oid should be zero')
        }
    }

    hex-str = 'a144f8a1c8c0b2e5c0fca5650f1c2f3a4b5c6d7e'
    o, ok = oid.oid-from-hex(hex-str)
    {
        ok == true -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: oid-from-hex valid ok')
        }
    }
    back = oid.oid-hex-str(o)
    {
        back == hex-str -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: oid-hex-str round trip')
        }
    }

    junk-oid oid
    junk-oid, bad-ok = oid.oid-from-hex('abc')
    {
        bad-ok == false -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: oid-from-hex short should fail')
        }
    }

    o2, junk-ok-hex = oid.oid-from-hex(hex-str)
    {
        o.eq(o2) == true -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: oid.eq same')
        }
    }
    o3 = oid.zero-oid()
    {
        o.eq(o3) == false -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: oid.eq different')
        }
    }

    {
        o.is-zero() == false -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: non-zero oid is-zero should be false')
        }
    }

    sha-result = oid.sha1-hex('abc')
    {
        sha-result == 'a9993e364706816aba3e25717850c26c9cd0d89d' -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: SHA1 abc known vector')
        }
    }

    sha-empty = oid.sha1-hex('')
    {
        sha-empty == 'da39a3ee5e6b4b0d3255bfef95601890afd80709' -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: SHA1 empty known vector')
        }
    }

    sha-fox = oid.sha1-hex('The quick brown fox jumps over the lazy dog')
    {
        sha-fox == '2fd4e1c67a2d28fced849ee1bb76e7391b93eb12' -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: SHA1 fox known vector')
        }
    }

    ho = oid.hash-object('blob', 'hello')
    ho-hex = oid.oid-hex-str(ho)
    {
        ho-hex == 'b6fc4c620b67d95f953a5c1c1230aaab5db5a1b0' -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: hash-object blob hello')
        }
    }

    et = oid.empty-tree-oid()
    et-hex = oid.oid-hex-str(et)
    {
        et-hex == '4b825dc642cb6eb9a060e54bf8d69288fbee4904' -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: empty-tree-oid known value')
        }
    }

    hdr = oid.object-header('blob', 5)
    {
        hdr == 'blob 5\0' -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: object-header blob 5')
        }
    }
    hdr2 = oid.object-header('commit', 100)
    {
        hdr2 == 'commit 100\0' -> passed = passed + 1

        -> {
            failed = failed + 1
            print('FAIL: object-header commit 100')
        }
    }

    tp = util.i64-to-str(passed)
    tf = util.i64-to-str(failed)
    print('')
    print('Passed: ' - tp - ', Failed: ' - tf)
    failed > 0 -> 1
    0
}
