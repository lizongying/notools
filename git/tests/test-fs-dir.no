; Debug: test fs.open-dir and read-dir directly

# /git/src/util

main = () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-refs-br'
    git-dir = test-dir - '/.git'

    ; create the directory structure manually
    fs.is-dir(test-dir) -> {}
    -> fs.mkdir-all(test-dir)
    fs.is-dir(git-dir) -> {}
    -> fs.mkdir-all(git-dir)
    heads-dir = git-dir - '/refs/heads'
    fs.is-dir(heads-dir) -> {}
    -> fs.mkdir-all(heads-dir)

    ; create a test ref file
    util.write-file-simple(heads-dir - '/main', 'abc123\n')

    print('about to open-dir...')
    dirp = fs.open-dir(heads-dir)
    print('open-dir returned:')
    print(dirp)

    print('about to read-dir...')
    dir-entry, dir-ok = fs.read-dir(dirp)
    print('read-dir returned')
    print('dir-entry:')
    print(dir-entry)
    print('dir-ok:')
    print(dir-ok)

    fs.close-dir(dirp)

    0
}
