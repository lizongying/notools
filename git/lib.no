; Export declarations — keeps functions alive across the whole-module optimizer
; Each line exports a function from its module so cross-module callers survive DCE.
; When the alias is the same as the function name, the alias is omitted.

; util
@ /git/src/util.char-str
@ /git/src/util.find-byte-str
@ /git/src/util.mkdir-all
@ /git/src/util.i64-to-str
@ /git/src/util.hexdigit
@ /git/src/util.hex-encode
@ /git/src/util.hex-decode
@ /git/src/util.bytes-to-str
@ /git/src/util.bytes-range
@ /git/src/util.find-byte
@ /git/src/util.read-u32-be
@ /git/src/util.write-u32-be
@ /git/src/util.read-u16-be
@ /git/src/util.write-u16-be
@ /git/src/util.trim-newline
@ /git/src/util.str-range
@ /git/src/util.util-keepalive

