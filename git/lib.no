// Export declarations — keeps functions alive across the whole-module optimizer
// Each line exports a function from its module so cross-module callers survive DCE.

// util
@ /git/src/util.char-str char-str
@ /git/src/util.find-byte-str find-byte-str
@ /git/src/util.mkdir-all mkdir-all
@ /git/src/util.i64-to-str i64-to-str
@ /git/src/util.hexdigit hexdigit
@ /git/src/util.hex-encode hex-encode
@ /git/src/util.hex-decode hex-decode
@ /git/src/util.bytes-to-str bytes-to-str
@ /git/src/util.bytes-range bytes-range
@ /git/src/util.find-byte find-byte
@ /git/src/util.read-u32-be read-u32-be
@ /git/src/util.write-u32-be write-u32-be
@ /git/src/util.read-u16-be read-u16-be
@ /git/src/util.write-u16-be write-u16-be
@ /git/src/util.trim-newline trim-newline
@ /git/src/util.str-range str-range
@ /git/src/util.util-keepalive util-keepalive

// oid
@ /git/src/oid.oid-from-hex oid-from-hex
@ /git/src/oid.hash-object hash-object
@ /git/src/oid.sha1-hex sha1-hex
@ /git/src/oid.zero-oid zero-oid
@ /git/src/oid.empty-tree-oid empty-tree-oid
@ /git/src/oid.object-header object-header
@ /git/src/oid.oid-hex-str oid-hex-str
@ /git/src/oid.oid-keepalive oid-keepalive

// zlib
@ /git/src/zlib.zlib-compress zlib-compress
@ /git/src/zlib.zlib-decompress zlib-decompress
@ /git/src/zlib.adler32 adler32
@ /git/src/zlib.zlib-keepalive zlib-keepalive

