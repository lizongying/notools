# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
main = () {
    ; keepalive: force every cross-module entry function to stay linked
    print('start')
    util.util-keepalive()
    print('after util')
    oid.oid-keepalive()
    print('after oid')
    zlib.zlib-keepalive()
    print('after zlib')
    object.object-keepalive()
    print('after object')

    ; smoke test: build a tree (regular file mode = 33188 decimal -> 100644 octal)
    b = object.write-blob('/tmp/kg', 'hello')
    print('blob-oid=' - oid.oid-hex-str(b))
    traw = object.tree-add-raw('', 33188, 'hello.txt', b)
    tid = object.tree-write-raw('/tmp/kg', traw)
    print('tree-oid=' - oid.oid-hex-str(tid))
    traw2 str
    trawok bool
    traw2, trawok = object.tree-read-raw('/tmp/kg', tid)
    print('read ok=' - util.i64-to-str(trawok))
    print('n=' - util.i64-to-str(object.tree-count-raw(traw2)))
    print('entry0 name=' - object.tree-name-raw(traw2, 0))
    print('entry0 mode=' - util.i64-to-str(object.tree-mode-raw(traw2, 0)))
    id0 = object.tree-id-raw(traw2, 0)
    print('entry0 id=' - oid.oid-hex-str(id0))
}
