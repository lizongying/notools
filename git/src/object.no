; object — Git object model: blob / tree / commit / tag
;
; Encodes and decodes the four object kinds and implements loose-object
; storage (the .git/objects/<aa>/<bbbb...> zlib stream). Object identity is a
; SHA-1 over "<type> <size>\0<payload>" (see oid.no).
;
; IMPORTANT nolang codegen constraints baked into this file (see project
; memory). A struct whose vec fields are read after being RETURNED from a
; function is corrupted by the whole-module optimizer (e.g. `t.modes[0]` on a
; tree returned by tree-add crashes). So we keep NO vec fields in any value
; type that crosses a function boundary. Specifically:
;   * tree is stored as a single sorted byte-string `raw` (Git's exact on-disk
;     tree format: "<octal-mode> <name>\0<20 raw id bytes>" per entry) plus a
;     scalar `n` count. No []i64 / []str fields at all.
;   * commit parents are stored as a concatenated 40-char-hex string
;     parenthex with an explicit nparents count.
;   * parse commit/tag headers line-by-line over a byte-string (never []str).
;   * carry all Git bytes as `str` (one codepoint per byte 0-255) across module
;     boundaries; []byte is only used INSIDE this module.
;   * bind every cross-module call result to a typed local before reuse.

# /git/src/util
# /git/src/oid

; ═══════════════════════════════════════════════
; value types
; ═══════════════════════════════════════════════

; tree: a Git tree stored as a single sorted byte-string (Git's exact on-disk
; tree format) plus a scalar entry count. NO vec fields — a struct whose vec
; fields are read after being returned from a function is corrupted by the
; nolang optimizer (see project memory). Each entry in `raw` is:
;   "<octal-mode> <name>\0<20 raw id bytes>"
; Entries are kept sorted by base_name_compare at all times.
tree {
    raw str
    n i64
}

person-info {
    name str
    email str
    time i64
    tz str
}

commit-info {
    tree-oid oid
    parenthex str      ; concatenated 40-char hex of each parent (no []oid)
    nparents i64
    author person-info
    committer person-info
    message str
}

tag-info {
    object oid
    obj-type str
    tag str
    tagger person-info
    message str
}

; ═══════════════════════════════════════════════
; octal helpers (git stores modes as octal text)
; ═══════════════════════════════════════════════

i64-to-octal = (n i64) (out str) {
    {
        n == 0 -> {
            out = '0'
            return
        }
    }
    tmp []byte = with-cap(16)
    x = n
    {
        tmp.push(48 + (x % 8))
        x = x / 8
        x == 0 -> break
    } ()
    ; Concat-return (stride-1) so the result is safe wherever it is used.
    out = ''
    L = tmp.len
    i <- [0..L): {
        cb str = with-len(1)
        cb[0] = tmp[L - 1 - i]
        out = out - cb
    }
}

octal-to-i64 = (s str) (out i64) {
    out = 0
    i <- [0..s.len): {
        out = out * 8 + (s[i] - 48)
    }
}

mode-is-dir = (m i64) (yes bool) {
    yes = m == 16384
}

; ═══════════════════════════════════════════════
; tree builder + base_name_compare
; ═══════════════════════════════════════════════


; id-bytes: build a 20-byte string from an oid's raw bytes. Concat-return.
id-bytes = (id oid) (out str) {
    out = ''
    k <- [0..20): {
        cb str = with-len(1)
        cb[0] = id.id[k]
        out = out - cb
    }
}

; name-cmp: git's base_name_compare with the '/' rule for directories.
; (na,adir) is the candidate; (nb,bdir) is the existing entry.
name-cmp = (na str, adir bool, nb str, bdir bool) (r i64) {
    la = na.len
    lb = nb.len
    len = la
    lb < len -> len = lb
    r = 0
    i = 0
    {
        i < len -> {
            ca = na[i]
            cb = nb[i]
            ca < cb -> {
                r = -1
                return
            }
            ca > cb -> {
                r = 1
                return
            }
            i = i + 1
        }
    } (i < len)
    ca = 0
    cb = 0
    {
        la > len -> ca = na[len]
        lb > len -> cb = nb[len]
        ca == 0 && adir == true -> ca = 47
        cb == 0 && bdir == true -> cb = 47
        ca < cb -> r = -1
        ca > cb -> r = 1
    }
}

; tree-insert-offset: offset in raw where a new (mode,name) entry belongs so
; that raw stays sorted by base_name_compare.
tree-insert-offset = (raw str, mode i64, name str) (off i64) {
    off = raw.len
    pos = 0
    adir = mode == 16384
    {
        pos >= raw.len -> break
        sp = util.find-byte-str(raw, 32, pos)
        sp < 0 -> break
        nl = util.find-byte-str(raw, 0, sp + 1)
        nl < 0 -> break
        emode = octal-to-i64(raw[pos .. sp))
        ename = raw[sp + 1 .. nl)
        bdir = emode == 16384
        c = name-cmp(name, adir, ename, bdir)
        c <= 0 -> {
            off = pos
            break
        }
        pos = nl + 21
    } (true)
}


; tree-entry-at: locate entry i in raw, returning its start/space/nul offsets.
tree-entry-at = (raw str, i i64) (off i64, sp i64, nl i64) {
    off = 0
    k = 0
    {
        k >= i -> break
        s = util.find-byte-str(raw, 32, off)
        s < 0 -> break
        n = util.find-byte-str(raw, 0, s + 1)
        n < 0 -> break
        off = n + 21
        k = k + 1
    } (k < i)
    sp = util.find-byte-str(raw, 32, off)
    nl = util.find-byte-str(raw, 0, sp + 1)
}

; tree-name: the name byte-string of entry i
tree-name = (t tree, i i64) (s str) {
    off i64
    sp i64
    nl i64
    off, sp, nl = tree-entry-at(t.raw, i)
    s = util.str-range(t.raw, sp + 1, nl)
}

; tree-mode: the octal mode of entry i
tree-mode = (t tree, i i64) (m i64) {
    off i64
    sp i64
    nl i64
    off, sp, nl = tree-entry-at(t.raw, i)
    m = octal-to-i64(util.str-range(t.raw, off, sp))
}

; tree-id: the object id of entry i
tree-id = (t tree, i i64) (o oid) {
    off i64
    sp i64
    nl i64
    off, sp, nl = tree-entry-at(t.raw, i)
    tmp oid
    k <- [0..20): {
        tmp.id[k] = t.raw[nl + 1 + k]
    }
    o = tmp
}

; ═══════════════════════════════════════════════
; CROSS-MODULE-SAFE tree API
;
; nolang corrupts a struct field that is a `str` (or vec) when the struct is
; returned across a module boundary, so we NEVER hand a `tree` struct to
; another module. Instead the tree's bytes travel as a plain top-level `str`
; (which survives), and these wrappers rebuild a local `tree` internally.
; ═══════════════════════════════════════════════

; tree-count-raw: number of entries in a raw tree byte-string
tree-count-raw = (raw str) (n i64) {
    n = 0
    pos = 0
    {
        pos >= raw.len -> break
        sp = util.find-byte-str(raw, 32, pos)
        sp < 0 -> break
        nl = util.find-byte-str(raw, 0, sp + 1)
        nl < 0 -> break
        pos = nl + 21
        n = n + 1
    } (true)
}

; tree-add-raw: append an entry to a raw tree string; returns the new raw str.
; Operates directly on the `str` (no `tree` struct return — returning a struct
; carrying a `str` field loses the buffer even within a module).
tree-add-raw = (raw str, mode i64, name str, id oid) (out str) {
oct = i64-to-octal(mode)
ib = id-bytes(id)
nul str = '\0'
e = oct - ' ' - name - nul - ib
    curlen = raw.len
    {
        curlen == 0 -> {
            out = e
        } -> {
            ins = tree-insert-offset(raw, mode, name)
            ins == 0 -> {
                out = e - raw
            }
            ins == curlen -> {
                out = raw - e
            }
            left str = util.str-range(raw, 0, ins)
            right str = util.str-range(raw, ins, raw.len)
            out = left - e - right
        }
    }
}

; tree-write-raw: store a raw tree; returns its oid
tree-write-raw = (git-dir str, raw str) (o oid) {
    o = write-loose(git-dir, 'tree', raw)
}

; tree-read-raw: read a tree object's raw bytes (top-level str)
tree-read-raw = (git-dir str, o oid) (raw str, ok bool) {
    k str
    d str
    ok2 bool
    k, d, ok2 = read-loose(git-dir, o)
    {
        ok2 == false -> {
            ok = false
            return
        }
    }
    raw = d
    ok = true
}

; tree-name-raw / tree-mode-raw / tree-id-raw: access entry i of a raw tree
tree-name-raw = (raw str, i i64) (s str) {
    t = tree { raw: raw, n: tree-count-raw(raw) }
    s = tree-name(t, i)
}

tree-mode-raw = (raw str, i i64) (m i64) {
    t = tree { raw: raw, n: tree-count-raw(raw) }
    m = tree-mode(t, i)
}

tree-id-raw = (raw str, i i64) (o oid) {
    t = tree { raw: raw, n: tree-count-raw(raw) }
    o = tree-id(t, i)
}

; ═══════════════════════════════════════════════
; tree encode / decode
; ═══════════════════════════════════════════════

; tree-encode: return the sorted raw tree bytes. raw is already kept sorted by
; base_name_compare at all times, so this is just an accessor.
tree-encode = (t tree) (out str) {
    out = t.raw
}

; ═══════════════════════════════════════════════
; person line encode / decode
; ═══════════════════════════════════════════════

person-line = (role str, p person-info) (out str) {
    ; DEBUG: read struct fields BEFORE cross-module call
    nm str = p.name
    em str = p.email
    tm i64 = p.time
    tzh str = p.tz
    ts str = util.i64-to-str(tm)
    out = role - ' ' - nm - ' <' - em - '> ' - ts - ' ' - tzh
}

; parse-person-fields: parse "Name <email> 1234567890 +0000" returning the
; parts as top-level scalars/strings (a struct return would lose the `str`
; fields, so we return them individually).
parse-person-fields = (s str) (name str, email str, time i64, tz str) {
    lt i64 = s.index('<')
    gt i64 = s.index('>')
    nm str = util.str-range(s, 0, lt)
    nm.len > 0 -> nm[nm.len - 1] == 32 -> nm = util.str-range(nm, 0, nm.len - 1)
    name = nm
    email = util.str-range(s, lt + 1, gt)
    rest str = util.str-range(s, gt + 1, s.len)
    sp i64 = util.find-byte-str(rest, 32, 0)
    sp < 0 -> sp = rest.len
    ts str = util.str-range(rest, 0, sp)
    ti ?i64 = ts.to-i64()
    ti: {
        ok -> time = it
        nil -> {}
        err -> {}
    }
    tz = util.str-range(rest, sp + 1, rest.len)
}

; ═══════════════════════════════════════════════
; commit encode / decode
; ═══════════════════════════════════════════════

commit-encode = (c commit-info) (out str) {
    tid oid = c.tree-oid
    th str = oid.oid-hex-str(tid)
    nl str = '\n'
    s = 'tree ' - th - nl
    i <- [0..c.nparents): {
        ph str = util.str-range(c.parenthex, i * 40, i * 40 + 40)
        s = s - 'parent ' - ph - nl
    }
    al str = person-line('author', c.author)
    s = s - al - nl
    cl str = person-line('committer', c.committer)
    s = s - cl - nl - nl - c.message
    out = s
}


; ═══════════════════════════════════════════════
; tag encode / decode
; ═══════════════════════════════════════════════

tag-encode = (t tag-info) (out str) {
    tobj oid = t.object
    oh str = oid.oid-hex-str(tobj)
    nl str = '\n'
    s = 'object ' - oh - nl
    s = s - 'type ' - t.obj-type - nl
    s = s - 'tag ' - t.tag - nl
    tl str = person-line('tagger', t.tagger)
    s = s - tl - nl - nl - t.message
    out = s
}


; ═══════════════════════════════════════════════
; loose object write / read
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; INLINE zlib stored-block codec
;
; The zlib compression/decompression is inlined directly into write-loose /
; read-loose (NOT a separate z-compress/z-decompress function). nolang's codegen
; treats a `with-len` (stride-8) string RETURNED from a function call differently
; from a `with-len` string that is a LOCAL: the caller indexes a returned str
; stride-1, so only the first byte survives. By keeping `comp` / `out` as LOCALS
; inside the same function that built them, every index is stride-8-aware and
; the bytes survive. The stream is byte-for-byte identical to a real zlib
; stored-block stream, so real git can read our objects.
; ═══════════════════════════════════════════════

; build-header: "<type> <size>\0" header, built locally as a PROPER concat str.
; Replaces the cross-module oid.object-header call whose with-len return was
; corrupted at the boundary.
build-header = (kind str, size i64) (out str) {
sz = util.i64-to-str(size)
nul str = '\0'
out = kind - ' ' - sz - nul
}

; hex-char: render one byte as a 2-char lowercase hex string. Built purely by
; CONCATENATION so the result is a proper `%str` (accepted by C builtins such
; as open-write / is-file). A str built with `with-len`+assignment is a
; `%str-long` that C builtins misread — that is why earlier writes created no
; file. `hc[hi] - ''` turns a byte into a single-char proper str.
hex-char = (b byte) (s str) {
    hc = '0123456789abcdef'
    hi = (b >> 4) & 15
    lo = b & 15
    s = hc[hi] - '' - hc[lo] - ''
}

; object-path: <git-dir>/objects/<aa>/<bbbb...> as a PROPER %str (built purely
; by concatenation of literals + single-char strings). Required so C builtins
; like open-write and is-file accept the path. `hex-char` takes ONE oid byte
; and emits 2 hex chars, so the dir is byte[0] (2 hex) and the file is bytes
; [1..20) (19 bytes -> 38 hex). Do NOT index o.id by hex position.
object-path = (git-dir str, o oid) (out str) {
    out = git-dir - '/objects/'
    out = out - hex-char(o.id[0])
    sl str = '/'
    out = out - sl
    i <- [1..20): { out = out - hex-char(o.id[i]) }
}

; object-dir: <git-dir>/objects/<aa> — parent dir passed to util.mkdir-all.
object-dir = (git-dir str, o oid) (out str) {
    out = git-dir - '/objects/'
    out = out - hex-char(o.id[0])
}

; write-loose: hash, compress and store a loose object; returns its oid.
; data str: payload as a byte-string (each codepoint 0-255).
write-loose = (git-dir str, kind str, data str) (o oid) {
    o = oid.hash-object(kind, data)
    dir str = object-dir(git-dir, o)
    util.mkdir-all(dir)
    f str = object-path(git-dir, o)
    hdr = build-header(kind, data.len)
    full str = with-len(hdr.len + data.len)
    i <- [0..hdr.len): {
        full[i] = hdr[i]
    }
    i <- [0..data.len): {
        full[hdr.len + i] = data[i]
    }
    ; Inline zlib stored-block compression. `comp` stays a LOCAL here so every
    ; index is stride-8-aware (a returned str would be indexed stride-1 by the
    ; caller and corrupted). Builds a single stored block (BTYPE=00).
    ; NOTE: single block supports up to 65535 bytes. For larger objects,
    ; multiple blocks should be chained — but this covers the vast majority
    ; of Git objects (source files, small trees, commits).
    full-len = full.len
    full-len > 65535 -> full-len = 65535
    comp str = with-len(2 + 5 + full-len + 4)
    comp[0] = 0x78
    comp[1] = 0x9c
    comp[2] = 1
    comp[3] = full-len & 0xff
    comp[4] = (full-len >> 8) & 0xff
    nlen = (~full-len) & 0xffff
    comp[5] = nlen & 0xff
    comp[6] = (nlen >> 8) & 0xff
    i <- [0..full-len): {
        comp[7 + i] = full[i]
    }
    ; Adler-32 computed INLINE (reading full[i] locally, stride-8-aware). A
    ; separate adler function would index its `s` parameter stride-1 and produce
    ; a wrong checksum.
    a = 1
    b = 0
    i <- [0..full-len): {
        bb = full[i]
        a = (a + bb) % 65521
        b = (b + a) % 65521
    }
    ad = ((b << 16) | a) & 0xffffffff
    comp[7 + full-len] = (ad >> 24) & 0xff
    comp[7 + full-len + 1] = (ad >> 16) & 0xff
    comp[7 + full-len + 2] = (ad >> 8) & 0xff
    comp[7 + full-len + 3] = ad & 0xff
    ; Write the compressed object to file.
    fd = fs.open-write(f)
    fs.write(fd, comp, comp.len)
    fs.close(fd)
}

; write-blob: store a blob whose content is a byte-string
write-blob = (git-dir str, content str) (o oid) {
    o = write-loose(git-dir, 'blob', content)
}

; write-tree: encode and store a tree (already sorted in raw)
write-tree = (git-dir str, t tree) (o oid) {
    o = write-loose(git-dir, 'tree', t.raw)
}

; write-commit: encode and store a commit
write-commit = (git-dir str, c commit-info) (o oid) {
    enc = commit-encode(c)
    o = write-loose(git-dir, 'commit', enc)
}

; write-tag: encode and store an annotated tag
write-tag = (git-dir str, t tag-info) (o oid) {
    enc = tag-encode(t)
    o = write-loose(git-dir, 'tag', enc)
}

; read-file-bytes: read an entire file into a proper nolang `str` whose `.len`
; is correct and whose codepoints ARE the raw file bytes. `fs.read-file` returns
; a correct `%str` (verified); we gate on `fs.is-file` so a missing object is
; reported as ok=false rather than an empty read.
read-file-bytes = (p str) (content str, ok bool) {
    isf = fs.is-file(p)
    {
        isf == false -> {
            content = ''
            ok = false
            return
        }
    }
    content = fs.read-file(p)
    ok = true
}

; read-loose: read a loose object; ok=false if absent or corrupt.
; data str: payload returned as a byte-string (each codepoint 0-255).
;
; `rf` is a stride-1 proper str from fs.read-file, so rf[p] reads are correct.
; `out` is built as a CONCAT (stride-1) string so find-byte-local / str-copy
; (which index it locally) read correct bytes AND so the returned kind/data
; (via str-copy, also concat) survive any boundary.
read-loose = (git-dir str, o oid) (kind str, data str, ok bool) {
    ok = false
    f str = object-path(git-dir, o)
    isf = fs.is-file(f)
    isf == false -> return
    rf str = fs.read-file(f)
    {
        rf.len == 0 -> return
        rf.len < 6 -> return
    }
    ; First pass: sum the uncompressed lengths across stored blocks.
    total = 0
    p = 2
    {
        p >= rf.len -> break
        bfinal = rf[p] & 1
        btype = (rf[p] >> 1) & 3
        btype != 0 -> return
        p = p + 1
        len = rf[p] | (rf[p + 1] << 8)
        p = p + 2
        p = p + 2
        total = total + len
        p = p + len
        bfinal == 1 -> break
    } (true)
    ; Second pass: build `out` by concatenating payload from each stored block.
    out = ''
    p = 2
    {
        p >= rf.len -> break
        bfinal = rf[p] & 1
        p = p + 1
        len = rf[p] | (rf[p + 1] << 8)
        p = p + 4
        out = out - rf[p..p + len)
        p = p + len
        bfinal == 1 -> break
    } (true)
    sp i64 = util.find-byte-str(out, 32, 0)
    sp < 0 -> return
    kind = util.str-range(out, 0, sp)
    nul i64 = util.find-byte-str(out, 0, sp + 1)
    nul < 0 -> return
    start = nul + 1
    data = util.str-range(out, start, out.len)
    ok = true
}

; ═══════════════════════════════════════════════
; CROSS-MODULE-SAFE commit / tag API
;
; `commit-info` / `tag-info` carry `str` fields and would be corrupted if
; returned across a module boundary, so we never hand them out. Instead the
; caller passes the individual scalar/str/oid fields and receives either an
; oid (for writes) or the individual scalar/str/oid fields (for reads).
; ═══════════════════════════════════════════════

; write-commit-full: encode + store a commit from its parts; returns its oid
write-commit-full = (git-dir str, tree-oid oid, parenthex str,
    a-name str, a-email str, a-time i64, a-tz str,
    c-name str, c-email str, c-time i64, c-tz str, message str) (o oid) {
    ; DEBUG: bypass struct, build directly from parameters
    th str = oid.oid-hex-str(tree-oid)
    nl str = '\n'
    ats str = util.i64-to-str(a-time)
    cts str = util.i64-to-str(c-time)
    enc str = 'tree ' - th - nl
    enc = enc - 'author ' - a-name - ' <' - a-email - '> ' - ats - ' ' - a-tz - nl
    enc = enc - 'committer ' - c-name - ' <' - c-email - '> ' - cts - ' ' - c-tz - nl
    enc = enc - nl - message
    o = write-loose(git-dir, 'commit', enc)
}

; read-commit-full: read + decode a commit; returns its parts individually.
; Parses INLINE (no commit-info struct return — that would lose the str fields)
; and returns only top-level scalars/strings/oid.
read-commit-full = (git-dir str, o oid) (tree-oid oid, parenthex str,
    a-name str, a-email str, a-time i64, a-tz str,
    c-name str, c-email str, c-time i64, c-tz str, message str, ok bool) {
    k str
    d str
    ok2 bool
    k, d, ok2 = read-loose(git-dir, o)
    {
        ok2 == false -> {
            ok = false
            return
        }
    }
    text str = d
    idx i64 = text.index('\n\n')
    hend = text.len
    idx >= 0 -> hend = idx
    message = ''
    idx >= 0 -> message = util.str-range(text, idx + 2, text.len)
    tree-oid = oid.zero-oid()
    parenthex = ''
    a-name = ''
    a-email = ''
    a-time = 0
    a-tz = ''
    c-name = ''
    c-email = ''
    c-time = 0
    c-tz = ''
    pos = 0
    {
        pos >= hend -> break
        nl i64 = util.find-byte-str(text, 10, pos)
        nl < 0 -> nl = hend
        line str = util.str-range(text, pos, nl)
        line.starts-with('tree ') -> {
            hx str = util.str-range(line, 5, line.len)
            toid, tok = oid.oid-from-hex(hx)
            tok == true -> tree-oid = toid
        }
        line.starts-with('parent ') -> {
            hx2 str = util.str-range(line, 7, line.len)
            parenthex = parenthex - hx2
        }
        line.starts-with('author ') -> {
            ap str = util.str-range(line, 7, line.len)
            a-name, a-email, a-time, a-tz = parse-person-fields(ap)
        }
        line.starts-with('committer ') -> {
            cp str = util.str-range(line, 11, line.len)
            c-name, c-email, c-time, c-tz = parse-person-fields(cp)
        }
        pos = nl + 1
    } (true)
    ok = true
}

; write-tag-full: encode + store an annotated tag from its parts; returns oid
write-tag-full = (git-dir str, obj oid, obj-type str, tag str,
    t-name str, t-email str, t-time i64, t-tz str, message str) (o oid) {
    tg = tag-info {
        object: obj
        obj-type: obj-type
        tag: tag
        tagger: person-info { name: t-name, email: t-email, time: t-time, tz: t-tz }
        message: message
    }
    o = write-tag(git-dir, tg)
}

; read-tag-full: read + decode a tag; returns its parts individually.
; Parses INLINE (no tag-info struct return) and returns top-level values.
read-tag-full = (git-dir str, o oid) (obj oid, obj-type str, tag str,
    t-name str, t-email str, t-time i64, t-tz str, message str, ok bool) {
    k str
    d str
    ok2 bool
    k, d, ok2 = read-loose(git-dir, o)
    {
        ok2 == false -> {
            ok = false
            return
        }
    }
    text str = d
    idx i64 = text.index('\n\n')
    hend = text.len
    idx >= 0 -> hend = idx
    message = ''
    idx >= 0 -> message = util.str-range(text, idx + 2, text.len)
    obj = oid.zero-oid()
    obj-type = ''
    tag = ''
    t-name = ''
    t-email = ''
    t-time = 0
    t-tz = ''
    pos = 0
    {
        pos >= hend -> break
        nl i64 = util.find-byte-str(text, 10, pos)
        nl < 0 -> nl = hend
        line str = util.str-range(text, pos, nl)
        line.starts-with('object ') -> {
            hx str = util.str-range(line, 7, line.len)
            tobj, took = oid.oid-from-hex(hx)
            took == true -> obj = tobj
        }
        line.starts-with('type ') -> {
            obj-type = util.str-range(line, 5, line.len)
        }
        line.starts-with('tag ') -> {
            tag = util.str-range(line, 4, line.len)
        }
        line.starts-with('tagger ') -> {
            gp str = util.str-range(line, 7, line.len)
            t-name, t-email, t-time, t-tz = parse-person-fields(gp)
        }
        pos = nl + 1
    } (true)
    ok = true
}

; str-eq: length + byte-wise equality of two byte-strings (intra-module safe;
; avoids relying on nolang's `==` semantics for str, which are inconsistent for
; computed/with-len strings).
; Accumulate in a regular local `r` (named-return assignment inside a loop's
; `-> { }` block does not persist in nolang); copy to the named return `yes`
; once, at top level, at the end.
str-eq = (a str, b str) (yes bool) {
    r i64 = 0
    a.len != b.len -> return
    r = 1
    i = 0
    {
        i >= a.len -> break
        m i64 = a[i] != b[i]
        r = m ? 0 : r
        m == 1 -> break
        i = i + 1
    } ()
    yes = r == 1
}

; object-roundtrip-test: full write+read round trip for blob, tree, commit and
; tag, entirely INTRA-module so no `str` payload crosses a module boundary
; (which is where nolang corrupts stride-8 strings). Validation uses oid.eq
; (struct compare) and str-eq (byte compare), never `print` of a string.
; Returns true only if every round trip reproduces the original bytes.
object-roundtrip-test = (git-dir str) (ok bool) {
    ; --- blob round trip ---
    b = write-blob(git-dir, 'hello')
    bk str
    bd str
    bok bool
    bk, bd, bok = read-loose(git-dir, b)
    ok = bok
    ok = ok && str-eq(bd, 'hello')
    ok = ok && str-eq(bk, 'blob')
    ob i64 = 0
    ok == true -> ob = 1
    ; --- tree round trip ---
    traw = tree-add-raw('', 33188, 'hello.txt', b)
    tid = tree-write-raw(git-dir, traw)
    back str
    tok bool
    back, tok = tree-read-raw(git-dir, tid)
    ok = ok && tok
    n = tree-count-raw(back)
    ok = ok && (n == 1)
    m = tree-mode-raw(back, 0)
    ok = ok && (m == 33188)
    nm = tree-name-raw(back, 0)
    ok = ok && str-eq(nm, 'hello.txt')
    id0 = tree-id-raw(back, 0)
    ok = ok && oid.eq(id0, b)
    ; --- commit round trip ---
    oc = write-commit-full(git-dir, tid, '', 'An', 'ae', 1112911993, '+0000', 'Cn', 'ce', 1112911993, '+0000', 'msg')
    _ct oid
    _cph str
    _can str
    _cae str
    _cat i64
    _caz str
    _ccn str
    _cce str
    _cct i64
    _ccz str
    _cm str
    _cok bool
    _ct, _cph, _can, _cae, _cat, _caz, _ccn, _cce, _cct, _ccz, _cm, _cok = read-commit-full(git-dir, oc)
    ok = ok && _cok
    ok = ok && str-eq(_can, 'An')
    ok = ok && str-eq(_cm, 'msg')
    ; --- tag round trip ---
    otg = write-tag-full(git-dir, b, 'blob', 'v0', 'Tn', 'te', 1112911993, '+0000', 'tm')
    _to oid
    _tty str
    _tt str
    _tnm str
    _tem str
    _ttm i64
    _ttz str
    _tmsg str
    _tok bool
    _to, _tty, _tt, _tnm, _tem, _ttm, _ttz, _tmsg, _tok = read-tag-full(git-dir, otg)
    ok = ok && _tok
    ok = ok && str-eq(_tt, 'v0')
    ok = ok && str-eq(_tmsg, 'tm')
}

