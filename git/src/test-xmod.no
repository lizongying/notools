; Test function in config module to verify cross-module branch bug

# /git/src/util

test-cross-module-branch = (data str) (result str) {
    result = ''
    pos = 0
    {
        pos >= data.len -> break
        nl = util.find-byte-str(data, 10, pos)
        end = data.len
        nl >= 0 -> end = nl
        line = util.str-range(data, pos, end)
        
        ; Two conditions in same {} block
        line[0] == 91 -> {
            result = result - 'S'
        }
        line[0] >= 92 -> {
            result = result - 'K'
        }
        
        pos = nl + 1
        nl < 0 -> break
    } (true)
}
