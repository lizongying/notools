// config — Git configuration file parsing and manipulation
//
// Supports the INI-style git config format:
//   [section]
//       key = value
//   [section "subsection"]
//       key = value
//
// Cross-module safety: returns individual scalars/strings.

# /git/src/util

// ═══════════════════════════════════════════════
// local helpers
// ═══════════════════════════════════════════════

str-copy = (s str, a i64, b i64) (out str) {
    out = ''
    i <- [a..b): {
        cb str = with-len(1)
        cb[0] = s[i]
        out = out - cb
    }
}

find-byte-local = (s str, b byte, from i64) (pos i64) {
    r i64 = -1
    i = from
    {
        i >= s.len -> break
        c i64 = s[i]
        r = (c == b) ? i : r
        c == b -> break
        i = i + 1
    } ()
    pos = r
}

trim-newline-local = (s str) (out str) {
    L = s.len
    L > 0 -> {
        last = s[L - 1]
        last == 10 -> {
            L = L - 1
            out = str-copy(s, 0, L)
            L > 0 -> {
                s2 = out
                last2 = s2[L - 1]
                last2 == 13 -> {
                    out = str-copy(s2, 0, L - 1)
                }
            }
            return
        }
    }
    out = s
}

// trim leading/trailing whitespace
trim-ws = (s str) (out str) {
    ; find start
    start = 0
    {
        start >= s.len -> break
        c = s[start]
        c == 32 || c == 9 -> start = start + 1
        c != 32 && c != 9 -> break
    } ()
    ; find end
    end = s.len
    {
        end <= start -> break
        c = s[end - 1]
        c == 32 || c == 9 || c == 10 || c == 13 -> end = end - 1
        c != 32 && c != 9 && c != 10 && c != 13 -> break
    } ()
    out = str-copy(s, start, end)
}

read-file-str = (p str) (out str, ok bool) {
    ok = false
    isf = fs.is-file(p)
    isf == false -> {
        out = ''
        return
    }
    raw = fs.read-file(p)
    out = ''
    i <- [0..raw.len): {
        cb str = with-len(1)
        cb[0] = raw[i]
        out = out - cb
    }
    ok = true
}

write-file-simple = (p str, content str) (ok bool) {
    ok = false
    fd = fs.open-write(p)
    i <- [0..content.len): {
        cs str = with-len(1)
        cs[0] = content[i]
        fs.write(fd, cs, 1)
    }
    fs.close(fd)
    ok = true
}

str-eq-local = (a str, b str) (yes bool) {
    yes = false
    a.len != b.len -> return
    yes = true
    i = 0
    {
        i >= a.len -> break
        a[i] != b[i] -> {
            yes = false
            return
        }
        i = i + 1
    } ()
}

to-lower-local = (s str) (out str) {
    out = ''
    i <- [0..s.len): {
        c = s[i]
        c >= 65 && c <= 90 -> {
            lc = c + 32
            cs str = with-len(1)
            cs[0] = lc
            out = out - cs
        } -> {
            cs str = with-len(1)
            cs[0] = c
            out = out - cs
        }
    }
}

// ═══════════════════════════════════════════════
// config get / set
// ═══════════════════════════════════════════════

// config-get: get a config value from .git/config
// git-dir str, section str, key str
// returns value str, ok bool
//
// Section matching is case-insensitive. Key matching is case-insensitive.
// Supports [section] and [section "subsection"] — subsection is case-sensitive.
// For subsection lookup, pass section as 'section.subsection' (dot-separated).
config-get = (git-dir str, section str, key str) (value str, ok bool) {
    ok = false
    p = git-dir - '/config'
    content str
    file-ok bool
    content, file-ok = read-file-str(p)
    file-ok == false -> return
    ; parse section name and optional subsection from `section` param
    ; if section contains '.', split into section + subsection
    sect-upper = to-lower-local(section)
    ; scan lines
    pos = 0
    in-section = false
    current-section str = ''
    {
        pos >= content.len -> break
        nl = find-byte-local(content, 10, pos)
        end = content.len
        nl >= 0 -> end = nl
        line = str-copy(content, pos, end)
        trimmed = trim-ws(line)
        trimmed.len == 0 -> {} -> {
            ; section header: [section] or [section "subsection"]
            trimmed.starts-with('[') -> {
                ; extract section content between [ and ]
                rb = find-byte-local(trimmed, 93, 0) ; ]
                rb >= 0 -> {
                    inner = str-copy(trimmed, 1, rb)
                    ; check for subsection: section "subsection"
                    dq = find-byte-local(inner, 34, 0) ; "
                    dq >= 0 -> {
                        sname = str-copy(inner, 0, dq)
                        sname = trim-ws(sname)
                        sname-upper = to-lower-local(sname)
                        dq2 = find-byte-local(inner, 34, dq + 1)
                        dq2 >= 0 -> {
                            subsec = str-copy(inner, dq + 1, dq2)
                            current-section = sname-upper - '.' - subsec
                        }
                    } -> {
                        inner = trim-ws(inner)
                        inner-upper = to-lower-local(inner)
                        current-section = inner-upper
                    }
                    ; check if this matches our target section
                    same = str-eq-local(current-section, sect-upper)
                    in-section = same
                }
            } -> {
                ; key = value line
                in-section == true -> {
                    eq = find-byte-local(trimmed, 61, 0) ; =
                    eq >= 0 -> {
                        k = str-copy(trimmed, 0, eq)
                        k = trim-ws(k)
                        k-upper = to-lower-local(k)
                        target-key-upper = to-lower-local(key)
                        key-same = str-eq-local(k-upper, target-key-upper)
                        key-same == true -> {
                            v = str-copy(trimmed, eq + 1, trimmed.len)
                            v = trim-ws(v)
                            ; strip surrounding quotes if present
                            v.len >= 2 -> {
                                v[0] == 34 -> {
                                    v2 = str-copy(v, 1, v.len - 1)
                                    v = v2
                                }
                            }
                            value = v
                            ok = true
                            break
                        }
                    }
                }
            }
        }
        pos = nl + 1
        nl < 0 -> break
    } (true)
}

// config-set: set a config value in .git/config (replaces existing or appends)
// git-dir str, section str, key str, value str
// returns ok bool
config-set = (git-dir str, section str, key str, value str) (ok bool) {
    ok = false
    p = git-dir - '/config'
    content str
    file-ok bool
    content, file-ok = read-file-str(p)
    file-ok == false -> {
        content = ''
    }
    ; build new content
    sect-upper = to-lower-local(section)
    target-key-upper = to-lower-local(key)
    ; scan for existing section and key
    new-content = ''
    pos = 0
    in-section = false
    current-section str = ''
    found-and-replaced = false
    section-found = false
    last-section-end i64 = 0
    {
        pos >= content.len -> break
        nl = find-byte-local(content, 10, pos)
        end = content.len
        nl >= 0 -> end = nl
        line = str-copy(content, pos, end)
        trimmed = trim-ws(line)
        trimmed.len == 0 -> {
            new-content = new-content - line - '\n'
        } -> {
            ; section header
            trimmed.starts-with('[') -> {
                rb = find-byte-local(trimmed, 93, 0)
                rb >= 0 -> {
                    inner = str-copy(trimmed, 1, rb)
                    dq = find-byte-local(inner, 34, 0)
                    dq >= 0 -> {
                        sname = str-copy(inner, 0, dq)
                        sname = trim-ws(sname)
                        sname-upper = to-lower-local(sname)
                        dq2 = find-byte-local(inner, 34, dq + 1)
                        dq2 >= 0 -> {
                            subsec = str-copy(inner, dq + 1, dq2)
                            current-section = sname-upper - '.' - subsec
                        }
                    } -> {
                        inner = trim-ws(inner)
                        inner-upper = to-lower-local(inner)
                        current-section = inner-upper
                    }
                    same = str-eq-local(current-section, sect-upper)
                    in-section = same
                    same == true -> section-found = true
                }
                new-content = new-content - line - '\n'
            } -> {
                ; key = value line
                in-section == true -> {
                    eq = find-byte-local(trimmed, 61, 0)
                    eq >= 0 -> {
                        k = str-copy(trimmed, 0, eq)
                        k = trim-ws(k)
                        k-upper = to-lower-local(k)
                        key-same = str-eq-local(k-upper, target-key-upper)
                        key-same == true -> {
                            ; replace this line
                            new-content = new-content - '\t' - key - ' = ' - value - '\n'
                            found-and-replaced = true
                        } -> {
                            new-content = new-content - line - '\n'
                        }
                    } -> {
                        new-content = new-content - line - '\n'
                    }
                } -> {
                    new-content = new-content - line - '\n'
                }
            }
        }
        pos = nl + 1
        nl < 0 -> break
    } (true)
    ; if key was not found in the section, append it
    found-and-replaced == true -> {} -> {
        ; if section doesn't exist, create it
        section-found == false -> {
            new-content = new-content - '[' - section - ']\n'
        }
        new-content = new-content - '\t' - key - ' = ' - value - '\n'
    }
    write-file-simple(p, new-content)
    ok = true
}

// ═══════════════════════════════════════════════
// user info helpers
// ═══════════════════════════════════════════════

// get-user-name: get user.name from config or env
// git-dir str
// returns name str, ok bool
get-user-name = (git-dir str) (name str, ok bool) {
    name, ok = config-get(git-dir, 'user', 'name')
    ok == true -> return
    ; fall back to env
    name = os.get-env('GIT_AUTHOR_NAME')
    name == '' -> name = os.get-env('GIT_COMMITTER_NAME')
    name != '' -> ok = true
}

// get-user-email: get user.email from config or env
// git-dir str
// returns email str, ok bool
get-user-email = (git-dir str) (email str, ok bool) {
    email, ok = config-get(git-dir, 'user', 'email')
    ok == true -> return
    email = os.get-env('GIT_AUTHOR_EMAIL')
    email == '' -> email = os.get-env('GIT_COMMITTER_EMAIL')
    email != '' -> ok = true
}

// ═══════════════════════════════════════════════
// keepalive
// ═══════════════════════════════════════════════

config-keepalive = () (alive bool) {
    _v str; _ok bool
    _v, _ok = config-get('/tmp/.config-test', 'core', 'bare')
    _ok2 bool
    _ok2 = config-set('/tmp/.config-test', 'core', 'bare', 'false')
    _n str
    _n, _ok3 = get-user-name('/tmp/.config-test')
    _e str
    _e, _ok4 = get-user-email('/tmp/.config-test')
    alive = true
}
