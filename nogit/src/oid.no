; oid — Git object identifiers (SHA-1) and object hashing
;
; A Git object id is the SHA-1 (20 bytes) of the bytes:
;   "<type> <size>\0<payload>"
; We model it as a struct wrapping [20]byte so we can attach methods and keep
; it distinct from a plain byte array.

; oid: a 20-byte Git object identifier
oid {
    id [20]byte
}

; oid.to-hex: render the object id as a 40-character lowercase hex string
; returns out str: hex digest
oid.to-hex = () (out str) {
    out str = with-len(40)
    hex-chars = '0123456789abcdef'
    i <- [0..20): {
        b = .id[i]

        d9v1 char = hex-chars[(b >> 4) & 15]: {
            ok -> it

            -> "0"
        }

        #{overflow=wrap}
        out[i * 2]: {
            ok -> it = d9v1

            -> _
        }

        d9v2 char = hex-chars[b & 15]: {
            ok -> it

            -> "0"
        }

        #{overflow=wrap}
        out[i * 2 + 1]: {
            ok -> it = d9v2

            -> _
        }
    }
}

; oid-hex-str: render an oid as a 40-char hex string. Provided as a FREE
; function (NOT the .to-hex method) for cross-module use.
; o oid: the object id
; returns out str: 40-char lowercase hex string
oid-hex-str = (o oid) (out str) {
    out = ''
    hc = '0123456789abcdef'
    i <- [0..20): {
        b = o.id[i]
        d9v3 str = hc[(b >> 4) & 15]: {
            ok -> it

            -> ''
        }
        out.push-str(d9v3)
        d9v4 str = hc[b & 15]: {
            ok -> it

            -> ''
        }
        out.push-str(d9v4)
    }
}

; zero-oid: a zeroed object id (all zeros)
zero-oid = () (o oid) {
    i <- [0..20): o.id[i] = 0
}

; oid.eq: byte-wise equality with another oid
; o oid: the other id
; returns yes bool
oid.eq = (o oid) (yes bool) {
    yes = true
    i <- [0..20): {
        lv byte = .id[i]: {
            ok -> it

            -> 0
        }
        rv byte = o.id[i]: {
            ok -> it

            -> 0
        }
        lv != rv -> {
            yes = false
            return
        }
    }
}

; oid.is-zero: true when the id is all zeros (unused / unknown)
; returns yes bool
oid.is-zero = () (yes bool) {
    yes = true
    i <- [0..20): {
        lv byte = .id[i]: {
            ok -> it

            -> 0
        }
        lv != 0 -> {
            yes = false
            return
        }
    }
}

; oid-from-hex: parse a 40-char hex string into an oid
; s str: hex digest
; returns o ?oid: the id (nil if not exactly 40 valid hex chars)
;
; NOTE: we build into a LOCAL `tmp` and assign it to the return param `o` at
; the end. Mutating the nested [20]byte array field of a return-parameter
; struct directly does not persist in nolang, so we copy through a local.
oid-from-hex = (s str) (o ?oid) {
    s.len-bytes() != 40 -> return
    tmp oid
    i <- [0..20): {
        c0 byte = s.byte(i * 2): {
            ok -> it

            -> 0
        }

        c1 byte = s.byte(i * 2 + 1): {
            ok -> it

            -> 0
        }
        hi = util.hexdigit(c0)
        lo = util.hexdigit(c1)
        hi < 0 || lo < 0 -> return
        bv byte = (hi << 4) | lo
        tmp.id[i]: {
            ok -> it = bv

            -> _
        }
    }
    o = tmp
}

; object-header: build the "<type> <size>\0" header bytes for an object,
; returned as a *byte-string* (each codepoint == one byte 0-255).
; kind str: one of blob/tree/commit/tag
; size i64: payload byte length
; returns out str: header bytes (no payload appended)
object-header = (kind str, size i64) (out str) {
    sz = util.i64-to-str(size)
    nul = '\0'
    out = kind - ' ' - sz - nul
}

; sha1-hex: SHA-1 digest of a byte-string, returned as a 40-char hex string.
; data str: message bytes (each codepoint 0-255)
; returns out str: lowercase hex digest
;
; Pure-Nolang implementation. IMPORTANT: all hash-state word math is done in
; `u32`. nolang's bitwise operators (& | ^ ~) are correct on `u32` but truncate
; to 8 bits on `i64`; `<<` / `rotate-left` widen to `i64`, so their result is
; narrowed back to `u32` with `& 4294967295`. `u32` addition naturally wraps
; mod 2^32 (same pattern gitoxide/md5.no rely on). The message bytes are still
; carried as a `str` byte-string because []byte is unreliable across modules.
; rotl32: 32-bit left rotate implemented with explicit shifts.
; The builtin rotate lowers to llvm.fshl.i64 — a 64-bit rotate. Its width is
; chosen from the argument's MIR type, but MIR (and even HIR) flattens every
; integer to i64, so a `u32` argument is indistinguishable from i64 and the
; builtin degenerates to `(x << n)`, silently dropping the `x >> (32-n)`
; wrap-around half. That makes every 32-bit hash (SHA-1 here, md5x in
; notools) produce wrong digests.
rotl32 = (x u32, n i64) (r u32) {
    r = ((x << n) | (x >> (32 - n))) & 4294967295
}

sha1-hex = (data str) (out str) {
    h0 u32 = 0x67452301
    h1 u32 = 0xefcdab89
    h2 u32 = 0x98badcfe
    h3 u32 = 0x10325476
    h4 u32 = 0xc3d2e1f0

    ; MIR 會把所有整數展平成 i64，`u32` 只是「範圍提示」：算術不會自動截斷到
    ; 32 位（`#{overflow=wrap}` 是 lint 註解，不做截斷）。故每個 32-bit 累加
    ; 之後都要手動 & mask，否則 h0..h4 會長到 64 位、摘要全錯。
    ; （notools/src/sha1x.no 用的是同一套寫法。）
    mask u32 = 4294967295

    mlen = data.len-bytes()

    #{overflow=wrap}
    bitlen i64 = mlen * 8

    #{overflow=wrap}
    total = mlen + 1
    rem = total % 64

    #{overflow=wrap}
    z = 56 - rem

    #{overflow=wrap}
    z < 0 -> z = z + 64: {
        ok -> it

        -> _
    }

    #{overflow=wrap}
    plen = total + z + 8

    msgb []byte = with-cap-len(plen, plen)

    ; build raw bytes: place-writing bytes >= 0x80 into a str stores a code point
    ; and consecutive writes lose high bytes — sha1 padding must be raw bytes
    i <- [0..mlen): {
        dbv = data.byte(i)
        dv byte = 0
        dbv: {
            ok -> dv = it

            -> _
        }
        msgb[i] = dv
    }
    msgb[mlen] = 0x80
    i <- [0..z): {
        msgb[mlen + 1 + i] = 0
    }
    hi = (bitlen >> 32) & 0xffffffff
    lo = bitlen & 0xffffffff

    msgb[mlen + 1 + z + 0] = (hi >> 24) & 0xff
    msgb[mlen + 1 + z + 1] = (hi >> 16) & 0xff
    msgb[mlen + 1 + z + 2] = (hi >> 8) & 0xff
    msgb[mlen + 1 + z + 3] = hi & 0xff
    msgb[mlen + 1 + z + 4] = (lo >> 24) & 0xff
    msgb[mlen + 1 + z + 5] = (lo >> 16) & 0xff
    msgb[mlen + 1 + z + 6] = (lo >> 8) & 0xff
    msgb[mlen + 1 + z + 7] = lo & 0xff

    msg str = msgb.slice(0, plen).to-bytes-str()

    #{overflow=wrap}
    nchunks = plen / 64
    w [80]u32
    t u32
    ci <- [0..nchunks): {

        #{overflow=wrap}
        off = ci * 64
        j <- [0..16): {

            ; NOTE: `str[i]` now yields a *codepoint*, so byte access must go
            ; through s.byte(i). Assigning a byte value > 127 into a u32
            ; SIGN-extends it (e.g. 0x80 -> 0xffffff80), so mask with & 0xff
            ; to force zero-extension before the shift/OR.
            #{overflow=wrap}
            w0 u32 = msg.byte(off + j * 4) & 0xff

            #{overflow=wrap}
            w1 u32 = msg.byte(off + j * 4 + 1) & 0xff

            #{overflow=wrap}
            w2 u32 = msg.byte(off + j * 4 + 2) & 0xff

            #{overflow=wrap}
            w3 u32 = msg.byte(off + j * 4 + 3) & 0xff
            w[j]: {
                ok -> it = w0

                -> _
            }

            d9v5 u32 = w[j]: {
                ok -> it

                -> 0
            }
            w[j]: {
                ok -> it = (d9v5 << 24) & mask

                -> _
            }
            t = (w1 << 16) & mask

            d9v6 u32 = w[j]: {
                ok -> it

                -> 0
            }
            w[j]: {
                ok -> it = d9v6 | t

                -> _
            }
            t = (w2 << 8) & mask

            d9v7 u32 = w[j]: {
                ok -> it

                -> 0
            }
            w[j]: {
                ok -> it = d9v7 | t

                -> _
            }

            d9v8 u32 = w[j]: {
                ok -> it

                -> 0
            }
            w[j]: {
                ok -> it = d9v8 | w3

                -> _
            }
        }
        j <- [16..80): {

            ; W[i] = rotl1(W[i-3] ^ W[i-8] ^ W[i-14] ^ W[i-16]); XOR is associative,
            ; so fold the four terms into one u32-annotated declaration. Splitting the
            ; chain across separate `v = v ^ ...` reassignments makes the checker re-widen
            ; v to i64 (u32 ^ u32 -> i64), which then trips rotl32's u32 parameter.
            wm3 u32 = w[j - 3]: {
                ok -> it

                -> 0
            }
            wm8 u32 = w[j - 8]: {
                ok -> it

                -> 0
            }
            wm14 u32 = w[j - 14]: {
                ok -> it

                -> 0
            }
            wm16 u32 = w[j - 16]: {
                ok -> it

                -> 0
            }

            v u32 = wm3 ^ wm8 ^ wm14 ^ wm16
            rv u32 = rotl32(v, 1)
            w[j]: {
                ok -> it = rv

                -> _
            }
        }
        a u32 = h0
        b u32 = h1
        c u32 = h2
        d u32 = h3
        e u32 = h4

        ; working vars hoisted outside the loop (md5.no pattern)
        ; NOTE: nolang `->` branches are sequential `if`s, NOT if-elif. Each
        ; condition below is made mutually exclusive with a lower bound so the
        ; correct f/k is selected for the round.
        f u32
        k u32
        j <- [0..80): {
            j < 20 -> {
                f = (b & c) | ((~b) & d)
                k = 0x5a827999
            }
            j >= 20 && j < 40 -> {
                f = b ^ c ^ d
                k = 0x6ed9eba1
            }
            j >= 40 && j < 60 -> {
                f = (b & c) | (b & d) | (c & d)
                k = 0x8f1bbcdc
            }
            j >= 60 -> {
                f = b ^ c ^ d
                k = 0xca62c1d6
            }
            ta u32 = rotl32(a, 5)

            #{overflow=wrap}
            temp u32 = (ta + f) & mask

            #{overflow=wrap}
            temp = (temp + e) & mask

            #{overflow=wrap}
            temp = (temp + k) & mask

            wj u32 = w[j]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            temp = (temp + wj) & mask
            temp = temp & mask
            e = d
            d = c
            c = rotl32(b, 30)
            b = a
            a = temp
        }

        h0 = (h0 + a) & mask

        h1 = (h1 + b) & mask

        h2 = (h2 + c) & mask

        h3 = (h3 + d) & mask

        h4 = (h4 + e) & mask
    }

    ; assemble 20 raw digest bytes then hex-encode
    dig [20]byte
    digv0 byte = (h0 >> 24) & 0xff
    dig[0]: {
        ok -> it = digv0

        -> _
    }
    digv1 byte = (h0 >> 16) & 0xff
    dig[1]: {
        ok -> it = digv1

        -> _
    }
    digv2 byte = (h0 >> 8) & 0xff
    dig[2]: {
        ok -> it = digv2

        -> _
    }
    digv3 byte = h0 & 0xff
    dig[3]: {
        ok -> it = digv3

        -> _
    }
    digv4 byte = (h1 >> 24) & 0xff
    dig[4]: {
        ok -> it = digv4

        -> _
    }
    digv5 byte = (h1 >> 16) & 0xff
    dig[5]: {
        ok -> it = digv5

        -> _
    }
    digv6 byte = (h1 >> 8) & 0xff
    dig[6]: {
        ok -> it = digv6

        -> _
    }
    digv7 byte = h1 & 0xff
    dig[7]: {
        ok -> it = digv7

        -> _
    }
    digv8 byte = (h2 >> 24) & 0xff
    dig[8]: {
        ok -> it = digv8

        -> _
    }
    digv9 byte = (h2 >> 16) & 0xff
    dig[9]: {
        ok -> it = digv9

        -> _
    }
    digv10 byte = (h2 >> 8) & 0xff
    dig[10]: {
        ok -> it = digv10

        -> _
    }
    digv11 byte = h2 & 0xff
    dig[11]: {
        ok -> it = digv11

        -> _
    }
    digv12 byte = (h3 >> 24) & 0xff
    dig[12]: {
        ok -> it = digv12

        -> _
    }
    digv13 byte = (h3 >> 16) & 0xff
    dig[13]: {
        ok -> it = digv13

        -> _
    }
    digv14 byte = (h3 >> 8) & 0xff
    dig[14]: {
        ok -> it = digv14

        -> _
    }
    digv15 byte = h3 & 0xff
    dig[15]: {
        ok -> it = digv15

        -> _
    }
    digv16 byte = (h4 >> 24) & 0xff
    dig[16]: {
        ok -> it = digv16

        -> _
    }
    digv17 byte = (h4 >> 16) & 0xff
    dig[17]: {
        ok -> it = digv17

        -> _
    }
    digv18 byte = (h4 >> 8) & 0xff
    dig[18]: {
        ok -> it = digv18

        -> _
    }
    digv19 byte = h4 & 0xff
    dig[19]: {
        ok -> it = digv19

        -> _
    }

    hex-chars = '0123456789abcdef'
    out str = with-len(40)
    i <- [0..20): {
        b = dig[i]

        d9v9 char = hex-chars[(b >> 4) & 15]: {
            ok -> it

            -> "0"
        }

        #{overflow=wrap}
        out[i * 2]: {
            ok -> it = d9v9

            -> _
        }

        d9v10 char = hex-chars[b & 15]: {
            ok -> it

            -> "0"
        }

        #{overflow=wrap}
        out[i * 2 + 1]: {
            ok -> it = d9v10

            -> _
        }
    }
}

; hash-object: compute the object id of (kind, data)
; kind str: object type
; data str: payload as a byte-string (each codepoint 0-255)
; returns o oid: SHA-1 of header + payload
;
; Pure-Nolang SHA-1 (sha1-hex) operating on str — no std sha1, no []byte
; crossing a module boundary, so it is robust against the compiler bugs.
hash-object = (kind str, data str) (o oid) {
    hdr = object-header(kind, data.len-bytes())

    #{overflow=wrap}
    buflen = hdr.len-bytes() + data.len-bytes()
    buf []byte = with-cap-len(buflen, buflen)

    ; build raw bytes: place-writes of bytes >= 0x80 store code points / lose writes
    i <- [0..hdr.len-bytes()): {
        hbv = hdr.byte(i)
        hv byte = 0
        hbv: {
            ok -> hv = it

            -> _
        }
        buf[i] = hv
    }
    i <- [0..data.len-bytes()): {
        dbv = data.byte(i)
        dv byte = 0
        dbv: {
            ok -> dv = it

            -> _
        }
        buf[hdr.len-bytes() + i] = dv
    }
    hx = sha1-hex(buf.slice(0, buflen).to-bytes-str())
    o-opt = oid-from-hex(hx)
    o oid
    ok = false
    o-opt: {
        ok -> {
            o = o-opt
            ok = true
        }

        nil || err -> {
        }
    }
    ok -> {}
}

; empty-tree-oid: the well-known id of the empty tree object
; returns o oid
empty-tree-oid = () (o oid) {

    ; empty tree has zero payload bytes -> data is the empty byte-string
    o = hash-object('tree', '')
}
