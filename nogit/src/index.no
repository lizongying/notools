; index — Git staging area (index file format v2)
;
; The index is a binary file at .git/index that tracks staged files.
; Format (index v2):
;   Header: "DIRC" (4) + version(4, BE) + entry_count(4, BE)
;   For each entry:
;     ctime-s(4) ctime-n(4) mtime-s(4) mtime-n(4)
;     dev(4) ino(4) mode(4) uid(4) gid(4) size(4)
;     sha1(20) flags(2)
;     name(nul-terminated, padded to 8-byte boundary)
;   Extensions (optional)
;   SHA-1 trailer (20 bytes, hash of entire file content)
;
; Cross-module safety: returns individual scalars/strings/oids.

# /nogit/src/util
# /nogit/src/oid

; ═══════════════════════════════════════════════
; index entry struct (intra-module only — never returned across boundary)
; ═══════════════════════════════════════════════

index-entry {
    ctime-s i64
    ctime-n i64
    mtime-s i64
    mtime-n i64
    dev i64
    ino i64
    mode i64
    uid i64
    gid i64
    size i64
    oid oid
    flags i64
    name str
}

; ═══════════════════════════════════════════════
; local helpers
; ═══════════════════════════════════════════════

; build a 1-byte string from the low byte of v
i64-to-byte-at = (v i64) (out str) {
    b []byte = with-cap-len(1, 1)
    b[0] = v & 0xff
    out = b.slice(0, 1).to-bytes-str()
}

; build a big-endian 32-bit int as a 4-byte string
i64-to-u32-be-at = (v i64) (out str) {
    b []byte = with-cap-len(4, 4)
    b[0] = (v >> 24) & 0xff
    b[1] = (v >> 16) & 0xff
    b[2] = (v >> 8) & 0xff
    b[3] = v & 0xff
    out = b.slice(0, 4).to-bytes-str()
}

; build a big-endian 16-bit int as a 2-byte string
i64-to-u16-be-at = (v i64) (out str) {
    b []byte = with-cap-len(2, 2)
    b[0] = (v >> 8) & 0xff
    b[1] = v & 0xff
    out = b.slice(0, 2).to-bytes-str()
}

; read-u32-be-local: read big-endian 32-bit from a str at offset
; NOTE: use .byte() (raw byte) not s[i] (UTF-8 codepoint), otherwise binary
; bytes >= 0x80 in index content are misread (see util.str-range/find-byte-str).
read-u32-be-local = (s str, pos i64) (v i64) {
    v = s.byte(pos) & 0xff
    v = (v << 8) | (s.byte(pos + 1) & 0xff)
    v = (v << 8) | (s.byte(pos + 2) & 0xff)
    v = (v << 8) | (s.byte(pos + 3) & 0xff)
}

read-u16-be-local = (s str, pos i64) (v i64) {
    v = s.byte(pos) & 0xff
    v = (v << 8) | (s.byte(pos + 1) & 0xff)
}

; find-newline-local: find byte 10 (newline) in str from position
; Returns s.len if not found.
; Wraps util.find-byte-str (which returns -1) converting to s.len.
find-newline-local = (s str, from i64) (pos i64) {
    pos = util.find-byte-str(s, 10, from)
    pos < 0 -> pos = s.len-bytes()
}

; G-10: byte-range via fixed-index str writes (§6.6 safe) instead of
; util.str-range's []byte scratch, which non-deterministically bad-copies
; some byte ranges (verified: str-range returns all-zero / SIGBUS on index
; content while .byte() on the same offsets is correct).
byte-range-str = (s str, a i64, n i64) (out str) {
    cs []char
    i <- [0..n): {
        cbv = s.byte(a + i)
        v i32 = 0
        cbv: {
            ok -> v = it

            -> _
        }
        cs.push(v)
    }
    out = str.from-chars(cs)
}

; ═══════════════════════════════════════════════
; index read
; ═══════════════════════════════════════════════

; read-index: read .git/index and return entries as flat arrays
; git-dir str
; returns:
;   names str  — all entry names, newline-separated
;   hexoids str — all entry oids as 40-char hex, concatenated
;   modes str  — all entry modes as decimal strings, newline-separated
;   count i64  — number of entries
;   ok bool    — false if index is missing or corrupt
;
; Note: because nolang []str is unreliable across module boundaries, we
; concatenate all names with '\n' and all hex oids together (each 40 chars).
; The caller splits them by position.
read-index = (git-dir str) (names str, hexoids str, modes str, count i64, ok bool) {
    ok = false
    names = ''
    hexoids = ''
    modes = ''
    count = 0
    p = git-dir - '/index'
    content str
    file-ok bool
    isf = fs.is-file(p)
    {
        ! isf -> {
            content = ''
            file-ok = false
        }

        -> {
            content = fs.read-file(p).to-bytes-str()
            file-ok = true
        }
    }
    {
        ! file-ok -> return

        content.len-bytes() < 12 -> return

        ; verify signature "DIRC"
        content[0] != 68 -> return; D

        content[1] != 73 -> return; I

        content[2] != 82 -> return; R

        content[3] != 67 -> return; C
    }

    ; version
    ver = read-u32-be-local(content, 4)

    ; G-10: header v2 (also carries v3 stage entries, same layout) and
    ; v4 (prefix-compressed names, no 8-byte padding).
    ver != 2 && ver != 4 -> return
    is-v4 = ver == 4

    ; entry count
    count = read-u32-be-local(content, 8)
    count < 0 -> return

    ; parse entries
    names = ''
    hexoids = ''
    modes = ''
    pos = 12
    entry-start i64
    entry-len i64
    prev-name str = ''
    suffix-len i64 = 0
    i <- [0..count): {

        #{overflow=wrap}
        pos + 62 > content.len-bytes() -> {
            count = i
            break
        }

        ; skip ctime(8), mtime(8), dev(4), ino(4) = 24 bytes
        #{overflow=wrap}
        pos = pos + 24: {
            ok -> it

            -> _
        }

        ; mode (4 bytes BE)
        mode-val i64 = read-u32-be-local(content, pos)

        #{overflow=wrap}
        pos = pos + 4: {
            ok -> it

            -> _
        }

        ; skip uid(4), gid(4), size(4) = 12 bytes
        #{overflow=wrap}
        pos = pos + 12: {
            ok -> it

            -> _
        }

        ; sha1 (20 bytes)
        ob []byte = with-cap-len(20, 20)
        k <- [0..20): {
            cbv = content.byte(pos + k)
            v byte = 0
            cbv: {
                ok -> v = it

                -> _
            }
            ob[k] = v
        }
        oid-bytes str = ob.slice(0, 20).to-bytes-str()

        #{overflow=wrap}
        pos = pos + 20: {
            ok -> it

            -> _
        }

        ; flags (2 bytes BE) — lower 12 bits = name length
        flags i64 = read-u16-be-local(content, pos)

        #{overflow=wrap}
        pos = pos + 2: {
            ok -> it

            -> _
        }
        name-len = flags & 0xfff

        ; G-10 v4: after flags comes [strip:1][suffix:name-len][NUL], no pad.
        ; Full name = prev[0 .. prev.len-strip) + suffix. v2: [name][NUL]+pad.
        nm str = ''
        is-v4 -> {
            strip = content.byte(pos) & 0xff

            #{overflow=wrap}
            keep = prev-name.len-bytes() - strip: {
                ok -> it

                -> _
            }
            keep < 0 -> keep = 0
            ; suffix length = full name_len - kept prefix bytes
            #{overflow=wrap}
            suffix-len = name-len - keep: {
                ok -> it

                -> _
            }
            suffix-len < 0 -> suffix-len = 0
            #{overflow=wrap}
            pos + 1 + suffix-len > content.len-bytes() -> {
                count = i
                break
            }
            suffix = byte-range-str(content, pos + 1, suffix-len)
            nm = byte-range-str(prev-name, 0, keep) - suffix
        }
        ! is-v4 -> {
            #{overflow=wrap}
            pos + name-len > content.len-bytes() -> {
                count = i
                break
            }
            nm = byte-range-str(content, pos, name-len)
        }
        prev-name = nm

        names = names - nm - '\n'

        ; hex oid
        ; G-11/X-3: str index assignment writes the option tag byte (0x01).
        ; Build the hex string by direct concatenation instead.
        hx = ''
        hc = '0123456789abcdef'
        j <- [0..20): {
            b = oid-bytes.byte(j)

            d9v1 str = hc[(b >> 4) & 15]: {
                ok -> it.to-str()

                -> ''
            }
            hx = hx - d9v1

            d9v2 str = hc[b & 15]: {
                ok -> it.to-str()

                -> ''
            }
            hx = hx - d9v2
        }
        hexoids = hexoids - hx

        ; mode as decimal
        ms = util.i64-to-str(mode-val)

        modes = modes - ms - '\n'

        ; advance past name + NUL
        #{overflow=wrap}
        entry-start = pos - 62: {
            ok -> it

            -> _
        }

        entry-len i64 = 0
        is-v4 -> {
            ; G-10 v4: 62 fixed + 1 strip + suffix + 1 NUL, NO 8-byte pad
            #{overflow=wrap}
            entry-len = 64 + suffix-len: {
                ok -> it

                -> _
            }
        }
        ! is-v4 -> {
            ; v2: 62 fixed + name + 1 NUL, padded to 8-byte boundary
            #{overflow=wrap}
            entry-len = 62 + name-len + 1: {
                ok -> it

                -> _
            }
            rem = entry-len % 8

            #{overflow=wrap}
            rem > 0 -> entry-len = entry-len + (8 - rem): {
                ok -> it

                -> _
            }
        }

        #{overflow=wrap}
        pos = entry-start + entry-len: {
            ok -> it

            -> _
        }
        pos > content.len-bytes() -> {

            #{overflow=wrap}
            count = i + 1: {
                ok -> it

                -> _
            }
            break
        }
    }
    ok = true
}

; read-index-entry-at: read a specific entry's full info from index
; git-dir str, index i64 (0-based)
; returns name str, oid oid, mode i64, ok bool
read-index-entry-at = (git-dir str, idx i64) (name str, o oid, mode i64, ok bool) {
    ok = false
    name = ''
    mode = 0
    p = git-dir - '/index'
    content str
    file-ok bool
    isf = fs.is-file(p)
    {
        ! isf -> {
            content = ''
            file-ok = false
        }

        -> {
            content = fs.read-file(p).to-bytes-str()
            file-ok = true
        }
    }
    {
        ! file-ok -> return

        content.len-bytes() < 12 -> return

        ; verify signature
        content[0] != 68 -> return

        content[1] != 73 -> return

        content[2] != 82 -> return

        content[3] != 67 -> return
    }
    count = read-u32-be-local(content, 8)
    idx >= count -> return

    ; skip to entry idx
    pos = 12
    entry-start i64
    entry-len i64
    i <- [0..idx): {

        #{overflow=wrap}
        pos + 62 > content.len-bytes() -> return

        #{overflow=wrap}
        pos = pos + 24: {
            ok -> it

            -> _
        }; skip ctime/mtime/dev/ino

        #{overflow=wrap}
        pos = pos + 4: {
            ok -> it

            -> _
        }; skip mode

        #{overflow=wrap}
        pos = pos + 12: {
            ok -> it

            -> _
        }; skip uid/gid/size

        #{overflow=wrap}
        pos = pos + 20: {
            ok -> it

            -> _
        }; skip sha1
        flags = read-u16-be-local(content, pos)

        #{overflow=wrap}
        pos = pos + 2: {
            ok -> it

            -> _
        }
        skip-name-len = flags & 0xfff

        #{overflow=wrap}
        entry-start = pos - 62: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        entry-len = 62 + skip-name-len + 1: {
            ok -> it

            -> _
        }
        rem = entry-len % 8

        #{overflow=wrap}
        rem > 0 -> entry-len = entry-len + (8 - rem): {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        pos = entry-start + entry-len: {
            ok -> it

            -> _
        }
    }

    ; now at entry idx
    #{overflow=wrap}
    pos + 62 > content.len-bytes() -> return

    #{overflow=wrap}
    pos = pos + 24: {
        ok -> it

        -> _
    }; skip ctime/mtime/dev/ino
    mode = read-u32-be-local(content, pos)

    #{overflow=wrap}
    pos = pos + 4: {
        ok -> it

        -> _
    }

    #{overflow=wrap}
    pos = pos + 12: {
        ok -> it

        -> _
    }; skip uid/gid/size

    ; read oid
    tmp oid
    k <- [0..20): {

        #{overflow=wrap}
        tmp.id[k] = content.byte(pos + k)
    }
    o = tmp

    #{overflow=wrap}
    pos = pos + 20: {
        ok -> it

        -> _
    }
    flags = read-u16-be-local(content, pos)

    #{overflow=wrap}
    pos = pos + 2: {
        ok -> it

        -> _
    }
    name-len = flags & 0xfff

    #{overflow=wrap}
    name = util.str-range(content, pos, pos + name-len)
    ok = true
}

; ═══════════════════════════════════════════════
; index write
; ═══════════════════════════════════════════════

; write-index: write .git/index from flat arrays
; git-dir str
; names-str str: newline-separated file paths
; oids-str str: concatenated 40-char hex oids
; modes-str str: newline-separated mode strings
; count i64: number of entries
; returns ok bool
;
; We build the entire index file content as a single str (byte-string)
; and write it byte-by-byte (stride-safe).
;
; Stat fields (ctime/mtime/uid/gid/size) are populated using fs.stat-*
; builtins. dev and ino remain 0 (not available in Nolang stdlib).
write-index = (git-dir str, names-str str, oids-str str, modes-str str, count i64) (ok bool) {
    ok = false
    p = git-dir - '/index'

    ; get working directory for stat lookups
    work-dir = os.get-wd()

    ; build index content
    ; header: DIRC + version(4) + count(4) = 12 bytes
    ; each entry: 62 bytes fixed + name + NUL + padding
    ; we need two passes: first compute total size, then build
    ; for simplicity, build incrementally as a concat str
    out = ''

    ; DIRC signature
    sig = 'DIRC'
    out = out - sig

    ; version 2
    ver = i64-to-u32-be-at(2)
    out = out - ver

    ; entry count
    cnt = i64-to-u32-be-at(count)
    out = out - cnt

    ; parse names, modes, oids from flat strings
    name-pos = 0
    mode-pos = 0
    i <- [0..count): {

        ; find end of name i
        nl = find-newline-local(names-str, name-pos)
        nm = util.str-range(names-str, name-pos, nl)

        ; find end of mode i
        nl2 = find-newline-local(modes-str, mode-pos)
        ms = modes-str[mode-pos..nl2)

        ; parse mode
        mode-val i64 = 0
        k <- [0..ms.len-bytes()): {

            #{overflow=wrap}
            mode-val = mode-val * 10 + (ms[k] - 48)
        }

        ; extract oid i (40 chars each)
        hx = oids-str[i * 40..i * 40 + 40)

        ; parse oid
        entry-oid oid
        k <- [0..20): {

            #{overflow=wrap}
            c0 = hx[k * 2]

            #{overflow=wrap}
            c1 = hx[k * 2 + 1]
            hi = util.hexdigit(c0)
            lo = util.hexdigit(c1)
            entry-oid.id[k] = (hi << 4) | lo
        }

        ; build entry (62 bytes fixed + name + NUL + padding)
        ; populate stat fields using fs.stat-* builtins
        ; build the full file path for stat lookup
        stat-path = work-dir - '/' - nm
        stat-ok = fs.is-file(stat-path)

        ; stat fields (default to 0 if file not found)
        st-mtime i64 = 0
        st-uid i64 = 0
        st-gid i64 = 0
        st-size i64 = 0
        stat-ok -> {
            st-mtime = fs.stat-mtime(stat-path)
            st-uid = fs.stat-uid(stat-path)
            st-gid = fs.stat-gid(stat-path)
            st-size, st-sok = os.stat-size(stat-path)
            ! st-sok -> st-size = 0
        }

        ; ctime(8) — use mtime as ctime (Nolang has no stat-ctime)
        ct8 str = i64-to-u32-be-at(st-mtime) - '\x00\x00\x00\x00'
        out = out - ct8

        ; mtime(8)
        mt8 str = i64-to-u32-be-at(st-mtime) - '\x00\x00\x00\x00'
        out = out - mt8

        ; dev(4) — 0 (not available in Nolang stdlib)
        zero4 str = with-len(4)
        out = out - zero4

        ; ino(4) — 0 (not available in Nolang stdlib)
        out = out - zero4

        ; mode(4)
        mode-bytes str = i64-to-u32-be-at(mode-val)
        out = out - mode-bytes

        ; uid(4)
        uid-bytes str = i64-to-u32-be-at(st-uid)
        out = out - uid-bytes

        ; gid(4)
        gid-bytes str = i64-to-u32-be-at(st-gid)
        out = out - gid-bytes

        ; size(4)
        size-bytes str = i64-to-u32-be-at(st-size)
        out = out - size-bytes

        ; sha1(20)
        ob []byte = with-cap-len(20, 20)
        k <- [0..20): {
            ebv = entry-oid.id[k]
            v byte = 0
            ebv: {
                ok -> v = it

                -> _
            }
            ob[k] = v
        }
        oid-bytes str = ob.slice(0, 20).to-bytes-str()
        out = out - oid-bytes

        ; flags(2) — name length in lower 12 bits
        name-len = nm.len-bytes()
        name-len > 0xfff -> name-len = 0xfff
        flags-bytes str = i64-to-u16-be-at(name-len)
        out = out - flags-bytes

        ; name + NUL
        out = out - nm
        nul-byte str = with-len(1)
        nul-byte[0]: {
            ok -> it = 0

            -> _
        }
        out = out - nul-byte

        ; pad to 8-byte boundary
        ; entry total so far = 62 + nm.len + 1
        #{overflow=wrap}
        entry-total = 62 + nm.len-bytes() + 1
        rem = entry-total % 8
        rem > 0 -> {

            #{overflow=wrap}
            pad-count = 8 - rem
            k <- [0..pad-count): {
                pb str = with-len(1)
                pb[0]: {
                    ok -> it = 0

                    -> _
                }
                out = out - pb
            }
        }

        ; advance positions for next entry
        #{overflow=wrap}
        name-pos = nl + 1: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mode-pos = nl2 + 1: {
            ok -> it

            -> _
        }
    }

    ; SHA-1 trailer — hash the entire content built so far
    ; We use oid.sha1-hex to compute the hash, then append the 20 raw bytes
    trailer-hex = oid.sha1-hex(out)

    ; convert hex to 20 raw bytes
    k <- [0..20): {

        #{overflow=wrap}
        c0 byte = trailer-hex.byte(k * 2): {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        c1 byte = trailer-hex.byte(k * 2 + 1): {
            ok -> it

            -> 0
        }
        hi = util.hexdigit(c0)
        lo = util.hexdigit(c1)
        tb []byte = with-cap-len(1, 1)
        tb[0] = (hi << 4) | lo
        out = out - tb.slice(0, 1).to-bytes-str()
    }

    ; write byte-by-byte (stride-safe)
    ; X-4: propagate write failure to caller
    ok = util.write-file-simple(p, out)
}

; ═══════════════════════════════════════════════
; index add / remove
; ═══════════════════════════════════════════════

; sort-index-entries: sort the flat index arrays by base_name_compare.
; Uses selection sort: repeatedly pick the smallest unsorted entry and
; append it to the output. This avoids in-place array manipulation.
; names str: newline-separated file paths
; hexoids str: concatenated 40-char hex oids
; modes-str str: newline-separated mode strings
; count i64: number of entries
; returns: sorted-names, sorted-oids, sorted-modes
sort-index-entries = (names str, hexoids str, modes-str str, count i64) (sorted-names str, sorted-oids str, sorted-modes str) {
    sorted-names = ''
    sorted-oids = ''
    sorted-modes = ''

    ; Track which entries have been placed (by index).
    ; We use a string of '0'/'1' as a bitmap.
    placed str = with-len(count)
    i <- [0..count): {
        placed[i]: {
            ok -> it = 48; '0' = not placed

            -> _
        }
    }

    ; For each output position, find the smallest unsorted entry.
    out-i <- [0..count): {
        best-j i64 = -1

        ; Pre-extract all names and find the minimum unsorted one.
        ; We scan all entries, skipping those already placed.
        scan-j <- [0..count): {
            placed[scan-j] == 48 -> {

                ; extract name scan-j
                np i64 = 0
                k <- [0..scan-j): {
                    nl-k = find-newline-local(names, np)

                    #{overflow=wrap}
                    np = nl-k + 1: {
                        ok -> it

                        -> _
                    }
                }
                nj-end = find-newline-local(names, np)
                nj-name = util.str-range(names, np, nj-end)

                best-j < 0 -> {
                    best-j = scan-j
                }
                best-j >= 0 -> {

                    ; extract name best-j for comparison
                    bp i64 = 0
                    k <- [0..best-j): {
                        nl-b = find-newline-local(names, bp)

                        #{overflow=wrap}
                        bp = nl-b + 1: {
                            ok -> it

                            -> _
                        }
                    }
                    bj-end = find-newline-local(names, bp)
                    bj-name = util.str-range(names, bp, bj-end)

                    cmp = name-cmp-index(nj-name, bj-name)
                    cmp < 0 -> best-j = scan-j
                }
            }
        }

        ; Place best-j into output
        best-j >= 0 -> {

            ; extract name best-j
            np i64 = 0
            k <- [0..best-j): {
                nl-k = find-newline-local(names, np)

                #{overflow=wrap}
                np = nl-k + 1: {
                    ok -> it

                    -> _
                }
            }
            nj-end = find-newline-local(names, np)
            nj-name = util.str-range(names, np, nj-end)

            ; extract oid best-j
            nj-oid = hexoids[best-j * 40..best-j * 40 + 40)

            ; extract mode best-j
            mp i64 = 0
            k <- [0..best-j): {
                ml-k = find-newline-local(modes-str, mp)

                #{overflow=wrap}
                mp = ml-k + 1: {
                    ok -> it

                    -> _
                }
            }
            mj-end = find-newline-local(modes-str, mp)
            nj-mode = modes-str[mp..mj-end)

            sorted-names = sorted-names - nj-name - '\n'
            sorted-oids = sorted-oids - nj-oid

            sorted-modes = sorted-modes - nj-mode - '\n'
            placed[best-j]: {
                ok -> it = 49; '1' = placed

                -> _
            }
        }
    }
}

; name-cmp-index: simplified base_name_compare for index sorting.
; Compares two file names byte by byte. Both are regular files (not dirs)
; in the index context, so no directory '/' rule needed.
; Returns <0 if a < b, 0 if equal, >0 if a > b.
name-cmp-index = (a str, b str) (r i64) {
    la = a.len-bytes()
    lb = b.len-bytes()
    len = la
    lb < len -> len = lb
    r = 0
    i = 0
    (i < len) {
        i < len -> {
            ca = a[i]
            cb = b[i]
            ca < cb -> {
                r = -1
                return
            }
            ca > cb -> {
                r = 1
                return
            }

            #{overflow=wrap}
            i = i + 1: {
                ok -> it

                -> _
            }
        }
    }
    la < lb -> r = -1
    la > lb -> r = 1
}

; index-add: add a file to the index (blob already written to object store)
; git-dir str, path str (file path relative to work tree), o oid, mode i64
; returns ok bool
;
; Reads existing index, replaces or appends the entry, rewrites index.
index-add = (git-dir str, path str, o oid, mode i64) (ok bool) {
    ok = false

    ; read existing index (avoid multi-return assign to prevent string corruption)
    ri-names str
    ri-hexoids str
    ri-modes str
    ri-count i64
    ri-ok bool
    ri-names, ri-hexoids, ri-modes, ri-count, ri-ok = read-index(git-dir)
    ! ri-ok -> ri-count = 0

    ; build new arrays
    new-names = ''
    new-oids = ''
    new-modes = ''
    new-count = 0

    ; hex of new oid
    new-hex = oid.oid-hex-str(o)
    mode-str = util.i64-to-str(mode)
    found = false

    ; iterate existing entries, replacing if path matches
    pos = 0
    mode-pos = 0
    i <- [0..ri-count): {

        ; find end of name i
        nl = find-newline-local(ri-names, pos)
        nm = util.str-range(ri-names, pos, nl)

        ; find end of mode i
        mnl2 = find-newline-local(ri-modes, mode-pos)
        old-ms = ri-modes[mode-pos..mnl2)

        ; check if it matches path
        same = util.str-eq(nm, path)
        {
            same -> {

                ; replace with new entry
                new-names = new-names - path - '\n'
                new-oids = new-oids - new-hex

                new-modes = new-modes - mode-str - '\n'

                #{overflow=wrap}
                new-count = new-count + 1: {
                    ok -> it

                    -> _
                }
                found = true
            }

            -> {

                ; keep existing
                new-names = new-names - nm - '\n'
                old-hex = ri-hexoids[i * 40..i * 40 + 40)
                new-oids = new-oids - old-hex

                new-modes = new-modes - old-ms - '\n'

                #{overflow=wrap}
                new-count = new-count + 1: {
                    ok -> it

                    -> _
                }
            }
        }

        ; advance positions
        #{overflow=wrap}
        pos = nl + 1: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mode-pos = mnl2 + 1: {
            ok -> it

            -> _
        }
        nl >= ri-names.len() -> break
    }

    ; if path was not found, append new entry
    {
        ! found -> {
            new-names = new-names - path - '\n'
            new-oids = new-oids - new-hex

            new-modes = new-modes - mode-str - '\n'

            #{overflow=wrap}
            new-count = new-count + 1: {
                ok -> it

                -> _
            }
        }
    }

    ; sort entries before writing (Git requires base_name_compare order)
    sorted-names str
    sorted-oids str
    sorted-modes str
    sorted-names, sorted-oids, sorted-modes = sort-index-entries(new-names, new-oids, new-modes, new-count)

    ; rewrite index
    write-ok = write-index(git-dir, sorted-names, sorted-oids, sorted-modes, new-count)
    ok = write-ok
}

; index-remove: remove a file from the index
; git-dir str, path str
; returns ok bool
index-remove = (git-dir str, path str) (ok bool) {
    ok = false

    ; read existing index (avoid multi-return assign to prevent string corruption)
    ri-names str
    ri-hexoids str
    ri-modes str
    ri-count i64
    ri-ok bool
    ri-names, ri-hexoids, ri-modes, ri-count, ri-ok = read-index(git-dir)
    ! ri-ok -> return
    new-names = ''
    new-oids = ''
    new-modes = ''
    new-count = 0
    pos = 0
    mode-pos = 0
    i <- [0..ri-count): {

        ; find end of name i
        nl = find-newline-local(ri-names, pos)
        nm = util.str-range(ri-names, pos, nl)

        ; find end of mode i
        mnl2 = find-newline-local(ri-modes, mode-pos)
        old-ms = ri-modes[mode-pos..mnl2)
        same = util.str-eq(nm, path)
        {
            same ->

            -> {
                new-names = new-names - nm - '\n'
                old-hex = ri-hexoids[i * 40..i * 40 + 40)
                new-oids = new-oids - old-hex

                new-modes = new-modes - old-ms - '\n'

                #{overflow=wrap}
                new-count = new-count + 1: {
                    ok -> it

                    -> _
                }
            }
        }

        ; advance positions
        #{overflow=wrap}
        pos = nl + 1: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        mode-pos = mnl2 + 1: {
            ok -> it

            -> _
        }
        nl >= ri-names.len() -> break
    }

    ; sort entries before writing (Git requires base_name_compare order)
    sorted-names str
    sorted-oids str
    sorted-modes str
    sorted-names, sorted-oids, sorted-modes = sort-index-entries(new-names, new-oids, new-modes, new-count)
    write-ok = write-index(git-dir, sorted-names, sorted-oids, sorted-modes, new-count)
    ok = write-ok
}
