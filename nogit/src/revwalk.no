; revwalk — Git revision walking / commit graph traversal
;
; Provides commit history traversal for `git log`, ancestry queries, etc.
; Supports:
;   * Basic linear walk (follow first parent or all parents)
;   * Commit lookup by oid
;   * Ancestor checking
;
; Cross-module safety: returns individual scalars/strings/oids.
; Resolve ref, walk commits, format log output.

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/object
# /nogit/src/refs
# /nogit/src/pack

; ═══════════════════════════════════════════════
; local helpers
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; unified object read (loose + packed)
; ═══════════════════════════════════════════════

; read-object: try loose first, then packed. Returns kind, data, ok.
read-object = (git-dir str, o oid) (kind str, data str, ok bool) {
    kind, data, ok = object.read-loose(git-dir, o)
    ! ok -> {
        kind, data, ok = pack.read-packed-object(git-dir, o)
    }
}

; ═══════════════════════════════════════════════
; commit lookup
; ═══════════════════════════════════════════════

; resolve-ref: resolve a ref name or hex oid to an oid
; Supports: HEAD, main, refs/heads/main, 40-char hex, HEAD~N, HEAD^N, ref~N, ref^N
; git-dir str, ref str (e.g. "HEAD", "main", "refs/heads/main", or 40-char hex)
; returns o ?oid
resolve-ref = (git-dir str, ref str) (o ?oid) {

    ; check for ~N or ^N suffix
    tilde-pos = util.find-byte-str(ref, 126, 0)
    caret-pos = util.find-byte-str(ref, 94, 0)
    split-pos = -1
    tilde-pos >= 0 -> split-pos = tilde-pos
    caret-pos > tilde-pos -> split-pos = caret-pos

    ; if there's a ~ or ^ suffix, resolve the base ref and walk back N steps
    split-pos > 0 -> {
        base-ref = util.str-range(ref, 0, split-pos)

        #{overflow=wrap}
        suffix = util.str-range(ref, split-pos + 1, ref.len-bytes())
        base-oid-opt = resolve-ref(git-dir, base-ref)
        base-oid oid
        base-ok bool = false
        base-oid-opt: {
            ok -> {
                base-oid = base-oid-opt
                base-ok = true
            }

            nil || err -> {
            }
        }
        ! base-ok -> return

        ; parse N (default 1)
        n i64 = 1
        suffix.len() > 0 -> {
            n = 0
            si <- [0..suffix.len()): {

                #{overflow=wrap}
                n = n * 10 + (suffix[si] - 48)
            }
            n == 0 -> n = 1
        }

        ; walk first-parent N steps
        cur = base-oid
        step <- [0..n): {
            ph str
            np i64
            ph, np, walk-ok = commit-parents(git-dir, cur)
            ! walk-ok -> return
            ph.len() >= 40 -> {
                first-hex = util.str-range(ph, 0, 40)
                cur-opt = oid.oid-from-hex(first-hex)
                cur-opt: {
                    ok -> {
                        cur = cur-opt
                        walk-ok = true
                    }

                    nil || err -> {
                        walk-ok = false
                    }
                }
                ! walk-ok -> return
            }

            -> {
                return
            }
        }
        o = cur
        return
    }

    ; try HEAD first (most common short name)
    {
        ref == 'HEAD' -> {
            o = refs.read-ref(git-dir, 'HEAD')
            o: {
                ok -> return

                nil || err -> {
                }
            }
        }
    }

    ; try as full ref name (refs/heads/..., refs/tags/...)
    o = refs.read-ref(git-dir, ref)
    o: {
        ok -> return

        nil || err -> {
        }
    }

    ; try as refs/heads/<ref>
    o = refs.read-ref(git-dir, 'refs/heads/' - ref)
    o: {
        ok -> return

        nil || err -> {
        }
    }

    ; try as refs/tags/<ref>
    o = refs.read-ref(git-dir, 'refs/tags/' - ref)
    tags-ok = false
    o: {
        ok -> tags-ok = true

        nil || err -> {
        }
    }
    {
        tags-ok -> return

        ref.len-bytes() == 40 -> {

            ; try as 40-char hex oid (must be exactly 40 chars)

            o = oid.oid-from-hex(ref)
        }
    }
}

; ═══════════════════════════════════════════════
; commit info helpers
; ═══════════════════════════════════════════════

; commit-tree-oid: read a commit and return its tree oid
; git-dir str, commit-oid oid
; returns tree-oid ?oid
commit-tree-oid = (git-dir str, commit-oid oid) (tree-oid ?oid) {
    k str
    d str
    read-ok bool
    k, d, read-ok = read-object(git-dir, commit-oid)
    {
        ! read-ok -> return

        ; parse "tree <hex>\n" — "tree " is 5 bytes, then 40-char hex
        d.len() < 46 -> return
    }

    ; extract the 40-char hex after "tree "
    hx = util.str-range(d, 5, 45)
    tree-oid = oid.oid-from-hex(hx)
}

; commit-parents: read a commit and return its parent oids
; git-dir str, commit-oid oid
; returns parent-hex str (concatenated 40-char hex), nparents i64, ok bool
commit-parents = (git-dir str, commit-oid oid) (parent-hex str, nparents i64, ok bool) {
    ok = false
    k str
    data str
    read-ok bool
    k, data, read-ok = read-object(git-dir, commit-oid)
    ! read-ok -> return
    parent-hex = ''
    nparents = 0
    pos = 0
    !! {
        pos >= data.len() -> break
        nl = util.find-byte-str(data, 10, pos)
        end = data.len()
        nl >= 0 -> end = nl
        line = util.str-range(data, pos, end)
        line.starts-with('parent ') -> {
            hx = util.str-range(line, 7, line.len())
            parent-hex = parent-hex - hx

            #{overflow=wrap}
            nparents = nparents + 1
        }

        ; stop at blank line (message starts)
        line.len() == 0 -> break

        ; stop at author/committer lines
        line.starts-with('author ') -> break
        line.starts-with('committer ') -> break

        #{overflow=wrap}
        pos = nl + 1
        nl < 0 -> break
    }
    ok = true
}

; commit-info-full: read a commit and return all fields
; git-dir str, commit-oid oid
; returns tree-oid oid, parent-hex str, nparents i64,
;   a-name str, a-email str, a-time i64, a-tz str,
;   c-name str, c-email str, c-time i64, c-tz str, message str, ok bool
commit-info-full = (git-dir str, commit-oid oid) (tree-oid oid, parent-hex str, nparents i64, a-name str, a-email str, a-time i64, a-tz str, c-name str, c-email str, c-time i64, c-tz str, message str, ok bool) {
    tree-oid, parent-hex, a-name, a-email, a-time, a-tz, c-name, c-email, c-time, c-tz, message, ok = object.read-commit-full(git-dir, commit-oid)

    #{overflow=wrap}
    nparents = parent-hex.len() / 40
}

; ═══════════════════════════════════════════════
; revision walk
; ═══════════════════════════════════════════════

; revwalk-first-parent: walk commit history following first parent
; git-dir str, start-oid oid, max-count i64 (0 = unlimited)
; returns commit-hex str (newline-separated 40-char hex), count i64, ok bool
revwalk-first-parent = (git-dir str, start-oid oid, max-count i64) (commit-hex str, count i64, ok bool) {
    ok = false
    commit-hex = ''
    count = 0
    cur = start-oid
    !! {
        count >= 10000 -> break
        max-count > 0 -> {
            count >= max-count -> break
        }
        t, ph, an, ae, at, az, cn, ce, ct, cz, msg, cok = object.read-commit-full(git-dir, cur)
        ! cok -> break
        ch = oid.oid-hex-str(cur)

        commit-hex = commit-hex - ch - '\n'

        #{overflow=wrap}
        count = count + 1

        #{overflow=wrap}
        np i64 = ph.len() / 40
        np == 0 -> break
        {
            ph.len() >= 40 -> {
                first-parent-hex = util.str-range(ph, 0, 40)
                cur-opt = oid.oid-from-hex(first-parent-hex)
                cur oid
                cok bool = false
                cur-opt: {
                    ok -> {
                        cur = cur-opt
                        cok = true
                    }

                    nil || err -> {
                    }
                }
                ! cok -> break
            }

            -> {
                break
            }
        }
    }
    ok = true
}

; revwalk-format-log: resolve ref, walk commits, format log output
; git-dir str, ref str (e.g. "HEAD"), max-count i64 (0 = unlimited)
; returns output ?str (formatted log; nil on failure)
;
; Walks all parents (not just first-parent) using BFS with a simple
; queue. This ensures merge commits have all their branches visible.
; Visited commits are tracked by concatenated hex strings.
revwalk-format-log = (git-dir str, ref str, max-count i64) (output ?str) {
    out = ''
    start-oid-opt = resolve-ref(git-dir, ref)
    start-oid oid
    ref-ok = false
    start-oid-opt: {
        ok -> {
            start-oid = start-oid-opt
            ref-ok = true
        }

        nil || err -> {
        }
    }
    ! ref-ok -> return

    ; BFS queue — stored as concatenated 40-char hex strings
    queue-hex = oid.oid-hex-str(start-oid)
    queue-n = 1

    ; visited set — concatenated 40-char hex strings
    visited-hex = ''
    count = 0

    !! {
        queue-n == 0 -> break
        count >= 10000 -> break
        max-count > 0 -> {
            count >= max-count -> break
        }

        ; dequeue first element
        cur-hex = util.str-range(queue-hex, 0, 40)
        queue-hex = util.str-range(queue-hex, 40, queue-hex.len())

        #{overflow=wrap}
        queue-n = queue-n - 1

        ; check if already visited
        is-visited = false
        vpos = 0
        !! {
            vpos >= visited-hex.len-bytes() -> break

            #{overflow=wrap}
            vh = util.str-range(visited-hex, vpos, vpos + 40)
            same = util.str-eq(vh, cur-hex)
            same -> {
                is-visited = true
                break
            }

            #{overflow=wrap}
            vpos = vpos + 40
        }

        ! is-visited -> {

            ; mark as visited
            visited-hex = visited-hex - cur-hex

            ; parse oid
            cur-opt = oid.oid-from-hex(cur-hex)
            cur oid
            cur-ok bool = false
            cur-opt: {
                ok -> {
                    cur = cur-opt
                    cur-ok = true
                }

                nil || err -> {
                }
            }
            cur-ok -> {

                ; read commit
                t, ph, an, ae, at, az, cn, ce, ct, cz, msg, cok = object.read-commit-full(git-dir, cur)
                cok -> {

                    out = out - 'commit ' - cur-hex - '\n'

                    out = out - 'Author: ' - an - ' <' - ae - '>\n'

                    out = out - 'Date:   ' - util.i64-to-str(at) - ' ' - az - '\n'
                    out = out - '\n'

                    out = out - '    ' - msg - '\n'
                    out = out - '\n'

                    #{overflow=wrap}
                    count = count + 1

                    ; enqueue all parents (not just first-parent)
                    #{overflow=wrap}
                    np i64 = ph.len() / 40
                    i <- [0..np): {

                        #{overflow=wrap}
                        parent-hex = util.str-range(ph, i * 40, i * 40 + 40)

                        #{overflow=wrap}
                        queue-hex = queue-hex - parent-hex

                        #{overflow=wrap}
                        queue-n = queue-n + 1
                    }
                }
            }
        }
    }
    output = out
}

; revwalk-format-log-oneline: resolve ref, walk commits, format oneline log output
; git-dir str, ref str (e.g. "HEAD"), max-count i64 (0 = unlimited)
; returns output ?str (formatted oneline log; nil on failure)
;
; Like revwalk-format-log but uses the --oneline format:
;   "<short-hash> <message-first-line>"
; Walks all parents using BFS with visited set.
revwalk-format-log-oneline = (git-dir str, ref str, max-count i64) (output ?str) {
    out = ''
    start-oid-opt = resolve-ref(git-dir, ref)
    start-oid oid
    ref-ok = false
    start-oid-opt: {
        ok -> {
            start-oid = start-oid-opt
            ref-ok = true
        }

        nil || err -> {
        }
    }
    ! ref-ok -> return

    ; BFS queue — stored as concatenated 40-char hex strings
    queue-hex = oid.oid-hex-str(start-oid)
    queue-n = 1

    ; visited set — concatenated 40-char hex strings
    visited-hex = ''
    count = 0

    !! {
        queue-n == 0 -> break
        count >= 10000 -> break
        max-count > 0 -> {
            count >= max-count -> break
        }

        ; dequeue first element
        cur-hex = util.str-range(queue-hex, 0, 40)
        queue-hex = util.str-range(queue-hex, 40, queue-hex.len())

        #{overflow=wrap}
        queue-n = queue-n - 1

        ; check if already visited
        is-visited = false
        vpos = 0
        !! {
            vpos >= visited-hex.len-bytes() -> break

            #{overflow=wrap}
            vh = util.str-range(visited-hex, vpos, vpos + 40)
            same = util.str-eq(vh, cur-hex)
            same -> {
                is-visited = true
                break
            }

            #{overflow=wrap}
            vpos = vpos + 40
        }

        ! is-visited -> {

            ; mark as visited
            visited-hex = visited-hex - cur-hex

            ; parse oid
            cur-opt = oid.oid-from-hex(cur-hex)
            cur oid
            cur-ok bool = false
            cur-opt: {
                ok -> {
                    cur = cur-opt
                    cur-ok = true
                }

                nil || err -> {
                }
            }
            cur-ok -> {

                ; read commit
                t, ph, an, ae, at, az, cn, ce, ct, cz, msg, cok = object.read-commit-full(git-dir, cur)
                cok -> {

                    ; short hash = first 7 chars
                    short-hex = util.str-range(cur-hex, 0, 7)

                    ; first line of message
                    msg-nl = util.find-byte-str(msg, 10, 0)
                    msg-end = msg.len()
                    msg-nl >= 0 -> msg-end = msg-nl
                    msg-line = util.str-range(msg, 0, msg-end)

                    out = out - short-hex - ' ' - msg-line - '\n'

                    #{overflow=wrap}
                    count = count + 1

                    ; enqueue all parents
                    #{overflow=wrap}
                    np i64 = ph.len() / 40
                    i <- [0..np): {

                        #{overflow=wrap}
                        parent-hex = util.str-range(ph, i * 40, i * 40 + 40)

                        #{overflow=wrap}
                        queue-hex = queue-hex - parent-hex

                        #{overflow=wrap}
                        queue-n = queue-n + 1
                    }
                }
            }
        }
    }
    output = out
}

; revwalk-all: walk commit history following all parents (breadth-first)
; This is a simplified version — it doesn't handle merge ordering correctly.
; git-dir str, start-oid oid, max-count i64 (0 = unlimited)
; returns commit-hex str (newline-separated), count i64, ok bool
revwalk-all = (git-dir str, start-oid oid, max-count i64) (commit-hex str, count i64, ok bool) {
    ok = false
    commit-hex = ''
    count = 0

    ; simple queue: we store visited oids as concatenated hex
    visited-hex = ''
    queue-hex = oid.oid-hex-str(start-oid)
    queue-n = 1
    !! {
        queue-n == 0 -> break
        max-count > 0 -> {
            count >= max-count -> break
        }

        ; dequeue first
        cur-hex = util.str-range(queue-hex, 0, 40)
        queue-hex = util.str-range(queue-hex, 40, queue-hex.len())

        #{overflow=wrap}
        queue-n = queue-n - 1

        ; parse oid
        cur-opt = oid.oid-from-hex(cur-hex)
        cur oid
        cur-ok bool = false
        cur-opt: {
            ok -> {
                cur = cur-opt
                cur-ok = true
            }

            nil || err -> {
            }
        }
        ! cur-ok -> break

        ; check if already visited
        is-visited = false
        vpos = 0
        !! {
            vpos >= visited-hex.len-bytes() -> break

            #{overflow=wrap}
            vh = util.str-range(visited-hex, vpos, vpos + 40)
            same = util.str-eq(vh, cur-hex)
            same -> {
                is-visited = true
                break
            }

            #{overflow=wrap}
            vpos = vpos + 40
        }
        {
            is-visited ->

            -> {

                ; mark as visited
                visited-hex = visited-hex - cur-hex

                ; read commit
                t, ph, an, ae, at, az, cn, ce, ct, cz, msg, cok = object.read-commit-full(git-dir, cur)
                cok -> {

                    commit-hex = commit-hex - cur-hex - '\n'

                    #{overflow=wrap}
                    count = count + 1

                    ; enqueue parents
                    #{overflow=wrap}
                    np i64 = ph.len() / 40
                    i <- [0..np): {

                        #{overflow=wrap}
                        parent-hex = util.str-range(ph, i * 40, i * 40 + 40)

                        #{overflow=wrap}
                        queue-hex = queue-hex - parent-hex

                        #{overflow=wrap}
                        queue-n = queue-n + 1
                    }
                }
            }
        }
    }
    ok = true
}

; ═══════════════════════════════════════════════
; ancestry
; ═══════════════════════════════════════════════

; is-ancestor: check if ancestor-oid is an ancestor of descendant-oid
; git-dir str, ancestor oid, descendant oid
; returns yes bool
is-ancestor = (git-dir str, ancestor oid, descendant oid) (yes bool) {
    yes = false

    ; walk all parents of descendant, check if ancestor is among them
    visited-hex = ''
    queue-hex = oid.oid-hex-str(descendant)
    queue-n = 1
    ancestor-hex = oid.oid-hex-str(ancestor)
    !! {
        queue-n == 0 -> break
        cur-hex = util.str-range(queue-hex, 0, 40)
        queue-hex = util.str-range(queue-hex, 40, queue-hex.len())

        #{overflow=wrap}
        queue-n = queue-n - 1

        ; check if this is the ancestor
        same = util.str-eq(cur-hex, ancestor-hex)
        same -> {
            yes = true
            break
        }

        ; check visited
        is-visited = false
        vpos = 0
        !! {
            vpos >= visited-hex.len-bytes() -> break

            #{overflow=wrap}
            vh = util.str-range(visited-hex, vpos, vpos + 40)
            vsame = util.str-eq(vh, cur-hex)
            vsame -> {
                is-visited = true
                break
            }

            #{overflow=wrap}
            vpos = vpos + 40
        }
        {
            is-visited ->

            -> {
                visited-hex = visited-hex - cur-hex
                cur-opt = oid.oid-from-hex(cur-hex)
                cur oid
                cur-ok bool = false
                cur-opt: {
                    ok -> {
                        cur = cur-opt
                        cur-ok = true
                    }

                    nil || err -> {
                    }
                }
                cur-ok -> {
                    t, ph, an, ae, at, az, cn, ce, ct, cz, msg, cok = object.read-commit-full(git-dir, cur)
                    cok -> {

                        #{overflow=wrap}
                        np i64 = ph.len() / 40
                        i <- [0..np): {

                            #{overflow=wrap}
                            parent-hex = util.str-range(ph, i * 40, i * 40 + 40)

                            #{overflow=wrap}
                            queue-hex = queue-hex - parent-hex

                            #{overflow=wrap}
                            queue-n = queue-n + 1
                        }
                    }
                }
            }
        }
    }
}
