; refs — Git reference management: HEAD, branches, tags, packed-refs
;
; Supports:
;   * Loose refs: refs/heads/*, refs/tags/*, refs/remotes/*
;   * Symbolic refs: HEAD -> "ref: refs/heads/main"
;   * Packed-refs: .git/packed-refs (compact storage)
;   * Reflog: .git/logs/HEAD, .git/logs/refs/heads/<name>
;
; Cross-module safety: all return values are individual scalars/strings/oids.
; Return strings are built by concatenation.

# /nogit/src/util
# /nogit/src/oid

; ═══════════════════════════════════════════════
; local helpers (intra-module safe)
; ═══════════════════════════════════════════════

; valid-ref-name: reject names that could escape the git directory or that
; violate git's check-ref-format rules. Every function that builds a path from
; a caller-supplied ref name MUST call this first (G-1 path traversal).
; Rejects: empty, leading '/', leading '-', leading '.', control chars,
; backslash, '//', '..', '.' path segments, trailing '/' and trailing '.'.
valid-ref-name = (name str) (valid bool) {
    valid = false
    n = name.len-bytes()
    n > 0 -> {
        ; leading slash / dash / dot
        first = name.byte(0)
        first: {
            ok -> {
                it == 47 -> return
                it == 45 -> return
                it == 46 -> return
            }

            -> return
        }

        ok-scan = true
        prev byte = 0
        seg-first byte = 0
        seg-len = 0
        i <- [0..n): {
            cbv = name.byte(i)
            c byte = 0
            cbv: {
                ok -> c = it

                -> _
            }

            ; control chars (<0x20, 0x7f) and backslash are never valid
            c < 32 -> ok-scan = false
            c == 127 -> ok-scan = false
            c == 92 -> ok-scan = false

            ; consecutive separators and consecutive dots are never valid
            prev == 47 && c == 47 -> ok-scan = false
            prev == 46 && c == 46 -> ok-scan = false

            {
                c == 47 -> {
                    ; closing a segment: a lone '.' segment is invalid
                    seg-len == 1 && seg-first == 46 -> ok-scan = false
                    seg-len = 0
                }

                -> {
                    seg-len == 0 -> seg-first = c

                    #{overflow=wrap}
                    seg-len = seg-len + 1: {
                        ok -> it

                        -> _
                    }
                }
            }
            prev = c
        }

        ; final segment checks: lone '.', trailing '/' and trailing '.'
        seg-len == 1 && seg-first == 46 -> ok-scan = false
        prev == 47 -> ok-scan = false
        prev == 46 -> ok-scan = false
        ok-scan -> valid = true
    }
}

; ═══════════════════════════════════════════════
; loose ref read / write
; ═══════════════════════════════════════════════

; read-loose-ref: read a loose ref file
; git-dir str, name str (e.g. "refs/heads/main")
; returns content ?str (nil if ref file absent or unreadable)
read-loose-ref = (git-dir str, name str) (content ?str) {
    content = nil
    sl = '/'
    p = git-dir - sl - name
    co-opt = util.read-file-str(p)
    co-opt: {
        ok -> content = it

        nil -> {
        }

        err -> {
        }
    }
}

; read-ref: read a reference (symbolic, loose, or packed)
; git-dir str, name str (e.g. "HEAD", "refs/heads/main")
; returns o ?oid
;
; Resolution order:
;   1. If the ref content starts with "ref:", follow the symbolic ref recursively
;   2. Otherwise, parse as 40-char hex oid
;   3. If the loose ref is absent, check packed-refs
read-ref = (git-dir str, name str) (o ?oid) {
    o = read-ref-depth(git-dir, name, 0)
}

; read-ref-depth: internal, depth-limited implementation of read-ref.
; Git caps symbolic ref chains at 5 levels. Without the limit a cyclic
; A -> B -> A ref pair recurses forever and overflows the stack (G-3).
read-ref-depth = (git-dir str, name str, depth i64) (o ?oid) {
    depth > 5 -> return
    ! valid-ref-name(name) -> return

    ; try loose ref first
    content str
    content-have = false
    content-opt = read-loose-ref(git-dir, name)
    content-opt: {
        ok -> {
            content = it
            content-have = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        content-have -> {
            content = util.trim-newline(content)

            ; check if symbolic: "ref: <target>"
            content.starts-with('ref: ') -> {
                target = util.str-range(content, 5, content.len())
                target = util.trim-newline(target)
                ! valid-ref-name(target) -> return

                #{overflow=wrap}
                next-depth = depth + 1: {
                    ok -> it

                    -> _
                }
                o = read-ref-depth(git-dir, target, next-depth)
                return
            }

            ; parse as hex oid
            content.len() >= 40 -> {
                hx = util.str-range(content, 0, 40)
                o = oid.oid-from-hex(hx)
                return
            }
        }
    }

    ; try packed-refs
    o = read-packed-ref(git-dir, name)
}

; read-symbolic-ref: read a symbolic ref (e.g. HEAD) and return the target name
; git-dir str, name str (e.g. "HEAD")
; returns target ?str (nil if absent or not a symbolic ref)
read-symbolic-ref = (git-dir str, name str) (target ?str) {
    target = nil
    content str
    found = false
    content-opt = read-loose-ref(git-dir, name)
    content-opt: {
        ok -> {
            content = it
            found = true
        }

        nil -> {
        }

        err -> {
        }
    }
    found -> {
        content = util.trim-newline(content)
        content.starts-with('ref: ') -> {
            target = util.str-range(content, 5, content.len())
            target = util.trim-newline(target)
        }
    }
}

; write-ref: write a loose ref (oid value)
; git-dir str, name str (e.g. "refs/heads/main"), o oid
write-ref = (git-dir str, name str, o oid) (ok bool) {
    ok = false
    ! valid-ref-name(name) -> {
        print('error: invalid ref name')
        return
    }
    sl = '/'
    p = git-dir - sl - name

    ; ensure parent dir exists (recursive, like mkdir -p)
    idx = p.rindex('/')
    {
        idx >= 0 -> {
            parent = util.str-range(p, 0, idx)
            {
                fs.is-dir(parent) ->

                -> {
                    util.mkdir-all(parent)
                }
            }
        }
    }
    hx = oid.oid-hex-str(o)

    content = hx - '\n'
    ; X-4: propagate write failure (disk full / permissions) to caller
    ok = util.write-file-simple(p, content)
}

; write-symbolic-ref: write a symbolic ref (e.g. HEAD -> refs/heads/main)
; git-dir str, name str (e.g. "HEAD"), target str (e.g. "refs/heads/main")
write-symbolic-ref = (git-dir str, name str, target str) (ok bool) {
    ok = false
    ! valid-ref-name(name) -> {
        print('error: invalid ref name')
        return
    }
    ! valid-ref-name(target) -> {
        print('error: invalid symbolic ref target')
        return
    }
    sl = '/'
    p = git-dir - sl - name

    content = 'ref: ' - target - '\n'
    ; X-4: propagate write failure (disk full / permissions) to caller
    ok = util.write-file-simple(p, content)
}

; update-head: set HEAD to point to a branch (symbolic)
; git-dir str, branch str (e.g. "refs/heads/main")
update-head = (git-dir str, branch str) (ok bool) {
    ok = write-symbolic-ref(git-dir, 'HEAD', branch)
}

; set-head-detached: set HEAD to a specific oid (detached HEAD)
; git-dir str, o oid
set-head-detached = (git-dir str, o oid) (ok bool) {
    p = git-dir - '/HEAD'
    hx = oid.oid-hex-str(o)

    content = hx - '\n'
    ; X-4: propagate write failure (disk full / permissions) to caller
    ok = util.write-file-simple(p, content)
}

; current-branch: read HEAD and return the branch name it points to
; git-dir str
; returns branch str, detached bool, ok bool
;   detached=true means HEAD is at a specific oid (not on a branch)
;   detached=false means HEAD -> refs/heads/<branch>
current-branch = (git-dir str) (branch str, detached bool, ok bool) {
    ok = false
    target str
    target-opt = read-symbolic-ref(git-dir, 'HEAD')
    target-opt: {
        ok -> {
            target = it
            target.starts-with('refs/heads/') -> {
                branch = util.str-range(target, 11, target.len())
                detached = false
                ok = true
                return
            }
        }

        nil -> {
        }

        err -> {
        }
    }

    ; detached HEAD
    o oid
    ref-ok = false
    o-opt = read-ref(git-dir, 'HEAD')
    o-opt: {
        ok -> {
            o = o-opt
            ref-ok = true
        }

        nil || err -> {
        }
    }
    {
        ref-ok -> {
            branch = ''
            detached = true
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; branch management
; ═══════════════════════════════════════════════

; create-branch: create a new branch ref pointing to an oid
; git-dir str, name str, o oid
; returns ok bool (false if already exists)
create-branch = (git-dir str, name str, o oid) (ok bool) {
    ! valid-ref-name(name) -> {
        print('error: invalid branch name')
        return
    }
    ref-name = 'refs/heads/' - name
    sl = '/'

    p = git-dir - sl - ref-name

    ; check if already exists
    exists = fs.is-file(p)
    {
        exists -> return
    }
    ok = write-ref(git-dir, ref-name, o)
}

; delete-branch: delete a branch ref
; git-dir str, name str
; returns ok bool
delete-branch = (git-dir str, name str) (ok bool) {
    ! valid-ref-name(name) -> {
        print('error: invalid branch name')
        return
    }
    ref-name = 'refs/heads/' - name
    sl = '/'

    p = git-dir - sl - ref-name
    ok = fs.remove(p)
}

; list-branches: list all branch names (loose refs only)
; git-dir str
; returns names str (newline-separated), count i64
list-branches = (git-dir str) (names str, count i64) {
    names = ''
    count = 0
    heads-dir = git-dir - '/refs/heads'
    isd = fs.is-dir(heads-dir)
    {
        ! isd -> return
    }
    dirp = fs.open-dir(heads-dir)
    {
        dirp == 0 -> return
    }
    br-entry str
    br-ok = true
    !! {
        ! br-ok -> break
        br-entry-opt = fs.read-dir(dirp)
        br-entry = ''
        br-ok = false
        br-entry-opt: {
            ok -> {
                br-entry = it
                br-ok = true
            }

            -> {
            }
        }
        {
            br-ok -> {

                ; skip . and .. entries
                is-dot = util.str-eq(br-entry, '.')
                is-dotdot = util.str-eq(br-entry, '..')
                ! is-dot && ! is-dotdot -> {
                    br-entry.len() > 0 -> {
                        names = names - br-entry - '\n'

                        #{overflow=wrap}
                        count = count + 1: {
                            ok -> it

                            -> _
                        }
                    }
                }
            }
        }
    }
    fs.close-dir(dirp)
}

; ═══════════════════════════════════════════════
; tag management
; ═══════════════════════════════════════════════

; create-tag: create a lightweight tag ref
; git-dir str, name str, o oid
; returns ok bool (false if already exists)
create-tag = (git-dir str, name str, o oid) (ok bool) {
    ! valid-ref-name(name) -> {
        print('error: invalid tag name')
        return
    }
    ref-name = 'refs/tags/' - name
    sl = '/'

    p = git-dir - sl - ref-name
    exists = fs.is-file(p)
    {
        exists -> return
    }
    ok = write-ref(git-dir, ref-name, o)
}

; delete-tag: delete a tag ref
; git-dir str, name str
; returns ok bool
delete-tag = (git-dir str, name str) (ok bool) {
    ! valid-ref-name(name) -> {
        print('error: invalid tag name')
        return
    }
    ref-name = 'refs/tags/' - name
    sl = '/'

    p = git-dir - sl - ref-name
    ok = fs.remove(p)
}

; list-tags: list all tag names (loose refs only)
; git-dir str
; returns names str (newline-separated), count i64
list-tags = (git-dir str) (names str, count i64) {
    names = ''
    count = 0
    tags-dir = git-dir - '/refs/tags'
    isd = fs.is-dir(tags-dir)
    {
        ! isd -> return
    }
    dirp = fs.open-dir(tags-dir)
    {
        dirp == 0 -> return
    }
    tg-entry str
    tg-ok = true
    !! {
        ! tg-ok -> break
        tg-entry-opt = fs.read-dir(dirp)
        tg-entry = ''
        tg-ok = false
        tg-entry-opt: {
            ok -> {
                tg-entry = it
                tg-ok = true
            }

            -> {
            }
        }
        {
            tg-ok -> {

                ; skip . and .. entries
                is-dot = util.str-eq(tg-entry, '.')
                is-dotdot = util.str-eq(tg-entry, '..')
                ! is-dot && ! is-dotdot -> {
                    tg-entry.len() > 0 -> {
                        names = names - tg-entry - '\n'

                        #{overflow=wrap}
                        count = count + 1: {
                            ok -> it

                            -> _
                        }
                    }
                }
            }
        }
    }
    fs.close-dir(dirp)
}

; ═══════════════════════════════════════════════
; packed-refs support
; ═══════════════════════════════════════════════

; read-packed-refs: read .git/packed-refs file
; git-dir str
; returns content ?str (nil if unreadable)
read-packed-refs-file = (git-dir str) (content ?str) {
    p = git-dir - '/packed-refs'
    content = util.read-file-str(p)
}

; read-packed-ref: look up a specific ref in packed-refs
; git-dir str, name str
; returns o ?oid
read-packed-ref = (git-dir str, name str) (o ?oid) {
    content str
    content-opt = read-packed-refs-file(git-dir)
    content-opt: {
        ok -> content = it

        nil -> {
            return
        }

        err -> {
            return
        }
    }

    ; scan lines: "<40-hex> <refname>"
    pos = 0
    !! {
        pos >= content.len() -> break
        nl = util.find-byte-str(content, 10, pos)
        end = content.len()
        nl >= 0 -> end = nl
        line = util.str-range(content, pos, end)

        ; skip comment lines (start with #)
        {
            line.starts-with('#') ->

            -> {

                ; skip peeled lines (^...)
                {
                    line.starts-with('^') ->

                    -> {

                        ; line format: "<hex> <refname>"
                        sp = util.find-byte-str(line, 32, 0)
                        sp >= 0 -> {
                            hx = util.str-range(line, 0, sp)

                            #{overflow=wrap}
                            refname = util.str-range(line, sp + 1, line.len())
                            refname = util.trim-newline(refname)

                            ; compare refname with name
                            same = util.str-eq(refname, name)
                            same -> {
                                hx.len() >= 40 -> {
                                    o = oid.oid-from-hex(util.str-range(hx, 0, 40))
                                    o-have bool = false
                                    o: {
                                        ok -> o-have = true

                                        nil || err -> {
                                        }
                                    }
                                    o-have -> break
                                }
                            }
                        }
                    }
                }
            }
        }

        #{overflow=wrap}
        pos = nl + 1
        nl < 0 -> break
    }
}

; ═══════════════════════════════════════════════
; reflog support
; ═══════════════════════════════════════════════

; write-reflog: append a reflog entry to .git/logs/<refname>
; git-dir str, refname str (e.g. "HEAD" or "refs/heads/main"),
; old-oid oid, new-oid oid, committer-name str, committer-email str,
; time i64, tz str, message str
; returns ok bool
write-reflog = (git-dir str, refname str, old-oid oid, new-oid oid, name str, email str, time i64, tz str, message str) (ok bool) {
    ok = false
    ! valid-ref-name(refname) -> {
        print('error: invalid reflog ref name')
        return
    }
    log-path = git-dir - '/logs/' - refname

    ; ensure parent dir exists (recursive)
    idx = log-path.rindex('/')
    {
        idx >= 0 -> {
            parent = util.str-range(log-path, 0, idx)
            {
                fs.is-dir(parent) ->

                -> {
                    util.mkdir-all(parent)
                }
            }
        }
    }

    ; build entry: "<old-hex> <new-hex> <name> <<email>> <time> <tz>\t<message>\n"
    old-hex = oid.oid-hex-str(old-oid)
    new-hex = oid.oid-hex-str(new-oid)
    ts = util.i64-to-str(time)
    tab = '\t'
    nl = '\n'

    log-entry = old-hex - ' ' - new-hex - ' ' - name - ' <' - email - '> ' - ts - ' ' - tz - tab - message - nl

    ; append to file (read existing, append, write back)
    existing = ''
    existing-opt = util.read-file-str(log-path)
    existing-opt: {
        ok -> existing = it

        nil -> {
        }

        err -> {
        }
    }
    full = existing - log-entry
    ; X-4: propagate write failure to caller
    ok = util.write-file-simple(log-path, full)
}

; read-reflog: read reflog entries
; git-dir str, refname str
; returns content ?str (nil if no reflog file)
read-reflog = (git-dir str, refname str) (content ?str) {
    log-path = git-dir - '/logs/' - refname
    content = util.read-file-str(log-path)
}
