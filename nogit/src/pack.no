; pack — Git packfile read support (pack v2)
;
; Packfiles are the compact on-disk format for Git objects. A pack consists of:
;   - 4-byte signature "PACK"
;   - 4-byte version (2)
;   - 4-byte object count
;   - Object entries (variable-length header + zlib-compressed data)
;   - 20-byte SHA-1 trailer
;
; Each object entry:
;   - Variable-length size encoding with type in first byte
;   - For OBJ_OFS_DELTA / OBJ_REF_DELTA: delta base reference
;   - zlib-compressed content
;
; Delta format:
;   - source size (varint, little-endian base-128)
;   - target size (varint, little-endian base-128)
;   - series of instructions:
;     * Copy (high bit = 1): offset and size from base, variable encoding
;     * Insert (high bit = 0): 1-127 bytes of literal data
;
; Cross-module safety: returns individual scalars/strings/oids.

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/zlib
# /nogit/src/object

; ═══════════════════════════════════════════════
; pack object type constants
; ═══════════════════════════════════════════════

; OBJ_COMMIT = 1
; OBJ_TREE   = 2
; OBJ_BLOB   = 3
; OBJ_TAG    = 4
; OBJ_OFS_DELTA = 6
; OBJ_REF_DELTA = 7

; ═══════════════════════════════════════════════
; local helpers
; ═══════════════════════════════════════════════

; type-to-name: map pack type int to git object kind string
type-to-name = (t i64) (name str) {
    name = ''
    t == 1 -> name = 'commit'
    t == 2 -> name = 'tree'
    t == 3 -> name = 'blob'
    t == 4 -> name = 'tag'
}

; read-varint-le: read a little-endian base-128 varint (used in delta sizes)
; data str, pos i64
; returns value i64, new-pos i64
read-varint-le = (data str, pos i64) (value i64, new-pos i64) {
    value = 0
    shift = 0
    {
        pos >= data.len -> break
        b = data[pos] & 0xff
        value = value | ((b & 0x7f) << shift)
        pos = pos + 1
        shift = shift + 7
        (b & 0x80) == 0 -> break
    } (true)
    new-pos = pos
}

; apply-delta: apply git delta encoding to a base object
; base str: base object data
; delta str: delta instructions
; returns result str, ok bool
apply-delta = (base str, delta str) (result str, ok bool) {
    ok = false
    result = ''

    ; read source size (varint)
    src-size, pos = read-varint-le(delta, 0)
    ; read target size (varint)
    tgt-size, pos = read-varint-le(delta, pos)

    ; verify source size matches base
    src-size != base.len -> return

    ; process delta instructions
    {
        pos >= delta.len -> break
        op = delta[pos] & 0xff
        pos = pos + 1

        ; high bit set = copy from base
        (op & 0x80) != 0 -> {
            ; copy instruction: read variable offset and size
            copy-off i64 = 0
            copy-sz i64 = 0
            (op & 0x01) != 0 -> {
                copy-off = copy-off | ((delta[pos] & 0xff))
                pos = pos + 1
            }
            (op & 0x02) != 0 -> {
                copy-off = copy-off | ((delta[pos] & 0xff) << 8)
                pos = pos + 1
            }
            (op & 0x04) != 0 -> {
                copy-off = copy-off | ((delta[pos] & 0xff) << 16)
                pos = pos + 1
            }
            (op & 0x08) != 0 -> {
                copy-off = copy-off | ((delta[pos] & 0xff) << 24)
                pos = pos + 1
            }
            (op & 0x10) != 0 -> {
                copy-sz = copy-sz | ((delta[pos] & 0xff))
                pos = pos + 1
            }
            (op & 0x20) != 0 -> {
                copy-sz = copy-sz | ((delta[pos] & 0xff) << 8)
                pos = pos + 1
            }
            (op & 0x40) != 0 -> {
                copy-sz = copy-sz | ((delta[pos] & 0xff) << 16)
                pos = pos + 1
            }

            ; default size if 0 means 0x10000
            copy-sz == 0 -> copy-sz = 0x10000

            ; copy bytes from base
            i <- [0..copy-sz): {
                copy-off + i >= base.len -> break
                cs str = with-len(1)
                cs[0] = base[copy-off + i]
                result = result - cs
            }
        }

        ; high bit clear = insert literal data (1-127 bytes)
        -> {
            ins-len = op & 0x7f
            ins-len == 0 -> return
            i <- [0..ins-len): {
                pos >= delta.len -> break
                cs str = with-len(1)
                cs[0] = delta[pos]
                result = result - cs
                pos = pos + 1
            }
        }
    } (true)
    ok = true
}

; ═══════════════════════════════════════════════
; packfile read
; ═══════════════════════════════════════════════

; read-pack-header: read the PACK header and return version + object count
; data str: packfile content as byte-string
; returns version i64, count i64, ok bool
read-pack-header = (data str) (version i64, count i64, ok bool) {
    ok = false
    {
        data.len < 12 -> return

        ; verify "PACK" signature
        data[0] != 80 -> return; P

        data[1] != 65 -> return; A

        data[2] != 67 -> return; C

        data[3] != 75 -> return; K
    }

    ; version (big-endian 32-bit)
    version = (data[4] & 0xff)
    version = (version << 8) | (data[5] & 0xff)
    version = (version << 8) | (data[6] & 0xff)
    version = (version << 8) | (data[7] & 0xff)

    ; object count
    count = (data[8] & 0xff)
    count = (count << 8) | (data[9] & 0xff)
    count = (count << 8) | (data[10] & 0xff)
    count = (count << 8) | (data[11] & 0xff)
    ok = true
}

; read-pack-object-header: read the variable-length object header at offset
; data str, pos i64 (offset in pack data)
; returns type i64, size i64, new-pos i64 (offset after header), ok bool
read-pack-object-header = (data str, pos i64) (type i64, size i64, new-pos i64, ok bool) {
    ok = false
    pos >= data.len -> return
    b = data[pos] & 0xff
    type = (b >> 4) & 7
    size = b & 15
    shift = 4
    pos = pos + 1
    {
        (b & 0x80) == 0 -> break
        pos >= data.len -> return
        b = data[pos] & 0xff
        size = size | ((b & 0x7f) << shift)
        shift = shift + 7
        pos = pos + 1
    } (true)
    new-pos = pos
    ok = true
}

; read-ofs-delta-base: read the negative offset for OBJ_OFS_DELTA
; data str, pos i64
; returns offset i64, new-pos i64, ok bool
read-ofs-delta-base = (data str, pos i64) (offset i64, new-pos i64, ok bool) {
    ok = false
    pos >= data.len -> return
    b = data[pos] & 0xff
    offset = b & 0x7f
    pos = pos + 1
    {
        (b & 0x80) == 0 -> break
        pos >= data.len -> return
        b = data[pos] & 0xff
        offset = ((offset + 1) << 7) | (b & 0x7f)
        pos = pos + 1
    } (true)
    new-pos = pos
    ok = true
}

; ═══════════════════════════════════════════════
; packfile object scanning and reading
; ═══════════════════════════════════════════════

; find-pack-object: find an object in a packfile by oid using .idx file
; git-dir str, o oid
; returns pack-path str, offset i64, ok bool
;
; Uses the pack .idx file (v2 format) to locate the object by oid.
; Falls back to scan-pack-for-oid if no .idx file is found.
find-pack-object = (git-dir str, o oid) (pack-path str, offset i64, ok bool) {
    ok = false
    pack-dir = git-dir - '/objects/pack'
    isd = fs.is-dir(pack-dir)
    isd == false -> return

    ; list .pack files
    dirp = fs.open-dir(pack-dir)
    dirp == 0 -> return
    pk-ok = true
    {
        pk-ok == false -> break
        fname, pk-ok = fs.read-dir(dirp)
        pk-ok == true -> {
            fname.len > 5 -> {

                ; check if ends with ".pack"
                ext-start = fname.len - 5
                is-pack = true
                fname[ext-start] != 46 -> is-pack = false; .
                fname[ext-start + 1] != 112 -> is-pack = false; p
                fname[ext-start + 2] != 97 -> is-pack = false; a
                fname[ext-start + 3] != 99 -> is-pack = false; c
                fname[ext-start + 4] != 107 -> is-pack = false; k
                is-pack == true -> {
                    pp = pack-dir - '/' - fname

                    ; try .idx file first
                    idx-path = util.str-range(pp, 0, pp.len - 5) - '.idx'
                    idx-ok = fs.is-file(idx-path)
                    idx-ok == true -> {
                        offset, found = find-in-idx(idx-path, o)
                        found == true -> {
                            pack-path = pp
                            ok = true
                            break
                        }
                    }

                    ; fallback: scan pack directly
                    idx-ok == false -> {
                        offset, found = scan-pack-for-oid(pp, o)
                        found == true -> {
                            pack-path = pp
                            ok = true
                            break
                        }
                    }
                }
            }
        }
    } (true)
    fs.close-dir(dirp)
}

; find-in-idx: look up an oid in a pack .idx v2 file
; idx-path str: path to .idx file
; target oid: the oid to find
; returns offset i64, ok bool
find-in-idx = (idx-path str, target oid) (offset i64, ok bool) {
    ok = false
    idx str
    read-ok bool
    idx, read-ok = util.read-file-str(idx-path)
    read-ok == false -> return
    idx.len < 8 -> return

    ; verify magic: \xff t O c
    idx[0] != 0xff -> return
    idx[1] != 0x74 -> return
    idx[2] != 0x4f -> return
    idx[3] != 0x63 -> return

    ; version (must be 2)
    ver i64 = read-u32-be-local-idx(idx, 4)
    ver != 2 -> return

    ; fanout table at offset 8, 256 entries of 4 bytes each
    ; fanout[255] = total object count
    obj-count i64 = read-u32-be-local-idx(idx, 8 + 255 * 4)
    obj-count == 0 -> return

    ; oid table starts at offset 8 + 256*4 = 1032
    oid-table-start = 8 + 256 * 4

    ; binary search for the target oid in the sorted oid table
    target-bytes str = with-len(20)
    k <- [0..20): {
        target-bytes[k] = target.id[k]
    }

    lo i64 = 0
    hi i64 = obj-count - 1
    found-idx i64 = -1
    {
        lo > hi -> break
        mid i64 = (lo + hi) / 2
        ; compare target with oid at mid
        oid-start = oid-table-start + mid * 20
        cmp i64 = 0
        j <- [0..20): {
            a = idx[oid-start + j] & 0xff
            b = target.id[j] & 0xff
            a < b -> {
                cmp = -1
                break
            }
            a > b -> {
                cmp = 1
                break
            }
        }
        cmp == 0 -> {
            found-idx = mid
            break
        }
        cmp < 0 -> lo = mid + 1
        cmp > 0 -> hi = mid - 1
    } (true)

    found-idx < 0 -> return

    ; offset table starts after oid table + crc table
    ; layout: oid-table (obj-count * 20) + crc-table (obj-count * 4) + offset-table (obj-count * 4)
    offset-table-start = oid-table-start + obj-count * 20 + obj-count * 4
    off-raw i64 = read-u32-be-local-idx(idx, offset-table-start + found-idx * 4)

    ; if high bit is set, it's an index into the large-offset table
    (off-raw & 0x80000000) != 0 -> {
        large-idx = off-raw & 0x7fffffff
        large-table-start = offset-table-start + obj-count * 4
        ; large offsets are 8 bytes each
        offset = read-u64-be-local-idx(idx, large-table-start + large-idx * 8)
    }
    -> {
        offset = off-raw
    }
    ok = true
}

; read-u32-be-local-idx: read big-endian 32-bit from idx str
read-u32-be-local-idx = (s str, pos i64) (v i64) {
    v = s[pos] & 0xff
    v = (v << 8) | (s[pos + 1] & 0xff)
    v = (v << 8) | (s[pos + 2] & 0xff)
    v = (v << 8) | (s[pos + 3] & 0xff)
}

; read-u64-be-local-idx: read big-endian 64-bit from idx str
read-u64-be-local-idx = (s str, pos i64) (v i64) {
    v = s[pos] & 0xff
    v = (v << 8) | (s[pos + 1] & 0xff)
    v = (v << 8) | (s[pos + 2] & 0xff)
    v = (v << 8) | (s[pos + 3] & 0xff)
    v = (v << 8) | (s[pos + 4] & 0xff)
    v = (v << 8) | (s[pos + 5] & 0xff)
    v = (v << 8) | (s[pos + 6] & 0xff)
    v = (v << 8) | (s[pos + 7] & 0xff)
}

; scan-pack-for-oid: scan a packfile for an object with the given oid
; pack-path str, target oid
; returns offset i64, ok bool
;
; Uses zlib.zlib-decompress (now with full DEFLATE support) to decompress
; each object, hash it, and compare. Delta objects are resolved to compute
; their final oid.
scan-pack-for-oid = (pack-path str, target oid) (offset i64, ok bool) {
    ok = false
    data, read-ok = util.read-file-str(pack-path)
    read-ok == false -> return
    ver, count, hdr-ok = read-pack-header(data)
    hdr-ok == false -> return

    ; Bug 18 warmup for zlib
warmup-data str = with-len(11)
warmup-data[0] = 0x78
warmup-data[1] = 0x9c
warmup-data[2] = 0x01
warmup-data[3] = 0x00
warmup-data[4] = 0x00
warmup-data[5] = 0xff
warmup-data[6] = 0xff
warmup-data[7] = 0x00
warmup-data[8] = 0x01
warmup-data[9] = 0x00
warmup-data[10] = 0x01
    _w-out str
    _w-ok bool
    _w-out, _w-ok = zlib.zlib-decompress(warmup-data)

    ; walk all objects
    pos i64 = 12
    i <- [0..count): {
        pos >= data.len -> break
        obj-start = pos
        type, size, new-pos, ohdr-ok = read-pack-object-header(data, pos)
        ohdr-ok == false -> break
        pos = new-pos

        ; handle delta types — read base reference
        delta-base-oid oid
        delta-base-offset i64 = -1
        {
            type == 6 -> {
                ; OBJ_OFS_DELTA
                ofs, np, dok = read-ofs-delta-base(data, pos)
                dok == false -> break
                pos = np
                delta-base-offset = obj-start - ofs
            }

            type == 7 -> {
                ; OBJ_REF_DELTA — 20 bytes base oid
                k <- [0..20): {
                    delta-base-oid.id[k] = data[pos + k]
                }
                pos = pos + 20
            }
        }

        ; decompress the object data
        comp-start = pos
        decompressed, decomp-ok = zlib.zlib-decompress(util.str-range(data, comp-start, data.len))

        ; for direct objects (non-delta), hash and compare
        decomp-ok == true -> {
            type < 5 -> {
                ; direct object — hash and compare
                type-name = ''
                type == 1 -> type-name = 'commit'
                type == 2 -> type-name = 'tree'
                type == 3 -> type-name = 'blob'
                type == 4 -> type-name = 'tag'
                type-name.len > 0 -> {

                    ; hash the object
                    hdr = type-name - ' '
                    sz-str = ''

                    ; local i64 to str
                    s = size
                    s == 0 -> sz-str = '0'
                    s != 0 -> {
                        digs = ''
                        x = s
                        {
                            r = x % 10
                            cs str = with-len(1)
                            cs[0] = 48 + r
                            digs = cs - digs
                            x = x / 10
                            x == 0 -> break
                        } (true)
                        sz-str = digs
                    }
                    hdr = hdr - sz-str - '\0'
                    full str = with-len(hdr.len + decompressed.len)
                    j <- [0..hdr.len): {
                        full[j] = hdr[j]
                    }
                    j <- [0..decompressed.len): {
                        full[hdr.len + j] = decompressed[j]
                    }
                    obj-hex = oid.sha1-hex(full)

                    ; compare with target
                    target-hex = oid.oid-hex-str(target)
                    same = true
                    j <- [0..40): {
                        obj-hex[j] != target-hex[j] -> {
                            same = false
                            break
                        }
                    }
                    same == true -> {
                        offset = obj-start
                        ok = true
                        break
                    }
                }
            }
        }

        ; advance pos past the zlib stream
        ; Use zlib-consumed-binary-search to find the exact number of
        ; bytes consumed by the zlib stream. This handles both stored
        ; blocks (our own output) and compressed blocks (real git's
        ; DEFLATE output) correctly.
        consumed i64 = 0
        consumed = zlib.zlib-consumed-binary-search(data, comp-start)
        consumed == 0 -> {
            ; fallback: try stored-block scan
            sub str = util.str-range(data, comp-start, data.len)
            consumed = zlib.zlib-consumed-stored(sub)
        }
        consumed == 0 -> {
            ; could not determine compressed size — stop scanning
            break
        }
        pos = comp-start + consumed
    }
}

; ═══════════════════════════════════════════════
; packfile read entry point
; ═══════════════════════════════════════════════

; read-packed-object: read an object from a packfile
; git-dir str, o oid
; returns kind str, data str, ok bool
;
; Supports direct objects (types 1-4) and delta objects (types 6-7).
; Delta resolution recursively reads the base object (which may itself
; be a delta) and applies the delta instructions.
read-packed-object = (git-dir str, o oid) (kind str, data str, ok bool) {
    ok = false
    pack-path, offset, found-ok = find-pack-object(git-dir, o)
    found-ok == false -> return

    ; read pack data
    pack-data, read-ok = util.read-file-str(pack-path)
    read-ok == false -> return

    ; Bug 18 warmup for zlib
warmup-data str = with-len(11)
warmup-data[0] = 0x78
warmup-data[1] = 0x9c
warmup-data[2] = 0x01
warmup-data[3] = 0x00
warmup-data[4] = 0x00
warmup-data[5] = 0xff
warmup-data[6] = 0xff
warmup-data[7] = 0x00
warmup-data[8] = 0x01
warmup-data[9] = 0x00
warmup-data[10] = 0x01
    _w-out str
    _w-ok bool
    _w-out, _w-ok = zlib.zlib-decompress(warmup-data)

    kind, data, ok = read-packed-at-offset(git-dir, pack-data, offset)
}

; read-packed-at-offset: read a pack object at a given offset
; Handles both direct and delta objects. Recursive for delta resolution.
; git-dir str, pack-data str, offset i64
; returns kind str, data str, ok bool
read-packed-at-offset = (git-dir str, pack-data str, offset i64) (kind str, data str, ok bool) {
    ok = false

    ; read object header at offset
    type, size, new-pos, hdr-ok = read-pack-object-header(pack-data, offset)
    hdr-ok == false -> return
    pos = new-pos

    ; handle delta types
    {
        type == 6 -> {
            ; OBJ_OFS_DELTA — read negative offset to base
            ofs, np, dok = read-ofs-delta-base(pack-data, pos)
            dok == false -> return
            base-offset = offset - ofs

            ; decompress delta data
            delta-data, decomp-ok = zlib.zlib-decompress(util.str-range(pack-data, np, pack-data.len))
            decomp-ok == false -> return

            ; recursively read base object
            base-kind, base-data, base-ok = read-packed-at-offset(git-dir, pack-data, base-offset)
            base-ok == false -> return

            ; apply delta
            result, apply-ok = apply-delta(base-data, delta-data)
            apply-ok == false -> return

            kind = base-kind
            data = result
            ok = true
            return
        }

        type == 7 -> {
            ; OBJ_REF_DELTA — 20 bytes base oid
            base-oid oid
            k <- [0..20): {
                base-oid.id[k] = pack-data[pos + k]
            }
            pos = pos + 20

            ; decompress delta data
            delta-data, decomp-ok = zlib.zlib-decompress(util.str-range(pack-data, pos, pack-data.len))
            decomp-ok == false -> return

            ; read base object (try loose first, then pack)
            base-kind, base-data, base-ok = object.read-loose(git-dir, base-oid)
            base-ok == false -> {
                base-kind, base-data, base-ok = read-packed-object(git-dir, base-oid)
            }
            base-ok == false -> return

            ; apply delta
            result, apply-ok = apply-delta(base-data, delta-data)
            apply-ok == false -> return

            kind = base-kind
            data = result
            ok = true
            return
        }
    }

    ; direct object — decompress
    decompressed, decomp-ok = zlib.zlib-decompress(util.str-range(pack-data, pos, pack-data.len))
    {
        decomp-ok == false -> return

        ; map type to kind
        type == 1 -> kind = 'commit'

        type == 2 -> kind = 'tree'

        type == 3 -> kind = 'blob'

        type == 4 -> kind = 'tag'
    }
    data = decompressed
    ok = true
}
