; pack — Git packfile read support (pack v2)
;
; Packfiles are the compact on-disk format for Git objects. A pack consists of:
;   - 4-byte signature "PACK"
;   - 4-byte version (2)
;   - 4-byte object count
;   - Object entries (variable-length header + zlib-compressed data)
;   - 20-byte SHA-1 trailer
;
; Each object entry:
;   - Variable-length size encoding with type in first byte
;   - For OBJ_OFS_DELTA / OBJ_REF_DELTA: delta base reference
;   - zlib-compressed content
;
; Delta format:
;   - source size (varint, little-endian base-128)
;   - target size (varint, little-endian base-128)
;   - series of instructions:
;     * Copy (high bit = 1): offset and size from base, variable encoding
;     * Insert (high bit = 0): 1-127 bytes of literal data
;
; Cross-module safety: returns individual scalars/strings/oids.

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/zlib
# /nogit/src/object

; ═══════════════════════════════════════════════
; pack object type constants
; ═══════════════════════════════════════════════

; OBJ_COMMIT = 1
; OBJ_TREE   = 2
; OBJ_BLOB   = 3
; OBJ_TAG    = 4
; OBJ_OFS_DELTA = 6
; OBJ_REF_DELTA = 7

; ═══════════════════════════════════════════════
; local helpers
; ═══════════════════════════════════════════════

; type-to-name: map pack type int to git object kind string
type-to-name = (t i64) (name str) {
    name = ''
    t == 1 -> name = 'commit'
    t == 2 -> name = 'tree'
    t == 3 -> name = 'blob'
    t == 4 -> name = 'tag'
}

; read-varint-le: read a little-endian base-128 varint (used in delta sizes)
; data str, pos i64
; returns value i64, new-pos i64
read-varint-le = (data str, pos i64) (value i64, new-pos i64) {
    value = 0
    shift = 0
    !! {
        pos >= data.len-bytes() -> break
        b = data[pos] & 0xff
        value = value | ((b & 0x7f) << shift)

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        shift = shift + 7: {
            ok -> it

            -> _
        }
        (b & 0x80) == 0 -> break
    }
    new-pos = pos
}

; apply-delta: apply git delta encoding to a base object
; base str: base object data
; delta str: delta instructions
; returns result str, ok bool
apply-delta = (base str, delta str) (result ?str) {
    acc = ''

    ; read source size (varint)
    src-size, pos = read-varint-le(delta, 0)

    ; read target size (varint)
    tgt-size, pos = read-varint-le(delta, pos)

    ; verify source size matches base
    src-size != base.len-bytes() -> return

    ; process delta instructions
    !! {
        pos >= delta.len-bytes() -> break
        op = delta[pos] & 0xff

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }

        ; high bit set = copy from base
        {
            (op & 0x80) != 0 -> {

                ; copy instruction: read variable offset and size.
                ; Every operand byte is bounds-checked before reading (G-7).
                copy-off i64 = 0
                copy-sz i64 = 0
                (op & 0x01) != 0 -> {
                    pos >= delta.len-bytes() -> return
                    copy-off = copy-off | (delta[pos] & 0xff)

                    #{overflow=wrap}
                    pos = pos + 1: {
                        ok -> it

                        -> _
                    }
                }
                (op & 0x02) != 0 -> {
                    pos >= delta.len-bytes() -> return
                    copy-off = copy-off | ((delta[pos] & 0xff) << 8)

                    #{overflow=wrap}
                    pos = pos + 1: {
                        ok -> it

                        -> _
                    }
                }
                (op & 0x04) != 0 -> {
                    pos >= delta.len-bytes() -> return
                    copy-off = copy-off | ((delta[pos] & 0xff) << 16)

                    #{overflow=wrap}
                    pos = pos + 1: {
                        ok -> it

                        -> _
                    }
                }
                (op & 0x08) != 0 -> {
                    pos >= delta.len-bytes() -> return
                    copy-off = copy-off | ((delta[pos] & 0xff) << 24)

                    #{overflow=wrap}
                    pos = pos + 1: {
                        ok -> it

                        -> _
                    }
                }
                (op & 0x10) != 0 -> {
                    pos >= delta.len-bytes() -> return
                    copy-sz = copy-sz | (delta[pos] & 0xff)

                    #{overflow=wrap}
                    pos = pos + 1: {
                        ok -> it

                        -> _
                    }
                }
                (op & 0x20) != 0 -> {
                    pos >= delta.len-bytes() -> return
                    copy-sz = copy-sz | ((delta[pos] & 0xff) << 8)

                    #{overflow=wrap}
                    pos = pos + 1: {
                        ok -> it

                        -> _
                    }
                }
                (op & 0x40) != 0 -> {
                    pos >= delta.len-bytes() -> return
                    copy-sz = copy-sz | ((delta[pos] & 0xff) << 16)

                    #{overflow=wrap}
                    pos = pos + 1: {
                        ok -> it

                        -> _
                    }
                }

                ; default size if 0 means 0x10000
                copy-sz == 0 -> copy-sz = 0x10000

                ; the whole copy must fit inside the base object
                #{overflow=wrap}
                copy-end = copy-off + copy-sz: {
                    ok -> it

                    -> _
                }
                copy-end > base.len-bytes() -> return

                ; copy bytes from base (concatenation: writing a str value
                ; into a str slot via s[i] emits tag bytes, see G-11)
                i <- [0..copy-sz): {
                    #{overflow=wrap}
                    at = copy-off + i: {
                        ok -> it

                        -> _
                    }
                    d9v1 str = base[at]: {
                        ok -> it.to-str()

                        -> ''
                    }
                    acc = acc - d9v1
                }
            }

            -> {

                ; high bit clear = insert literal data (1-127 bytes)
                ins-len = op & 0x7f
                ins-len == 0 -> return

                #{overflow=wrap}
                ins-end = pos + ins-len: {
                    ok -> it

                    -> _
                }
                ins-end > delta.len-bytes() -> return
                i <- [0..ins-len): {
                    #{overflow=wrap}
                    at = pos + i: {
                        ok -> it

                        -> _
                    }
                    d9v2 str = delta[at]: {
                        ok -> it.to-str()

                        -> ''
                    }
                    acc = acc - d9v2
                }
                pos = ins-end
            }
        }
    }

    ; the final result must match the declared target size (G-7)
    acc.len-bytes() != tgt-size -> return
    result = acc
}

; ═══════════════════════════════════════════════
; packfile read
; ═══════════════════════════════════════════════

; read-pack-header: read the PACK header and return version + object count
; data str: packfile content as byte-string
; returns version i64, count i64, ok bool
read-pack-header = (data str) (version i64, count i64, ok bool) {
    ok = false
    {
        data.len-bytes() < 12 -> return

        ; verify "PACK" signature
        data[0] != 80 -> return; P

        data[1] != 65 -> return; A

        data[2] != 67 -> return; C

        data[3] != 75 -> return; K
    }

    ; version (big-endian 32-bit)
    version = (data[4] & 0xff)
    version = (version << 8) | (data[5] & 0xff)
    version = (version << 8) | (data[6] & 0xff)
    version = (version << 8) | (data[7] & 0xff)

    ; object count
    count = (data[8] & 0xff)
    count = (count << 8) | (data[9] & 0xff)
    count = (count << 8) | (data[10] & 0xff)
    count = (count << 8) | (data[11] & 0xff)
    ok = true
}

; read-pack-object-header: read the variable-length object header at offset
; data str, pos i64 (offset in pack data)
; returns type i64, size i64, new-pos i64 (offset after header), ok bool
read-pack-object-header = (data str, pos i64) (type i64, size i64, new-pos i64, ok bool) {
    ok = false
    pos >= data.len-bytes() -> return
    b = data[pos] & 0xff
    type = (b >> 4) & 7
    size = b & 15
    shift = 4

    #{overflow=wrap}
    pos = pos + 1: {
        ok -> it

        -> _
    }
    !! {
        (b & 0x80) == 0 -> break
        pos >= data.len-bytes() -> return
        b = data[pos] & 0xff
        size = size | ((b & 0x7f) << shift)

        #{overflow=wrap}
        shift = shift + 7: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }
    }
    new-pos = pos
    ok = true
}

; read-ofs-delta-base: read the negative offset for OBJ_OFS_DELTA
; data str, pos i64
; returns offset i64, new-pos i64, ok bool
read-ofs-delta-base = (data str, pos i64) (offset i64, new-pos i64, ok bool) {
    ok = false
    pos >= data.len-bytes() -> return
    b = data[pos] & 0xff
    offset = b & 0x7f

    #{overflow=wrap}
    pos = pos + 1: {
        ok -> it

        -> _
    }
    !! {
        (b & 0x80) == 0 -> break
        pos >= data.len-bytes() -> return
        b = data[pos] & 0xff
        offset = ((offset + 1) << 7) | (b & 0x7f)

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }
    }
    new-pos = pos
    ok = true
}

; ═══════════════════════════════════════════════
; packfile object scanning and reading
; ═══════════════════════════════════════════════

; find-pack-object: find an object in a packfile by oid using .idx file
; git-dir str, o oid
; returns pack-path str, offset i64, ok bool
;
; Uses the pack .idx file (v2 format) to locate the object by oid.
; Falls back to scan-pack-for-oid if no .idx file is found.
find-pack-object = (git-dir str, o oid) (pack-path str, offset i64, ok bool) {
    ok = false
    pack-dir = git-dir - '/objects/pack'
    isd = fs.is-dir(pack-dir)
    ! isd -> return

    ; list .pack files
    dirp = fs.open-dir(pack-dir)
    dirp == 0 -> return
    pk-ok = true
    !! {
        ! pk-ok -> break
        fname-opt = fs.read-dir(dirp)
        fname = ''
        pk-ok = false
        fname-opt: {
            ok -> {
                fname = it
                pk-ok = true
            }

            -> {
            }
        }
        pk-ok -> {
            fname.len() > 5 -> {

                ; check if ends with ".pack"
                #{overflow=wrap}
                ext-start = fname.len() - 5
                is-pack = true
                fname[ext-start] != 46 -> is-pack = false; .

                #{overflow=wrap}
                fname[ext-start + 1] != 112 -> is-pack = false; p

                #{overflow=wrap}
                fname[ext-start + 2] != 97 -> is-pack = false; a

                #{overflow=wrap}
                fname[ext-start + 3] != 99 -> is-pack = false; c

                #{overflow=wrap}
                fname[ext-start + 4] != 107 -> is-pack = false; k
                is-pack -> {
                    pp = pack-dir - '/' - fname

                    ; try .idx file first
                    #{overflow=wrap}
                    idx-path = util.str-range(pp, 0, pp.len-bytes() - 5) - '.idx'
                    idx-ok = fs.is-file(idx-path)
                    idx-ok -> {
                        offset-opt = find-in-idx(idx-path, o)
                        offset i64
                        found bool = false
                        offset-opt: {
                            ok -> {
                                offset = it
                                found = true
                            }

                            nil || err -> {
                            }
                        }
                        found -> {
                            pack-path = pp
                            ok = true
                            break
                        }
                    }

                    ; fallback: scan pack directly
                    ! idx-ok -> {
                        offset-opt = scan-pack-for-oid(pp, o)
                        offset i64
                        found bool = false
                        offset-opt: {
                            ok -> {
                                offset = it
                                found = true
                            }

                            nil || err -> {
                            }
                        }
                        found -> {
                            pack-path = pp
                            ok = true
                            break
                        }
                    }
                }
            }
        }
    }
    fs.close-dir(dirp)
}

; find-in-idx: look up an oid in a pack .idx v2 file
; idx-path str: path to .idx file
; target oid: the oid to find
; returns offset i64, ok bool
find-in-idx = (idx-path str, target oid) (offset ?i64) {
    idx str
    idx-opt = util.read-file-str(idx-path)
    idx-opt: {
        ok -> idx = it

        nil -> {
            return
        }

        err -> {
            return
        }
    }
    ; the fanout table alone is 8 + 256*4 = 1032 bytes
    idx.len-bytes() < 1032 -> return

    ; verify magic: \xff t O c
    idx[0] != 0xff -> return
    idx[1] != 0x74 -> return
    idx[2] != 0x4f -> return
    idx[3] != 0x63 -> return

    ; version (must be 2)
    ver = read-u32-be-local-idx(idx, 4)
    ver != 2 -> return

    ; fanout table at offset 8, 256 entries of 4 bytes each
    ; fanout[255] = total object count
    fan-off = 0
    fan-off-opt = 8 + 255 * 4
    fan-off-opt: {
        ok -> {
            fan-off = it
        }

        -> {
            fan-off = 0
        }
    }
    obj-count = read-u32-be-local-idx(idx, fan-off)
    obj-count == 0 -> return

    ; G-9: a truncated .idx must not drive huge table walks. Every object
    ; needs at least 20 (oid) + 4 (crc) + 4 (offset) bytes after the fanout.
    #{overflow=wrap}
    max-count = (idx.len-bytes() - 1032) / 28: {
        ok -> it

        -> _
    }
    obj-count > max-count -> return

    ; oid table starts at offset 8 + 256*4 = 1032
    oid-table-start = 0
    oid-table-start-opt = 8 + 256 * 4
    oid-table-start-opt: {
        ok -> {
            oid-table-start = it
        }

        -> {
            oid-table-start = 0
        }
    }

    ; binary search for the target oid in the sorted oid table
    tb []byte = with-cap-len(20, 20)
    k <- [0..20): {
        bv = target.id[k]
        v byte = 0
        bv: {
            ok -> v = it

            -> _
        }
        tb[k] = v
    }
    target-bytes str = tb.slice(0, 20).to-bytes-str()

    lo = 0

    #{overflow=wrap}
    hi = obj-count - 1
    found-idx = -1
    !! {
        lo > hi -> break

        mid i64 = 0
        mid-opt = (lo + hi) / 2
        mid-opt: {
            ok -> {
                mid = it
            }

            -> {
                mid = 0
            }
        }

        ; compare target with oid at mid
        #{overflow=wrap}
        oid-start = oid-table-start + mid * 20
        #{overflow=wrap}
        oid-start + 20 > idx.len-bytes() -> return
        cmp i64 = 0
        j <- [0..20): {

            #{overflow=wrap}
            a = idx[oid-start + j] & 0xff
            b = target.id[j] & 0xff
            a < b -> {
                cmp = -1
                break
            }
            a > b -> {
                cmp = 1
                break
            }
        }
        cmp == 0 -> {
            found-idx = mid
            break
        }

        #{overflow=wrap}
        cmp < 0 -> lo = mid + 1: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        cmp > 0 -> hi = mid - 1
    }

    found-idx < 0 -> return

    ; offset table starts after oid table + crc table
    ; layout: oid-table (obj-count * 20) + crc-table (obj-count * 4) + offset-table (obj-count * 4)
    offset-table-start = 0
    offset-table-start-opt = oid-table-start + obj-count * 20 + obj-count * 4
    offset-table-start-opt: {
        ok -> {
            offset-table-start = it
        }

        -> {
            offset-table-start = 0
        }
    }

    oid-step = 0
    oid-step-opt = found-idx * 4
    oid-step-opt: {
        ok -> {
            oid-step = it
        }

        -> {
            oid-step = 0
        }
    }
    oid-slot = 0
    oid-slot-opt = offset-table-start + oid-step
    oid-slot-opt: {
        ok -> {
            oid-slot = it
        }

        -> {
            oid-slot = 0
        }
    }
    #{overflow=wrap}
    oid-slot + 4 > idx.len-bytes() -> return
    off-raw = read-u32-be-local-idx(idx, oid-slot)

    ; if high bit is set, it's an index into the large-offset table
    {
        (off-raw & 0x80000000) != 0 -> {
            large-idx = off-raw & 0x7fffffff

            large-table-start i64 = 0
            large-table-start-opt = offset-table-start + obj-count * 4
            large-table-start-opt: {
                ok -> {
                    large-table-start = it
                }

                -> {
                    large-table-start = 0
                }
            }

            ; large offsets are 8 bytes each
            lo-step i64 = 0
            lo-step-opt = large-idx * 8
            lo-step-opt: {
                ok -> {
                    lo-step = it
                }

                -> {
                    lo-step = 0
                }
            }
            lo-slot i64 = 0
            lo-slot-opt = large-table-start + lo-step
            lo-slot-opt: {
                ok -> {
                    lo-slot = it
                }

                -> {
                    lo-slot = 0
                }
            }
            offset = read-u64-be-local-idx(idx, lo-slot)
        }

        -> {
            offset = off-raw
        }
    }
}

; idx-byte: read one raw byte from an .idx string; out-of-range -> 0.
; Using .byte() avoids UTF-8 codepoint re-encoding of binary data.
idx-byte = (s str, pos i64) (v i64) {
    v = 0
    pos < 0 -> return
    pos >= s.len-bytes() -> return
    bv = s.byte(pos)
    bv: {
        ok -> v = it

        -> _
    }
}

; read-u32-be-local-idx: read big-endian 32-bit from idx str
read-u32-be-local-idx = (s str, pos i64) (v i64) {
    v = 0
    i <- [0..4): {
        #{overflow=wrap}
        at = pos + i: {
            ok -> it

            -> _
        }
        b = idx-byte(s, at)

        #{overflow=wrap}
        v = (v << 8) | (b & 0xff): {
            ok -> it

            -> _
        }
    }
}

; read-u64-be-local-idx: read big-endian 64-bit from idx str
read-u64-be-local-idx = (s str, pos i64) (v i64) {
    v = 0
    i <- [0..8): {
        #{overflow=wrap}
        at = pos + i: {
            ok -> it

            -> _
        }
        b = idx-byte(s, at)

        #{overflow=wrap}
        v = (v << 8) | (b & 0xff): {
            ok -> it

            -> _
        }
    }
}

; scan-pack-for-oid: scan a packfile for an object with the given oid
; pack-path str, target oid
; returns offset i64, ok bool
;
; Uses zlib.zlib-decompress (now with full DEFLATE support) to decompress
; each object, hash it, and compare. Delta objects are resolved to compute
; their final oid.
scan-pack-for-oid = (pack-path str, target oid) (offset ?i64) {
    data str
    data-opt = util.read-file-str(pack-path)
    data-opt: {
        ok -> data = it

        nil -> {
            return
        }

        err -> {
            return
        }
    }
    ver, count, hdr-ok = read-pack-header(data)
    ! hdr-ok -> return

    ; Bug 18 warmup for zlib
    warmup-data = '\x78\x9c\x01\x00\x00\xff\xff\x00\x01\x00\x01'
    w-opt = zlib.zlib-decompress(warmup-data)
    _ = w-opt

    ; walk all objects
    pos = 12
    i <- [0..count): {
        pos >= data.len() -> break
        obj-start = pos
        type, size, new-pos, ohdr-ok = read-pack-object-header(data, pos)
        ! ohdr-ok -> break
        pos = new-pos

        ; handle delta types — read base reference
        delta-base-oid oid
        delta-base-offset i64 = -1
        {
            type == 6 -> {

                ; OBJ_OFS_DELTA
                ofs, np, dok = read-ofs-delta-base(data, pos)
                ! dok -> break
                pos = np

                #{overflow=wrap}
                delta-base-offset = obj-start - ofs
            }

            type == 7 -> {

                ; OBJ_REF_DELTA — 20 bytes base oid
                k <- [0..20): {

                    #{overflow=wrap}
                    bv byte = data.byte(pos + k): {
                        ok -> it

                        -> 0
                    }
                    delta-base-oid.id[k] = bv
                }

                #{overflow=wrap}
                pos = pos + 20: {
                    ok -> it

                    -> _
                }
            }
        }

        ; decompress the object data
        comp-start = pos
        decompressed str = ''
        decomp-have = false
        decomp-opt = zlib.zlib-decompress(util.str-range(data, comp-start, data.len()))
        decomp-opt: {
            ok -> {
                decompressed = it
                decomp-have = true
            }

            nil -> {
            }

            err -> {
            }
        }

        ; for direct objects (non-delta), hash and compare
        decomp-have -> {
            type < 5 -> {

                ; direct object — hash and compare
                type-name = ''
                type == 1 -> type-name = 'commit'
                type == 2 -> type-name = 'tree'
                type == 3 -> type-name = 'blob'
                type == 4 -> type-name = 'tag'
                type-name.len-bytes() > 0 -> {

                    ; hash the object
                    hdr = type-name - ' '
                    sz-str = ''

                    ; local i64 to str
                    ; G-11/X-3: build via concatenation, not str index writes.
                    s = size
                    s == 0 -> sz-str = '0'
                    s != 0 -> {
                        digs = ''
                        dec-digits = '0123456789'
                        x = s
                        !! {
                            r = x % 10

                            dr = dec-digits[r]: {
                                ok -> it.to-str()

                                -> ''
                            }
                            digs = dr - digs

                            #{overflow=wrap}
                            q = x / 10: {
                                ok -> it

                                -> 0
                            }
                            x = q
                            x == 0 -> break
                        }
                        sz-str = digs
                    }

                    #{overflow=wrap}
                    hdr = hdr - sz-str - '\0'

                    ; G-11/X-3: str index assignment writes the option tag byte
                    ; (0x01). The two loops below were a byte-for-byte copy of
                    ; hdr + decompressed; concatenation is equivalent and safe.
                    full = hdr - decompressed
                    obj-hex = oid.sha1-hex(full)

                    ; compare with target
                    target-hex = oid.oid-hex-str(target)
                    same = true
                    j <- [0..40): {
                        obj-hex[j] != target-hex[j] -> {
                            same = false
                            break
                        }
                    }
                    same -> {
                        offset = obj-start
                        break
                    }
                }
            }
        }

        ; advance pos past the zlib stream
        ; Use zlib-consumed-binary-search to find the exact number of
        ; bytes consumed by the zlib stream. This handles both stored
        ; blocks (our own output) and compressed blocks (real git's
        ; DEFLATE output) correctly.
        consumed i64 = 0
        consumed = zlib.zlib-consumed-binary-search(data, comp-start)
        consumed == 0 -> {

            ; fallback: try stored-block scan
            sub str = util.str-range(data, comp-start, data.len())
            consumed = zlib.zlib-consumed-stored(sub)
        }
        consumed == 0 -> {

            ; could not determine compressed size — stop scanning
            break
        }

        #{overflow=wrap}
        pos = comp-start + consumed: {
            ok -> it

            -> _
        }
    }
}

; ═══════════════════════════════════════════════
; packfile read entry point
; ═══════════════════════════════════════════════

; read-packed-object: read an object from a packfile
; git-dir str, o oid
; returns kind str, data str, ok bool
;
; Supports direct objects (types 1-4) and delta objects (types 6-7).
; Delta resolution recursively reads the base object (which may itself
; be a delta) and applies the delta instructions.
read-packed-object = (git-dir str, o oid) (kind str, data str, ok bool) {
    kind, data, ok = read-packed-object-depth(git-dir, o, 0)
}

; read-packed-object-depth: internal bounded implementation of
; read-packed-object. Delta chains deeper than 50 are rejected (G-6).
read-packed-object-depth = (git-dir str, o oid, depth i64) (kind str, data str, ok bool) {
    ok = false
    depth > 50 -> return
    pack-path, offset, found-ok = find-pack-object(git-dir, o)
    ! found-ok -> return

    ; read pack data
    pack-data str
    pack-data-opt = util.read-file-str(pack-path)
    pack-data-opt: {
        ok -> pack-data = it

        nil -> {
            return
        }

        err -> {
            return
        }
    }

    ; Bug 18 warmup for zlib
    warmup-data = '\x78\x9c\x01\x00\x00\xff\xff\x00\x01\x00\x01'
    w-opt = zlib.zlib-decompress(warmup-data)
    _ = w-opt

    kind, data, ok = read-packed-at-offset-depth(git-dir, pack-data, offset, depth)
}

; read-packed-at-offset: read a pack object at a given offset
; Handles both direct and delta objects. Recursive for delta resolution.
; git-dir str, pack-data str, offset i64
; returns kind str, data str, ok bool
read-packed-at-offset = (git-dir str, pack-data str, offset i64) (kind str, data str, ok bool) {
    kind, data, ok = read-packed-at-offset-depth(git-dir, pack-data, offset, 0)
}

; read-packed-at-offset-depth: bounded internal implementation (G-6). A
; corrupt ofs-delta base offset or a cyclic ref-delta chain would otherwise
; recurse without limit.
read-packed-at-offset-depth = (git-dir str, pack-data str, offset i64, depth i64) (kind str, data str, ok bool) {
    ok = false
    depth > 50 -> return
    offset < 12 -> return
    offset >= pack-data.len-bytes() -> return

    ; read object header at offset
    type, size, new-pos, hdr-ok = read-pack-object-header(pack-data, offset)
    ! hdr-ok -> return
    pos = new-pos

    ; handle delta types
    {
        type == 6 -> {

            ; OBJ_OFS_DELTA — read negative offset to base
            ofs, np, dok = read-ofs-delta-base(pack-data, pos)
            ! dok -> return

            #{overflow=wrap}
            base-offset = offset - ofs: {
                ok -> it

                -> _
            }
            ; G-6: base must be an earlier object inside the pack
            base-offset < 12 -> return
            base-offset >= offset -> return
            base-offset >= pack-data.len-bytes() -> return

            #{overflow=wrap}
            next-depth = depth + 1: {
                ok -> it

                -> _
            }

            ; decompress delta data
            delta-data str
            delta-opt = zlib.zlib-decompress(util.str-range(pack-data, np, pack-data.len-bytes()))
            delta-opt: {
                ok -> {
                    delta-data = it
                }

                nil -> {
                    return
                }

                err -> {
                    return
                }
            }

            ; recursively read base object (depth-bounded)
            base-kind, base-data, base-ok = read-packed-at-offset-depth(git-dir, pack-data, base-offset, next-depth)
            ! base-ok -> return

            ; apply delta
            result-opt = apply-delta(base-data, delta-data)
            result str
            apply-ok bool = false
            result-opt: {
                ok -> {
                    result = it
                    apply-ok = true
                }

                nil || err -> {
                }
            }
            ! apply-ok -> return

            kind = base-kind
            data = result
            ok = true
            return
        }

        type == 7 -> {

            ; OBJ_REF_DELTA — 20 bytes base oid
            #{overflow=wrap}
            pos + 20 > pack-data.len-bytes() -> return
            base-oid oid
            k <- [0..20): {

                #{overflow=wrap}
                bv byte = pack-data.byte(pos + k): {
                    ok -> it

                    -> 0
                }
                base-oid.id[k] = bv
            }

            #{overflow=wrap}
            pos = pos + 20: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            next-depth = depth + 1: {
                ok -> it

                -> _
            }

            ; decompress delta data
            delta-data str
            delta-opt = zlib.zlib-decompress(util.str-range(pack-data, pos, pack-data.len-bytes()))
            delta-opt: {
                ok -> {
                    delta-data = it
                }

                nil -> {
                    return
                }

                err -> {
                    return
                }
            }

            ; read base object (try loose first, then pack, depth-bounded)
            base-kind, base-data, base-ok = object.read-loose(git-dir, base-oid)
            ! base-ok -> {
                base-kind, base-data, base-ok = read-packed-object-depth(git-dir, base-oid, next-depth)
            }
            ! base-ok -> return

            ; apply delta
            result-opt = apply-delta(base-data, delta-data)
            result str
            apply-ok bool = false
            result-opt: {
                ok -> {
                    result = it
                    apply-ok = true
                }

                nil || err -> {
                }
            }
            ! apply-ok -> return

            kind = base-kind
            data = result
            ok = true
            return
        }
    }

    ; direct object — decompress
    decompressed str
    decomp-opt = zlib.zlib-decompress(util.str-range(pack-data, pos, pack-data.len-bytes()))
    decomp-opt: {
        ok -> {
            decompressed = it
        }

        nil -> {
            return
        }

        err -> {
            return
        }
    }
    {
        ; map type to kind
        type == 1 -> kind = 'commit'

        type == 2 -> kind = 'tree'

        type == 3 -> kind = 'blob'

        type == 4 -> kind = 'tag'
    }
    data = decompressed
    ok = true
}
