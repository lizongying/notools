; pack — Git packfile read support (pack v2)
;
; Packfiles are the compact on-disk format for Git objects. A pack consists of:
;   - 4-byte signature "PACK"
;   - 4-byte version (2)
;   - 4-byte object count
;   - Object entries (variable-length header + zlib-compressed data)
;   - 20-byte SHA-1 trailer
;
; Each object entry:
;   - Variable-length size encoding with type in first byte
;   - For OBJ_OFS_DELTA / OBJ_REF_DELTA: delta base reference
;   - zlib-compressed content
;
; Cross-module safety: returns individual scalars/strings/oids.

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/zlib

; ═══════════════════════════════════════════════
; local helpers
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; pack object type constants
; ═══════════════════════════════════════════════

; OBJ_COMMIT = 1
; OBJ_TREE   = 2
; OBJ_BLOB   = 3
; OBJ_TAG    = 4
; OBJ_OFS_DELTA = 6
; OBJ_REF_DELTA = 7

; ═══════════════════════════════════════════════
; packfile read
; ═══════════════════════════════════════════════

; read-pack-header: read the PACK header and return version + object count
; data str: packfile content as byte-string
; returns version i64, count i64, ok bool
read-pack-header = (data str) (version i64, count i64, ok bool) {
    ok = false
    {
        data.len < 12 -> return

        ; verify "PACK" signature
        data[0] != 80 -> return; P

        data[1] != 65 -> return; A

        data[2] != 67 -> return; C

        data[3] != 75 -> return; K
    }

    ; version (big-endian 32-bit)
    version = (data[4] & 0xff)
    version = (version << 8) | (data[5] & 0xff)
    version = (version << 8) | (data[6] & 0xff)
    version = (version << 8) | (data[7] & 0xff)

    ; object count
    count = (data[8] & 0xff)
    count = (count << 8) | (data[9] & 0xff)
    count = (count << 8) | (data[10] & 0xff)
    count = (count << 8) | (data[11] & 0xff)
    ok = true
}

; read-pack-object-header: read the variable-length object header at offset
; data str, pos i64 (offset in pack data)
; returns type i64, size i64, new-pos i64 (offset after header), ok bool
read-pack-object-header = (data str, pos i64) (type i64, size i64, new-pos i64, ok bool) {
    ok = false
    pos >= data.len -> return
    b = data[pos] & 0xff
    type = (b >> 4) & 7
    size = b & 15
    shift = 4
    pos = pos + 1
    {
        (b & 0x80) == 0 -> break
        pos >= data.len -> return
        b = data[pos] & 0xff
        size = size | ((b & 0x7f) << shift)
        shift = shift + 7
        pos = pos + 1
    } (true)
    new-pos = pos
    ok = true
}

; read-ofs-delta-base: read the negative offset for OBJ_OFS_DELTA
; data str, pos i64
; returns offset i64, new-pos i64, ok bool
read-ofs-delta-base = (data str, pos i64) (offset i64, new-pos i64, ok bool) {
    ok = false
    pos >= data.len -> return
    b = data[pos] & 0xff
    offset = b & 0x7f
    pos = pos + 1
    {
        (b & 0x80) == 0 -> break
        pos >= data.len -> return
        b = data[pos] & 0xff
        offset = ((offset + 1) << 7) | (b & 0x7f)
        pos = pos + 1
    } (true)
    new-pos = pos
    ok = true
}

; find-pack-object: find an object in a packfile by oid
; git-dir str, o oid
; returns pack-path str, offset i64, ok bool
;
; Scans all .pack files in objects/pack/ and their .idx files.
; For simplicity, we scan the pack directly (no idx support yet).
find-pack-object = (git-dir str, o oid) (pack-path str, offset i64, ok bool) {
    ok = false
    pack-dir = git-dir - '/objects/pack'
    isd = fs.is-dir(pack-dir)
    isd == false -> return

    ; list .pack files
    dirp = fs.open-dir(pack-dir)
    dirp == 0 -> return
    pk-ok = true
    {
        pk-ok == false -> break
        fname, pk-ok = fs.read-dir(dirp)
        pk-ok == true -> {
            fname.len > 5 -> {

                ; check if ends with ".pack"
                ext-start = fname.len - 5
                is-pack = true
                fname[ext-start] != 46 -> is-pack = false; .
                fname[ext-start + 1] != 112 -> is-pack = false; p
                fname[ext-start + 2] != 97 -> is-pack = false; a
                fname[ext-start + 3] != 99 -> is-pack = false; c
                fname[ext-start + 4] != 107 -> is-pack = false; k
                is-pack == true -> {
                    pp = pack-dir - '/' - fname
                    offset, found = scan-pack-for-oid(pp, o)
                    found == true -> {
                        pack-path = pp
                        ok = true
                        break
                    }
                }
            }
        }
    } (true)
    fs.close-dir(dirp)
}

; scan-pack-for-oid: scan a packfile for an object with the given oid
; pack-path str, target oid
; returns offset i64, ok bool
scan-pack-for-oid = (pack-path str, target oid) (offset i64, ok bool) {
    ok = false
    data, read-ok = util.read-file-str(pack-path)
    read-ok == false -> return
    ver, count, hdr-ok = read-pack-header(data)
    hdr-ok == false -> return

    ; walk all objects
    pos i64 = 12
    i <- [0..count): {
        pos >= data.len -> break
        obj-start = pos
        type, size, new-pos, ohdr-ok = read-pack-object-header(data, pos)
        ohdr-ok == false -> break
        pos = new-pos

        ; handle delta types
        type == 6 -> {

            ; OBJ_OFS_DELTA
            ofs, np, dok = read-ofs-delta-base(data, pos)
            dok == false -> break
            pos = np
        }
        type == 7 -> {

            ; OBJ_REF_DELTA — 20 bytes base oid
            pos = pos + 20
        }

        ; now at compressed data — we need to decompress to find the oid
        ; but computing the oid requires full decompression + hashing
        ; for now, skip the compressed data
        ; We need to find the end of the zlib stream.
        ; Since we can only do stored blocks, scan for the zlib stream end.
        ; For a stored block: skip header byte, then 4 bytes (LEN + NLEN), then data, then check BFINAL
        ; This is a simplified skip — real packs may use compressed DEFLATE blocks.
        ; For now, we decompress and hash to check if this is our object.
        comp-start = pos
        decompressed, decomp-ok = zlib.zlib-decompress(data[comp-start..data.len))
        decomp-ok == true -> {

            ; build header and hash
            type-name = ''
            type == 1 -> type-name = 'commit'
            type == 2 -> type-name = 'tree'
            type == 3 -> type-name = 'blob'
            type == 4 -> type-name = 'tag'
            type-name.len > 0 -> {

                ; hash the object
                hdr = type-name - ' '
                sz-str = ''

                ; local i64 to str
                s = size
                s == 0 -> sz-str = '0'
                s != 0 -> {
                    digs = ''
                    x = s
                    {
                        r = x % 10
                        cs str = with-len(1)
                        cs[0] = 48 + r
                        digs = cs - digs
                        x = x / 10
                        x == 0 -> break
                    } (true)
                    sz-str = digs
                }
                hdr = hdr - sz-str - '\0'
                full str = with-len(hdr.len + decompressed.len)
                j <- [0..hdr.len): {
                    full[j] = hdr[j]
                }
                j <- [0..decompressed.len): {
                    full[hdr.len + j] = decompressed[j]
                }
                obj-hex = oid.sha1-hex(full)

                ; compare with target
                target-hex = oid.oid-hex-str(target)
                same = true
                j <- [0..40): {
                    obj-hex[j] != target-hex[j] -> {
                        same = false
                        break
                    }
                }
                same == true -> {
                    offset = obj-start
                    ok = true
                    break
                }
            }
        }

        ; advance pos past the zlib stream
        ; find end of zlib stream (stored blocks: scan to BFINAL=1 block end)
        ; For stored blocks, the zlib stream ends after the last block's data + 4 byte Adler-32
        ; We scan blocks to find the end
        zp = comp-start + 2; skip 2-byte zlib header
        {
            zp >= data.len -> break
            bfinal = data[zp] & 1
            btype = (data[zp] >> 1) & 3
            zp = zp + 1
            {
                btype == 0 -> {

                    ; stored block
                    blen = (data[zp] & 0xff) | ((data[zp + 1] & 0xff) << 8)
                    zp = zp + 4; skip LEN + NLEN
                    zp = zp + blen
                }

                -> {

                    ; compressed block — we can't easily skip these
                    ; For now, just break (we only support stored blocks)
                    break
                }
            }

            bfinal == 1 -> {
                zp = zp + 4; skip Adler-32
                break
            }
        } (true)
        pos = zp
    }
}

; ═══════════════════════════════════════════════
; packfile read entry point
; ═══════════════════════════════════════════════

; read-packed-object: read an object from a packfile
; git-dir str, o oid
; returns kind str, data str, ok bool
read-packed-object = (git-dir str, o oid) (kind str, data str, ok bool) {
    ok = false
    pack-path, offset, found-ok = find-pack-object(git-dir, o)
    found-ok == false -> return

    ; read pack data
    pack-data, read-ok = util.read-file-str(pack-path)
    read-ok == false -> return

    ; read object header at offset
    type, size, new-pos, hdr-ok = read-pack-object-header(pack-data, offset)
    hdr-ok == false -> return
    pos = new-pos

    ; handle deltas
    {
        type == 6 -> {

            ; OBJ_OFS_DELTA — TODO: implement delta resolution
            return
        }

        type == 7 -> {

            ; OBJ_REF_DELTA — TODO: implement delta resolution
            return
        }
    }

    ; direct object — decompress
    decompressed, decomp-ok = zlib.zlib-decompress(pack-data[pos..pack-data.len))
    {
        decomp-ok == false -> return

        ; map type to kind
        type == 1 -> kind = 'commit'

        type == 2 -> kind = 'tree'

        type == 3 -> kind = 'blob'

        type == 4 -> kind = 'tag'
    }
    data = decompressed
    ok = true
}
