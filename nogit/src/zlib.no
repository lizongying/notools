; zlib — RFC 1950 zlib (de)compression using std archive/gzip
;
; Git stores every loose object and every pack-object payload as a zlib
; stream: a 2-byte header, raw DEFLATE data, and a 4-byte big-endian Adler-32
; checksum of the uncompressed data.
;
; We use the Nolang standard library `archive/gzip` module which provides
; full DEFLATE compression and decompression. This means:
;   * Objects written by nogit can be read by real git (zlib format is valid)
;   * Objects written by real git can be read by nogit (full DEFLATE support)
;
; The codec operates on *byte-strings* (str with one codepoint per byte 0-255).
; We bridge str <-> []byte via str.to-bytes() and []byte.to-str().

; byte-to-str: wrap a single byte value into a 1-byte string
byte-to-str = (b byte) (s str) {
    buf []byte = with-cap-len(1, 1)
    buf[0] = b
    tb0o = buf.slice(0, 1).to-str()
    tb0v = tb0o: {
        ok -> it
    
        nil || err -> ''
    }
    s = tb0v
}

; adler32: Adler-32 checksum (RFC 1950) of a byte-string
; data str: input bytes (each codepoint 0-255)
; returns sum i64: checksum (masked to 32 bits)
adler32 = (data str) (sum i64) {
    mod = 65521
    a = 1
    b = 0
    i <- [0..data.len-bytes()): {
        a = (a + data.byte(i)) % mod
        b = (b + a) % mod: {
            ok -> it

            -> _
        }
    }
    sum = ((b << 16) | a) & 0xffffffff
}

; zlib-compress: compress raw data into a zlib stream
; data str: uncompressed input bytes
; returns out str: zlib-wrapped stream (header + deflate + adler32)
;
; We construct the zlib stream manually using stored blocks (BTYPE=00).
; This is less compact than dynamic DEFLATE but produces a valid zlib
; stream that real git can read. The format is:
;   - 2-byte zlib header (78 9c)
;   - One or more stored blocks (BFINAL + BTYPE + LEN + NLEN + data)
;   - 4-byte big-endian Adler-32 checksum
zlib-compress = (data str) (out str) {

    ; zlib header: CMF=0x78 (CM=8, CINFO=7), FLG=0x9c (FCHECK, no dict)
    out = '\x78\x9c'

    ; data is split into stored blocks of max 65535 bytes each
    pos = 0
    rem = data.len-bytes()
    !! {
        rem <= 0 -> {

            ; empty data — single empty stored block (BFINAL=1)
            out = out - '\x01\x00\x00\xff\xff'
            break
        }

        ; block size: min(rem, 65535)
        blen i64 = rem
        blen > 65535 -> blen = 65535

        ; block header byte: BFINAL = (rem <= 65535 ? 1 : 0), BTYPE = 00
        bfinal byte = 0
        rem <= 65535 -> bfinal = 1
        hdr byte = bfinal | 0; BTYPE=00 (stored)
        hs str = with-len(1)
        hs = hs.set-byte(0, hdr)
        out = out - hs

        ; LEN (little-endian 16-bit)
        len-lo byte = blen & 0xff
        len-hi byte = (blen >> 8) & 0xff

        ; NLEN = ~LEN (one's complement)
        nlen-lo byte = len-lo ^ 0xff
        nlen-hi byte = len-hi ^ 0xff

        ; write LEN and NLEN
        lb []byte = with-cap-len(4, 4)
        lb[0] = len-lo
        lb[1] = len-hi
        lb[2] = nlen-lo
        lb[3] = nlen-hi
        tb1o = lb.slice(0, 4).to-str()
        tb1v = tb1o: {
            ok -> it
        
            nil || err -> ''
        }
        out = out - tb1v

        ; write data bytes
        blk []byte = with-cap-len(blen, blen)
        i <- [0..blen): {
            bv = data.byte(pos + i)
            v byte = 0
            bv: {
                ok -> v = it

                -> _
            }
            blk[i] = v
        }
        tb2o = blk.slice(0, blen).to-str()
        tb2v = tb2o: {
            ok -> it
        
            nil || err -> ''
        }
        out = out - tb2v

        #{overflow=wrap}
        pos = pos + blen: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        rem = rem - blen: {
            ok -> it

            -> _
        }
        rem <= 0 -> break
    }

    ; Adler-32 checksum (big-endian 4 bytes)
    adler = adler32(data)
    a0 byte = (adler >> 24) & 0xff
    a1 byte = (adler >> 16) & 0xff
    a2 byte = (adler >> 8) & 0xff
    a3 byte = adler & 0xff
    ab []byte = with-cap-len(4, 4)
    ab[0] = a0
    ab[1] = a1
    ab[2] = a2
    ab[3] = a3
    tb3o = ab.slice(0, 4).to-str()
    tb3v = tb3o: {
        ok -> it
    
        nil || err -> ''
    }
    out = out - tb3v
}

; zlib-decompress: decompress a zlib stream
; data str: a zlib stream (e.g. a git loose object file)
; returns out ?str: uncompressed bytes (?str ok), nil on error
;
; Supports both stored blocks (BTYPE=00) and compressed blocks via std gzip.
; First tries the std gzip module; if that fails, falls back to manual
; stored-block decompression.
zlib-decompress = (data str) (out ?str) {
    out = nil
    data.len-bytes() < 6 -> return

    ; Try manual stored-block decompression first (handles our own output)
    stored-out = zlib-decompress-stored(data)
    stored-out: {
        ok -> {
            out = it
            return
        }

        nil -> {
        }

        err -> {
        }
    }

    ; Check if this is a zlib stream (starts with 0x78)
    ; gzip.gzip-decompress expects gzip format (0x1f 0x8b), not zlib (0x78 0x9c).
    ; For zlib format, we skip the 2-byte header and use inflate-decompress
    ; on the raw DEFLATE data. We estimate the output size as 100x the input
    ; (generous upper bound for typical git objects).
    data.byte(0) == 0x78 -> {

        ; zlib format — skip 2-byte header, decompress raw DEFLATE
        #{overflow=wrap}
        deflate-data []byte = with-len(data.len-bytes() - 2)
        i <- [0..data.len-bytes() - 2): {

            #{overflow=wrap}
            deflate-data[i]: {
                ok -> it = data.byte(i + 2)

                -> _
            }
        }

        ; Output-size estimate. NOTE: std gzip.inflate-decompress grows its
        ; result with push() and currently ignores this hint, so raising the
        ; cap cannot truncate output. The bound still documents the intended
        ; ceiling for callers and protects against a future stdlib that does
        ; preallocate out-size bytes. 512 MB keeps real git objects (which may
        ; exceed the old 1 MB cap) working (G-4).
        #{overflow=wrap}
        est-out i64 = data.len-bytes() * 100
        est-out > 536870912 -> est-out = 536870912; cap at 512MB
        est-out < 64 -> est-out = 64; minimum
        decomp-bytes []byte = gzip.inflate-decompress(deflate-data, est-out)
        decomp-bytes.len() == 0 -> {
            out = ''
            return
        }

        tb4o = decomp-bytes.to-str()
        tb4v = tb4o: {
            ok -> it
        
            nil || err -> ''
        }
        out = tb4v
        return
    }

    ; Fall back to std gzip module (for gzip format data)
    data-bytes = data.to-bytes()
    decomp-bytes = gzip.decompress(data-bytes)
    decomp-bytes.len() == 0 -> {

        ; decompression returned empty — could be legitimate empty data
        ; or a failure. Check if the input looks like a valid zlib stream.
        ; A valid zlib stream starts with 0x78 (CMF byte).
        data.byte(0) == 0x78 -> {
            out = ''
        }
        return
    }

    tb5o = decomp-bytes.to-str()
    tb5v = tb5o: {
        ok -> it
    
        nil || err -> ''
    }
    out = tb5v
}

; zlib-decompress-stored: decompress stored-blocks-only zlib stream
; (legacy fallback — used if std gzip module has issues)
; data str: a zlib stream with only BTYPE=00 blocks
; returns out ?str: uncompressed bytes (?str ok), nil on non-stored input
zlib-decompress-stored = (data str) (out ?str) {
    out = nil
    data.len-bytes() < 6 -> return

    ; single pass: extract payload bytes from each stored block
    p = 2
    built = ''
    bad = false
    !! {
        p >= data.len-bytes() -> break
        bfinal = data.byte(p) & 1
        btype = (data.byte(p) >> 1) & 3
        btype != 0 -> bad = true
        bad -> break

        #{overflow=wrap}
        p = p + 1: {
            ok -> it

            -> 0
        }
        len = data.byte(p) | (data.byte(p + 1) << 8)

        #{overflow=wrap}
        p = p + 4: {
            ok -> it

            -> 0
        }
        i <- [0..len): {

            #{overflow=wrap}
            bv = data.byte(p + i)
            bc byte = bv: {
                ok -> it

                -> 0
            }
            bs str = byte-to-str(bc)
            built = built - bs
        }

        #{overflow=wrap}
        p = p + len: {
            ok -> it

            -> 0
        }
        bfinal == 1 -> break
    }
    bad -> return
    out = built
}

; zlib-consumed-stored: calculate consumed bytes for a stored-block-only zlib stream.
; Returns 0 if the stream contains non-stored blocks.
; data str: a zlib stream starting at offset 0
; returns consumed i64: total bytes consumed (including header and Adler-32)
zlib-consumed-stored = (data str) (consumed i64) {
    consumed = 0
    data.len-bytes() < 6 -> return

    ; skip 2-byte zlib header
    p = 2
    !! {
        p >= data.len-bytes() -> return
        bfinal = data.byte(p) & 1
        btype = (data.byte(p) >> 1) & 3
        btype != 0 -> return

        #{overflow=wrap}
        p = p + 1: {
            ok -> it

            -> _
        }
        blk-len = (data.byte(p) & 0xff) | ((data.byte(p + 1) & 0xff) << 8)

        #{overflow=wrap}
        p = p + 4 + blk-len: {
            ok -> it

            -> _
        }
        bfinal == 1 -> break
    }

    ; p now points to the Adler-32 (4 bytes)
    #{overflow=wrap}
    consumed = p + 4: {
        ok -> it

        -> _
    }
}

; zlib-consumed-binary-search: find the consumed length of a zlib stream
; that starts at `start` inside a larger buffer (e.g. a packfile).
;
; LIMITATION (G-5): the std inflate API does not expose how many input bytes
; it consumed, and decompressing a TRUNCATED dynamic-Huffman stream can crash
; the runtime (verified by experiment). We therefore never decompress a
; prefix. Stored-block streams are measured exactly by zlib-consumed-stored.
; For compressed streams we decompress the full remainder once, compute its
; Adler-32, and scan the raw bytes for the big-endian 4-byte trailer; this
; locates the real stream end without re-decompressing truncated input.
;
; data str: the full data buffer
; start i64: offset where the zlib stream begins
; returns consumed i64: total bytes consumed (0 on error)
zlib-consumed-binary-search = (data str, start i64) (consumed i64) {
    consumed = 0

    #{overflow=wrap}
    avail = data.len-bytes() - start: {
        ok -> it

        -> _
    }
    avail < 6 -> return

    sub-full str = util.str-range(data, start, data.len-bytes())

    ; stored blocks: zlib-consumed-stored gives the exact length
    stored-len = zlib-consumed-stored(sub-full)
    stored-len > 0 -> {
        consumed = stored-len
        return
    }

    ; compressed blocks: verify the trailing Adler-32 of the full stream
    full-opt = zlib-decompress(sub-full)
    full-out str = ''
    full-opt: {
        ok -> full-out = it

        -> return
    }
    expected = adler32(full-out)
    b0 = (expected >> 24) & 255
    b1 = (expected >> 16) & 255
    b2 = (expected >> 8) & 255
    b3 = expected & 255

    ; First 4-byte match from the earliest plausible trailer position is
    ; the end of this stream (a coincidental match is ~1 in 2^32 per byte).
    e = start + 6: {
        ok -> it

        -> _
    }
    !! {
        #{overflow=wrap}
        e4 = e + 4: {
            ok -> it

            -> _
        }
        e4 > data.len-bytes() -> break

        #{overflow=wrap}
        e1 = e + 1: {
            ok -> it

            -> _
        }
        #{overflow=wrap}
        e2 = e + 2: {
            ok -> it

            -> _
        }
        #{overflow=wrap}
        e3 = e + 3: {
            ok -> it

            -> _
        }
        hit = data.byte(e) == b0 && data.byte(e1) == b1 && data.byte(e2) == b2 && data.byte(e3) == b3
        hit -> {
            #{overflow=wrap}
            consumed = e4 - start: {
                ok -> it

                -> _
            }
            return
        }
        e = e1
    }

    ; FALLBACK: no verifiable trailer. The old code returned a lower bound
    ; that desynchronised the pack scanner. Consuming the rest of the buffer
    ; stops scanning cleanly instead of misparsing following objects.
    consumed = avail
}
