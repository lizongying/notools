; object — Git object model: blob / tree / commit / tag
;
; Encodes and decodes the four object kinds and implements loose-object
; storage (the .git/objects/<aa>/<bbbb...> zlib stream). Object identity is a
; SHA-1 over "<type> <size>\0<payload>" (see oid.no).
;
; Design notes:
;   * tree is stored as a single sorted byte-string `raw` (Git's exact on-disk
;     tree format: "<octal-mode> <name>\0<20 raw id bytes>" per entry) plus a
;     scalar `n` count.
;   * commit parents are stored as a concatenated 40-char-hex string
;     parenthex with an explicit nparents count.
;   * parse commit/tag headers line-by-line over a byte-string.
;   * carry all Git bytes as `str` (one codepoint per byte 0-255).

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/zlib

; ═══════════════════════════════════════════════
; value types
; ═══════════════════════════════════════════════

; tree: a Git tree stored as a single sorted byte-string (Git's exact on-disk
; tree format) plus a scalar entry count. Each entry in `raw` is:
;   "<octal-mode> <name>\0<20 raw id bytes>"
; Entries are kept sorted by base_name_compare at all times.
tree {
    raw str
    n i64
}

person-info {
    name str
    email str
    time i64
    tz str
}

commit-info {
    tree-oid oid
    parenthex str
    nparents i64
    author person-info
    committer person-info
    message str
}

; concatenated 40-char hex of each parent (no []oid)

tag-info {
    object oid
    obj-type str
    tag str
    tagger person-info
    message str
}

; ═══════════════════════════════════════════════
; octal helpers (git stores modes as octal text)
; ═══════════════════════════════════════════════

i64-to-octal = (n i64) (out str) {
    {
        n == 0 -> {
            out = '0'
            return
        }
    }
    tmp []byte = with-cap(16)
    x = n
    {
        tmp.push(48 + (x % 8))
        x = x / 8
        x == 0 -> break
    } (true)

    ; Concat-return so the result is safe wherever it is used.
    out = ''
    L = tmp.len
    i <- [0..L): {
        cb str = with-len(1)
        cb[0] = tmp[L - 1 - i]
        out = out - cb
    }
}

octal-to-i64 = (s str) (out i64) {
    out = 0
    i <- [0..s.len): {
        out = out * 8 + (s[i] - 48)
    }
}

mode-is-dir = (m i64) (yes bool) {
    yes = m == 16384
}

; ═══════════════════════════════════════════════
; tree builder + base_name_compare
; ═══════════════════════════════════════════════

; id-bytes: build a 20-byte string from an oid's raw bytes. Concat-return.
id-bytes = (id oid) (out str) {
    out = ''
    k <- [0..20): {
        cb str = with-len(1)
        cb[0] = id.id[k]
        out = out - cb
    }
}

; name-cmp: git's base_name_compare with the '/' rule for directories.
; (na,adir) is the candidate; (nb,bdir) is the existing entry.
name-cmp = (na str, adir bool, nb str, bdir bool) (r i64) {
    la = na.len
    lb = nb.len
    len = la
    lb < len -> len = lb
    r = 0
    i = 0
    {
        i < len -> {
            ca = na[i]
            cb = nb[i]
            ca < cb -> {
                r = -1
                return
            }
            ca > cb -> {
                r = 1
                return
            }
            i = i + 1
        }
    } (i < len)
    ca = 0
    cb = 0
    {
        la > len -> ca = na[len]

        lb > len -> cb = nb[len]

        ca == 0 && adir == true -> ca = 47

        cb == 0 && bdir == true -> cb = 47

        ca < cb -> r = -1

        ca > cb -> r = 1
    }
}

; tree-insert-offset: offset in raw where a new (mode,name) entry belongs so
; that raw stays sorted by base_name_compare.
tree-insert-offset = (raw str, mode i64, name str) (off i64) {
    off = raw.len
    pos = 0
    adir = mode == 16384
    {
        pos >= raw.len -> break
        sp = util.find-byte-str(raw, 32, pos)
        sp < 0 -> break
        nl = util.find-byte-str(raw, 0, sp + 1)
        nl < 0 -> break
        emode = octal-to-i64(raw[pos..sp))
        name-start = sp + 1
        ename = raw[name-start..nl)
        bdir = emode == 16384
        c = name-cmp(name, adir, ename, bdir)
        c <= 0 -> {
            off = pos
            break
        }
        pos = nl + 21
    } (true)
}

; tree-entry-at: locate entry i in raw, returning its start/space/nul offsets.
tree-entry-at = (raw str, i i64) (off i64, sp i64, nl i64) {
    off = 0
    k = 0
    {
        k >= i -> break
        s = util.find-byte-str(raw, 32, off)
        s < 0 -> break
        n = util.find-byte-str(raw, 0, s + 1)
        n < 0 -> break
        off = n + 21
        k = k + 1
    } (k < i)
    sp = util.find-byte-str(raw, 32, off)
    nl = util.find-byte-str(raw, 0, sp + 1)
}

; tree-name: the name byte-string of entry i
tree-name = (t tree, i i64) (s str) {
    off i64
    sp i64
    nl i64
    off, sp, nl = tree-entry-at(t.raw, i)
    s = util.str-range(t.raw, sp + 1, nl)
}

; tree-mode: the octal mode of entry i
tree-mode = (t tree, i i64) (m i64) {
    off i64
    sp i64
    nl i64
    off, sp, nl = tree-entry-at(t.raw, i)
    m = octal-to-i64(util.str-range(t.raw, off, sp))
}

; tree-id: the object id of entry i
tree-id = (t tree, i i64) (o oid) {
    off i64
    sp i64
    nl i64
    off, sp, nl = tree-entry-at(t.raw, i)
    tmp oid
    k <- [0..20): {
        tmp.id[k] = t.raw[nl + 1 + k]
    }
    o = tmp
}

; ═══════════════════════════════════════════════
; Tree API
;
; The tree's bytes travel as a plain top-level `str`, and these wrappers
; rebuild a local `tree` internally.
; ═══════════════════════════════════════════════

; tree-count-raw: number of entries in a raw tree byte-string
tree-count-raw = (raw str) (n i64) {
    n = 0
    pos = 0
    {
        pos >= raw.len -> break
        sp = util.find-byte-str(raw, 32, pos)
        sp < 0 -> break
        nl = util.find-byte-str(raw, 0, sp + 1)
        nl < 0 -> break
        pos = nl + 21
        n = n + 1
    } (true)
}

; tree-add-raw: append an entry to a raw tree string; returns the new raw str.
tree-add-raw = (raw str, mode i64, name str, id oid) (out str) {
    oct = i64-to-octal(mode)
    ib = id-bytes(id)
    nul str = '\0'
    e = oct - ' ' - name - nul - ib
    curlen = raw.len
    {
        curlen == 0 -> {
            out = e
        }

        -> {
            ins = tree-insert-offset(raw, mode, name)
            ins == 0 -> {
                out = e - raw
            }
            ins == curlen -> {
                out = raw - e
            }
            left str = util.str-range(raw, 0, ins)
            right str = util.str-range(raw, ins, raw.len)
            out = left - e - right
        }
    }
}

; tree-write-raw: store a raw tree; returns its oid
tree-write-raw = (git-dir str, raw str) (o oid) {
    o = write-loose(git-dir, 'tree', raw)
}

; build-tree-from-flat: build a proper nested tree from flat index entries.
; Index entries have full paths like "dir/sub/file.txt". We need to create
; subtree objects for each directory level.
;
; git-dir str, paths str (newline-separated), hexoids str (40-char each),
; modes-str str (newline-separated decimal mode strings), count i64
; returns root-oid oid, ok bool
build-tree-from-flat = (git-dir str, paths str, hexoids str, modes-str str, count i64) (root-oid oid, ok bool) {
    ok = false

    ; We build the tree recursively. For the root level, we collect all
    ; entries that have no '/' (files at root) and all entries that start
    ; with a directory prefix (first segment before '/').
    ;
    ; For each directory, we recursively build its subtree.

    ; Collect the root-level entries
    root-raw str = ''
    name-pos = 0
    mode-pos = 0

    ; First pass: add all root-level files (no '/' in path)
    i <- [0..count): {
        ; extract name i
        nl = util.find-byte-str(paths, 10, name-pos)
        nl-end = paths.len
        nl >= 0 -> nl-end = nl
        nm = util.str-range(paths, name-pos, nl-end)

        ; extract mode i
        mnl = util.find-byte-str(modes-str, 10, mode-pos)
        mnl-end = modes-str.len
        mnl >= 0 -> mnl-end = mnl
        ms = util.str-range(modes-str, mode-pos, mnl-end)

        ; parse mode
        mode-val i64 = 0
        k <- [0..ms.len): {
            mode-val = mode-val * 10 + (ms[k] - 48)
        }

        ; extract oid i
        hx = util.str-range(hexoids, i * 40, i * 40 + 40)
        entry-oid oid
        k <- [0..20): {
            c0 = hx[k * 2]
            c1 = hx[k * 2 + 1]
            hi = util.hexdigit(c0)
            lo = util.hexdigit(c1)
            entry-oid.id[k] = (hi << 4) | lo
        }

        ; check if this is a root-level file (no '/')
        slash-pos = util.find-byte-str(nm, 47, 0)
        slash-pos < 0 -> {
            ; root-level file — add directly
            root-raw = tree-add-raw(root-raw, mode-val, nm, entry-oid)
        }

        name-pos = nl + 1
        mode-pos = mnl + 1
    }

    ; Second pass: collect directory prefixes and build subtrees
    ; We need to find unique directory prefixes (first segment before '/')
    ; and for each, recursively build the subtree from entries under that prefix.
    ;
    ; To avoid duplicates, we track seen directory names.
    seen-dirs str = ''

    name-pos = 0
    mode-pos = 0
    i2 <- [0..count): {
        ; extract name i2
        nl = util.find-byte-str(paths, 10, name-pos)
        nl-end = paths.len
        nl >= 0 -> nl-end = nl
        nm = util.str-range(paths, name-pos, nl-end)

        ; check if this path has a '/'
        slash-pos = util.find-byte-str(nm, 47, 0)
        slash-pos >= 0 -> {
            ; extract directory prefix (first segment)
            dir-name = util.str-range(nm, 0, slash-pos)

            ; check if we've already processed this directory
            already-seen = false
            seen-pos = 0
            {
                seen-pos >= seen-dirs.len -> break
                seen-nl = util.find-byte-str(seen-dirs, 10, seen-pos)
                seen-end = seen-dirs.len
                seen-nl >= 0 -> seen-end = seen-nl
                seen-name = util.str-range(seen-dirs, seen-pos, seen-end)
                same = util.str-eq(seen-name, dir-name)
                same == true -> {
                    already-seen = true
                    break
                }
                seen-pos = seen-nl + 1
                seen-nl < 0 -> break
            } (true)

            already-seen == false -> {
                ; mark as seen
                seen-dirs = seen-dirs - dir-name - '\n'

                ; collect all entries under this directory
                sub-paths = ''
                sub-hexoids = ''
                sub-modes = ''
                sub-count i64 = 0

                sub-name-pos = 0
                sub-mode-pos = 0
                j <- [0..count): {
                    ; extract name j
                    snl = util.find-byte-str(paths, 10, sub-name-pos)
                    snl-end = paths.len
                    snl >= 0 -> snl-end = snl
                    snm = util.str-range(paths, sub-name-pos, snl-end)

                    ; extract mode j
                    smnl = util.find-byte-str(modes-str, 10, sub-mode-pos)
                    smnl-end = modes-str.len
                    smnl >= 0 -> smnl-end = smnl
                    sms = util.str-range(modes-str, sub-mode-pos, smnl-end)

                    ; check if this path starts with dir-name + '/'
                    prefix = dir-name - '/'
                    snm.starts-with(prefix) -> {
                        ; extract the sub-path (strip dir-name + '/' prefix)
                        sub-path = util.str-range(snm, slash-pos + 1, snm.len)

                        sub-paths = sub-paths - sub-path - '\n'

                        ; extract oid j
                        shx = util.str-range(hexoids, j * 40, j * 40 + 40)
                        sub-hexoids = sub-hexoids - shx

                        sub-modes = sub-modes - sms - '\n'
                        sub-count = sub-count + 1
                    }

                    sub-name-pos = snl + 1
                    sub-mode-pos = smnl + 1
                    snl < 0 -> break
                }

                ; recursively build subtree
                sub-oid, sub-ok = build-tree-from-flat(git-dir, sub-paths, sub-hexoids, sub-modes, sub-count)
                sub-ok == true -> {
                    ; add the subtree entry to root-raw
                    root-raw = tree-add-raw(root-raw, 16384, dir-name, sub-oid)
                }
            }
        }

        name-pos = nl + 1
        mode-pos = 0
        ; re-scan mode-pos for i2 (since we're using a separate loop)
        k2 <- [0..i2): {
            kmnl = util.find-byte-str(modes-str, 10, mode-pos)
            mode-pos = kmnl + 1
        }
    }

    ; store the root tree
    root-oid = tree-write-raw(git-dir, root-raw)
    ok = true
}

; tree-read-raw: read a tree object's raw bytes (top-level str)
tree-read-raw = (git-dir str, o oid) (raw str, ok bool) {
    k str
    d str
    ok2 bool
    k, d, ok2 = read-loose(git-dir, o)
    {
        ok2 == false -> {
            ok = false
            return
        }
    }
    raw = d
    ok = true
}

; tree-name-raw / tree-mode-raw / tree-id-raw: access entry i of a raw tree
; NOTE: inlined tree-entry-at logic to avoid struct field corruption bug
; in the Nolang compiler when creating a local tree struct and passing it
; to another function that does cross-module calls on the str field.
tree-name-raw = (raw str, i i64) (s str) {
    off i64 = 0
    k = 0
    {
        k >= i -> break
        sp0 = util.find-byte-str(raw, 32, off)
        nl0 = util.find-byte-str(raw, 0, sp0 + 1)
        off = nl0 + 21
        k = k + 1
    } (k < i)
    sp = util.find-byte-str(raw, 32, off)
    nl = util.find-byte-str(raw, 0, sp + 1)
    s = util.str-range(raw, sp + 1, nl)
}

tree-mode-raw = (raw str, i i64) (m i64) {
    off i64 = 0
    k = 0
    {
        k >= i -> break
        sp0 = util.find-byte-str(raw, 32, off)
        nl0 = util.find-byte-str(raw, 0, sp0 + 1)
        off = nl0 + 21
        k = k + 1
    } (k < i)
    sp = util.find-byte-str(raw, 32, off)
    ms = util.str-range(raw, off, sp)
    m = octal-to-i64(ms)
}

tree-id-raw = (raw str, i i64) (o oid) {
    off i64 = 0
    k = 0
    {
        k >= i -> break
        sp0 = util.find-byte-str(raw, 32, off)
        nl0 = util.find-byte-str(raw, 0, sp0 + 1)
        off = nl0 + 21
        k = k + 1
    } (k < i)
    sp = util.find-byte-str(raw, 32, off)
    nl = util.find-byte-str(raw, 0, sp + 1)
    tmp oid
    j <- [0..20): {
        tmp.id[j] = raw[nl + 1 + j]
    }
    o = tmp
}

; ═══════════════════════════════════════════════
; tree encode / decode
; ═══════════════════════════════════════════════

; tree-encode: return the sorted raw tree bytes. raw is already kept sorted by
; base_name_compare at all times, so this is just an accessor.
tree-encode = (t tree) (out str) {
    out = t.raw
}

; ═══════════════════════════════════════════════
; person line encode / decode
; ═══════════════════════════════════════════════

person-line = (role str, p person-info) (out str) {
    ts str = util.i64-to-str(p.time)
    out = role - ' ' - p.name - ' <' - p.email - '> ' - ts - ' ' - p.tz
}

; parse-person-fields: parse "Name <email> 1234567890 +0000" returning the
; parts as top-level scalars/strings (a struct return would lose the `str`
; fields, so we return them individually).
parse-person-fields = (s str) (name str, email str, time i64, tz str) {
    lt i64 = s.index('<')
    gt i64 = s.index('>')
    nm str = util.str-range(s, 0, lt)
    {
        nm.len > 0 -> {
            nm[nm.len - 1] == 32 -> nm = util.str-range(nm, 0, nm.len - 1)
        }
    }
    name = nm
    email = util.str-range(s, lt + 1, gt)
    rest str = util.str-range(s, gt + 1, s.len)
    ; skip leading space(s) in rest
    rpos i64 = 0
    {
        rpos < rest.len -> {
            rest[rpos] == 32 -> rpos = rpos + 1

            -> break
        }
    } (true)
    rest = util.str-range(rest, rpos, rest.len)
    sp i64 = util.find-byte-str(rest, 32, 0)
    sp < 0 -> sp = rest.len
    ts str = util.str-range(rest, 0, sp)
    ti ?i64 = ts.to-i64()
    ti: {
        ok -> time = it

        nil ->

        err ->
    }
    tz = util.str-range(rest, sp + 1, rest.len)
}

; ═══════════════════════════════════════════════
; commit encode / decode
; ═══════════════════════════════════════════════

commit-encode = (c commit-info) (out str) {
    tid oid = c.tree-oid
    th str = oid.oid-hex-str(tid)
    nl str = '\n'
    s = 'tree ' - th - nl
    ; copy parenthex to local var to avoid struct field access bug in loops
    phx str = c.parenthex
    off i64 = 0
    {
        off >= phx.len -> break
        ph str = util.str-range(phx, off, off + 40)
        s = s - 'parent ' - ph - nl
        off = off + 40
    } (true)
    al str = person-line('author', c.author)
    s = s - al - nl
    cl str = person-line('committer', c.committer)
    s = s - cl - nl - nl - c.message
    out = s
}

; ═══════════════════════════════════════════════
; tag encode / decode
; ═══════════════════════════════════════════════

tag-encode = (t tag-info) (out str) {
    tobj oid = t.object
    oh str = oid.oid-hex-str(tobj)
    nl str = '\n'
    s = 'object ' - oh - nl
    s = s - 'type ' - t.obj-type - nl
    s = s - 'tag ' - t.tag - nl
    tl str = person-line('tagger', t.tagger)
    s = s - tl - nl - nl - t.message
    out = s
}

; ═══════════════════════════════════════════════
; loose object write / read
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; zlib stored-block codec — uses git/src/zlib module functions
; (zlib-compress / zlib-decompress) instead of inlined code.
; ═══════════════════════════════════════════════

; hex-char: render one byte as a 2-char lowercase hex string.
hex-char = (b byte) (s str) {
    hc = '0123456789abcdef'
    hi = (b >> 4) & 15
    lo = b & 15
    s str = with-len(2)
    s[0] = hc[hi]
    s[1] = hc[lo]
}

; object-path: <git-dir>/objects/<aa>/<bbbb...> path string.
; hex-char takes ONE oid byte and emits 2 hex chars, so the dir is byte[0]
; (2 hex) and the file is bytes [1..20) (19 bytes -> 38 hex).
object-path = (git-dir str, o oid) (out str) {
    out = git-dir - '/objects/'
    out = out - hex-char(o.id[0])
    sl str = '/'
    out = out - sl
    i <- [1..20): {
        out = out - hex-char(o.id[i])
    }
}

; object-dir: <git-dir>/objects/<aa> — parent dir passed to util.mkdir-all.
object-dir = (git-dir str, o oid) (out str) {
    out = git-dir - '/objects/'
    out = out - hex-char(o.id[0])
}

; write-loose: hash, compress and store a loose object; returns its oid.
; data str: payload as a byte-string (each codepoint 0-255).
write-loose = (git-dir str, kind str, data str) (o oid) {
    o = oid.hash-object(kind, data)
    dir str = object-dir(git-dir, o)
    util.mkdir-all(dir)
    f str = object-path(git-dir, o)
    hdr = oid.object-header(kind, data.len)
    full str = with-len(hdr.len + data.len)
    i <- [0..hdr.len): {
        full[i] = hdr[i]
    }
    i <- [0..data.len): {
        full[hdr.len + i] = data[i]
    }
    comp str = zlib.zlib-compress(full)

    ; Write the compressed object to file.
    fd = fs.open-write(f)
    fs.write(fd, comp, comp.len)
    fs.close(fd)
}

; write-blob: store a blob whose content is a byte-string
write-blob = (git-dir str, content str) (o oid) {
    o = write-loose(git-dir, 'blob', content)
}

; write-tree: encode and store a tree (already sorted in raw)
write-tree = (git-dir str, t tree) (o oid) {
    o = write-loose(git-dir, 'tree', t.raw)
}

; write-commit: encode and store a commit
write-commit = (git-dir str, c commit-info) (o oid) {
    enc = commit-encode(c)
    o = write-loose(git-dir, 'commit', enc)
}

; write-tag: encode and store an annotated tag
write-tag = (git-dir str, t tag-info) (o oid) {
    enc = tag-encode(t)
    o = write-loose(git-dir, 'tag', enc)
}

; read-file-bytes: read an entire file into a proper nolang `str` whose `.len`
; is correct and whose codepoints ARE the raw file bytes. `fs.read-file` returns
; a correct `%str` (verified); we gate on `fs.is-file` so a missing object is
; reported as ok=false rather than an empty read.
read-file-bytes = (p str) (content str, ok bool) {
    isf = fs.is-file(p)
    {
        isf == false -> {
            content = ''
            ok = false
            return
        }
    }
    content = fs.read-file(p)
    ok = true
}

; read-loose: read a loose object; ok=false if absent or corrupt.
; data str: payload returned as a byte-string (each codepoint 0-255).
;
; `rf` is a proper str from fs.read-file; zlib.zlib-decompress handles
; decompression. The returned kind/data are concat strings that survive
; any module boundary.
;
; Bug 18 workaround: the first cross-module call to zlib.zlib-decompress
; can return wrong results due to a Nolang compiler bug. We perform a
; warmup call with a tiny known zlib stream to prime the function before
; doing the real decompression.
read-loose = (git-dir str, o oid) (kind str, data str, ok bool) {
    ok = false
    f str = object-path(git-dir, o)
    isf = fs.is-file(f)
    isf == false -> return
    rf str = fs.read-file(f)
    {
        rf.len == 0 -> return

        rf.len < 6 -> return
    }

    ; Bug 18 warmup: prime zlib.zlib-decompress with a known-good stream
    ; This is a valid zlib-compressed empty string:
    ;   78 9c      = zlib header (CM=8, CINFO=7, FCHECK)
    ;   01         = BFINAL=1, BTYPE=00 (stored)
    ;   00 00      = LEN=0
    ;   ff ff      = NLEN=~0
    ;   00 01 00 01 = Adler-32 of empty data (a=1, b=0 → 0x00010001)
    warmup-data str = with-len(11)
    warmup-data[0] = 0x78
    warmup-data[1] = 0x9c
    warmup-data[2] = 0x01
    warmup-data[3] = 0x00
    warmup-data[4] = 0x00
    warmup-data[5] = 0xff
    warmup-data[6] = 0xff
    warmup-data[7] = 0x00
    warmup-data[8] = 0x01
    warmup-data[9] = 0x00
    warmup-data[10] = 0x01
    _w-out str
    _w-ok bool
    _w-out, _w-ok = zlib.zlib-decompress(warmup-data)

    out str
    dec-ok bool
    out, dec-ok = zlib.zlib-decompress(rf)
    dec-ok == false -> return
    sp i64 = util.find-byte-str(out, 32, 0)
    sp < 0 -> return
    kind = util.str-range(out, 0, sp)
    nul i64 = util.find-byte-str(out, 0, sp + 1)
    nul < 0 -> return
    start = nul + 1
    data = util.str-range(out, start, out.len)
    ok = true
}

; ═══════════════════════════════════════════════
; Commit / tag API
;
; The caller passes the individual scalar/str/oid fields and receives either
; an oid (for writes) or the individual scalar/str/oid fields (for reads).
; ═══════════════════════════════════════════════

; write-commit-full: encode + store a commit from its parts; returns its oid
write-commit-full = (git-dir str, tree-oid oid, parenthex str, a-name str, a-email str, a-time i64, a-tz str, c-name str, c-email str, c-time i64, c-tz str, message str) (o oid) {
    c = commit-info {
        tree-oid: tree-oid
        parenthex: parenthex
        nparents: parenthex.len / 40
        author: person-info {
            name: a-name
            email: a-email
            time: a-time
            tz: a-tz
        }
        committer: person-info {
            name: c-name
            email: c-email
            time: c-time
            tz: c-tz
        }
        message: message
    }
    o = write-commit(git-dir, c)
}

; read-commit-full: read + decode a commit; returns its parts individually.
read-commit-full = (git-dir str, o oid) (tree-oid oid, parenthex str, a-name str, a-email str, a-time i64, a-tz str, c-name str, c-email str, c-time i64, c-tz str, message str, ok bool) {
    k str
    d str
    ok2 bool
    k, d, ok2 = read-loose(git-dir, o)
    {
        ok2 == false -> {
            ok = false
            return
        }
    }
    text str = d
    idx i64 = text.index('\n\n')
    hend = text.len
    idx >= 0 -> hend = idx
    message = ''
    idx >= 0 -> message = util.str-range(text, idx + 2, text.len)
    tree-oid = oid.zero-oid()
    parenthex = ''
    a-name = ''
    a-email = ''
    a-time = 0
    a-tz = ''
    c-name = ''
    c-email = ''
    c-time = 0
    c-tz = ''
    pos = 0
    {
        pos >= hend -> break
        nl i64 = util.find-byte-str(text, 10, pos)
        nl < 0 -> nl = hend
        line str = util.str-range(text, pos, nl)
        line.starts-with('tree ') -> {
            hx str = util.str-range(line, 5, line.len)
            toid, tok = oid.oid-from-hex(hx)
            tok == true -> tree-oid = toid
        }
        line.starts-with('parent ') -> {
            hx2 str = util.str-range(line, 7, line.len)
            parenthex = parenthex - hx2
        }
        line.starts-with('author ') -> {
            ap str = util.str-range(line, 7, line.len)
            a-name, a-email, a-time, a-tz = parse-person-fields(ap)
        }
        line.starts-with('committer ') -> {
            cp str = util.str-range(line, 10, line.len)
            c-name, c-email, c-time, c-tz = parse-person-fields(cp)
        }
        pos = nl + 1
    } (true)
    ok = true
}

; parse-commit-from-data: parse commit data string into fields
; data str: commit object payload (no header)
; returns tree-oid oid, parenthex str, a-name str, a-email str, a-time i64, a-tz str,
;   c-name str, c-email str, c-time i64, c-tz str, message str, ok bool
parse-commit-from-data = (d str) (tree-oid oid, parenthex str, a-name str, a-email str, a-time i64, a-tz str, c-name str, c-email str, c-time i64, c-tz str, message str, ok bool) {
    text str = d
    idx i64 = text.index('\n\n')
    hend = text.len
    idx >= 0 -> hend = idx
    message = ''
    idx >= 0 -> message = util.str-range(text, idx + 2, text.len)
    tree-oid = oid.zero-oid()
    parenthex = ''
    a-name = ''
    a-email = ''
    a-time = 0
    a-tz = ''
    c-name = ''
    c-email = ''
    c-time = 0
    c-tz = ''
    pos = 0
    {
        pos >= hend -> break
        nl i64 = util.find-byte-str(text, 10, pos)
        nl < 0 -> nl = hend
        line str = util.str-range(text, pos, nl)
        line.starts-with('tree ') -> {
            hx str = util.str-range(line, 5, line.len)
            toid, tok = oid.oid-from-hex(hx)
            tok == true -> tree-oid = toid
        }
        line.starts-with('parent ') -> {
            hx2 str = util.str-range(line, 7, line.len)
            parenthex = parenthex - hx2
        }
        line.starts-with('author ') -> {
            ap str = util.str-range(line, 7, line.len)
            a-name, a-email, a-time, a-tz = parse-person-fields(ap)
        }
        line.starts-with('committer ') -> {
            cp str = util.str-range(line, 10, line.len)
            c-name, c-email, c-time, c-tz = parse-person-fields(cp)
        }
        pos = nl + 1
    } (true)
    ok = true
}

; write-tag-full: encode + store an annotated tag from its parts; returns oid
write-tag-full = (git-dir str, obj oid, obj-type str, tag str, t-name str, t-email str, t-time i64, t-tz str, message str) (o oid) {
    tg = tag-info {
        object: obj
        obj-type: obj-type
        tag: tag
        tagger: person-info {
            name: t-name
            email: t-email
            time: t-time
            tz: t-tz
        }
        message: message
    }
    o = write-tag(git-dir, tg)
}

; read-tag-full: read + decode a tag; returns its parts individually.
read-tag-full = (git-dir str, o oid) (obj oid, obj-type str, tag str, t-name str, t-email str, t-time i64, t-tz str, message str, ok bool) {
    k str
    d str
    ok2 bool
    k, d, ok2 = read-loose(git-dir, o)
    {
        ok2 == false -> {
            ok = false
            return
        }
    }
    text str = d
    idx i64 = text.index('\n\n')
    hend = text.len
    idx >= 0 -> hend = idx
    message = ''
    idx >= 0 -> message = util.str-range(text, idx + 2, text.len)
    obj = oid.zero-oid()
    obj-type = ''
    tag = ''
    t-name = ''
    t-email = ''
    t-time = 0
    t-tz = ''
    pos = 0
    {
        pos >= hend -> break
        nl i64 = util.find-byte-str(text, 10, pos)
        nl < 0 -> nl = hend
        line str = util.str-range(text, pos, nl)
        line.starts-with('object ') -> {
            hx str = util.str-range(line, 7, line.len)
            tobj, took = oid.oid-from-hex(hx)
            took == true -> obj = tobj
        }
        line.starts-with('type ') -> {
            obj-type = util.str-range(line, 5, line.len)
        }
        line.starts-with('tag ') -> {
            tag = util.str-range(line, 4, line.len)
        }
        line.starts-with('tagger ') -> {
            gp str = util.str-range(line, 7, line.len)
            t-name, t-email, t-time, t-tz = parse-person-fields(gp)
        }
        pos = nl + 1
    } (true)
    ok = true
}

; object-roundtrip-test: full write+read round trip for blob, tree, commit and
; tag. Validation uses oid.eq (struct compare) and util.str-eq (byte compare).
; Returns true only if every round trip reproduces the original bytes.
object-roundtrip-test = (git-dir str) (ok bool) {

    ; --- blob round trip ---
    b = write-blob(git-dir, 'hello')
    bk str
    bd str
    bok bool
    bk, bd, bok = read-loose(git-dir, b)
    ok = bok
    ok = ok && util.str-eq(bd, 'hello')
    ok = ok && util.str-eq(bk, 'blob')
    ob i64 = 0
    ok == true -> ob = 1

    ; --- tree round trip ---
    traw = tree-add-raw('', 33188, 'hello.txt', b)
    tid = tree-write-raw(git-dir, traw)
    back, tok = tree-read-raw(git-dir, tid)
    ok = ok && tok
    n = tree-count-raw(back)
    ok = ok && (n == 1)
    m = tree-mode-raw(back, 0)
    ok = ok && (m == 33188)
    nm = tree-name-raw(back, 0)
    ok = ok && util.str-eq(nm, 'hello.txt')
    id0 = tree-id-raw(back, 0)
    ok = ok && oid.eq(id0, b)

    ; --- commit round trip ---
    oc = write-commit-full(git-dir, tid, '', 'An', 'ae', 1112911993, '+0000', 'Cn', 'ce', 1112911993, '+0000', 'msg')
    ct, cph, can, cae, cat, caz, ccn, cce, cct, ccz, cm, cok = read-commit-full(git-dir, oc)
    ok = ok && cok
    ok = ok && util.str-eq(can, 'An')
    ok = ok && util.str-eq(cm, 'msg')

    ; --- tag round trip ---
    otg = write-tag-full(git-dir, b, 'blob', 'v0', 'Tn', 'te', 1112911993, '+0000', 'tm')
    to, tty, tt, tnm, tem, ttm, ttz, tmsg, tag-ok = read-tag-full(git-dir, otg)
    ok = ok && tag-ok
    ok = ok && util.str-eq(tt, 'v0')
    ok = ok && util.str-eq(tmsg, 'tm')
}

; tree-to-flat: recursively walk a tree and produce flat index arrays.
; Recursively reads subtrees, producing paths like "dir/sub/file.txt".
;
; git-dir str, tree-oid oid, prefix str (path prefix for entries in this subtree)
; returns paths str (newline-sep), hexoids str (40-char each), modes str (newline-sep),
;         count i64, ok bool
tree-to-flat = (git-dir str, tree-oid oid, prefix str) (paths str, hexoids str, modes str, count i64, ok bool) {
    ok = false
    paths = ''
    hexoids = ''
    modes = ''
    count = 0

    ; read tree object
    kind str
    raw str
    read-ok bool
    kind, raw, read-ok = read-loose(git-dir, tree-oid)
    read-ok == false -> return

    ; parse tree entries
    n = tree-count-raw(raw)
    i <- [0..n): {
        mode = tree-mode-raw(raw, i)
        nm = tree-name-raw(raw, i)
        entry-oid = tree-id-raw(raw, i)
        entry-hex = oid.oid-hex-str(entry-oid)

        ; build full path: prefix/nm or just nm if prefix is empty
        full-path = nm
        prefix.len > 0 -> {
            full-path = prefix - '/' - nm
        }

        mode == 16384 -> {
            ; subtree — recurse
            sub-paths, sub-hexoids, sub-modes, sub-count, sub-ok = tree-to-flat(git-dir, entry-oid, full-path)
            sub-ok == true -> {
                paths = paths - sub-paths
                hexoids = hexoids - sub-hexoids
                modes = modes - sub-modes
                count = count + sub-count
            }
        }

        -> {
            ; blob or other — add as flat entry
            paths = paths - full-path - '\n'
            hexoids = hexoids - entry-hex
            mode-str = util.i64-to-str(mode)
            modes = modes - mode-str - '\n'
            count = count + 1
        }
    }
    ok = true
}

; checkout-tree: recursively write tree contents to the working directory.
; This reads a tree object, and for each entry:
;   - if it's a blob (mode != 16384), write the blob content to a file
;   - if it's a subtree (mode == 16384), recursively checkout the subtree
;
; git-dir str, tree-oid oid, dest-dir str (path to write files into)
; returns ok bool
checkout-tree = (git-dir str, tree-oid oid, dest-dir str) (ok bool) {
    ok = false

    ; read tree object
    kind str
    raw str
    read-ok bool
    kind, raw, read-ok = read-loose(git-dir, tree-oid)
    read-ok == false -> return

    ; parse tree entries
    n = tree-count-raw(raw)
    i <- [0..n): {
        mode = tree-mode-raw(raw, i)
        nm = tree-name-raw(raw, i)
        entry-oid = tree-id-raw(raw, i)

        ; build full path: dest-dir/nm
        full-path = dest-dir
        dest-dir.len > 0 -> {
            last = dest-dir[dest-dir.len - 1]
            last != 47 -> full-path = dest-dir - '/' - nm
        }
        dest-dir.len == 0 -> full-path = nm

        mode == 16384 -> {
            ; subtree — create directory and recurse
            util.mkdir-all(full-path)
            sub-ok = checkout-tree(git-dir, entry-oid, full-path)
        }

        -> {
            ; blob — read object and write to file
            b-kind str
            b-data str
            b-ok bool
            b-kind, b-data, b-ok = read-loose(git-dir, entry-oid)
            b-ok == true -> {
                ; ensure parent directory exists
                slash = full-path.rindex('/')
                slash >= 0 -> {
                    parent = util.str-range(full-path, 0, slash)
                    util.mkdir-all(parent)
                }
                util.write-file-simple(full-path, b-data)
            }
        }
    }
    ok = true
}

; remove-stale-files: remove files in the working directory that are NOT in the
; target tree. This is called before checkout-tree to clean up files that were
; tracked in the old HEAD but are not in the new HEAD.
;
; git-dir str, tree-oid oid, dest-dir str (work tree root)
; returns ok bool
remove-stale-files = (git-dir str, tree-oid oid, dest-dir str) (ok bool) {
    ok = true

    ; get flat file list from the target tree
    flat-paths, flat-hexoids, flat-modes, flat-count, flat-ok = tree-to-flat(git-dir, tree-oid, '')
    flat-ok == false -> return

    ; scan the working directory and remove files not in flat-paths
    dest-dir.len > 0 -> {
        remove-stale-dir(git-dir, dest-dir, dest-dir, flat-paths, flat-count)
    }
}

; remove-stale-dir: recursively scan a directory and remove files not in the
; target set. Also removes empty directories after removing stale files.
; base-dir str (root work tree), dir str (current dir),
; cur-prefix str (unused, for future use), flat-paths str (newline-sep),
; flat-count i64
remove-stale-dir = (base-dir str, dir str, cur-prefix str, flat-paths str, flat-count i64) {
    dirp = fs.open-dir(dir)
    dirp == 0 -> return
    fe-ok = true
    {
        fe-ok == false -> break
        fname, fe-ok = fs.read-dir(dirp)
        fe-ok == true -> {
            ; skip . and .. and .git
            is-dot = util.str-eq(fname, '.')
            is-dotdot = util.str-eq(fname, '..')
            is-git = util.str-eq(fname, '.git')
            is-dot == false && is-dotdot == false && is-git == false -> {
                full-path = dir - '/' - fname
                ; compute relative path from base-dir
                rel-path = fname
                base-len = base-dir.len
                full-len = full-path.len
                full-len > base-len -> {
                    rel-path = util.str-range(full-path, base-len + 1, full-len)
                }
                isf = fs.is-file(full-path)
                isf == true -> {
                    ; check if this file is in the target set
                    in-target = false
                    pos = 0
                    j <- [0..flat-count): {
                        nl = util.find-byte-str(flat-paths, 10, pos)
                        end = flat-paths.len
                        nl >= 0 -> end = nl
                        nm = util.str-range(flat-paths, pos, end)
                        same = util.str-eq(nm, rel-path)
                        same == true -> {
                            in-target = true
                            break
                        }
                        pos = nl + 1
                        nl < 0 -> break
                    }
                    in-target == false -> {
                        fs.remove(full-path)
                    }
                }
                isf == false -> {
                    isd = fs.is-dir(full-path)
                    isd == true -> {
                        ; recursively scan subdirectory
                        remove-stale-dir(base-dir, full-path, cur-prefix, flat-paths, flat-count)
                    }
                }
            }
        }
    } (true)
    fs.close-dir(dirp)
}