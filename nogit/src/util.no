; util — shared helpers for the pure-Nolang Git implementation
;
; Low-level string/byte/integer utilities used across the git modules.
; Kept dependency-free (only std fs / os) so it can be imported anywhere.

; char-str: build a single-character string from a byte value
; c byte: the byte to wrap
; returns s str: a 1-byte string
char-str = (c byte) (s str) {
    s str = with-len(1)
    s[0]: {
        ok -> it = c

        -> _
    }
}

; bytes-range: take a byte slice [start, end) and view it as a string
; data []byte: source bytes
; start i64, end i64: half-open range
; returns out str: string of those bytes
bytes-range = (data []byte, start i64, end i64) (out str) {

    #{overflow=wrap}
    n = end - start
    b []byte = with-cap-len(n, n)
    i <- [0..n): {
        dvo = data[start + i]
        dv byte = 0
        dvo: {
            ok -> dv = it

            -> _
        }
        b[i] = dv
    }
    out = b.slice(0, n).to-bytes-str()
}

; bytes-to-str: convert an entire byte slice into a string (1:1 bytes)
; data []byte: source bytes
; returns out str: string of the same bytes
bytes-to-str = (data []byte) (out str) {
    out = bytes-range(data, 0, data.len())
}

; str-range: copy byte-string chars in the half-open range [start, end) into a
; fresh string. Uses nolang's native slice s[a..b).
; s str: source byte-string
; start i64, end i64: half-open char range (0 <= start <= end <= s.len)
; returns out str: the copied substring
; NOTE: s[a..b) 是「碼點」切片且會重新做 UTF-8 編碼，對二進位 byte-string 會
; 損壞內容與長度。本函式是 byte-string 專用，故逐 byte 以 .byte() 取出後寫入
; 新字串（索引「寫入」本來就是 byte 位移，與 .byte() 讀取一致）。
str-range = (s str, start i64, end i64) (out str) {
    lb = s.len-bytes()
    a = start
    a < 0 -> a = 0
    a > lb -> a = lb
    e = end
    e > lb -> e = lb

    n = e - a
    n < 0 -> n = 0
    b []byte = with-cap-len(n, n)
    i <- [0..n): {
        cbv = s.byte(a + i)
        v byte = 0
        cbv: {
            ok -> v = it

            -> _
        }
        b[i] = v
    }
    out = b.slice(0, n).to-bytes-str()
}

; mkdir-seg: create a single directory segment; returns made i64 (1 if present/created, 0 on failure).
; i64 (not bool) is returned because bool arithmetic miscompiles in this toolchain version.
mkdir-seg = (parent str) (made i64) {
    made = 0
    {
        parent.len-bytes() == 0 -> made = 1

        -> {
            fs.is-dir(parent) -> made = 1

            -> {
                d = path{
                    p: parent
                }
                {
                    d.make-dir() -> made = 1

                    -> made = 0
                }
            }
        }
    }
}

; mkdir-all: recursively create a directory (like mkdir -p)
; p str: directory path (must be a directory, not a file)
; returns ok bool: true if the directory exists at the end
; NOTE: conditional arms inside loop bodies are dead-stripped by the compiler in
; module functions, so segment creation is delegated to mkdir-seg.
mkdir-all = (p str) (ok bool) {
    ok = true
    full = p

    #{overflow=wrap}
    p.byte(p.len-bytes() - 1) != 47 -> full = p - '/'

    #{overflow=wrap}
    prefix = full.slice-bytes(0, full.len-bytes() - 1)
    parts = prefix.split('/')
    n = parts.len()
    made-count = 0
    i <- [0..n): {
        mk-acc = ''
        j <- [0..i + 1): {
            mk-acc = mk-acc - parts[j] - '/'
        }

        #{overflow=wrap}
        seg = util.str-range(mk-acc, 0, mk-acc.len-bytes() - 1)
        made = mkdir-seg(seg)

        #{overflow=wrap}
        made-count = made-count + made: {
            ok -> it

            -> _
        }
    }
    ok = mkdir-seg(full) != 0
    ok = ok && made-count == n
}

; remove-tree: recursively remove a file or directory tree (like rm -rf).
; p str: path to remove; missing paths are a no-op.
; returns ok bool: true when the tree is gone
; NOTE: MUST use fs.dir-entries (filters . and ..). fs.list-dir includes them,
; and recursing into '..' walks the delete up out of the target directory.
remove-tree = (p str) (ok bool) {
    ok = true
    isf = fs.is-file(p)
    isd = fs.is-dir(p)
    ! isf && ! isd -> return
    isf -> fs.remove(p)
    kids = fs.dir-entries(p)
    i <- [0..kids.len()): {
        name = kids[i]: {
            ok -> it

            -> ''
        }
        child = p - '/' - name
        ok = remove-tree(child)
    }
    isd -> fs.rmdir(p)
}

; read-u32-be: read a big-endian 32-bit unsigned integer from a byte slice
; data []byte: source bytes
; pos i64: offset of the most-significant byte
; returns v i64: the integer value
read-u32-be = (data []byte, pos i64) (v i64) {
    v = data[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    b1 = data[pos + 1]: {
        ok -> it

        -> 0
    }
    v = (v << 8) | b1: {
        ok -> it

        -> _
    }

    #{overflow=wrap}
    b2 = data[pos + 2]: {
        ok -> it

        -> 0
    }
    v = (v << 8) | b2: {
        ok -> it

        -> _
    }

    #{overflow=wrap}
    b3 = data[pos + 3]: {
        ok -> it

        -> 0
    }
    v = (v << 8) | b3: {
        ok -> it

        -> _
    }
}

; write-u32-be: write a big-endian 32-bit unsigned integer into a byte slice
; buf []byte: destination (must have room)
; pos i64: offset where to write
; v i64: value to write (low 32 bits used)
write-u32-be = (buf []byte, pos i64, v i64) {
    buf[pos]: {
        ok -> it = (v >> 24) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 1]: {
        ok -> it = (v >> 16) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 2]: {
        ok -> it = (v >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 3]: {
        ok -> it = v & 255

        -> _
    }
}

; read-u16-be: read a big-endian 16-bit unsigned integer
; data []byte: source bytes
; pos i64: offset
; returns v i64: value
read-u16-be = (data []byte, pos i64) (v i64) {
    v = data[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    b1 = data[pos + 1]: {
        ok -> it

        -> 0
    }
    v = (v << 8) | b1: {
        ok -> it

        -> _
    }
}

; write-u16-be: write a big-endian 16-bit unsigned integer
; buf []byte: destination
; pos i64: offset
; v i64: value
write-u16-be = (buf []byte, pos i64, v i64) {
    buf[pos]: {
        ok -> it = (v >> 8) & 255

        -> _
    }

    #{overflow=wrap}
    buf[pos + 1]: {
        ok -> it = v & 255

        -> _
    }
}

; find-byte: locate the first occurrence of byte b at or after `from`
; data []byte: haystack
; b byte: needle
; from i64: start offset
; returns pos i64: index of first match, or -1 if not found
find-byte = (data []byte, b byte, from i64) (pos i64) {
    pos = -1
    i <- [from..data.len()): {
        bv = data[i]
        bv: {
            ok -> {
                it == b -> {
                    pos = i
                    break
                }
            }

            -> _
        }
    }
}

; find-byte-str: like find-byte but on a byte-string (str with one codepoint
; per byte). Used by the object layer which carries Git bytes as str.
find-byte-str = (s str, b byte, from i64) (pos i64) {
    pos = -1
    i <- [from..s.len-bytes()): {
        s.byte(i) == b -> {
            pos = i
            break
        }
    }
}

; trim-newline: strip a single trailing LF (and a preceding CR if present)
; Uses str-range (native slice wrapper).
; s str: input
; returns out str: s without a trailing newline
trim-newline = (s str) (out str) {
    out = s
    L = out.len-bytes()
    {
        L > 0 -> {

            #{overflow=wrap}
            {
                out.byte(L - 1) == 10 -> {

                    #{overflow=wrap}
                    L = L - 1
                    out = str-range(out, 0, L)
                    L > 0 -> {

                        #{overflow=wrap}
                        out[L - 1] == 13 -> {

                            #{overflow=wrap}
                            out = str-range(out, 0, L - 1)
                        }
                    }
                }
            }
        }
    }
}

; hexdigit: convert an ASCII hex character to its 0-15 value
; c byte: ASCII byte
; returns v i64: 0-15, or -1 if not a hex digit
;
; Default value placed before guarded branches; the guards override it when matched.
hexdigit = (c byte) (v i64) {
    v = -1
    {
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            v = c - 48
        }

        c >= 97 && c <= 102 -> {

            #{overflow=wrap}
            v = c - 87
        }

        c >= 65 && c <= 70 -> {

            #{overflow=wrap}
            v = c - 55
        }
    }
}

; hex-decode: decode a hex string into bytes
; s str: even-length hex string
; returns out []byte, ok bool: decoded bytes, ok=false if invalid / odd length
hex-decode = (s str) (out ?[]byte) {
    s.len-bytes() % 2 != 0 -> return

    #{overflow=wrap}
    tmp []byte = with-len(s.len-bytes() / 2)
    i <- [0..tmp.len()): {

        #{overflow=wrap}
        hib = s.byte(i * 2)
        hi = hexdigit(hib: {
            ok -> it

            -> 0
        })

        #{overflow=wrap}
        lob = s.byte(i * 2 + 1)
        lo = hexdigit(lob: {
            ok -> it

            -> 0
        })
        hi < 0 || lo < 0 -> return
        tmp[i]: {
            ok -> it = (hi << 4) | lo

            -> _
        }
    }
    out = tmp
}

; hex-encode: encode bytes as a lowercase hex string
; data []byte: input bytes
; returns out str: hex string
hex-encode = (data []byte) (out str) {
    hex-chars = '0123456789abcdef'

    #{overflow=wrap}
    out str = with-len(data.len() * 2)
    i <- [0..data.len()): {
        b = data[i]: {
            ok -> it

            -> 0
        }

        d9v1 str = hex-chars[(b >> 4) & 15]: {
            ok -> it

            -> ''
        }

        #{overflow=wrap}
        out[i * 2]: {
            ok -> it = d9v1

            -> _
        }

        d9v2 str = hex-chars[b & 15]: {
            ok -> it

            -> ''
        }

        #{overflow=wrap}
        out[i * 2 + 1]: {
            ok -> it = d9v2

            -> _
        }
    }
}

; i64-to-str: decimal string of a non-negative integer
; n i64: value (>= 0)
; returns out str: decimal representation
i64-to-str = (n i64) (out str) {
    {
        n == 0 -> {
            out = '0'
            return
        }
    }
    tmp []byte = with-cap(20)
    x = n
    !! {

        #{overflow=wrap}
        tmp.push(48 + (x % 10))

        #{overflow=wrap}
        x = x / 10: {
            ok -> it

            -> _
        }
        x == 0 -> break
    }
    out = ''
    L = tmp.len()
    i <- [0..L): {
        cb str = with-len(1)

        d9v3 byte = tmp[L - 1 - i]: {
            ok -> it

            -> 0
        }
        cb[0]: {
            ok -> it = d9v3

            -> _
        }
        out = out - cb
    }
}

; str-eq: byte-wise equality of two byte-strings.
; a str, b str: strings to compare
; returns yes bool: true if equal
str-eq = (a str, b str) (yes bool) {
    yes = false
    a.len-bytes() != b.len-bytes() -> return
    yes = true
    i = 0
    !! {
        i >= a.len-bytes() -> break
        a.byte(i) != b.byte(i) -> {
            yes = false
            return
        }

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }
}

; read-file-str: read an entire file into a str.
; p str: file path
; returns out ?str: file content (nil if file not found)
read-file-str = (p str) (out ?str) {
    out = nil
    isf = fs.is-file(p)
    {
        ! isf -> {
            return
        }
    }
    out = fs.read-file(p).to-bytes-str()
}

; write-file-simple: write content to a file path.
; p str: file path, content str: content to write
; returns ok bool: true on success
write-file-simple = (p str, content str) (ok bool) {
    ok = false
    fd = fs.open-write(p)
    fs.write(fd, content, content.len-bytes())
    fs.close(fd)
    ok = true
}
