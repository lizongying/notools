{
  name: 'nogit'
  description: 'Pure Nolang implementation of Git (no system git binary)'
  keywords: []
  author: '李宗英'
  email: 'lizongying@msn.com'
  organization: ''
  repository: 'git@github.com:lizongying/notools.git'
  homepage: 'https://github.com/lizongying/notools'
  license: 'MIT'
  mirrors: []
  dependencies: []
  compiler: {
    version: 'v0.4.32'
    link-libs: []
  }
  output: '/dist'
  ; `no pack` walks the package tree and parses every .no file. Tests and the
  ; scratch CLI fixture are build/test-only sources (and still use older syntax),
  ; so they must not become modules of the published nogit-ast.zip.
  ignore: ['tests/', 'tmp-cli-commit/']
}
