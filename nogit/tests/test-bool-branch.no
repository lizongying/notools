; Test bool variable in branch selection

# /nogit/src/util

main = () {
    print('--- Test bool in branch ---')

    content = 'line1\nline2\nline3'
    pos = 0
    result = ''

    !! {
        pos >= content.len-bytes() -> break
        nl = util.find-byte-str(content, 10, pos)
        end = content.len-bytes()
        nl >= 0 -> end = nl
        line = util.str-range(content, pos, end)

        is-sec = line.starts-with('line')
        is-sec -> {
            print('matched: ')
            print(line)

            #{overflow=wrap}
            result = result - line - '\n'
        }
        ! is-sec -> {
            print('not matched: ')
            print(line)

            #{overflow=wrap}
            result = result - line - '\n'
        }

        #{overflow=wrap}
        pos = nl + 1
        nl < 0 -> break
    }

    print('result:')
    print(result)

    0
}
