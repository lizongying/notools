; Test 5a: config module — basic get/set

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Testing config: basic ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-cfg-basic'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }

        nil || err -> {
        }
    }
    {
        init-ok -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }

    ; config-set user.name
    set-ok = config.config-set(git-dir, 'user', 'name', 'Test User')
    {
        set-ok -> print('PASS: config-set name')

        -> print('FAIL: config-set name')
    }

    ; config-set user.email
    set-ok2 = config.config-set(git-dir, 'user', 'email', 'test@example.com')
    {
        set-ok2 -> print('PASS: config-set email')

        -> print('FAIL: config-set email')
    }

    ; config-get should find user.name
    val = ''
    val-ok = false
    val-opt = config.config-get(git-dir, 'user', 'name')
    val-opt: {
        ok -> {
            val = it
            val-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        val-ok -> print('PASS: config-get ok')

        -> print('FAIL: config-get ok')
    }

    {
        val == 'Test User' -> print('PASS: config-get value')

        -> print('FAIL: config-get value: ' - val)
    }

    ; config-get email
    eval = ''
    eval-ok = false
    eval-opt = config.config-get(git-dir, 'user', 'email')
    eval-opt: {
        ok -> {
            eval = it
            eval-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        eval-ok -> print('PASS: config-get email ok')

        -> print('FAIL: config-get email ok')
    }

    {
        eval == 'test@example.com' -> print('PASS: config-get email value')

        -> print('FAIL: config-get email value: ' - eval)
    }

    ; config-get nonexistent key
    junk-cv = ''
    junk-cv-ok = false
    junk-cv-opt = config.config-get(git-dir, 'user', 'nonexistent')
    junk-cv-opt: {
        ok -> {
            junk-cv = it
            junk-cv-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! junk-cv-ok -> print('PASS: nonexistent key fails')

        -> print('FAIL: nonexistent key should fail')
    }

    ; config-get nonexistent section
    junk-cv2 = ''
    junk-cv2-ok = false
    junk-cv2-opt = config.config-get(git-dir, 'nonexistent', 'key')
    junk-cv2-opt: {
        ok -> {
            junk-cv2 = it
            junk-cv2-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! junk-cv2-ok -> print('PASS: nonexistent section fails')

        -> print('FAIL: nonexistent section should fail')
    }

    ; config-get from core section
    core-val = ''
    core-ok = false
    core-val-opt = config.config-get(git-dir, 'core', 'bare')
    core-val-opt: {
        ok -> {
            core-val = it
            core-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        core-ok -> print('PASS: core.bare ok')

        -> print('FAIL: core.bare ok')
    }

    {
        core-val == 'false' -> print('PASS: core.bare value')

        -> print('FAIL: core.bare value: ' - core-val)
    }

    ; case-insensitive
    ru = ''
    ru-ok = false
    ru-opt = config.config-get(git-dir, 'USER', 'NAME')
    ru-opt: {
        ok -> {
            ru = it
            ru-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ru-ok -> print('PASS: case-insensitive ok')

        -> print('FAIL: case-insensitive ok')
    }
    {
        ru == 'Test User' -> print('PASS: case-insensitive value')

        -> print('FAIL: case-insensitive value')
    }

    ; get-user-name / get-user-email
    un = ''
    un-ok = false
    un-opt = config.get-user-name(git-dir)
    un-opt: {
        ok -> {
            un = it
            un-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        un-ok -> print('PASS: get-user-name ok')

        -> print('FAIL: get-user-name ok')
    }
    {
        un == 'Test User' -> print('PASS: get-user-name value')

        -> print('FAIL: get-user-name value')
    }
    ue = ''
    ue-ok = false
    ue-opt = config.get-user-email(git-dir)
    ue-opt: {
        ok -> {
            ue = it
            ue-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ue-ok -> print('PASS: get-user-email ok')

        -> print('FAIL: get-user-email ok')
    }
    {
        ue == 'test@example.com' -> print('PASS: get-user-email value')

        -> print('FAIL: get-user-email value')
    }
    0
}
