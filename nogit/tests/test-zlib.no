; Test 3: zlib module — compress/decompress round trip

# /nogit/src/util
# /nogit/src/zlib

main = () {
    print('--- Testing zlib module ---')

    passed = 0
    failed = 0

    adler = zlib.adler32('Wikipedia')
    {
        adler == 0x11e60398 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: adler32 Wikipedia')
        }
    }

    adler-empty = zlib.adler32('')
    {
        adler-empty == 1 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: adler32 empty')
        }
    }

    data = 'hello world'
    comp = zlib.zlib-compress(data)
    {
        comp.len() > 0 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib-compress should produce output')
        }
    }
    decomp, decomp-ok = zlib.zlib-decompress(comp)
    {
        decomp-ok -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib-decompress ok')
        }
    }
    {
        decomp == data -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib round trip small')
        }
    }

    comp-empty = zlib.zlib-compress('')
    decomp-empty, decomp-empty-ok = zlib.zlib-decompress(comp-empty)
    {
        decomp-empty-ok -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib-decompress empty ok')
        }
    }
    {
        decomp-empty == '' -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib round trip empty')
        }
    }

    ; compress/decompress round trip — data with all byte values
    pattern-data str = with-len(200)
    i <- [0..200): {
        pattern-data[i] = (i % 256) & 0xff
    }
    comp-pat = zlib.zlib-compress(pattern-data)
    decomp-pat, decomp-pat-ok = zlib.zlib-decompress(comp-pat)
    {
        decomp-pat-ok -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib-decompress pattern ok')
        }
    }
    {
        decomp-pat.len() == 200 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib round trip pattern len')
        }
    }
    {
        decomp-pat[0] == 0 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib round trip pattern byte 0')
        }
    }
    {
        decomp-pat[100] == 100 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib round trip pattern byte 100')
        }
    }
    {
        decomp-pat[199] == 199 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib round trip pattern byte 199')
        }
    }

    junk-str str
    junk-str, bad-ok = zlib.zlib-decompress('short')
    {
        ! bad-ok -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib-decompress short input should fail')
        }
    }

    comp2 = zlib.zlib-compress('test')
    {
        comp2[0] == 0x78 -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib header byte 0 should be 0x78')
        }
    }
    {
        comp2[1] == 0x9c -> {

            #{overflow=wrap}
            passed = passed + 1
        }

        -> {

            #{overflow=wrap}
            failed = failed + 1
            print('FAIL: zlib header byte 1 should be 0x9c')
        }
    }

    tp = util.i64-to-str(passed)
    tf = util.i64-to-str(failed)
    print('')

    #{overflow=wrap}
    print('Passed: ' - tp - ', Failed: ' - tf)
    failed > 0 -> 1
    0
}
