; Test 3: zlib module — compress/decompress round trip

# /nogit/src/util
# /nogit/src/zlib

; Build the 200-byte round-trip pattern with a local buffer. Module-level
; (top-level) []byte index writes do not land reliably on v0.4.37, while a
; function-local slice behaves correctly.
make-pattern-bytes = () (out str) {
    bs []byte = with-len(200)
    i <- [0..200): {
        {
            bs[i] ?= i & 0xff
        }: {
            err -> _

            -> _
        }
    }
    out = bs.to-str(): {
        ok -> it

        nil || err -> ''
    }
}

print('--- Testing zlib module ---')

passed = 0
failed = 0

adler = zlib.adler32('Wikipedia')
{
    adler == 0x11e60398 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: adler32 Wikipedia')
    }
}

adler-empty = zlib.adler32('')
{
    adler-empty == 1 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: adler32 empty')
    }
}

data = 'hello world'
comp = zlib.zlib-compress(data)
{
    comp.len() > 0 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib-compress should produce output')
    }
}
decomp = ''
decomp-ok = false
decomp-opt = zlib.zlib-decompress(comp)
decomp-opt: {
    ok -> {
        decomp = it
        decomp-ok = true
    }

    nil -> {
    }

    err -> {
    }
}
{
    decomp-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib-decompress ok')
    }
}
{
    decomp == data -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib round trip small')
    }
}

comp-empty = zlib.zlib-compress('')
decomp-empty = ''
decomp-empty-ok = false
decomp-empty-opt = zlib.zlib-decompress(comp-empty)
decomp-empty-opt: {
    ok -> {
        decomp-empty = it
        decomp-empty-ok = true
    }

    nil -> {
    }

    err -> {
    }
}
{
    decomp-empty-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib-decompress empty ok')
    }
}
{
    decomp-empty == '' -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib round trip empty')
    }
}

; compress/decompress round trip — data with all byte values
pattern-data = make-pattern-bytes()
comp-pat = zlib.zlib-compress(pattern-data)
decomp-pat = ''
decomp-pat-ok = false
decomp-pat-opt = zlib.zlib-decompress(comp-pat)
decomp-pat-opt: {
    ok -> {
        decomp-pat = it
        decomp-pat-ok = true
    }

    nil -> {
    }

    err -> {
    }
}
{
    decomp-pat-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib-decompress pattern ok')
    }
}
{
    decomp-pat.len-bytes() == 200 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib round trip pattern len')
    }
}
{
    decomp-pat.byte(0) == 0 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib round trip pattern byte 0')
    }
}
{
    decomp-pat.byte(100) == 100 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib round trip pattern byte 100')
    }
}
{
    decomp-pat.byte(199) == 199 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib round trip pattern byte 199')
    }
}

bad-ok = false
bad-opt = zlib.zlib-decompress('short')
bad-opt: {
    ok -> {
        bad-ok = true
    }

    nil -> {
    }

    err -> {
    }
}
{
    ! bad-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: zlib-decompress short input should fail')
