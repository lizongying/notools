; Comprehensive test: refs module — branches, tags, detached HEAD, reflog
;
; Tests: write-ref, read-ref, symbolic refs, create/delete branches,
;        create/delete tags, list branches/tags, detached HEAD,
;        reflog write/read, duplicate prevention.

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

print('--- Comprehensive Refs Test ---')

passed = 0
failed = 0

cwd = os.get-wd()

test-dir = cwd - '/tests/tmp-refs-comp'

git-dir = test-dir - '/.git'
gd str
init-ok = false
repository.repo-init(test-dir, false): {
    ok -> {
        gd = it
        init-ok = true
    }

    -> _
}
{
    init-ok -> print('repo-init ok')

    -> print('repo-init FAIL')
}

; create test oids
oid-a = oid.hash-object('blob', 'content a')
oid-b = oid.hash-object('blob', 'content b')

; 1. write-ref / read-ref
w-ok = refs.write-ref(git-dir, 'refs/heads/main', oid-a)
{
    w-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: write-ref')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: write-ref')
    }
}

read-oid oid
r-ok = false
refs.read-ref(git-dir, 'refs/heads/main'): {
    ok -> {
        read-oid = it
        r-ok = true
    }

    -> _
}
{
    r-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: read-ref ok')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: read-ref ok')
    }
}
{
    read-oid.eq(oid-a) -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: read-ref oid match')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: read-ref oid match')
    }
}

; 2. symbolic ref (HEAD)
refs.update-head(git-dir, 'refs/heads/main')
target = ''
sym-ok = false
target-opt = refs.read-symbolic-ref(git-dir, 'HEAD')
target-opt: {
    ok -> {
        target = it
        sym-ok = true
    }

    nil -> {
    }

    err -> {
    }
}
{
    sym-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: read-symbolic-ref ok')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: read-symbolic-ref ok')
    }
}
{
    target == 'refs/heads/main' -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: HEAD target')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: HEAD target')
    }
}

; HEAD resolves through symbolic ref
head-oid oid
head-ok = false
refs.read-ref(git-dir, 'HEAD'): {
    ok -> {
        head-oid = it
        head-ok = true
    }

    -> _
}
{
    head-oid.eq(oid-a) -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: HEAD resolves')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: HEAD resolves')
    }
}

; 3. current-branch
branch, detached, cb-ok = refs.current-branch(git-dir)
{
    cb-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: current-branch ok')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: current-branch ok')
    }
}
{
    branch == 'main' -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: current-branch = main')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: current-branch = main')
    }
}
{
    ! detached -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: not detached')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: not detached')
    }
}

