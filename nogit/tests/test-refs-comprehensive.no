    }
}

; 7. reflog
now = os.now()
refs.write-reflog(git-dir, 'HEAD', oid.zero-oid(), oid-a, 'Test User', 'test@test.com', now, '+0000', 'commit (initial): test')

#{overflow=wrap}
refs.write-reflog(git-dir, 'HEAD', oid-a, oid-b, 'Test User', 'test@test.com', now + 100, '+0000', 'commit: second')

rl-content = ''
rl-ok = false
rl-opt = refs.read-reflog(git-dir, 'HEAD')
rl-opt: {
    ok -> {
        rl-content = it
        rl-ok = true
    }

    nil -> {
    }

    err -> {
    }
}
{
    rl-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: reflog read ok')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: reflog read ok')
    }
}
{
    rl-content.len() > 0 -> {

        #{overflow=wrap}
        passed = passed + 1: {
            ok -> it

            -> _
        }
        print('PASS: reflog has content')
    }

    -> {

        #{overflow=wrap}
        failed = failed + 1: {
            ok -> it

            -> _
        }
        print('FAIL: reflog has content')
    }
}

; 8. nonexistent ref
junk-ro oid
missing-ok = false
refs.read-ref(git-dir, 'refs/heads/nonexistent'): {
    ok -> {
        junk-ro = it
        missing-ok = true
    }

    -> _
}
{
    ! missing-ok -> {

        #{overflow=wrap}
        passed = passed + 1: {
