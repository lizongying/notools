; Test config-get after config-set

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Test config-get directly ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-debug-get'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }

        nil || err -> {
        }
    }

    ; Read config directly
    p = git-dir - '/config'
    content = ''
    file-ok = false
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> {
            content = it
            file-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    print('direct read: len=')
    print(content.len())
    print('direct read: ok=')
    print(file-ok)

    ; Call config-get (cross-module)
    val = ''
    val-ok = false
    val-opt = config.config-get(git-dir, 'core', 'bare')
    val-opt: {
        ok -> {
            val = it
            val-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    print('config-get ok=')
    print(val-ok)
    print('config-get val=')
    print(val)

    0
}
