; Debug: minimal test of read-dir in a loop

# /nogit/src/util

main = () {
    cwd = os.get-wd()
    #{overflow=wrap}
    test-dir = cwd - '/tests/tmp-rd-test'
    fs.is-dir(test-dir) -> {}

    -> fs.mkdir-all(test-dir)

    ; create some files
    #{overflow=wrap}
    util.write-file-simple(test-dir - '/file1', 'aaa')
    #{overflow=wrap}
    util.write-file-simple(test-dir - '/file2', 'bb')
    #{overflow=wrap}
    util.write-file-simple(test-dir - '/file3', 'c')

    dirp = fs.open-dir(test-dir)
    print('dirp:')
    print(dirp)

    ; Simple loop without multi-return in the loop body
    ok = true
    c = 0
    {
        ok == false -> break
        name, ok = fs.read-dir(dirp)
        {
            ok == true -> {
                print('entry:')
                print(name)
                print('len:')
                print(name.len())
                #{overflow=wrap}
                c = c + 1
            }
        }
        c > 10 -> break
    } (true)

    fs.close-dir(dirp)
    print('total:')
    print(c)
    0
}
