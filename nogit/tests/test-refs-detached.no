; Test 7c: refs module — detached HEAD and reflog

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

main = () {
    print('--- Testing refs: detached & reflog ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-refs-det'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    ; set up main branch
    main-oid = oid.hash-object('blob', 'main data')
    refs.write-ref(git-dir, 'refs/heads/main', main-oid)

    ; set-head-detached
    detached-oid = oid.hash-object('blob', 'detached')
    refs.set-head-detached(git-dir, detached-oid)
    d-target, d-sym-ok = refs.read-symbolic-ref(git-dir, 'HEAD')
    {
        d-sym-ok == false -> print('PASS: detached HEAD not symbolic')

        -> print('FAIL: detached HEAD should not be symbolic')
    }
    d-branch, d-detached, d-ok = refs.current-branch(git-dir)
    {
        d-detached == true -> print('PASS: current-branch detached')

        -> print('FAIL: current-branch should be detached')
    }
    ; update-head back to symbolic
    refs.update-head(git-dir, 'refs/heads/main')
    b2, det2, ok2 = refs.current-branch(git-dir)
    {
        ok2 == true -> print('PASS: current-branch after update ok')

        -> print('FAIL: current-branch after update-head ok')
    }
    {
        det2 == false -> print('PASS: not detached after update')

        -> print('FAIL: should not be detached after update-head')
    }
    ; reflog
    old-oid = oid.zero-oid()
    new-oid = oid.hash-object('blob', 'reflog test')
    rl-ok = refs.write-reflog(git-dir, 'HEAD', old-oid, new-oid, 'Test User', 'test@test.com', 1112911993, '+0000', 'test reflog entry')
    {
        rl-ok == true -> print('PASS: write-reflog')

        -> print('FAIL: write-reflog ok')
    }
    rl-content, rl-read-ok = refs.read-reflog(git-dir, 'HEAD')
    {
        rl-read-ok == true -> print('PASS: read-reflog')

        -> print('FAIL: read-reflog ok')
    }
    {
        rl-content.len > 0 -> print('PASS: reflog not empty')

        -> print('FAIL: reflog content should not be empty')
    }
    0
}
