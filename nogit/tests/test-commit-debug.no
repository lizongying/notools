; Debug: test commit parsing

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/zlib
# /nogit/src/object
# /nogit/src/repository

main = () {
    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-obj-commit'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }

        nil || err -> {
        }
    }

    b-oid = object.write-blob(git-dir, 'commit test data')

    ; zlib warmup
    bp = object.object-path(git-dir, b-oid)
    braw str = fs.read-file(bp).to-bytes-str()
    warmup-ok = false
    warmup-opt = zlib.zlib-decompress(braw)
    warmup-opt: {
        ok -> {
            warmup-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }

    traw = object.tree-add-raw('', 33188, 'test.txt', b-oid)
    tree-oid = object.tree-write-raw(git-dir, traw)

    commit-oid = object.write-commit-full(git-dir, tree-oid, '', 'Author Name', 'author@test.com', 1112911993, '+0000', 'Committer Name', 'committer@test.com', 1112911993, '+0000', 'test commit message')

    cp = object.object-path(git-dir, commit-oid)
    craw str = fs.read-file(cp).to-bytes-str()
    cout = ''
    cout-opt = zlib.zlib-decompress(craw)
    cout-opt: {
        ok -> {
            cout = it
        }

        nil -> {
        }

        err -> {
        }
    }

    print('decompressed content:')
    print(cout)
    print('len:')
    print(cout.len())

    ; Check author line
    idx = cout.index('author ')
    print('author idx:')
    print(idx)

    {
        idx >= 0 -> {
            nl = util.find-byte-str(cout, 10, idx)
            print('nl:')
            print(nl)
            line = util.str-range(cout, idx, nl)
            print('author line:')
            print(line)
        }
    }

    0
}
