; Debug - inline config-set with debug output

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set inline with debug ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-inline'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    p = git-dir - '/config'
    content, file-ok = util.read-file-str(p)
    print('content.len=')
    print(content.len)

    ; Call config-set-line directly
    line = '[core]'
    trimmed = config.trim-ws(line)
    print('calling config-set-line with [core]')
    lo, rep, is-sec = config.config-set-line(line, trimmed, false, 'user', 'name', 'name', 'Test User')
    print('line-out=')
    print(lo)
    print('replaced=')
    print(rep)
    print('is-section=')
    print(is-sec)

    ; Try with a key=value line
    line2 = '	name = Old Name'
    trimmed2 = config.trim-ws(line2)
    print('calling config-set-line with name = Old Name')
    lo2, rep2, is-sec2 = config.config-set-line(line2, trimmed2, true, 'user', 'name', 'name', 'Test User')
    print('line-out2=')
    print(lo2)
    print('replaced2=')
    print(rep2)
    print('is-section2=')
    print(is-sec2)

    ; Try with a non-matching key=value line
    line3 = '	bare = false'
    trimmed3 = config.trim-ws(line3)
    print('calling config-set-line with bare = false')
    lo3, rep3, is-sec3 = config.config-set-line(line3, trimmed3, true, 'user', 'name', 'name', 'Test User')
    print('line-out3=')
    print(lo3)
    print('replaced3=')
    print(rep3)
    print('is-section3=')
    print(is-sec3)

    0
}
