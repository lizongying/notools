; Debug: test list-branches

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

main = () {
    print('--- Debug list-branches ---')

    cwd = os.get-wd()

    #{overflow=wrap}
    test-dir = cwd - '/tests/tmp-refs-br'

    #{overflow=wrap}
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    ; set up main branch
    main-oid = oid.hash-object('blob', 'main data')
    refs.write-ref(git-dir, 'refs/heads/main', main-oid)

    ; create dev branch
    branch2-oid = oid.hash-object('blob', 'branch2')
    refs.write-ref(git-dir, 'refs/heads/main', branch2-oid)
    cb-ok = refs.create-branch(git-dir, 'dev', branch2-oid)
    print('create-branch ok:')
    print(cb-ok)

    ; list branches
    #{overflow=wrap}
    heads-dir = git-dir - '/refs/heads'
    print('heads-dir:')
    print(heads-dir)
    isd = fs.is-dir(heads-dir)
    print('is-dir:')
    print(isd)

    dirp = fs.open-dir(heads-dir)
    print('dirp:')
    print(dirp)

    {
        dirp == 0 -> {
            print('open-dir failed')
            0
        }

        -> {

            ; read entries
            br-entry str
            br-ok = true
            c = 0
            !! {
                ! br-ok -> break
                print('calling read-dir...')
                br-entry, br-ok = fs.read-dir(dirp)
                print('read-dir ok=')
                print(br-ok)
                br-ok -> {
                    print('entry.len=')
                    print(br-entry.len())

                    #{overflow=wrap}
                    c = c + 1
                }
                c > 10 -> break
            }
            fs.close-dir(dirp)
            print('total entries:')
            print(c)
            0
        }
    }
}
