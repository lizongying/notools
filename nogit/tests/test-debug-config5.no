; Debug test for config-set crash - simplified config-set

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set simplified ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-cfg5'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    ; Inline a simplified config-set
    p = git-dir - '/config'
    content, file-ok = util.read-file-str(p)

    new-content = ''
    pos = 0
    {
        pos >= content.len -> break
        nl = util.find-byte-str(content, 10, pos)
        print('iter pos=')
        print(pos)
        print('nl=')
        print(nl)

        end = content.len
        nl >= 0 -> end = nl
        line = util.str-range(content, pos, end)
        print('line=')
        print(line)

        new-content = new-content - line - '\n'

        pos = nl + 1
        nl < 0 -> break
    } (true)

    print('new-content:')
    print(new-content)
    print('done')

    0
}
