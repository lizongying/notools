; Debug test for config-set crash - simplified config-set

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set simplified ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-debug-cfg5'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }

        nil || err -> {
        }
    }

    ; Inline a simplified config-set
    p = git-dir - '/config'
    content = ''
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> content = it

        nil -> {
        }

        err -> {
        }
    }

    new-content = ''
    pos = 0
    !! {
        pos >= content.len() -> break
        nl = util.find-byte-str(content, 10, pos)
        print('iter pos=')
        print(pos)
        print('nl=')
        print(nl)

        end = content.len()
        nl >= 0 -> end = nl
        line = util.str-range(content, pos, end)
        print('line=')
        print(line)

        new-content = new-content - line - '\n'

        #{overflow=wrap}
        pos = nl + 1
        nl < 0 -> break
    }

    print('new-content:')
    print(new-content)
    print('done')

    0
}
