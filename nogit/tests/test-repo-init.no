; Test 6a: repository module — init and structure

# /nogit/src/util
# /nogit/src/repository

main = () {
    print('--- Testing repository: init ---')

    cwd = os.get-wd()
    #{overflow=wrap}
    test-dir = cwd - '/tests/tmp-repo-init'
    #{overflow=wrap}
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    {
        gd == git-dir -> print('PASS: git-dir path')

        -> print('FAIL: git-dir path')
    }
    ; verify directory structure
    {
        fs.is-dir(git-dir) -> print('PASS: git-dir exists')

        -> print('FAIL: git-dir exists')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/objects') -> print('PASS: objects dir')

        -> print('FAIL: objects dir')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/objects/info') -> print('PASS: objects/info dir')

        -> print('FAIL: objects/info dir')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/objects/pack') -> print('PASS: objects/pack dir')

        -> print('FAIL: objects/pack dir')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/refs') -> print('PASS: refs dir')

        -> print('FAIL: refs dir')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/refs/heads') -> print('PASS: refs/heads dir')

        -> print('FAIL: refs/heads dir')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/refs/tags') -> print('PASS: refs/tags dir')

        -> print('FAIL: refs/tags dir')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/info') -> print('PASS: info dir')

        -> print('FAIL: info dir')
    }
    #{overflow=wrap}
    {
        fs.is-dir(git-dir - '/hooks') -> print('PASS: hooks dir')

        -> print('FAIL: hooks dir')
    }
    #{overflow=wrap}
    {
        fs.is-file(git-dir - '/HEAD') -> print('PASS: HEAD file')

        -> print('FAIL: HEAD file')
    }
    #{overflow=wrap}
    {
        fs.is-file(git-dir - '/config') -> print('PASS: config file')

        -> print('FAIL: config file')
    }
    #{overflow=wrap}
    {
        fs.is-file(git-dir - '/description') -> print('PASS: description file')

        -> print('FAIL: description file')
    }
    ; verify HEAD content
    #{overflow=wrap}
    head-content = fs.read-file(git-dir - '/HEAD')
    {
        head-content == 'ref: refs/heads/main\n' -> print('PASS: HEAD content')

        -> print('FAIL: HEAD content')
    }
    0
}
