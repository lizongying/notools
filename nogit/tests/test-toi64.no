; Debug: test to-i64 parsing

# /nogit/src/util

main = () {
    s = '1112911993'
    print('s:')
    print(s)
    print('s.len:')
    print(s.len)
    ti ?i64 = s.to-i64()
    print('ti tag:')
    ; check option tag
    ti: {
        ok -> {
            print('ok, value:')
            print(it)
        }

        nil -> print('nil')

        err -> print('err')
    }
    0
}
