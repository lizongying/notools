; Debug: minimal list-branches call

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

main = () {
    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-refs-br'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }

        nil || err -> {
        }
    }

    main-oid = oid.hash-object('blob', 'main data')
    refs.write-ref(git-dir, 'refs/heads/main', main-oid)

    branch2-oid = oid.hash-object('blob', 'branch2')
    refs.write-ref(git-dir, 'refs/heads/main', branch2-oid)
    cb-ok = refs.create-branch(git-dir, 'dev', branch2-oid)
    cb-ok2 = refs.create-branch(git-dir, 'dev', branch2-oid)

    print('calling list-branches...')
    bnames, bcount = refs.list-branches(git-dir)
    print('list-branches returned')
    print('bcount:')
    print(bcount)

    0
}
