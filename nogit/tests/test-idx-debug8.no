print-hex = (content str) {
    hc = '0123456789abcdef'
    i <- [0..content.len-bytes()): {
        b = content[i]
        h1 str = with-len(1)
        ; D9: place-match 写的 RHS 若是对另一基底做裸下标读会静默丢写，先两段式暂存成 char
        #{index-out=zero}
        hi char = hc[(b >> 4) & 15]
        h1[0]: {
            ok -> it = hi
            -> _
        }
        h2 str = with-len(1)
        #{index-out=zero}
        lo char = hc[b & 15]
        h2[0]: {
            ok -> it = lo
            -> _
        }

        print(h1 - h2 - ' ')
    }
}

