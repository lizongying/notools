; Test if {} branch selection with two conditions works in a simple function

# /nogit/src/util

; This function is in the test file (main module), so it's not cross-module
test-branch = (s str) (result str) {
    result = ''
    ; First condition
    s[0] == 91 -> {
        result = 'bracket'
    }
    ; Second condition
    s[0] >= 92 -> {
        result = 'other'
    }
}

; This function calls util (cross-module) and has a loop
test-loop = (data str) (result str) {
    result = ''
    pos = 0
    {
        pos >= data.len -> break
        nl = util.find-byte-str(data, 10, pos)
        end = data.len
        nl >= 0 -> end = nl
        line = util.str-range(data, pos, end)

        ; Two conditions in same {} block
        line[0] == 91 -> {
            result = result - 'S'
        }
        line[0] >= 92 -> {
            result = result - 'K'
        }

        pos = nl + 1
        nl < 0 -> break
    } (true)
}

main = () {
    print('--- Test branch selection ---')

    ; Test 1: simple function call
    r1 = test-branch('[core]')
    print('test-branch [core]: ')
    print(r1)

    r2 = test-branch('hello')
    print('test-branch hello: ')
    print(r2)

    ; Test 2: loop with two conditions (same module)
    r3 = test-loop('[core]\nhello\n[user]')
    print('test-loop: ')
    print(r3)

    0
}
