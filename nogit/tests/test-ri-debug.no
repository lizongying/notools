; Debug: test repo-init return value

# /nogit/src/util
# /nogit/src/repository

main = () {
    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-ri-debug'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok bool = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }
        nil || err -> { }
    }
    print('gd:')
    print(gd)
    print('init-ok:')
    print(init-ok)
    {
        init-ok -> print('PASS')

        -> print('FAIL')
    }
    0
}
