; Debug test for config-set crash - step by step

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set step ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-cfg3'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    ; Test trim-ws
    print('before trim-ws')
    tw = config.trim-ws('  hello  ')
    print('after trim-ws: ')
    print(tw)

    ; Test config-get (which also parses config)
    print('before config-get')
    val, gok = config.config-get(git-dir, 'core', 'bare')
    print('after config-get')
    gok == true -> print('config-get ok') -> print('config-get fail')
    val == 'false' -> print('val=false') -> print('val=' - val)

    ; Now test config-set
    print('before config-set')
    set-ok = config.config-set(git-dir, 'user', 'name', 'TestUser')
    print('after config-set')

    0
}
