; Test 9a: revwalk module — resolve-ref and commit info

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/zlib
# /nogit/src/object
# /nogit/src/refs
# /nogit/src/repository
# /nogit/src/revwalk

main = () {
    print('--- Testing revwalk: resolve & info ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-rw-resolve'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }

        nil || err -> {
        }
    }
    {
        init-ok -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }

    ; create a commit chain
    blob = object.write-blob(git-dir, 'revwalk test')
    traw = object.tree-add-raw('', 33188, 'test.txt', blob)
    tree-oid = object.tree-write-raw(git-dir, traw)

    ; commit1 (no parent)
    c1 = object.write-commit-full(git-dir, tree-oid, '', 'A', 'a@b.com', 1000, '+0000', 'C', 'c@b.com', 1000, '+0000', 'first commit')

    ; commit2 (parent = commit1)
    c2 = object.write-commit-full(git-dir, tree-oid, oid.oid-hex-str(c1), 'A', 'a@b.com', 2000, '+0000', 'C', 'c@b.com', 2000, '+0000', 'second commit')

    ; commit3 (parent = commit2)
    c3 = object.write-commit-full(git-dir, tree-oid, oid.oid-hex-str(c2), 'A', 'a@b.com', 3000, '+0000', 'C', 'c@b.com', 3000, '+0000', 'third commit')

    ; set up refs
    refs.write-ref(git-dir, 'refs/heads/main', c3)
    refs.update-head(git-dir, 'refs/heads/main')

    ; resolve-ref
    head-oid-opt = revwalk.resolve-ref(git-dir, 'HEAD')
    head-oid oid
    resolve-ok = false
    head-oid-opt: {
        ok -> {
            head-oid = head-oid-opt
            resolve-ok = true
        }

        nil || err -> {
        }
    }
    {
        resolve-ok -> print('PASS: resolve-ref HEAD ok')

        -> print('FAIL: resolve-ref HEAD ok')
    }
    {
        head-oid.eq(c3) -> print('PASS: resolve-ref HEAD = c3')

        -> print('FAIL: resolve-ref HEAD should be c3')
    }

    ; resolve-ref by branch name
    main-oid-opt = revwalk.resolve-ref(git-dir, 'main')
    main-oid oid
    main-ok = false
    main-oid-opt: {
        ok -> {
            main-oid = main-oid-opt
            main-ok = true
        }

        nil || err -> {
        }
    }
    {
        main-ok -> print('PASS: resolve-ref main ok')

        -> print('FAIL: resolve-ref main ok')
    }
    {
        main-oid.eq(c3) -> print('PASS: resolve-ref main = c3')

        -> print('FAIL: resolve-ref main should be c3')
    }

    ; resolve-ref by hex oid
    hex-oid-opt = revwalk.resolve-ref(git-dir, oid.oid-hex-str(c3))
    hex-oid oid
    hex-ok = false
    hex-oid-opt: {
        ok -> {
            hex-oid = hex-oid-opt
            hex-ok = true
        }

        nil || err -> {
        }
    }
    {
        hex-ok -> print('PASS: resolve-ref hex ok')

        -> print('FAIL: resolve-ref hex oid ok')
    }
    {
        hex-oid.eq(c3) -> print('PASS: resolve-ref hex = c3')

        -> print('FAIL: resolve-ref hex oid should be c3')
    }

    ; commit-tree-oid
    tree-from-commit-opt = revwalk.commit-tree-oid(git-dir, c3)
    tree-from-commit oid
    ct-ok = false
    tree-from-commit-opt: {
        ok -> {
            tree-from-commit = tree-from-commit-opt
            ct-ok = true
        }

        nil || err -> {
        }
    }
    {
        ct-ok -> print('PASS: commit-tree-oid ok')

        -> print('FAIL: commit-tree-oid ok')
    }
    {
        tree-from-commit.eq(tree-oid) -> print('PASS: commit-tree-oid match')

        -> print('FAIL: commit-tree-oid match')
    }

    ; commit-parents
    parent-hex, nparents, cp-ok = revwalk.commit-parents(git-dir, c3)
    {
        cp-ok -> print('PASS: commit-parents ok')

        -> print('FAIL: commit-parents ok')
    }
    {
        nparents == 1 -> print('PASS: nparents = 1')

        -> print('FAIL: commit-parents count should be 1')
    }
    0
}
