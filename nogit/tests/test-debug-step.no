; Debug test - check config after each set

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set step by step ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-debug-step'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok bool = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }
        nil || err -> { }
    }

    p = git-dir - '/config'
    content str = ''
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> content = it
        nil -> {}
        err -> {}
    }
    print('=== initial config ===')
    print(content)
    print('===')

    print('setting user.name')
    config.config-set(git-dir, 'user', 'name', 'Test User')
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> content = it
        nil -> {}
        err -> {}
    }
    print('=== after user.name ===')
    print(content)
    print('===')

    print('setting user.email')
    config.config-set(git-dir, 'user', 'email', 'test@example.com')
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> content = it
        nil -> {}
        err -> {}
    }
    print('=== after user.email ===')
    print(content)
    print('===')

    print('setting remote.origin.url')
    config.config-set(git-dir, 'remote.origin', 'url', 'git@example.com:repo.git')
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> content = it
        nil -> {}
        err -> {}
    }
    print('=== after remote.origin.url ===')
    print(content)
    print('===')

    0
}
