# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

main = () {
    print('start')
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-simple-refs3'
    git-dir = test-dir - '/.git'
    repository.repo-init(test-dir, false)
    print('init done')
    oid-a = oid.hash-object('blob', 'content a')
    oid-b = oid.hash-object('blob', 'content b')

    refs.write-ref(git-dir, 'refs/heads/main', oid-a)
    refs.update-head(git-dir, 'refs/heads/main')
    refs.create-branch(git-dir, 'feature', oid-a)
    refs.create-branch(git-dir, 'develop', oid-b)
    bnames, bcount = refs.list-branches(git-dir)
    print('branches listed: ' - util.i64-to-str(bcount))

    ; duplicate
    dup-ok = refs.create-branch(git-dir, 'feature', oid-b)
    print('dup done')
    ; delete
    del-ok = refs.delete-branch(git-dir, 'feature')
    print('delete done')
    bnames2, bcount2 = refs.list-branches(git-dir)
    print('after delete: ' - util.i64-to-str(bcount2))

    ; tags
    refs.create-tag(git-dir, 'v1.0', oid-a)
    refs.create-tag(git-dir, 'v2.0', oid-b)
    print('tags created')
    tnames, tcount = refs.list-tags(git-dir)
    print('tags listed: ' - util.i64-to-str(tcount))

    ; dup tag
    dup-tag-ok = refs.create-tag(git-dir, 'v1.0', oid-b)
    print('dup tag done')
    ; delete tag
    dt-ok = refs.delete-tag(git-dir, 'v1.0')
    print('tag deleted')
    tnames2, tcount2 = refs.list-tags(git-dir)
    print('tags after delete: ' - util.i64-to-str(tcount2))

    ; detached
    refs.set-head-detached(git-dir, oid-a)
    print('set detached')
    det-branch, det-detached, det-ok2 = refs.current-branch(git-dir)
    print('detached=' - util.i64-to-str(det-detached))

    ; restore
    refs.update-head(git-dir, 'refs/heads/main')
    print('restored')

    ; reflog
    now = os.now()
    refs.write-reflog(git-dir, 'HEAD', oid.zero-oid(), oid-a, 'Test User', 'test@test.com', now, '+0000', 'init')
    print('reflog written')
    rl-content, rl-ok = refs.read-reflog(git-dir, 'HEAD')
    print('reflog read, len=' - util.i64-to-str(rl-content.len))

    ; nonexistent
    junk-ro oid
    junk-ro, missing-ok = refs.read-ref(git-dir, 'refs/heads/nonexistent')
    print('missing ref ok=' - util.i64-to-str(missing-ok))

    ; det symbolic
    refs.set-head-detached(git-dir, oid-b)
    junk-target str
    junk-target, det-sym-ok = refs.read-symbolic-ref(git-dir, 'HEAD')
    print('det sym ok=' - util.i64-to-str(det-sym-ok))

    print('ALL DONE')
    0
}
