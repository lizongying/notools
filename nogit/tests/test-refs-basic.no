; Test 7a: refs module — basic ref read/write

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

print('--- Testing refs: basic ---')

cwd = os.get-wd()

test-dir = cwd - '/tests/tmp-refs-basic'

git-dir = test-dir - '/.git'
gd str
init-ok = false
repository.repo-init(test-dir, false): {
    ok -> {
        gd = it
        init-ok = true
    }

    -> _
}
{
    init-ok -> print('PASS: repo-init')

    -> print('FAIL: repo-init')
}

; write-ref / read-ref round trip
test-ref-oid = oid.hash-object('blob', 'ref test data')
w-ok = refs.write-ref(git-dir, 'refs/heads/main', test-ref-oid)
{
    w-ok -> print('PASS: write-ref')

    -> print('FAIL: write-ref')
}
read-oid oid
r-ok = false
refs.read-ref(git-dir, 'refs/heads/main'): {
    ok -> {
        read-oid = it
        r-ok = true
    }

    -> _
}
{
    r-ok -> print('PASS: read-ref ok')

    -> print('FAIL: read-ref ok')
}
{
    read-oid.eq(test-ref-oid) -> print('PASS: read-ref oid match')

    -> print('FAIL: read-ref oid match')
}

; HEAD should be symbolic ref to refs/heads/main
target = ''
sym-ok = false
target-opt = refs.read-symbolic-ref(git-dir, 'HEAD')
target-opt: {
    ok -> {
        target = it
        sym-ok = true
    }

    nil -> {
    }

    err -> {
    }
}
{
    sym-ok -> print('PASS: read-symbolic-ref ok')

    -> print('FAIL: read-symbolic-ref ok')
}
{
    target == 'refs/heads/main' -> print('PASS: HEAD target')

    -> print('FAIL: HEAD target')
}

; read-ref HEAD should resolve through symbolic ref
head-oid oid
head-ok = false
refs.read-ref(git-dir, 'HEAD'): {
    ok -> {
        head-oid = it
        head-ok = true
    }

    -> _
}
{
    head-ok -> print('PASS: read-ref HEAD ok')

    -> print('FAIL: read-ref HEAD ok')
}
{
    head-oid.eq(test-ref-oid) -> print('PASS: HEAD oid match')

    -> print('FAIL: HEAD oid match')
}

; current-branch should return main
branch, detached, cb-ok = refs.current-branch(git-dir)
{
    cb-ok -> print('PASS: current-branch ok')

    -> print('FAIL: current-branch ok')
}
{
    branch == 'main' -> print('PASS: current-branch name')

    -> print('FAIL: current-branch name')
}
{
    ! detached -> print('PASS: not detached')

    -> print('FAIL: not detached')
}

; read-ref for nonexistent ref
junk-ro oid
missing-ok = false
refs.read-ref(git-dir, 'refs/heads/nonexistent'): {
    ok -> {
        junk-ro = it
        missing-ok = true
    }

    -> _
}
{
    ! missing-ok -> print('PASS: nonexistent ref fails')

    -> print('FAIL: nonexistent ref should fail')
}
0
