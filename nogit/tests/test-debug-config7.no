; Debug test - call config-set on existing section

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set existing section ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-debug-cfg7'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok bool = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }
        nil || err -> { }
    }

    ; Try setting core.bare (section already exists)
    print('before config-set core.bare')
    set-ok = config.config-set(git-dir, 'core', 'bare', 'true')
    print('after config-set core.bare')
    {
        set-ok -> print('PASS')

        -> print('FAIL')
    }
    0
}
