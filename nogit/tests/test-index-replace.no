; Test 8b: index module — replace, remove, and entry-at

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/object
# /nogit/src/zlib
# /nogit/src/index
# /nogit/src/repository

main = () {
    print('--- Testing index: replace & remove ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)
    {
        init-ok == true -> print('PASS: repo-init')

        -> print('FAIL: repo-init')
    }
    ; write blobs
    blob1 = object.write-blob(git-dir, 'content1')
    blob2 = object.write-blob(git-dir, 'content2')

    ; add two files
    index.index-add(git-dir, 'file1.txt', blob1, 33188)
    index.index-add(git-dir, 'file2.txt', blob2, 33188)

    junk-n1 str
    junk-h1 str
    junk-m1 str
    junk-n1, junk-h1, junk-m1, count2, junk-ok1 = index.read-index(git-dir)
    {
        count2 == 2 -> print('PASS: count = 2 after second add')

        -> print('FAIL: index count after second add should be 2')
    }
    ; replace first file (update content)
    blob1b = object.write-blob(git-dir, 'content1-updated')
    index.index-add(git-dir, 'file1.txt', blob1b, 33188)
    junk-n2 str
    junk-h2 str
    junk-m2 str
    junk-n2, junk-h2, junk-m2, count3, junk-ok2 = index.read-index(git-dir)
    {
        count3 == 2 -> print('PASS: count = 2 after replace')

        -> print('FAIL: index count after replace should still be 2')
    }
    ; index-remove
    index.index-remove(git-dir, 'file2.txt')
    junk-n4 str
    junk-h4 str
    junk-m4 str
    junk-n4, junk-h4, junk-m4, count4, junk-ok4 = index.read-index(git-dir)
    {
        count4 == 1 -> print('PASS: count = 1 after remove')

        -> print('FAIL: index count after remove should be 1')
    }
    ; read-index-entry-at
    nm-at, oid-at, mode-at, at-ok = index.read-index-entry-at(git-dir, 0)
    {
        at-ok == true -> print('PASS: read-index-entry-at ok')

        -> print('FAIL: read-index-entry-at ok')
    }
    {
        nm-at == 'file1.txt' -> print('PASS: entry-at name')

        -> print('FAIL: read-index-entry-at name')
    }
    {
        mode-at == 33188 -> print('PASS: entry-at mode')

        -> print('FAIL: read-index-entry-at mode')
    }
    {
        oid-at.eq(blob1b) == true -> print('PASS: entry-at oid')

        -> print('FAIL: read-index-entry-at oid')
    }
    0
}
