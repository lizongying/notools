; Debug test for config-set crash

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-debug-cfg2'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok bool = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }
        nil || err -> { }
    }
    print('repo-init done')

    ; read config file
    p = git-dir - '/config'
    content str = ''
    file-ok = false
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> {
            content = it
            file-ok = true
        }
        nil -> {}
        err -> {}
    }
    print('read config: ok=')
    print(file-ok)
    print('content len=')
    print(content.len())
    print('content:')
    print(content)

    ; try to-lower-local directly
    print('before to-lower-local')
    lower = config.to-lower-local('USER')
    print('after to-lower-local: ')
    print(lower)

    0
}
