; Debug: test read-index-entry-at

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/object
# /nogit/src/zlib
# /nogit/src/index
# /nogit/src/repository

main = () {
    print('--- Debug: read-index-entry-at ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    ; write blobs
    blob1 = object.write-blob(git-dir, 'content1')
    blob2 = object.write-blob(git-dir, 'content2')

    ; add two files
    index.index-add(git-dir, 'file1.txt', blob1, 33188)
    index.index-add(git-dir, 'file2.txt', blob2, 33188)

    ; replace first file (update content)
    blob1b = object.write-blob(git-dir, 'content1-updated')
    index.index-add(git-dir, 'file1.txt', blob1b, 33188)

    ; index-remove
    index.index-remove(git-dir, 'file2.txt')

    ; read-index-entry-at
    nm-at, oid-at, mode-at, at-ok = index.read-index-entry-at(git-dir, 0)
    print('at-ok:')
    print(at-ok)
    print('nm-at:')
    print(nm-at)
    print('nm-at len:')
    print(nm-at.len)
    print('mode-at:')
    print(mode-at)

    ; compare
    print('eq file1.txt:')
    print(nm-at == 'file1.txt')

    ; Also read raw index for comparison
    names, hexoids, modes, count, ok = index.read-index(git-dir)
    print('read-index count:')
    print(count)
    print('read-index names:')
    print(names)

    0
}
