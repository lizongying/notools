; Debug: test read-index inside index-add context

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/object
# /nogit/src/zlib
# /nogit/src/index
# /nogit/src/repository

main = () {
    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-idx-rep'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    blob1 = object.write-blob(git-dir, 'content1')
    index.index-add(git-dir, 'file1.txt', blob1, 33188)

    ; manually do what index-add does: read-index, then check names
    n1, h1, m1, c1, ok1 = index.read-index(git-dir)
    print('after 1st add - read-index:')
    print('  count:')
    print(c1)
    print('  names:')
    print(n1)
    print('  names len:')
    print(n1.len)

    ; Now manually do what the second index-add would do
    ; First read-index
    n2, h2, m2, c2, ok2 = index.read-index(git-dir)
    print('before 2nd add - read-index:')
    print('  count:')
    print(c2)
    print('  names:')
    print(n2)
    print('  names len:')
    print(n2.len)

    ; Check if names is correct by parsing first entry
    nl = util.find-byte-str(n2, 10, 0)
    print('  first newline at:')
    print(nl)
    nm = n2[0..nl)
    print('  first name:')
    print(nm)
    print('  first name len:')
    print(nm.len)

    0
}
