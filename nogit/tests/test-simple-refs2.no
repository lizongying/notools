# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

main = () {
    print('start')
    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-simple-refs2'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok bool = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }
        nil || err -> { }
    }
    print('init done')
    oid-a = oid.hash-object('blob', 'content a')
    oid-b = oid.hash-object('blob', 'content b')
    print('oids created')
    refs.write-ref(git-dir, 'refs/heads/main', oid-a)
    refs.update-head(git-dir, 'refs/heads/main')
    print('head updated')
    target str = ''
    target-opt = refs.read-symbolic-ref(git-dir, 'HEAD')
    target-opt: {
        ok -> target = it
        nil -> {}
        err -> {}
    }
    print('sym ref read')
    head-oid-opt = refs.read-ref(git-dir, 'HEAD')
    head-oid oid
    head-ok bool = false
    head-oid-opt: {
        ok -> {
            head-oid = head-oid-opt
            head-ok = true
        }
        nil || err -> { }
    }
    print('head read')
    branch, detached, cb-ok = refs.current-branch(git-dir)
    print('current branch')

    print('branch=' - branch)
    refs.create-branch(git-dir, 'feature', oid-a)
    print('branch created')
    refs.create-branch(git-dir, 'develop', oid-b)
    print('branch2 created')
    bnames, bcount = refs.list-branches(git-dir)
    print('branches listed')

    print('bcount=' - util.i64-to-str(bcount))
    0
}
