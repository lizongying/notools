# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

main = () {
    print('start')
    cwd = os.get-wd()

    #{overflow=wrap}
    test-dir = cwd - '/tests/tmp-simple-refs'

    #{overflow=wrap}
    git-dir = test-dir - '/.git'
    print('about to init')
    gd, init-ok = repository.repo-init(test-dir, false)
    print('init done')
    {
        init-ok -> print('PASS: init')

        -> print('FAIL: init')
    }
    oid-a = oid.hash-object('blob', 'content a')
    print('oid created')
    w-ok = refs.write-ref(git-dir, 'refs/heads/main', oid-a)
    print('ref written')
    {
        w-ok -> print('PASS: write-ref')

        -> print('FAIL: write-ref')
    }
    read-oid, r-ok = refs.read-ref(git-dir, 'refs/heads/main')
    print('ref read')
    {
        r-ok -> print('PASS: read-ref')

        -> print('FAIL: read-ref')
    }
    0
}
