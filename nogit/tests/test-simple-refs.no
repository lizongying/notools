# /nogit/src/util
# /nogit/src/oid
# /nogit/src/refs
# /nogit/src/repository

main = () {
    print('start')
    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-simple-refs'

    git-dir = test-dir - '/.git'
    print('about to init')
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok bool = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }
        nil || err -> { }
    }
    print('init done')
    {
        init-ok -> print('PASS: init')

        -> print('FAIL: init')
    }
    oid-a = oid.hash-object('blob', 'content a')
    print('oid created')
    w-ok = refs.write-ref(git-dir, 'refs/heads/main', oid-a)
    print('ref written')
    {
        w-ok -> print('PASS: write-ref')

        -> print('FAIL: write-ref')
    }
    read-oid-opt = refs.read-ref(git-dir, 'refs/heads/main')
    read-oid oid
    r-ok bool = false
    read-oid-opt: {
        ok -> {
            read-oid = read-oid-opt
            r-ok = true
        }
        nil || err -> { }
    }
    print('ref read')
    {
        r-ok -> print('PASS: read-ref')

        -> print('FAIL: read-ref')
    }
    0
}
