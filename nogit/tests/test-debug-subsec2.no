; Debug test for config-get with subsection

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-get subsection ---')

    cwd = os.get-wd()
    test-dir = cwd - '/tests/tmp-debug-sub2'
    git-dir = test-dir - '/.git'
    gd, init-ok = repository.repo-init(test-dir, false)

    config.config-set(git-dir, 'user', 'name', 'Test User')
    config.config-set(git-dir, 'remote.origin', 'url', 'git@example.com:repo.git')
    config.config-set(git-dir, 'remote.origin', 'fetch', '+refs/heads/*:refs/remotes/origin/*')
    print('all config-set done')

    ; read config to verify
    p = git-dir - '/config'
    content, file-ok = util.read-file-str(p)
    print('config content:')
    print(content)

    ; Test subsection lookup
    print('before config-get remote.origin url')
    ru, ru-ok = config.config-get(git-dir, 'remote.origin', 'url')
    print('after config-get remote.origin url')
    ru-ok == true -> print('ok, val=' - ru) -> print('fail')

    0
}
