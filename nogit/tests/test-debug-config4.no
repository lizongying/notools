; Debug test for config-set crash - inline the function

# /nogit/src/util
# /nogit/src/config
# /nogit/src/repository

main = () {
    print('--- Debug config-set inline ---')

    cwd = os.get-wd()

    test-dir = cwd - '/tests/tmp-debug-cfg4'

    git-dir = test-dir - '/.git'
    gd-opt = repository.repo-init(test-dir, false)
    gd str
    init-ok = false
    gd-opt: {
        ok -> {
            gd = gd-opt
            init-ok = true
        }

        nil || err -> {
        }
    }

    p = git-dir - '/config'
    content = ''
    content-opt = util.read-file-str(p)
    content-opt: {
        ok -> content = it

        nil -> {
        }

        err -> {
        }
    }
    print('content len=')
    print(content.len())

    ; inline parts of config-set to find crash
    sect-upper = config.to-lower-local('user')
    target-key-upper = config.to-lower-local('name')
    print('sect-upper=')
    print(sect-upper)
    print('target-key-upper=')
    print(target-key-upper)

    new-content = ''
    pos = 0
    in-section = false
    current-section = ''
    found-and-replaced = false
    section-found = false
    last-section-end = 0

    ; first iteration of the loop
    print('before first iteration')
    nl = util.find-byte-str(content, 10, pos)
    print('nl=')
    print(nl)
    end = content.len()
    nl >= 0 -> end = nl
    print('end=')
    print(end)
    line = util.str-range(content, pos, end)
    print('line=')
    print(line)
    trimmed = config.trim-ws(line)
    print('trimmed=')
    print(trimmed)
    print('trimmed.len=')
    print(trimmed.len())

    ; test starts-with
    print('before starts-with')
    starts = trimmed.starts-with('[')
    print('starts-with [ =')
    print(starts)
    print('after starts-with')

    0
}
