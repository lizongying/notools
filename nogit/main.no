; ═══════════════════════════════════════════════
; git write-tree
; ═══════════════════════════════════════════════

cmd-write-tree = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    names, hexoids, modes-str, count, index-ok = index.read-index(git-dir)
    index-ok == false -> {
        print('fatal: could not read index')
        return
    }
    ; Build a proper nested tree with subtrees for subdirectories
    tree-oid, tree-ok = object.build-tree-from-flat(git-dir, names, hexoids, modes-str, count)
    tree-ok == false -> {
        print('fatal: could not build tree')
        return
    }
    ch = oid.oid-hex-str(tree-oid)
    print(ch)
}

; ═══════════════════════════════════════════════
