; ═══════════════════════════════════════════════

cmd-update-ref = (argc i64) {
    argc < 3 -> {
        print('usage: git update-ref <ref> <oid>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    ref = os.arg(2)
    val = os.arg(3)
    o, ref-ok = revwalk.resolve-ref(git-dir, val)
    {
        ref-ok == false -> {
            o, ref-ok = oid.oid-from-hex(val)
            ref-ok == false -> {
                print('fatal: could not resolve {val}')
                return
            }
        }
    }
    refs.write-ref(git-dir, ref, o)
}

; ═══════════════════════════════════════════════
; git config
; ═══════════════════════════════════════════════

cmd-config = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    {
        repo-ok == false -> {
            print('fatal: not a git repository')
            return
        }
        argc < 2 -> {
            print('usage: git config <section.key> [value]')
            return
        }
    }
    key = os.arg(2)
    dot = util.find-byte-str(key, 46, 0)
    dot < 0 -> {
        print('invalid key format, use section.key')
        return
    }
    section = util.str-range(key, 0, dot)
    skey = util.str-range(key, dot + 1, key.len)
    {
        argc >= 3 -> {
            val = os.arg(3)
            config.config-set(git-dir, section, skey, val)
        }
        -> {
            val, get-ok = config.config-get(git-dir, section, skey)
            get-ok == true -> print(val)
            get-ok == false -> print('')
        }
    }
}

; ═══════════════════════════════════════════════
; git reflog
; ═══════════════════════════════════════════════

cmd-reflog = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    content, read-ok = refs.read-reflog(git-dir, 'HEAD')
    read-ok == false -> {
        print('no reflog')
        return
    }
    print(content)
}

; ═══════════════════════════════════════════════
; git show
; ═══════════════════════════════════════════════

cmd-show = (argc i64) {
    argc < 2 -> {
        print('usage: git show <ref>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    ref = os.arg(2)
    o, ref-ok = revwalk.resolve-ref(git-dir, ref)
    ref-ok == false -> {
        print('fatal: could not resolve {ref}')
        return
    }
    kind, data, read-ok = object.read-loose(git-dir, o)
    read-ok == false -> {
        kind, data, read-ok = pack.read-packed-object(git-dir, o)
    }
    read-ok == false -> {
        print('fatal: object not found')
        return
    }
    print('type: {kind}')
    ch = oid.oid-hex-str(o)
    print('oid: {ch}')
    print('')
    print(data)
}

; ═══════════════════════════════════════════════
; git rm
; ═══════════════════════════════════════════════

cmd-rm = (argc i64) {
    argc < 2 -> {
        print('usage: git rm <path>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    cached = false
    i <- [1..argc): {
        arg = os.arg(i + 1)
        arg == '--cached' -> cached = true
    }
    path = os.arg(2)
    path == '--cached' -> {
        argc < 3 -> {
            print('usage: git rm --cached <path>')
            return
        }
        path = os.arg(3)
    }

    ; Remove from index
    ok = index.index-remove(git-dir, path)
    ok == false -> {
        print('fatal: could not remove {path} from index')
        return
    }

    ; Remove from working tree unless --cached
    cached == false -> {
        full-path = path
        work-tree.len > 0 -> {
            sl = '/'
            full-path = work-tree - sl - path
        }
        fs.remove(full-path)
    }
    print('rm {path}')
}

; ═══════════════════════════════════════════════
; git reset
; ═══════════════════════════════════════════════

cmd-reset = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }

    ; Check for --hard flag
    hard = false
    target = 'HEAD'
    i <- [1..argc): {
        arg = os.arg(i + 1)
        arg == '--hard' -> hard = true
        arg != '--hard' -> target = arg
    }

    ; Resolve the target ref to an oid
    target-oid, target-ok = revwalk.resolve-ref(git-dir, target)
    target-ok == false -> {
        print('fatal: could not resolve {target}')
        return
    }

    ; Reset HEAD to the target
    branch, detached, branch-ok = refs.current-branch(git-dir)
    {
        branch-ok == true && detached == false -> {
            ref-name = 'refs/heads/' - branch
            refs.write-ref(git-dir, ref-name, target-oid)
        }
        -> {
            refs.set-head-detached(git-dir, target-oid)
        }
    }

    ; Read the target's tree and rebuild index + worktree
    tree-oid, tree-ok = revwalk.commit-tree-oid(git-dir, target-oid)
    tree-ok == true -> {
        ; Rebuild index from the tree
        flat-paths, flat-hexoids, flat-modes, flat-count, flat-ok = tree-to-flat-unified(git-dir, tree-oid, '')
        flat-ok == true -> {
            index.write-index(git-dir, flat-paths, flat-hexoids, flat-modes, flat-count)
        }

        ; --hard: also restore working tree
        hard == true -> {
            ; Remove files not in the target tree
            object.remove-stale-files(git-dir, tree-oid, work-tree)

            co-ok = checkout-tree-unified(git-dir, tree-oid, work-tree)
            co-ok == false -> {
                print('warning: could not fully restore working tree')
            }
        }
    }
    print('Reset to {target}')
}
