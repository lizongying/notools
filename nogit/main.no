; main — Git CLI entry point and command dispatcher
;
; Implements the modern Git command set in pure Nolang (no system git binary).
; Commands: init, add, commit, log, status, branch, checkout, tag,
;           show, cat-file, hash-object, ls-tree, ls-files, rev-parse,
;           write-tree, update-ref, config, reflog, rm, reset
;
; Usage: no run nogit <command> [args...]

# /nogit/src/util
# /nogit/src/oid
# /nogit/src/object
# /nogit/src/refs
# /nogit/src/config
# /nogit/src/index
# /nogit/src/repository
# /nogit/src/revwalk
# /nogit/src/zlib
# /nogit/src/pack

; os.arg(0) returns the program path (argv[0]), so we subtract 1 from
; argc and add 1 to every arg index to skip the program name.
main = () {
    argc = os.args() - 1
    argc < 1 -> {
        print-usage()
        return
    }
    cmd = os.arg(1)
    cmd: {
        'init' -> cmd-init(argc)
        'add' -> cmd-add(argc)
        'commit' -> cmd-commit(argc)
        'log' -> cmd-log(argc)
        'status' -> cmd-status(argc)
        'branch' -> cmd-branch(argc)
        'checkout' -> cmd-checkout(argc)
        'tag' -> cmd-tag(argc)
        'show' -> cmd-show(argc)
        'cat-file' -> cmd-cat-file(argc)
        'hash-object' -> cmd-hash-object(argc)
        'ls-tree' -> cmd-ls-tree(argc)
        'ls-files' -> cmd-ls-files(argc)
        'rev-parse' -> cmd-rev-parse(argc)
        'write-tree' -> cmd-write-tree(argc)
        'rm' -> cmd-rm(argc)
        'reset' -> cmd-reset(argc)
        'update-ref' -> cmd-update-ref(argc)
        'config' -> cmd-config(argc)
        'reflog' -> cmd-reflog(argc)
        'version' -> print('nolang-git v0.1.0 (pure nolang)')
        'help' -> print-usage()
        -> {
            print('unknown command: {cmd}')
            print-usage()
        }
    }
}

; ═══════════════════════════════════════════════
; usage
; ═══════════════════════════════════════════════

print-usage = () {
    print('nolang-git — pure Nolang Git implementation')
    print('')
    print('Usage: git <command> [args]')
    print('')
    print('Commands:')
    print('  init [path]       Create a new repository')
    print('  add <path>        Stage a file')
    print('  commit -m <msg>   Create a commit')
    print('  log [count]       Show commit history')
    print('  status            Show working tree status')
    print('  branch [name]     List or create branches')
    print('  checkout <name>   Switch branches')
    print('  tag <name>        Create a tag')
    print('  show <ref>        Show object content')
    print('  cat-file <t> <r>  Show object by type and ref')
    print('  hash-object <p>   Hash a file (write to store)')
    print('  ls-tree <ref>     List tree contents')
    print('  ls-files          List index contents')
    print('  rev-parse <ref>   Resolve ref to oid')
    print('  write-tree        Write tree from index')
    print('  rm <path>         Remove from index')
    print('  reset [ref]       Reset HEAD/index')
    print('  update-ref <r> <v> Update a ref')
    print('  config <s.k> [v]  Get or set config')
    print('  reflog            Show reflog')
    print('  version           Show version')
}

; ═══════════════════════════════════════════════
; local helpers
; ═══════════════════════════════════════════════

read-worktree-file = (work-tree str, path str) (content str, ok bool) {
    sl = '/'
    full = work-tree - sl - path
    work-tree.len > 0 -> {
        last = work-tree[work-tree.len - 1]
        last == 47 -> full = work-tree - path
    }
    content, ok = util.read-file-str(full)
}

; read-object-unified: try loose first, then packed.
read-object-unified = (git-dir str, o oid) (kind str, data str, ok bool) {
    kind, data, ok = object.read-loose(git-dir, o)
    ok == false -> {
        kind, data, ok = pack.read-packed-object(git-dir, o)
    }
}

; tree-to-flat-unified: like object.tree-to-flat but supports packed repos.
; Uses read-object-unified instead of read-loose.
tree-to-flat-unified = (git-dir str, tree-oid oid, prefix str) (paths str, hexoids str, modes str, count i64, ok bool) {
    ok = false
    paths = ''
    hexoids = ''
    modes = ''
    count = 0

    ; read tree object (loose or packed)
    kind str
    raw str
    read-ok bool
    kind, raw, read-ok = read-object-unified(git-dir, tree-oid)
    read-ok == false -> return

    ; parse tree entries
    n = object.tree-count-raw(raw)
    i <- [0..n): {
        mode = object.tree-mode-raw(raw, i)
        nm = object.tree-name-raw(raw, i)
        entry-oid = object.tree-id-raw(raw, i)
        entry-hex = oid.oid-hex-str(entry-oid)

        ; build full path
        full-path = nm
        prefix.len > 0 -> {
            full-path = prefix - '/' - nm
        }

        mode == 16384 -> {
            ; subtree — recurse
            sub-paths, sub-hexoids, sub-modes, sub-count, sub-ok = tree-to-flat-unified(git-dir, entry-oid, full-path)
            sub-ok == true -> {
                paths = paths - sub-paths
                hexoids = hexoids - sub-hexoids
                modes = modes - sub-modes
                count = count + sub-count
            }
        }

        -> {
            ; blob — add as flat entry
            paths = paths - full-path - '\n'
            hexoids = hexoids - entry-hex
            mode-str = util.i64-to-str(mode)
            modes = modes - mode-str - '\n'
            count = count + 1
        }
    }
    ok = true
}

; checkout-tree-unified: like object.checkout-tree but supports packed repos.
; Uses read-object-unified to read tree and blob objects.
checkout-tree-unified = (git-dir str, tree-oid oid, dest-dir str) (ok bool) {
    ok = false

    ; read tree object (loose or packed)
    kind str
    raw str
    read-ok bool
    kind, raw, read-ok = read-object-unified(git-dir, tree-oid)
    read-ok == false -> return

    ; parse tree entries
    n = object.tree-count-raw(raw)
    i <- [0..n): {
        mode = object.tree-mode-raw(raw, i)
        nm = object.tree-name-raw(raw, i)
        entry-oid = object.tree-id-raw(raw, i)

        ; build full path
        full-path = dest-dir
        dest-dir.len > 0 -> {
            last = dest-dir[dest-dir.len - 1]
            last != 47 -> full-path = dest-dir - '/' - nm
        }
        dest-dir.len == 0 -> full-path = nm

        mode == 16384 -> {
            ; subtree — create directory and recurse
            util.mkdir-all(full-path)
            sub-ok = checkout-tree-unified(git-dir, entry-oid, full-path)
        }

        -> {
            ; blob — read object and write to file
            b-kind str
            b-data str
            b-ok bool
            b-kind, b-data, b-ok = read-object-unified(git-dir, entry-oid)
            b-ok == true -> {
                ; ensure parent directory exists
                slash = full-path.rindex('/')
                slash >= 0 -> {
                    parent = util.str-range(full-path, 0, slash)
                    util.mkdir-all(parent)
                }
                util.write-file-simple(full-path, b-data)
            }
        }
    }
    ok = true
}

; log-packed: manual commit walk for packed repos (fallback when revwalk fails)
; Walks first-parent chain using read-object-unified.
log-packed = (git-dir str, oneline bool, max-count i64) {
    start-oid, ref-ok = refs.read-ref(git-dir, 'HEAD')
    ref-ok == false -> return
    cur = start-oid
    count i64 = 0
    {
        count >= 10000 -> break
        max-count > 0 -> {
            count >= max-count -> break
        }
        k str
        d str
        read-ok bool
        k, d, read-ok = read-object-unified(git-dir, cur)
        read-ok == false -> break
        ; parse commit: tree, parent, author, message
        cur-hex = oid.oid-hex-str(cur)
        idx i64 = d.index('\n\n')
        hend = d.len
        idx >= 0 -> hend = idx
        msg = ''
        idx >= 0 -> msg = util.str-range(d, idx + 2, d.len)
        parent-hex str = ''
        a-name str = ''
        a-email str = ''
        a-time i64 = 0
        a-tz str = ''
        pos = 0
        {
            pos >= hend -> break
            nl i64 = util.find-byte-str(d, 10, pos)
            nl < 0 -> nl = hend
            line str = util.str-range(d, pos, nl)
            line.starts-with('parent ') -> {
                parent-hex = util.str-range(line, 7, line.len)
            }
            line.starts-with('author ') -> {
                ap str = util.str-range(line, 7, line.len)
                a-name, a-email, a-time, a-tz = object.parse-person-fields(ap)
            }
            pos = nl + 1
        } (true)
        oneline == true -> {
            short-hex = util.str-range(cur-hex, 0, 7)
            ; first line of message
            ml = msg.len
            mnl = util.find-byte-str(msg, 10, 0)
            mnl >= 0 -> ml = mnl
            first-line = util.str-range(msg, 0, ml)
            print('{short-hex} {first-line}')
        }
        -> {
            print('commit ' - cur-hex)
            print('Author: ' - a-name - ' <' - a-email - '>')
            print('Date:   ' - util.i64-to-str(a-time) - ' ' - a-tz)
            print('')
            print('    ' - msg)
            print('')
        }
        count = count + 1
        parent-hex.len == 40 -> {
            cur, ref-ok = oid.oid-from-hex(parent-hex)
            ref-ok == false -> break
        }
        parent-hex.len == 0 -> break
        parent-hex.len > 40 -> {
            ; multiple parents — take first
            first-hex = util.str-range(parent-hex, 0, 40)
            cur, ref-ok = oid.oid-from-hex(first-hex)
            ref-ok == false -> break
        }
    } (true)
}

; ═══════════════════════════════════════════════
; git init
; ═══════════════════════════════════════════════

cmd-init = (argc i64) {
    path = '.'
    bare = false
    i <- [1..argc): {
        arg = os.arg(i + 1)
        arg == '--bare' -> bare = true
        arg == '-q' -> {}
        -> path = arg
    }
    cwd = os.get-wd()
    full-path = path
    {
        path == '.' -> full-path = cwd
        path.starts-with('/') -> full-path = path
        path.starts-with('.') -> {
            sl = '/'
            {
                path.starts-with('./') -> {
                    full-path = cwd - sl - util.str-range(path, 2, path.len)
                }
                -> {
                    full-path = cwd - sl - path
                }
            }
        }
    }
    git-dir, ok = repository.repo-init(full-path, bare)
    ok == false -> {
        print('fatal: could not initialize repository')
        return
    }
    print('Initialized empty Git repository in {git-dir}')
}

; ═══════════════════════════════════════════════
; git add
; ═══════════════════════════════════════════════

cmd-add = (argc i64) {
    argc < 2 -> {
        print('usage: git add <path>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    i <- [1..argc): {
        path = os.arg(i + 1)
        path == '--' -> {}

        path == '.' -> {
            ; Add all files in current directory recursively
            add-directory-recursive(git-dir, work-tree, work-tree, '')
        }

        path.starts-with('./') -> {
            clean-path = util.str-range(path, 2, path.len)
            clean-path.len == 0 -> {
                ; path is './' — add entire work tree
                add-directory-recursive(git-dir, work-tree, work-tree, '')
            }
            -> {
                full-path = work-tree - '/' - clean-path
                add-file-or-dir(git-dir, work-tree, full-path, clean-path)
            }
        }

        path.starts-with('/') -> {
            ; absolute path — try to add relative to work-tree
            add-file-or-dir(git-dir, work-tree, path, path)
        }

        -> {
            ; relative path
            full-path = work-tree - '/' - path
            add-file-or-dir(git-dir, work-tree, full-path, path)
        }
    }
}

; add-directory-recursive: recursively add all files in a directory
; Uses a single skip-check function to avoid && chain issues.
; git-dir str, work-tree str, dir-path str (absolute), rel-prefix str (relative prefix)
add-directory-recursive = (git-dir str, work-tree str, dir-path str, rel-prefix str) {
    dirp = fs.open-dir(dir-path)
    dirp == 0 -> return
    fe-ok = true
    {
        fe-ok == false -> break
        fname, fe-ok = fs.read-dir(dirp)
        fe-ok == true -> {
            ; Inline skip check to avoid function return value issues
            fl = fname.len
            proceed = true
            fl == 1 -> {
                fname[0] == 46 -> proceed = false
            }
            fl == 2 -> {
                c0 = fname[0]
                c0 == 46 -> {
                    c1 = fname[1]
                    c1 == 46 -> proceed = false
                }
            }
            fl == 4 -> {
                c0 = fname[0]
                c0 == 46 -> {
                    c1 = fname[1]
                    c1 == 103 -> {
                        c2 = fname[2]
                        c2 == 105 -> {
                            c3 = fname[3]
                            c3 == 116 -> proceed = false
                        }
                    }
                }
            }
            proceed == true -> {
                sub-full = dir-path - '/' - fname
                sub-rel = fname
                rel-prefix.len > 0 -> sub-rel = rel-prefix - '/' - fname
                add-file-or-dir(git-dir, work-tree, sub-full, sub-rel)
            }
        }
    } (true)
    fs.close-dir(dirp)
}

; add-file-or-dir: add a single file or recursively add all files in a directory
; git-dir str, work-tree str, full-path str (absolute path), rel-path str (relative to work-tree)
add-file-or-dir = (git-dir str, work-tree str, full-path str, rel-path str) {
    ; Normalize rel-path: strip leading "./" and reject "."
    rel-path == '.' -> return
    rel-path.starts-with('./') -> {
        rel-path = util.str-range(rel-path, 2, rel-path.len)
    }
    isf = fs.is-file(full-path)
    isf == true -> {
        content, read-ok = util.read-file-str(full-path)
        read-ok == false -> {
            print('fatal: could not read {rel-path}')
            return
        }
        blob-oid = object.write-blob(git-dir, content)
        index-ok = index.index-add(git-dir, rel-path, blob-oid, 33188)
        index-ok == false -> {
            print('fatal: could not stage {rel-path}')
        }
        return
    }
    isd = fs.is-dir(full-path)
    isd == true -> {
        add-directory-recursive(git-dir, work-tree, full-path, rel-path)
        return
    }
    print('fatal: pathspec {rel-path} did not match any files')
}

; ═══════════════════════════════════════════════
; git commit
; ═══════════════════════════════════════════════

cmd-commit = (argc i64) {
    message = ''
    i <- [1..argc): {
        arg = os.arg(i + 1)
        arg == '-m' -> {
            i < argc - 1 -> {
                message = os.arg(i + 2)
            }
        }
    }
    message == '' -> {
        print('usage: git commit -m <message>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    names, hexoids, modes-str, count, index-ok = index.read-index(git-dir)
    {
        index-ok == false -> {
            print('nothing to commit (empty index)')
            return
        }
        count == 0 -> {
            print('nothing to commit (empty index)')
            return
        }
    }
    ; Build a proper nested tree with subtrees for subdirectories
    tree-oid, tree-ok = object.build-tree-from-flat(git-dir, names, hexoids, modes-str, count)
    tree-ok == false -> {
        print('fatal: could not build tree')
        return
    }
    parent-oid, parent-ok = refs.read-ref(git-dir, 'HEAD')
    parenthex = ''
    parent-ok == true -> parenthex = oid.oid-hex-str(parent-oid)

    ; Check for empty commit — if HEAD tree matches the new tree, nothing changed
    parent-ok == true -> {
        head-tree-oid, ht-ok = revwalk.commit-tree-oid(git-dir, parent-oid)
        ht-ok == true -> {
            same-tree = oid.eq(head-tree-oid, tree-oid)
            same-tree == true -> {
                print('nothing to commit, working tree clean')
                return
            }
        }
    }
    a-name, a-ok = config.get-user-name(git-dir)
    {
        a-ok == false -> {
            a-name = 'Unknown'
            a-email = 'unknown@example.com'
        }
        -> {
            a-email, a-ok = config.get-user-email(git-dir)
            a-ok == false -> a-email = 'unknown@example.com'
        }
    }
    now = os.now()
    tz = '+0000'
    commit-oid = object.write-commit-full(git-dir, tree-oid, parenthex, a-name, a-email, now, tz, a-name, a-email, now, tz, message)
    branch, detached, branch-ok = refs.current-branch(git-dir)

    ; Update refs
    ref-name = 'refs/heads/' - branch
    commit-msg = 'commit: ' - message
    initial-msg = 'commit (initial): ' - message
    {
        branch-ok == true -> {
            detached == false -> {
                refs.write-ref(git-dir, ref-name, commit-oid)
                refs.write-reflog(git-dir, 'HEAD', parent-oid, commit-oid, a-name, a-email, now, tz, commit-msg)
                refs.write-reflog(git-dir, ref-name, parent-oid, commit-oid, a-name, a-email, now, tz, commit-msg)
            }
            -> {
                refs.set-head-detached(git-dir, commit-oid)
            }
        }
        -> {
            refs.create-branch(git-dir, 'main', commit-oid)
            refs.update-head(git-dir, 'refs/heads/main')
            refs.write-reflog(git-dir, 'HEAD', oid.zero-oid(), commit-oid, a-name, a-email, now, tz, initial-msg)
        }
    }

    ; Print result
    ch = oid.oid-hex-str(commit-oid)
    {
        branch-ok == true -> {
            detached == false -> {
                line = '[' - branch
                line = line - ' '
                line = line - ch
                line = line - '] '
                line = line - message
                print(line)
            }
            -> {
                print('HEAD detached at {ch}')
            }
        }
        -> {
            print('[main {ch}] {message}')
        }
    }
}

; ═══════════════════════════════════════════════
; git log
; ═══════════════════════════════════════════════

cmd-log = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    max-count = 0
    oneline = false
    i <- [1..argc): {
        arg = os.arg(i + 1)
        arg == '-n' -> {
            i < argc - 1 -> {
                nstr = os.arg(i + 2)
                nstr.len > 0 -> {
                    nv = 0
                    k <- [0..nstr.len): {
                        nv = nv * 10 + (nstr[k] - 48)
                    }
                    max-count = nv
                }
            }
        }
        arg == '--oneline' -> oneline = true
    }
    oneline == true -> {
        log-output, log-ok = revwalk.revwalk-format-log-oneline(git-dir, 'HEAD', max-count)
        log-ok == false -> {
            log-packed(git-dir, true, max-count)
            return
        }
        log-output.len == 0 -> {
            log-packed(git-dir, true, max-count)
            return
        }
        print(log-output)
    }
    oneline == false -> {
        log-output, log-ok = revwalk.revwalk-format-log(git-dir, 'HEAD', max-count)
        log-ok == false -> {
            log-packed(git-dir, false, max-count)
            return
        }
        log-output.len == 0 -> {
            log-packed(git-dir, false, max-count)
            return
        }
        print(log-output)
    }
}

; ═══════════════════════════════════════════════
; git status
; ═══════════════════════════════════════════════

cmd-status = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    branch, detached, branch-ok = refs.current-branch(git-dir)
    {
        branch-ok == true -> {
            detached == false -> print('On branch {branch}')
            detached == true -> print('HEAD detached')
        }
        -> {
            print('On branch main (no commits yet)')
        }
    }
    print('')
    names, hexoids, modes-str, count, index-ok = index.read-index(git-dir)
    count == 0 -> {
        print('nothing to commit')
        return
    }

    ; Check if we have a HEAD commit to compare against
    head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
    has-head = head-ok

    ; If we have a HEAD, get the flat file list from the tree
    head-flat-names str = ''
    head-flat-oids str = ''
    head-flat-count i64 = 0
    has-head == true -> {
        head-tree-oid, head-ok = revwalk.commit-tree-oid(git-dir, head-oid)
        has-head = head-ok
        has-head == true -> {
            head-flat-names, head-flat-oids, head-flat-modes, head-flat-count, head-flat-ok = tree-to-flat-unified(git-dir, head-tree-oid, '')
            head-flat-ok == false -> {
                has-head = false
            }
        }
    }

    staged-names str = ''
    staged-count i64 = 0
    modified-names str = ''
    modified-count i64 = 0

    ; Compare each index entry against HEAD tree and working tree
    pos = 0
    i <- [0..count): {
        nl = util.find-byte-str(names, 10, pos)
        end = names.len
        nl >= 0 -> end = nl
        nm = util.str-range(names, pos, end)
        hx = util.str-range(hexoids, i * 40, i * 40 + 40)

        ; Check against HEAD tree (staged changes)
        in-head = false
        head-matches = false
        has-head == true -> {
            ; Search for this file in the flat HEAD file list
            hpos = 0
            j <- [0..head-flat-count): {
                hnl = util.find-byte-str(head-flat-names, 10, hpos)
                hend = head-flat-names.len
                hnl >= 0 -> hend = hnl
                hnm = util.str-range(head-flat-names, hpos, hend)
                same-nm = util.str-eq(hnm, nm)
                same-nm == true -> {
                    in-head = true
                    hhex = util.str-range(head-flat-oids, j * 40, j * 40 + 40)
                    head-matches = util.str-eq(hhex, hx)
                    break
                }
                hpos = hnl + 1
                hnl < 0 -> break
            }
        }

        ; Determine staged status
        {
            has-head == false -> {
                ; No HEAD — everything is "new file"
                staged-names = staged-names - 'new file: ' - nm - '\n'
                staged-count = staged-count + 1
            }

            has-head == true -> {
                in-head == false -> {
                    ; File not in HEAD tree — new file
                    staged-names = staged-names - 'new file: ' - nm - '\n'
                    staged-count = staged-count + 1
                }
                in-head == true -> {
                    head-matches == false -> {
                        ; File in HEAD but content differs — modified
                        staged-names = staged-names - 'modified: ' - nm - '\n'
                        staged-count = staged-count + 1
                    }
                }
            }
        }

        ; Check working tree (modified files)
        work-file = nm
        work-tree.len > 0 -> {
            sl = '/'
            work-file = work-tree - sl - nm
        }
        isf = fs.is-file(work-file)
        isf == false -> {
            modified-names = modified-names - 'deleted: ' - nm - '\n'
            modified-count = modified-count + 1
        }
        isf == true -> {
            ; Read work tree file and compare hash
            w-content, w-ok = util.read-file-str(work-file)
            w-ok == true -> {
                w-oid = oid.hash-object('blob', w-content)
                w-hex = oid.oid-hex-str(w-oid)
                w-matches = util.str-eq(w-hex, hx)
                w-matches == false -> {
                    modified-names = modified-names - 'modified: ' - nm - '\n'
                    modified-count = modified-count + 1
                }
            }
        }

        pos = nl + 1
        nl < 0 -> break
    }

    ; Print staged changes
    staged-count > 0 -> {
        print('Changes to be committed:')
        spos = 0
        {
            spos >= staged-names.len -> break
            snl = util.find-byte-str(staged-names, 10, spos)
            send = staged-names.len
            snl >= 0 -> send = snl
            sline = util.str-range(staged-names, spos, send)
            print('  ' - sline)
            spos = snl + 1
            snl < 0 -> break
        } (true)
        print('')
    }

    ; Print modified (not staged) changes
    modified-count > 0 -> {
        print('Changes not staged for commit:')
        mpos = 0
        {
            mpos >= modified-names.len -> break
            mnl = util.find-byte-str(modified-names, 10, mpos)
            mend = modified-names.len
            mnl >= 0 -> mend = mnl
            mline = util.str-range(modified-names, mpos, mend)
            print('  ' - mline)
            mpos = mnl + 1
            mnl < 0 -> break
        } (true)
        print('')
    }

    ; Detect untracked files — files in work tree not in index
    untracked-names str = ''
    untracked-count i64 = 0
    work-tree.len > 0 -> {
        untracked-names, untracked-count = scan-untracked(work-tree, work-tree, names, count)
    }

    ; Print untracked files
    untracked-count > 0 -> {
        print('Untracked files:')
        upos = 0
        {
            upos >= untracked-names.len -> break
            unl = util.find-byte-str(untracked-names, 10, upos)
            uend = untracked-names.len
            unl >= 0 -> uend = unl
            uline = util.str-range(untracked-names, upos, uend)
            print('  ' - uline)
            upos = unl + 1
            unl < 0 -> break
        } (true)
        print('')
    }

    staged-count == 0 && modified-count == 0 && untracked-count == 0 -> {
        print('nothing to commit, working tree clean')
    }
}

; scan-untracked: recursively scan work tree for files not in index
; base-dir str (root work tree dir), dir str (current dir being scanned),
; index-names str (newline-separated), index-count i64
; returns untracked-names str (newline-sep), untracked-count i64
scan-untracked = (base-dir str, dir str, index-names str, index-count i64) (untracked-names str, untracked-count i64) {
    untracked-names = ''
    untracked-count = 0
    dirp = fs.open-dir(dir)
    dirp == 0 -> return
    fe-ok = true
    {
        fe-ok == false -> break
        fname, fe-ok = fs.read-dir(dirp)
        fe-ok == true -> {
            ; skip . and .. and .git
            is-dot = util.str-eq(fname, '.')
            is-dotdot = util.str-eq(fname, '..')
            is-git = util.str-eq(fname, '.git')
            is-dot == false && is-dotdot == false && is-git == false -> {
                full-path = dir - '/' - fname
                ; compute relative path from base-dir
                rel-path = fname
                base-len = base-dir.len
                full-len = full-path.len
                full-len > base-len -> {
                    ; skip base-dir + '/' prefix
                    rel-path = util.str-range(full-path, base-len + 1, full-len)
                }
                isf = fs.is-file(full-path)
                isf == true -> {
                    ; check if this file is in index
                    in-index = false
                    pos = 0
                    j <- [0..index-count): {
                        nl = util.find-byte-str(index-names, 10, pos)
                        end = index-names.len
                        nl >= 0 -> end = nl
                        nm = util.str-range(index-names, pos, end)
                        same = util.str-eq(nm, rel-path)
                        same == true -> {
                            in-index = true
                            break
                        }
                        pos = nl + 1
                        nl < 0 -> break
                    }
                    in-index == false -> {
                        untracked-names = untracked-names - rel-path - '\n'
                        untracked-count = untracked-count + 1
                    }
                }
                isf == false -> {
                    isd = fs.is-dir(full-path)
                    isd == true -> {
                        ; recursively scan subdirectory
                        sub-names, sub-count = scan-untracked(base-dir, full-path, index-names, index-count)
                        untracked-names = untracked-names - sub-names
                        untracked-count = untracked-count + sub-count
                    }
                }
            }
        }
    } (true)
    fs.close-dir(dirp)
}

; ═══════════════════════════════════════════════
; git branch
; ═══════════════════════════════════════════════

cmd-branch = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    ; Check for -d (delete) flag
    argc >= 2 -> {
        arg2 = os.arg(2)
        arg2 == '-d' -> {
            argc < 3 -> {
                print('usage: git branch -d <name>')
                return
            }
            del-name = os.arg(3)
            ok = refs.delete-branch(git-dir, del-name)
            {
                ok == true -> print('Deleted branch {del-name}')
                ok == false -> print('error: branch not found')
            }
            return
        }
    }
    {
        argc >= 2 -> {
            name = os.arg(2)
            head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
            head-ok == false -> {
                print('fatal: no HEAD ref')
                return
            }
            ok = refs.create-branch(git-dir, name, head-oid)
            {
                ok == false -> {
                    print('fatal: branch {name} already exists')
                }
                -> {
                    print('Created branch {name}')
                }
            }
            return
        }
    }
    names, count = refs.list-branches(git-dir)
    cur-branch, _det, cur-ok = refs.current-branch(git-dir)
    pos = 0
    {
        pos >= names.len -> break
        nl = util.find-byte-str(names, 10, pos)
        end = names.len
        nl >= 0 -> end = nl
        nm = util.str-range(names, pos, end)
        is-cur = true
        nm.len != cur-branch.len -> is-cur = false
        is-cur == true -> {
            j <- [0..nm.len): {
                nm[j] != cur-branch[j] -> {
                    is-cur = false
                    break
                }
            }
        }
        is-cur == true -> print('* {nm}')
        is-cur == false -> print('  {nm}')
        pos = nl + 1
        nl < 0 -> break
    } (true)
}

; ═══════════════════════════════════════════════
; git checkout
; ═══════════════════════════════════════════════

cmd-checkout = (argc i64) {
    argc < 2 -> {
        print('usage: git checkout <branch> [-- <file>...]')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }

    ; Check for -- separator (checkout files mode)
    has-separator = false
    file-start = argc
    i <- [1..argc): {
        a = os.arg(i + 1)
        a == '--' -> {
            has-separator = true
            file-start = i + 1
        }
    }

    ; File checkout mode: restore specific files from HEAD/tree
    has-separator == true -> {
        head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
        head-ok == false -> {
            print('fatal: no HEAD ref')
            return
        }
        tree-oid, tree-ok = revwalk.commit-tree-oid(git-dir, head-oid)
        tree-ok == false -> {
            print('fatal: could not read commit tree')
            return
        }

        ; Get flat file list from tree
        flat-paths, flat-hexoids, flat-modes, flat-count, flat-ok = tree-to-flat-unified(git-dir, tree-oid, '')
        flat-ok == false -> {
            print('fatal: could not read tree')
            return
        }

        ; Restore each requested file
        j <- [file-start..argc): {
            req-file = os.arg(j + 1)
            ; find this file in the flat list
            pos = 0
            i2 <- [0..flat-count): {
                nl = util.find-byte-str(flat-paths, 10, pos)
                end = flat-paths.len
                nl >= 0 -> end = nl
                nm = util.str-range(flat-paths, pos, end)
                same = util.str-eq(nm, req-file)
                same == true -> {
                    ; read blob and restore
                    hx = util.str-range(flat-hexoids, i2 * 40, i2 * 40 + 40)
                    file-oid, oid-ok = oid.oid-from-hex(hx)
                    oid-ok == true -> {
                        b-kind, b-data, b-read-ok = object.read-loose(git-dir, file-oid)
                        b-read-ok == true -> {
                            full-path = req-file
                            work-tree.len > 0 -> {
                                full-path = work-tree - '/' - req-file
                            }
                            ; ensure parent dir
                            slash = full-path.rindex('/')
                            slash >= 0 -> {
                                parent = util.str-range(full-path, 0, slash)
                                util.mkdir-all(parent)
                            }
                            util.write-file-simple(full-path, b-data)
                        }
                    }
                    break
                }
                pos = nl + 1
                nl < 0 -> break
            }
        }
        print('Restored files from HEAD')
        return
    }

    ; Branch checkout mode
    name = os.arg(2)
    ref-name = 'refs/heads/' - name
    o, ref-ok = refs.read-ref(git-dir, ref-name)
    ref-ok == false -> {
        print('error: pathspec {name} did not match any branch')
        return
    }

    ; Read the commit to get the tree oid
    tree-oid, tree-ok = revwalk.commit-tree-oid(git-dir, o)
    tree-ok == true -> {
        ; Remove files that are in the work tree but not in the target tree
        object.remove-stale-files(git-dir, tree-oid, work-tree)

        ; Restore working tree from the commit's tree
        co-ok = checkout-tree-unified(git-dir, tree-oid, work-tree)
        co-ok == false -> {
            print('warning: could not fully restore working tree')
        }

        ; Rebuild index from the tree
        flat-paths, flat-hexoids, flat-modes, flat-count, flat-ok = tree-to-flat-unified(git-dir, tree-oid, '')
        flat-ok == true -> {
            index.write-index(git-dir, flat-paths, flat-hexoids, flat-modes, flat-count)
        }
    }

    refs.update-head(git-dir, ref-name)
    print('Switched to branch {name}')
}

; ═══════════════════════════════════════════════
; git tag
; ═══════════════════════════════════════════════

cmd-tag = (argc i64) {
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    ; Check for -d (delete) flag
    argc >= 2 -> {
        arg2 = os.arg(2)
        arg2 == '-d' -> {
            argc < 3 -> {
                print('usage: git tag -d <name>')
                return
            }
            del-name = os.arg(3)
            ok = refs.delete-tag(git-dir, del-name)
            {
                ok == true -> print('Deleted tag {del-name}')
                ok == false -> print('error: tag not found')
            }
            return
        }
        arg2 == '-a' -> {
            ; Annotated tag: git tag -a <name> -m <message>
            argc < 3 -> {
                print('usage: git tag -a <name> -m <message>')
                return
            }
            tag-name = os.arg(3)
            tag-msg = ''
            i <- [4..argc): {
                a = os.arg(i + 1)
                a == '-m' -> {
                    i < argc - 1 -> {
                        tag-msg = os.arg(i + 2)
                    }
                }
            }
            tag-msg == '' -> tag-msg = 'tag {tag-name}'
            head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
            head-ok == false -> {
                print('fatal: no HEAD ref')
                return
            }
            a-name, a-ok = config.get-user-name(git-dir)
            {
                a-ok == false -> {
                    a-name = 'Unknown'
                    a-email = 'unknown@example.com'
                }
                -> {
                    a-email, a-ok = config.get-user-email(git-dir)
                    a-ok == false -> a-email = 'unknown@example.com'
                }
            }
            now = os.now()
            tz = '+0000'
            tag-oid = object.write-tag-full(git-dir, head-oid, 'commit', tag-name, a-name, a-email, now, tz, tag-msg)
            ; Create the tag ref pointing to the tag object
            ref-ok = refs.create-tag(git-dir, tag-name, tag-oid)
            {
                ref-ok == true -> print('Created annotated tag {tag-name}')
                ref-ok == false -> print('fatal: tag {tag-name} already exists')
            }
            return
        }
    }
    {
        argc >= 2 -> {
            name = os.arg(2)
            head-oid, head-ok = refs.read-ref(git-dir, 'HEAD')
            head-ok == false -> {
                print('fatal: no HEAD ref')
                return
            }
            ok = refs.create-tag(git-dir, name, head-oid)
            {
                ok == false -> {
                    print('fatal: tag {name} already exists')
                }
                -> {
                    print('Created tag {name}')
                }
            }
            return
        }
    }
    names, count = refs.list-tags(git-dir)
    pos = 0
    {
        pos >= names.len -> break
        nl = util.find-byte-str(names, 10, pos)
        end = names.len
        nl >= 0 -> end = nl
        nm = util.str-range(names, pos, end)
        print(nm)
        pos = nl + 1
        nl < 0 -> break
    } (true)
}

; ═══════════════════════════════════════════════
; git cat-file
; ═══════════════════════════════════════════════

cmd-cat-file = (argc i64) {
    argc < 3 -> {
        print('usage: git cat-file <type> <ref>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    opt = os.arg(2)
    ref = os.arg(3)
    o, ref-ok = revwalk.resolve-ref(git-dir, ref)
    ref-ok == false -> {
        print('fatal: could not resolve {ref}')
        return
    }
    kind, data, read-ok = object.read-loose(git-dir, o)
    read-ok == false -> {
        kind, data, read-ok = pack.read-packed-object(git-dir, o)
    }
    read-ok == false -> {
        print('fatal: object not found')
        return
    }
    opt: {
        '-t' -> print(kind)
        '-s' -> {
            sz = util.i64-to-str(data.len)
            print(sz)
        }
        '-p' -> {
            print(data)
        }
        kind -> print(data)
        -> {
            print('unknown option: {opt}')
        }
    }
}

; ═══════════════════════════════════════════════
; git hash-object
; ═══════════════════════════════════════════════

cmd-hash-object = (argc i64) {
    write = false
    path = ''
    i <- [1..argc): {
        arg = os.arg(i + 1)
        arg == '-w' -> write = true
        arg != '-w' -> path = arg
    }
    path == '' -> {
        print('usage: git hash-object [-w] <file>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    content, read-ok = util.read-file-str(path)
    {
        read-ok == false -> {
            print('fatal: could not read {path}')
            return
        }
        write == true -> {
            o = object.write-blob(git-dir, content)
            ch = oid.oid-hex-str(o)
            print(ch)
        }
        -> {
            o = oid.hash-object('blob', content)
            ch = oid.oid-hex-str(o)
            print(ch)
        }
    }
}

; ═══════════════════════════════════════════════
; git ls-tree
; ═══════════════════════════════════════════════

cmd-ls-tree = (argc i64) {
    argc < 2 -> {
        print('usage: git ls-tree <tree-ish>')
        return
    }
    git-dir, work-tree, repo-ok = repository.repo-discover-cwd()
    repo-ok == false -> {
        print('fatal: not a git repository')
        return
    }
    ref = os.arg(2)
    o, ref-ok = revwalk.resolve-ref(git-dir, ref)
    ref-ok == false -> {
        print('fatal: could not resolve {ref}')
        return
    }
    kind, data, read-ok = object.read-loose(git-dir, o)
    read-ok == false -> {
        kind, data, read-ok = pack.read-packed-object(git-dir, o)
    }
    read-ok == false -> {
        print('fatal: object not found')
        return
    }
    kind: {
        'commit' -> {
            ; Parse tree oid directly from commit data instead of calling
            ; revwalk.commit-tree-oid to avoid cross-module variable issues
            sp-c = util.find-byte-str(data, 10, 0)
            first-line-end = data.len
            sp-c >= 0 -> first-line-end = sp-c
            first-line = util.str-range(data, 0, first-line-end)
            first-line.starts-with('tree ') -> {
                tree-hex = util.str-range(first-line, 5, first-line.len)
                o, ref-ok = oid.oid-from-hex(tree-hex)
                ref-ok == false -> {
                    print('fatal: could not parse tree oid')
                    return
                }
                kind, data, read-ok = object.read-loose(git-dir, o)
                read-ok == false -> {
                    kind, data, read-ok = pack.read-packed-object(git-dir, o)
                }
                read-ok == false -> {
                    print('fatal: could not read tree object')
                    return
                }
            }
            -> {
                print('fatal: commit has no tree line')
                return
            }
        }
        'tree' ->
        -> {
            print('fatal: not a tree object')
            return
        }
    }
    n = object.tree-count-raw(data)
    i <- [0..n): {
        mode = object.tree-mode-raw(data, i)
        nm = object.tree-name-raw(data, i)
        entry-oid = object.tree-id-raw(data, i)
        type-name = 'blob'
        mode == 16384 -> type-name = 'tree'
        mode-str = ''
        m = mode
        m == 0 -> mode-str = '0'
        m != 0 -> {
            tmp []byte = with-cap(16)
            {
                tmp.push(48 + (m % 8))
                m = m / 8
                m == 0 -> break
            } (true)
            L = tmp.len
            j <- [0..L): {
                cs str = with-len(1)
                cs[0] = tmp[L - 1 - j]
                mode-str = mode-str - cs
            }
        }
        mode-str.len < 6 -> {
            pad-n = 6 - mode-str.len
            j <- [0..pad-n): {
                mode-str = '0' - mode-str
            }
        }
        ch = oid.oid-hex-str(entry-oid)
        print('{mode-str} {type-name} {ch}\t{nm}')
    }
}

; ═══════════════════════════════════════════════
; git ls-files
