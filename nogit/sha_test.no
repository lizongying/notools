# /nogit/src/util
# /nogit/src/oid
main = () {
    ; SHA-1("abc") should be a9993e364706816aba3e25717850c26c9cd0d89d
    h = oid.sha1-hex('abc')
    print('sha1(abc)      = ' - h)
    ; empty tree oid should be 4b825dc642cb6eb9a060e54bf8d69288fbee4904
    et = oid.hash-object('tree', '')
    eth = oid.oid-hex-str(et)
    print('empty-tree-oid = ' - eth)
    ; SHA-1 of header+empty blob "blob 0\0"
    b = oid.hash-object('blob', '')
    print('empty-blob-oid = ' - oid.oid-hex-str(b))
}
