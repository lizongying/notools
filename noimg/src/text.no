; text.no — Text rendering and watermark
; Provides basic bitmap font rendering for text overlay / watermark
; Uses a built-in 5x7 pixel font for ASCII printable characters (32-126)
; Inspired by libvips text operations

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

; ── Built-in 5x7 bitmap font ──
; Each character is 5 columns x 7 rows, stored as 7 bytes per char
; Each byte's low 5 bits represent one row (MSB = leftmost pixel)
; Font covers ASCII 32 (space) through 126 (~)

; text.font-data: returns the bitmap font data for characters 32-126
; Returns a string of 95*7 = 665 bytes
; Each char uses 7 bytes; byte[j] bit i (4..0) = pixel(col=i, row=j)
font-data = () (data str) {
    ; Space (32) through ~ (126), 95 chars x 7 bytes = 665 bytes
    ; Format: for each char, 7 bytes where each byte's bits 4..0 = row pixels
    ; Bit 4 = leftmost, bit 0 = rightmost
    data = ''
    ; Row patterns for common chars — stored as hex pairs
    ; We use a compact encoding: each char = 7 hex digits (each 0-F maps to 5 bits)
    ; Char 32 (space): all zeros
    data = data + '\x00\x00\x00\x00\x00\x00\x00'
    ; Char 33 (!): vertical bar center
    data = data + '\x08\x08\x08\x08\x08\x00\x08'
    ; Char 34 ("): two dots top
    data = data + '\x14\x14\x14\x00\x00\x00\x00'
    ; Char 35 (#): crosshatch
    data = data +'\x14\x14\x3e\x14\x3e\x14\x14'
    ; Char 36 ($): dollar sign
    data = data + '\x20\x3c\x22\x3c\x08\x14\x3c'
    ; Char 37 (%): percent
    data = data + '\x22\x14\x08\x10\x20\x42\x20'
    ; Char 38 (&): ampersand
    data = data + '\x18\x24\x28\x1e\x2a\x24\x1e'
    ; Char 39 ('): apostrophe
    data = data + '\x08\x08\x10\x00\x00\x00\x00'
    ; Char 40 ((): open paren
    data = data + '\x08\x10\x20\x20\x20\x10\x08'
    ; Char 41 ()): close paren
    data = data + '\x08\x04\x02\x02\x02\x04\x08'
    ; Char 42 (*): asterisk
    data = data + '\x00\x08\x2a\x1c\x2a\x08\x00'
    ; Char 43 (+): plus
    data = data + '\x00\x08\x08\x3e\x08\x08\x00'
    ; Char 44 (,): comma
    data = data + '\x00\x00\x00\x00\x08\x08\x10'
    ; Char 45 (-): minus
    data = data + '\x00\x00\x00\x3e\x00\x00\x00'
    ; Char 46 (.): period
    data = data + '\x00\x00\x00\x00\x00\x08\x08'
    ; Char 47 (/): slash
    data = data + '\x00\x02\x04\x08\x10\x20\x00'
    ; Char 48 (0): zero
    data = data + '\x1c\x22\x26\x2a\x32\x22\x1c'
    ; Char 49 (1): one
    data = data + '\x08\x18\x08\x08\x08\x08\x1c'
    ; Char 50 (2): two
    data = data + '\x1c\x22\x02\x04\x08\x10\x3e'
    ; Char 51 (3): three
    data = data + '\x3e\x02\x04\x1c\x02\x22\x1c'
    ; Char 52 (4): four
    data = data + '\x04\x0c\x14\x24\x3e\x04\x04'
    ; Char 53 (5): five
    data = data + '\x3e\x20\x3c\x02\x02\x22\x1c'
    ; Char 54 (6): six
    data = data + '\x04\x08\x10\x3c\x22\x22\x1c'
    ; Char 55 (7): seven
    data = data + '\x3e\x02\x04\x08\x10\x10\x10'
    ; Char 56 (8): eight
    data = data + '\x1c\x22\x22\x1c\x22\x22\x1c'
    ; Char 57 (9): nine
    data = data + '\x1c\x22\x22\x1c\x02\x04\x08'
    ; Char 58 (:): colon
    data = data + '\x00\x00\x08\x00\x00\x08\x00'
    ; Char 59 (;): semicolon
    data = data + '\x00\x00\x08\x00\x00\x08\x10'
    ; Char 60 (<): less than
    data = data + '\x02\x04\x08\x10\x08\x04\x02'
    ; Char 61 (=): equals
    data = data + '\x00\x00\x3e\x00\x3e\x00\x00'
    ; Char 62 (>): greater than
    data = data + '\x10\x08\x04\x02\x04\x08\x10'
    ; Char 63 (?): question
    data = data + '\x1c\x22\x02\x04\x08\x00\x08'
    ; Char 64 (@): at sign
    data = data + '\x1c\x22\x2a\x2a\x2a\x20\x1e'
    ; Char 65 (A)
    data = data + '\x08\x14\x22\x3e\x22\x22\x22'
    ; Char 66 (B)
    data = data + '\x3c\x22\x22\x3c\x22\x22\x3c'
    ; Char 67 (C)
    data = data + '\x1c\x22\x20\x20\x20\x22\x1c'
    ; Char 68 (D)
    data = data + '\x3c\x22\x22\x22\x22\x22\x3c'
    ; Char 69 (E)
    data = data + '\x3e\x20\x20\x3c\x20\x20\x3e'
    ; Char 70 (F)
    data = data + '\x3e\x20\x20\x3c\x20\x20\x20'
    ; Char 71 (G)
    data = data + '\x1c\x22\x20\x26\x22\x22\x1c'
    ; Char 72 (H)
    data = data + '\x22\x22\x22\x3e\x22\x22\x22'
    ; Char 73 (I)
    data = data + '\x1c\x08\x08\x08\x08\x08\x1c'
    ; Char 74 (J)
    data = data + '\x02\x02\x02\x02\x22\x22\x1c'
    ; Char 75 (K)
    data = data + '\x22\x24\x28\x30\x28\x24\x22'
    ; Char 76 (L)
    data = data + '\x20\x20\x20\x20\x20\x20\x3e'
    ; Char 77 (M)
    data = data + '\x22\x36\x2a\x2a\x22\x22\x22'
    ; Char 78 (N)
    data = data + '\x22\x22\x32\x2a\x26\x22\x22'
    ; Char 79 (O)
    data = data + '\x1c\x22\x22\x22\x22\x22\x1c'
    ; Char 80 (P)
    data = data + '\x3c\x22\x22\x3c\x20\x20\x20'
    ; Char 81 (Q)
    data = data + '\x1c\x22\x22\x22\x2a\x24\x1a'
    ; Char 82 (R)
    data = data + '\x3c\x22\x22\x3c\x28\x24\x22'
    ; Char 83 (S)
    data = data + '\x1c\x22\x20\x1c\x02\x22\x1c'
    ; Char 84 (T)
    data = data + '\x3e\x08\x08\x08\x08\x08\x08'
    ; Char 85 (U)
    data = data + '\x22\x22\x22\x22\x22\x22\x1c'
    ; Char 86 (V)
    data = data + '\x22\x22\x22\x22\x14\x14\x08'
    ; Char 87 (W)
    data = data + '\x22\x22\x22\x2a\x2a\x36\x22'
    ; Char 88 (X)
    data = data + '\x22\x22\x14\x08\x14\x22\x22'
    ; Char 89 (Y)
    data = data + '\x22\x22\x14\x08\x08\x08\x08'
    ; Char 90 (Z)
    data = data + '\x3e\x02\x04\x08\x10\x20\x3e'
    ; Char 91 ([)
    data = data + '\x1c\x10\x10\x10\x10\x10\x1c'
    ; Char 92 (\)
    data = data + '\x00\x20\x10\x08\x04\x02\x00'
    ; Char 93 (])
    data = data + '\x1c\x04\x04\x04\x04\x04\x1c'
    ; Char 94 (^)
    data = data + '\x08\x14\x22\x00\x00\x00\x00'
    ; Char 95 (_)
    data = data + '\x00\x00\x00\x00\x00\x00\x3e'
    ; Char 96 (`)
    data = data + '\x08\x04\x00\x00\x00\x00\x00'
    ; Char 97 (a)
    data = data + '\x00\x00\x1c\x02\x1e\x22\x1e'
    ; Char 98 (b)
    data = data + '\x20\x20\x3c\x22\x22\x22\x3c'
    ; Char 99 (c)
    data = data + '\x00\x00\x1c\x20\x20\x20\x1c'
    ; Char 100 (d)
    data = data + '\x02\x02\x1e\x22\x22\x22\x1e'
    ; Char 101 (e)
    data = data + '\x00\x00\x1c\x22\x3e\x20\x1c'
    ; Char 102 (f)
    data = data + '\x06\x08\x08\x1c\x08\x08\x08'
    ; Char 103 (g) — 7 bytes
    data = data + '\x00\x1e\x22\x22\x1e\x02\x3c'
    ; Char 104 (h)
    data = data + '\x20\x20\x3c\x22\x22\x22\x22'
    ; Char 105 (i)
    data = data + '\x08\x00\x18\x08\x08\x08\x1c'
    ; Char 106 (j) — 7 bytes
    data = data + '\x04\x00\x0c\x04\x04\x24\x18'
    ; Char 107 (k)
    data = data + '\x20\x20\x24\x28\x30\x28\x24'
    ; Char 108 (l)
    data = data + '\x18\x08\x08\x08\x08\x08\x1c'
    ; Char 109 (m)
    data = data + '\x00\x00\x14\x2a\x2a\x2a\x22'
    ; Char 110 (n)
    data = data + '\x00\x00\x3c\x22\x22\x22\x22'
    ; Char 111 (o)
    data = data + '\x00\x00\x1c\x22\x22\x22\x1c'
    ; Char 112 (p)
    data = data + '\x00\x00\x3c\x22\x22\x3c\x20'
    ; Char 113 (q)
    data = data + '\x00\x00\x1e\x22\x22\x1e\x02'
    ; Char 114 (r)
    data = data + '\x00\x00\x3c\x22\x20\x20\x20'
    ; Char 115 (s)
    data = data + '\x00\x00\x1e\x20\x1c\x02\x3c'
    ; Char 116 (t)
    data = data + '\x08\x08\x3e\x08\x08\x08\x06'
    ; Char 117 (u)
    data = data + '\x00\x00\x22\x22\x22\x22\x1e'
    ; Char 118 (v)
    data = data + '\x00\x00\x22\x22\x22\x14\x08'
    ; Char 119 (w)
    data = data + '\x00\x00\x22\x22\x2a\x2a\x14'
    ; Char 120 (x)
    data = data + '\x00\x00\x22\x14\x08\x14\x22'
    ; Char 121 (y) — 7 bytes
    data = data + '\x00\x00\x22\x22\x22\x1e\x02'
    ; Char 122 (z)
    data = data + '\x00\x00\x3e\x04\x08\x10\x3e'
    ; Char 123 ({)
    data = data + '\x06\x08\x08\x10\x08\x08\x06'
    ; Char 124 (|)
    data = data + '\x08\x08\x08\x00\x08\x08\x08'
    ; Char 125 (})
    data = data + '\x10\x08\x08\x04\x08\x08\x10'
    ; Char 126 (~)
    data = data + '\x14\x2a\x00\x00\x00\x00\x00'
}

; ── Font glyph lookup ──

; text.get-glyph: get the 7-byte bitmap for a character
; ch i64: ASCII character code (32-126)
; returns glyph str: 7 bytes representing the 5x7 bitmap
get-glyph = (ch i64) (glyph str) {
    {
        ch < 32 -> ch = 32
    }
    {
        ch > 126 -> ch = 126
    }
    idx = (ch - 32) * 7
    font = font-data()
    glyph = font.slice(idx, idx + 7)
}

; ── Text dimensions ──

; text.text-width: compute rendered width of a text string
; text-str str: text to measure
; scale i64: pixel scale (1 = 5x7 per char, 2 = 10x14, etc.)
; returns w i64: width in pixels
text-width = (text-str str, scale i64) (w i64) {
    n = text-str.len
    w = n * 5 * scale
    {
        n > 0 -> w = w + (n - 1) * scale
    }
}

; text.text-height: compute rendered height of a text string
; scale i64: pixel scale
; returns h i64: height in pixels (7 * scale)
text-height = (scale i64) (h i64) {
    h = 7 * scale
}

; ── Text rendering ──

; text.draw-text: draw text onto an image at position
; img image: target image (modified in place)
; text-str str: text to draw
; x i64: top-left x coordinate
; y i64: top-left y coordinate
; scale i64: pixel scale (1=5x7, 2=10x14)
; r i64: red channel value for text
; g i64: green channel value for text
; b i64: blue channel value for text
draw-text = (img image, text-str str, x i64, y i64, scale i64, r i64, g i64, b i64) {
    n = text-str.len
    {
        n == 0 -> return
    }
    char-w = 5 * scale + scale
    ci <- [0..n): {
        ch = text-str[ci] & 255
        glyph = get-glyph(ch)
        row <- [0..7): {
            row-bits = glyph[row] & 255
            col <- [0..5): {
                bit = (row-bits >> (4 - col)) & 1
                {
                    bit == 1 -> {
                        sy <- [0..scale): {
                            sx <- [0..scale): {
                                px = x + ci * char-w + col * scale + sx
                                py = y + row * scale + sy
                                {
                                    px >= 0 && px < img.width && py >= 0 && py < img.height -> {
                                        idx = (py * img.width + px) * img.bands
                                        {
                                            img.bands >= 3 -> {
                                                img.data[idx] = r
                                                img.data[idx + 1] = g
                                                img.data[idx + 2] = b
                                                {
                                                    img.bands >= 4 -> {
                                                        img.data[idx + 3] = 255
                                                    }
                                                }
                                            }

                                            -> {
                                                val = (r + g + b) / 3
                                                img.data[idx] = val
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ── Watermark ──

; text.watermark: add a text watermark to an image
; img image: input image
; text-str str: watermark text
; position i64: 0=top-left, 1=top-right, 2=center, 3=bottom-left, 4=bottom-right
; scale i64: pixel scale
; r i64: text red
; g i64: text green
; b i64: text blue
; returns out image: image with watermark
watermark = (img image, text-str str, position i64, scale i64, r i64, g i64, b i64) (out image) {
    out = image.copy(img)
    tw = text-width(text-str, scale)
    th = text-height(scale)
    margin = 4
    {
        position == 0 -> {
            ; Top-left
            draw-text(out, text-str, margin, margin, scale, r, g, b)
        }

        position == 1 -> {
            ; Top-right
            x = out.width - tw - margin
            {
                x < 0 -> x = 0
            }
            draw-text(out, text-str, x, margin, scale, r, g, b)
        }

        position == 2 -> {
            ; Center
            x = (out.width - tw) / 2
            y = (out.height - th) / 2
            {
                x < 0 -> x = 0
            }
            {
                y < 0 -> y = 0
            }
            draw-text(out, text-str, x, y, scale, r, g, b)
        }

        position == 3 -> {
            ; Bottom-left
            y = out.height - th - margin
            {
                y < 0 -> y = 0
            }
            draw-text(out, text-str, margin, y, scale, r, g, b)
        }

        position == 4 -> {
            ; Bottom-right
            x = out.width - tw - margin
            y = out.height - th - margin
            {
                x < 0 -> x = 0
            }
            {
                y < 0 -> y = 0
            }
            draw-text(out, text-str, x, y, scale, r, g, b)
        }
    }
}
