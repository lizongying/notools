        -> _
    }
    plane[115]: {
        ok -> it = 0x50

        -> _
    }
    plane[116]: {
        ok -> it = 0x71

        -> _
    }
    plane[117]: {
        ok -> it = 0x7f

        -> _
    }
    plane[118]: {
        ok -> it = 0x60

        -> _
    }
    plane[119]: {
        ok -> it = 0x70

        -> _
    }

    ; Color cache
    #{overflow=wrap}
    cc-cache []byte = with-len(cc-size * 4)

    ; Decode pixels
    lb0 = 0
    lb1 = 0
    lb4 = 0
    lf = 0
    px = 0
    (px < sub-n) {
        px < sub-n -> {

            ; select htree group for this pixel
            gidx = 0
            {
                huff-bits > 0 -> {
                    pcol = px % img-w

                    #{overflow=wrap}
                    prow = px / img-w
                    mx = pcol >> huff-bits
                    my = prow >> huff-bits

                    #{overflow=wrap}
                    midx = huff-xsize * my + mx

                    gidx = huff-img[midx]: {
                        ok -> it

                        -> 0
                    }
                }
            }

            #{overflow=wrap}
            lb0v-o = gidx * ts0
            lb0v i64 = lb0v-o: {
                ok -> it

                -> 0
            }
            lb0 = lb0v

            #{overflow=wrap}
            lb1v-o = gidx * 256
            lb1v i64 = lb1v-o: {
                ok -> it

                -> 0
            }
            lb1 = lb1v

            #{overflow=wrap}
            lb4v-o = gidx * 40
            lb4v i64 = lb4v-o: {
                ok -> it

                -> 0
            }
            lb4 = lb4v

            #{overflow=wrap}
            lfv-o = gidx * 16
            lfv i64 = lfv-o: {
                ok -> it

                -> 0
            }
            lf = lfv

            green, tp, tb, tc = webp-huff-decode-off(lens-0, lb0, ts0, first-0, lf, count-0, lf, data, pos, buf, cnt)
            pos = tp
            buf = tb
            cnt = tc

            {
                green < 256 -> {

                    ; Literal: R from tree1, B from tree2, A from tree3
                    red, tp, tb, tc = webp-huff-decode-off(lens-1, lb1, 256, first-1, lf, count-1, lf, data, pos, buf, cnt)
                    pos = tp
                    buf = tb
                    cnt = tc
                    blue, tp, tb, tc = webp-huff-decode-off(lens-2, lb1, 256, first-2, lf, count-2, lf, data, pos, buf, cnt)
                    pos = tp
                    buf = tb
                    cnt = tc
                    alpha, tp, tb, tc = webp-huff-decode-off(lens-3, lb1, 256, first-3, lf, count-3, lf, data, pos, buf, cnt)
                    pos = tp
                    buf = tb
                    cnt = tc

                    #{overflow=wrap}
                    sub-argb[px * 4]: {
                        ok -> it = alpha

                        -> _
                    }

                    #{overflow=wrap}
                    sub-argb[px * 4 + 1]: {
                        ok -> it = red

                        -> _
                    }

                    #{overflow=wrap}
                    sub-argb[px * 4 + 2]: {
                        ok -> it = green

                        -> _
                    }

                    #{overflow=wrap}
                    sub-argb[px * 4 + 3]: {
                        ok -> it = blue

                        -> _
                    }
                    webp-cc-insert(cc-cache, cc-size, sub-argb, px)

                    #{overflow=wrap}
                    px1-o = px + 1
                    px1 i64 = px1-o: {
                        ok -> it

                        -> 0
                    }
                    px = px1
                }

                green < 280 -> {

                    ; Backward reference (LZ77). length prefix = green - 256
                    #{overflow=wrap}
                    lp = green - 256
                    lp-extra = (lp - 2) >> 1
                    {
                        lp < 4 -> {

                            #{overflow=wrap}
                            length = lp + 1
                        }

                        -> {
                            lp-val, tp, tb, tc = webp-br-read(data, pos, buf, cnt, lp-extra)
                            pos = tp
                            buf = tb
                            cnt = tc
                            lp-offset = (2 + (lp & 1)) << lp-extra

                            #{overflow=wrap}
                            length = lp-offset + 1 + lp-val
                        }
                    }

                    ; distance symbol from tree4 -> GetCopyDistance -> PlaneCodeToDistance
                    dsym, tp, tb, tc = webp-huff-decode-off(lens-4, lb4, 40, first-4, lf, count-4, lf, data, pos, buf, cnt)
                    pos = tp
                    buf = tb
                    cnt = tc

                    #{overflow=wrap}
                    dm2-o = dsym - 2
                    dm2 i64 = dm2-o: {
                        ok -> it

                        -> 0
                    }
                    d-extra = dm2 >> 1
                    dist-code = 0
                    {
                        dsym < 4 -> {

                            #{overflow=wrap}
                            dc1-o = dsym + 1
                            dc1 i64 = dc1-o: {
                                ok -> it

                                -> 0
                            }
                            dist-code = dc1
                        }

                        -> {
                            d-val, tp, tb, tc = webp-br-read(data, pos, buf, cnt, d-extra)
                            pos = tp
                            buf = tb
                            cnt = tc
                            one = dsym & 1

                            #{overflow=wrap}
                            two-o = 2 + one
                            two i64 = two-o: {
                                ok -> it

                                -> 0
                            }
                            d-offset = two << d-extra

                            #{overflow=wrap}
                            dop1-o = d-offset + 1
                            dop1 i64 = dop1-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            dop2-o = dop1 + d-val
                            dop2 i64 = dop2-o: {
                                ok -> it

                                -> 0
                            }
                            dist-code = dop2
                        }
                    }
                    dist = 0
                    {
                        dist-code > 120 -> {

                            #{overflow=wrap}
                            d120-o = dist-code - 120
                            d120 i64 = d120-o: {
                                ok -> it

                                -> 0
                            }
                            dist = d120
                        }

                        -> {

                            #{overflow=wrap}
                            dcm1-o = dist-code - 1
                            dcm1 i64 = dcm1-o: {
                                ok -> it

                                -> 0
                            }
                            dc = plane[dcm1]: {
                                ok -> it

                                -> 0
                            }
                            yoff = dc >> 4
                            dcf = dc & 0xf

                            #{overflow=wrap}
                            xoff-o = 8 - dcf
                            xoff i64 = xoff-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            prod-o = yoff * img-w
                            prod i64 = prod-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            dist-o = prod + xoff
                            dist i64 = dist-o: {
                                ok -> it

                                -> 0
                            }
                            {
                                dist < 1 -> {
                                    dist = 1
                                }
                            }
                        }
                    }

                    ; copy `length` pixels from `dist` back
                    li <- [0..length): {

                        #{overflow=wrap}
                        {
                            px - dist + li >= 0 && px + li < sub-n -> {

                                #{overflow=wrap}
                                sidx = px - dist + li

                                #{overflow=wrap}
                                didx = px + li

                                #{overflow=wrap}
                                cb0 = sub-argb[sidx * 4]: {
                                    ok -> it

                                    -> 0
                                }
                                sub-argb[didx * 4]: {
                                    ok -> it = cb0

                                    -> _
                                }

                                #{overflow=wrap}
                                cb1 = sub-argb[sidx * 4 + 1]: {
                                    ok -> it

                                    -> 0
                                }
                                sub-argb[didx * 4 + 1]: {
                                    ok -> it = cb1

                                    -> _
                                }

                                #{overflow=wrap}
                                cb2 = sub-argb[sidx * 4 + 2]: {
                                    ok -> it

                                    -> 0
                                }
                                sub-argb[didx * 4 + 2]: {
                                    ok -> it = cb2

                                    -> _
                                }

                                #{overflow=wrap}
                                cb3 = sub-argb[sidx * 4 + 3]: {
                                    ok -> it

                                    -> 0
                                }
                                sub-argb[didx * 4 + 3]: {
                                    ok -> it = cb3

                                    -> _
                                }
                                webp-cc-insert(cc-cache, cc-size, sub-argb, didx)
                            }
                        }
                    }

                    #{overflow=wrap}
                    pxl-o = px + length
                    pxl i64 = pxl-o: {
                        ok -> it

                        -> 0
                    }
                    px = pxl
                }

                -> {

                    ; Color cache: key = green - 280
                    #{overflow=wrap}
                    key = green - 280

                    #{overflow=wrap}
                    kb = key * 4

                    k0 = cc-cache[kb]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    k1 = cc-cache[kb + 1]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    k2 = cc-cache[kb + 2]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    k3 = cc-cache[kb + 3]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    sub-argb[px * 4]: {
                        ok -> it = k0

                        -> _
                    }

                    #{overflow=wrap}
                    sub-argb[px * 4 + 1]: {
                        ok -> it = k1

                        -> _
                    }

                    #{overflow=wrap}
                    sub-argb[px * 4 + 2]: {
                        ok -> it = k2

                        -> _
                    }

                    #{overflow=wrap}
                    sub-argb[px * 4 + 3]: {
                        ok -> it = k3

                        -> _
                    }
                    webp-cc-insert(cc-cache, cc-size, sub-argb, px)

                    #{overflow=wrap}
                    px1b-o = px + 1
                    px1b i64 = px1b-o: {
                        ok -> it

                        -> 0
                    }
                    px = px1b
                }
            }
        }
    }

    out = sub-argb
    new-pos = pos
    new-buf = buf
    new-cnt = cnt
}

; ── VP8L Main Decoder ──

; webp-decode-vp8l: decode VP8L lossless bitstream to raw pixel data
; data str: file data
; vp8l-pos i64: byte position of VP8L data (at 0x2F signature)
; w i64: image width
; h i64: image height
; has-alpha bool: whether alpha channel is present
; returns pixels []byte: decoded pixel data (RGB or RGBA)
webp-decode-vp8l = (data []byte, vp8l-pos i64, w i64, h i64, has-alpha bool) (pixels []byte) {

    #{overflow=wrap}
    n-pixels = w * h
    bands = 3
    has-alpha -> bands = 4

    ; ARGB buffer (4 bytes per pixel internally)
    #{overflow=wrap}
    argb []byte = with-len(n-pixels * 4)

    ; Bit reader: start after 0x2F signature byte
    pos = 0
    pos-opt = vp8l-pos + 1
    pos-opt: {
        ok -> {
            pos = it
        }

        -> {
            pos = 0
        }
    }
    buf = 0
    cnt = 0

    ; Skip header: width(14), height(14), alpha(1), version(3) = 32 bits
    hdr-w, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 14)
    pos = tp
    buf = tb
    cnt = tc
    hdr-h, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 14)
    pos = tp
    buf = tb
    cnt = tc
    alpha-bit, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 1)
    pos = tp
    buf = tb
    cnt = tc
    vp8l-version, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 3)
    pos = tp
    buf = tb
    cnt = tc

    ; Read transforms (up to 4)
    ; Store transform parameters
    transform-types []byte = with-len(4)

    ; Predictor mode bits (ttype 0)
    transform-bits []byte = with-len(4)

    ; Color indexing palette (ttype 3)
    #{overflow=wrap}
    ci-palette []byte = with-len(256 * 4); ARGB per entry
    ci-palette-size = 0
    ci-bits = 8
    ci-sub-w = 0
    ci-img []byte = with-len(0)

    ; Color indexing faithful-state (libwebp COLOR_INDEXING_TRANSFORM)
    ci-present = false
    ci-ppw = 1; pixels per word = 1 << exp
    ci-bpp = 8; bits per index = 8 >> exp
    ci-final = 256; expanded palette entries = 1 << bpp
    ci-decode-w = 0; subsampled main-image width
    argb2 []byte = with-len(0); CI expansion target (function scope for lifetime)

    ; Transform image buffers — declared outside branch scope
    ; so inverse transforms can access them
    pred-img []byte = with-len(0)
    pred-w = 0
    pred-h = 0
    ct-img []byte = with-len(0)
    ct-w = 0
    ct-h = 0

    ; block-size (1<<bits) and bits exponent for predictor / cross-color transforms
    pred-block = 4
    ct-block = 4
    n-transforms = 0
    tf-more = true
    (tf-more && n-transforms < 4) {
        tf-more && n-transforms < 4 -> {
            used, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 1)
            pos = tp
            buf = tb
            cnt = tc
            {
                used == 0 -> {
                    tf-more = false
                }

                -> {
                    ttype, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 2)
                    pos = tp
                    buf = tb
                    cnt = tc
                    transform-types[n-transforms]: {
                        ok -> it = ttype

                        -> _
                    }

                    #{overflow=wrap}
                    nt1-o = n-transforms + 1
                    nt1 i64 = nt1-o: {
                        ok -> it

                        -> 0
                    }
                    n-transforms = nt1
                    {
                        ttype == 0 -> {

                            ; Predictor/Cross-color: read 3-bit block-size field.
                            ; Per libwebp: bits = MIN_TRANSFORM_BITS(2) + ReadBits(3);
                            ; block = 1 << bits; transform image is subsampled by block.
                            pbits, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 3)
                            pos = tp
                            buf = tb
                            cnt = tc

                            #{overflow=wrap}
                            pred-blk = 2 + pbits
                            pred-block = 1 << pred-blk
                            transform-bits[0]: {
                                ok -> it = pred-blk

                                -> _
                            }

                            pred-w = webp-ceil-div(w, pred-block)
                            pred-h = webp-ceil-div(h, pred-block)

                            ; Decode the predictor sub-image as ARGB
                            pred-argb, tp, tb, tc = webp-decode-argb-image(data, pos, buf, cnt, pred-w, pred-h, false)
                            pos = tp
                            buf = tb
                            cnt = tc

                            ; Extract the green channel (byte offset +2) as the predictor
                            ; mode, masked to low nibble per libwebp
                            ; (VP8LPredictorsAdd[(*pred >> 8) & 0xf]).
                            #{overflow=wrap}
                            pred-n = pred-w * pred-h
                            pred-img = with-len(pred-n)
                            pi <- [0..pred-n): {

                                #{overflow=wrap}
                                d9v9 = pred-argb[pi * 4 + 2]: {
                                    ok -> it

                                    -> 0
                                }
                                pred-img[pi]: {
                                    ok -> it = d9v9 & 0xf

                                    -> _
                                }
                            }
                        }

                        ttype == 1 -> {

                            ; Cross-color transform: bits = 2 + ReadBits(3), block = 1<<bits.
                            ; Channel layout per spec:
                            ;   R channel (offset +1) = red_to_blue
                            ;   G channel (offset +2) = green_to_blue
                            ;   B channel (offset +3) = green_to_red
                            cbits, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 3)
                            pos = tp
                            buf = tb
                            cnt = tc

                            #{overflow=wrap}
                            ct-blk = 2 + cbits
                            ct-block = 1 << ct-blk
                            transform-bits[1]: {
                                ok -> it = ct-blk

                                -> _
                            }

                            ct-w = webp-ceil-div(w, ct-block)
                            ct-h = webp-ceil-div(h, ct-block)

                            ; Decode the color transform sub-image as ARGB
                            ct-img, tp, tb, tc = webp-decode-argb-image(data, pos, buf, cnt, ct-w, ct-h, false)
                            pos = tp
                            buf = tb
                            cnt = tc
                        }

                        ttype == 2 -> {
                            ; Subtract green: no extra data
                        }

                        ttype == 3 -> {

                            ; Color indexing (faithful libwebp ReadTransform/
                            ; COLOR_INDEXING_TRANSFORM): num_colors = ReadBits(8)+1.
                            ; exp = bits exponent; ppw = 1<<exp pixels packed per
                            ; source word; bpp = 8>>exp bits per index.
                            ; Main image decodes at subsampled width; the palette
                            ; itself is a VP8L sub-image of size num_colors x 1,
                            ; then delta-expanded (ExpandColorMap) to 1<<bpp entries.
                            psize-code, tp, tb, tc = webp-br-read(data, pos, buf, cnt, 8)
                            pos = tp
                            buf = tb
                            cnt = tc

                            #{overflow=wrap}
                            ci-palette-size = psize-code + 1

                            ci-exp = 0
                            {
                                ci-palette-size > 16 -> {
                                    ci-exp = 0
                                }

                                ci-palette-size > 4 && ci-palette-size <= 16 -> {
                                    ci-exp = 1
                                }

                                ci-palette-size > 2 && ci-palette-size <= 4 -> {
                                    ci-exp = 2
                                }

                                ci-palette-size <= 2 -> {
                                    ci-exp = 3
                                }
                            }
                            ci-ppw = 1 << ci-exp
                            ci-bpp = 8 >> ci-exp

                            ci-decode-w = webp-ceil-div(w, ci-ppw)
                            ci-final = 1 << ci-bpp
                            ci-present = true

                            ; palette = VP8L sub-image (num_colors x 1)
                            ci-pargb, tp, tb, tc = webp-decode-argb-image(data, pos, buf, cnt, ci-palette-size, 1, false)
                            pos = tp
                            buf = tb
                            cnt = tc

                            ; ExpandColorMap: entry0 copied; entry i = entry i-1 +
                            ; palette delta byte (mod 256); tail zeroed to black.
                            d9v10 = ci-pargb[0]: {
                                ok -> it

                                -> 0
                            }
                            ci-palette[0]: {
                                ok -> it = d9v10

                                -> _
                            }

                            d9v11 = ci-pargb[1]: {
                                ok -> it

                                -> 0
                            }
                            ci-palette[1]: {
                                ok -> it = d9v11

                                -> _
                            }

                            d9v12 = ci-pargb[2]: {
                                ok -> it

                                -> 0
                            }
                            ci-palette[2]: {
                                ok -> it = d9v12

                                -> _
                            }

                            d9v13 = ci-pargb[3]: {
                                ok -> it

                                -> 0
                            }
                            ci-palette[3]: {
                                ok -> it = d9v13

                                -> _
                            }
                            ei <- [4..ci-palette-size * 4): {

                                #{overflow=wrap}
                                em4-o = ei - 4
                                em4 i64 = em4-o: {
                                    ok -> it

                                    -> 0
                                }
                                pe = ci-pargb[ei]: {
                                    ok -> it

                                    -> 0
                                }
                                pa = ci-palette[em4]: {
                                    ok -> it

                                    -> 0
                                }
                                dm = webp-u8-add-mod(pe, pa)
                                ci-palette[ei]: {
                                    ok -> it = dm

                                    -> _
                                }
                            }
                            zi <- [ci-palette-size * 4..ci-final * 4): {
                                ci-palette[zi]: {
                                    ok -> it = 0

                                    -> _
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    ; Decode the main ARGB image via the shared VP8L core (color cache,
    ; meta-Huffman htree groups, 5 Huffman trees, LZ77 / color cache symbols).
    ; With color-indexing present, the main image decodes at the subsampled width.
    decode-w = w
    {
        ci-present -> {
            decode-w = ci-decode-w
        }
    }
    argb, tp, tb, tc = webp-decode-argb-image(data, pos, buf, cnt, decode-w, h, true)
    pos = tp
    buf = tb
    cnt = tc

    ; Apply color-indexing inverse FIRST (it is always the last transform read,
    ; hence first applied in reverse). Expands subsampled argb -> full-width argb.
    {
        ci-present -> {

            #{overflow=wrap}
            ci-mask = (1 << ci-bpp) - 1

            #{overflow=wrap}
            argb2 = with-len(n-pixels * 4)
            ey <- [0..h): {
                exs <- [0..ci-decode-w): {

                    #{overflow=wrap}
                    sidx = ey * ci-decode-w + exs

                    #{overflow=wrap}
                    packed = argb[sidx * 4 + 2]: {
                        ok -> it

                        -> 0
                    }
                    kk <- [0..ci-ppw): {

                        #{overflow=wrap}
                        dx = exs * ci-ppw + kk
                        {
                            dx < w -> {
                                idx = (packed >> (kk * ci-bpp)) & ci-mask

                                #{overflow=wrap}
                                pb = idx * 4

                                #{overflow=wrap}
                                oidx = (ey * w + dx) * 4

                                d9v14 = ci-palette[pb]: {
                                    ok -> it

                                    -> 0
                                }

                                argb2[oidx]: {
                                    ok -> it = d9v14

                                    -> _
                                }

                                d9v15 = ci-palette[pb + 1]: {
                                    ok -> it

                                    -> 0
                                }

                                #{overflow=wrap}
                                argb2[oidx + 1]: {
                                    ok -> it = d9v15

                                    -> _
                                }

                                d9v16 = ci-palette[pb + 2]: {
                                    ok -> it

                                    -> 0
                                }

                                #{overflow=wrap}
                                argb2[oidx + 2]: {
                                    ok -> it = d9v16

                                    -> _
                                }

                                d9v17 = ci-palette[pb + 3]: {
                                    ok -> it

                                    -> 0
                                }

                                #{overflow=wrap}
                                argb2[oidx + 3]: {
                                    ok -> it = d9v17

                                    -> _
                                }
                            }
                        }
                    }
                }
            }
            argb = argb2
        }
    }

    ; Apply inverse transforms in reverse order
    ti <- [0..n-transforms): {

        #{overflow=wrap}
        ttype = transform-types[n-transforms - 1 - ti]: {
            ok -> it

            -> 0
        }
        {
            ttype == 0 -> {

                ; Inverse predictor: reconstruct pixels from residuals
                ; The predictor image (pred-img) defines the prediction mode
                ; per 4x4 block. pred-img has dimensions pred-w x pred-h
                ; where each entry covers a 4x4 block of pixels.
                pi <- [0..n-pixels): {

                    #{overflow=wrap}
                    py = pi / w

                    #{overflow=wrap}
                    px = pi - py * w

                    ; Get the predictor mode for this pixel's block
                    #{overflow=wrap}
                    blk-x = px / pred-block

                    #{overflow=wrap}
                    blk-y = py / pred-block

                    #{overflow=wrap}
                    blk-idx = blk-y * pred-w + blk-x
                    mode = 0
                    {
                        blk-idx < pred-img.len() -> {
                            mode = pred-img[blk-idx]: {
                                ok -> it

                                -> 0
                            }
                        }
                    }

                    ; libwebp forces predictor modes on the first row / first
                    ; column regardless of the predictor sub-image (see
                    ; PredictorInverseTransform_C):
                    ;   (y==0,x==0) -> 0 (ARGB_BLACK); (y==0,x>0) -> 1 (Left);
                    ;   (y>0,x==0) -> 2 (Top); otherwise the sub-image mode.
                    {
                        py == 0 && px == 0 -> {
                            mode = 0
                        }

                        py == 0 && px > 0 -> {
                            mode = 1
                        }

                        py > 0 && px == 0 -> {
                            mode = 2
                        }
                    }

                    ; VP8L predictor modes (per WebP Lossless Bitstream spec):
                    ;   0  = 0xFF000000 (black, alpha=255)
                    ;   1  = Left (L)
                    ;   2  = Top (T)
                    ;   3  = Top-Right (TR)
                    ;   4  = Top-Left (TL)
                    ;   5  = Average2(Average2(L, TR), T)
                    ;   6  = Average2(L, TL)
                    ;   7  = Average2(L, T)
                    ;   8  = Average2(TL, T)
                    ;   9  = Average2(T, TR)
                    ;   10 = Average2(Average2(L, TL), Average2(T, TR))
                    ;   11 = Select(L, T, TL): based on Manhattan distance,
                    ;        p-l = |L-TL|+|L-TL|+|L-TL|+|L-TL| (4-channel sum)
                    ;        p-t = |T-TL|+|T-TL|+|T-TL|+|T-TL| (4-channel sum)
                    ;        p-l < p-t -> L, else T
                    ;   12 = ClampAddSubtractFull(L, T, TL) = Clamp(L + T - TL)
                    ;        i.e. per channel: clamp(val=L+T-TL, lo=0, hi=255)
                    ;   13 = ClampAddSubtractHalf(Average2(L,T), TL)
                    ;        i.e. per channel: clamp(val=Avg2(L,T)+(Avg2(L,T)-TL)/2, lo=0, hi=255)
                    ;
                    ; For modes 1-4 we can apply the prediction inline (single neighbor).
                    ; For modes 0 and 5-13 we compute pred-a/r/g/b then add at the end.

                    ; ── Collect neighbor values (needed for all modes except 0) ──
                    left-a = 0
                    left-r = 0
                    left-g = 0
                    left-b = 0
                    {
                        px > 0 -> {

                            #{overflow=wrap}
                            left-a = argb[(pi - 1) * 4]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            left-r = argb[(pi - 1) * 4 + 1]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            left-g = argb[(pi - 1) * 4 + 2]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            left-b = argb[(pi - 1) * 4 + 3]: {
                                ok -> it

                                -> 0
                            }
                        }
                    }
                    top-a = 0
                    top-r = 0
                    top-g = 0
                    top-b = 0
                    {
                        py > 0 -> {

                            #{overflow=wrap}
                            top-a = argb[(pi - w) * 4]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            top-r = argb[(pi - w) * 4 + 1]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            top-g = argb[(pi - w) * 4 + 2]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            top-b = argb[(pi - w) * 4 + 3]: {
                                ok -> it

                                -> 0
                            }
                        }
                    }
                    tl-a = 0
                    tl-r = 0
                    tl-g = 0
                    tl-b = 0
                    {
                        px > 0 && py > 0 -> {

                            #{overflow=wrap}
                            tl-a = argb[(pi - w - 1) * 4]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tl-r = argb[(pi - w - 1) * 4 + 1]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tl-g = argb[(pi - w - 1) * 4 + 2]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tl-b = argb[(pi - w - 1) * 4 + 3]: {
                                ok -> it

                                -> 0
                            }
                        }
                    }
                    tr-a = top-a
                    tr-r = top-r
                    tr-g = top-g
                    tr-b = top-b

                    #{overflow=wrap}
                    {
                        py > 0 && px + 1 < w -> {

                            #{overflow=wrap}
                            tr-a = argb[(pi - w + 1) * 4]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tr-r = argb[(pi - w + 1) * 4 + 1]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tr-g = argb[(pi - w + 1) * 4 + 2]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tr-b = argb[(pi - w + 1) * 4 + 3]: {
                                ok -> it

                                -> 0
                            }
                        }
                    }

                    ; ── Compute prediction ──
                    avg-lt-a i64 = 0
                    avg-lt-r i64 = 0
                    avg-lt-g i64 = 0
                    avg-lt-b i64 = 0
                    avg-ltl-a i64 = 0
                    avg-ltl-r i64 = 0
                    avg-ltl-g i64 = 0
                    avg-ltl-b i64 = 0
                    avg-ltr-a i64 = 0
                    avg-ltr-r i64 = 0
                    avg-ltr-g i64 = 0
                    avg-ltr-b i64 = 0
                    avg-ttr-a i64 = 0
                    avg-ttr-r i64 = 0
                    avg-ttr-g i64 = 0
                    avg-ttr-b i64 = 0
                    pred-a = 0
                    pred-r = 0
                    pred-g = 0
                    pred-b = 0

                    {
                        mode == 0 -> {

                            ; 0xFF000000: solid black with full alpha
                            pred-a = 255
                            pred-r = 0
                            pred-g = 0
                            pred-b = 0
                        }
                    }
                    {
                        mode == 1 -> {

                            ; Left (L)
                            pred-a = left-a
                            pred-r = left-r
                            pred-g = left-g
                            pred-b = left-b
                        }
                    }
                    {
                        mode == 2 -> {

                            ; Top (T)
                            pred-a = top-a
                            pred-r = top-r
                            pred-g = top-g
                            pred-b = top-b
                        }
                    }
                    {
                        mode == 3 -> {

                            ; Top-Right (TR) — falls back to T when last in row
                            pred-a = tr-a
                            pred-r = tr-r
                            pred-g = tr-g
                            pred-b = tr-b
                        }
                    }
                    {
                        mode == 4 -> {

                            ; Top-Left (TL)
                            pred-a = tl-a
                            pred-r = tl-r
                            pred-g = tl-g
                            pred-b = tl-b
                        }
                    }
                    {
                        mode == 5 -> {

                            ; Average2(Average2(L, TR), T)
                            avg-ltr-a = webp-avg2(left-a, tr-a)
                            avg-ltr-r = webp-avg2(left-r, tr-r)
                            avg-ltr-g = webp-avg2(left-g, tr-g)
                            avg-ltr-b = webp-avg2(left-b, tr-b)
                            pred-a = webp-avg2(avg-ltr-a, top-a)
                            pred-r = webp-avg2(avg-ltr-r, top-r)
                            pred-g = webp-avg2(avg-ltr-g, top-g)
                            pred-b = webp-avg2(avg-ltr-b, top-b)
                        }
                    }
                    {
                        mode == 6 -> {

                            ; Average2(L, TL)
                            pred-a = webp-avg2(left-a, tl-a)
                            pred-r = webp-avg2(left-r, tl-r)
                            pred-g = webp-avg2(left-g, tl-g)
                            pred-b = webp-avg2(left-b, tl-b)
                        }
                    }
                    {
                        mode == 7 -> {

                            ; Average2(L, T)
                            pred-a = webp-avg2(left-a, top-a)
                            pred-r = webp-avg2(left-r, top-r)
                            pred-g = webp-avg2(left-g, top-g)
                            pred-b = webp-avg2(left-b, top-b)
                        }
                    }
                    {
                        mode == 8 -> {

                            ; Average2(TL, T)
                            pred-a = webp-avg2(tl-a, top-a)
                            pred-r = webp-avg2(tl-r, top-r)
                            pred-g = webp-avg2(tl-g, top-g)
                            pred-b = webp-avg2(tl-b, top-b)
                        }
                    }
                    {
                        mode == 9 -> {

                            ; Average2(T, TR)
                            pred-a = webp-avg2(top-a, tr-a)
                            pred-r = webp-avg2(top-r, tr-r)
                            pred-g = webp-avg2(top-g, tr-g)
                            pred-b = webp-avg2(top-b, tr-b)
                        }
                    }
                    {
                        mode == 10 -> {

                            ; Average2(Average2(L, TL), Average2(T, TR))
                            avg-ltl-a = webp-avg2(left-a, tl-a)
                            avg-ltl-r = webp-avg2(left-r, tl-r)
                            avg-ltl-g = webp-avg2(left-g, tl-g)
                            avg-ltl-b = webp-avg2(left-b, tl-b)
                            avg-ttr-a = webp-avg2(top-a, tr-a)
                            avg-ttr-r = webp-avg2(top-r, tr-r)
                            avg-ttr-g = webp-avg2(top-g, tr-g)
                            avg-ttr-b = webp-avg2(top-b, tr-b)
                            pred-a = webp-avg2(avg-ltl-a, avg-ttr-a)
                            pred-r = webp-avg2(avg-ltl-r, avg-ttr-r)
                            pred-g = webp-avg2(avg-ltl-g, avg-ttr-g)
                            pred-b = webp-avg2(avg-ltl-b, avg-ttr-b)
                        }
                    }
                    {
                        mode == 11 -> {

                            ; Select(L, T, TL): Manhattan distance on all 4 channels
                            ; p-l = |L.A-TL.A| + |L.R-TL.R| + |L.G-TL.G| + |L.B-TL.B|
                            ; p-t = |T.A-TL.A| + |T.R-TL.R| + |T.G-TL.G| + |T.B-TL.B|
                            ; p-l < p-t -> Left, else Top
                            #{overflow=wrap}
                            dla = left-a - tl-a
                            {
                                dla < 0 -> dla = -dla
                            }

                            #{overflow=wrap}
                            dlr = left-r - tl-r
                            {
                                dlr < 0 -> dlr = -dlr
                            }

                            #{overflow=wrap}
                            dlg = left-g - tl-g
                            {
                                dlg < 0 -> dlg = -dlg
                            }

                            #{overflow=wrap}
                            dlb = left-b - tl-b
                            {
                                dlb < 0 -> dlb = -dlb
                            }

                            #{overflow=wrap}
                            p-l = dla + dlr + dlg + dlb

                            #{overflow=wrap}
                            dta = top-a - tl-a
                            {
                                dta < 0 -> dta = -dta
                            }

                            #{overflow=wrap}
                            dtr = top-r - tl-r
                            {
                                dtr < 0 -> dtr = -dtr
                            }

                            #{overflow=wrap}
                            dtg = top-g - tl-g
                            {
                                dtg < 0 -> dtg = -dtg
                            }

                            #{overflow=wrap}
                            dtb = top-b - tl-b
                            {
                                dtb < 0 -> dtb = -dtb
                            }

                            #{overflow=wrap}
                            p-t = dta + dtr + dtg + dtb
                            {
                                p-l < p-t -> {
                                    pred-a = left-a
                                    pred-r = left-r
                                    pred-g = left-g
                                    pred-b = left-b
                                }

                                -> {
                                    pred-a = top-a
                                    pred-r = top-r
                                    pred-g = top-g
                                    pred-b = top-b
                                }
                            }
                        }
                    }
                    {
                        mode == 12 -> {

                            ; ClampAddSubtractFull(L, T, TL) = Clamp(L + T - TL)
                            ; Per channel: val = L + T - TL, clamp to [0, 255]
                            val-a = webp-addsub-full(left-a, top-a, tl-a)
                            val-r = webp-addsub-full(left-r, top-r, tl-r)
                            val-g = webp-addsub-full(left-g, top-g, tl-g)
                            val-b = webp-addsub-full(left-b, top-b, tl-b)
                            {
                                val-a < 0 -> val-a = 0

                                val-a > 255 -> val-a = 255
                            }
                            {
                                val-r < 0 -> val-r = 0

                                val-r > 255 -> val-r = 255
                            }
                            {
                                val-g < 0 -> val-g = 0

                                val-g > 255 -> val-g = 255
                            }
                            {
                                val-b < 0 -> val-b = 0

                                val-b > 255 -> val-b = 255
                            }
                            pred-a = val-a
                            pred-r = val-r
                            pred-g = val-g
                            pred-b = val-b
                        }
                    }
                    {
                        mode >= 13 -> {

                            ; Mode 13: ClampAddSubtractHalf(Average2(L,T), TL)
                            ; Per channel: avg = Average2(L,T), val = avg + (avg - TL) / 2
                            ; clamp to [0, 255]
                            avg-lt-a = webp-avg2(left-a, top-a)
                            avg-lt-r = webp-avg2(left-r, top-r)
                            avg-lt-g = webp-avg2(left-g, top-g)
                            avg-lt-b = webp-avg2(left-b, top-b)

                            val-a = webp-addsub2(avg-lt-a, tl-a)
                            val-r = webp-addsub2(avg-lt-r, tl-r)
                            val-g = webp-addsub2(avg-lt-g, tl-g)
                            val-b = webp-addsub2(avg-lt-b, tl-b)
                            {
                                val-a < 0 -> val-a = 0

                                val-a > 255 -> val-a = 255
                            }
                            {
                                val-r < 0 -> val-r = 0

                                val-r > 255 -> val-r = 255
                            }
                            {
                                val-g < 0 -> val-g = 0

                                val-g > 255 -> val-g = 255
                            }
                            {
                                val-b < 0 -> val-b = 0

                                val-b > 255 -> val-b = 255
                            }
                            pred-a = val-a
                            pred-r = val-r
                            pred-g = val-g
                            pred-b = val-b
                        }
                    }

                    ; Add residual to prediction
                    d9v18 = argb[pi * 4]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    sa-o = d9v18 + pred-a
                    sa i64 = sa-o: {
                        ok -> it

                        -> 0
                    }
                    va = sa & 255
                    argb[pi * 4]: {
                        ok -> it = va

                        -> _
                    }

                    d9v19 = argb[pi * 4 + 1]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    sr-o = d9v19 + pred-r
                    sr i64 = sr-o: {
                        ok -> it

                        -> 0
                    }
                    vr = sr & 255
                    argb[pi * 4 + 1]: {
                        ok -> it = vr

                        -> _
                    }

                    d9v20 = argb[pi * 4 + 2]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    sg-o = d9v20 + pred-g
                    sg i64 = sg-o: {
                        ok -> it

                        -> 0
                    }
                    vg = sg & 255
                    argb[pi * 4 + 2]: {
                        ok -> it = vg

                        -> _
                    }

                    d9v21 = argb[pi * 4 + 3]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    sb-o = d9v21 + pred-b
                    sb i64 = sb-o: {
                        ok -> it

                        -> 0
                    }
                    vb2 = sb & 255
                    argb[pi * 4 + 3]: {
                        ok -> it = vb2

                        -> _
                    }
                }
            }
        }

        {
            ttype == 1 -> {

                ; Inverse color transform (per VP8L spec §4.2)
                ; The color transform image (ct-img) is an ARGB sub-image
                ; of size (ct-w x ct-h). For each 4x4 block of the main image,
                ; we look up the corresponding transform pixel.
                ; Channel layout per spec:
                ;   R channel (offset +1) = red_to_blue   (signed 8-bit)
                ;   G channel (offset +2) = green_to_blue (signed 8-bit)
                ;   B channel (offset +3) = green_to_red  (signed 8-bit)
                ;   A channel (offset +0) = 255 (unused)
                ; Inverse transform:
                ;   new_red  = red  + ((green_to_red   * green) >> 5)
                ;   new_blue = blue + ((green_to_blue  * green) >> 5)
                ;                     + ((red_to_blue  * (new_red & 0xff)) >> 5)
                ; Note: two independent >>5 shifts, not a combined one.
                pi <- [0..n-pixels): {

                    #{overflow=wrap}
                    py = pi / w

                    #{overflow=wrap}
                    px = pi - py * w

                    #{overflow=wrap}
                    blk-x = px / ct-block

                    #{overflow=wrap}
                    blk-y = py / ct-block

                    #{overflow=wrap}
                    blk-idx = blk-y * ct-w + blk-x

                    ; Read coefficients from ct-img ARGB
                    rtb = 0; red_to_blue   (from R channel, signed)
                    gtb = 0; green_to_blue (from G channel, signed)
                    gtr = 0; green_to_red  (from B channel, signed)

                    #{overflow=wrap}
                    {
                        blk-idx * 4 + 3 < ct-img.len() -> {

                            #{overflow=wrap}
                            raw-r = ct-img[blk-idx * 4 + 1]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            raw-g = ct-img[blk-idx * 4 + 2]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            raw-b = ct-img[blk-idx * 4 + 3]: {
                                ok -> it

                                -> 0
                            }

                            ; Convert to signed: values 128..255 → -128..-1
                            rtb = raw-r
                            rtb > 127 -> {

                                #{overflow=wrap}
                                rtbv-o = rtb - 256
                                rtbv i64 = rtbv-o: {
                                    ok -> it

                                    -> 0
                                }
                                rtb = rtbv
                            }
                            gtb = raw-g
                            gtb > 127 -> {

                                #{overflow=wrap}
                                gtbv-o = gtb - 256
                                gtbv i64 = gtbv-o: {
                                    ok -> it

                                    -> 0
                                }
                                gtb = gtbv
                            }
                            gtr = raw-b
                            gtr > 127 -> {

                                #{overflow=wrap}
                                gtrv-o = gtr - 256
                                gtrv i64 = gtrv-o: {
                                    ok -> it

                                    -> 0
                                }
                                gtr = gtrv
                            }
                        }
                    }

                    #{overflow=wrap}
                    g = argb[pi * 4 + 2]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    r = argb[pi * 4 + 1]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    b = argb[pi * 4 + 3]: {
                        ok -> it

                        -> 0
                    }

                    ; Apply inverse color transform per libwebp
                    ; VP8LTransformColorInverse_C: green and new_red are treated
                    ; as SIGNED int8, and ColorTransformDelta uses an ARITHMETIC
                    ; >>5 (webp-ashr). gtr/gtb/rtb are already signed.
                    gs = webp-s8(g)

                    #{overflow=wrap}
                    dr = webp-ashr(gtr * gs, 5)
                    new-red = (r + dr) & 255

                    #{overflow=wrap}
                    argb[pi * 4 + 1]: {
                        ok -> it = new-red

                        -> _
                    }

                    #{overflow=wrap}
                    dbs = webp-ashr(gtb * gs, 5)

                    #{overflow=wrap}
                    drb = webp-ashr(rtb * webp-s8(new-red), 5)
                    new-blue = (b + dbs + drb) & 255

                    #{overflow=wrap}
                    argb[pi * 4 + 3]: {
                        ok -> it = new-blue

                        -> _
                    }
                }
            }
        }

        {
            ttype == 2 -> {

                ; Inverse subtract-green: add green to red and blue
                pi <- [0..n-pixels): {

                    #{overflow=wrap}
                    g = argb[pi * 4 + 2]: {
                        ok -> it

                        -> 0
                    }

                    d9v22 = argb[pi * 4 + 1]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    sr2-o = d9v22 + g
                    sr2 i64 = sr2-o: {
                        ok -> it

                        -> 0
                    }
                    vr2 = sr2 & 255
                    argb[pi * 4 + 1]: {
                        ok -> it = vr2

                        -> _
                    }

                    d9v23 = argb[pi * 4 + 3]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    sb2-o = d9v23 + g
                    sb2 i64 = sb2-o: {
                        ok -> it

                        -> 0
                    }
                    vb3 = sb2 & 255
                    argb[pi * 4 + 3]: {
                        ok -> it = vb3

                        -> _
                    }
                }
            }
        }

        {
            ttype == 3 -> {
                ; Color-indexing inverse already applied above (before this loop,
                ; since it is always the last transform read / first applied and
                ; changes the buffer width). No-op here.
            }
        }
    }

    ; Convert ARGB to output format (RGB or RGBA)
    #{overflow=wrap}
    pixels = with-len(n-pixels * bands)
    {
        bands == 4 -> {
            i <- [0..n-pixels): {

                #{overflow=wrap}
                c0 = argb[i * 4 + 1]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                pixels[i * 4]: {
                    ok -> it = c0

                    -> _
                }

                #{overflow=wrap}
                c1 = argb[i * 4 + 2]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                pixels[i * 4 + 1]: {
                    ok -> it = c1

                    -> _
                }

                #{overflow=wrap}
                c2 = argb[i * 4 + 3]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                pixels[i * 4 + 2]: {
                    ok -> it = c2

                    -> _
                }

                c3 = argb[i * 4]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                pixels[i * 4 + 3]: {
                    ok -> it = c3

                    -> _
                }
            }
        }

        -> {
            i <- [0..n-pixels): {

                #{overflow=wrap}
                c0 = argb[i * 4 + 1]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                pixels[i * 3]: {
                    ok -> it = c0

                    -> _
                }

                #{overflow=wrap}
                c1 = argb[i * 4 + 2]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                pixels[i * 3 + 1]: {
                    ok -> it = c1

                    -> _
                }

                #{overflow=wrap}
                c2 = argb[i * 4 + 3]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                pixels[i * 3 + 2]: {
                    ok -> it = c2

                    -> _
                }
            }
        }
    }
}

; webp-read-u32-le: read 32-bit little-endian
webp-read-u32-le = (data []byte, pos i64) (val i64) {
    b0 = data[pos]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    b1 = data[pos + 1]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    b2 = data[pos + 2]: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    b3 = data[pos + 3]: {
        ok -> it

        -> 0
    }

    val = (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)
}

; webp-parse-vp8: parse VP8 lossy bitstream header for dimensions
webp-parse-vp8 = (data []byte, pos i64, size i64) (w i64, h i64) {
    w = 0
    h = 0

    #{overflow=wrap}
    pos + 10 > data.len() -> return
    tag0 = webp-byte-at(data, pos)
    key-frame = (tag0 & 1) != 0
    ! key-frame -> return

    #{overflow=wrap}
    p3-o = pos + 3
    p3 = p3-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    p4-o = pos + 4
    p4 = p4-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    p5-o = pos + 5
    p5 = p5-o: {
        ok -> it

        -> 0
    }
    b3 = webp-byte-at(data, p3)
    b4 = webp-byte-at(data, p4)
    b5 = webp-byte-at(data, p5)
    {
        b3 == 157 && b4 == 1 && b5 == 42 -> {

            #{overflow=wrap}
            p6-o = pos + 6
            p6 i64 = p6-o: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            p7-o = pos + 7
            p7 i64 = p7-o: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            p8-o = pos + 8
            p8 i64 = p8-o: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            p9-o = pos + 9
            p9 i64 = p9-o: {
                ok -> it

                -> 0
            }
            b6 = webp-byte-at(data, p6)
            b7 = webp-byte-at(data, p7)
            b8 = webp-byte-at(data, p8)
            b9 = webp-byte-at(data, p9)
            b7s = b7 << 8

            #{overflow=wrap}
            wv-o = b6 + b7s
            wv i64 = wv-o: {
                ok -> it

                -> 0
            }
            b9s = b9 << 8

            #{overflow=wrap}
            hv-o = b8 + b9s
            hv i64 = hv-o: {
                ok -> it

                -> 0
            }
            w13 = wv & 16383
            h13 = hv & 16383
            w = w13
            h = h13
        }
    }
}

; webp-parse-vp8l: parse VP8L lossless bitstream header for dimensions
webp-parse-vp8l = (data []byte, pos i64, size i64) (w i64, h i64) {
    w = 0
    h = 0

    #{overflow=wrap}
    pos + 5 > data.len() -> return

    b0 = webp-byte-at(data, pos)
    {
        b0 == 47 -> {
        }

        -> return
    }

    #{overflow=wrap}
    p1-o = pos + 1
    p1 = p1-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    p2-o = pos + 2
    p2 = p2-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    p3-o = pos + 3
    p3 = p3-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    p4-o = pos + 4
    p4 = p4-o: {
        ok -> it

        -> 0
    }
    b1 = webp-byte-at(data, p1)
    b2 = webp-byte-at(data, p2)
    b3 = webp-byte-at(data, p3)
    b4 = webp-byte-at(data, p4)

    b2m = b2 & 63
    b2s = b2m << 8

    #{overflow=wrap}
    wor-o = b1 + b2s
    wor = wor-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    wv-o = wor + 1
    wv = wv-o: {
        ok -> it

        -> 0
    }

    b2h = b2 >> 6
    b3s = b3 << 2
    b4m = b4 & 15
    b4s = b4m << 10

    #{overflow=wrap}
    hor1-o = b2h + b3s
    hor1 = hor1-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    hor2-o = hor1 + b4s
    hor2 = hor2-o: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    hv-o = hor2 + 1
    hv = hv-o: {
        ok -> it

        -> 0
    }
    w = wv
    h = hv
}

; webp-vp8l-alpha-flag: check if VP8L has alpha
webp-vp8l-alpha-flag = (data []byte, pos i64) (has-alpha bool) {
    has-alpha = false

    #{overflow=wrap}
    pos + 5 > data.len() -> return

    #{overflow=wrap}
    p4a-o = pos + 4
    p4a = p4a-o: {
        ok -> it

        -> 0
    }
    b4a = webp-byte-at(data, p4a)
    has-alpha = (b4a & 16) != 0
}

; ── Encoder helpers (VP8L lossless, libwebp-interoperable) ──

; webp-enc-write-bits: append n bits (1..24) of val, LSB first
; buf i64 / cnt i64: bit accumulator state (threaded through)
; out []byte: output byte stream (mutated via push)
; returns new-buf i64, new-cnt i64
webp-enc-write-bits = (buf i64, cnt i64, out []byte, val i64, n i64) (new-buf i64, new-cnt i64) {
    ones = 1 << n

    #{overflow=wrap}
    onesm-o = ones - 1
    onesm = onesm-o: {
        ok -> it

        -> 0
    }
    vm = val & onesm
    vl = vm << cnt

    #{overflow=wrap}
    buf2-o = buf + vl
    buf2 = buf2-o: {
        ok -> it

        -> 0
    }
    buf = buf2

    #{overflow=wrap}
    cntnew-o = cnt + n
    cntnew = cntnew-o: {
        ok -> it

        -> 0
    }
    cnt = cntnew
    cnt >= 8 -> {
        out.push(buf & 255)
        buf = buf >> 8

        #{overflow=wrap}
        c8-o = cnt - 8
        c8 i64 = c8-o: {
            ok -> it

            -> 0
        }
        cnt = c8
    }
    new-buf = buf
    new-cnt = cnt
}

; webp-enc-canonical: assign canonical Huffman codes from code lengths
; (same construction the decoder expects: codes emitted MSB-first)
; lens []i64: code length per symbol (0 = unused)
; codes []i64: output canonical code per symbol (mutated)
webp-enc-canonical = (lens []i64, codes []i64) {
    n-sym = lens.len()
    count []i64 = with-len(16)
    si <- [0..n-sym): {
        ls = lens[si]: {
            ok -> it

            -> 0
        }

        d9v24 byte = count[ls]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv-o = d9v24 + 1
        nv i64 = nv-o: {
            ok -> it

            -> 0
        }
        count[ls]: {
            ok -> it = nv

            -> _
        }
    }
    next-code []i64 = with-len(16)
    code = 0
    k <- [1..16): {
        next-code[k]: {
            ok -> it = code

            -> _
        }
        ck = count[k]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        csum-o = code + ck
        csum i64 = csum-o: {
            ok -> it

            -> 0
        }
        code = csum << 1
    }
    si <- [0..n-sym): {
        cl = lens[si]: {
            ok -> it

            -> 0
        }
        cl > 0 -> {
            d9v25 byte = next-code[cl]: {
                ok -> it

                -> 0
            }

            codes[si]: {
                ok -> it = d9v25

                -> _
            }

            d9v26 byte = next-code[cl]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            nv2-o = d9v26 + 1
            nv2 i64 = nv2-o: {
                ok -> it

                -> 0
            }
            next-code[cl]: {
                ok -> it = nv2

                -> _
            }
        }
    }
}

; webp-enc-huff-lens: build code lengths for a frequency histogram,
; limited to max-len bits (package-merge / Moeller-Reed method).
; freq []i64: symbol frequencies (sum must be > 0)
; max-len i64: hard limit on code length (VP8L allows 15)
; lens []i64: output code lengths (mutated, same length as freq)
webp-enc-huff-lens = (freq []i64, max-len i64, lens []i64) {
    n-sym = freq.len()
    si <- [0..n-sym): {
        lens[si]: {
            ok -> it = 0

            -> _
        }
    }

    ; collect leaves (symbol, weight). Fixed arrays sized to the alphabet so
    ; no vec is reallocated inside a loop (avoids arena/lifetime pitfalls).
    lsym []i64 = with-len(n-sym)
    lw []i64 = with-len(n-sym)
    n-leaves = 0
    si <- [0..n-sym): {
        {
            fs = freq[si]: {
                ok -> it

                -> 0
            }
            fs > 0 -> {
                lsym[n-leaves]: {
                    ok -> it = si

                    -> _
                }

                d9v27 i64 = freq[si]: {
                    ok -> it

                    -> 0
                }

                lw[n-leaves]: {
                    ok -> it = d9v27

                    -> _
                }

                #{overflow=wrap}
                nlv1-o = n-leaves + 1
                nlv1 i64 = nlv1-o: {
                    ok -> it

                    -> 0
                }
                n-leaves = nlv1
            }
        }
    }
    n-leaves == 0 -> return
    n-leaves == 1 -> {
        s0 = lsym[0]: {
            ok -> it

            -> 0
        }
        lens[s0]: {
            ok -> it = 1

            -> _
        }
        return
    }

    ; plain Huffman: nodes 0..n-leaves-1 are leaves (weight = freq, children -1).
    ; repeatedly merge the two smallest-weight active roots into a new parent
    ; until one root remains, then read each leaf's depth as its code length.
    #{overflow=wrap}
    max-nodes = n-leaves * 2
    nw []i64 = with-len(max-nodes)
    nl []i64 = with-len(max-nodes)
    nr []i64 = with-len(max-nodes)
    i <- [0..n-leaves): {
        d9v28 i64 = lw[i]: {
            ok -> it

            -> 0
        }
        nw[i]: {
            ok -> it = d9v28

            -> _
        }
        nl[i]: {
            ok -> it = -1

            -> _
        }
        nr[i]: {
            ok -> it = -1

            -> _
        }
    }
    nn = n-leaves
    act []i64 = with-len(n-leaves)
    na = n-leaves
    i <- [0..n-leaves): {
        act[i]: {
            ok -> it = i

            -> _
        }
    }
    (na > 1) {
        na > 1 -> {

            ; first smallest
            m1 = 0
            k <- [1..na): {
                {
                    ak = act[k]: {
                        ok -> it

                        -> 0
                    }
                    am1 = act[m1]: {
                        ok -> it

                        -> 0
                    }
                    nk = nw[ak]: {
                        ok -> it

                        -> 0
                    }
                    nm1 = nw[am1]: {
                        ok -> it

                        -> 0
                    }
                    nk < nm1 -> m1 = k
                }
            }

            r1 = act[m1]: {
                ok -> it

                -> 0
            }
            j <- [m1..na - 1): {

                #{overflow=wrap}
                d9v29 i64 = act[j + 1]: {
                    ok -> it

                    -> 0
                }

                act[j]: {
                    ok -> it = d9v29

                    -> _
                }
            }

            #{overflow=wrap}
            nad-o = na - 1
            nad i64 = nad-o: {
                ok -> it

                -> 0
            }
            na = nad

            ; second smallest
            m2 = 0
            k <- [1..na): {
                {
                    ak2 = act[k]: {
                        ok -> it

                        -> 0
                    }
                    am2 = act[m2]: {
                        ok -> it

                        -> 0
                    }
                    nk2 = nw[ak2]: {
                        ok -> it

                        -> 0
                    }
                    nm2 = nw[am2]: {
                        ok -> it

                        -> 0
                    }
                    nk2 < nm2 -> m2 = k
                }
            }

            r2 = act[m2]: {
                ok -> it

                -> 0
            }
            j <- [m2..na - 1): {

                #{overflow=wrap}
                d9v30 i64 = act[j + 1]: {
                    ok -> it

                    -> 0
                }

                act[j]: {
                    ok -> it = d9v30

                    -> _
                }
            }

            #{overflow=wrap}
            nad-o = na - 1
            nad i64 = nad-o: {
                ok -> it

                -> 0
            }
            na = nad

            ; new parent node
            d9v31 i64 = nw[r1]: {
                ok -> it

                -> 0
            }

            d9v32 i64 = nw[r2]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            nsum-o = d9v31 + d9v32
            nsum i64 = nsum-o: {
                ok -> it

                -> 0
            }
            nw[nn]: {
                ok -> it = nsum

                -> _
            }
            nl[nn]: {
                ok -> it = r1

                -> _
            }
            nr[nn]: {
                ok -> it = r2

                -> _
            }
            act[na]: {
                ok -> it = nn

                -> _
            }

            #{overflow=wrap}
            nai-o = na + 1
            nai i64 = nai-o: {
                ok -> it

                -> 0
            }
            na = nai

            #{overflow=wrap}
            nni-o = nn + 1
            nni i64 = nni-o: {
                ok -> it

                -> 0
            }
            nn = nni
        }
    }

    ; depth-first traversal from the root (depth 0) to assign leaf code lengths.
    #{overflow=wrap}
    st-n []i64 = with-len(max-nodes + 2)

    #{overflow=wrap}
    st-d []i64 = with-len(max-nodes + 2)
    sp = 0

    d9v33 = act[0]: {
        ok -> it

        -> 0
    }
    st-n[sp]: {
        ok -> it = d9v33

        -> _
    }
    st-d[sp]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    spi-o = sp + 1
    spi = spi-o: {
        ok -> it

        -> 0
    }
    sp = spi
    (sp > 0) {
        sp > 0 -> {

            #{overflow=wrap}
            spd-o = sp - 1
            spd i64 = spd-o: {
                ok -> it

                -> 0
            }
            sp = spd

            nd = st-n[sp]: {
                ok -> it

                -> 0
            }

            dp = st-d[sp]: {
                ok -> it

                -> 0
            }

            nlv = nl[nd]: {
                ok -> it

                -> 0
            }
            {
                nlv < 0 -> {

                    ; leaf: symbol lsym[nd] gets length dp (min 1)
                    sy = lsym[nd]: {
                        ok -> it

                        -> 0
                    }
                    len-v = dp
                    len-v < 1 -> len-v = 1
                    lens[sy]: {
                        ok -> it = len-v

                        -> _
                    }
                }

                -> {
                    d9v34 i64 = nl[nd]: {
                        ok -> it

                        -> 0
                    }

                    st-n[sp]: {
                        ok -> it = d9v34

                        -> _
                    }

                    #{overflow=wrap}
                    dp1-o = dp + 1
                    dp1 i64 = dp1-o: {
                        ok -> it

                        -> 0
                    }
                    st-d[sp]: {
                        ok -> it = dp1

                        -> _
                    }

                    #{overflow=wrap}
                    spi2-o = sp + 1
                    spi2 i64 = spi2-o: {
                        ok -> it

                        -> 0
                    }
                    sp = spi2

                    d9v35 i64 = nr[nd]: {
                        ok -> it

                        -> 0
                    }

                    st-n[sp]: {
                        ok -> it = d9v35

                        -> _
                    }

                    #{overflow=wrap}
                    dp2-o = dp + 1
                    dp2 i64 = dp2-o: {
                        ok -> it

                        -> 0
                    }
                    st-d[sp]: {
                        ok -> it = dp2

                        -> _
                    }

                    #{overflow=wrap}
                    spi2-o = sp + 1
                    spi2 i64 = spi2-o: {
                        ok -> it

                        -> 0
                    }
                    sp = spi2
                }
            }
        }
    }
}

; webp-enc-build-cl-seq: encode one prefix tree's code lengths with the
; 18-symbol meta-Huffman alphabet (direct / repeat-prev / repeat-zero)
; lens []i64: code lengths (0..15), e.g. 256 or 4096 entries
; seq-sym []i64 / seq-extra []i64 / seq-nextra []i64: emitted meta symbols (mutated)
webp-enc-build-cl-seq = (lens []i64, seq-sym []i64, seq-extra []i64, seq-nextra []i64) {
    n = lens.len()
    i = 0
    (i < n) {
        i < n -> {
            v = lens[i]: {
                ok -> it

                -> 0
            }

            ; count a rlen of equal code lengths (max 6) starting at i
            rlen = 1
            scanning = true
            ni i64 = 0
            (scanning && rlen < 6) {
                scanning && rlen < 6 -> {

                    #{overflow=wrap}
                    niv-o = i + rlen
                    niv i64 = niv-o: {
                        ok -> it

                        -> 0
                    }
                    ni = niv

                    nv = lens[ni]: {
                        ok -> it

                        -> 0
                    }
                    {
                        ni < n && nv == v -> {

                            #{overflow=wrap}
                            rli-o = rlen + 1
                            rli i64 = rli-o: {
                                ok -> it

                                -> 0
                            }
                            rlen = rli
                        }

                        -> {
                            scanning = false
                        }
                    }
                }
            }

            #{overflow=wrap}
            im1v-o = i - 1
            im1v i64 = im1v-o: {
                ok -> it

                -> 0
            }
            im1 = im1v
            lim1 = lens[im1]: {
                ok -> it

                -> 0
            }
            {
                ; a run of zeros must use symbol 17 (repeat zero); symbol 16
                ; repeats the last NON-ZERO literal, so it must never carry a
                ; zero value (decoder keeps prev-code-len unchanged for 17/18).
                v == 0 && rlen >= 3 -> {
                    seq-sym.push(17)
                    seq-extra.push(rlen - 3)
                    seq-nextra.push(3)
                }

                v != 0 && i > 0 && rlen >= 3 && v == lim1 -> {

                    ; repeat previous (non-zero) code length: meta symbol 16,
                    ; 2 extra bits, count = 3 + extra = rlen
                    seq-sym.push(16)
                    seq-extra.push(rlen - 3)
                    seq-nextra.push(2)
                }

                -> {

                    ; emit direct code lengths for the rlen
                    k <- [0..rlen): {
                        seq-sym.push(v)
                        seq-extra.push(0)
                        seq-nextra.push(0)
                    }
                }
            }

            #{overflow=wrap}
            ir-o = i + rlen
            ir i64 = ir-o: {
                ok -> it

                -> 0
            }
            i = ir
        }
    }
}

; webp-enc-write-code: emit a canonical Huffman code MSB-first (the decoder
; reconstructs symbols as code = (code << 1) | bit, so the code's high bit must
; hit the stream first). n = code length in bits.
webp-enc-write-code = (buf i64, cnt i64, out []byte, code i64, n i64) (new-buf i64, new-cnt i64) {
    k <- [0..n): {

        #{overflow=wrap}
        shift = n - 1 - k
        b = (code >> shift) & 1
        buf, cnt = webp-enc-write-bits(buf, cnt, out, b, 1)
    }
    new-buf = buf
    new-cnt = cnt
}

; webp-enc-write-tree-fixed: non-simple VP8L Huffman block that uses a fixed
; 4-bit code-length alphabet (symbols 0..15, all length 4). No RLE symbols are
; used; every code length is emitted directly. Larger but unambiguous.
webp-enc-write-tree-fixed = (buf i64, cnt i64, out []byte, lens []i64) (new-buf i64, new-cnt i64) {
    n = lens.len()
    buf, cnt = webp-enc-write-bits(buf, cnt, out, 0, 1)
    buf, cnt = webp-enc-write-bits(buf, cnt, out, 15, 4)
    k-order-fixed []i64 = with-len(19)
    k-order-fixed[0]: {
        ok -> it = 17

        -> _
    }
    k-order-fixed[1]: {
        ok -> it = 18

        -> _
    }
    k-order-fixed[2]: {
        ok -> it = 0

        -> _
    }
    k-order-fixed[3]: {
        ok -> it = 1

        -> _
    }
    k-order-fixed[4]: {
        ok -> it = 2

        -> _
    }
    k-order-fixed[5]: {
        ok -> it = 3

        -> _
    }
    k-order-fixed[6]: {
        ok -> it = 4

        -> _
    }
    k-order-fixed[7]: {
        ok -> it = 5

        -> _
    }
    k-order-fixed[8]: {
        ok -> it = 16

        -> _
    }
    k-order-fixed[9]: {
        ok -> it = 6

        -> _
    }
    k-order-fixed[10]: {
        ok -> it = 7

        -> _
    }
    k-order-fixed[11]: {
        ok -> it = 8

        -> _
    }
    k-order-fixed[12]: {
        ok -> it = 9

        -> _
    }
    k-order-fixed[13]: {
        ok -> it = 10

        -> _
    }
    k-order-fixed[14]: {
        ok -> it = 11

        -> _
    }
    k-order-fixed[15]: {
        ok -> it = 12

        -> _
    }
    k-order-fixed[16]: {
        ok -> it = 13

        -> _
    }
    k-order-fixed[17]: {
        ok -> it = 14

        -> _
    }
    k-order-fixed[18]: {
        ok -> it = 15

        -> _
    }
    mi <- [0..19): {
        ko = k-order-fixed[mi]: {
            ok -> it

            -> 0
        }
        clen i64 = 0
        ko <= 15 -> clen = 4
        buf, cnt = webp-enc-write-bits(buf, cnt, out, clen, 3)
    }
    buf, cnt = webp-enc-write-bits(buf, cnt, out, 0, 1)
    k <- [0..n): {
        lv = lens[k]: {
            ok -> it

            -> 0
        }
        buf, cnt = webp-enc-write-code(buf, cnt, out, lv, 4)
    }
    new-buf = buf
    new-cnt = cnt
}

; webp-enc-write-tree: write one prefix code's code lengths as a
; spec-correct VP8L Huffman-code block (mirrors webp-decode-meta-huff).
; Simple code (1 bit flag + <=2 symbols of length 1) when the tree has <=2
; nonzero lengths that are all 1; otherwise the non-simple code-length-code
; block (num_codes + permuted 3-bit CL lengths + use-length + CL sequence).
; lens []i64: code lengths of the tree
; returns new-buf i64, new-cnt i64
webp-enc-write-tree = (buf i64, cnt i64, out []byte, lens []i64) (new-buf i64, new-cnt i64) {
    n = lens.len()
    nzc = 0
    s1 = 0
    s2 = 0
    all-one = true
    k <- [0..n): {
        cl = lens[k]: {
            ok -> it

            -> 0
        }
        {
            cl > 0 -> {

                #{overflow=wrap}
                nzci-o = nzc + 1
                nzci i64 = nzci-o: {
                    ok -> it

                    -> 0
                }
                nzc = nzci
                {
                    nzc == 1 -> s1 = k
                }
                {
                    nzc == 2 -> s2 = k
                }
                {
                    cl != 1 -> all-one = false
                }
            }
        }
    }
    {
        nzc > 2 || ! all-one -> {
            nb i64 = 0
            nc i64 = 0
            nb, nc = webp-enc-write-tree-fixed(buf, cnt, out, lens)
            new-buf = nb
            new-cnt = nc
            return
        }
    }
    {
        nzc <= 2 && all-one -> {

            ; simple code
            buf, cnt = webp-enc-write-bits(buf, cnt, out, 1, 1)
            scf = 0
            {
                nzc == 2 -> scf = 1
            }
            buf, cnt = webp-enc-write-bits(buf, cnt, out, scf, 1)
            f1 = 0
            {
                s1 >= 2 -> f1 = 1
            }
            buf, cnt = webp-enc-write-bits(buf, cnt, out, f1, 1)
            {
                f1 == 0 -> {
                    buf, cnt = webp-enc-write-bits(buf, cnt, out, s1, 1)
                }

                -> {
                    buf, cnt = webp-enc-write-bits(buf, cnt, out, s1, 8)
                }
            }
            {
                nzc == 2 -> {
                    buf, cnt = webp-enc-write-bits(buf, cnt, out, s2, 8)
                }
            }
        }

        -> {

            ; non-simple: code lengths coded with the 19-symbol CL alphabet
            seq-sym []i64 = with-cap(0)
            seq-extra []i64 = with-cap(0)
            seq-nextra []i64 = with-cap(0)
            webp-enc-build-cl-seq(lens, seq-sym, seq-extra, seq-nextra)

            cl-freq []i64 = with-len(19)
            i <- [0..seq-sym.len()): {
                svi = seq-sym[i]: {
                    ok -> it

                    -> 0
                }
                d9v36 i64 = cl-freq[svi]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                nv-o = d9v36 + 1
                nv i64 = nv-o: {
                    ok -> it

                    -> 0
                }
                cl-freq[svi]: {
                    ok -> it = nv

                    -> _
                }
            }

            ; the CL decoder cannot represent a single-symbol CL table with
            ; real bits; add a filler symbol so >=2 CL symbols are present
            ndist = 0
            last-used = 0
            k <- [0..19): {
                cfk = cl-freq[k]: {
                    ok -> it

                    -> 0
                }
                cfk > 0 -> {

                    #{overflow=wrap}
                    ndi-o = ndist + 1
                    ndi i64 = ndi-o: {
                        ok -> it

                        -> 0
                    }
                    ndist = ndi
                    last-used = k
                }
            }
            {
                ndist < 2 -> {
                    fill = 0
                    {
                        last-used == 0 -> fill = 1
                    }

                    d9v37 i64 = cl-freq[fill]: {
                        ok -> it

                        -> 0
                    }

                    #{overflow=wrap}
                    nvf-o = d9v37 + 1
                    nvf i64 = nvf-o: {
                        ok -> it

                        -> 0
                    }
                    cl-freq[fill]: {
                        ok -> it = nvf

                        -> _
                    }
                }
            }
            cl-lens []i64 = with-len(19)
            webp-enc-huff-lens(cl-freq, 7, cl-lens)
            cl-codes []i64 = with-len(19)
            webp-enc-canonical(cl-lens, cl-codes)

            ; kCodeLengthCodeOrder[19]
            k-order []i64 = with-len(19)
            k-order[0]: {
                ok -> it = 17

                -> _
            }
            k-order[1]: {
                ok -> it = 18

                -> _
            }
            k-order[2]: {
                ok -> it = 0

                -> _
            }
            k-order[3]: {
                ok -> it = 1

                -> _
            }
            k-order[4]: {
                ok -> it = 2

                -> _
            }
            k-order[5]: {
                ok -> it = 3

                -> _
            }
            k-order[6]: {
                ok -> it = 4

                -> _
            }
            k-order[7]: {
                ok -> it = 5

                -> _
            }
            k-order[8]: {
                ok -> it = 16

                -> _
            }
            k-order[9]: {
                ok -> it = 6

                -> _
            }
            k-order[10]: {
                ok -> it = 7

                -> _
            }
            k-order[11]: {
                ok -> it = 8

                -> _
            }
            k-order[12]: {
                ok -> it = 9

                -> _
            }
            k-order[13]: {
                ok -> it = 10

                -> _
            }
            k-order[14]: {
                ok -> it = 11

                -> _
            }
            k-order[15]: {
                ok -> it = 12

                -> _
            }
            k-order[16]: {
                ok -> it = 13

                -> _
            }
            k-order[17]: {
                ok -> it = 14

                -> _
            }
            k-order[18]: {
                ok -> it = 15

                -> _
            }

            ; not-simple flag
            buf, cnt = webp-enc-write-bits(buf, cnt, out, 0, 1)

            ; num_codes = 19 -> stored as (19 - 4) in 4 bits
            buf, cnt = webp-enc-write-bits(buf, cnt, out, 15, 4)
            mi <- [0..19): {
                ko = k-order[mi]: {
                    ok -> it

                    -> 0
                }

                clk = cl-lens[ko]: {
                    ok -> it

                    -> 0
                }
                buf, cnt = webp-enc-write-bits(buf, cnt, out, clk, 3)
            }

            ; use-length = 0 (all n symbols follow)
            buf, cnt = webp-enc-write-bits(buf, cnt, out, 0, 1)
            i <- [0..seq-sym.len()): {
                s = seq-sym[i]: {
                    ok -> it

                    -> 0
                }

                ccs = cl-codes[s]: {
                    ok -> it

                    -> 0
                }
                cls = cl-lens[s]: {
                    ok -> it

                    -> 0
                }
                buf, cnt = webp-enc-write-code(buf, cnt, out, ccs, cls)
                sne = seq-nextra[i]: {
                    ok -> it

                    -> 0
                }
                sne > 0 -> {
                    sxe = seq-extra[i]: {
                        ok -> it

                        -> 0
                    }
                    buf, cnt = webp-enc-write-bits(buf, cnt, out, sxe, sne)
                }
            }
        }
    }
    new-buf = buf
    new-cnt = cnt
}

; webp-enc-write-entropy: 5 prefix code blocks + green-prefixed pixel data
; main-w i64: encoded width (reduced by color-index packing)
; g/r/b/a []i64: one component per pixel (a unused when has-alpha is false)
; len-g/len-r/len-b/len-a []i64: 5 x 4096 code-length arrays (tree j at offset j*4096)
; returns new-buf i64, new-cnt i64
webp-enc-write-entropy = (buf i64, cnt i64, out []byte, main-w i64, npix i64, g []i64, r []i64, b []i64, a []i64, len-g []i64, len-r []i64, len-b []i64, len-a []i64, has-alpha bool) (new-buf i64, new-cnt i64) {

    ; canonical codes per tree + write the 5 code-length blocks
    #{overflow=wrap}
    all-codes []i64 = with-len(5 * 4096)
    j <- [0..5): {
        tree-lens []i64 = with-len(4096)

        #{overflow=wrap}
        base = j * 4096
        k <- [0..4096): {

            #{overflow=wrap}
            bk-o = base + k
            bk i64 = bk-o: {
                ok -> it

                -> 0
            }
            d9v38 i64 = len-g[bk]: {
                ok -> it

                -> 0
            }
            tree-lens[k]: {
                ok -> it = d9v38

                -> _
            }
        }
        tree-codes []i64 = with-len(4096)
        webp-enc-canonical(tree-lens, tree-codes)
        k <- [0..4096): {
            d9v39 i64 = tree-codes[k]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            bk2-o = base + k
            bk2 i64 = bk2-o: {
                ok -> it

                -> 0
            }
            all-codes[bk2]: {
                ok -> it = d9v39

                -> _
            }
        }
        buf, cnt = webp-enc-write-tree(buf, cnt, out, tree-lens)
    }

    ; pixel data: green first, then red/blue/alpha through tree (green >> 3) % 5
    i <- [0..npix): {
        gv = g[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        sel = (gv >> 3) % 5

        #{overflow=wrap}
        base = sel * 4096

        #{overflow=wrap}
        gidx-o = base + gv
        gidx i64 = gidx-o: {
            ok -> it

            -> 0
        }
        acg = all-codes[gidx]: {
            ok -> it

            -> 0
        }
        lg = len-g[gidx]: {
            ok -> it

            -> 0
        }
        buf, cnt = webp-enc-write-bits(buf, cnt, out, acg, lg)

        rv = r[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        rb1-o = base + 256
        rb1 i64 = rb1-o: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        ridx-o = rb1 + rv
        ridx i64 = ridx-o: {
            ok -> it

            -> 0
        }
        acr = all-codes[ridx]: {
            ok -> it

            -> 0
        }
        lr = len-r[ridx]: {
            ok -> it

            -> 0
        }
        buf, cnt = webp-enc-write-bits(buf, cnt, out, acr, lr)

        bv = b[i]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        bb1-o = base + 512
        bb1 i64 = bb1-o: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        bidx-o = bb1 + bv
        bidx i64 = bidx-o: {
            ok -> it

            -> 0
        }
        acb = all-codes[bidx]: {
            ok -> it

            -> 0
        }
        lb = len-b[bidx]: {
            ok -> it

            -> 0
        }
        buf, cnt = webp-enc-write-bits(buf, cnt, out, acb, lb)
        {
            has-alpha -> {
                av = a[i]: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                ab1-o = base + 768
                ab1 i64 = ab1-o: {
                    ok -> it

                    -> 0
                }

                #{overflow=wrap}
                aidx-o = ab1 + av
                aidx i64 = aidx-o: {
                    ok -> it

                    -> 0
                }
                aca = all-codes[aidx]: {
                    ok -> it

                    -> 0
                }
                la = len-a[aidx]: {
                    ok -> it

                    -> 0
                }
                buf, cnt = webp-enc-write-bits(buf, cnt, out, aca, la)
            }
        }
    }
    new-buf = buf
    new-cnt = cnt
}

; ── Load ──

; webp.load: load a WebP file (VP8L lossless decoding)
; Supports: VP8L (lossless). Lossy VP8 is NOT supported (returns nil).
; path str: file path
; returns img ?image: loaded image, nil on error or unsupported format
load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len() < 12 -> {
        img = nil
        return
    }

    ; Check RIFF signature
    {
        (data[0] & 255) == 82 && (data[1] & 255) == 73 && (data[2] & 255) == 70 && (data[3] & 255) == 70 -> {
        }

        -> {
            img = nil
            return
        }

        ; Check WEBP format
        (data[8] & 255) == 87 && (data[9] & 255) == 69 && (data[10] & 255) == 66 && (data[11] & 255) == 80 -> {
        }

        -> {
            img = nil
            return
        }
    }

    pos = 12
    w = 0
    h = 0
    bands = 3
    vp8l-pos = -1
    vp8l-size = 0
    has-alpha = false
    chunk-data-pos = 0
    size-pos = 0

    ; Parse RIFF chunks
    #{overflow=wrap}
    (pos + 8 <= data.len()) {

        #{overflow=wrap}
        pos + 8 <= data.len() -> {
            fourcc = data.slice(pos, pos + 4).to-bytes-str()

            #{overflow=wrap}
            sp4-o = pos + 4
            sp4 i64 = sp4-o: {
                ok -> it

                -> 0
            }
            size-pos = sp4
            chunk-size = webp-read-u32-le(data, size-pos)

            #{overflow=wrap}
            cdp8-o = pos + 8
            cdp8 i64 = cdp8-o: {
                ok -> it

                -> 0
            }
            chunk-data-pos = cdp8
            {
                fourcc == 'VP8X' -> {
                    {

                        #{overflow=wrap}
                        cdp10-o = chunk-data-pos + 10
                        cdp10 i64 = cdp10-o: {
                            ok -> it

                            -> 0
                        }
                        cdp10 <= data.len() -> {
                            b0x = webp-byte-at(data, chunk-data-pos)
                            has-alpha = (b0x & 16) != 0

                            #{overflow=wrap}
                            c4-o = chunk-data-pos + 4
                            c4 i64 = c4-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            c5-o = chunk-data-pos + 5
                            c5 i64 = c5-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            c6-o = chunk-data-pos + 6
                            c6 i64 = c6-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            c7-o = chunk-data-pos + 7
                            c7 i64 = c7-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            c8b-o = chunk-data-pos + 8
                            c8b i64 = c8b-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            c9-o = chunk-data-pos + 9
                            c9 i64 = c9-o: {
                                ok -> it

                                -> 0
                            }
                            d4 = webp-byte-at(data, c4)
                            d5 = webp-byte-at(data, c5)
                            d6 = webp-byte-at(data, c6)
                            d7 = webp-byte-at(data, c7)
                            d8b = webp-byte-at(data, c8b)
                            d9 = webp-byte-at(data, c9)
                            d5s = d5 << 8
                            d6s = d6 << 16

                            #{overflow=wrap}
                            cw1-o = d4 + d5s
                            cw1 i64 = cw1-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            cw2-o = cw1 + d6s
                            cw2 i64 = cw2-o: {
                                ok -> it

                                -> 0
                            }
                            d8s = d8b << 8
                            d9s = d9 << 16

                            #{overflow=wrap}
                            ch1-o = d7 + d8s
                            ch1 i64 = ch1-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            ch2-o = ch1 + d9s
                            ch2 i64 = ch2-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            wp1-o = cw2 + 1
                            wp1 i64 = wp1-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            hp1-o = ch2 + 1
                            hp1 i64 = hp1-o: {
                                ok -> it

                                -> 0
                            }
                            w = wp1
                            h = hp1
                        }
                    }
                    has-alpha -> bands = 4
                }

                fourcc == 'VP8L' -> {
                    vp8l-pos = chunk-data-pos
                    vp8l-size = chunk-size
                    w, h = webp-parse-vp8l(data, chunk-data-pos, chunk-size)
                    alpha-flag = webp-vp8l-alpha-flag(data, chunk-data-pos)
                    alpha-flag -> {
                        has-alpha = true
                        bands = 4
                    }
                }

                fourcc == 'VP8 ' -> {

                    ; Lossy VP8 — decode with the vp8 module (fixed-point path).
                    payload = data.slice(chunk-data-pos, chunk-data-pos + chunk-size)
                    rgb, dw, dh, vok = vp8.vp8-decode-frame(payload, chunk-size)
                    vok == 0 -> {
                        img = nil
                        return
                    }
                    {

                        #{overflow=wrap}
                        vdbuf []byte = with-len(dw * dh * 3)
                        vk <- [0..dw * dh * 3): {
                            d9v40 byte = rgb[vk]: {
                                ok -> it

                                -> 0
                            }
                            vdbuf[vk]: {
                                ok -> it = d9v40

                                -> _
                            }
                        }
                        img = image.new-from-data(dw, dh, 3, vdbuf)
                        return
                    }
                }
            }

            #{overflow=wrap}
            pn-o = chunk-data-pos + chunk-size
            pn i64 = pn-o: {
                ok -> it

                -> 0
            }
            pos = pn
            csm = chunk-size & 1
            csm != 0 -> {

                #{overflow=wrap}
                pp1-o = pos + 1
                pp1 i64 = pp1-o: {
                    ok -> it

                    -> 0
                }
                pos = pp1
            }
        }
    }

    ; Check if VP8L was found
    {
        vp8l-pos < 0 || w <= 0 || h <= 0 || w > 65535 || h > 65535 -> {
            img = nil
            return
        }
    }

    ; Decode VP8L lossless bitstream
    pixels = webp-decode-vp8l(data, vp8l-pos, w, h, has-alpha)

    ; Build image from decoded pixel data
    #{overflow=wrap}
    dbuf []byte = with-len(w * h * bands)
    i <- [0..w * h * bands): {
        d9v41 byte = pixels[i]: {
            ok -> it

            -> 0
        }
        dbuf[i]: {
            ok -> it = d9v41

            -> _
        }
    }
    img = image.new-from-data(w, h, bands, dbuf)
}

; ── Save ──

; webp.save: save image as WebP VP8L lossless, interoperable with libwebp
; Stream layout: header + optional color-index transform (unique colors
; <= 256, with 1/2/4/8-bit index packing) + subtract-green + 5 canonical
; Huffman prefix codes built from real histograms + entropy-coded pixels.
; path str: output path
; img image: image to save
; webp-enc-write-subimage: encode a VP8L sub-image used for transforms
; (e.g. the color-index palette). There is no 0x2F signature, no transform
; chain and no meta-Huffman: only the 1-bit color-cache-used flag (=0)
; followed by the 5 canonical Huffman trees and the green-first entropy-coded
; pixels. This is exactly what webp-decode-argb-image expects for a
; (allow-meta=false) sub-image. buf/cnt are threaded; out is the byte
; accumulator; sub-w is the encoded width; npix is the pixel count; g/r/b/a
; hold one component per pixel.
webp-enc-write-subimage = (buf i64, cnt i64, out []byte, sub-w i64, npix i64, g []i64, r []i64, b []i64, a []i64, has-alpha bool) (new-buf i64, new-cnt i64) {

    ; color cache: not used
    buf, cnt = webp-enc-write-bits(buf, cnt, out, 0, 1)

    ; build 5 single-group Huffman trees (green 280, red/blue/alpha 256, dist 40)
    ts-g = 280
    ts-c = 256
    ts-d = 40
    freq-g []i64 = with-len(ts-g)
    freq-r []i64 = with-len(ts-c)
    freq-b []i64 = with-len(ts-c)
    freq-a []i64 = with-len(ts-c)
    freq-d []i64 = with-len(ts-d)
    i <- [0..npix): {
        gi = g[i]: {
            ok -> it

            -> 0
        }
        d9v42 i64 = freq-g[gi]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv42-o = d9v42 + 1
        nv42 i64 = nv42-o: {
            ok -> it

            -> 0
        }
        freq-g[gi]: {
            ok -> it = nv42

            -> _
        }

        ri = r[i]: {
            ok -> it

            -> 0
        }
        d9v43 i64 = freq-r[ri]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv43-o = d9v43 + 1
        nv43 i64 = nv43-o: {
            ok -> it

            -> 0
        }
        freq-r[ri]: {
            ok -> it = nv43

            -> _
        }

        bi = b[i]: {
            ok -> it

            -> 0
        }
        d9v44 i64 = freq-b[bi]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv44-o = d9v44 + 1
        nv44 i64 = nv44-o: {
            ok -> it

            -> 0
        }
        freq-b[bi]: {
            ok -> it = nv44

            -> _
        }

        ai = a[i]: {
            ok -> it

            -> 0
        }
        d9v45 i64 = freq-a[ai]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv45-o = d9v45 + 1
        nv45 i64 = nv45-o: {
            ok -> it

            -> 0
        }
        freq-a[ai]: {
            ok -> it = nv45

            -> _
        }
    }

    ; code lengths per tree (limit 15 bits per VP8L spec)
    len-g []i64 = with-len(ts-g)
    len-r []i64 = with-len(ts-c)
    len-b []i64 = with-len(ts-c)
    len-a []i64 = with-len(ts-c)
    len-d []i64 = with-len(ts-d)
    webp-enc-huff-lens(freq-g, 15, len-g)
    webp-enc-huff-lens(freq-r, 15, len-r)
    webp-enc-huff-lens(freq-b, 15, len-b)
    webp-enc-huff-lens(freq-a, 15, len-a)
    webp-enc-huff-lens(freq-d, 15, len-d)
    codes-g []i64 = with-len(ts-g)
    codes-r []i64 = with-len(ts-c)
    codes-b []i64 = with-len(ts-c)
    codes-a []i64 = with-len(ts-c)
    webp-enc-canonical(len-g, codes-g)
    webp-enc-canonical(len-r, codes-r)
    webp-enc-canonical(len-b, codes-b)
    webp-enc-canonical(len-a, codes-a)

    ; distinct symbol counts (<=1 => decoder reads 0 bits for that channel)
    nz-g = 0
    i <- [0..ts-g): {
        lgi = len-g[i]: {
            ok -> it

            -> 0
        }
        lgi > 0 -> {

            #{overflow=wrap}
            nzg-o = nz-g + 1
            nzg i64 = nzg-o: {
                ok -> it

                -> 0
            }
            nz-g = nzg
        }
    }
    nz-r = 0
    i <- [0..ts-c): {
        lri = len-r[i]: {
            ok -> it

            -> 0
        }
        lri > 0 -> {

            #{overflow=wrap}
            nzr-o = nz-r + 1
            nzr i64 = nzr-o: {
                ok -> it

                -> 0
            }
            nz-r = nzr
        }
    }
    nz-b = 0
    i <- [0..ts-c): {
        lbi = len-b[i]: {
            ok -> it

            -> 0
        }
        lbi > 0 -> {

            #{overflow=wrap}
            nzb-o = nz-b + 1
            nzb i64 = nzb-o: {
                ok -> it

                -> 0
            }
            nz-b = nzb
        }
    }
    nz-a = 0
    i <- [0..ts-c): {
        lai = len-a[i]: {
            ok -> it

            -> 0
        }
        lai > 0 -> {

            #{overflow=wrap}
            nza-o = nz-a + 1
            nza i64 = nza-o: {
                ok -> it

                -> 0
            }
            nz-a = nza
        }
    }

    ; the 5 code-length blocks
    buf, cnt = webp-enc-write-tree(buf, cnt, out, len-g)
    buf, cnt = webp-enc-write-tree(buf, cnt, out, len-r)
    buf, cnt = webp-enc-write-tree(buf, cnt, out, len-b)
    buf, cnt = webp-enc-write-tree(buf, cnt, out, len-a)
    buf, cnt = webp-enc-write-tree(buf, cnt, out, len-d)

    ; entropy-coded pixels: green, red, blue, alpha (single group, no LZ77)
    i <- [0..npix): {
        {
            nz-g > 1 -> {
                gv = g[i]: {
                    ok -> it

                    -> 0
                }

                ccg = codes-g[gv]: {
                    ok -> it

                    -> 0
                }
                lcg = len-g[gv]: {
                    ok -> it

                    -> 0
                }
                buf, cnt = webp-enc-write-code(buf, cnt, out, ccg, lcg)
            }
        }
        {
            nz-r > 1 -> {
                rv = r[i]: {
                    ok -> it

                    -> 0
                }

                ccr = codes-r[rv]: {
                    ok -> it

                    -> 0
                }
                lcr = len-r[rv]: {
                    ok -> it

                    -> 0
                }
                buf, cnt = webp-enc-write-code(buf, cnt, out, ccr, lcr)
            }
        }
        {
            nz-b > 1 -> {
                bv = b[i]: {
                    ok -> it

                    -> 0
                }

                ccb = codes-b[bv]: {
                    ok -> it

                    -> 0
                }
                lcb = len-b[bv]: {
                    ok -> it

                    -> 0
                }
                buf, cnt = webp-enc-write-code(buf, cnt, out, ccb, lcb)
            }
        }
        {
            nz-a > 1 -> {
                av = a[i]: {
                    ok -> it

                    -> 0
                }

                cca = codes-a[av]: {
                    ok -> it

                    -> 0
                }
                lca = len-a[av]: {
                    ok -> it

                    -> 0
                }
                buf, cnt = webp-enc-write-code(buf, cnt, out, cca, lca)
            }
        }
    }
    new-buf = buf
    new-cnt = cnt
}

; returns ok bool
save = (path str, img image) (ok bool) {
    w = img.width
    h = img.height
    has-alpha = img.bands == 4
    w > 16384 || h > 16384 -> {
        ok = false
        return
    }

    #{overflow=wrap}
    npix = w * h

    ; unpack source pixels into ARGB component arrays
    g0 []i64 = with-len(npix)
    r0 []i64 = with-len(npix)
    b0 []i64 = with-len(npix)
    a0 []i64 = with-len(npix)
    i <- [0..npix): {

        #{overflow=wrap}
        o = i * img.bands

        #{overflow=wrap}
        o1-o = o + 1
        o1 i64 = o1-o: {
            ok -> it

            -> 0
        }
        d9v46 byte = img.data[o1]: {
            ok -> it

            -> 0
        }
        g0[i]: {
            ok -> it = d9v46

            -> _
        }

        d9v47 byte = img.data[o]: {
            ok -> it

            -> 0
        }
        r0[i]: {
            ok -> it = d9v47

            -> _
        }

        #{overflow=wrap}
        o2-o = o + 2
        o2 i64 = o2-o: {
            ok -> it

            -> 0
        }
        d9v48 byte = img.data[o2]: {
            ok -> it

            -> 0
        }
        b0[i]: {
            ok -> it = d9v48

            -> _
        }
        {
            has-alpha -> {

                #{overflow=wrap}
                o3-o = o + 3
                o3 i64 = o3-o: {
                    ok -> it

                    -> 0
                }
                d9v49 byte = img.data[o3]: {
                    ok -> it

                    -> 0
                }
                a0[i]: {
                    ok -> it = d9v49

                    -> _
                }
            }

            -> {
                a0[i]: {
                    ok -> it = 255

                    -> _
                }
            }
        }
    }

    ; color-index detection: collect up to 256 unique ARGB colors.
    ; if a 257th distinct color appears, abandon color-index mode cleanly.
    ci-mode = false
    ci-candidate = true
    pal-count = 0
    pal-a []i64 = with-len(256)
    pal-r []i64 = with-len(256)
    pal-g []i64 = with-len(256)
    pal-b []i64 = with-len(256)
    idx []i64 = with-len(npix)
    i <- [0..npix): {
        ci-candidate -> {
            found = -1
            pr = r0[i]: {
                ok -> it

                -> 0
            }
            pg = g0[i]: {
                ok -> it

                -> 0
            }
            pb = b0[i]: {
                ok -> it

                -> 0
            }
            pa = a0[i]: {
                ok -> it

                -> 0
            }
            p <- [0..pal-count): {
                prp = pal-r[p]: {
                    ok -> it

                    -> 0
                }
                pgp = pal-g[p]: {
                    ok -> it

                    -> 0
                }
                pbp = pal-b[p]: {
                    ok -> it

                    -> 0
                }
                pap = pal-a[p]: {
                    ok -> it

                    -> 0
                }
                found < 0 && prp == pr && pgp == pg && pbp == pb && pap == pa -> found = p
            }
            {
                found >= 0 -> {
                    idx[i]: {
                        ok -> it = found

                        -> _
                    }
                }

                -> {
                    pal-count < 256 -> {
                        d9v50 i64 = r0[i]: {
                            ok -> it

                            -> 0
                        }

                        pal-r[pal-count]: {
                            ok -> it = d9v50

                            -> _
                        }

                        d9v51 i64 = g0[i]: {
                            ok -> it

                            -> 0
                        }

                        pal-g[pal-count]: {
                            ok -> it = d9v51

                            -> _
                        }

                        d9v52 i64 = b0[i]: {
                            ok -> it

                            -> 0
                        }

                        pal-b[pal-count]: {
                            ok -> it = d9v52

                            -> _
                        }

                        d9v53 i64 = a0[i]: {
                            ok -> it

                            -> 0
                        }

                        pal-a[pal-count]: {
                            ok -> it = d9v53

                            -> _
                        }
                        idx[i]: {
                            ok -> it = pal-count

                            -> _
                        }

                        #{overflow=wrap}
                        pci-o = pal-count + 1
                        pci i64 = pci-o: {
                            ok -> it

                            -> 0
                        }
                        pal-count = pci
                    }

                    -> {
                        ci-candidate = false
                    }
                }
            }
        }
    }
    ci-candidate && pal-count > 0 && pal-count <= 256 -> ci-mode = true

    ; bits per color index from palette size (per VP8L spec)
    ci-bits = 8
    ci-mode -> {
        {
            pal-count <= 2 -> ci-bits = 1
        }
        {
            pal-count > 2 && pal-count <= 4 -> ci-bits = 2
        }
        {
            pal-count > 4 && pal-count <= 16 -> ci-bits = 4
        }
    }

    ; subtract-green heuristic: enabled when |R-G| + |B-G| residuals are
    ; smaller than raw |R| + |B| (and not already inside color-index mode,
    ; where sg applies to the palette plane instead)
    sg-enabled = false
    ! ci-mode -> {
        sum-raw = 0
        sum-sg = 0
        i <- [0..npix): {
            ri = r0[i]: {
                ok -> it

                -> 0
            }
            bi = b0[i]: {
                ok -> it

                -> 0
            }
            gi = g0[i]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            drv-o = ri - 128
            drv i64 = drv-o: {
                ok -> it

                -> 0
            }
            dr = drv
            dr < 0 -> {
                drn-o = -dr
                drn i64 = drn-o: {
                    ok -> it

                    -> 0
                }
                dr = drn
            }

            #{overflow=wrap}
            dbv-o = bi - 128
            dbv i64 = dbv-o: {
                ok -> it

                -> 0
            }
            db = dbv
            db < 0 -> {
                dbn-o = -db
                dbn i64 = dbn-o: {
                    ok -> it

                    -> 0
                }
                db = dbn
            }

            #{overflow=wrap}
            sr1-o = sum-raw + dr
            sr1 i64 = sr1-o: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            sr2-o = sr1 + db
            sr2 i64 = sr2-o: {
                ok -> it

                -> 0
            }
            sum-raw = sr2

            #{overflow=wrap}
            dgv-o = ri - gi
            dgv i64 = dgv-o: {
                ok -> it

                -> 0
            }
            dg = dgv
            dg < 0 -> {
                dgn-o = -dg
                dgn i64 = dgn-o: {
                    ok -> it

                    -> 0
                }
                dg = dgn
            }

            #{overflow=wrap}
            db2v-o = bi - gi
            db2v i64 = db2v-o: {
                ok -> it

                -> 0
            }
            db2 = db2v
            db2 < 0 -> {
                db2n-o = -db2
                db2n i64 = db2n-o: {
                    ok -> it

                    -> 0
                }
                db2 = db2n
            }

            #{overflow=wrap}
            ss1-o = sum-sg + dg
            ss1 i64 = ss1-o: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            ss2-o = ss1 + db2
            ss2 i64 = ss2-o: {
                ok -> it

                -> 0
            }
            sum-sg = ss2
        }
        sum-sg < sum-raw -> sg-enabled = true
    }

    ; color-index mode stores the full (true-color) palette and a pure index
    ; image (R=B=A=0), so subtract-green is not combined with it
    ci-mode -> sg-enabled = false

    ; honor the color-index / subtract-green heuristics: the transform chain
    ; below actually emits whichever transform(s) were selected (instead of
    ; forcing a plain ARGB image). CI and SG are mutually exclusive here.

    ; build the encoded component planes
    ; color-index mode: green = packed palette indices (one word per
    ; (8 >> ci-bits) pixels, spread across the 4 channels); red/blue are
    ; the subtract-green residuals of the palette entries, alpha unused
    main-w = w

    #{overflow=wrap}
    ppw = 8 / ci-bits

    #{overflow=wrap}
    enc-n = npix / ppw
    enc-g []i64 = with-len(npix)
    enc-r []i64 = with-len(npix)
    enc-b []i64 = with-len(npix)
    enc-a []i64 = with-len(npix)
    {
        ci-mode -> {

            #{overflow=wrap}
            num = w + ppw - 1

            #{overflow=wrap}
            main-w = num / ppw

            #{overflow=wrap}
            enc-n = main-w * h
            i <- [0..enc-n): {
                word = 0
                k <- [0..ppw): {

                    #{overflow=wrap}
                    sx = i % main-w * ppw + k

                    #{overflow=wrap}
                    sy = i / main-w
                    p = 0
                    {
                        sx < w -> {

                            #{overflow=wrap}
                            sw-o = sy * w
                            sw i64 = sw-o: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            sidx-o = sw + sx
                            sidx i64 = sidx-o: {
                                ok -> it

                                -> 0
                            }
                            p = idx[sidx]: {
                                ok -> it

                                -> 0
                            }
                        }
                    }

                    #{overflow=wrap}
                    bit-pos = k * ci-bits
                    shift = bit-pos
                    word = word | ((p & ((1 << ci-bits) - 1)) << shift)
                }

                ; all ci-ppw indices are packed into the green byte (the decoder
                ; reads indices from the green channel only); r/b/a are unused in
                ; color-index mode (the palette holds the real colors)
                enc-g[i]: {
                    ok -> it = word & 255

                    -> _
                }
                enc-r[i]: {
                    ok -> it = 0

                    -> _
                }
                enc-b[i]: {
                    ok -> it = 0

                    -> _
                }
                enc-a[i]: {
                    ok -> it = 0

                    -> _
                }
            }
        }

        -> {
            {
                sg-enabled -> {
                    i <- [0..npix): {
                        d9v54 i64 = r0[i]: {
                            ok -> it

                            -> 0
                        }

                        d9v55 i64 = g0[i]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        rr-o = d9v54 - d9v55
                        rr i64 = rr-o: {
                            ok -> it

                            -> 0
                        }
                        rr8 = rr & 255
                        enc-r[i]: {
                            ok -> it = rr8

                            -> _
                        }

                        d9v56 i64 = b0[i]: {
                            ok -> it

                            -> 0
                        }

                        d9v57 i64 = g0[i]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        bb-o = d9v56 - d9v57
                        bb i64 = bb-o: {
                            ok -> it

                            -> 0
                        }
                        bb8 = bb & 255
                        enc-b[i]: {
                            ok -> it = bb8

                            -> _
                        }
                    }
                }

                -> {
                    i <- [0..npix): {
                        d9v58 i64 = r0[i]: {
                            ok -> it

                            -> 0
                        }

                        enc-r[i]: {
                            ok -> it = d9v58

                            -> _
                        }

                        d9v59 i64 = b0[i]: {
                            ok -> it

                            -> 0
                        }

                        enc-b[i]: {
                            ok -> it = d9v59

                            -> _
                        }
                    }
                }
            }
            i <- [0..npix): {
                d9v60 i64 = g0[i]: {
                    ok -> it

                    -> 0
                }

                enc-g[i]: {
                    ok -> it = d9v60

                    -> _
                }

                d9v61 i64 = a0[i]: {
                    ok -> it

                    -> 0
                }

                enc-a[i]: {
                    ok -> it = d9v61

                    -> _
                }
            }
            enc-n = npix
        }
    }

    ; ── build 5 single-group Huffman trees (VP8L): green(280) red(256)
    ;    blue(256) alpha(256) dist(40). The ARGB image always codes alpha
    ;    (opaque input carries alpha=255). No color cache, meta-Huffman or
    ;    LZ77; the optional color-index / subtract-green transforms are written
    ;    in the transform chain above. ──
    ts-g = 280
    ts-c = 256
    ts-d = 40
    freq-g []i64 = with-len(ts-g)
    freq-r []i64 = with-len(ts-c)
    freq-b []i64 = with-len(ts-c)
    freq-a []i64 = with-len(ts-c)
    freq-d []i64 = with-len(ts-d)
    i <- [0..enc-n): {
        egi = enc-g[i]: {
            ok -> it

            -> 0
        }
        d9v62 i64 = freq-g[egi]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv62-o = d9v62 + 1
        nv62 i64 = nv62-o: {
            ok -> it

            -> 0
        }
        freq-g[egi]: {
            ok -> it = nv62

            -> _
        }

        eri = enc-r[i]: {
            ok -> it

            -> 0
        }
        d9v63 i64 = freq-r[eri]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv63-o = d9v63 + 1
        nv63 i64 = nv63-o: {
            ok -> it

            -> 0
        }
        freq-r[eri]: {
            ok -> it = nv63

            -> _
        }

        ebi = enc-b[i]: {
            ok -> it

            -> 0
        }
        d9v64 i64 = freq-b[ebi]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv64-o = d9v64 + 1
        nv64 i64 = nv64-o: {
            ok -> it

            -> 0
        }
        freq-b[ebi]: {
            ok -> it = nv64

            -> _
        }

        eai = enc-a[i]: {
            ok -> it

            -> 0
        }
        d9v65 i64 = freq-a[eai]: {
            ok -> it

            -> 0
        }

        #{overflow=wrap}
        nv65-o = d9v65 + 1
        nv65 i64 = nv65-o: {
            ok -> it

            -> 0
        }
        freq-a[eai]: {
            ok -> it = nv65

            -> _
        }
    }

    ; code lengths per tree (limit 15 bits per VP8L spec)
    len-g []i64 = with-len(ts-g)
    len-r []i64 = with-len(ts-c)
    len-b []i64 = with-len(ts-c)
    len-a []i64 = with-len(ts-c)
    len-d []i64 = with-len(ts-d)
    webp-enc-huff-lens(freq-g, 15, len-g)
    webp-enc-huff-lens(freq-r, 15, len-r)
    webp-enc-huff-lens(freq-b, 15, len-b)
    webp-enc-huff-lens(freq-a, 15, len-a)
    webp-enc-huff-lens(freq-d, 15, len-d)
    codes-g []i64 = with-len(ts-g)
    codes-r []i64 = with-len(ts-c)
    codes-b []i64 = with-len(ts-c)
    codes-a []i64 = with-len(ts-c)
    webp-enc-canonical(len-g, codes-g)
    webp-enc-canonical(len-r, codes-r)
    webp-enc-canonical(len-b, codes-b)
    webp-enc-canonical(len-a, codes-a)

    ; distinct symbol counts (<=1 => decoder reads 0 bits for that channel)
    nz-g = 0
    i <- [0..ts-g): {
        lgi = len-g[i]: {
            ok -> it

            -> 0
        }
        lgi > 0 -> {

            #{overflow=wrap}
            nzg-o = nz-g + 1
            nzg i64 = nzg-o: {
                ok -> it

                -> 0
            }
            nz-g = nzg
        }
    }
    nz-r = 0
    i <- [0..ts-c): {
        lri = len-r[i]: {
            ok -> it

            -> 0
        }
        lri > 0 -> {

            #{overflow=wrap}
            nzr-o = nz-r + 1
            nzr i64 = nzr-o: {
                ok -> it

                -> 0
            }
            nz-r = nzr
        }
    }
    nz-b = 0
    i <- [0..ts-c): {
        lbi = len-b[i]: {
            ok -> it

            -> 0
        }
        lbi > 0 -> {

            #{overflow=wrap}
            nzb-o = nz-b + 1
            nzb i64 = nzb-o: {
                ok -> it

                -> 0
            }
            nz-b = nzb
        }
    }
    nz-a = 0
    i <- [0..ts-c): {
        lai = len-a[i]: {
            ok -> it

            -> 0
        }
        lai > 0 -> {

            #{overflow=wrap}
            nza-o = nz-a + 1
            nza i64 = nza-o: {
                ok -> it

                -> 0
            }
            nz-a = nza
        }
    }

    ; assemble the VP8L bitstream (bit accumulator threaded as scalars)
    vp8l-out []byte = with-cap(0)
    bit-buf = 0
    bit-cnt = 0
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 47, 8)

    #{overflow=wrap}
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, w - 1, 14)

    #{overflow=wrap}
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, h - 1, 14)
    ab = 0
    {
        has-alpha -> ab = 1
    }
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, ab, 1)
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 0, 3)

    ; ── transform chain ──
    ; Per the VP8L spec the color-index transform (ttype 3) is stored FIRST
    ; because it is applied LAST during decoding (the decoder expands the index
    ; image first, then undoes subtract-green in reverse order). subtract-green
    ; (ttype 2) follows. The chain is closed by a final used=0 bit.
    ci-mode -> {

        ; palette sub-image (pal-count x 1) stored as deltas: entry 0 absolute,
        ; entry i = (previous + delta) mod 256 (libwebp ExpandColorMap).
        pal-sub-g []i64 = with-len(pal-count)
        pal-sub-r []i64 = with-len(pal-count)
        pal-sub-b []i64 = with-len(pal-count)
        pal-sub-a []i64 = with-len(pal-count)

        d9v66 i64 = pal-g[0]: {
            ok -> it

            -> 0
        }
        pal-sub-g[0]: {
            ok -> it = d9v66

            -> _
        }

        d9v67 i64 = pal-r[0]: {
            ok -> it

            -> 0
        }
        pal-sub-r[0]: {
            ok -> it = d9v67

            -> _
        }

        d9v68 i64 = pal-b[0]: {
            ok -> it

            -> 0
        }
        pal-sub-b[0]: {
            ok -> it = d9v68

            -> _
        }

        d9v69 i64 = pal-a[0]: {
            ok -> it

            -> 0
        }
        pal-sub-a[0]: {
            ok -> it = d9v69

            -> _
        }
        j <- [1..pal-count): {
            d9v70 i64 = pal-g[j]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            jm1-o = j - 1
            jm1 i64 = jm1-o: {
                ok -> it

                -> 0
            }
            d9v71 i64 = pal-g[jm1]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            dg-o = d9v70 - d9v71
            dg i64 = dg-o: {
                ok -> it

                -> 0
            }
            dg8 = dg & 255
            pal-sub-g[j]: {
                ok -> it = dg8

                -> _
            }

            d9v72 i64 = pal-r[j]: {
                ok -> it

                -> 0
            }

            d9v73 i64 = pal-r[jm1]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            dr2-o = d9v72 - d9v73
            dr2 i64 = dr2-o: {
                ok -> it

                -> 0
            }
            dr8 = dr2 & 255
            pal-sub-r[j]: {
                ok -> it = dr8

                -> _
            }

            d9v74 i64 = pal-b[j]: {
                ok -> it

                -> 0
            }

            d9v75 i64 = pal-b[jm1]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            db2-o = d9v74 - d9v75
            db2 i64 = db2-o: {
                ok -> it

                -> 0
            }
            db8 = db2 & 255
            pal-sub-b[j]: {
                ok -> it = db8

                -> _
            }

            d9v76 i64 = pal-a[j]: {
                ok -> it

                -> 0
            }

            d9v77 i64 = pal-a[jm1]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            da2-o = d9v76 - d9v77
            da2 i64 = da2-o: {
                ok -> it

                -> 0
            }
            da8 = da2 & 255
            pal-sub-a[j]: {
                ok -> it = da8

                -> _
            }
        }

        ; used=1 + ttype=3 (color-index)
        bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 1, 1)
        bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 3, 2)

        ; psize-code = palette_size - 1
        bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, pal-count - 1, 8)

        ; palette VP8L sub-image
        bit-buf, bit-cnt = webp-enc-write-subimage(bit-buf, bit-cnt, vp8l-out, pal-count, pal-count, pal-sub-g, pal-sub-r, pal-sub-b, pal-sub-a, true)
    }
    sg-enabled -> {

        ; used=1 + ttype=2 (subtract-green), no extra data
        bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 1, 1)
        bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 2, 2)
    }

    ; end of transform chain
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 0, 1)

    ; color cache: not used
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 0, 1)

    ; meta-Huffman: not used (single group)
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 0, 1)

    ; the 5 code-length blocks
    bit-buf, bit-cnt = webp-enc-write-tree(bit-buf, bit-cnt, vp8l-out, len-g)
    bit-buf, bit-cnt = webp-enc-write-tree(bit-buf, bit-cnt, vp8l-out, len-r)
    bit-buf, bit-cnt = webp-enc-write-tree(bit-buf, bit-cnt, vp8l-out, len-b)
    bit-buf, bit-cnt = webp-enc-write-tree(bit-buf, bit-cnt, vp8l-out, len-a)
    bit-buf, bit-cnt = webp-enc-write-tree(bit-buf, bit-cnt, vp8l-out, len-d)

    ; entropy-coded pixels: green, red, blue, alpha (single group, no LZ77)
    i <- [0..enc-n): {
        {
            nz-g > 1 -> {
                gv = enc-g[i]: {
                    ok -> it

                    -> 0
                }

                ceg = codes-g[gv]: {
                    ok -> it

                    -> 0
                }
                leg = len-g[gv]: {
                    ok -> it

                    -> 0
                }
                bit-buf, bit-cnt = webp-enc-write-code(bit-buf, bit-cnt, vp8l-out, ceg, leg)
            }
        }
        {
            nz-r > 1 -> {
                rv = enc-r[i]: {
                    ok -> it

                    -> 0
                }

                cer = codes-r[rv]: {
                    ok -> it

                    -> 0
                }
                ler = len-r[rv]: {
                    ok -> it

                    -> 0
                }
                bit-buf, bit-cnt = webp-enc-write-code(bit-buf, bit-cnt, vp8l-out, cer, ler)
            }
        }
        {
            nz-b > 1 -> {
                bv = enc-b[i]: {
                    ok -> it

                    -> 0
                }

                ceb = codes-b[bv]: {
                    ok -> it

                    -> 0
                }
                leb = len-b[bv]: {
                    ok -> it

                    -> 0
                }
                bit-buf, bit-cnt = webp-enc-write-code(bit-buf, bit-cnt, vp8l-out, ceb, leb)
            }
        }
        {
            nz-a > 1 -> {
                av = enc-a[i]: {
                    ok -> it

                    -> 0
                }

                cea = codes-a[av]: {
                    ok -> it

                    -> 0
                }
                lea = len-a[av]: {
                    ok -> it

                    -> 0
                }
                bit-buf, bit-cnt = webp-enc-write-code(bit-buf, bit-cnt, vp8l-out, cea, lea)
            }
        }
    }

    ; flush remaining bits
    {
        bit-cnt > 0 -> {
            vp8l-out.push((bit-buf & ((1 << bit-cnt) - 1)) & 255)
        }
    }

    ; RIFF/WEBP container with a single VP8L chunk
    ; layout: RIFF(4) + size(4) + WEBP(4) + VP8L(4) + chunk-size(4) + payload + pad
    payload-len = vp8l-out.len()
    pad = payload-len & 1

    filesize = 0
    filesize-opt = 12 + 8 + payload-len + pad
    filesize-opt: {
        ok -> {
            filesize = it
        }

        -> {
            filesize = 0
        }
    }

    #{overflow=wrap}
    sz-opt = filesize - 8
    sz = sz-opt: {
        ok -> it

        -> 0
    }
    buf []byte = with-cap(filesize)
    buf.push(82); R
    buf.push(73); I
    buf.push(70); F
    buf.push(70); F
    buf.push(sz & 255)
    buf.push((sz >> 8) & 255)
    buf.push((sz >> 16) & 255)
    buf.push((sz >> 24) & 255)
    buf.push(87); W
    buf.push(69); E
    buf.push(66); B
    buf.push(80); P
    buf.push(86); V
    buf.push(80); P
    buf.push(56); 8
    buf.push(76); L
    buf.push(payload-len & 255)
    buf.push((payload-len >> 8) & 255)
    buf.push((payload-len >> 16) & 255)
    buf.push((payload-len >> 24) & 255)
    i <- [0..payload-len): {
        vb = vp8l-out[i]: {
            ok -> it

            -> 0
        }
        buf.push(vb)
    }
    {
        pad != 0 -> buf.push(0)
    }

    wfd = fs.open-write(path)
    {
        wfd < 0 -> {
            ok = false
            return
        }
    }
    fs.write(wfd, buf, buf.len())
    fs.close(wfd)
    ok = true
}
