; webp.no — WebP format reader/writer
; Supports:
;   - Load: VP8L lossless decoding (Huffman + LZ77 + color cache + transforms)
;   - Save: VP8L lossless encoding (canonical Huffman entropy coding,
;     color-index + subtract-green transforms) — interoperable with libwebp
;     (files written by save() decode identically with dwebp/webpinfo).
;
; NOTE: VP8 (lossy) decoding is NOT supported — load() returns nil for lossy WebP.

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/vp8.vp8-decode-frame

; ── VP8L Bit Reader ──

; webp-br-read: read n bits (1-24) from the bitstream
; returns val i64, new-pos i64, new-buf i64, new-cnt i64
webp-br-read = (data []byte, pos i64, buf i64, cnt i64, n i64) (val i64, new-pos i64, new-buf i64, new-cnt i64) {
    (cnt < n) {
        cnt < n -> {
            {
                pos < data.len() -> {
                    b = data[pos] & 255
                    buf = buf | (b << cnt)

                    #{overflow=wrap}
                    cnt = cnt + 8
                    #{overflow=wrap}
                    pos = pos + 1
                }

                -> {
                    #{overflow=wrap}
                    cnt = cnt + 8
                }
            }
        }
    }
    val = buf & ((1 << n) - 1)
    buf = buf >> n

    #{overflow=wrap}
    cnt = cnt - n
    new-pos = pos
    new-buf = buf
    new-cnt = cnt
}

; webp-br-read-bit: read a single bit
; returns val i64, new-pos i64, new-buf i64, new-cnt i64
webp-br-read-bit = (data []byte, pos i64, buf i64, cnt i64) (val i64, new-pos i64, new-buf i64, new-cnt i64) {
    {
        cnt == 0 -> {
            pos < data.len() -> {
                buf = data[pos] & 255
                cnt = 8

                #{overflow=wrap}
                pos = pos + 1
            }

            -> {
                buf = 0
                cnt = 1
            }
        }
    }
    val = buf & 1
    buf = buf >> 1

    #{overflow=wrap}
    cnt = cnt - 1
    new-pos = pos
    new-buf = buf
    new-cnt = cnt
}

; ── VP8L Huffman Decoding ──

; webp-build-huff-codes: build canonical Huffman codes from code lengths
; code-lens []byte: code length per symbol
; n-symbols i64: number of symbols
; out-codes []byte: output code values
; out-first []byte: first code per length 1..15
; out-count []byte: count per length 1..15
webp-build-huff-codes = (code-lens []byte, n-symbols i64, out-codes []byte, out-first []byte, out-count []byte) {
    i <- [0..n-symbols): {
        cl = code-lens[i]
        {
            cl > 0 -> {

                #{overflow=wrap}
                out-count[cl] = out-count[cl] + 1
            }
        }
    }
    fc = 0
    L <- [1..16): {
        out-first[L] = fc
        fc = (fc + out-count[L]) << 1
    }
    next-code []byte = with-len(16)
    L <- [1..16): {
        next-code[L] = out-first[L]
    }
    si <- [0..n-symbols): {
        cl = code-lens[si]
        {
            cl > 0 -> {
                out-codes[si] = next-code[cl]

                #{overflow=wrap}
                next-code[cl] = next-code[cl] + 1
            }
        }
    }
}

; webp-huff-decode: decode one Huffman symbol
; returns sym i64, new-pos i64, new-buf i64, new-cnt i64
webp-huff-decode = (code-lens []byte, n-symbols i64, codes []byte, first []byte, count []byte, data []byte, pos i64, buf i64, cnt i64) (sym i64, new-pos i64, new-buf i64, new-cnt i64) {
    code = 0
    found = false
    sym = 0
    L = 1
    (! found && L <= 15) {
        ! found && L <= 15 -> {
            bit, pos, buf, cnt = webp-br-read-bit(data, pos, buf, cnt)
            code = (code << 1) | bit
            #{overflow=wrap}
            {
                count[L] > 0 && code >= first[L] && code <= first[L] + count[L] - 1 -> {
                    #{overflow=wrap}
                    offset = code - first[L]
                    c = 0
                    si <- [0..n-symbols): {
                        {
                            ! found && code-lens[si] == L -> {
                                {
                                    c == offset -> {
                                        sym = si
                                        found = true
                                    }
                                }
                                #{overflow=wrap}
                                c = c + 1
                            }
                        }
                    }
                }
            }
            #{overflow=wrap}
            L = L + 1
        }
    }
    new-pos = pos
    new-buf = buf
    new-cnt = cnt
}

; ── VP8L Meta-Huffman ──

; webp-decode-meta-huff: decode meta-Huffman to build a code length table
; n-syms i64: number of symbols (256 + cc-size)
; returns code-lens []byte (n-syms entries), new-pos i64, new-buf i64, new-cnt i64
webp-decode-meta-huff = (data []byte, pos i64, buf i64, cnt i64, n-syms i64) (code-lens []byte, new-pos i64, new-buf i64, new-cnt i64) {
    code-lens []byte = with-len(n-syms)
    simple, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 1)

    {
        simple == 1 -> {
            n-syms, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 1)
            {
                n-syms == 0 -> {
                    sym1, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 8)
                    code-lens[sym1] = 1
                }

                -> {
                    sym1, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 8)
                    sym2, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 8)
                    code-lens[sym1] = 1
                    {
                        sym1 != sym2 -> {
                            code-lens[sym2] = 2
                        }
                    }
                }
            }
        }

        -> {

            ; Non-simple: 18 meta symbols with 3-bit code lengths
            meta-lens []byte = with-len(18)
            mi <- [0..18): {
                ml, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 3)
                meta-lens[mi] = ml
            }
            meta-codes []byte = with-len(18)
            meta-first []byte = with-len(16)
            meta-count []byte = with-len(16)
            webp-build-huff-codes(meta-lens, 18, meta-codes, meta-first, meta-count)

            sym-idx = 0
            (sym-idx < n-syms) {
                sym-idx < n-syms -> {
                    msym, pos, buf, cnt = webp-huff-decode(meta-lens, 18, meta-codes, meta-first, meta-count, data, pos, buf, cnt)
                    {
                        msym <= 15 -> {
                            code-lens[sym-idx] = msym

                            #{overflow=wrap}
                            sym-idx = sym-idx + 1
                        }

                        msym == 16 -> {
                            ext, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 2)
                            #{overflow=wrap}
                            repeat = 3 + ext
                            #{overflow=wrap}
                            {
                                sym-idx > 0 && sym-idx + repeat <= n-syms -> {
                                    #{overflow=wrap}
                                    prev = code-lens[sym-idx - 1]
                                    r <- [0..repeat): {
                                        #{overflow=wrap}
                                        code-lens[sym-idx + r] = prev
                                    }
                                    #{overflow=wrap}
                                    sym-idx = sym-idx + repeat
                                }

                                -> {
                                    sym-idx = n-syms
                                }
                            }
                        }

                        msym == 17 -> {
                            ext, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 3)
                            #{overflow=wrap}
                            repeat = 3 + ext
                            #{overflow=wrap}
                            {
                                sym-idx + repeat <= n-syms -> {
                                    r <- [0..repeat): {
                                        #{overflow=wrap}
                                        code-lens[sym-idx + r] = 0
                                    }
                                    #{overflow=wrap}
                                    sym-idx = sym-idx + repeat
                                }

                                -> {
                                    sym-idx = n-syms
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    new-pos = pos
    new-buf = buf
    new-cnt = cnt
}

; ── VP8L Sub-Image Decoder ──

; webp-decode-argb-image: decode a VP8L ARGB sub-image (for transform images)
; This is used to decode predictor and color transform sub-images.
; Each sub-image has its own color cache config and 5 Huffman tables.
; data str: file data
; pos i64: current bit position
; buf i64: bit buffer
; cnt i64: bit count
; img-w i64: sub-image width
; img-h i64: sub-image height
; returns out []byte: ARGB pixel data (4 bytes per pixel), new-pos, new-buf, new-cnt
webp-decode-argb-image = (data []byte, pos i64, buf i64, cnt i64, img-w i64, img-h i64) (out []byte, new-pos i64, new-buf i64, new-cnt i64) {

    #{overflow=wrap}
    sub-n = img-w * img-h

    #{overflow=wrap}
    sub-argb []byte = with-len(sub-n * 4)

    ; Read color cache config for sub-image
    sub-cc-used, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 1)
    sub-cc-size = 0
    {
        sub-cc-used == 1 -> {
            sub-cc-bits, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 4)
            sub-cc-size = 1 << sub-cc-bits
        }
    }

    ; Decode 5 Huffman tables for sub-image
    #{overflow=wrap}
    sub-n-syms = 256 + sub-cc-size

    sub-lens-0 []byte = with-len(sub-n-syms)
    sub-lens-1 []byte = with-len(sub-n-syms)
    sub-lens-2 []byte = with-len(sub-n-syms)
    sub-lens-3 []byte = with-len(sub-n-syms)
    sub-lens-4 []byte = with-len(sub-n-syms)

    sub-lens-0, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, sub-n-syms)
    sub-lens-1, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, sub-n-syms)
    sub-lens-2, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, sub-n-syms)
    sub-lens-3, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, sub-n-syms)
    sub-lens-4, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, sub-n-syms)

    ; Build canonical codes for all 5 tables
    sub-codes-0 []byte = with-len(sub-n-syms)
    sub-first-0 []byte = with-len(16)
    sub-count-0 []byte = with-len(16)
    webp-build-huff-codes(sub-lens-0, sub-n-syms, sub-codes-0, sub-first-0, sub-count-0)

    sub-codes-1 []byte = with-len(sub-n-syms)
    sub-first-1 []byte = with-len(16)
    sub-count-1 []byte = with-len(16)
    webp-build-huff-codes(sub-lens-1, sub-n-syms, sub-codes-1, sub-first-1, sub-count-1)

    sub-codes-2 []byte = with-len(sub-n-syms)
    sub-first-2 []byte = with-len(16)
    sub-count-2 []byte = with-len(16)
    webp-build-huff-codes(sub-lens-2, sub-n-syms, sub-codes-2, sub-first-2, sub-count-2)

    sub-codes-3 []byte = with-len(sub-n-syms)
    sub-first-3 []byte = with-len(16)
    sub-count-3 []byte = with-len(16)
    webp-build-huff-codes(sub-lens-3, sub-n-syms, sub-codes-3, sub-first-3, sub-count-3)

    sub-codes-4 []byte = with-len(sub-n-syms)
    sub-first-4 []byte = with-len(16)
    sub-count-4 []byte = with-len(16)
    webp-build-huff-codes(sub-lens-4, sub-n-syms, sub-codes-4, sub-first-4, sub-count-4)

    ; Color cache for sub-image
    #{overflow=wrap}
    sub-cc-cache []byte = with-len(sub-cc-size * 4)

    ; Decode all pixels
    sub-px = 0
    (sub-px < sub-n) {
        sub-px < sub-n -> {

            ; Decode green channel (table 0)
            sgreen, pos, buf, cnt = webp-huff-decode(sub-lens-0, sub-n-syms, sub-codes-0, sub-first-0, sub-count-0, data, pos, buf, cnt)

            {
                sgreen < 256 -> {

                    ; Normal pixel: decode R, B, A using table selected by (green >> 3) % 5
                    s-tbl = (sgreen >> 3) % 5
                    s-red = 0
                    s-blue = 0
                    s-alpha = 255

                    {
                        s-tbl == 0 -> {
                            s-red, pos, buf, cnt = webp-huff-decode(sub-lens-0, sub-n-syms, sub-codes-0, sub-first-0, sub-count-0, data, pos, buf, cnt)
                            s-blue, pos, buf, cnt = webp-huff-decode(sub-lens-0, sub-n-syms, sub-codes-0, sub-first-0, sub-count-0, data, pos, buf, cnt)
                            s-alpha, pos, buf, cnt = webp-huff-decode(sub-lens-0, sub-n-syms, sub-codes-0, sub-first-0, sub-count-0, data, pos, buf, cnt)
                        }

                        s-tbl == 1 -> {
                            s-red, pos, buf, cnt = webp-huff-decode(sub-lens-1, sub-n-syms, sub-codes-1, sub-first-1, sub-count-1, data, pos, buf, cnt)
                            s-blue, pos, buf, cnt = webp-huff-decode(sub-lens-1, sub-n-syms, sub-codes-1, sub-first-1, sub-count-1, data, pos, buf, cnt)
                            s-alpha, pos, buf, cnt = webp-huff-decode(sub-lens-1, sub-n-syms, sub-codes-1, sub-first-1, sub-count-1, data, pos, buf, cnt)
                        }

                        s-tbl == 2 -> {
                            s-red, pos, buf, cnt = webp-huff-decode(sub-lens-2, sub-n-syms, sub-codes-2, sub-first-2, sub-count-2, data, pos, buf, cnt)
                            s-blue, pos, buf, cnt = webp-huff-decode(sub-lens-2, sub-n-syms, sub-codes-2, sub-first-2, sub-count-2, data, pos, buf, cnt)
                            s-alpha, pos, buf, cnt = webp-huff-decode(sub-lens-2, sub-n-syms, sub-codes-2, sub-first-2, sub-count-2, data, pos, buf, cnt)
                        }

                        s-tbl == 3 -> {
                            s-red, pos, buf, cnt = webp-huff-decode(sub-lens-3, sub-n-syms, sub-codes-3, sub-first-3, sub-count-3, data, pos, buf, cnt)
                            s-blue, pos, buf, cnt = webp-huff-decode(sub-lens-3, sub-n-syms, sub-codes-3, sub-first-3, sub-count-3, data, pos, buf, cnt)
                            s-alpha, pos, buf, cnt = webp-huff-decode(sub-lens-3, sub-n-syms, sub-codes-3, sub-first-3, sub-count-3, data, pos, buf, cnt)
                        }

                        s-tbl == 4 -> {
                            s-red, pos, buf, cnt = webp-huff-decode(sub-lens-4, sub-n-syms, sub-codes-4, sub-first-4, sub-count-4, data, pos, buf, cnt)
                            s-blue, pos, buf, cnt = webp-huff-decode(sub-lens-4, sub-n-syms, sub-codes-4, sub-first-4, sub-count-4, data, pos, buf, cnt)
                            s-alpha, pos, buf, cnt = webp-huff-decode(sub-lens-4, sub-n-syms, sub-codes-4, sub-first-4, sub-count-4, data, pos, buf, cnt)
                        }
                    }

                    #{overflow=wrap}
                    sub-argb[sub-px * 4] = s-alpha
                    #{overflow=wrap}
                    sub-argb[sub-px * 4 + 1] = s-red
                    #{overflow=wrap}
                    sub-argb[sub-px * 4 + 2] = sgreen
                    #{overflow=wrap}
                    sub-argb[sub-px * 4 + 3] = s-blue
                }

                -> {

                    ; Color cache or LZ77 reference
                    #{overflow=wrap}
                    s-cc-idx = sgreen - 256
                    {
                        s-cc-idx < sub-cc-size -> {
                            #{overflow=wrap}
                            sub-argb[sub-px * 4] = sub-cc-cache[s-cc-idx * 4]
                            #{overflow=wrap}
                            sub-argb[sub-px * 4 + 1] = sub-cc-cache[s-cc-idx * 4 + 1]
                            #{overflow=wrap}
                            sub-argb[sub-px * 4 + 2] = sub-cc-cache[s-cc-idx * 4 + 2]
                            #{overflow=wrap}
                            sub-argb[sub-px * 4 + 3] = sub-cc-cache[s-cc-idx * 4 + 3]
                        }

                        -> {

                            ; LZ77 back-reference
                            ; length prefix code = green symbol - 256 - cc-size
                            #{overflow=wrap}
                            s-len-prefix = sgreen - 256 - sub-cc-size
                            {
                                s-len-prefix < 4 -> {
                                    ; no extra bits: length = prefix + 1
                                    #{overflow=wrap}
                                    s-len = s-len-prefix + 1
                                }

                                -> {
                                    ; extra = (prefix - 2) >> 1; offset = (2 + (prefix & 1)) << extra
                                    s-len-extra = (s-len-prefix - 2) >> 1
                                    s-len-extra-val, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, s-len-extra)
                                    s-len-odd = s-len-prefix & 1
                                    s-len-offset = (2 + s-len-odd) << s-len-extra
                                    #{overflow=wrap}
                                    s-len = s-len-offset + 1 + s-len-extra-val
                                }
                            }
                            s-dist-code, pos, buf, cnt = webp-huff-decode(sub-lens-4, sub-n-syms, sub-codes-4, sub-first-4, sub-count-4, data, pos, buf, cnt)
                            {
                                s-dist-code <= 3 -> {
                                    #{overflow=wrap}
                                    s-dist = s-dist-code + 1
                                }

                                -> {
                                    s-dist-extra = (s-dist-code - 2) >> 1
                                    s-extra-val, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, s-dist-extra)
                                    s-odd = s-dist-code & 1
                                    s-dist-offset = (2 + s-odd) << s-dist-extra
                                    #{overflow=wrap}
                                    s-dist = s-dist-offset + 1 + s-extra-val
                                }
                            }
                            s-li <- [0..s-len): {
                                #{overflow=wrap}
                                {
                                    sub-px - s-dist + s-li >= 0 && sub-px + s-li < sub-n -> {
                                        #{overflow=wrap}
                                        s-src = sub-px - s-dist + s-li
                                        #{overflow=wrap}
                                        sub-argb[(sub-px + s-li) * 4] = sub-argb[s-src * 4]
                                        #{overflow=wrap}
                                        sub-argb[(sub-px + s-li) * 4 + 1] = sub-argb[s-src * 4 + 1]
                                        #{overflow=wrap}
                                        sub-argb[(sub-px + s-li) * 4 + 2] = sub-argb[s-src * 4 + 2]
                                        #{overflow=wrap}
                                        sub-argb[(sub-px + s-li) * 4 + 3] = sub-argb[s-src * 4 + 3]
                                    }
                                }
                            }
                            #{overflow=wrap}
                            sub-px = sub-px + s-len - 1
                        }
                    }
                }
            }

            ; Update color cache
            {
                sub-cc-size > 0 -> {
                    #{overflow=wrap}
                    sa0 = sub-argb[sub-px * 4]
                    #{overflow=wrap}
                    sr0 = sub-argb[sub-px * 4 + 1]
                    #{overflow=wrap}
                    sg0 = sub-argb[sub-px * 4 + 2]
                    #{overflow=wrap}
                    sb0 = sub-argb[sub-px * 4 + 3]
                    s-hash = (sa0 * 506832829 + sr0 * 6454117 + sg0 * 2654435761 + sb0 * 40503) & (sub-cc-size - 1)
                    #{overflow=wrap}
                    sub-cc-cache[s-hash * 4] = sa0
                    #{overflow=wrap}
                    sub-cc-cache[s-hash * 4 + 1] = sr0
                    #{overflow=wrap}
                    sub-cc-cache[s-hash * 4 + 2] = sg0
                    #{overflow=wrap}
                    sub-cc-cache[s-hash * 4 + 3] = sb0
                }
            }

            #{overflow=wrap}
            sub-px = sub-px + 1
        }
    }

    out = sub-argb
    new-pos = pos
    new-buf = buf
    new-cnt = cnt
}

; ── VP8L Main Decoder ──

; webp-decode-vp8l: decode VP8L lossless bitstream to raw pixel data
; data str: file data
; vp8l-pos i64: byte position of VP8L data (at 0x2F signature)
; w i64: image width
; h i64: image height
; has-alpha bool: whether alpha channel is present
; returns pixels []byte: decoded pixel data (RGB or RGBA)
webp-decode-vp8l = (data []byte, vp8l-pos i64, w i64, h i64, has-alpha bool) (pixels []byte) {

    #{overflow=wrap}
    n-pixels = w * h
    bands = 3
    has-alpha -> bands = 4

    ; ARGB buffer (4 bytes per pixel internally)
    #{overflow=wrap}
    argb []byte = with-len(n-pixels * 4)

    ; Bit reader: start after 0x2F signature byte
    #{overflow=wrap}
    pos = vp8l-pos + 1
    buf = 0
    cnt = 0

    ; Skip header: width(14), height(14), alpha(1), version(3) = 32 bits
    hdr-w, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 14)
    hdr-h, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 14)
    alpha-bit, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 1)
    vp8l-version, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 3)

    ; Read transforms (up to 4)
    ; Store transform parameters
    transform-types []byte = with-len(4)

    ; Predictor mode bits (ttype 0)
    transform-bits []byte = with-len(4)

    ; Color indexing palette (ttype 3)
    #{overflow=wrap}
    ci-palette []byte = with-len(256 * 4); ARGB per entry
    ci-palette-size = 0
    ci-bits = 8
    ci-sub-w = 0
    ci-img []byte = with-len(0)

    ; Transform image buffers — declared outside branch scope
    ; so inverse transforms can access them
    pred-img []byte = with-len(0)
    pred-w = 0
    pred-h = 0
    ct-img []byte = with-len(0)
    ct-w = 0
    ct-h = 0
    n-transforms = 0
    (n-transforms < 4) {
        n-transforms < 4 -> {
            used, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 1)
            {
                used == 0 -> {
                    n-transforms = 4
                }

                -> {
                    ttype, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 2)
                    transform-types[n-transforms] = ttype

                    #{overflow=wrap}
                    n-transforms = n-transforms + 1
                    {
                        ttype == 0 -> {

                            ; Predictor: 4 bits per pixel for the transform-bits field
                            pbits, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 4)
                            transform-bits[0] = pbits

                            ; The predictor image is an ARGB sub-image of size
                            ; ((w+3)/4) * ((h+3)/4), decoded with full 5-table Huffman.
                            #{overflow=wrap}
                            pred-w = (w + 3) / 4
                            #{overflow=wrap}
                            pred-h = (h + 3) / 4

                            ; Decode the predictor sub-image as ARGB
                            pred-argb, pos, buf, cnt = webp-decode-argb-image(data, pos, buf, cnt, pred-w, pred-h)

                            ; Extract the green channel (byte offset +2) as the predictor mode
                            #{overflow=wrap}
                            pred-n = pred-w * pred-h
                            pred-img = with-len(pred-n)
                            pi <- [0..pred-n): {
                                #{overflow=wrap}
                                pred-img[pi] = pred-argb[pi * 4 + 2]
                            }
                        }

                        ttype == 1 -> {

                            ; Color transform: 3 bits for transform-bits
                            cbits, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 3)
                            transform-bits[1] = cbits

                            ; Color transform image is an ARGB sub-image
                            ; of size ((w+3)/4) x ((h+3)/4), decoded with full 5-table Huffman.
                            ; Channel layout per spec:
                            ;   R channel (offset +1) = red_to_blue
                            ;   G channel (offset +2) = green_to_blue
                            ;   B channel (offset +3) = green_to_red
                            #{overflow=wrap}
                            ct-w = (w + 3) / 4
                            #{overflow=wrap}
                            ct-h = (h + 3) / 4
                            #{overflow=wrap}
                            ct-n = ct-w * ct-h

                            ; Decode the color transform sub-image as ARGB
                            ct-img, pos, buf, cnt = webp-decode-argb-image(data, pos, buf, cnt, ct-w, ct-h)
                        }

                        ttype == 2 -> {
                            ; Subtract green: no extra data
                        }

                        ttype == 3 -> {

                            ; Color indexing: 8 bits palette size code
                            psize-code, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 8)
                            #{overflow=wrap}
                            ci-palette-size = psize-code + 1

                            ; Read palette entries (ARGB, 4 bytes each)
                            pi3 <- [0..ci-palette-size * 4): {
                                pv, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 8)
                                ci-palette[pi3] = pv
                            }

                            ; Determine bits per pixel for color indexing
                            ; VP8L spec: the palette code determines how many
                            ; pixel indices are packed into each ARGB sub-image pixel.
                            ; palette_size <= 2  -> 1 bit/pixel
                            ; palette_size <= 4  -> 2 bits/pixel
                            ; palette_size <= 16 -> 4 bits/pixel
                            ; palette_size <= 256 -> 8 bits/pixel (no packing)
                            ci-bits = 8
                            {
                                ci-palette-size <= 2 -> ci-bits = 1
                            }
                            {
                                ci-palette-size > 2 && ci-palette-size <= 4 -> ci-bits = 2
                            }
                            {
                                ci-palette-size > 4 && ci-palette-size <= 16 -> ci-bits = 4
                            }

                            ; Decode the color index sub-image with modified width
                            ; Per spec: indices-per-word = 8 >> ci-bits,
                            ; so sub-image width = ceil(w / indices-per-word)
                            ci-ppw = 8 >> ci-bits
                            #{overflow=wrap}
                            ci-sub-w = (w + ci-ppw - 1) / ci-ppw
                            ci-sub-h = h
                            ci-img, pos, buf, cnt = webp-decode-argb-image(data, pos, buf, cnt, ci-sub-w, ci-sub-h)
                        }
                    }
                }
            }
        }
    }

    ; Read color cache size
    cc-used, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 1)
    cc-size = 0
    {
        cc-used == 1 -> {
            cc-bits, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, 4)
            cc-size = 1 << cc-bits
        }
    }

    ; Decode 5 Huffman tables
    #{overflow=wrap}
    n-huff-syms = 256 + cc-size

    huff-lens-0 []byte = with-len(n-huff-syms)
    huff-lens-1 []byte = with-len(n-huff-syms)
    huff-lens-2 []byte = with-len(n-huff-syms)
    huff-lens-3 []byte = with-len(n-huff-syms)
    huff-lens-4 []byte = with-len(n-huff-syms)

    huff-lens-0, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, n-huff-syms)
    huff-lens-1, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, n-huff-syms)
    huff-lens-2, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, n-huff-syms)
    huff-lens-3, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, n-huff-syms)
    huff-lens-4, pos, buf, cnt = webp-decode-meta-huff(data, pos, buf, cnt, n-huff-syms)

    ; Build canonical codes for all 5 tables
    codes-0 []byte = with-len(n-huff-syms)
    first-0 []byte = with-len(16)
    count-0 []byte = with-len(16)
    webp-build-huff-codes(huff-lens-0, n-huff-syms, codes-0, first-0, count-0)

    codes-1 []byte = with-len(n-huff-syms)
    first-1 []byte = with-len(16)
    count-1 []byte = with-len(16)
    webp-build-huff-codes(huff-lens-1, n-huff-syms, codes-1, first-1, count-1)

    codes-2 []byte = with-len(n-huff-syms)
    first-2 []byte = with-len(16)
    count-2 []byte = with-len(16)
    webp-build-huff-codes(huff-lens-2, n-huff-syms, codes-2, first-2, count-2)

    codes-3 []byte = with-len(n-huff-syms)
    first-3 []byte = with-len(16)
    count-3 []byte = with-len(16)
    webp-build-huff-codes(huff-lens-3, n-huff-syms, codes-3, first-3, count-3)

    codes-4 []byte = with-len(n-huff-syms)
    first-4 []byte = with-len(16)
    count-4 []byte = with-len(16)
    webp-build-huff-codes(huff-lens-4, n-huff-syms, codes-4, first-4, count-4)

    ; Color cache
    #{overflow=wrap}
    cc-cache []byte = with-len(cc-size * 4)
    ci <- [0..cc-size * 4): {
        cc-cache[ci] = 0
    }

    ; Decode all pixels
    px-idx = 0
    (px-idx < n-pixels) {
        px-idx < n-pixels -> {

            ; Decode green channel (table 0)
            green, pos, buf, cnt = webp-huff-decode(huff-lens-0, n-huff-syms, codes-0, first-0, count-0, data, pos, buf, cnt)

            {
                green < 256 -> {

                    ; Normal pixel: decode R, B, A using table selected by (green >> 3) % 5
                    tbl-id = (green >> 3) % 5
                    red = 0
                    blue = 0
                    alpha = 255

                    {
                        tbl-id == 0 -> {
                            red, pos, buf, cnt = webp-huff-decode(huff-lens-0, n-huff-syms, codes-0, first-0, count-0, data, pos, buf, cnt)
                            blue, pos, buf, cnt = webp-huff-decode(huff-lens-0, n-huff-syms, codes-0, first-0, count-0, data, pos, buf, cnt)
                            {
                                has-alpha -> {
                                    alpha, pos, buf, cnt = webp-huff-decode(huff-lens-0, n-huff-syms, codes-0, first-0, count-0, data, pos, buf, cnt)
                                }
                            }
                        }

                        tbl-id == 1 -> {
                            red, pos, buf, cnt = webp-huff-decode(huff-lens-1, n-huff-syms, codes-1, first-1, count-1, data, pos, buf, cnt)
                            blue, pos, buf, cnt = webp-huff-decode(huff-lens-1, n-huff-syms, codes-1, first-1, count-1, data, pos, buf, cnt)
                            {
                                has-alpha -> {
                                    alpha, pos, buf, cnt = webp-huff-decode(huff-lens-1, n-huff-syms, codes-1, first-1, count-1, data, pos, buf, cnt)
                                }
                            }
                        }

                        tbl-id == 2 -> {
                            red, pos, buf, cnt = webp-huff-decode(huff-lens-2, n-huff-syms, codes-2, first-2, count-2, data, pos, buf, cnt)
                            blue, pos, buf, cnt = webp-huff-decode(huff-lens-2, n-huff-syms, codes-2, first-2, count-2, data, pos, buf, cnt)
                            {
                                has-alpha -> {
                                    alpha, pos, buf, cnt = webp-huff-decode(huff-lens-2, n-huff-syms, codes-2, first-2, count-2, data, pos, buf, cnt)
                                }
                            }
                        }

                        tbl-id == 3 -> {
                            red, pos, buf, cnt = webp-huff-decode(huff-lens-3, n-huff-syms, codes-3, first-3, count-3, data, pos, buf, cnt)
                            blue, pos, buf, cnt = webp-huff-decode(huff-lens-3, n-huff-syms, codes-3, first-3, count-3, data, pos, buf, cnt)
                            {
                                has-alpha -> {
                                    alpha, pos, buf, cnt = webp-huff-decode(huff-lens-3, n-huff-syms, codes-3, first-3, count-3, data, pos, buf, cnt)
                                }
                            }
                        }

                        tbl-id == 4 -> {
                            red, pos, buf, cnt = webp-huff-decode(huff-lens-4, n-huff-syms, codes-4, first-4, count-4, data, pos, buf, cnt)
                            blue, pos, buf, cnt = webp-huff-decode(huff-lens-4, n-huff-syms, codes-4, first-4, count-4, data, pos, buf, cnt)
                            {
                                has-alpha -> {
                                    alpha, pos, buf, cnt = webp-huff-decode(huff-lens-4, n-huff-syms, codes-4, first-4, count-4, data, pos, buf, cnt)
                                }
                            }
                        }
                    }

                    ; Store ARGB
                    #{overflow=wrap}
                    argb[px-idx * 4] = alpha
                    #{overflow=wrap}
                    argb[px-idx * 4 + 1] = red
                    #{overflow=wrap}
                    argb[px-idx * 4 + 2] = green
                    #{overflow=wrap}
                    argb[px-idx * 4 + 3] = blue
                }

                -> {

                    ; Color cache or LZ77 reference
                    #{overflow=wrap}
                    cc-idx = green - 256
                    {
                        cc-idx < cc-size -> {

                            ; Color cache hit
                            #{overflow=wrap}
                            argb[px-idx * 4] = cc-cache[cc-idx * 4]
                            #{overflow=wrap}
                            argb[px-idx * 4 + 1] = cc-cache[cc-idx * 4 + 1]
                            #{overflow=wrap}
                            argb[px-idx * 4 + 2] = cc-cache[cc-idx * 4 + 2]
                            #{overflow=wrap}
                            argb[px-idx * 4 + 3] = cc-cache[cc-idx * 4 + 3]
                        }

                        -> {

                            ; LZ77 back-reference
                            ; Copy length: green - 256 - cc-size + 1
                            #{overflow=wrap}
                            lz77-len = green - 256 - cc-size
                            #{overflow=wrap}
                            lz77-len = lz77-len + 1

                            ; Read distance code from the distance Huffman table (table 4)
                            dist-code, pos, buf, cnt = webp-huff-decode(huff-lens-4, n-huff-syms, codes-4, first-4, count-4, data, pos, buf, cnt)

                            ; VP8L distance code table:
                            ; code 0: dist=1 (0 extra bits)
                            ; code 1: dist=2
                            ; code 2: dist=3
                            ; code 3: dist=4
                            ; For code >= 4: extra_bits = (code - 2) / 2, base computed via formula
                            ; Actually VP8L uses: codes 0-3 = direct, then each pair of codes adds 1 extra bit
                            ; code 4-5: 1 extra bit, base=5
                            ; code 6-7: 2 extra bits, base=7
                            ; code 8-9: 3 extra bits, base=11
                            ; General: for code >= 4:
                            ;   extra_bits = (code - 2) / 2  (integer division)
                            ;   base = 1 + (1 << extra_bits) + ((code - 2) % 2) * (1 << extra_bits)
                            ; Simplified: dist = base + extra_val
                            {
                                dist-code <= 3 -> {
                                    #{overflow=wrap}
                                    lz77-dist = dist-code + 1
                                }

                                -> {

                                    ; VP8L distance: extra_bits = (code - 2) >> 1
                                    ; dist = ((2 + (code & 1)) << extra_bits) + 1 + extra_val
                                    dist-extra = (dist-code - 2) >> 1
                                    extra-val, pos, buf, cnt = webp-br-read(data, pos, buf, cnt, dist-extra)
                                    odd-bit = dist-code & 1
                                    dist-offset = (2 + odd-bit) << dist-extra
                                    #{overflow=wrap}
                                    lz77-dist = dist-offset + 1 + extra-val
                                }
                            }

                            ; Copy lz77-len pixels from distance lz77-dist back
                            li <- [0..lz77-len): {
                                #{overflow=wrap}
                                {
                                    px-idx - lz77-dist + li >= 0 && px-idx + li < n-pixels -> {
                                        #{overflow=wrap}
                                        src-idx = px-idx - lz77-dist + li
                                        #{overflow=wrap}
                                        argb[(px-idx + li) * 4] = argb[src-idx * 4]
                                        #{overflow=wrap}
                                        argb[(px-idx + li) * 4 + 1] = argb[src-idx * 4 + 1]
                                        #{overflow=wrap}
                                        argb[(px-idx + li) * 4 + 2] = argb[src-idx * 4 + 2]
                                        #{overflow=wrap}
                                        argb[(px-idx + li) * 4 + 3] = argb[src-idx * 4 + 3]
                                    }
                                }
                            }
                            #{overflow=wrap}
                            px-idx = px-idx + lz77-len - 1; -1 because loop will add 1
                        }
                    }
                }
            }

            ; Update color cache
            {
                cc-size > 0 -> {
                    #{overflow=wrap}
                    a0 = argb[px-idx * 4]
                    #{overflow=wrap}
                    r0 = argb[px-idx * 4 + 1]
                    #{overflow=wrap}
                    g0 = argb[px-idx * 4 + 2]
                    #{overflow=wrap}
                    b0 = argb[px-idx * 4 + 3]
                    hash = (a0 * 506832829 + r0 * 6454117 + g0 * 2654435761 + b0 * 40503) & (cc-size - 1)
                    #{overflow=wrap}
                    cc-cache[hash * 4] = a0
                    #{overflow=wrap}
                    cc-cache[hash * 4 + 1] = r0
                    #{overflow=wrap}
                    cc-cache[hash * 4 + 2] = g0
                    #{overflow=wrap}
                    cc-cache[hash * 4 + 3] = b0
                }
            }

            #{overflow=wrap}
            px-idx = px-idx + 1
        }
    }

    ; Apply inverse transforms in reverse order
    ti <- [0..n-transforms): {

        #{overflow=wrap}
        ttype = transform-types[n-transforms - 1 - ti]
        {
            ttype == 0 -> {

                ; Inverse predictor: reconstruct pixels from residuals
                ; The predictor image (pred-img) defines the prediction mode
                ; per 4x4 block. pred-img has dimensions pred-w x pred-h
                ; where each entry covers a 4x4 block of pixels.
                pi <- [0..n-pixels): {

                    #{overflow=wrap}
                    py = pi / w

                    #{overflow=wrap}
                    px = pi - py * w

                    ; Get the predictor mode for this pixel's 4x4 block
                    #{overflow=wrap}
                    blk-x = px / 4

                    #{overflow=wrap}
                    blk-y = py / 4

                    #{overflow=wrap}
                    blk-idx = blk-y * pred-w + blk-x
                    mode = 0
                    {
                        blk-idx < pred-img.len() -> {
                            mode = pred-img[blk-idx]
                        }
                    }

                    ; VP8L predictor modes (per WebP Lossless Bitstream spec):
                    ;   0  = 0xFF000000 (black, alpha=255)
                    ;   1  = Left (L)
                    ;   2  = Top (T)
                    ;   3  = Top-Right (TR)
                    ;   4  = Top-Left (TL)
                    ;   5  = Average2(Average2(L, TR), T)
                    ;   6  = Average2(L, TL)
                    ;   7  = Average2(L, T)
                    ;   8  = Average2(TL, T)
                    ;   9  = Average2(T, TR)
                    ;   10 = Average2(Average2(L, TL), Average2(T, TR))
                    ;   11 = Select(L, T, TL): based on Manhattan distance,
                    ;        pL = |L-TL|+|L-TL|+|L-TL|+|L-TL| (4-channel sum)
                    ;        pT = |T-TL|+|T-TL|+|T-TL|+|T-TL| (4-channel sum)
                    ;        pL < pT -> L, else T
                    ;   12 = ClampAddSubtractFull(L, T, TL) = Clamp(L + T - TL)
                    ;        i.e. per channel: clamp(val=L+T-TL, lo=0, hi=255)
                    ;   13 = ClampAddSubtractHalf(Average2(L,T), TL)
                    ;        i.e. per channel: clamp(val=Avg2(L,T)+(Avg2(L,T)-TL)/2, lo=0, hi=255)
                    ;
                    ; For modes 1-4 we can apply the prediction inline (single neighbor).
                    ; For modes 0 and 5-13 we compute pred-a/r/g/b then add at the end.

                    ; ── Collect neighbor values (needed for all modes except 0) ──
                    left-a = 0
                    left-r = 0
                    left-g = 0
                    left-b = 0
                    {
                        px > 0 -> {

                            #{overflow=wrap}
                            left-a = argb[(pi - 1) * 4]
                            #{overflow=wrap}
                            left-r = argb[(pi - 1) * 4 + 1]
                            #{overflow=wrap}
                            left-g = argb[(pi - 1) * 4 + 2]
                            #{overflow=wrap}
                            left-b = argb[(pi - 1) * 4 + 3]
                        }
                    }
                    top-a = 0
                    top-r = 0
                    top-g = 0
                    top-b = 0
                    {
                        py > 0 -> {

                            #{overflow=wrap}
                            top-a = argb[(pi - w) * 4]
                            #{overflow=wrap}
                            top-r = argb[(pi - w) * 4 + 1]
                            #{overflow=wrap}
                            top-g = argb[(pi - w) * 4 + 2]
                            #{overflow=wrap}
                            top-b = argb[(pi - w) * 4 + 3]
                        }
                    }
                    tl-a = 0
                    tl-r = 0
                    tl-g = 0
                    tl-b = 0
                    {
                        px > 0 && py > 0 -> {

                            #{overflow=wrap}
                            tl-a = argb[(pi - w - 1) * 4]
                            #{overflow=wrap}
                            tl-r = argb[(pi - w - 1) * 4 + 1]
                            #{overflow=wrap}
                            tl-g = argb[(pi - w - 1) * 4 + 2]
                            #{overflow=wrap}
                            tl-b = argb[(pi - w - 1) * 4 + 3]
                        }
                    }
                    tr-a = top-a
                    tr-r = top-r
                    tr-g = top-g
                    tr-b = top-b
                    #{overflow=wrap}
                    {
                        py > 0 && px + 1 < w -> {
                            #{overflow=wrap}
                            tr-a = argb[(pi - w + 1) * 4]
                            #{overflow=wrap}
                            tr-r = argb[(pi - w + 1) * 4 + 1]
                            #{overflow=wrap}
                            tr-g = argb[(pi - w + 1) * 4 + 2]
                            #{overflow=wrap}
                            tr-b = argb[(pi - w + 1) * 4 + 3]
                        }
                    }

                    ; ── Compute prediction ──
                    pred-a = 0
                    pred-r = 0
                    pred-g = 0
                    pred-b = 0

                    {
                        mode == 0 -> {

                            ; 0xFF000000: solid black with full alpha
                            pred-a = 255
                            pred-r = 0
                            pred-g = 0
                            pred-b = 0
                        }
                    }
                    {
                        mode == 1 -> {

                            ; Left (L)
                            pred-a = left-a
                            pred-r = left-r
                            pred-g = left-g
                            pred-b = left-b
                        }
                    }
                    {
                        mode == 2 -> {

                            ; Top (T)
                            pred-a = top-a
                            pred-r = top-r
                            pred-g = top-g
                            pred-b = top-b
                        }
                    }
                    {
                        mode == 3 -> {

                            ; Top-Right (TR) — falls back to T when last in row
                            pred-a = tr-a
                            pred-r = tr-r
                            pred-g = tr-g
                            pred-b = tr-b
                        }
                    }
                    {
                        mode == 4 -> {

                            ; Top-Left (TL)
                            pred-a = tl-a
                            pred-r = tl-r
                            pred-g = tl-g
                            pred-b = tl-b
                        }
                    }
                    {
                        mode == 5 -> {

                            ; Average2(Average2(L, TR), T)
                            #{overflow=wrap}
                            avg-ltr-a = (left-a + tr-a) / 2
                            #{overflow=wrap}
                            avg-ltr-r = (left-r + tr-r) / 2
                            #{overflow=wrap}
                            avg-ltr-g = (left-g + tr-g) / 2
                            #{overflow=wrap}
                            avg-ltr-b = (left-b + tr-b) / 2
                            #{overflow=wrap}
                            pred-a = (avg-ltr-a + top-a) / 2
                            #{overflow=wrap}
                            pred-r = (avg-ltr-r + top-r) / 2
                            #{overflow=wrap}
                            pred-g = (avg-ltr-g + top-g) / 2
                            #{overflow=wrap}
                            pred-b = (avg-ltr-b + top-b) / 2
                        }
                    }
                    {
                        mode == 6 -> {

                            ; Average2(L, TL)
                            #{overflow=wrap}
                            pred-a = (left-a + tl-a) / 2
                            #{overflow=wrap}
                            pred-r = (left-r + tl-r) / 2
                            #{overflow=wrap}
                            pred-g = (left-g + tl-g) / 2
                            #{overflow=wrap}
                            pred-b = (left-b + tl-b) / 2
                        }
                    }
                    {
                        mode == 7 -> {

                            ; Average2(L, T)
                            #{overflow=wrap}
                            pred-a = (left-a + top-a) / 2
                            #{overflow=wrap}
                            pred-r = (left-r + top-r) / 2
                            #{overflow=wrap}
                            pred-g = (left-g + top-g) / 2
                            #{overflow=wrap}
                            pred-b = (left-b + top-b) / 2
                        }
                    }
                    {
                        mode == 8 -> {

                            ; Average2(TL, T)
                            #{overflow=wrap}
                            pred-a = (tl-a + top-a) / 2
                            #{overflow=wrap}
                            pred-r = (tl-r + top-r) / 2
                            #{overflow=wrap}
                            pred-g = (tl-g + top-g) / 2
                            #{overflow=wrap}
                            pred-b = (tl-b + top-b) / 2
                        }
                    }
                    {
                        mode == 9 -> {

                            ; Average2(T, TR)
                            #{overflow=wrap}
                            pred-a = (top-a + tr-a) / 2
                            #{overflow=wrap}
                            pred-r = (top-r + tr-r) / 2
                            #{overflow=wrap}
                            pred-g = (top-g + tr-g) / 2
                            #{overflow=wrap}
                            pred-b = (top-b + tr-b) / 2
                        }
                    }
                    {
                        mode == 10 -> {

                            ; Average2(Average2(L, TL), Average2(T, TR))
                            #{overflow=wrap}
                            avg-ltl-a = (left-a + tl-a) / 2
                            #{overflow=wrap}
                            avg-ltl-r = (left-r + tl-r) / 2
                            #{overflow=wrap}
                            avg-ltl-g = (left-g + tl-g) / 2
                            #{overflow=wrap}
                            avg-ltl-b = (left-b + tl-b) / 2
                            #{overflow=wrap}
                            avg-ttr-a = (top-a + tr-a) / 2
                            #{overflow=wrap}
                            avg-ttr-r = (top-r + tr-r) / 2
                            #{overflow=wrap}
                            avg-ttr-g = (top-g + tr-g) / 2
                            #{overflow=wrap}
                            avg-ttr-b = (top-b + tr-b) / 2
                            #{overflow=wrap}
                            pred-a = (avg-ltl-a + avg-ttr-a) / 2
                            #{overflow=wrap}
                            pred-r = (avg-ltl-r + avg-ttr-r) / 2
                            #{overflow=wrap}
                            pred-g = (avg-ltl-g + avg-ttr-g) / 2
                            #{overflow=wrap}
                            pred-b = (avg-ltl-b + avg-ttr-b) / 2
                        }
                    }
                    {
                        mode == 11 -> {

                            ; Select(L, T, TL): Manhattan distance on all 4 channels
                            ; pL = |L.A-TL.A| + |L.R-TL.R| + |L.G-TL.G| + |L.B-TL.B|
                            ; pT = |T.A-TL.A| + |T.R-TL.R| + |T.G-TL.G| + |T.B-TL.B|
                            ; pL < pT -> Left, else Top
                            #{overflow=wrap}
                            dla = left-a - tl-a
                            {
                                dla < 0 -> dla = -dla
                            }
                            #{overflow=wrap}
                            dlr = left-r - tl-r
                            {
                                dlr < 0 -> dlr = -dlr
                            }
                            #{overflow=wrap}
                            dlg = left-g - tl-g
                            {
                                dlg < 0 -> dlg = -dlg
                            }
                            #{overflow=wrap}
                            dlb = left-b - tl-b
                            {
                                dlb < 0 -> dlb = -dlb
                            }
                            #{overflow=wrap}
                            pL = dla + dlr + dlg + dlb
                            #{overflow=wrap}
                            dta = top-a - tl-a
                            {
                                dta < 0 -> dta = -dta
                            }
                            #{overflow=wrap}
                            dtr = top-r - tl-r
                            {
                                dtr < 0 -> dtr = -dtr
                            }
                            #{overflow=wrap}
                            dtg = top-g - tl-g
                            {
                                dtg < 0 -> dtg = -dtg
                            }
                            #{overflow=wrap}
                            dtb = top-b - tl-b
                            {
                                dtb < 0 -> dtb = -dtb
                            }
                            #{overflow=wrap}
                            pT = dta + dtr + dtg + dtb
                            {
                                pL < pT -> {
                                    pred-a = left-a
                                    pred-r = left-r
                                    pred-g = left-g
                                    pred-b = left-b
                                }

                                -> {
                                    pred-a = top-a
                                    pred-r = top-r
                                    pred-g = top-g
                                    pred-b = top-b
                                }
                            }
                        }
                    }
                    {
                        mode == 12 -> {

                            ; ClampAddSubtractFull(L, T, TL) = Clamp(L + T - TL)
                            ; Per channel: val = L + T - TL, clamp to [0, 255]
                            #{overflow=wrap}
                            val-a = left-a + top-a - tl-a
                            #{overflow=wrap}
                            val-r = left-r + top-r - tl-r
                            #{overflow=wrap}
                            val-g = left-g + top-g - tl-g
                            #{overflow=wrap}
                            val-b = left-b + top-b - tl-b
                            {
                                val-a < 0 -> val-a = 0

                                val-a > 255 -> val-a = 255
                            }
                            {
                                val-r < 0 -> val-r = 0

                                val-r > 255 -> val-r = 255
                            }
                            {
                                val-g < 0 -> val-g = 0

                                val-g > 255 -> val-g = 255
                            }
                            {
                                val-b < 0 -> val-b = 0

                                val-b > 255 -> val-b = 255
                            }
                            pred-a = val-a
                            pred-r = val-r
                            pred-g = val-g
                            pred-b = val-b
                        }
                    }
                    {
                        mode >= 13 -> {

                            ; Mode 13: ClampAddSubtractHalf(Average2(L,T), TL)
                            ; Per channel: avg = Average2(L,T), val = avg + (avg - TL) / 2
                            ; clamp to [0, 255]
                            #{overflow=wrap}
                            avg-lt-a = (left-a + top-a) / 2
                            #{overflow=wrap}
                            avg-lt-r = (left-r + top-r) / 2
                            #{overflow=wrap}
                            avg-lt-g = (left-g + top-g) / 2
                            #{overflow=wrap}
                            avg-lt-b = (left-b + top-b) / 2
                            #{overflow=wrap}
                            val-a = avg-lt-a + (avg-lt-a - tl-a) / 2
                            #{overflow=wrap}
                            val-r = avg-lt-r + (avg-lt-r - tl-r) / 2
                            #{overflow=wrap}
                            val-g = avg-lt-g + (avg-lt-g - tl-g) / 2
                            #{overflow=wrap}
                            val-b = avg-lt-b + (avg-lt-b - tl-b) / 2
                            {
                                val-a < 0 -> val-a = 0

                                val-a > 255 -> val-a = 255
                            }
                            {
                                val-r < 0 -> val-r = 0

                                val-r > 255 -> val-r = 255
                            }
                            {
                                val-g < 0 -> val-g = 0

                                val-g > 255 -> val-g = 255
                            }
                            {
                                val-b < 0 -> val-b = 0

                                val-b > 255 -> val-b = 255
                            }
                            pred-a = val-a
                            pred-r = val-r
                            pred-g = val-g
                            pred-b = val-b
                        }
                    }

                    ; Add residual to prediction
                    #{overflow=wrap}
                    argb[pi * 4] = (argb[pi * 4] + pred-a) & 255

                    #{overflow=wrap}
                    argb[pi * 4 + 1] = (argb[pi * 4 + 1] + pred-r) & 255

                    #{overflow=wrap}
                    argb[pi * 4 + 2] = (argb[pi * 4 + 2] + pred-g) & 255

                    #{overflow=wrap}
                    argb[pi * 4 + 3] = (argb[pi * 4 + 3] + pred-b) & 255
                }
            }
        }

        {
            ttype == 1 -> {

                ; Inverse color transform (per VP8L spec §4.2)
                ; The color transform image (ct-img) is an ARGB sub-image
                ; of size (ct-w x ct-h). For each 4x4 block of the main image,
                ; we look up the corresponding transform pixel.
                ; Channel layout per spec:
                ;   R channel (offset +1) = red_to_blue   (signed 8-bit)
                ;   G channel (offset +2) = green_to_blue (signed 8-bit)
                ;   B channel (offset +3) = green_to_red  (signed 8-bit)
                ;   A channel (offset +0) = 255 (unused)
                ; Inverse transform:
                ;   new_red  = red  + ((green_to_red   * green) >> 5)
                ;   new_blue = blue + ((green_to_blue  * green) >> 5)
                ;                     + ((red_to_blue  * (new_red & 0xff)) >> 5)
                ; Note: two independent >>5 shifts, not a combined one.
                pi <- [0..n-pixels): {

                    #{overflow=wrap}
                    py = pi / w

                    #{overflow=wrap}
                    px = pi - py * w

                    #{overflow=wrap}
                    blk-x = px / 4

                    #{overflow=wrap}
                    blk-y = py / 4

                    #{overflow=wrap}
                    blk-idx = blk-y * ct-w + blk-x

                    ; Read coefficients from ct-img ARGB
                    rtb = 0; red_to_blue   (from R channel, signed)
                    gtb = 0; green_to_blue (from G channel, signed)
                    gtr = 0; green_to_red  (from B channel, signed)
                    #{overflow=wrap}
                    {
                        blk-idx * 4 + 3 < ct-img.len() -> {
                            #{overflow=wrap}
                            raw-r = ct-img[blk-idx * 4 + 1]
                            #{overflow=wrap}
                            raw-g = ct-img[blk-idx * 4 + 2]
                            #{overflow=wrap}
                            raw-b = ct-img[blk-idx * 4 + 3]

                            ; Convert to signed: values 128..255 → -128..-1
                            rtb = raw-r
                            #{overflow=wrap}
                            rtb > 127 -> rtb = rtb - 256
                            gtb = raw-g
                            #{overflow=wrap}
                            gtb > 127 -> gtb = gtb - 256
                            gtr = raw-b
                            #{overflow=wrap}
                            gtr > 127 -> gtr = gtr - 256
                        }
                    }

                    #{overflow=wrap}
                    g = argb[pi * 4 + 2]

                    #{overflow=wrap}
                    r = argb[pi * 4 + 1]

                    #{overflow=wrap}
                    b = argb[pi * 4 + 3]

                    ; Apply inverse color transform (two independent >>5)
                    #{overflow=wrap}
                    new-red = r + ((gtr * g) >> 5)
                    new-red = new-red & 255
                    {
                        new-red < 0 -> {

                            #{overflow=wrap}
                            new-red = new-red + 256
                        }
                    }

                    #{overflow=wrap}
                    argb[pi * 4 + 1] = new-red

                    #{overflow=wrap}
                    new-blue = b + ((gtb * g) >> 5) + ((rtb * (new-red & 255)) >> 5)
                    new-blue = new-blue & 255
                    {
                        new-blue < 0 -> {

                            #{overflow=wrap}
                            new-blue = new-blue + 256
                        }
                    }

                    #{overflow=wrap}
                    argb[pi * 4 + 3] = new-blue
                }
            }
        }

        {
            ttype == 2 -> {

                ; Inverse subtract-green: add green to red and blue
                pi <- [0..n-pixels): {

                    #{overflow=wrap}
                    g = argb[pi * 4 + 2]

                    #{overflow=wrap}
                    argb[pi * 4 + 1] = (argb[pi * 4 + 1] + g) & 255

                    #{overflow=wrap}
                    argb[pi * 4 + 3] = (argb[pi * 4 + 3] + g) & 255
                }
            }
        }

        {
            ttype == 3 -> {

                ; Inverse color indexing: unpack palette indices from sub-image
                ; The sub-image (ci-img) has width ci-sub-w and height h.
                ; Each ARGB pixel in ci-img packs ci-bits palette indices.
                ; We need to unpack them back to the main image.
                ; For ci-bits == 8: each sub-image pixel green channel = 1 index
                ; For ci-bits < 8: each 32-bit ARGB value packs multiple indices
                ; VP8L packing: bits are stored from LSB to MSB in the 32-bit value
                ; The 32-bit value is treated as: alpha(8) | red(8) | green(8) | blue(8)
                ; Bits are packed sequentially across all 4 channels (32 bits total)
                pi <- [0..n-pixels): {

                    #{overflow=wrap}
                    py = pi / w

                    #{overflow=wrap}
                    px = pi - py * w

                    ; Which sub-image pixel contains this pixel's index?
                    #{overflow=wrap}
                    sub-px = px / ci-bits

                    #{overflow=wrap}
                    sub-idx = py * ci-sub-w + sub-px

                    ; Which bit position within the sub-image pixel?
                    #{overflow=wrap}
                    bit-pos = (px - sub-px * ci-bits) * ci-bits

                    ; Extract the index from the 32-bit ARGB value
                    ; The ARGB value is stored as [A, R, G, B] in ci-img
                    ; Reconstruct the 32-bit value: A<<24 | R<<16 | G<<8 | B
                    #{overflow=wrap}
                    {
                        sub-idx * 4 + 3 < ci-img.len() -> {
                            #{overflow=wrap}
                            a-val = ci-img[sub-idx * 4]
                            #{overflow=wrap}
                            r-val = ci-img[sub-idx * 4 + 1]
                            #{overflow=wrap}
                            g-val = ci-img[sub-idx * 4 + 2]
                            #{overflow=wrap}
                            b-val = ci-img[sub-idx * 4 + 3]
                            packed = (a-val << 24) | (r-val << 16) | (g-val << 8) | b-val
                            #{overflow=wrap}
                            mask = (1 << ci-bits) - 1
                            idx = (packed >> bit-pos) & mask
                            {
                                idx < ci-palette-size -> {
                                    #{overflow=wrap}
                                    argb[pi * 4] = ci-palette[idx * 4]
                                    #{overflow=wrap}
                                    argb[pi * 4 + 1] = ci-palette[idx * 4 + 1]
                                    #{overflow=wrap}
                                    argb[pi * 4 + 2] = ci-palette[idx * 4 + 2]
                                    #{overflow=wrap}
                                    argb[pi * 4 + 3] = ci-palette[idx * 4 + 3]
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    ; Convert ARGB to output format (RGB or RGBA)
    #{overflow=wrap}
    pixels = with-len(n-pixels * bands)
    {
        bands == 4 -> {
            i <- [0..n-pixels): {

                #{overflow=wrap}
                pixels[i * 4] = argb[i * 4 + 1]

                #{overflow=wrap}
                pixels[i * 4 + 1] = argb[i * 4 + 2]

                #{overflow=wrap}
                pixels[i * 4 + 2] = argb[i * 4 + 3]

                #{overflow=wrap}
                pixels[i * 4 + 3] = argb[i * 4]
            }
        }

        -> {
            i <- [0..n-pixels): {
                #{overflow=wrap}
                pixels[i * 3] = argb[i * 4 + 1]
                #{overflow=wrap}
                pixels[i * 3 + 1] = argb[i * 4 + 2]
                #{overflow=wrap}
                pixels[i * 3 + 2] = argb[i * 4 + 3]
            }
        }
    }
}

; webp-read-u32-le: read 32-bit little-endian
webp-read-u32-le = (data []byte, pos i64) (val i64) {
    val = (data[pos] & 255) | ((data[pos + 1] & 255) << 8) | ((data[pos + 2] & 255) << 16) | ((data[pos + 3] & 255) << 24)
}

; webp-parse-vp8: parse VP8 lossy bitstream header for dimensions
webp-parse-vp8 = (data []byte, pos i64, size i64) (w i64, h i64) {
    w = 0
    h = 0

    #{overflow=wrap}
    pos + 10 > data.len() -> return
    tag0 = data[pos] & 255
    key-frame = (tag0 & 1) != 0
    ! key-frame -> return
    {
        (data[pos + 3] & 255) == 157 && (data[pos + 4] & 255) == 1 && (data[pos + 5] & 255) == 42 -> {
            w = (data[pos + 6] & 255) | ((data[pos + 7] & 255) << 8)
            h = (data[pos + 8] & 255) | ((data[pos + 9] & 255) << 8)
            w = w & 16383
            h = h & 16383
        }
    }
}

; webp-parse-vp8l: parse VP8L lossless bitstream header for dimensions
webp-parse-vp8l = (data []byte, pos i64, size i64) (w i64, h i64) {
    w = 0
    h = 0

    #{overflow=wrap}
    pos + 5 > data.len() -> return
    (data[pos] & 255) == 47 -> {}

    -> return

    #{overflow=wrap}
    b1 = data[pos + 1] & 255

    #{overflow=wrap}
    b2 = data[pos + 2] & 255

    #{overflow=wrap}
    b3 = data[pos + 3] & 255

    #{overflow=wrap}
    b4 = data[pos + 4] & 255

    #{overflow=wrap}
    w = (b1 | ((b2 & 63) << 8)) + 1

    #{overflow=wrap}
    h = ((b2 >> 6) | (b3 << 2) | ((b4 & 15) << 10)) + 1
}

; webp-vp8l-alpha-flag: check if VP8L has alpha
webp-vp8l-alpha-flag = (data []byte, pos i64) (has-alpha bool) {
    has-alpha = false

    #{overflow=wrap}
    pos + 5 > data.len() -> return

    #{overflow=wrap}
    b4 = data[pos + 4] & 255
    has-alpha = (b4 & 16) != 0
}

; ── Encoder helpers (VP8L lossless, libwebp-interoperable) ──

; webp-enc-write-bits: append n bits (1..24) of val, LSB first
; buf i64 / cnt i64: bit accumulator state (threaded through)
; out []byte: output byte stream (mutated via push)
; returns new-buf i64, new-cnt i64
webp-enc-write-bits = (buf i64, cnt i64, out []byte, val i64, n i64) (new-buf i64, new-cnt i64) {
    #{overflow=wrap}
    buf = buf | ((val & ((1 << n) - 1)) << cnt)
    #{overflow=wrap}
    cnt = cnt + n
    (cnt >= 8) {
        cnt >= 8 -> {
            out.push(buf & 255)
            buf = buf >> 8
            #{overflow=wrap}
            cnt = cnt - 8
        }
    }
    new-buf = buf
    new-cnt = cnt
}

; webp-enc-canonical: assign canonical Huffman codes from code lengths
; (same construction the decoder expects: codes emitted MSB-first)
; lens []i64: code length per symbol (0 = unused)
; codes []i64: output canonical code per symbol (mutated)
webp-enc-canonical = (lens []i64, codes []i64) {
    n-sym = lens.len()
    count []i64 = with-len(16)
    si <- [0..n-sym): {
        #{overflow=wrap}
        count[lens[si]] = count[lens[si]] + 1
    }
    next-code []i64 = with-len(16)
    code = 0
    k <- [1..16): {
        next-code[k] = code
        #{overflow=wrap}
        code = (code + count[k]) << 1
    }
    si <- [0..n-sym): {
        cl = lens[si]
        cl > 0 -> {
            codes[si] = next-code[cl]
            #{overflow=wrap}
            next-code[cl] = next-code[cl] + 1
        }
    }
}

; webp-enc-huff-lens: build code lengths for a frequency histogram,
; limited to max-len bits (package-merge / Moeller-Reed method).
; freq []i64: symbol frequencies (sum must be > 0)
; max-len i64: hard limit on code length (VP8L allows 15)
; lens []i64: output code lengths (mutated, same length as freq)
webp-enc-huff-lens = (freq []i64, max-len i64, lens []i64) {
    n-sym = freq.len()
    si <- [0..n-sym): {
        lens[si] = 0
    }

    ; nonzero leaves sorted by weight (insertion sort; alphabet <= 4096)
    syms []i64 = with-cap(0)
    wts []i64 = with-cap(0)
    si <- [0..n-sym): {
        freq[si] > 0 -> {
            j = syms.len()
            syms.push(0)
            wts.push(0)
            w = freq[si]
            shifting = true
            (shifting && j > 0) {
                shifting && j > 0 -> {
                    wts[j - 1] > w -> {
                        syms[j] = syms[j - 1]
                        wts[j] = wts[j - 1]
                        #{overflow=wrap}
                        j = j - 1
                    }
                    -> {
                        shifting = false
                    }
                }
            }
            syms[j] = si
            wts[j] = w
        }
    }
    n-leaves = syms.len()
    n-leaves == 0 -> return
    n-leaves == 1 -> {
        lens[syms[0]] = 1
        return
    }

    ; package-merge: select 2 * n-leaves - 2 coins at the last level
    #{overflow=wrap}
    need = n-leaves * 2 - 2

    ; level-1 list: each leaf coin appears twice, sorted by weight
    cur-sym []i64 = with-cap(n-leaves * 2)
    cur-wt []i64 = with-cap(n-leaves * 2)
    cur-l []i64 = with-cap(n-leaves * 2)
    cur-r []i64 = with-cap(n-leaves * 2)
    i <- [0..n-leaves): {
        cur-sym.push(syms[i])
        cur-wt.push(wts[i])
        cur-l.push(-1)
        cur-r.push(-1)
        cur-sym.push(syms[i])
        cur-wt.push(wts[i])
        cur-l.push(-1)
        cur-r.push(-1)
    }
    use-count []i64 = with-len(n-sym)
    lv = 1
    (lv < max-len) {
        lv < max-len -> {

            ; package step: pair consecutive coins of the previous list
            pkg-wt []i64 = with-cap(0)
            pkg-l []i64 = with-cap(0)
            pkg-r []i64 = with-cap(0)
            total = cur-sym.len()
            p <- [0..total / 2): {
                #{overflow=wrap}
                q = p * 2
                #{overflow=wrap}
                pkg-wt.push(cur-wt[q] + cur-wt[q + 1])
                pkg-l.push(q)
                pkg-r.push(q + 1)
            }

            ; merge packaged coins with the doubled leaf list by weight
            m-sym []i64 = with-cap(0)
            m-wt []i64 = with-cap(0)
            m-l []i64 = with-cap(0)
            m-r []i64 = with-cap(0)
            a = 0
            b = 0
            (a < pkg-wt.len() && b < cur-sym.len()) {
                a < pkg-wt.len() && b < cur-sym.len() -> {
                    pkg-wt[a] <= cur-wt[b] -> {
                        m-sym.push(-1)
                        m-wt.push(pkg-wt[a])
                        m-l.push(pkg-l[a])
                        m-r.push(pkg-r[a])
                        #{overflow=wrap}
                        a = a + 1
                    }
                    -> {
                        m-sym.push(cur-sym[b])
                        m-wt.push(cur-wt[b])
                        m-l.push(-1)
                        m-r.push(-1)
                        #{overflow=wrap}
                        b = b + 1
                    }
                }
            }
            (a < pkg-wt.len()) {
                a < pkg-wt.len() -> {
                    m-sym.push(-1)
                    m-wt.push(pkg-wt[a])
                    m-l.push(pkg-l[a])
                    m-r.push(pkg-r[a])
                    #{overflow=wrap}
                    a = a + 1
                }
            }
            (b < cur-sym.len()) {
                b < cur-sym.len() -> {
                    m-sym.push(cur-sym[b])
                    m-wt.push(cur-wt[b])
                    m-l.push(-1)
                    m-r.push(-1)
                    #{overflow=wrap}
                    b = b + 1
                }
            }

            ; truncate to `need` coins; become the working list next level
            keep = need
            m-sym.len() < keep -> keep = m-sym.len()
            cur-sym = with-len(keep)
            cur-wt = with-len(keep)
            cur-l = with-len(keep)
            cur-r = with-len(keep)
            i <- [0..keep): {
                cur-sym[i] = m-sym[i]
                cur-wt[i] = m-wt[i]
                cur-l[i] = m-l[i]
                cur-r[i] = m-r[i]
            }
            #{overflow=wrap}
            lv = lv + 1
        }
    }

    ; count leaf-coin usage in the final list: length = occurrences
    i <- [0..cur-sym.len()): {
        cur-l[i] < 0 -> {
            #{overflow=wrap}
            use-count[cur-sym[i]] = use-count[cur-sym[i]] + 1
        }
    }
    i <- [0..n-sym): {
        lens[i] = use-count[i]
    }
}

; webp-enc-build-cl-seq: encode one prefix tree's code lengths with the
; 18-symbol meta-Huffman alphabet (direct / repeat-prev / repeat-zero)
; lens []i64: code lengths (0..15), e.g. 256 or 4096 entries
; seq-sym []i64 / seq-extra []i64 / seq-nextra []i64: emitted meta symbols (mutated)
webp-enc-build-cl-seq = (lens []i64, seq-sym []i64, seq-extra []i64, seq-nextra []i64) {
    n = lens.len()
    i = 0
    (i < n) {
        i < n -> {
            v = lens[i]

            ; count a rlen of equal code lengths (max 6) starting at i
            rlen = 1
            scanning = true
            (scanning && rlen < 6) {
                scanning && rlen < 6 -> {
                    #{overflow=wrap}
                    ni = i + rlen
                    ni < n && lens[ni] == v -> {
                        #{overflow=wrap}
                        rlen = rlen + 1
                    }
                    -> {
                        scanning = false
                    }
                }
            }
            {
                i > 0 && rlen >= 3 && v == lens[i - 1] -> {

                    ; repeat previous code length: meta symbol 16, 2 extra bits (rlen - 3)
                    seq-sym.push(16)
                    seq-extra.push(rlen - 3)
                    seq-nextra.push(2)
                }

                v == 0 && rlen >= 3 -> {

                    ; repeat zero: meta symbol 17, 3 extra bits (rlen - 3)
                    seq-sym.push(17)
                    seq-extra.push(rlen - 3)
                    seq-nextra.push(3)
                }

                -> {

                    ; emit direct code lengths for the rlen
                    k <- [0..rlen): {
                        seq-sym.push(v)
                        seq-extra.push(0)
                        seq-nextra.push(0)
                    }
                }
            }
            #{overflow=wrap}
            i = i + rlen
        }
    }
}

; webp-enc-write-tree: write one prefix code's code lengths as a
; non-simple meta-Huffman code block (5 trees share this writer)
; lens []i64: code lengths of the tree (256 + cc-size entries)
; returns new-buf i64, new-cnt i64
webp-enc-write-tree = (buf i64, cnt i64, out []byte, lens []i64) (new-buf i64, new-cnt i64) {
    seq-sym []i64 = with-cap(0)
    seq-extra []i64 = with-cap(0)
    seq-nextra []i64 = with-cap(0)
    webp-enc-build-cl-seq(lens, seq-sym, seq-extra, seq-nextra)

    ; histogram over the 18 meta symbols
    cl-freq []i64 = with-len(18)
    i <- [0..seq-sym.len()): {
        #{overflow=wrap}
        cl-freq[seq-sym[i]] = cl-freq[seq-sym[i]] + 1
    }
    cl-lens []i64 = with-len(18)
    webp-enc-huff-lens(cl-freq, 7, cl-lens)
    cl-codes []i64 = with-len(18)
    webp-enc-canonical(cl-lens, cl-codes)

    ; non-simple flag + 3-bit code lengths for the 18 meta symbols
    buf, cnt = webp-enc-write-bits(buf, cnt, out, 1, 1)
    i <- [0..18): {
        buf, cnt = webp-enc-write-bits(buf, cnt, out, cl-lens[i], 3)
    }
    ; the code-length sequence itself
    i <- [0..seq-sym.len()): {
        s = seq-sym[i]
        buf, cnt = webp-enc-write-bits(buf, cnt, out, cl-codes[s], cl-lens[s])
        {
            seq-nextra[i] > 0 -> {
                buf, cnt = webp-enc-write-bits(buf, cnt, out, seq-extra[i], seq-nextra[i])
            }
        }
    }
    new-buf = buf
    new-cnt = cnt
}

; webp-enc-write-entropy: 5 prefix code blocks + green-prefixed pixel data
; main-w i64: encoded width (reduced by color-index packing)
; g/r/b/a []i64: one component per pixel (a unused when has-alpha is false)
; len-g/len-r/len-b/len-a []i64: 5 x 4096 code-length arrays (tree j at offset j*4096)
; returns new-buf i64, new-cnt i64
webp-enc-write-entropy = (buf i64, cnt i64, out []byte, main-w i64, npix i64, g []i64, r []i64, b []i64, a []i64, len-g []i64, len-r []i64, len-b []i64, len-a []i64, has-alpha bool) (new-buf i64, new-cnt i64) {

    ; canonical codes per tree + write the 5 code-length blocks
    all-codes []i64 = with-len(5 * 4096)
    j <- [0..5): {
        tree-lens []i64 = with-len(4096)
        #{overflow=wrap}
        base = j * 4096
        k <- [0..4096): {
            tree-lens[k] = len-g[base + k]
        }
        tree-codes []i64 = with-len(4096)
        webp-enc-canonical(tree-lens, tree-codes)
        k <- [0..4096): {
            all-codes[base + k] = tree-codes[k]
        }
        buf, cnt = webp-enc-write-tree(buf, cnt, out, tree-lens)
    }

    ; pixel data: green first, then red/blue/alpha through tree (green >> 3) % 5
    i <- [0..npix): {
        gv = g[i]
        #{overflow=wrap}
        sel = (gv >> 3) % 5
        #{overflow=wrap}
        base = sel * 4096
        buf, cnt = webp-enc-write-bits(buf, cnt, out, all-codes[base + gv], len-g[base + gv])
        rv = r[i]
        buf, cnt = webp-enc-write-bits(buf, cnt, out, all-codes[base + 256 + rv], len-r[base + 256 + rv])
        bv = b[i]
        buf, cnt = webp-enc-write-bits(buf, cnt, out, all-codes[base + 512 + bv], len-b[base + 512 + bv])
        {
            has-alpha -> {
                av = a[i]
                buf, cnt = webp-enc-write-bits(buf, cnt, out, all-codes[base + 768 + av], len-a[base + 768 + av])
            }
        }
    }
    new-buf = buf
    new-cnt = cnt
}

; ── Load ──

; webp.load: load a WebP file (VP8L lossless decoding)
; Supports: VP8L (lossless). Lossy VP8 is NOT supported (returns nil).
; path str: file path
; returns img ?image: loaded image, nil on error or unsupported format
load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len() < 12 -> {
        img = nil
        return
    }

    ; Check RIFF signature
    (data[0] & 255) == 82 && (data[1] & 255) == 73 && (data[2] & 255) == 70 && (data[3] & 255) == 70 -> {}

    -> {
        img = nil
        return
    }

    ; Check WEBP format
    (data[8] & 255) == 87 && (data[9] & 255) == 69 && (data[10] & 255) == 66 && (data[11] & 255) == 80 -> {}

    -> {
        img = nil
        return
    }

    pos = 12
    w = 0
    h = 0
    bands = 3
    vp8l-pos = -1
    vp8l-size = 0
    has-alpha = false

    ; Parse RIFF chunks
    #{overflow=wrap}
    (pos + 8 <= data.len()) {

        #{overflow=wrap}
        pos + 8 <= data.len() -> {
            fourcc = data.slice(pos, pos + 4).to-bytes-str()
            chunk-size = webp-read-u32-le(data, pos + 4)
            chunk-data-pos = pos + 8
            {
                fourcc == 'VP8X' -> {
                    {
                        chunk-data-pos + 10 <= data.len() -> {
                            has-alpha = (data[chunk-data-pos] & 16) != 0
                            cw = (data[chunk-data-pos + 4] & 255) | ((data[chunk-data-pos + 5] & 255) << 8) | ((data[chunk-data-pos + 6] & 255) << 16)
                            ch = (data[chunk-data-pos + 7] & 255) | ((data[chunk-data-pos + 8] & 255) << 8) | ((data[chunk-data-pos + 9] & 255) << 16)
                            w = cw + 1
                            h = ch + 1
                        }
                    }
                    has-alpha -> bands = 4
                }

                fourcc == 'VP8L' -> {
                    vp8l-pos = chunk-data-pos
                    vp8l-size = chunk-size
                    w, h = webp-parse-vp8l(data, chunk-data-pos, chunk-size)
                    alpha-flag = webp-vp8l-alpha-flag(data, chunk-data-pos)
                    alpha-flag -> {
                        has-alpha = true
                        bands = 4
                    }
                }

                fourcc == 'VP8 ' -> {

                    ; Lossy VP8 — decode with the vp8 module (fixed-point path).
                    payload = data.slice(chunk-data-pos, chunk-data-pos + chunk-size)
                    rgb, dw, dh, vok = vp8.vp8-decode-frame(payload, chunk-size)
                    vok == 0 -> {
                        img = nil
                        return
                    }
                    {
                        #{overflow=wrap}
                        _vd []byte = with-len(dw * dh * 3)
                        vk <- [0..dw * dh * 3): {
                            _vd[vk] = rgb[vk]
                        }
                        img = image.new-from-data(dw, dh, 3, _vd)
                        return
                    }
                }
            }
            pos = chunk-data-pos + chunk-size
            {
                chunk-size & 1 != 0 -> pos = pos + 1
            }
        }
    }

    ; Check if VP8L was found
    {
        vp8l-pos < 0 || w <= 0 || h <= 0 || w > 65535 || h > 65535 -> {
            img = nil
            return
        }
    }

    ; Decode VP8L lossless bitstream
    pixels = webp-decode-vp8l(data, vp8l-pos, w, h, has-alpha)

    ; Build image from decoded pixel data
    #{overflow=wrap}
    _d []byte = with-len(w * h * bands)
    i <- [0..w * h * bands): {
        _d[i] = pixels[i]
    }
    img = image.new-from-data(w, h, bands, _d)
}

; ── Save ──

; webp.save: save image as WebP VP8L lossless, interoperable with libwebp
; Stream layout: header + optional color-index transform (unique colors
; <= 256, with 1/2/4/8-bit index packing) + subtract-green + 5 canonical
; Huffman prefix codes built from real histograms + entropy-coded pixels.
; path str: output path
; img image: image to save
; returns ok bool
save = (path str, img image) (ok bool) {
    w = img.width
    h = img.height
    has-alpha = img.bands == 4
    w > 16384 || h > 16384 -> {
        ok = false
        return
    }

    #{overflow=wrap}
    npix = w * h

    ; unpack source pixels into ARGB component arrays
    g0 []i64 = with-len(npix)
    r0 []i64 = with-len(npix)
    b0 []i64 = with-len(npix)
    a0 []i64 = with-len(npix)
    i <- [0..npix): {
        #{overflow=wrap}
        o = i * img.bands
        g0[i] = img.data[o + 1]
        r0[i] = img.data[o]
        b0[i] = img.data[o + 2]
        {
            has-alpha -> a0[i] = img.data[o + 3]
            -> a0[i] = 255
        }
    }

    ; color-index detection: collect up to 256 unique ARGB colors.
    ; if a 257th distinct color appears, abandon color-index mode cleanly.
    ci-mode = false
    ci-candidate = true
    pal-count = 0
    pal-a []i64 = with-len(256)
    pal-r []i64 = with-len(256)
    pal-g []i64 = with-len(256)
    pal-b []i64 = with-len(256)
    idx []i64 = with-len(npix)
    i <- [0..npix): {
        ci-candidate -> {
            found = -1
            p <- [0..pal-count): {
                found < 0 && pal-r[p] == r0[i] && pal-g[p] == g0[i] && pal-b[p] == b0[i] && pal-a[p] == a0[i] -> found = p
            }
            {
                found >= 0 -> idx[i] = found
                -> {
                    pal-count < 256 -> {
                        pal-r[pal-count] = r0[i]
                        pal-g[pal-count] = g0[i]
                        pal-b[pal-count] = b0[i]
                        pal-a[pal-count] = a0[i]
                        idx[i] = pal-count
                        #{overflow=wrap}
                        pal-count = pal-count + 1
                    }
                    -> {
                        ci-candidate = false
                    }
                }
            }
        }
    }
    ci-candidate && pal-count > 0 && pal-count <= 256 -> ci-mode = true

    ; bits per color index from palette size (per VP8L spec)
    ci-bits = 8
    ci-mode -> {
        {
            pal-count <= 2 -> ci-bits = 1
        }
        {
            pal-count > 2 && pal-count <= 4 -> ci-bits = 2
        }
        {
            pal-count > 4 && pal-count <= 16 -> ci-bits = 4
        }
    }

    ; subtract-green heuristic: enabled when |R-G| + |B-G| residuals are
    ; smaller than raw |R| + |B| (and not already inside color-index mode,
    ; where sg applies to the palette plane instead)
    sg-enabled = false
    ! ci-mode -> {
        sum-raw = 0
        sum-sg = 0
        i <- [0..npix): {
            #{overflow=wrap}
            dr = r0[i] - 128
            {
                dr < 0 -> dr = -dr
            }
            #{overflow=wrap}
            db = b0[i] - 128
            {
                db < 0 -> db = -db
            }
            #{overflow=wrap}
            sum-raw = sum-raw + dr + db
            #{overflow=wrap}
            dg = r0[i] - g0[i]
            {
                dg < 0 -> dg = -dg
            }
            #{overflow=wrap}
            db2 = b0[i] - g0[i]
            {
                db2 < 0 -> db2 = -db2
            }
            #{overflow=wrap}
            sum-sg = sum-sg + dg + db2
        }
        sum-sg < sum-raw -> sg-enabled = true
    }
    ; color-index mode stores the full (true-color) palette and a pure index
    ; image (R=B=A=0), so subtract-green is not combined with it
    ci-mode -> sg-enabled = false

    ; build the encoded component planes
    ; color-index mode: green = packed palette indices (one word per
    ; (8 >> ci-bits) pixels, spread across the 4 channels); red/blue are
    ; the subtract-green residuals of the palette entries, alpha unused
    main-w = w
    #{overflow=wrap}
    ppw = 8 >> ci-bits
    #{overflow=wrap}
    enc-n = npix / ppw
    enc-g []i64 = with-len(npix)
    enc-r []i64 = with-len(npix)
    enc-b []i64 = with-len(npix)
    enc-a []i64 = with-len(npix)
    {
        ci-mode -> {
            #{overflow=wrap}
            num = w + ppw - 1
            #{overflow=wrap}
            main-w = num / ppw
            #{overflow=wrap}
            enc-n = main-w * h
            i <- [0..enc-n): {
                word = 0
                k <- [0..ppw): {
                    #{overflow=wrap}
                    sx = i % main-w * ppw + k
                    #{overflow=wrap}
                    sy = i / main-w
                    p = 0
                    sx < w -> p = idx[sy * w + sx]
                    #{overflow=wrap}
                    bit-pos = k * ci-bits
                    #{overflow=wrap}
                    chunk = bit-pos / 8
                    #{overflow=wrap}
                    shift = (bit-pos - chunk * 8) * 8
                    #{overflow=wrap}
                    word = word | ((p & ((1 << ci-bits) - 1)) << shift)
                }
                enc-g[i] = word & 255
                enc-r[i] = (word >> 8) & 255
                enc-b[i] = (word >> 16) & 255
                enc-a[i] = (word >> 24) & 255
            }
        }

        -> {
            sg-enabled -> {
                i <- [0..npix): {
                    #{overflow=wrap}
                    enc-r[i] = (r0[i] - g0[i]) & 255
                    #{overflow=wrap}
                    enc-b[i] = (b0[i] - g0[i]) & 255
                }
            }
            -> {
                i <- [0..npix): {
                    enc-r[i] = r0[i]
                    enc-b[i] = b0[i]
                }
            }
            i <- [0..npix): {
                enc-g[i] = g0[i]
                enc-a[i] = a0[i]
            }
            #{overflow=wrap}
            enc-n = npix
        }
    }

    ; histograms: green symbols are split across the 5 trees by (g >> 3) % 5
    freq-g []i64 = with-len(5 * 4096)
    freq-r []i64 = with-len(5 * 4096)
    freq-b []i64 = with-len(5 * 4096)
    freq-a []i64 = with-len(5 * 4096)
    i <- [0..enc-n): {
        gv = enc-g[i]
        #{overflow=wrap}
        base = ((gv >> 3) % 5) * 4096
        #{overflow=wrap}
        freq-g[base + gv] = freq-g[base + gv] + 1
        #{overflow=wrap}
        freq-r[base + 256 + enc-r[i]] = freq-r[base + 256 + enc-r[i]] + 1
        #{overflow=wrap}
        freq-b[base + 512 + enc-b[i]] = freq-b[base + 512 + enc-b[i]] + 1
        {
            has-alpha -> {
                #{overflow=wrap}
                freq-a[base + 768 + enc-a[i]] = freq-a[base + 768 + enc-a[i]] + 1
            }
        }
    }

    ; code lengths per tree (limit 15 bits per VP8L spec)
    len-g []i64 = with-len(5 * 4096)
    len-r []i64 = with-len(5 * 4096)
    len-b []i64 = with-len(5 * 4096)
    len-a []i64 = with-len(5 * 4096)
    flat []i64 = with-len(4096)
    j <- [0..5): {
        #{overflow=wrap}
        base = j * 4096
        tmp []i64 = with-len(4096)
        k <- [0..4096): {
            tmp[k] = freq-g[base + k]
        }
        webp-enc-huff-lens(tmp, 15, flat)
        k <- [0..4096): {
            len-g[base + k] = flat[k]
        }
        k <- [0..4096): {
            tmp[k] = freq-r[base + k]
        }
        webp-enc-huff-lens(tmp, 15, flat)
        k <- [0..4096): {
            len-r[base + k] = flat[k]
        }
        k <- [0..4096): {
            tmp[k] = freq-b[base + k]
        }
        webp-enc-huff-lens(tmp, 15, flat)
        k <- [0..4096): {
            len-b[base + k] = flat[k]
        }
        k <- [0..4096): {
            tmp[k] = freq-a[base + k]
        }
        webp-enc-huff-lens(tmp, 15, flat)
        k <- [0..4096): {
            len-a[base + k] = flat[k]
        }
    }

    ; assemble the VP8L bitstream (bit accumulator threaded as scalars)
    vp8l-out []byte = with-cap(0)
    bit-buf = 0
    bit-cnt = 0
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 47, 8)
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, w - 1, 14)
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, h - 1, 14)
    ab = 0
    {
        has-alpha -> ab = 1
    }
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, ab, 1)
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 0, 3)

    ; transform chain: color-index then subtract-green
    {
        ci-mode -> {
            bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 1, 1)
            bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 3, 2)
            bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, pal-count - 1, 8)
            p <- [0..pal-count): {
                bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, pal-b[p], 8)
                bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, pal-g[p], 8)
                bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, pal-r[p], 8)
                bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, pal-a[p], 8)
            }
        }
    }
    {
        sg-enabled -> {
            bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 1, 1)
            bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 2, 2)
        }
    }
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 0, 1)

    ; color cache: not used
    bit-buf, bit-cnt = webp-enc-write-bits(bit-buf, bit-cnt, vp8l-out, 0, 1)

    ; entropy-coded image data
    bit-buf, bit-cnt = webp-enc-write-entropy(bit-buf, bit-cnt, vp8l-out, main-w, enc-n, enc-g, enc-r, enc-b, enc-a, len-g, len-r, len-b, len-a, has-alpha)

    ; flush remaining bits
    {
        bit-cnt > 0 -> {
            vp8l-out.push((bit-buf & ((1 << bit-cnt) - 1)) & 255)
        }
    }

    ; RIFF/WEBP container with a single VP8L chunk
    #{overflow=wrap}
    total = 8 + 8 + vp8l-out.len()
    #{overflow=wrap}
    padded = total + (total & 1)
    buf []byte = with-cap(padded)
    buf.push(82); R
    buf.push(73); I
    buf.push(70); F
    buf.push(70); F
    #{overflow=wrap}
    sz = total - 8
    buf.push(sz & 255)
    buf.push((sz >> 8) & 255)
    buf.push((sz >> 16) & 255)
    buf.push((sz >> 24) & 255)
    buf.push(87); W
    buf.push(69); E
    buf.push(66); B
    buf.push(80); P
    buf.push(86); V
    buf.push(80); P
    buf.push(56); 8
    buf.push(76); L
    chunk-len = vp8l-out.len()
    buf.push(chunk-len & 255)
    buf.push((chunk-len >> 8) & 255)
    buf.push((chunk-len >> 16) & 255)
    buf.push((chunk-len >> 24) & 255)
    i <- [0..chunk-len): {
        buf.push(vp8l-out[i])
    }
    {
        total & 1 != 0 -> buf.push(0)
    }

    wfd = fs.open-write(path)
    {
        wfd < 0 -> {
            ok = false
            return
        }
    }
    fs.write(wfd, buf, buf.len())
    fs.close(wfd)
    ok = true
}
