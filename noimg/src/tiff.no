; tiff.no — TIFF (Tagged Image File Format) read/write
; Supports:
;   - Little-endian (II) byte order
;   - Baseline RGB (photometric=2), Grayscale (photometric=1)
;   - 8-bit and 16-bit samples
;   - Strip-based layout (no tiles)
;   - No compression (compression=1)
;   - Single strip per image (rows-per-strip = height)
;
; TIFF file layout:
;   Header (8 bytes): byte-order(II/MM), magic(42), IFD-offset(4)
;   IFD: count(2), entries(count*12), next-IFD(4)
;   Each entry: tag(2), type(2), count(4), value/offset(4)

; TIFF tag constants
; Note: values are used as literal constants in code to avoid compiler bug with global variables

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.invert
# /noimg/src/image.add-const
# /noimg/src/image.avg
# /noimg/src/image.min-val
# /noimg/src/image.max-val
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

tiff-write-entry = (out []byte, tag i64, typ i64, count i64, value i64) {
    out.push(tag & 255)
    out.push((tag >> 8) & 255)
    out.push(typ & 255)
    out.push((typ >> 8) & 255)
    out.push(count & 255)
    out.push((count >> 8) & 255)
    out.push((count >> 16) & 255)
    out.push((count >> 24) & 255)
    out.push(value & 255)
    out.push((value >> 8) & 255)
    out.push((value >> 16) & 255)
    out.push((value >> 24) & 255)
}

; tiff-read-u16: read 16-bit value
tiff-read-u16 = (data []byte, offset i64, little-endian bool) (val i64) {
    b0 byte = data[offset]: {
        ok -> it

        -> _
    }
    b1 byte = data[offset + 1]: {
        ok -> it

        -> _
    }
    {
        little-endian -> {
            val = (b0 & 255) | ((b1 & 255) << 8)
        }

        -> {
            val = ((b0 & 255) << 8) | (b1 & 255)
        }
    }
}

; tiff-read-u32: read 32-bit value
tiff-read-u32 = (data []byte, offset i64, little-endian bool) (val i64) {
    b0 byte = data[offset]: {
        ok -> it

        -> _
    }
    b1 byte = data[offset + 1]: {
        ok -> it

        -> _
    }
    b2 byte = data[offset + 2]: {
        ok -> it

        -> _
    }
    b3 byte = data[offset + 3]: {
        ok -> it

        -> _
    }
    {
        little-endian -> {
            val = (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)
        }

        -> {
            val = ((b0 & 255) << 24) | ((b1 & 255) << 16) | ((b2 & 255) << 8) | (b3 & 255)
        }
    }
}

; ── Load ──

; tiff.load: load a TIFF file
; path str: file path
; returns img ?image: loaded image, nil on error
load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len() < 8 -> {
        img = nil
        return
    }

    ; Check byte order
    little-endian = true
    d0 byte = data[0]: {
        ok -> it

        -> _
    }
    d1 byte = data[1]: {
        ok -> it

        -> _
    }
    {
        (d0 & 255) == 73 && (d1 & 255) == 73 -> {
            little-endian = true
        }

        (d0 & 255) == 77 && (d1 & 255) == 77 -> {
            little-endian = false
        }

        -> {
            img = nil
            return
        }
    }

    ; Read magic number (42)
    magic = tiff-read-u16(data, 2, little-endian)
    magic != 42 -> {
        img = nil
        return
    }

    ; Read IFD offset
    ifd-offset = tiff-read-u32(data, 4, little-endian)

    #{overflow=wrap}
    ifd-offset + 2 > data.len() -> {
        img = nil
        return
    }

    ; Parse IFD
    num-entries = tiff-read-u16(data, ifd-offset, little-endian)

    ; Initialize tag values
    w = 0
    h = 0
    bits-per-sample = 8
    samples-per-pixel = 1
    compression = 1
    photometric = 0
    strip-offset = 0
    strip-bytes = 0
    rows-per-strip = 0
    planar = 1
    i <- [0..num-entries): {

        #{overflow=wrap}
        entry-pos = ifd-offset + 2 + i * 12
        tag = tiff-read-u16(data, entry-pos, little-endian)

        #{overflow=wrap}
        type = tiff-read-u16(data, entry-pos + 2, little-endian): {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        count = tiff-read-u32(data, entry-pos + 4, little-endian): {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        val = tiff-read-u32(data, entry-pos + 8, little-endian)
        {
            tag == 256 -> w = val

            tag == 257 -> h = val

            tag == 258 -> bits-per-sample = val

            tag == 277 -> samples-per-pixel = val

            tag == 259 -> compression = val

            tag == 262 -> photometric = val

            tag == 273 -> strip-offset = val

            tag == 279 -> strip-bytes = val

            tag == 278 -> rows-per-strip = val

            tag == 284 -> planar = val
        }
    }
    {
        w <= 0 || h <= 0 || w > 65535 || h > 65535 -> {
            img = nil
            return
        }

        compression != 1 -> {
            img = nil
            return
        }

        bits-per-sample != 8 -> {
            img = nil
            return
        }
    }
    {
        samples-per-pixel == 0 -> samples-per-pixel = 1
    }
    bands = samples-per-pixel
    {
        bands > 4 -> bands = 4
    }

    #{overflow=wrap}
    n = w * h * bands
    d []byte = with-len(n)
    tmp = image.new-from-data(w, h, bands, d)

    ; Copy pixel data from strip
    #{overflow=wrap}
    {
        strip-offset + n <= data.len() -> {

            ; TIFF stores RGB, we store RGB
            {
                bands == samples-per-pixel -> {
                    i <- [0..n): {
                        dv = data[strip-offset + i]: {
                            ok -> it

                            -> 0
                        }
                        tmp.data[i] = dv & 255
                    }
                }

                -> {

                    ; Need to truncate channels
                    npix = w * h
                    i <- [0..npix): {
                        b <- [0..bands): {
                            dv2 = data[strip-offset + i * samples-per-pixel + b]: {
                                ok -> it

                                -> 0
                            }
                            tmp.data[i * bands + b] = dv2 & 255
                        }
                    }
                }
            }
        }
    }
    img = tmp
}

; tiff-write-entry: write a 12-byte IFD entry (little-endian)
; ── Save ──

; tiff.save: save image as baseline TIFF (uncompressed, little-endian)
; path str: output path
; img image: image
; returns ok bool
save = (path str, img image) (ok bool) {
    w = img.width
    h = img.height
    bands = img.bands
    {
        bands > 4 -> bands = 4
    }
    bits-per-sample = 8
    photometric = 2
    {
        bands == 1 -> photometric = 1

        bands >= 3 -> photometric = 2

        bands == 4 -> photometric = 2
    }

    ; Build pixel data (ensure RGB for bands>=3)
    #{overflow=wrap}
    pixel-data []byte = with-len(w * h * bands)
    {
        img.bands == bands -> {
            i <- [0..w * h * bands): {
                d9v1 byte = img.data[i]: {
                    ok -> it

                    -> _
                }
                pixel-data[i]: {
                    ok -> it = d9v1

                    -> _
                }
            }
        }

        -> {

            #{overflow=wrap}
            npix = w * h
            i <- [0..npix): {
                {
                    bands == 1 -> {
                        img.bands >= 3 -> {

                            #{overflow=wrap}
                            ri = i * img.bands: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            ri1 = ri + 1: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            ri2 = ri + 2: {
                                ok -> it

                                -> 0
                            }
                            r = img.data[ri]: {
                                ok -> it

                                -> 0
                            }
                            g = img.data[ri1]: {
                                ok -> it

                                -> 0
                            }
                            b = img.data[ri2]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            r299 = r * 299: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            g587 = g * 587: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            b114 = b * 114: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tsum = r299 + g587: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tsum2 = tsum + b114: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            tm = tsum2 / 1000: {
                                ok -> it

                                -> 0
                            }
                            pixel-data[i]: {
                                ok -> it = tm

                                -> _
                            }
                        }

                        -> {
                            d9v2 byte = img.data[i * img.bands]: {
                                ok -> it

                                -> _
                            }
                            pixel-data[i]: {
                                ok -> it = d9v2

                                -> _
                            }
                        }
                    }

                    bands == 3 -> {
                        img.bands >= 3 -> {
                            d9v3 byte = img.data[i * img.bands]: {
                                ok -> it

                                -> _
                            }

                            #{overflow=wrap}
                            pixel-data[i * 3]: {
                                ok -> it = d9v3

                                -> _
                            }

                            d9v4 byte = img.data[i * img.bands + 1]: {
                                ok -> it

                                -> _
                            }

                            #{overflow=wrap}
                            pixel-data[i * 3 + 1]: {
                                ok -> it = d9v4

                                -> _
                            }

                            d9v5 byte = img.data[i * img.bands + 2]: {
                                ok -> it

                                -> _
                            }

                            #{overflow=wrap}
                            pixel-data[i * 3 + 2]: {
                                ok -> it = d9v5

                                -> _
                            }
                        }

                        img.bands == 1 -> {
                            v = img.data[i]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            pixel-data[i * 3]: {
                                ok -> it = v

                                -> _
                            }

                            #{overflow=wrap}
                            pixel-data[i * 3 + 1]: {
                                ok -> it = v

                                -> _
                            }

                            #{overflow=wrap}
                            pixel-data[i * 3 + 2]: {
                                ok -> it = v

                                -> _
                            }
                        }
                    }

                    bands == 4 -> {
                        b <- [0..4): {
                            {
                                b < img.bands -> {
                                    d9v6 byte = img.data[i * img.bands + b]: {
                                        ok -> it

                                        -> _
                                    }

                                    #{overflow=wrap}
                                    pixel-data[i * 4 + b]: {
                                        ok -> it = d9v6

                                        -> _
                                    }
                                }

                                -> {

                                    #{overflow=wrap}
                                    pixel-data[i * 4 + b]: {
                                        ok -> it = 255

                                        -> _
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    ; Build TIFF file
    ; Header: 8 bytes
    ; IFD: 2 + 10*12 + 4 = 126 bytes
    num-tags = 10
    ifd-offset = 8
    pixel-offset = 0

    #{overflow=wrap}
    nt12 = num-tags * 12: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    po1 = 8 + 2: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    po2 = po1 + nt12: {
        ok -> it

        -> 0
    }

    #{overflow=wrap}
    po3 = po2 + 4: {
        ok -> it

        -> 0
    }
    pixel-offset = po3

    ; Write header
    #{overflow=wrap}
    buf []byte = with-cap(pixel-offset + pixel-data.len())

    ; Byte order: little-endian (II)
    buf.push(73)
    buf.push(73)

    ; Magic
    buf.push(42)
    buf.push(0)

    ; IFD offset
    buf.push(ifd-offset & 255)
    buf.push((ifd-offset >> 8) & 255)
    buf.push((ifd-offset >> 16) & 255)
    buf.push((ifd-offset >> 24) & 255)

    ; IFD entry count
    buf.push(num-tags & 255)
    buf.push(0)

    ; IFD entries (12 bytes each: tag(2), type(2), count(4), value(4))
    ; Tag 256: ImageWidth
    tiff-write-entry(buf, 256, 3, 1, w)

    ; Tag 257: ImageLength
    tiff-write-entry(buf, 257, 3, 1, h)

    ; Tag 258: BitsPerSample
    tiff-write-entry(buf, 258, 3, 1, 8)

    ; Tag 259: Compression (1 = none)
    tiff-write-entry(buf, 259, 3, 1, 1)

    ; Tag 262: PhotometricInterpretation
    tiff-write-entry(buf, 262, 3, 1, photometric)

    ; Tag 273: StripOffsets
    tiff-write-entry(buf, 273, 4, 1, pixel-offset)

    ; Tag 277: SamplesPerPixel
    tiff-write-entry(buf, 277, 3, 1, bands)

    ; Tag 278: RowsPerStrip
    tiff-write-entry(buf, 278, 3, 1, h)

    ; Tag 279: StripByteCounts
    tiff-write-entry(buf, 279, 4, 1, pixel-data.len())

    ; Tag 284: PlanarConfiguration (1 = chunky)
    tiff-write-entry(buf, 284, 3, 1, 1)

    ; Next IFD offset (0 = no more)
    buf.push(0)
    buf.push(0)
    buf.push(0)
    buf.push(0)

    ; Pixel data
    i <- [0..pixel-data.len()): {
        pv = pixel-data[i]: {
            ok -> it

            -> 0
        }
        buf.push(pv)
    }

    ; Write file
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, buf.len())
    fs.close(wfd)
    ok = true
}
