; image.no — Core image structure and basic operations
; Inspired by libvips VipsImage design

; Image structure — represents a pixel buffer in memory
; data is stored as a flat byte array in row-major order:
; pixel(x, y, band) = data[(y * width + x) * bands + band]
image {
    width i64
    height i64
    bands i64
    format i64      ; DEPRECATED: use depth instead. 0=U8, 1=U16 (== depth-1)
    depth i64       ; bytes per sample: 1=8-bit (U8), 2=16-bit (U16)
    interpretation i64
    coding i64
    xres f64
    yres f64
    xoffset i64
    yoffset i64
    data str
}

; ── Constructors ──

; new: create a new blank image
; w i64: width
; h i64: height
; b i64: bands (channels)
; returns img image: new image filled with zeros
new = (w i64, h i64, b i64) (img image) {
    img.width = w
    img.height = h
    img.bands = b
    img.format = 0
    img.depth = 1
    img.interpretation = 0
    img.coding = 0
    img.xres = 1.0
    img.yres = 1.0
    img.xoffset = 0
    img.yoffset = 0
    n = w * h * b
    _d str = with-len(n)
    img.data = _d
}

; new-from-data: create image wrapping existing data
; w i64: width
; h i64: height
; b i64: bands
; data str: pixel data
; returns img image: image wrapping data
new-from-data = (w i64, h i64, b i64, data str) (img image) {
    img.width = w
    img.height = h
    img.bands = b
    img.format = 0
    img.depth = 1
    img.interpretation = 0
    img.coding = 0
    img.xres = 1.0
    img.yres = 1.0
    img.xoffset = 0
    img.yoffset = 0
    img.data = data
}

; ── Pixel access ──

; get-pixel: get a pixel value
; img image: image
; x i64: x coordinate
; y i64: y coordinate
; band i64: band index
; returns val i64: pixel value
get-pixel = (img image, x i64, y i64, band i64) (val i64) {
    {
        img.depth == 2 -> {
            idx = ((y * img.width + x) * img.bands + band) * 2
            lo = img.data[idx]
            hi = img.data[idx + 1]
            val = lo | (hi << 8)
        }

        -> {
            idx = (y * img.width + x) * img.bands + band
            val = img.data[idx]
        }
    }
}

; set-pixel: set a pixel value
; img image: image
; x i64: x coordinate
; y i64: y coordinate
; band i64: band index
; v i64: value
set-pixel = (img image, x i64, y i64, band i64, v i64) {
    {
        img.depth == 2 -> {
            {
                v < 0 -> v = 0
            }
            {
                v > 65535 -> v = 65535
            }
            idx = ((y * img.width + x) * img.bands + band) * 2
            img.data[idx] = v & 255
            img.data[idx + 1] = (v >> 8) & 255
        }

        -> {
            idx = (y * img.width + x) * img.bands + band
            img.data[idx] = v
        }
    }
}

; ── Copy / Clone ──

; copy: deep copy an image
; img image: source image
; returns out image: copy of source
copy = (img image) (out image) {
    out.width = img.width
    out.height = img.height
    out.bands = img.bands
    out.format = img.format
    out.depth = img.depth
    out.interpretation = img.interpretation
    out.coding = img.coding
    out.xres = img.xres
    out.yres = img.yres
    out.xoffset = img.xoffset
    out.yoffset = img.yoffset
    n = img.width * img.height * img.bands * img.depth
    _d str = with-len(n)
    out.data = _d
    i <- [0..n): {
        out.data[i] = img.data[i]
    }
}

; ── Utility ──

; fill: fill entire image with a value
; img image: image to fill (modified in place)
; v i64: value to fill
fill = (img image, v i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            {
                v < 0 -> v = 0
            }
            {
                v > 65535 -> v = 65535
            }
            i <- [0..n): {
                idx = i * 2
                img.data[idx] = v & 255
                img.data[idx + 1] = (v >> 8) & 255
            }
        }

        -> {
            i <- [0..n): {
                img.data[i] = v
            }
        }
    }
}

; invert: invert all pixels (255 - val for U8)
; img image: image (modified in place)
invert = (img image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            i <- [0..n): {
                idx = i * 2
                lo = img.data[idx]
                hi = img.data[idx + 1]
                val = lo | (hi << 8)
                val = 65535 - val
                img.data[idx] = val & 255
                img.data[idx + 1] = (val >> 8) & 255
            }
        }

        -> {
            i <- [0..n): {
                img.data[i] = 255 - img.data[i]
            }
        }
    }
}

; add-const: add a constant to all pixels
; img image: image (modified in place)
; c i64: constant to add
add-const = (img image, c i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            mx-v = 65535
            i <- [0..n): {
                idx = i * 2
                lo = img.data[idx]
                hi = img.data[idx + 1]
                v = (lo | (hi << 8)) + c
                v > mx-v -> v = mx-v
                v < 0 -> v = 0
                img.data[idx] = v & 255
                img.data[idx + 1] = (v >> 8) & 255
            }
        }

        -> {
            i <- [0..n): {
                v = img.data[i] + c
                v > 255 -> v = 255
                v < 0 -> v = 0
                img.data[i] = v
            }
        }
    }
}

; avg: compute average pixel value
; img image: image
; returns avg i64: average value
avg = (img image) (avg i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    sum = 0
    {
        d == 2 -> {
            i <- [0..n): {
                idx = i * 2
                lo = img.data[idx]
                hi = img.data[idx + 1]
                sum = sum + (lo | (hi << 8))
            }
        }

        -> {
            i <- [0..n): {
                sum = sum + img.data[i]
            }
        }
    }
    n == 0 -> return
    avg = sum / n
}

; min-val: compute minimum pixel value
; img image: image
; returns mn i64: minimum value
min-val = (img image) (mn i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            mn = 65535
            i <- [0..n): {
                idx = i * 2
                lo = img.data[idx]
                hi = img.data[idx + 1]
                val = lo | (hi << 8)
                val < mn -> mn = val
            }
        }

        -> {
            mn = 255
            i <- [0..n): {
                img.data[i] < mn -> mn = img.data[i]
            }
        }
    }
}

; max-val: compute maximum pixel value
; img image: image
; returns mx i64: maximum value
max-val = (img image) (mx i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            mx = 0
            i <- [0..n): {
                idx = i * 2
                lo = img.data[idx]
                hi = img.data[idx + 1]
                val = lo | (hi << 8)
                val > mx -> mx = val
            }
        }

        -> {
            mx = 0
            i <- [0..n): {
                img.data[i] > mx -> mx = img.data[i]
            }
        }
    }
}

; ── Additional utility operations ──

; sub-const: subtract a constant from all pixels
; img image: image (modified in place)
; c i64: constant to subtract
sub-const = (img image, c i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            i <- [0..n): {
                idx = i * 2
                lo = img.data[idx]
                hi = img.data[idx + 1]
                v = (lo | (hi << 8)) - c
                v < 0 -> v = 0
                img.data[idx] = v & 255
                img.data[idx + 1] = (v >> 8) & 255
            }
        }

        -> {
            i <- [0..n): {
                v = img.data[i] - c
                v < 0 -> v = 0
                img.data[i] = v
            }
        }
    }
}

; mul-const: multiply all pixels by a factor (factor * 1000 for fixed-point)
; img image: image (modified in place)
; factor i64: multiplication factor * 1000 (e.g. 1500 = 1.5x)
mul-const = (img image, factor i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            mx-v = 65535
            i <- [0..n): {
                idx = i * 2
                lo = img.data[idx]
                hi = img.data[idx + 1]
                v = (lo | (hi << 8)) * factor / 1000
                v > mx-v -> v = mx-v
                v < 0 -> v = 0
                img.data[idx] = v & 255
                img.data[idx + 1] = (v >> 8) & 255
            }
        }

        -> {
            i <- [0..n): {
                v = img.data[i] * factor / 1000
                v > 255 -> v = 255
                v < 0 -> v = 0
                img.data[i] = v
            }
        }
    }
}

; clamp: clamp all pixel values to [min, max]
; img image: image (modified in place)
; mn i64: minimum value
; mx i64: maximum value
clamp = (img image, mn i64, mx i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands
    {
        d == 2 -> {
            i <- [0..n): {
                idx = i * 2
                lo i64 = img.data[idx]
                hi i64 = img.data[idx + 1]
                v i64 = lo | (hi << 8)
                v < mn -> v = mn
                v > mx -> v = mx
                img.data[idx] = v & 255
                img.data[idx + 1] = (v >> 8) & 255
            }
        }

-> {
; U8 path: direct data access for performance
i <- [0..n): {
v i64 = img.data[i]
v < mn -> v = mn
v > mx -> v = mx
img.data[i] = v
}
}
    }
}

; has-alpha: check if image has an alpha channel
; img image: image
; returns ok bool: true if 4-band (RGBA)
has-alpha = (img image) (ok bool) {
    ok = img.bands == 4
}

; is-rgba: check if image is RGBA
; img image: image
; returns ok bool: true if RGBA
is-rgba = (img image) (ok bool) {
    ok = img.bands == 4
}

; is-gray: check if image is grayscale
; img image: image
; returns ok bool: true if 1-band
is-gray = (img image) (ok bool) {
    ok = img.bands == 1
}

; is-rgb: check if image is RGB
; img image: image
; returns ok bool: true if 3-band
is-rgb = (img image) (ok bool) {
    ok = img.bands == 3
}

; add-alpha: add a fully opaque alpha channel to an image
; img image: input image
; returns out image: image with alpha channel added
add-alpha = (img image) (out image) {
{
img.bands == 4 -> {
out = image.copy(img)
return
}
}
npix = img.width * img.height
_d str = with-len(npix * 4)
out = image.new-from-data(img.width, img.height, 4, _d)
i <- [0..npix): {
{
img.bands >= 3 -> {
out.data[i * 4] = img.data[i * img.bands]
out.data[i * 4 + 1] = img.data[i * img.bands + 1]
out.data[i * 4 + 2] = img.data[i * img.bands + 2]
out.data[i * 4 + 3] = 255
}

img.bands == 2 -> {
; Gray + alpha: copy gray to R,G,B and alpha to A
out.data[i * 4] = img.data[i * 2]
out.data[i * 4 + 1] = img.data[i * 2]
out.data[i * 4 + 2] = img.data[i * 2]
out.data[i * 4 + 3] = img.data[i * 2 + 1]
}

-> {
; 1-band gray: copy gray to R,G,B, opaque alpha
out.data[i * 4] = img.data[i]
out.data[i * 4 + 1] = img.data[i]
out.data[i * 4 + 2] = img.data[i]
out.data[i * 4 + 3] = 255
}
}
}
}

; remove-alpha: remove alpha channel (flatten onto white background)
; img image: input RGBA image
; returns out image: RGB image
remove-alpha = (img image) (out image) {
    {
        img.bands != 4 -> {
            out = image.copy(img)
            return
        }
    }
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        a = img.data[i * 4 + 3]
        r = img.data[i * 4]
        g = img.data[i * 4 + 1]
        b = img.data[i * 4 + 2]
        ; Alpha blend onto white: out = src * alpha + 255 * (1 - alpha)
        out.data[i * 3] = (r * a + 255 * (255 - a)) / 255
        out.data[i * 3 + 1] = (g * a + 255 * (255 - a)) / 255
        out.data[i * 3 + 2] = (b * a + 255 * (255 - a)) / 255
    }
}

; n-pixels: return total number of pixels
; img image: image
; returns n i64: number of pixels (width * height)
n-pixels = (img image) (n i64) {
    n = img.width * img.height
}

; n-bytes: return total data byte count
; img image: image
; returns n i64: total bytes (width * height * bands * depth)
n-bytes = (img image) (n i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    n = img.width * img.height * img.bands * d
}

; image.is-u8: check if image is 8-bit
; img image: image
; returns ok bool: true if depth == 1
is-u8 = (img image) (ok bool) {
    ok = img.depth == 1
}

; image.is-u16: check if image is 16-bit
; img image: image
; returns ok bool: true if depth == 2
is-u16 = (img image) (ok bool) {
    ok = img.depth == 2
}

; image.bytes-per-sample: return bytes per sample
; img image: image
; returns n i64: 1 for U8, 2 for U16
bytes-per-sample = (img image) (n i64) {
    n = img.depth
    {
        n == 0 -> n = 1
    }
}

; ── 16-bit / HDR support ──
; format field: 0 = U8 (8-bit unsigned), 1 = U16 (16-bit unsigned)
; For U16, data is stored as 2 bytes per sample, little-endian
; pixel(x,y,band) = data[((y*width+x)*bands+band)*2] | (data[...+1] << 8)

; Format constants
; U8  = 0
; U16 = 1

; image.new-u16: create a new 16-bit image filled with zeros
; w i64: width
; h i64: height
; b i64: bands
; returns img image: new 16-bit image
new-u16 = (w i64, h i64, b i64) (img image) {
    img.width = w
    img.height = h
    img.bands = b
    img.format = 1
    img.depth = 2
    img.interpretation = 0
    img.coding = 0
    img.xres = 1.0
    img.yres = 1.0
    img.xoffset = 0
    img.yoffset = 0
    n = w * h * b * 2
    _d str = with-len(n)
    img.data = _d
}

; image.get-pixel-u16: get a 16-bit pixel value
; img image: 16-bit image
; x i64: x coordinate
; y i64: y coordinate
; band i64: band index
; returns val i64: pixel value (0-65535)
get-pixel-u16 = (img image, x i64, y i64, band i64) (val i64) {
    idx = ((y * img.width + x) * img.bands + band) * 2
    lo = img.data[idx]
    hi = img.data[idx + 1]
    val = lo | (hi << 8)
}

; image.set-pixel-u16: set a 16-bit pixel value
; img image: 16-bit image (modified in place)
; x i64: x coordinate
; y i64: y coordinate
; band i64: band index
; v i64: value (0-65535)
set-pixel-u16 = (img image, x i64, y i64, band i64, v i64) {
    idx = ((y * img.width + x) * img.bands + band) * 2
    {
        v < 0 -> v = 0
    }
    {
        v > 65535 -> v = 65535
    }
    img.data[idx] = v & 255
    img.data[idx + 1] = (v >> 8) & 255
}

; image.u8-to-u16: convert 8-bit image to 16-bit
; Expands 8-bit values to 16-bit by scaling: u16 = u8 * 257
; This maps 0->0, 255->65535
; img image: 8-bit source image
; returns out image: 16-bit image
u8-to-u16 = (img image) (out image) {
    npix = img.width * img.height
    out = new-u16(img.width, img.height, img.bands)
    i <- [0..npix * img.bands): {
        v = img.data[i]
        idx = i * 2
        u16 = v * 257
        out.data[idx] = u16 & 255
        out.data[idx + 1] = (u16 >> 8) & 255
    }
}

; image.u16-to-u8: convert 16-bit image to 8-bit
; Scales 16-bit values down: u8 = (u16 + 128) / 257
; img image: 16-bit source image
; returns out image: 8-bit image
u16-to-u8 = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * img.bands)
    out = image.new-from-data(img.width, img.height, img.bands, _d)
    out.depth = 1
    out.format = 0
    i <- [0..npix * img.bands): {
        lo = img.data[i * 2]
        hi = img.data[i * 2 + 1]
        u16 = lo | (hi << 8)
        out.data[i] = (u16 + 128) / 257
    }
}

; image.fill-u16: fill a 16-bit image with a value
; img image: 16-bit image (modified in place)
; v i64: value (0-65535)
fill-u16 = (img image, v i64) {
    {
        v < 0 -> v = 0
    }
    {
        v > 65535 -> v = 65535
    }
    n = img.width * img.height * img.bands
    i <- [0..n): {
        idx = i * 2
        img.data[idx] = v & 255
        img.data[idx + 1] = (v >> 8) & 255
    }
}

; image.invert-u16: invert all pixels of a 16-bit image
; img image: 16-bit image (modified in place)
invert-u16 = (img image) {
    n = img.width * img.height * img.bands
    i <- [0..n): {
        idx = i * 2
        lo = img.data[idx]
        hi = img.data[idx + 1]
        val = lo | (hi << 8)
        val = 65535 - val
        img.data[idx] = val & 255
        img.data[idx + 1] = (val >> 8) & 255
    }
}

; image.avg-u16: compute average pixel value for 16-bit image
; img image: 16-bit image
; returns avg i64: average value
avg-u16 = (img image) (avg i64) {
    n = img.width * img.height * img.bands
    sum = 0
    i <- [0..n): {
        idx = i * 2
        lo = img.data[idx]
        hi = img.data[idx + 1]
        sum = sum + (lo | (hi << 8))
    }
    {
        n == 0 -> return
    }
    avg = sum / n
}

; image.min-val-u16: compute minimum pixel value for 16-bit image
; img image: 16-bit image
; returns mn i64: minimum value
min-val-u16 = (img image) (mn i64) {
    mn = 65535
    n = img.width * img.height * img.bands
    i <- [0..n): {
        idx = i * 2
        lo = img.data[idx]
        hi = img.data[idx + 1]
        val = lo | (hi << 8)
        {
            val < mn -> mn = val
        }
    }
}

; image.max-val-u16: compute maximum pixel value for 16-bit image
; img image: 16-bit image
; returns mx i64: maximum value
max-val-u16 = (img image) (mx i64) {
    mx = 0
    n = img.width * img.height * img.bands
    i <- [0..n): {
        idx = i * 2
        lo = img.data[idx]
        hi = img.data[idx + 1]
        val = lo | (hi << 8)
        {
            val > mx -> mx = val
        }
    }
}
