; filter.no — Convolution filters: blur, sharpen, edge detect, emboss
; Inspired by libvips vips_conv / vips_gaussblur / vips_sharpen

; ── Generic convolution ──

; filter.convolve: apply a convolution kernel to image
; img image: input image
; kernel []i64: convolution kernel (square, ksize * ksize)
; ksize i64: kernel size (odd, e.g. 3, 5, 7)
; divisor i64: normalization divisor (sum of kernel elements, or 0 for auto)
; offset i64: value to add after normalization
; returns out image: filtered image

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.new-u16
# /noimg/src/image.copy
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

convolve = (img image, kernel []i64, ksize i64, divisor i64, offset i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    {
        ksize < 1 -> {
            out = image.copy(img)
            return
        }
    }
    half = ksize / 2
    div = divisor
    {
        div == 0 -> {
            div = 0
            i <- [0..ksize * ksize): {
                div = div + kernel[i]
            }
        }
    }
    div == 0 -> div = 1
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                sum = 0
                ky <- [0..ksize): {
                    kx <- [0..ksize): {
                        sx = x + kx - half
                        sy = y + ky - half
                        {
                            sx < 0 -> sx = 0

                            sx >= img.width -> sx = img.width - 1
                        }
                        {
                            sy < 0 -> sy = 0

                            sy >= img.height -> sy = img.height - 1
                        }
                        px = image.get-pixel(img, sx, sy, b)
                        sum = sum + px * kernel[ky * ksize + kx]
                    }
                }
                val = sum / div + offset
                val > max-v -> val = max-v
                val < 0 -> val = 0
                image.set-pixel(out, x, y, b, val)
            }
        }
    }
}

; ── Gaussian blur ──

; filter.gauss-blur: gaussian blur with adjustable sigma
; img image: input image
; sigma i64: blur radius (sigma * 10, e.g. 15 = 1.5)
; returns out image: blurred image
gauss-blur = (img image, sigma i64) (out image) {
    {
        sigma <= 0 -> {
            out = image.copy(img)
            return
        }
    }

    ; Compute kernel size from sigma
    ; ksize = 2 * ceil(3 * sigma) + 1
    ; sigma is sigma/10, so 3 * sigma/10 = 3*sigma/10
    radius = 3 * sigma / 10
    radius < 1 -> radius = 1
    ksize = radius * 2 + 1
    {
        ksize > 31 -> {
            ksize = 31
            radius = 15
        }
    }

    ; Build gaussian kernel
    kernel str = with-len(ksize * ksize)
    two-sigma2 = 2 * sigma * sigma / 100
    two-sigma2 == 0 -> two-sigma2 = 1
    sum = 0
    ky <- [0..ksize): {
        kx <- [0..ksize): {
            dx = kx - radius
            dy = ky - radius

            ; g = exp(-(dx^2 + dy^2) / (2 * sigma^2))
            ; Use integer approximation: exp(-r2 / two_sigma2) * 256
            r2 = dx * dx + dy * dy

            ; exp approximation using Taylor series: e^(-x) ~ 1 - x + x^2/2 - ...
            x = r2 * 100 / (two-sigma2 * 100)
            {
                x > 50 -> {
                    val = 0
                }

                -> {
                    val = 256
                    term = 256
                    j <- [1..20): {
                        term = term * (-x) / (j * 100)
                        val = val + term
                        term < 0 && term > -2 -> break
                        term > 0 && term < 2 -> break
                    }
                    val < 0 -> val = 0
                }
            }
            kernel[ky * ksize + kx] = val
            sum = sum + val
        }
    }
    out = filter.convolve(img, kernel, ksize, sum, 0)
}

; ── Box blur (fast) ──

; filter.box-blur: fast box blur (mean filter)
; img image: input image
; radius i64: blur radius
; returns out image: blurred image
box-blur = (img image, radius i64) (out image) {
    {
        radius <= 0 -> {
            out = image.copy(img)
            return
        }
    }
    ksize = radius * 2 + 1
    kernel str = with-len(ksize * ksize)
    n = ksize * ksize
    i <- [0..n): {
        kernel[i] = 1
    }
    out = filter.convolve(img, kernel, ksize, n, 0)
}

; ── Sharpen ──

; filter.sharpen: sharpen image using unsharp mask
; img image: input image
; sigma i64: blur sigma * 10
; amount i64: sharpen amount * 100
; returns out image: sharpened image
sharpen = (img image, sigma i64, amount i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    blurred = filter.gauss-blur(img, sigma)
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                pv = image.get-pixel(img, x, y, b)
                bv = image.get-pixel(blurred, x, y, b)
                diff = pv - bv
                val = pv + (diff * amount) / 100
                val > max-v -> val = max-v
                val < 0 -> val = 0
                image.set-pixel(out, x, y, b, val)
            }
        }
    }
}

; filter.sharpen-simple: simple Laplacian sharpen
; img image: input image
; returns out image: sharpened image
sharpen-simple = (img image) (out image) {

    ; Laplacian kernel:
    ;  0 -1  0
    ; -1  5 -1
    ;  0 -1  0
    kernel = [
        0, -1, 0, -1, 5, -1, 0, -1,
        0,
    ]
    out = filter.convolve(img, kernel, 3, 1, 0)
}

; ── Edge detection ──

; filter.sobel: Sobel edge detection
; img image: input image
; returns out image: edge image
sobel = (img image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    kx = [
        -1, 0, 1, -2, 0, 2, -1, 0,
        1,
    ]
    ky = [
        -1, -2, -1, 0, 0, 0, 1, 2,
        1,
    ]
    gx = filter.convolve(img, kx, 3, 1, 0)
    gy = filter.convolve(img, ky, 3, 1, 0)
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                ax = image.get-pixel(gx, x, y, b)
                ay = image.get-pixel(gy, x, y, b)
                sum = ax * ax + ay * ay
                val = sum / 4
                val > max-v -> val = max-v
                val < 0 -> val = 0
                image.set-pixel(out, x, y, b, val)
            }
        }
    }
}

; filter.laplacian: Laplacian edge detection
; img image: input image
; returns out image: edge image
laplacian = (img image) (out image) {
    kernel = [
        0, 1, 0, 1, -4, 1, 0, 1,
        0,
    ]
    out = filter.convolve(img, kernel, 3, 1, 128)
}

; ── Emboss ──

; filter.emboss: emboss filter
; img image: input image
; returns out image: embossed image
emboss = (img image) (out image) {
    kernel = [
        -2, -1, 0, -1, 1, 1, 0, 1,
        2,
    ]
    out = filter.convolve(img, kernel, 3, 1, 0)
}

; ── Median filter ──

; filter.median: median filter (noise removal)
; img image: input image
; radius i64: filter radius (1 = 3x3, 2 = 5x5)
; returns out image: filtered image
median = (img image, radius i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    {
        radius <= 0 -> {
            out = image.copy(img)
            return
        }
    }
    ksize = radius * 2 + 1
    buf-len = ksize * ksize
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                buf str = with-len(buf-len)
                cnt = 0
                ky <- [0..ksize): {
                    kx <- [0..ksize): {
                        sx = x + kx - radius
                        sy = y + ky - radius
                        {
                            sx < 0 -> sx = 0

                            sx >= img.width -> sx = img.width - 1
                        }
                        {
                            sy < 0 -> sy = 0

                            sy >= img.height -> sy = img.height - 1
                        }
                        buf[cnt] = image.get-pixel(img, sx, sy, b)
                        cnt = cnt + 1
                    }
                }

                i <- [1..buf-len): {
                    key = buf[i]
                    j = i - 1
                    {
                        j < 0 -> break
                        buf[j] > key -> {
                            buf[j + 1] = buf[j]
                            j = j - 1
                        }
                        -> break
                    } (true)
                    j + 1 >= 0 -> buf[j + 1] = key
                }
                image.set-pixel(out, x, y, b, buf[buf-len / 2])
            }
        }
    }
}

; ── Noise ──

; filter.add-noise: add random noise to image
; img image: input image
; amount i64: noise amount (0-255)
; returns out image: noisy image
add-noise = (img image, amount i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            out = image.copy(img)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        seed = os.now-ns() + i * 6364136223846793005
        r = (seed >> 16) & 255
        noise = (r * amount) / 255 - amount / 2
        b <- [0..img.bands): {
            v = image.get-pixel(img, px, py, b) + noise
            v > max-v -> v = max-v
            v < 0 -> v = 0
            image.set-pixel(out, px, py, b, v)
        }
    }
}

; ── Oil painting ──

; filter.oil-paint: oil painting effect
; img image: input image
; radius i64: filter radius
; levels i64: number of intensity levels
; returns out image: stylized image
oil-paint = (img image, radius i64, levels i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    {
        radius <= 0 -> radius = 1

        levels <= 0 -> levels = 32

        levels > 256 -> levels = 256
    }
    ksize = radius * 2 + 1
    hist str = with-len(256)
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {

                i <- [0..256): {
                    hist[i] = 0
                }

                ky <- [0..ksize): {
                    kx <- [0..ksize): {
                        sx = x + kx - radius
                        sy = y + ky - radius
                        {
                            sx < 0 -> sx = 0

                            sx >= img.width -> sx = img.width - 1
                        }
                        {
                            sy < 0 -> sy = 0

                            sy >= img.height -> sy = img.height - 1
                        }
                        v = image.get-pixel(img, sx, sy, b)
                        lvl = v * levels / (max-v + 1)
                        hist[lvl] = hist[lvl] + 1
                    }
                }

                max-count = 0
                max-lvl = 0
                i <- [0..levels): {
                    hist[i] > max-count -> {
                        max-count = hist[i]
                        max-lvl = i
                    }
                }

                val = max-lvl * (max-v + 1) / levels + (max-v + 1) / levels / 2
                val > max-v -> val = max-v
                val < 0 -> val = 0
                image.set-pixel(out, x, y, b, val)
            }
        }
    }
}

; ── Separable Gaussian blur (optimized: O(n*r) instead of O(n*r^2)) ──

; filter.gauss-blur-separable: fast Gaussian blur using separable kernel
; Applies a 1D horizontal blur, then a 1D vertical blur for O(2*r) per pixel.
; img image: input image
; sigma i64: blur radius (sigma * 10, e.g. 15 = 1.5)
; returns out image: blurred image
gauss-blur-separable = (img image, sigma i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    {
        sigma <= 0 -> {
            out = image.copy(img)
            return
        }
    }

    radius = 3 * sigma / 10
    radius < 1 -> radius = 1
    {
        radius > 31 -> {
            radius = 31
        }
    }
    ksize = radius * 2 + 1

    kernel str = with-len(ksize)
    two-sigma2 = 2 * sigma * sigma / 100
    two-sigma2 == 0 -> two-sigma2 = 1
    sum = 0
    i <- [0..ksize): {
        dx = i - radius
        r2 = dx * dx
        x = r2 * 100 / (two-sigma2 * 100)
        {
            x > 50 -> {
                kernel[i] = 0
            }

            -> {
                val = 256
                term = 256
                j <- [1..20): {
                    term = term * (-x) / (j * 100)
                    val = val + term
                    term < 0 && term > -2 -> break
                    term > 0 && term < 2 -> break
                }
                val < 0 -> val = 0
                kernel[i] = val
            }
        }
        sum = sum + kernel[i]
    }
    sum == 0 -> sum = 1

    _tmp str = with-len(img.width * img.height * img.bands)
    tmp = image.new-from-data(img.width, img.height, img.bands, _tmp)
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                acc = 0
                k <- [0..ksize): {
                    sx = x + k - radius
                    {
                        sx < 0 -> sx = 0
                        sx >= img.width -> sx = img.width - 1
                    }
                    acc = acc + image.get-pixel(img, sx, y, b) * kernel[k]
                }
                v = acc / sum
                v > max-v -> v = max-v
                v < 0 -> v = 0
                image.set-pixel(tmp, x, y, b, v)
            }
        }
    }

    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                acc = 0
                k <- [0..ksize): {
                    sy = y + k - radius
                    {
                        sy < 0 -> sy = 0
                        sy >= img.height -> sy = img.height - 1
                    }
                    acc = acc + image.get-pixel(tmp, x, sy, b) * kernel[k]
                }
                v = acc / sum
                v > max-v -> v = max-v
                v < 0 -> v = 0
                image.set-pixel(out, x, y, b, v)
            }
        }
    }
}

; ── Morphological operations ──

; filter.dilate: morphological dilation (max filter)
; Expands bright regions — good for thickening edges/features
; img image: input image
; radius i64: filter radius (1 = 3x3, 2 = 5x5)
; returns out image: dilated image
dilate = (img image, radius i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    {
        radius <= 0 -> {
            out = image.copy(img)
            return
        }
    }
    ksize = radius * 2 + 1
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                mx = 0
                ky <- [0..ksize): {
                    kx <- [0..ksize): {
                        sx = x + kx - radius
                        sy = y + ky - radius
                        {
                            sx < 0 -> sx = 0
                            sx >= img.width -> sx = img.width - 1
                        }
                        {
                            sy < 0 -> sy = 0
                            sy >= img.height -> sy = img.height - 1
                        }
                        v = image.get-pixel(img, sx, sy, b)
                        v > mx -> mx = v
                    }
                }
                image.set-pixel(out, x, y, b, mx)
            }
        }
    }
}

; filter.erode: morphological erosion (min filter)
; Shrinks bright regions — good for thinning features
; img image: input image
; radius i64: filter radius (1 = 3x3, 2 = 5x5)
; returns out image: eroded image
erode = (img image, radius i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    {
        radius <= 0 -> {
            out = image.copy(img)
            return
        }
    }
    ksize = radius * 2 + 1
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                mn = max-v
                ky <- [0..ksize): {
                    kx <- [0..ksize): {
                        sx = x + kx - radius
                        sy = y + ky - radius
                        {
                            sx < 0 -> sx = 0
                            sx >= img.width -> sx = img.width - 1
                        }
                        {
                            sy < 0 -> sy = 0
                            sy >= img.height -> sy = img.height - 1
                        }
                        v = image.get-pixel(img, sx, sy, b)
                        v < mn -> mn = v
                    }
                }
                image.set-pixel(out, x, y, b, mn)
            }
        }
    }
}

; filter.gradient: morphological gradient (dilate - erode)
; Highlights edges by computing the difference between dilation and erosion
; img image: input image
; radius i64: filter radius
; returns out image: gradient image
gradient = (img image, radius i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    dl = filter.dilate(img, radius)
    e = filter.erode(img, radius)
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                v = image.get-pixel(dl, x, y, b) - image.get-pixel(e, x, y, b)
                v < 0 -> v = 0
                v > max-v -> v = max-v
                image.set-pixel(out, x, y, b, v)
            }
        }
    }
}

; ── Unsharp mask (improved sharpen) ──

; filter.unsharp-mask: unsharp mask sharpening with explicit sigma and amount
; img image: input image
; sigma i64: blur sigma * 10
; amount i64: sharpen amount * 100
; threshold i64: threshold for applying sharpening (0 = all pixels)
; returns out image: sharpened image
unsharp-mask = (img image, sigma i64, amount i64, threshold i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * img.bands)
            out = image.new-from-data(img.width, img.height, img.bands, _d)
        }
    }
    blurred = filter.gauss-blur-separable(img, sigma)
    y <- [0..img.height): {
        x <- [0..img.width): {
            b <- [0..img.bands): {
                pv = image.get-pixel(img, x, y, b)
                bv = image.get-pixel(blurred, x, y, b)
                diff = pv - bv
                {
                    diff < 0 -> diff = -diff
                }
                {
                    diff >= threshold -> {
                        val = pv + (pv - bv) * amount / 100
                    }

                    -> {
                        val = pv
                    }
                }
                val > max-v -> val = max-v
                val < 0 -> val = 0
                image.set-pixel(out, x, y, b, val)
            }
        }
    }
}

; ── Vignette ──

; filter.vignette: apply a vignette effect (darken corners)
; img image: input image
; strength i64: vignette strength (0-100, percentage)
; returns out image: vignetted image
vignette = (img image, strength i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            out = image.copy(img)
        }
    }
    npix = img.width * img.height
    cx = img.width / 2
    cy = img.height / 2
    max-dist = cx * cx + cy * cy
    max-dist == 0 -> max-dist = 1
    s = strength
    s > 100 -> s = 100
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        dx = px - cx
        dy = py - cy
        dist2 = dx * dx + dy * dy
        factor = max-v - dist2 * s / (max-dist * 100 / max-v)
        factor < 0 -> factor = 0
        b <- [0..img.bands): {
            v = image.get-pixel(img, px, py, b) * factor / max-v
            v > max-v -> v = max-v
            v < 0 -> v = 0
            image.set-pixel(out, px, py, b, v)
        }
    }
}
