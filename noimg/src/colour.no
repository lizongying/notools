; colour.no — Color space conversions
; Implements RGB <-> sRGB <-> Grayscale <-> HSV/HSL conversions
; Inspired by libvips colour operations

; ── RGB <-> Grayscale ──

; colour.rgb2gray: convert RGB image to grayscale
; img image: input RGB image
; returns out image: grayscale (1-band) image

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.new-u16
# /noimg/src/image.copy
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

rgb2gray = (img image) (out image) {
    {
        img.bands >= 3 -> {
            d = img.depth
            {
                d == 0 -> d = 1
            }
            max-v = 255
            {
                d == 2 -> {
                    _d str = with-len(img.width * img.height * 2)
                    out = image.new-u16(img.width, img.height, 1)
                    max-v = 65535
                }

                -> {
                    _d str = with-len(img.width * img.height)
                    out = image.new-from-data(img.width, img.height, 1, _d)
                }
            }
            npix = img.width * img.height
            i <- [0..npix): {
                px = i % img.width
                py = i / img.width
                r = image.get-pixel(img, px, py, 0)
                g = image.get-pixel(img, px, py, 1)
                b = image.get-pixel(img, px, py, 2)
                v = (r * 299 + g * 587 + b * 114) / 1000
                v > max-v -> v = max-v
                v < 0 -> v = 0
                image.set-pixel(out, px, py, 0, v)
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; colour.gray2rgb: convert grayscale to RGB
; img image: grayscale image
; returns out image: RGB image
gray2rgb = (img image) (out image) {
    {
        img.bands == 1 -> {
            d = img.depth
            {
                d == 0 -> d = 1
            }
            max-v = 255
            {
                d == 2 -> {
                    out = image.new-u16(img.width, img.height, 3)
                    max-v = 65535
                }

                -> {
                    _d str = with-len(img.width * img.height * 3)
                    out = image.new-from-data(img.width, img.height, 3, _d)
                }
            }
            npix = img.width * img.height
            i <- [0..npix): {
                px = i % img.width
                py = i / img.width
                v = image.get-pixel(img, px, py, 0)
                image.set-pixel(out, px, py, 0, v)
                image.set-pixel(out, px, py, 1, v)
                image.set-pixel(out, px, py, 2, v)
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; ── RGB <-> HSV ──

; colour.rgb2hsv: convert RGB to HSV
; img image: RGB image
; returns out image: HSV image (H: 0-255, S: 0-255, V: 0-255)
rgb2hsv = (img image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, 3)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        r = image.get-pixel(img, px, py, 0)
        g = image.get-pixel(img, px, py, 1)
        b = image.get-pixel(img, px, py, 2)
        h = 0
        s = 0
        v = 0
        mx = r
        mx < g -> mx = g
        mx < b -> mx = b
        mn = r
        mn > g -> mn = g
        mn > b -> mn = b
        delta = mx - mn
        v = mx
        {
            mx == 0 -> {
                s = 0
            }

            -> {
                s = (delta * max-v) / mx
            }
        }
        delta == 0 -> {
            h = 0
        }
        mx == r -> {
            h = (g - b) * max-v / (delta)
            h < 0 -> h = h + max-v
        }
        mx == g -> {
            h = max-v / 3 + (b - r) * max-v / (delta)
        }
        mx == b -> {
            h = 2 * max-v / 3 + (r - g) * max-v / (delta)
        }
        image.set-pixel(out, px, py, 0, h)
        image.set-pixel(out, px, py, 1, s)
        image.set-pixel(out, px, py, 2, v)
    }
}

; colour.hsv2rgb: convert HSV to RGB
; img image: HSV image
; returns out image: RGB image
hsv2rgb = (img image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, 3)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        h = image.get-pixel(img, px, py, 0)
        s = image.get-pixel(img, px, py, 1)
        v = image.get-pixel(img, px, py, 2)
        r = 0
        g = 0
        b = 0
        {
            s == 0 -> {
                r = v
                g = v
                b = v
            }

            -> {
                hi = h * 6 / (max-v + 1)
                f = (h * 6 - hi * (max-v + 1)) / (max-v + 1)
                p = v * (max-v - s) / max-v
                q = v * (max-v - (s * f) / max-v) / max-v
                t = v * (max-v - (s * (max-v - f)) / max-v) / max-v
                {
                    hi == 0 -> {
                        r = v
                        g = t
                        b = p
                    }

                    hi == 1 -> {
                        r = q
                        g = v
                        b = p
                    }

                    hi == 2 -> {
                        r = p
                        g = v
                        b = t
                    }

                    hi == 3 -> {
                        r = p
                        g = q
                        b = v
                    }

                    hi == 4 -> {
                        r = t
                        g = p
                        b = v
                    }

                    -> {
                        r = v
                        g = p
                        b = q
                    }
                }
            }
        }

        image.set-pixel(out, px, py, 0, r)
        image.set-pixel(out, px, py, 1, g)
        image.set-pixel(out, px, py, 2, b)
    }
}

; ── RGB <-> HSL ──

; colour.rgb2hsl: convert RGB to HSL
; img image: RGB image
; returns out image: HSL image
rgb2hsl = (img image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, 3)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        r = image.get-pixel(img, px, py, 0)
        g = image.get-pixel(img, px, py, 1)
        b = image.get-pixel(img, px, py, 2)
        h = 0
        s = 0
        l = 0
        mx = r
        mx < g -> mx = g
        mx < b -> mx = b
        mn = r
        mn > g -> mn = g
        mn > b -> mn = b
        l = (mx + mn) / 2
        delta = mx - mn
        {
            delta == 0 -> {
                h = 0
                s = 0
            }

            -> {
                {
                    l < max-v / 2 -> {
                        s = delta * max-v / (mx + mn)
                    }

                    -> {
                        sum = 2 * max-v - mx - mn
                        sum == 0 -> {
                            s = 0
                        }

                        -> {
                            s = delta * max-v / sum
                        }
                    }
                }
                mx == r -> {
                    h = (g - b) * max-v / delta
                    h < 0 -> h = h + max-v
                }
                mx == g -> {
                    h = max-v / 3 + (b - r) * max-v / delta
                }
                mx == b -> {
                    h = 2 * max-v / 3 + (r - g) * max-v / delta
                }
            }
        }
        image.set-pixel(out, px, py, 0, h)
        image.set-pixel(out, px, py, 1, s)
        image.set-pixel(out, px, py, 2, l)
    }
}

; colour.hsl2rgb: convert HSL to RGB
; img image: HSL image (H: 0-255, S: 0-255, L: 0-255)
; returns out image: RGB image
hsl2rgb = (img image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, 3)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
        }
    }
    half-v = max-v / 2
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        h = image.get-pixel(img, px, py, 0)
        s = image.get-pixel(img, px, py, 1)
        l = image.get-pixel(img, px, py, 2)
        r = 0
        g = 0
        b = 0
        {
            s == 0 -> {
                r = l
                g = l
                b = l
            }

            -> {
                q = 0
                {
                    l < half-v -> {
                        q = l * (max-v + s) / max-v
                    }

                    -> {
                        q = l + s - l * s / max-v
                    }
                }
                p = 2 * l - q
                hk = h * 6 / (max-v + 1)
                tc = h * 6 - hk * (max-v + 1)
                {
                    hk == 0 -> {
                        r = q
                        g = p + (q - p) * tc / max-v
                        b = p
                    }

                    hk == 1 -> {
                        r = p + (q - p) * (max-v - tc) / max-v
                        g = q
                        b = p
                    }

                    hk == 2 -> {
                        r = p
                        g = q
                        b = p + (q - p) * tc / max-v
                    }

                    hk == 3 -> {
                        r = p
                        g = p + (q - p) * (max-v - tc) / max-v
                        b = q
                    }

                    hk == 4 -> {
                        r = p + (q - p) * tc / max-v
                        g = p
                        b = q
                    }

                    -> {
                        r = q
                        g = p
                        b = p + (q - p) * (max-v - tc) / max-v
                    }
                }
            }
        }
        {
            r < 0 -> r = 0
            r > max-v -> r = max-v
        }
        {
            g < 0 -> g = 0
            g > max-v -> g = max-v
        }
        {
            b < 0 -> b = 0
            b > max-v -> b = max-v
        }
        image.set-pixel(out, px, py, 0, r)
        image.set-pixel(out, px, py, 1, g)
        image.set-pixel(out, px, py, 2, b)
    }
}

; ── RGB <-> YCbCr ──

; colour.rgb2ycbcr: convert RGB to YCbCr (JPEG JFIF)
; img image: RGB image
; returns out image: YCbCr image
rgb2ycbcr = (img image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, 3)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
        }
    }
    half-v = max-v / 2
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        r = image.get-pixel(img, px, py, 0)
        g = image.get-pixel(img, px, py, 1)
        b = image.get-pixel(img, px, py, 2)
        y = (r * 77 + g * 150 + b * 29) >> 8
        cb = ((b - y) * half-v) / max-v + half-v
        cr = ((r - y) * half-v) / max-v + half-v
        {
            y < 0 -> y = 0
            y > max-v -> y = max-v
        }
        {
            cb < 0 -> cb = 0
            cb > max-v -> cb = max-v
        }
        {
            cr < 0 -> cr = 0
            cr > max-v -> cr = max-v
        }
        image.set-pixel(out, px, py, 0, y)
        image.set-pixel(out, px, py, 1, cb)
        image.set-pixel(out, px, py, 2, cr)
    }
}

; colour.ycbcr2rgb: convert YCbCr to RGB
; img image: YCbCr image
; returns out image: RGB image
ycbcr2rgb = (img image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, 3)
            max-v = 65535
        }

        -> {
            _d str = with-len(img.width * img.height * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
        }
    }
    half-v = max-v / 2
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        y = image.get-pixel(img, px, py, 0)
        cb = image.get-pixel(img, px, py, 1)
        cr = image.get-pixel(img, px, py, 2)
        r = y + (cr * max-v) / half-v
        b = y + (cb * max-v) / half-v
        g = (y * max-v - r * 77 - b * 29) / 150
        {
            r < 0 -> r = 0
            r > max-v -> r = max-v
        }
        {
            g < 0 -> g = 0
            g > max-v -> g = max-v
        }
        {
            b < 0 -> b = 0
            b > max-v -> b = max-v
        }
        image.set-pixel(out, px, py, 0, r)
        image.set-pixel(out, px, py, 1, g)
        image.set-pixel(out, px, py, 2, b)
    }
}

; ── Threshold / Binarize ──

; colour.threshold: binary threshold on grayscale or RGB
; img image: input image
; t i64: threshold value
; returns out image: binary (0 or 255) image
threshold = (img image, t i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            out = image.copy(img)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        b <- [0..img.bands): {
            v = image.get-pixel(img, px, py, b)
            {
                v >= t -> {
                    image.set-pixel(out, px, py, b, max-v)
                }

                -> {
                    image.set-pixel(out, px, py, b, 0)
                }
            }
        }
    }
}

; colour.otsu-threshold: compute Otsu's threshold
; img image: input image
; returns t i64: computed threshold
otsu-threshold = (img image) (t i64) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> max-v = 65535
    }
    hist-len = max-v + 1
    hist str = with-len(hist-len)
    i <- [0..hist-len): {
        hist[i] = 0
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        b <- [0..img.bands): {
            v = image.get-pixel(img, px, py, b)
            v >= hist-len -> v = hist-len - 1
            hist[v] = hist[v] + 1
        }
    }
    total = npix * img.bands
    sum = 0
    i <- [0..hist-len): {
        sum = sum + i * hist[i]
    }
    sum-b = 0
    w-b = 0
    max-var = 0
    t = 0
    i <- [0..hist-len): {
        w-b = w-b + hist[i]
        {
            w-b == 0 -> {
                i <- [0..0): {
                }
            }
        }
        w-f = total - w-b
        w-f == 0 -> break
        sum-b = sum-b + i * hist[i]
        m-b = sum-b / w-b
        m-f = (sum - sum-b) / w-f
        var = w-b * w-f * (m-b - m-f) * (m-b - m-f)
        var > max-var -> {
            max-var = var
            t = i
        }
    }
}

; ── Brightness / Contrast / Gamma ──

; colour.brightness: adjust brightness
; img image: input image
; b i64: brightness adjustment (-255 to 255)
; returns out image: adjusted image
brightness = (img image, b i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            out = image.copy(img)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        band <- [0..img.bands): {
            v = image.get-pixel(img, px, py, band) + b
            v > max-v -> v = max-v
            v < 0 -> v = 0
            image.set-pixel(out, px, py, band, v)
        }
    }
}

; colour.contrast: adjust contrast
; img image: input image
; c i64: contrast factor (-100 to 100, percentage)
; returns out image: adjusted image
contrast = (img image, c i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    half-v = 128
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
            half-v = max-v / 2
        }

        -> {
            out = image.copy(img)
        }
    }
    factor = (259 * (c + max-v)) / (max-v * (259 - c))
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        band <- [0..img.bands): {
            v = factor * (image.get-pixel(img, px, py, band) - half-v) + half-v
            v > max-v -> v = max-v
            v < 0 -> v = 0
            image.set-pixel(out, px, py, band, v)
        }
    }
}

; colour.gamma: apply gamma correction
; img image: input image
; g i64: gamma * 100 (e.g. 220 = 2.2)
; returns out image: corrected image
gamma = (img image, g i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            out = image.copy(img)
        }
    }
    g == 0 -> return
    lut-len = max-v + 1
    lut str = with-len(lut-len)
    i <- [0..lut-len): {
        norm = i * 1000 / max-v
        result = 0
        {
            g == 100 -> {
                result = i
            }

            g > 100 -> {
                exp = g - 100
                tmp = norm
                j <- [0..exp / 10): {
                    tmp = tmp * norm / 1000
                }
                result = tmp * max-v / 1000
            }

            -> {
                exp = 100 - g
                tmp = norm
                j <- [0..exp / 10): {
                    tmp = (tmp * 1000) / (norm > 0 ? norm : 1)
                }
                result = tmp * max-v / 1000
            }
        }
        result > max-v -> result = max-v
        result < 0 -> result = 0
        lut[i] = result
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        band <- [0..img.bands): {
            v = image.get-pixel(img, px, py, band)
            {
                v >= lut-len -> v = lut-len - 1
            }
            image.set-pixel(out, px, py, band, lut[v])
        }
    }
}

; ── Posterize ──

; colour.posterize: reduce the number of color levels
; img image: input image
; levels i64: number of levels per channel (2-256)
; returns out image: posterized image
posterize = (img image, levels i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            out = image.copy(img)
        }
    }
    {
        levels <= 0 -> return
    }
    step = (max-v + 1) / levels
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        band <- [0..img.bands): {
            v = image.get-pixel(img, px, py, band)
            v = (v / step) * step + step / 2
            v > max-v -> v = max-v
            v < 0 -> v = 0
            image.set-pixel(out, px, py, band, v)
        }
    }
}

; ── Solarize ──

; colour.solarize: invert pixels above threshold
; img image: input image
; t i64: threshold
; returns out image: solarized image
solarize = (img image, t i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
        }

        -> {
            out = image.copy(img)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        band <- [0..img.bands): {
            v = image.get-pixel(img, px, py, band)
            {
                v >= t -> {
                    v = max-v - v
                }
            }
            image.set-pixel(out, px, py, band, v)
        }
    }
}

; ── Overlay blend mode ──

; colour.overlay: apply overlay blend mode (hard light)
; img image: base image
; overlay image: overlay image
; returns out image: blended image
overlay-blend = (img image, overlay image) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    half-v = 128
    {
        d == 2 -> {
            out = image.new-u16(img.width, img.height, img.bands)
            max-v = 65535
            half-v = max-v / 2
        }

        -> {
            out = image.copy(img)
        }
    }
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        band <- [0..img.bands): {
            bv = image.get-pixel(img, px, py, band)
            {
                band < overlay.bands -> {
                    ov = image.get-pixel(overlay, px, py, band)
                    {
                        bv < half-v -> {
                            v = 2 * bv * ov / max-v
                        }

                        -> {
                            v = max-v - 2 * (max-v - bv) * (max-v - ov) / max-v
                        }
                    }
                    image.set-pixel(out, px, py, band, v)
                }
            }
        }
    }
}

; ── Adjust HSV ──

; colour.adjust-hsv: adjust hue, saturation, and value
; img image: input RGB image
; hue-shift i64: hue shift in degrees (0-255 range, e.g. 43 = ~60 degrees)
; sat-shift i64: saturation adjustment (-255 to 255, added to S)
; val-shift i64: value/brightness adjustment (-255 to 255, added to V)
; returns out image: adjusted RGB image
adjust-hsv = (img image, hue-shift i64, sat-shift i64, val-shift i64) (out image) {
    d = img.depth
    {
        d == 0 -> d = 1
    }
    max-v = 255
    {
        d == 2 -> max-v = 65535
    }
    hsv = colour.rgb2hsv(img)
    npix = img.width * img.height
    i <- [0..npix): {
        px = i % img.width
        py = i / img.width
        h = image.get-pixel(hsv, px, py, 0)
        s = image.get-pixel(hsv, px, py, 1)
        v = image.get-pixel(hsv, px, py, 2)
        h = h + hue-shift
        h >= max-v -> h = h - max-v
        h < 0 -> h = h + max-v
        s = s + sat-shift
        s > max-v -> s = max-v
        s < 0 -> s = 0
        v = v + val-shift
        v > max-v -> v = max-v
        v < 0 -> v = 0
        image.set-pixel(hsv, px, py, 0, h)
        image.set-pixel(hsv, px, py, 1, s)
        image.set-pixel(hsv, px, py, 2, v)
    }
    out = colour.hsv2rgb(hsv)
}

; ── Sepia tone ──

; colour.sepia: apply sepia tone effect
; img image: input image
; returns out image: sepia-toned image
sepia = (img image) (out image) {
    {
        img.bands >= 3 -> {
            d = img.depth
            {
                d == 0 -> d = 1
            }
            max-v = 255
            {
                d == 2 -> {
                    out = image.new-u16(img.width, img.height, 3)
                    max-v = 65535
                }

                -> {
                    _d str = with-len(img.width * img.height * 3)
                    out = image.new-from-data(img.width, img.height, 3, _d)
                }
            }
            npix = img.width * img.height
            i <- [0..npix): {
                px = i % img.width
                py = i / img.width
                r = image.get-pixel(img, px, py, 0)
                g = image.get-pixel(img, px, py, 1)
                b = image.get-pixel(img, px, py, 2)
                rr = (r * 393 + g * 769 + b * 189) / 1000
                gg = (r * 349 + g * 686 + b * 168) / 1000
                bb = (r * 272 + g * 534 + b * 131) / 1000
                rr > max-v -> rr = max-v
                gg > max-v -> gg = max-v
                bb > max-v -> bb = max-v
                image.set-pixel(out, px, py, 0, rr)
                image.set-pixel(out, px, py, 1, gg)
                image.set-pixel(out, px, py, 2, bb)
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; ── RGB <-> Lab ──

; colour.rgb2lab: convert RGB image to CIE Lab color space
; Uses sRGB -> linear RGB -> XYZ -> Lab pipeline with D65 illuminant
; img image: input RGB image (3+ bands)
; returns out image: Lab image (3-band, L: 0-255, a: 0-255, b: 0-255)
rgb2lab = (img image) (out image) {
    {
        img.bands >= 3 -> {
            d = img.depth
            {
                d == 0 -> d = 1
            }
            max-v = 255
            {
                d == 2 -> {
                    out = image.new-u16(img.width, img.height, 3)
                    max-v = 65535
                }

                -> {
                    _d str = with-len(img.width * img.height * 3)
                    out = image.new-from-data(img.width, img.height, 3, _d)
                }
            }
            npix = img.width * img.height
            i <- [0..npix): {
                px = i % img.width
                py = i / img.width
                r = image.get-pixel(img, px, py, 0)
                g = image.get-pixel(img, px, py, 1)
                b = image.get-pixel(img, px, py, 2)

                rf = r * 1000 / max-v
                gf = g * 1000 / max-v
                bf = b * 1000 / max-v

                {
                    rf <= 4045 -> {
                        rl = rf * 1000 / 12920
                    }
                    -> {
                        rl = rf * rf / 1000
                        rl = rl * 1000 / 1055
                    }
                }
                {
                    gf <= 4045 -> {
                        gl = gf * 1000 / 12920
                    }
                    -> {
                        gl = gf * gf / 1000
                        gl = gl * 1000 / 1055
                    }
                }
                {
                    bf <= 4045 -> {
                        bl = bf * 1000 / 12920
                    }
                    -> {
                        bl = bf * bf / 1000
                        bl = bl * 1000 / 1055
                    }
                }

                xn = (4124 * rl + 3576 * gl + 1805 * bl) / 10000000
                yn = (2126 * rl + 7152 * gl + 722 * bl) / 10000000
                zn = (193 * rl + 1192 * gl + 9505 * bl) / 10000000

                ; Normalize by D65 white point
                fx = xn * 1000 / 950
                fy = yn
                fz = zn * 1000 / 1089

                ; f(t) = t^(1/3) if t > 0.008856 else 7.787*t + 16/116
                {
                    fx > 8856 -> {
                        x0 = fx / 20000 + 10
                        x1 = (2 * x0 * 1000 + fx * 1000 / x0 * 1000 / x0) / 3
                        x1 = x1 / 1000
                        fx = x1
                    }
                    -> {
                        fx = 7787 * fx / 1000 + 4000 / 2900
                    }
                }
                {
                    fy > 8856 -> {
                        y0 = fy / 20000 + 10
                        y1 = (2 * y0 * 1000 + fy * 1000 / y0 * 1000 / y0) / 3
                        y1 = y1 / 1000
                        fy = y1
                    }
                    -> {
                        fy = 7787 * fy / 1000 + 4000 / 2900
                    }
                }
                {
                    fz > 8856 -> {
                        z0 = fz / 20000 + 10
                        z1 = (2 * z0 * 1000 + fz * 1000 / z0 * 1000 / z0) / 3
                        z1 = z1 / 1000
                        fz = z1
                    }
                    -> {
                        fz = 7787 * fz / 1000 + 4000 / 2900
                    }
                }

                l = 116 * fy / 1000 - 16
                av = 500 * (fx - fy) / 1000
                bv = 200 * (fy - fz) / 1000

                l = l * max-v / 100
                l < 0 -> l = 0
                l > max-v -> l = max-v
                av = av + max-v / 2
                av < 0 -> av = 0
                av > max-v -> av = max-v
                bv = bv + max-v / 2
                bv < 0 -> bv = 0
                bv > max-v -> bv = max-v

                image.set-pixel(out, px, py, 0, l)
                image.set-pixel(out, px, py, 1, av)
                image.set-pixel(out, px, py, 2, bv)
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; colour.lab2rgb: convert Lab image to RGB
; img image: Lab image (3-band)
; returns out image: RGB image (3-band)
lab2rgb = (img image) (out image) {
    {
        img.bands >= 3 -> {
            d = img.depth
            {
                d == 0 -> d = 1
            }
            max-v = 255
            {
                d == 2 -> {
                    out = image.new-u16(img.width, img.height, 3)
                    max-v = 65535
                }

                -> {
                    _d str = with-len(img.width * img.height * 3)
                    out = image.new-from-data(img.width, img.height, 3, _d)
                }
            }
            half-v = max-v / 2
            npix = img.width * img.height
            i <- [0..npix): {
                px = i % img.width
                py = i / img.width
                l = image.get-pixel(img, px, py, 0) * 100 / max-v
                av = image.get-pixel(img, px, py, 1) - half-v
                bv = image.get-pixel(img, px, py, 2) - half-v

                fy = (l + 16) * 1000 / 116
                fx = fy + av * 1000 / 500
                fz = fy - bv * 1000 / 200

                {
                    fx > 20690 -> {
                        xn = fx * fx / 1000000 * fx / 1000
                        xn = xn * 950 / 1000
                    }
                    -> {
                        xn = 3 * 7150 * (fx - 6900) / 10000000
                        xn = xn * 950 / 1000
                    }
                }
                {
                    fy > 20690 -> {
                        yn = fy * fy / 1000000 * fy / 1000
                    }
                    -> {
                        yn = 3 * 7150 * (fy - 6900) / 10000000
                    }
                }
                {
                    fz > 20690 -> {
                        zn = fz * fz / 1000000 * fz / 1000
                        zn = zn * 1089 / 1000
                    }
                    -> {
                        zn = 3 * 7150 * (fz - 6900) / 10000000
                        zn = zn * 1089 / 1000
                    }
                }

                rl = (32406 * xn - 15372 * yn - 4986 * zn) / 10000
                gl = (-9689 * xn + 18758 * yn + 415 * zn) / 10000
                bl = (557 * xn - 2040 * yn + 10570 * zn) / 10000

                {
                    rl <= 31308 -> {
                        r = 1292 * rl / 100000
                    }
                    -> {
                        r0 = rl / 200 + 50
                        r1 = (r0 + rl / r0) / 2
                        r = 1055 * r1 / 1000 * r1 / 1000 - 55
                    }
                }
                {
                    gl <= 31308 -> {
                        g = 1292 * gl / 100000
                    }
                    -> {
                        g0 = gl / 200 + 50
                        g1 = (g0 + gl / g0) / 2
                        g = 1055 * g1 / 1000 * g1 / 1000 - 55
                    }
                }
                {
                    bl <= 31308 -> {
                        b = 1292 * bl / 100000
                    }
                    -> {
                        b0 = bl / 200 + 50
                        b1 = (b0 + bl / b0) / 2
                        b = 1055 * b1 / 1000 * b1 / 1000 - 55
                    }
                }

                r = r * max-v / 1000
                g = g * max-v / 1000
                b = b * max-v / 1000
                r < 0 -> r = 0
                r > max-v -> r = max-v
                g < 0 -> g = 0
                g > max-v -> g = max-v
                b < 0 -> b = 0
                b > max-v -> b = max-v

                image.set-pixel(out, px, py, 0, r)
                image.set-pixel(out, px, py, 1, g)
                image.set-pixel(out, px, py, 2, b)
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; ── RGB <-> CMYK ──

; colour.rgb2cmyk: convert RGB to CMYK
; Uses simple subtractive model: K = max(R,G,B) inverted
; img image: input RGB image
; returns out image: CMYK image (4-band)
rgb2cmyk = (img image) (out image) {
    {
        img.bands >= 3 -> {
            d = img.depth
            {
                d == 0 -> d = 1
            }
            max-v = 255
            {
                d == 2 -> {
                    out = image.new-u16(img.width, img.height, 4)
                    max-v = 65535
                }

                -> {
                    _d str = with-len(img.width * img.height * 4)
                    out = image.new-from-data(img.width, img.height, 4, _d)
                }
            }
            npix = img.width * img.height
            i <- [0..npix): {
                px = i % img.width
                py = i / img.width
                r = image.get-pixel(img, px, py, 0)
                g = image.get-pixel(img, px, py, 1)
                b = image.get-pixel(img, px, py, 2)

                mx = r
                mx < g -> mx = g
                mx < b -> mx = b
                k = max-v - mx

                {
                    k < max-v -> {
                        c = (max-v - r - k) * max-v / (max-v - k)
                        m = (max-v - g - k) * max-v / (max-v - k)
                        y = (max-v - b - k) * max-v / (max-v - k)
                    }

                    -> {
                        c = 0
                        m = 0
                        y = 0
                    }
                }

                image.set-pixel(out, px, py, 0, c)
                image.set-pixel(out, px, py, 1, m)
                image.set-pixel(out, px, py, 2, y)
                image.set-pixel(out, px, py, 3, k)
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; colour.cmyk2rgb: convert CMYK to RGB
; img image: input CMYK image (4-band)
; returns out image: RGB image (3-band)
cmyk2rgb = (img image) (out image) {
    {
        img.bands >= 4 -> {
            d = img.depth
            {
                d == 0 -> d = 1
            }
            max-v = 255
            {
                d == 2 -> {
                    out = image.new-u16(img.width, img.height, 3)
                    max-v = 65535
                }

                -> {
                    _d str = with-len(img.width * img.height * 3)
                    out = image.new-from-data(img.width, img.height, 3, _d)
                }
            }
            npix = img.width * img.height
            i <- [0..npix): {
                px = i % img.width
                py = i / img.width
                c = image.get-pixel(img, px, py, 0)
                m = image.get-pixel(img, px, py, 1)
                y = image.get-pixel(img, px, py, 2)
                k = image.get-pixel(img, px, py, 3)

                r = max-v - (c * (max-v - k) / max-v + k)
                g = max-v - (m * (max-v - k) / max-v + k)
                b = max-v - (y * (max-v - k) / max-v + k)

                r < 0 -> r = 0
                g < 0 -> g = 0
                b < 0 -> b = 0

                image.set-pixel(out, px, py, 0, r)
                image.set-pixel(out, px, py, 1, g)
                image.set-pixel(out, px, py, 2, b)
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}