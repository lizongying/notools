; colour.no — Color space conversions
; Implements RGB <-> sRGB <-> Grayscale <-> HSV/HSL conversions
; Inspired by libvips colour operations

; ── RGB <-> Grayscale ──

; colour.rgb2gray: convert RGB image to grayscale
; img image: input RGB image
; returns out image: grayscale (1-band) image

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.invert
# /noimg/src/image.add-const
# /noimg/src/image.avg
# /noimg/src/image.min-val
# /noimg/src/image.max-val
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

rgb2gray = (img image) (out image) {
    {
        img.bands >= 3 -> {
            npix = img.width * img.height
            _d str = with-len(npix)
            out = image.new-from-data(img.width, img.height, 1, _d)
            i <- [0..npix): {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]

                ; ITU-R BT.601 luma
                v = (r * 299 + g * 587 + b * 114) / 1000
                out.data[i] = v
            }
        }

        -> {

            ; Already grayscale or unknown — just copy
            out = image.copy(img)
        }
    }
}

; colour.gray2rgb: convert grayscale to RGB
; img image: grayscale image
; returns out image: RGB image
gray2rgb = (img image) (out image) {
    {
        img.bands == 1 -> {
            npix = img.width * img.height
            _d str = with-len(npix * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
            i <- [0..npix): {
                v = img.data[i]
                out.data[i * 3] = v
                out.data[i * 3 + 1] = v
                out.data[i * 3 + 2] = v
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; ── RGB <-> HSV ──

; colour.rgb2hsv: convert RGB to HSV
; img image: RGB image
; returns out image: HSV image (H: 0-255, S: 0-255, V: 0-255)
rgb2hsv = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        r = img.data[i * img.bands]
        g = img.data[i * img.bands + 1]
        b = img.data[i * img.bands + 2]
        h = 0
        s = 0
        v = 0
        mx = r
        mx < g -> mx = g
        mx < b -> mx = b
        mn = r
        mn > g -> mn = g
        mn > b -> mn = b
        delta = mx - mn
        v = mx
        {
            mx == 0 -> {
                s = 0
            }

            -> {
                s = (delta * 255) / mx
            }
        }
        delta == 0 -> {
            h = 0
        }
        mx == r -> {
            h = (g - b) * 255 / (delta)
            h < 0 -> h = h + 255
        }
        mx == g -> {
            h = 85 + (b - r) * 255 / (delta)
        }
        mx == b -> {
            h = 170 + (r - g) * 255 / (delta)
        }
        out.data[i * 3] = h
        out.data[i * 3 + 1] = s
        out.data[i * 3 + 2] = v
    }
}

; colour.hsv2rgb: convert HSV to RGB
; img image: HSV image
; returns out image: RGB image
hsv2rgb = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        h = img.data[i * img.bands]
        s = img.data[i * img.bands + 1]
        v = img.data[i * img.bands + 2]
        r = 0
        g = 0
        b = 0
        {
            s == 0 -> {
                r = v
                g = v
                b = v
            }

            -> {

                ; h is 0-255, convert to sector 0-5
                hi = h * 6 / 256
                f = (h * 6 - hi * 256) / 256
                p = v * (255 - s) / 255
                q = v * (255 - (s * f) / 255) / 255
                t = v * (255 - (s * (255 - f)) / 255) / 255
                {
                    hi == 0 -> {
                        r = v
                        g = t
                        b = p
                    }

                    hi == 1 -> {
                        r = q
                        g = v
                        b = p
                    }

                    hi == 2 -> {
                        r = p
                        g = v
                        b = t
                    }

                    hi == 3 -> {
                        r = p
                        g = q
                        b = v
                    }

                    hi == 4 -> {
                        r = t
                        g = p
                        b = v
                    }

                    -> {
                        r = v
                        g = p
                        b = q
                    }
                }
            }
        }

        out.data[i * 3] = r
        out.data[i * 3 + 1] = g
        out.data[i * 3 + 2] = b
    }
}

; ── RGB <-> HSL ──

; colour.rgb2hsl: convert RGB to HSL
; img image: RGB image
; returns out image: HSL image
rgb2hsl = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        r = img.data[i * img.bands]
        g = img.data[i * img.bands + 1]
        b = img.data[i * img.bands + 2]
        h = 0
        s = 0
        l = 0
        mx = r
        mx < g -> mx = g
        mx < b -> mx = b
        mn = r
        mn > g -> mn = g
        mn > b -> mn = b
        l = (mx + mn) / 2
        delta = mx - mn
        {
            delta == 0 -> {
                h = 0
                s = 0
            }

            -> {
                {
                    l < 128 -> {
                        s = delta * 255 / (mx + mn)
                    }

                    -> {
                        sum = 510 - mx - mn
                        sum == 0 -> {
                            s = 0
                        }

                        -> {
                            s = delta * 255 / sum
                        }
                    }
                }
                mx == r -> {
                    h = (g - b) * 255 / delta
                    h < 0 -> h = h + 255
                }
                mx == g -> {
                    h = 85 + (b - r) * 255 / delta
                }
                mx == b -> {
                    h = 170 + (r - g) * 255 / delta
                }
            }
        }
        out.data[i * 3] = h
        out.data[i * 3 + 1] = s
        out.data[i * 3 + 2] = l
    }
}

; colour.hsl2rgb: convert HSL to RGB
; img image: HSL image (H: 0-255, S: 0-255, L: 0-255)
; returns out image: RGB image
hsl2rgb = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        h = img.data[i * img.bands]
        s = img.data[i * img.bands + 1]
        l = img.data[i * img.bands + 2]
        r = 0
        g = 0
        b = 0
        {
            s == 0 -> {
                r = l
                g = l
                b = l
            }

            -> {
                ; q = l < 128 ? l * (255 + s) / 255 : (l + s - l * s / 255)
                q = 0
                {
                    l < 128 -> {
                        q = l * (255 + s) / 255
                    }

                    -> {
                        q = l + s - l * s / 255
                    }
                }
                p = 2 * l - q
                ; h is 0-255, convert to 0-360 then compute
                ; Use sector approach: h * 6 / 256 gives sector
                hk = h * 6 / 256
                tc = h * 6 - hk * 256
                ; s' = s * q / 255 (saturation in q space)
                ; Actually use: c = (1 - |2l - 1|) * s
                ; t = c * (1 - |h' mod 2 - 1|)
                ; For integer math, compute RGB via p + (q - p) * sector
                {
                    hk == 0 -> {
                        r = q
                        g = p + (q - p) * tc / 255
                        b = p
                    }

                    hk == 1 -> {
                        r = p + (q - p) * (255 - tc) / 255
                        g = q
                        b = p
                    }

                    hk == 2 -> {
                        r = p
                        g = q
                        b = p + (q - p) * tc / 255
                    }

                    hk == 3 -> {
                        r = p
                        g = p + (q - p) * (255 - tc) / 255
                        b = q
                    }

                    hk == 4 -> {
                        r = p + (q - p) * tc / 255
                        g = p
                        b = q
                    }

                    -> {
                        r = q
                        g = p
                        b = p + (q - p) * (255 - tc) / 255
                    }
                }
            }
        }
        {
            r < 0 -> r = 0
            r > 255 -> r = 255
        }
        {
            g < 0 -> g = 0
            g > 255 -> g = 255
        }
        {
            b < 0 -> b = 0
            b > 255 -> b = 255
        }
        out.data[i * 3] = r
        out.data[i * 3 + 1] = g
        out.data[i * 3 + 2] = b
    }
}

; ── RGB <-> YCbCr ──

; colour.rgb2ycbcr: convert RGB to YCbCr (JPEG JFIF)
; img image: RGB image
; returns out image: YCbCr image
rgb2ycbcr = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        r = img.data[i * img.bands]
        g = img.data[i * img.bands + 1]
        b = img.data[i * img.bands + 2]
        y = (r * 77 + g * 150 + b * 29) >> 8
        cb = ((b - y) * 128) / 255 + 128
        cr = ((r - y) * 128) / 255 + 128
        {
            y < 0 -> y = 0

            y > 255 -> y = 255
        }
        {
            cb < 0 -> cb = 0

            cb > 255 -> cb = 255
        }
        {
            cr < 0 -> cr = 0

            cr > 255 -> cr = 255
        }
        out.data[i * 3] = y
        out.data[i * 3 + 1] = cb
        out.data[i * 3 + 2] = cr
    }
}

; colour.ycbcr2rgb: convert YCbCr to RGB
; img image: YCbCr image
; returns out image: RGB image
ycbcr2rgb = (img image) (out image) {
    npix = img.width * img.height
    _d str = with-len(npix * 3)
    out = image.new-from-data(img.width, img.height, 3, _d)
    i <- [0..npix): {
        y = img.data[i * img.bands]
        cb = img.data[i * img.bands + 1]
        cr = img.data[i * img.bands + 2]
        r = y + (cr * 255) / 128
        b = y + (cb * 255) / 128
        g = (y * 255 - r * 77 - b * 29) / 150
        {
            r < 0 -> r = 0

            r > 255 -> r = 255
        }
        {
            g < 0 -> g = 0

            g > 255 -> g = 255
        }
        {
            b < 0 -> b = 0

            b > 255 -> b = 255
        }
        out.data[i * 3] = r
        out.data[i * 3 + 1] = g
        out.data[i * 3 + 2] = b
    }
}

; ── Threshold / Binarize ──

; colour.threshold: binary threshold on grayscale or RGB
; img image: input image
; t i64: threshold value
; returns out image: binary (0 or 255) image
threshold = (img image, t i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    i <- [0..n): {
        img.data[i] >= t -> {
            out.data[i] = 255
        }

        -> {
            out.data[i] = 0
        }
    }
}

; colour.otsu-threshold: compute Otsu's threshold
; img image: input image
; returns t i64: computed threshold
otsu-threshold = (img image) (t i64) {

    ; Build histogram
    hist str = with-len(256)
    i <- [0..256): {
        hist[i] = 0
    }
    n = img.width * img.height * img.bands
    i <- [0..n): {
        v = img.data[i]
        hist[v] = hist[v] + 1
    }

    ; Total pixels
    total = n
    sum = 0
    i <- [0..256): {
        sum = sum + i * hist[i]
    }
    sum-b = 0
    w-b = 0
    max-var = 0
    t = 0
    i <- [0..256): {
        w-b = w-b + hist[i]
        w-b == 0 -> {
            i <- [0..0): {
            }
        }
        w-f = total - w-b
        w-f == 0 -> break
        sum-b = sum-b + i * hist[i]
        m-b = sum-b / w-b
        m-f = (sum - sum-b) / w-f
        var = w-b * w-f * (m-b - m-f) * (m-b - m-f)
        var > max-var -> {
            max-var = var
            t = i
        }
    }
}

; ── Brightness / Contrast / Gamma ──

; colour.brightness: adjust brightness
; img image: input image
; b i64: brightness adjustment (-255 to 255)
; returns out image: adjusted image
brightness = (img image, b i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    i <- [0..n): {
        v = img.data[i] + b
        v > 255 -> v = 255
        v < 0 -> v = 0
        out.data[i] = v
    }
}

; colour.contrast: adjust contrast
; img image: input image
; c i64: contrast factor (-100 to 100, percentage)
; returns out image: adjusted image
contrast = (img image, c i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    factor = (259 * (c + 255)) / (255 * (259 - c))
    i <- [0..n): {
        v = factor * (img.data[i] - 128) + 128
        v > 255 -> v = 255
        v < 0 -> v = 0
        out.data[i] = v
    }
}

; colour.gamma: apply gamma correction
; img image: input image
; g i64: gamma * 100 (e.g. 220 = 2.2)
; returns out image: corrected image
gamma = (img image, g i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    g == 0 -> return

    ; Build lookup table for speed
    lut str = with-len(256)
    i <- [0..256): {

        ; gamma = g / 100
        ; lut[i] = 255 * (i/255)^(g/100)
        ; Approximate with integer math
        norm = i * 1000 / 255

        ; norm^gamma * 255 / 1000^gamma
        result = 0
        {
            g == 100 -> {
                result = i
            }

            g > 100 -> {

                ; gamma > 1: darker
                ; approximate: i^gamma = i * i^(g-100)/100
                exp = g - 100
                tmp = norm
                j <- [0..exp / 10): {
                    tmp = tmp * norm / 1000
                }
                result = tmp * 255 / 1000
            }

            -> {

                ; gamma < 1: brighter
                exp = 100 - g
                tmp = norm
                j <- [0..exp / 10): {
                    tmp = (tmp * 1000) / (norm > 0 ? norm : 1)
                }
                result = tmp * 255 / 1000
            }
        }

        result > 255 -> result = 255
        result < 0 -> result = 0
        lut[i] = result
    }
    i <- [0..n): {
        out.data[i] = lut[img.data[i]]
    }
}

; ── Posterize ──

; colour.posterize: reduce the number of color levels
; img image: input image
; levels i64: number of levels per channel (2-256)
; returns out image: posterized image
posterize = (img image, levels i64) (out image) {
    out = image.copy(img)
    {
        levels <= 0 || levels > 256 -> return
    }
    step = 256 / levels
    n = img.width * img.height * img.bands
    i <- [0..n): {
        v = img.data[i]
        out.data[i] = (v / step) * step + step / 2
    }
}

; ── Solarize ──

; colour.solarize: invert pixels above threshold
; img image: input image
; t i64: threshold
; returns out image: solarized image
solarize = (img image, t i64) (out image) {
    out = image.copy(img)
    n = img.width * img.height * img.bands
    i <- [0..n): {
        img.data[i] >= t -> {
            out.data[i] = 255 - img.data[i]
        }
    }
}

; ── Overlay blend mode ──

; colour.overlay: apply overlay blend mode (hard light)
; For each pixel: if base < 128, result = 2 * base * overlay / 255
;                 if base >= 128, result = 255 - 2 * (255 - base) * (255 - overlay) / 255
; img image: base image
; overlay image: overlay image
; returns out image: blended image
overlay-blend = (img image, overlay image) (out image) {
    out = image.copy(img)
    npix = img.width * img.height
    i <- [0..npix): {
        b <- [0..img.bands): {
            bv = img.data[i * img.bands + b]
            {
                b < overlay.bands -> {
                    ov = overlay.data[i * overlay.bands + b]
                    {
                        bv < 128 -> {
                            out.data[i * img.bands + b] = 2 * bv * ov / 255
                        }

                        -> {
                            out.data[i * img.bands + b] = 255 - 2 * (255 - bv) * (255 - ov) / 255
                        }
                    }
                }
            }
        }
    }
}

; ── Adjust HSV ──

; colour.adjust-hsv: adjust hue, saturation, and value
; img image: input RGB image
; hue-shift i64: hue shift in degrees (0-255 range, e.g. 43 = ~60 degrees)
; sat-shift i64: saturation adjustment (-255 to 255, added to S)
; val-shift i64: value/brightness adjustment (-255 to 255, added to V)
; returns out image: adjusted RGB image
adjust-hsv = (img image, hue-shift i64, sat-shift i64, val-shift i64) (out image) {
    hsv = colour.rgb2hsv(img)
    npix = img.width * img.height
    i <- [0..npix): {
        h = hsv.data[i * 3]
        s = hsv.data[i * 3 + 1]
        v = hsv.data[i * 3 + 2]
        h = h + hue-shift
        h >= 255 -> h = h - 255
        h < 0 -> h = h + 255
        s = s + sat-shift
        s > 255 -> s = 255
        s < 0 -> s = 0
        v = v + val-shift
        v > 255 -> v = 255
        v < 0 -> v = 0
        hsv.data[i * 3] = h
        hsv.data[i * 3 + 1] = s
        hsv.data[i * 3 + 2] = v
    }
    out = colour.hsv2rgb(hsv)
}

; ── Sepia tone ──

; colour.sepia: apply sepia tone effect
; img image: input image
; returns out image: sepia-toned image
sepia = (img image) (out image) {
    {
        img.bands >= 3 -> {
            npix = img.width * img.height
            _d str = with-len(npix * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
            i <- [0..npix): {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]
                out.data[i * 3] = (r * 393 + g * 769 + b * 189) / 1000
                out.data[i * 3 + 1] = (r * 349 + g * 686 + b * 168) / 1000
                out.data[i * 3 + 2] = (r * 272 + g * 534 + b * 131) / 1000
                out.data[i * 3] > 255 -> out.data[i * 3] = 255
                out.data[i * 3 + 1] > 255 -> out.data[i * 3 + 1] = 255
                out.data[i * 3 + 2] > 255 -> out.data[i * 3 + 2] = 255
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; ── RGB <-> Lab ──

; colour.rgb2lab: convert RGB image to CIE Lab color space
; Uses sRGB -> linear RGB -> XYZ -> Lab pipeline with D65 illuminant
; img image: input RGB image (3+ bands)
; returns out image: Lab image (3-band, L: 0-255, a: 0-255, b: 0-255)
rgb2lab = (img image) (out image) {
    {
        img.bands >= 3 -> {
            npix = img.width * img.height
            _d str = with-len(npix * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
            i <- [0..npix): {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]

                ; sRGB to linear (inverse gamma)
                ; if v/255 <= 0.04045 -> v/(255*12.92) else ((v/255+0.055)/1.055)^2.4
                ; Simplified using integer math
                rf = r * 1000 / 255
                gf = g * 1000 / 255
                bf = b * 1000 / 255

                {
                    rf <= 4045 -> {
                        rl = rf * 1000 / 12920
                    }
                    -> {
                        rl = rf * rf / 1000
                        rl = rl * 1000 / 1055
                    }
                }
                {
                    gf <= 4045 -> {
                        gl = gf * 1000 / 12920
                    }
                    -> {
                        gl = gf * gf / 1000
                        gl = gl * 1000 / 1055
                    }
                }
                {
                    bf <= 4045 -> {
                        bl = bf * 1000 / 12920
                    }
                    -> {
                        bl = bf * bf / 1000
                        bl = bl * 1000 / 1055
                    }
                }

                ; XYZ conversion (D65, sRGB matrix)
                xn = (4124 * rl + 3576 * gl + 1805 * bl) / 10000000
                yn = (2126 * rl + 7152 * gl + 722 * bl) / 10000000
                zn = (193 * rl + 1192 * gl + 9505 * bl) / 10000000

                ; Normalize by D65 white point
                fx = xn * 1000 / 950
                fy = yn
                fz = zn * 1000 / 1089

                ; f(t) = t^(1/3) if t > 0.008856 else 7.787*t + 16/116
                {
                    fx > 8856 -> {
                        ; Cube root via Newton's method
                        x0 = fx / 20000 + 10
                        x1 = (2 * x0 * 1000 + fx * 1000 / x0 * 1000 / x0) / 3
                        x1 = x1 / 1000
                        fx = x1
                    }
                    -> {
                        fx = 7787 * fx / 1000 + 4000 / 2900
                    }
                }
                {
                    fy > 8856 -> {
                        y0 = fy / 20000 + 10
                        y1 = (2 * y0 * 1000 + fy * 1000 / y0 * 1000 / y0) / 3
                        y1 = y1 / 1000
                        fy = y1
                    }
                    -> {
                        fy = 7787 * fy / 1000 + 4000 / 2900
                    }
                }
                {
                    fz > 8856 -> {
                        z0 = fz / 20000 + 10
                        z1 = (2 * z0 * 1000 + fz * 1000 / z0 * 1000 / z0) / 3
                        z1 = z1 / 1000
                        fz = z1
                    }
                    -> {
                        fz = 7787 * fz / 1000 + 4000 / 2900
                    }
                }

                ; L = 116*fy - 16, a = 500*(fx-fy), b = 200*(fy-fz)
                l = 116 * fy / 1000 - 16
                av = 500 * (fx - fy) / 1000
                bv = 200 * (fy - fz) / 1000

                ; Scale to 0-255 range
                l = l * 255 / 100
                l < 0 -> l = 0
                l > 255 -> l = 255
                av = av + 128
                av < 0 -> av = 0
                av > 255 -> av = 255
                bv = bv + 128
                bv < 0 -> bv = 0
                bv > 255 -> bv = 255

                out.data[i * 3] = l
                out.data[i * 3 + 1] = av
                out.data[i * 3 + 2] = bv
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; colour.lab2rgb: convert Lab image to RGB
; img image: Lab image (3-band)
; returns out image: RGB image (3-band)
lab2rgb = (img image) (out image) {
    {
        img.bands >= 3 -> {
            npix = img.width * img.height
            _d str = with-len(npix * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
            i <- [0..npix): {
                l = img.data[i * img.bands] * 100 / 255
                av = img.data[i * img.bands + 1] - 128
                bv = img.data[i * img.bands + 2] - 128

                ; fy = (l + 16) / 116
                fy = (l + 16) * 1000 / 116
                fx = fy + av * 1000 / 500
                fz = fy - bv * 1000 / 200

                ; Inverse f: t^3 if t > 6/29 else 3*(6/29)^2*(t - 2/29)
                {
                    fx > 20690 -> {
                        xn = fx * fx / 1000000 * fx / 1000
                        xn = xn * 950 / 1000
                    }
                    -> {
                        xn = 3 * 7150 * (fx - 6900) / 10000000
                        xn = xn * 950 / 1000
                    }
                }
                {
                    fy > 20690 -> {
                        yn = fy * fy / 1000000 * fy / 1000
                    }
                    -> {
                        yn = 3 * 7150 * (fy - 6900) / 10000000
                    }
                }
                {
                    fz > 20690 -> {
                        zn = fz * fz / 1000000 * fz / 1000
                        zn = zn * 1089 / 1000
                    }
                    -> {
                        zn = 3 * 7150 * (fz - 6900) / 10000000
                        zn = zn * 1089 / 1000
                    }
                }

                ; XYZ to linear RGB (inverse matrix)
                rl = (32406 * xn - 15372 * yn - 4986 * zn) / 10000
                gl = (-9689 * xn + 18758 * yn + 415 * zn) / 10000
                bl = (557 * xn - 2040 * yn + 10570 * zn) / 10000

                ; Linear to sRGB (gamma)
                {
                    rl <= 31308 -> {
                        r = 1292 * rl / 100000
                    }
                    -> {
                        ; v^(1/2.4) ~ sqrt(v) approximation
                        r0 = rl / 200 + 50
                        r1 = (r0 + rl / r0) / 2
                        r = 1055 * r1 / 1000 * r1 / 1000 - 55
                    }
                }
                {
                    gl <= 31308 -> {
                        g = 1292 * gl / 100000
                    }
                    -> {
                        g0 = gl / 200 + 50
                        g1 = (g0 + gl / g0) / 2
                        g = 1055 * g1 / 1000 * g1 / 1000 - 55
                    }
                }
                {
                    bl <= 31308 -> {
                        b = 1292 * bl / 100000
                    }
                    -> {
                        b0 = bl / 200 + 50
                        b1 = (b0 + bl / b0) / 2
                        b = 1055 * b1 / 1000 * b1 / 1000 - 55
                    }
                }

                ; Scale to 0-255
                r = r * 255 / 1000
                g = g * 255 / 1000
                b = b * 255 / 1000
                r < 0 -> r = 0
                r > 255 -> r = 255
                g < 0 -> g = 0
                g > 255 -> g = 255
                b < 0 -> b = 0
                b > 255 -> b = 255

                out.data[i * 3] = r
                out.data[i * 3 + 1] = g
                out.data[i * 3 + 2] = b
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; ── RGB <-> CMYK ──

; colour.rgb2cmyk: convert RGB to CMYK
; Uses simple subtractive model: K = 255 - max(R,G,B)
; img image: input RGB image
; returns out image: CMYK image (4-band)
rgb2cmyk = (img image) (out image) {
    {
        img.bands >= 3 -> {
            npix = img.width * img.height
            _d str = with-len(npix * 4)
            out = image.new-from-data(img.width, img.height, 4, _d)
            i <- [0..npix): {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]

                mx = r
                mx < g -> mx = g
                mx < b -> mx = b
                k = 255 - mx

                {
                    k < 255 -> {
                        c = (255 - r - k) * 255 / (255 - k)
                        m = (255 - g - k) * 255 / (255 - k)
                        y = (255 - b - k) * 255 / (255 - k)
                    }

                    -> {
                        c = 0
                        m = 0
                        y = 0
                    }
                }

                out.data[i * 4] = c
                out.data[i * 4 + 1] = m
                out.data[i * 4 + 2] = y
                out.data[i * 4 + 3] = k
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}

; colour.cmyk2rgb: convert CMYK to RGB
; img image: input CMYK image (4-band)
; returns out image: RGB image (3-band)
cmyk2rgb = (img image) (out image) {
    {
        img.bands >= 4 -> {
            npix = img.width * img.height
            _d str = with-len(npix * 3)
            out = image.new-from-data(img.width, img.height, 3, _d)
            i <- [0..npix): {
                c = img.data[i * img.bands]
                m = img.data[i * img.bands + 1]
                y = img.data[i * img.bands + 2]
                k = img.data[i * img.bands + 3]

                r = 255 - (c * (255 - k) / 255 + k)
                g = 255 - (m * (255 - k) / 255 + k)
                b = 255 - (y * (255 - k) / 255 + k)

                r < 0 -> r = 0
                g < 0 -> g = 0
                b < 0 -> b = 0

                out.data[i * 3] = r
                out.data[i * 3 + 1] = g
                out.data[i * 3 + 2] = b
            }
        }

        -> {
            out = image.copy(img)
        }
    }
}