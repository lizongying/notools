; rotate.no — Image rotation and flip operations
; Inspired by libvips vips_rot90 / vips_flip / vips_flipd

; Rotation angles

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.invert
# /noimg/src/image.add-const
# /noimg/src/image.avg
# /noimg/src/image.min-val
# /noimg/src/image.max-val
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

ROT-90 = 90
ROT-180 = 180
ROT-270 = 270

; Flip directions
; FLIP-H  = 0   ; horizontal (left-right) (inlined)
; FLIP-V  = 1   ; vertical (top-bottom) (inlined)
; FLIP-BOTH = 2 ; both axes (inlined to avoid compiler global var bug)

; ── Rotation ──

; rotate.rot: rotate image by 90, 180, or 270 degrees
; img image: input image
; angle i64: rotation angle (90, 180, 270)
; returns out image: rotated image
rot = (img image, angle i64) (out image) {
    {
        angle == 90 -> {
            out = rot90(img)
        }

        angle == 180 -> {
            out = rot180(img)
        }

        angle == 270 -> {
            out = rot270(img)
        }

        -> {
            out = image.copy(img)
        }
    }
}

; rotate.rot90: rotate 90 degrees clockwise
; img image: input
; returns out image: rotated 90 CW
rot90 = (img image) (out image) {

    ; new dimensions: width=old height, height=old width
    #{overflow=wrap}
    _d str = with-len(img.width * img.height * img.bands)
    out = image.new-from-data(img.height, img.width, img.bands, _d)
    y <- [0..img.height): {
        x <- [0..img.width): {

            ; (x, y) -> (img.height-1-y, x) for CW
            #{overflow=wrap}
            src = (y * img.width + x) * img.bands

            #{overflow=wrap}
            dst = (x * img.height + (img.height - 1 - y)) * img.bands
            b <- [0..img.bands): {

                #{overflow=wrap}
                out.data[dst + b] = img.data[src + b]
            }
        }
    }
}

; rotate.rot180: rotate 180 degrees
; img image: input
; returns out image: rotated 180
rot180 = (img image) (out image) {

    #{overflow=wrap}
    _d str = with-len(img.width * img.height * img.bands)
    out = image.new-from-data(img.width, img.height, img.bands, _d)
    y <- [0..img.height): {
        x <- [0..img.width): {

            #{overflow=wrap}
            sx = img.width - 1 - x

            #{overflow=wrap}
            sy = img.height - 1 - y

            #{overflow=wrap}
            src = (sy * img.width + sx) * img.bands

            #{overflow=wrap}
            dst = (y * img.width + x) * img.bands
            b <- [0..img.bands): {

                #{overflow=wrap}
                out.data[dst + b] = img.data[src + b]
            }
        }
    }
}

; rotate.rot270: rotate 270 degrees clockwise (= 90 CCW)
; img image: input
; returns out image: rotated 270 CW
rot270 = (img image) (out image) {

    #{overflow=wrap}
    _d str = with-len(img.width * img.height * img.bands)
    out = image.new-from-data(img.height, img.width, img.bands, _d)
    y <- [0..img.height): {
        x <- [0..img.width): {

            ; (x, y) -> (y, img.width-1-x) for CCW
            #{overflow=wrap}
            src = (y * img.width + x) * img.bands

            #{overflow=wrap}
            dst = ((img.width - 1 - x) * img.height + y) * img.bands
            b <- [0..img.bands): {

                #{overflow=wrap}
                out.data[dst + b] = img.data[src + b]
            }
        }
    }
}

; rotate.rot-free: rotate by arbitrary angle using nearest-neighbor
; img image: input
; angle f64: angle in degrees (0-360)
; returns out image: rotated image (dimensions may grow)
rot-free = (img image, angle f64) (out image) {

    ; Convert to radians
    rad = angle * math.PI / 180.0
    cos-a = math.cos(rad)
    sin-a = math.sin(rad)

    ; Compute bounding box of rotated image
    w = img.width
    h = img.height

    ; f64 copies for the trig math: an arithmetic result takes the LEFT
    ; operand's type, so the i64 dimensions must be widened to f64 before
    ; mixing with cos-a/sin-a (otherwise `w * cos-a` lowers to integer math).
    wf = 0.0 + w
    hf = 0.0 + h

    ; Four corners
    #{overflow=wrap}
    x1 = wf * cos-a
    #{overflow=wrap}
    y1 = wf * sin-a
    #{overflow=wrap}
    x2 = wf * cos-a - hf * sin-a
    #{overflow=wrap}
    y2 = wf * sin-a + hf * cos-a
    #{overflow=wrap}
    x3 = 0.0 - hf * sin-a
    #{overflow=wrap}
    y3 = hf * cos-a

    ; Bounding box
    min-x = 0.0
    max-x = x1
    x2 < min-x -> min-x = x2
    x3 < min-x -> min-x = x3
    x2 > max-x -> max-x = x2
    x3 > max-x -> max-x = x3
    min-y = 0.0
    max-y = y1
    y2 < min-y -> min-y = y2
    y3 < min-y -> min-y = y3
    y2 > max-y -> max-y = y2
    y3 > max-y -> max-y = y3

    #{overflow=wrap}
    new-w = number.f64-to-i64(max-x - min-x + 1)

    #{overflow=wrap}
    new-h = number.f64-to-i64(max-y - min-y + 1)

    #{overflow=wrap}
    _d str = with-len(new-w * new-h * img.bands)
    out = image.new-from-data(new-w, new-h, img.bands, _d)

    ; Fill with black
    image.fill(out, 0)

    ; Center offsets
    #{overflow=wrap}
    cx = w / 2

    #{overflow=wrap}
    cy = h / 2

    #{overflow=wrap}
    ncx = new-w / 2

    #{overflow=wrap}
    ncy = new-h / 2
    y <- [0..new-h): {
        x <- [0..new-w): {

            ; Map dest pixel to source
            #{overflow=wrap}
            dx = x - ncx

            #{overflow=wrap}
            dy = y - ncy

            ; widen integer offsets to f64 so the rotation math stays float
            dxf = 0.0 + dx
            dyf = 0.0 + dy
            #{overflow=wrap}
            src-x = (dxf * cos-a + dyf * sin-a) + cx
            #{overflow=wrap}
            src-y = (dyf * cos-a - dxf * sin-a) + cy
            {
                src-x >= 0 && src-x < w && src-y >= 0 && src-y < h -> {
                    sx = number.f64-to-i64(src-x)
                    sy = number.f64-to-i64(src-y)

                    #{overflow=wrap}
                    src = (sy * w + sx) * img.bands
                    #{overflow=wrap}
                    dst = (y * new-w + x) * img.bands
                    b <- [0..img.bands): {
                        #{overflow=wrap}
                        out.data[dst + b] = img.data[src + b]
                    }
                }
            }
        }
    }
}

; ── Flip ──

; rotate.flip: flip image horizontally, vertically, or both
; img image: input
; dir i64: FLIP-H, FLIP-V, or FLIP-BOTH
; returns out image: flipped image
flip = (img image, dir i64) (out image) {
    {
        dir == 0 -> {
            out = flip-h(img)
        }

        dir == 1 -> {
            out = flip-v(img)
        }

        dir == 2 -> {
            out = rot180(img)
        }

        -> {
            out = image.copy(img)
        }
    }
}

; flip-h: horizontal flip (mirror left-right)
; img image: input
; returns out image: flipped
flip-h = (img image) (out image) {

    #{overflow=wrap}
    _d str = with-len(img.width * img.height * img.bands)
    out = image.new-from-data(img.width, img.height, img.bands, _d)
    y <- [0..img.height): {
        x <- [0..img.width): {

            #{overflow=wrap}
            sx = img.width - 1 - x

            #{overflow=wrap}
            src = (y * img.width + sx) * img.bands

            #{overflow=wrap}
            dst = (y * img.width + x) * img.bands
            b <- [0..img.bands): {

                #{overflow=wrap}
                out.data[dst + b] = img.data[src + b]
            }
        }
    }
}

; flip-v: vertical flip (mirror top-bottom)
; img image: input
; returns out image: flipped
flip-v = (img image) (out image) {

    #{overflow=wrap}
    _d str = with-len(img.width * img.height * img.bands)
    out = image.new-from-data(img.width, img.height, img.bands, _d)
    y <- [0..img.height): {
        x <- [0..img.width): {

            #{overflow=wrap}
            sy = img.height - 1 - y

            #{overflow=wrap}
            src = (sy * img.width + x) * img.bands

            #{overflow=wrap}
            dst = (y * img.width + x) * img.bands
            b <- [0..img.bands): {

                #{overflow=wrap}
                out.data[dst + b] = img.data[src + b]
            }
        }
    }
}

; ── Transpose / Transverse ──

; rotate.transpose: transpose (flip along main diagonal)
; img image: input
; returns out image: transposed
transpose = (img image) (out image) {

    #{overflow=wrap}
    _d str = with-len(img.width * img.height * img.bands)
    out = image.new-from-data(img.height, img.width, img.bands, _d)
    y <- [0..img.height): {
        x <- [0..img.width): {

            #{overflow=wrap}
            src = (y * img.width + x) * img.bands

            #{overflow=wrap}
            dst = (x * img.height + y) * img.bands
            b <- [0..img.bands): {

                #{overflow=wrap}
                out.data[dst + b] = img.data[src + b]
            }
        }
    }
}

; rotate.transverse: transverse (flip along anti-diagonal)
; img image: input
; returns out image: transversed
transverse = (img image) (out image) {

    #{overflow=wrap}
    _d str = with-len(img.width * img.height * img.bands)
    out = image.new-from-data(img.height, img.width, img.bands, _d)
    y <- [0..img.height): {
        x <- [0..img.width): {

            #{overflow=wrap}
            sx = img.width - 1 - x

            #{overflow=wrap}
            sy = img.height - 1 - y

            #{overflow=wrap}
            src = (sy * img.width + sx) * img.bands

            #{overflow=wrap}
            dst = (x * img.height + y) * img.bands
            b <- [0..img.bands): {

                #{overflow=wrap}
                out.data[dst + b] = img.data[src + b]
            }
        }
    }
}
