; ── Load ──

; tga.load: load a TGA file
; path str: file path
; returns img ?image: loaded image, nil on error

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.invert
# /noimg/src/image.add-const
# /noimg/src/image.avg
# /noimg/src/image.min-val
# /noimg/src/image.max-val
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

; tga.no — TGA (Truevision Targa) format read/write
; Supports:
;   Type 2  — uncompressed true-color (24/32-bit)
;   Type 3  — uncompressed grayscale (8-bit)
;   Type 10 — RLE compressed true-color (24/32-bit)
;
; TGA file layout:
;   Header (18 bytes): id-length, color-map-type, image-type, x-origin,
;     y-origin, width, height, pixel-depth, image-descriptor
;   Image ID (variable)
;   Color map (optional)
;   Pixel data (bottom-up or top-down depending on descriptor bit 5)

; 0.4.24 下索引读取返回 ?byte，value-match 只能作赋值右值顶层：
; 统一用这个 helper 把「读取 + mask」收成具体 i64。
tga-byte = (d []byte, i i64) (b i64) {
    v = d[i]: {
        ok -> it

        -> 0
    }
    b = v & 255
}

load = (path str) (img ?image) {
    data = fs.read-file(path)
    data.len() < 18 -> {
        img = nil
        return
    }
    id-len = tga-byte(data, 0)
    color-map-type = tga-byte(data, 1)
    image-type = tga-byte(data, 2)

    ; x-origin (bytes 8-9), y-origin (bytes 10-11) — little-endian
    w = tga-byte(data, 12) | (tga-byte(data, 13) << 8)
    h = tga-byte(data, 14) | (tga-byte(data, 15) << 8)
    depth = tga-byte(data, 16)
    descriptor = tga-byte(data, 17)
    {
        w <= 0 || h <= 0 || w > 65535 || h > 65535 -> {
            img = nil
            return
        }

        depth != 8 && depth != 24 && depth != 32 -> {
            img = nil
            return
        }
    }

    ; Top-down if bit 5 (0x20) is set
    top-down = (descriptor & 32) != 0

    ; Skip image ID
    #{overflow=wrap}
    pos = 18 + id-len

    ; Skip color map if present
    color-map-type != 0 -> {

        ; cmap entries (bytes 4-5), entry-size (byte 7)
        cm-entries i64 = tga-byte(data, 4) | (tga-byte(data, 5) << 8)
        cm-size = tga-byte(data, 7)

        #{overflow=wrap}
        pos = pos + cm-entries * ((cm-size + 7) / 8)
    }

    #{overflow=wrap}
    bands = depth / 8
    {
        image-type == 2 || image-type == 3 -> {

            ; Uncompressed
            img = tga-load-uncompressed(data, pos, w, h, bands, top-down)
        }

        image-type == 10 -> {

            ; RLE compressed true-color
            img = tga-load-rle(data, pos, w, h, bands, top-down)
        }

        -> {
            img = nil
        }
    }
}

; tga-load-uncompressed: load uncompressed TGA pixel data
; data str: file content
; pos i64: data start position
; w i64: width
; h i64: height
; bands i64: bytes per pixel (1, 3, 4)
; top-down bool: whether rows are top-down
; returns img ?image
tga-load-uncompressed = (data []byte, pos i64, w i64, h i64, bands i64, top-down bool) (img ?image) {
    n = 0
    w * h * bands: {
        ok -> {
            n = it
        }

        -> {
            n = 0
        }
    }
    dbuf []byte = with-len(n)
    tmp = image.new-from-data(w, h, bands, dbuf)
    y <- [0..h): {
        src-y = y

        #{overflow=wrap}
        ! top-down -> src-y = h - 1 - y
        x <- [0..w): {

            #{overflow=wrap}
            src = pos + (src-y * w + x) * bands

            #{overflow=wrap}
            dst = (y * w + x) * bands
            {
                bands == 1 -> {
                    tmp.data[dst] = tga-byte(data, src)
                }

                bands == 3 -> {

                    ; TGA stores BGRA, we store RGBA
                    #{overflow=wrap}
                    tmp.data[dst] = tga-byte(data, src + 2)

                    #{overflow=wrap}
                    tmp.data[dst + 1] = tga-byte(data, src + 1)

                    #{overflow=wrap}
                    tmp.data[dst + 2] = tga-byte(data, src)
                }

                bands == 4 -> {

                    #{overflow=wrap}
                    tmp.data[dst] = tga-byte(data, src + 2)

                    #{overflow=wrap}
                    tmp.data[dst + 1] = tga-byte(data, src + 1)

                    #{overflow=wrap}
                    tmp.data[dst + 2] = tga-byte(data, src)

                    #{overflow=wrap}
                    tmp.data[dst + 3] = tga-byte(data, src + 3)
                }
            }
        }
    }
    img = tmp
}

; tga-load-rle: load RLE compressed TGA
; TGA RLE: packet header byte:
;   bit 7 = 1 → run-length packet (repeat pixel count+1 times)
;   bit 7 = 0 → raw packet (count+1 raw pixels follow)
; returns img ?image
tga-load-rle = (data []byte, pos i64, w i64, h i64, bands i64, top-down bool) (img ?image) {
    n = 0
    w * h * bands: {
        ok -> {
            n = it
        }

        -> {
            n = 0
        }
    }
    dbuf []byte = with-len(n)
    tmp = image.new-from-data(w, h, bands, dbuf)

    #{overflow=wrap}
    total-pixels = w * h
    pixels-read = 0
    p = pos
    (pixels-read < total-pixels) {
        pixels-read < total-pixels -> {
            header = tga-byte(data, p)

            #{overflow=wrap}
            p = p + 1: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            count = (header & 127) + 1
            {
                header >= 128 -> {

                    ; Run-length packet: 1 pixel repeated
                    r = tga-byte(data, p)

                    #{overflow=wrap}
                    g = tga-byte(data, p + 1)

                    #{overflow=wrap}
                    b = tga-byte(data, p + 2)
                    a = 255

                    #{overflow=wrap}
                    bands == 4 -> a = tga-byte(data, p + 3)

                    #{overflow=wrap}
                    p = p + bands: {
                        ok -> it

                        -> 0
                    }
                    i <- [0..count): {
                        {
                            pixels-read >= total-pixels -> break
                        }
                        pixel-idx = pixels-read

                        #{overflow=wrap}
                        src-y = pixel-idx / w

                        #{overflow=wrap}
                        src-x = pixel-idx - src-y * w

                        #{overflow=wrap}
                        ! top-down -> src-y = h - 1 - src-y

                        #{overflow=wrap}
                        dst = (src-y * w + src-x) * bands
                        {
                            bands == 1 -> {
                                tmp.data[dst] = r
                            }

                            bands == 3 -> {
                                tmp.data[dst] = b

                                #{overflow=wrap}
                                tmp.data[dst + 1] = g

                                #{overflow=wrap}
                                tmp.data[dst + 2] = r
                            }

                            bands == 4 -> {
                                tmp.data[dst] = b

                                #{overflow=wrap}
                                tmp.data[dst + 1] = g

                                #{overflow=wrap}
                                tmp.data[dst + 2] = r

                                #{overflow=wrap}
                                tmp.data[dst + 3] = a
                            }
                        }

                        #{overflow=wrap}
                        pixels-read = pixels-read + 1: {
                            ok -> it

                            -> 0
                        }
                    }
                }

                -> {

                    ; Raw packet: count raw pixels
                    i <- [0..count): {
                        {
                            pixels-read >= total-pixels -> break
                        }
                        r = tga-byte(data, p)

                        #{overflow=wrap}
                        g = tga-byte(data, p + 1)

                        #{overflow=wrap}
                        b = tga-byte(data, p + 2)
                        a = 255

                        #{overflow=wrap}
                        bands == 4 -> a = tga-byte(data, p + 3)

                        #{overflow=wrap}
                        p = p + bands: {
                            ok -> it

                            -> 0
                        }
                        pixel-idx = pixels-read

                        #{overflow=wrap}
                        src-y = pixel-idx / w

                        #{overflow=wrap}
                        src-x = pixel-idx - src-y * w

                        #{overflow=wrap}
                        ! top-down -> src-y = h - 1 - src-y

                        #{overflow=wrap}
                        dst = (src-y * w + src-x) * bands
                        {
                            bands == 1 -> {
                                tmp.data[dst] = r
                            }

                            bands == 3 -> {
                                tmp.data[dst] = b

                                #{overflow=wrap}
                                tmp.data[dst + 1] = g

                                #{overflow=wrap}
                                tmp.data[dst + 2] = r
                            }

                            bands == 4 -> {
                                tmp.data[dst] = b

                                #{overflow=wrap}
                                tmp.data[dst + 1] = g

                                #{overflow=wrap}
                                tmp.data[dst + 2] = r

                                #{overflow=wrap}
                                tmp.data[dst + 3] = a
                            }
                        }

                        #{overflow=wrap}
                        pixels-read = pixels-read + 1: {
                            ok -> it

                            -> 0
                        }
                    }
                }
            }
        }
    }
    img = tmp
}

; ── Save ──

; tga.save: save an image as uncompressed TGA (type 2/3)
; path str: output path
; img image: image to save
; returns ok bool
save = (path str, img image) (ok bool) {

    #{overflow=wrap}
    depth = img.bands * 8
    {
        img.bands == 1 -> {
            ok = tga-write-uncompressed(path, img, 3, depth)
        }

        img.bands == 3 -> {
            ok = tga-write-uncompressed(path, img, 2, depth)
        }

        img.bands == 4 -> {
            ok = tga-write-uncompressed(path, img, 2, depth)
        }

        -> {

            ; Force to 3-band
            ok = tga-write-uncompressed(path, img, 2, 24)
        }
    }
}

; tga-write-uncompressed: write uncompressed TGA
; path str: path
; img image: image
; image-type i64: 2 (true-color) or 3 (grayscale)
; depth i64: bits per pixel
; returns ok bool
tga-write-uncompressed = (path str, img image, image-type i64, depth i64) (ok bool) {
    w = img.width
    h = img.height

    #{overflow=wrap}
    bands = depth / 8

    #{overflow=wrap}
    data-size i64 = w * h * bands

    total-size = 0
    18 + data-size: {
        ok -> {
            total-size = it
        }

        -> {
            total-size = 0
        }
    }
    buf []byte = with-cap(total-size)

    ; --- Header (18 bytes) ---
    buf.push(0)
    buf.push(0)
    buf.push(image-type & 255)

    ; Color map spec (5 bytes, all zero)
    buf.push(0)
    buf.push(0)
    buf.push(0)
    buf.push(0)
    buf.push(0)

    ; X origin (2 bytes LE)
    buf.push(0)
    buf.push(0)

    ; Y origin (2 bytes LE)
    buf.push(0)
    buf.push(0)

    ; Width (2 bytes LE)
    buf.push(w & 255)
    buf.push((w >> 8) & 255)

    ; Height (2 bytes LE)
    buf.push(h & 255)
    buf.push((h >> 8) & 255)

    ; Pixel depth
    buf.push(depth & 255)

    ; Image descriptor: bit 5 = top-down (0x20)
    buf.push(32)

    ; --- Pixel data (top-down) ---
    y <- [0..h): {
        x <- [0..w): {

            #{overflow=wrap}
            src = (y * w + x) * img.bands
            {
                bands == 1 -> {
                    img.bands == 1 -> {
                        buf.push(tga-byte(img.data, src))
                    }

                    -> {
                        r = img.data[src]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        g = img.data[src + 1]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        b = img.data[src + 2]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        buf.push((r * 299 + g * 587 + b * 114) / 1000)
                    }
                }

                bands == 3 -> {

                    ; TGA stores BGR
                    {
                        img.bands >= 3 -> {

                            #{overflow=wrap}
                            buf.push(tga-byte(img.data, src + 2))

                            #{overflow=wrap}
                            buf.push(tga-byte(img.data, src + 1))
                            buf.push(tga-byte(img.data, src))
                        }

                        img.bands == 1 -> {
                            v = img.data[src]: {
                                ok -> it

                                -> 0
                            }
                            buf.push(v)
                            buf.push(v)
                            buf.push(v)
                        }
                    }
                }

                bands == 4 -> {
                    img.bands >= 4 -> {

                        #{overflow=wrap}
                        buf.push(tga-byte(img.data, src + 2))

                        #{overflow=wrap}
                        buf.push(tga-byte(img.data, src + 1))
                        buf.push(tga-byte(img.data, src))

                        #{overflow=wrap}
                        buf.push(tga-byte(img.data, src + 3))
                    }

                    -> {
                        r = img.data[src]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        g = img.data[src + 1]: {
                            ok -> it

                            -> 0
                        }

                        #{overflow=wrap}
                        b = img.data[src + 2]: {
                            ok -> it

                            -> 0
                        }
                        buf.push(b)
                        buf.push(g)
                        buf.push(r)
                        buf.push(255)
                    }
                }
            }
        }
    }

    ; Write to file
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, buf.len())
    fs.close(wfd)
    ok = true
}

; tga.save-rle: save image as RLE compressed TGA (type 10)
; Note: RLE encoding is complex. For now, falls back to uncompressed save.
; path str: output path
; img image: image (RGB/RGBA)
; returns ok bool
save-rle = (path str, img image) (ok bool) {
    ok = save(path, img)
}
