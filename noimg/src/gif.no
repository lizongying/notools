; gif.no — GIF (Graphics Interchange Format) reader/writer
; Supports GIF89a with:
;   - Global and local color tables
;   - LZW compressed image data
;   - Interlaced images (de-interlacing)
;   - Transparent color (GCE extension)
;   - Animation: multi-frame extraction with disposal methods
;
; GIF file layout:
;   Header: 'GIF89a' or 'GIF87a' (6 bytes)
;   Logical screen descriptor (7 bytes): width, height, packed, bgcolor, aspect
;   Global color table (optional)
;   Blocks: extensions (0x21), image descriptors (0x2C), trailer (0x3B)

; ── Load ──

; gif.load: load a GIF file (first frame, composited)
; path str: file path
; returns img ?image: loaded image (RGBA, first frame composited), nil on error

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.invert
# /noimg/src/image.add-const
# /noimg/src/image.avg
# /noimg/src/image.min-val
# /noimg/src/image.max-val
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

load = (path str) (img ?image) {
    frames = gif-load-frames(path)
    {
        frames.len == 0 -> {
            img = nil
            return
        }
    }
    img = frames[0]
}

; gif-load-frames: load all frames from an animated GIF
; Composites each frame according to its disposal method.
; path str: file path
; returns frames []image: array of composited RGBA images, empty on error
gif-load-frames = (path str) (frames []image) {
    frames []image = with-cap(1)
    data = fs.read-file(path)
    data.len < 13 -> {
        return
    }

    ; Check GIF signature
    gif-ok = false
    (data[0] & 255) == 71 && (data[1] & 255) == 73 && (data[2] & 255) == 70 -> {
        gif-ok = true
    }
    gif-ok == false -> {
        return
    }

    ; Logical screen descriptor
    w = (data[6] & 255) | ((data[7] & 255) << 8)
    h = (data[8] & 255) | ((data[9] & 255) << 8)
    packed = data[10] & 255
    {
w <= 0 || h <= 0 || w > 65535 || h > 65535 -> {
return
        }
    }

    ; Global color table
    gct str = with-len(768)
    pos = 13
    has-gct = (packed & 128) != 0
    gct-size = 0
    has-gct == true -> {
        gct-bits = packed & 7
        gct-size = 1 << (gct-bits + 1)
        i <- [0..gct-size * 3): {
            gct[i] = data[pos + i] & 255
        }
        pos = pos + gct-size * 3
    }

    ; Create canvas (current composited frame)
    canvas-data str = with-len(w * h * 4)
    canvas = image.new-from-data(w, h, 4, canvas-data)
    i <- [0..w * h * 4): {
        canvas.data[i] = 0
    }

    ; Track disposal method and transparent color
    disposal = 0
    transparency = -1
    delay = 0

    ; Parse blocks
    {
        pos < data.len -> {
            block = data[pos] & 255
            {
                block == 44 -> {

                    ; Image descriptor (0x2C)
                    ; Save canvas state for disposal method 3 (restore to previous)
                    prev-canvas-data str = with-len(w * h * 4)
                    {
                        disposal == 3 -> {
                            i <- [0..w * h * 4): {
                                prev-canvas-data[i] = canvas.data[i]
                            }
                        }
                    }

                    ; Process image onto canvas
                    transparency, pos, frame-left, frame-top, frame-w, frame-h = gif-process-image(data, pos + 1, canvas, gct, has-gct, transparency)

                    ; Create output frame (copy of canvas)
                    frame-data str = with-len(w * h * 4)
                    i <- [0..w * h * 4): {
                        frame-data[i] = canvas.data[i]
                    }
                    frame = image.new-from-data(w, h, 4, frame-data)
                    frames.push(frame)

                    ; Apply disposal method
                    {
                        disposal == 2 -> {
                            ; Restore to background color
                            ; Clear only the frame region to transparent
                            fy <- [0..frame-h): {
                                fx <- [0..frame-w): {
                                    cx = frame-left + fx
                                    cy = frame-top + fy
                                    {
                                        cx >= 0 && cx < w && cy >= 0 && cy < h -> {
                                            dst = (cy * w + cx) * 4
                                            canvas.data[dst] = 0
                                            canvas.data[dst + 1] = 0
                                            canvas.data[dst + 2] = 0
                                            canvas.data[dst + 3] = 0
                                        }
                                    }
                                }
                            }
                        }

                        disposal == 3 -> {
                            ; Restore to previous
                            i <- [0..w * h * 4): {
                                canvas.data[i] = prev-canvas-data[i]
                            }
                        }
                    }
                    ; disposal == 0 or 1: do nothing (keep canvas as is)
                }

                block == 33 -> {

                    ; Extension (0x21)
                    pos = pos + 1
                    label = data[pos] & 255
                    pos = pos + 1
                    {
                        label == 249 -> {

                            ; Graphic Control Extension
                            gce-size = data[pos] & 255
                            pos = pos + 1
                            gce-packed = data[pos] & 255
                            disposal = (gce-packed >> 2) & 7
                            has-transp = (gce-packed & 1) != 0
                            pos = pos + 1

                            ; delay time (2 bytes)
                            delay = (data[pos] & 255) | ((data[pos + 1] & 255) << 8)
                            pos = pos + 2
                            {
                                has-transp == true -> {
                                    transparency = data[pos] & 255
                                }

                                -> {
                                    transparency = -1
                                }
                            }
                            pos = pos + 1

                            ; block terminator
                            pos = gif-skip-subblocks(data, pos)
                        }

                        -> {

                            ; Other extensions — skip
                            pos = gif-skip-subblocks(data, pos)
                        }
                    }
                }

                block == 59 -> {

                    ; Trailer (0x3B)
                    break
                }

                -> {
                    pos = pos + 1
                }
            }
        }
    } (pos < data.len)
}

; gif-process-image: process one image descriptor + data
; data str: file content
; pos i64: position after 0x2C marker
; img image: output image (RGBA)
; gct []byte: global color table
; has-gct bool: whether gct is valid
; transp i64: transparent color index (or -1)
; returns new-transp i64, new-pos i64, frame-left i64, frame-top i64, frame-w i64, frame-h i64
gif-process-image = (data str, pos i64, img image, gct []byte, has-gct bool, transp i64) (new-transp i64, new-pos i64, frame-left i64, frame-top i64, frame-w i64, frame-h i64) {
    new-transp = transp
    new-pos = pos
    frame-left = 0
    frame-top = 0
    frame-w = 0
    frame-h = 0

    ; Image descriptor fields
    left = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    top = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    iw = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    ih = (data[new-pos] & 255) | ((data[new-pos + 1] & 255) << 8)
    new-pos = new-pos + 2
    frame-left = left
    frame-top = top
    frame-w = iw
    frame-h = ih
    packed = data[new-pos] & 255
    new-pos = new-pos + 1

    ; Local color table
    lct str = with-len(768)
    use-lct = false
    {
        (packed & 128) != 0 -> {
            lct-bits = packed & 7
            lct-size = 1 << (lct-bits + 1)
            i <- [0..lct-size * 3): {
                lct[i] = data[new-pos + i] & 255
            }
            new-pos = new-pos + lct-size * 3
            use-lct = true
        }
    }

    ; LZW minimum code size
    min-code = data[new-pos] & 255
    new-pos = new-pos + 1

    ; Collect sub-block data
    block-data []byte = with-cap(65536)
    {
        new-pos < data.len -> {
            block-size = data[new-pos] & 255
            block-size == 0 -> break
            new-pos = new-pos + 1
            i <- [0..block-size): {
                block-data.push(data[new-pos + i] & 255)
            }
            new-pos = new-pos + block-size
        }
    } (new-pos < data.len)

    ; LZW decode
    decoded = gif-lzw-decode(block-data, min-code, iw * ih)

    ; Interlacing
    interlaced = (packed & 64) != 0

    ; Write pixels to image
    {
        decoded.len > 0 -> {
            y <- [0..ih): {
                {
                    interlaced == true -> {

                        ; De-interlace: passes 1-4
                        ; Pass 1: rows 0,8,16,...
                        ; Pass 2: rows 4,12,20,...
                        ; Pass 3: rows 2,6,10,14,...
                        ; Pass 4: rows 1,3,5,7,...
                        actual-y = gif-deinterlace-y(y, ih)
                    }

                    -> {
                        actual-y = y
                    }
                }

                {
                    actual-y < ih -> {
                        x <- [0..iw): {
                            idx = y * iw + x
                            {
                                idx < decoded.len -> {
                                    color-idx = decoded[idx]
                                    dst-y = actual-y + top
                                    dst-x = x + left
                                    {
                                        dst-x >= 0 && dst-x < img.width && dst-y >= 0 && dst-y < img.height -> {
                                            color-idx == new-transp && new-transp >= 0 -> {

                                                ; Transparent
                                                dst = (dst-y * img.width + dst-x) * 4
                                                img.data[dst] = 0
                                                img.data[dst + 1] = 0
                                                img.data[dst + 2] = 0
                                                img.data[dst + 3] = 0
                                            }

                                            -> {

                                                ; Use color table
                                                tbl = gct
                                                use-lct == true -> tbl = lct
                                                r = tbl[color-idx * 3]
                                                g = tbl[color-idx * 3 + 1]
                                                b = tbl[color-idx * 3 + 2]
                                                dst = (dst-y * img.width + dst-x) * 4
                                                img.data[dst] = r
                                                img.data[dst + 1] = g
                                                img.data[dst + 2] = b
                                                img.data[dst + 3] = 255
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; gif-deinterlace-y: map sequential row to actual row for interlaced GIF
; seq-y i64: sequential y (0..height-1)
; h i64: image height
; returns actual-y i64
gif-deinterlace-y = (seq-y i64, h i64) (actual-y i64) {

    ; Count rows per pass
    pass1 = (h + 7) / 8
    {
        h >= 4 -> {
            pass2 = (h - 4 + 7) / 8
        }

        -> {
            pass2 = 0
        }
    }
    {
        seq-y < pass1 -> {
            actual-y = seq-y * 8
            return
        }

        seq-y < pass1 + pass2 -> {
            actual-y = 4 + (seq-y - pass1) * 8
            return
        }
    }

    ; Count pass3 and pass4
    pass3count = (h - 2 + 3) / 4
    {
        h <= 2 -> pass3count = 0
    }
    {
        seq-y < pass1 + pass2 + pass3count -> {
            actual-y = 2 + (seq-y - pass1 - pass2) * 4
            return
        }
    }
    pass4count = (h - 1 + 1) / 2
    {
        h <= 1 -> pass4count = 0
    }
    actual-y = 1 + (seq-y - pass1 - pass2 - pass3count) * 2
}

; gif-skip-subblocks: skip all sub-blocks starting at pos
; data str: data
; pos i64: starting position (at first sub-block size byte)
; returns new-pos i64: position after all sub-blocks
gif-skip-subblocks = (data str, pos i64) (new-pos i64) {
    new-pos = pos
    {
        new-pos < data.len -> {
            block-size = data[new-pos] & 255
            new-pos = new-pos + 1
            block-size == 0 -> break
            new-pos = new-pos + block-size
        }
    } (new-pos < data.len)
}

; ── LZW decoder ──

; gif-lzw-decode: decode LZW compressed data
; data []byte: compressed data
; min-code i64: minimum code size (2-12)
; expected-len i64: expected decoded length
; returns decoded []byte
gif-lzw-decode = (data []byte, min-code i64, expected-len i64) (decoded []byte) {
    {
        min-code < 2 || min-code > 12 -> {
            decoded str = with-len(0)
            return
        }
    }
    clear-code = 1 << min-code
    end-code = clear-code + 1
    code-size = min-code + 1

    ; Initialize dictionary (max 4096 entries)
    dict-prefix str = with-len(4096)
    dict-suffix str = with-len(4096)
    dict-len = 0

    ; Initialize with base codes
    i <- [0..clear-code): {
        dict-prefix[i] = -1
        dict-suffix[i] = i
    }
    dict-len = end-code + 1

    ; Bit reader state
    bit-buf = 0
    bit-count = 0
    byte-pos = 0
    decoded []byte = with-cap(expected-len)
    prev-code = -1
    {
        byte-pos < data.len -> {

            ; Read bits from data
            {
                bit-count < code-size -> {
                    byte-pos < data.len -> {
                        bit-buf = bit-buf | ((data[byte-pos] & 255) << bit-count)
                        bit-count = bit-count + 8
                        byte-pos = byte-pos + 1
                    }
                }
            } (bit-count < code-size && byte-pos < data.len)
            bit-count < code-size -> break

            ; Extract code
            code = bit-buf & ((1 << code-size) - 1)
            bit-buf = bit-buf >> code-size
            bit-count = bit-count - code-size
            {
                code == clear-code -> {

                    ; Reset
                    code-size = min-code + 1
                    dict-len = end-code + 1
                    prev-code = -1
                }

                code == end-code -> {
                    break
                }

                -> {
                    code < dict-len -> {

                        ; Code in dictionary — output string
                        entry-buf []byte = with-cap(4096)
                        c = code
                        {
                            c >= 0 -> {
                                entry-buf.push(dict-suffix[c])
                                c = dict-prefix[c]
                            }
                        } (c >= 0)

                        ; Reverse entry-buf
                        entry-len = entry-buf.len
                        j <- [0..entry-buf.len / 2): {
                            tmp = entry-buf[j]
                            entry-buf[j] = entry-buf[entry-len - 1 - j]
                            entry-buf[entry-len - 1 - j] = tmp
                        }

                        ; Output
                        j <- [0..entry-buf.len): {
                            decoded.push(entry-buf[j])
                        }

                        ; Add to dictionary
                        {
                            prev-code >= 0 && dict-len < 4096 -> {
                                dict-prefix[dict-len] = prev-code
                                dict-suffix[dict-len] = entry-buf[0]
                                dict-len = dict-len + 1
                                {
                                    dict-len == (1 << code-size) && code-size < 12 -> {
                                        code-size = code-size + 1
                                    }
                                }
                            }
                        }
                        prev-code = code
                    }

                    -> {

                        ; Code not in dictionary yet
                        {
                            code == dict-len && prev-code >= 0 -> {

                                ; Output prev + first of prev
                                entry-buf []byte = with-cap(4096)
                                c = prev-code
                                {
                                    c >= 0 -> {
                                        entry-buf.push(dict-suffix[c])
                                        c = dict-prefix[c]
                                    }
                                } (c >= 0)
                                entry-len = entry-buf.len
                                j <- [0..entry-buf.len / 2): {
                                    tmp = entry-buf[j]
                                    entry-buf[j] = entry-buf[entry-len - 1 - j]
                                    entry-buf[entry-len - 1 - j] = tmp
                                }

                                ; The new entry-buf's first char is same as output's first
                                first-char = entry-buf[0]
                                j <- [0..entry-buf.len): {
                                    decoded.push(entry-buf[j])
                                }

                                ; Add to dictionary
                                {
                                    dict-len < 4096 -> {
                                        dict-prefix[dict-len] = prev-code
                                        dict-suffix[dict-len] = first-char
                                        dict-len = dict-len + 1
                                        {
                                            dict-len == (1 << code-size) && code-size < 12 -> {
                                                code-size = code-size + 1
                                            }
                                        }
                                    }
                                }
                                prev-code = code
                            }
                        }
                    }
                }
            }
        }
    } (byte-pos < data.len)
}

; ── Save (simple) ──

; gif.save: save as GIF89a with global color table using median-cut quantization
; Uses median-cut color quantization for better color fidelity.
; path str: output path
; img image: image to save (will be quantized to 256 colors)
; returns ok bool
save = (path str, img image) (ok bool) {
    w = img.width
    h = img.height
    npix = w * h

    ; Build palette using median-cut quantization
    palette, indexed = gif-median-cut(img, 256)
    n-colors = palette.len / 3

    ; Build full 256-entry palette (pad remaining with zeros)
    full-palette str = with-len(768)
    i <- [0..n-colors * 3): {
        full-palette[i] = palette[i]
    }

    ; Build output
    buf []byte = with-cap(13 + 768 + 10 + npix * 2)

    ; Header
    buf.push(71); G
    buf.push(73); I
    buf.push(70); F
    buf.push(56); 8
    buf.push(57); 9
    buf.push(97); a

    ; Logical screen descriptor
    buf.push(w & 255)
    buf.push((w >> 8) & 255)
    buf.push(h & 255)
    buf.push((h >> 8) & 255)
    buf.push(247); packed: GCT present, 256 colors
    buf.push(0); background color index
    buf.push(0); pixel aspect ratio

    ; Global color table (256 entries * 3 = 768 bytes)
    i <- [0..768): {
        buf.push(full-palette[i])
    }

    ; Image descriptor
    buf.push(44); 0x2C
    buf.push(0); left LE
    buf.push(0)
    buf.push(0); top LE
    buf.push(0)
    buf.push(w & 255)
    buf.push((w >> 8) & 255)
    buf.push(h & 255)
    buf.push((h >> 8) & 255)
    buf.push(0); no local color table, not interlaced

    ; LZW minimum code size
    buf.push(8)

    ; LZW encode
    lzw-data = gif-lzw-encode(indexed, npix, 8)

    ; Write in sub-blocks (max 255 bytes each)
    i = 0
    {
        i < lzw-data.len -> {
            block-size = lzw-data.len - i
            block-size > 255 -> block-size = 255
            buf.push(block-size)
            j <- [0..block-size): {
                buf.push(lzw-data[i + j])
            }
            i = i + block-size
        }
    } (i < lzw-data.len)
    buf.push(0); block terminator
    buf.push(59); trailer 0x3B

    ; Write file
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, buf.len)
    fs.close(wfd)
    ok = true
}

; gif-median-cut: median-cut color quantization
; Reduces image colors to at most n-colors using the median-cut algorithm.
; img image: source image
; n-colors i64: maximum number of colors (typically 256)
; returns palette []byte (n_colors*3 bytes), indexed []byte (w*h bytes)
gif-median-cut = (img image, n-colors i64) (palette []byte, indexed []byte) {
    w = img.width
    h = img.height
    npix = w * h

    ; Step 1: Collect pixel colors (sample if image is large)
    sample-step = 1
    {
        npix > 50000 -> {
            sample-step = npix / 50000 + 1
        }
    }

    ; Collect sampled colors into arrays
    max-samples = npix / sample-step + 1
    sample-r []byte = with-cap(max-samples)
    sample-g []byte = with-cap(max-samples)
    sample-b []byte = with-cap(max-samples)

    i <- [0..npix): {
        {
            i % sample-step == 0 -> {
                {
                    img.bands >= 3 -> {
                        sample-r.push(img.data[i * img.bands])
                        sample-g.push(img.data[i * img.bands + 1])
                        sample-b.push(img.data[i * img.bands + 2])
                    }

                    -> {
                        v = img.data[i * img.bands]
                        sample-r.push(v)
                        sample-g.push(v)
                        sample-b.push(v)
                    }
                }
            }
        }
    }

    n-samples = sample-r.len

    ; Step 2: Median-cut algorithm
    ; We maintain up to 256 boxes, each defined by:
    ; - start/end index into a sorted pixel array
    ; - the R/G/B range
    ; We split the box with the largest range along its widest channel
    ; at the median point.

    ; Sort indices by R, G, B separately (we sort per-box on demand)
    ; Instead of sorting, we use a simpler approach:
    ; Each box stores its pixel indices, and we split by finding the median
    ; of the widest channel using a counting sort.

    ; Box storage: up to 256 boxes
    ; Each box: [start, end, level]
    ; We store pixel indices per box in a flat array with start/end pointers
    ; We use a work array of pixel indices
    max-boxes = 256
    {
        n-colors > 256 -> n-colors = 256
    }

    ; Pixel index arrays: for each box, we have a contiguous range
    ; We use a single flat array and split it
    pix-idx []i64 = with-len(n-samples)
    i <- [0..n-samples): {
        pix-idx[i] = i
    }

    ; Box ranges: start, end (exclusive)
    box-start []i64 = with-len(max-boxes)
    box-end []i64 = with-len(max-boxes)
    n-boxes = 1
    box-start[0] = 0
    box-end[0] = n-samples

    ; Split boxes until we have n-colors boxes
    {
        n-boxes < n-colors -> {
            ; Find box with largest range
            best-box = -1
            best-range = 0
            best-channel = 0  ; 0=R, 1=G, 2=B
            bi <- [0..n-boxes): {
                {
                    box-end[bi] - box-start[bi] > 1 -> {
                        ; Compute range for each channel
                        r-min = 255
                        r-max = 0
                        g-min = 255
                        g-max = 0
                        b-min = 255
                        b-max = 0
                        pi <- [box-start[bi]..box-end[bi]): {
                            pidx = pix-idx[pi]
                            r = sample-r[pidx]
                            g = sample-g[pidx]
                            b = sample-b[pidx]
                            {
                                r < r-min -> r-min = r
                            }
                            {
                                r > r-max -> r-max = r
                            }
                            {
                                g < g-min -> g-min = g
                            }
                            {
                                g > g-max -> g-max = g
                            }
                            {
                                b < b-min -> b-min = b
                            }
                            {
                                b > b-max -> b-max = b
                            }
                        }
                        r-range = r-max - r-min
                        g-range = g-max - g-min
                        b-range = b-max - b-min
                        ; Pick widest channel
                        max-range = r-range
                        channel = 0
                        {
                            g-range > max-range -> {
                                max-range = g-range
                                channel = 1
                            }
                        }
                        {
                            b-range > max-range -> {
                                max-range = b-range
                                channel = 2
                            }
                        }
                        {
                            max-range > best-range -> {
                                best-range = max-range
                                best-box = bi
                                best-channel = channel
                            }
                        }
                    }
                }
            }

            {
                best-box >= 0 -> {
                    ; Split best_box along best_channel at median
                    ; Sort the pixels in this box by the selected channel
                    ; Use simple insertion sort (boxes are usually small)
                    bs = box-start[best-box]
                    be = box-end[best-box]
                    n-in-box = be - bs

                    ; Insertion sort by channel value
                    si <- [1..n-in-box): {
                        sj = si
                        {
                            sj > 0 -> {
                                ; Compare pix-idx[bs+sj] with pix-idx[bs+sj-1]
                                ; by the selected channel
                                p1 = pix-idx[bs + sj]
                                p0 = pix-idx[bs + sj - 1]
                                v1 = 0
                                v0 = 0
                                {
                                    best-channel == 0 -> {
                                        v1 = sample-r[p1]
                                        v0 = sample-r[p0]
                                    }

                                    best-channel == 1 -> {
                                        v1 = sample-g[p1]
                                        v0 = sample-g[p0]
                                    }

                                    best-channel == 2 -> {
                                        v1 = sample-b[p1]
                                        v0 = sample-b[p0]
                                    }
                                }
                                {
                                    v1 < v0 -> {
                                        ; Swap
                                        tmp = pix-idx[bs + sj]
                                        pix-idx[bs + sj] = pix-idx[bs + sj - 1]
                                        pix-idx[bs + sj - 1] = tmp
                                        sj = sj - 1
                                    }
                                }
                            }
                        } (sj > 0)
                    }

                    ; Split at median
                    mid = bs + (be - bs) / 2
                    {
                        mid > bs && mid < be -> {
                            ; Move current box end to mid, create new box
                            box-start[n-boxes] = mid
                            box-end[n-boxes] = be
                            box-end[best-box] = mid
                            n-boxes = n-boxes + 1
                        }
                    }
                }

                -> {
                    ; No splittable box found
                    n-boxes = n-colors
                }
            }
        }
    } (n-boxes < n-colors)

    ; Build palette: average color per box
    palette = with-cap(n-boxes * 3)
    bi <- [0..n-boxes): {
        {
            box-end[bi] > box-start[bi] -> {
                r-sum = 0
                g-sum = 0
                b-sum = 0
                cnt = 0
                pi <- [box-start[bi]..box-end[bi]): {
                    pidx = pix-idx[pi]
                    r-sum = r-sum + sample-r[pidx]
                    g-sum = g-sum + sample-g[pidx]
                    b-sum = b-sum + sample-b[pidx]
                    cnt = cnt + 1
                }
                {
                    cnt > 0 -> {
                        palette.push((r-sum / cnt) & 255)
                        palette.push((g-sum / cnt) & 255)
                        palette.push((b-sum / cnt) & 255)
                    }

                    -> {
                        palette.push(0)
                        palette.push(0)
                        palette.push(0)
                    }
                }
            }

            -> {
                palette.push(0)
                palette.push(0)
                palette.push(0)
            }
        }
    })

    n-pal-colors = palette.len / 3

    ; Map each pixel to nearest palette color
    indexed = with-len(npix)
    i <- [0..npix): {
        {
            img.bands >= 3 -> {
                r = img.data[i * img.bands]
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]
            }

            -> {
                r = img.data[i * img.bands]
                g = r
                b = r
            }
        }

        ; Find nearest palette color
        best-idx = 0
        best-dist = 999999
        ci <- [0..n-pal-colors): {
            pr = palette[ci * 3]
            pg = palette[ci * 3 + 1]
            pb = palette[ci * 3 + 2]
            dr = r - pr
            {
                dr < 0 -> dr = -dr
            }
            dg = g - pg
            {
                dg < 0 -> dg = -dg
            }
            db = b - pb
            {
                db < 0 -> db = -db
            }
            dist = dr + dg + db
            {
                dist < best-dist -> {
                    best-dist = dist
                    best-idx = ci
                }
            }
        }
        indexed[i] = best-idx
    }
}

; gif-lzw-encode: LZW encoder for GIF
; data []byte: input data (indexed pixels)
; data-len i64: data length
; min-code i64: minimum code size (typically 8)
; returns encoded []byte
gif-lzw-encode = (data []byte, data-len i64, min-code i64) (encoded []byte) {
    clear-code = 1 << min-code
    end-code = clear-code + 1
    code-size = min-code + 1

    ; Dictionary: for each code (0..4095), store the prefix code and suffix byte
    ; dict-prefix[code] = prefix code (-1 for root entries)
    ; dict-suffix[code] = suffix byte
    dict-prefix []i64 = with-len(4096)
    dict-suffix []byte = with-len(4096)
    dict-len = end-code + 1

    ; Initialize root entries
    i <- [0..clear-code): {
        dict-prefix[i] = -1
        dict-suffix[i] = i
    }

    ; Bit writer state
    bit-buf i64 = 0
    bit-count i64 = 0
    encoded []byte = with-cap(data.len)

    ; Helper: write a code to the bitstream
    ; Using inline code since Nolang functions modify parameters by reference

    ; Output clear code
    bit-buf = bit-buf | (clear-code << bit-count)
    bit-count = bit-count + code-size
    {
        bit-count >= 8 -> {
            encoded.push(bit-buf & 255)
            bit-buf = bit-buf >> 8
            bit-count = bit-count - 8
        }
    } (bit-count >= 8)

    ; LZW encode: find longest match in dictionary
    {
        data.len > 0 -> {
            ; Start with the first character as current code
            cur-code i64 = data[0]
            i = 1
            {
                i < data.len -> {
                    next-byte = data[i]

                    ; Search for (cur-code, next-byte) in dictionary
                    found = -1
                    j <- [end-code + 1..dict-len): {
                        {
                            found == -1 && dict-prefix[j] == cur-code && dict-suffix[j] == next-byte -> {
                                found = j
                            }
                        }
                    }

                    {
                        found >= 0 -> {
                            ; Extend current match
                            cur-code = found
                        }

                        -> {
                            ; No match: output cur-code, add (cur-code, next-byte) to dict
                            bit-buf = bit-buf | (cur-code << bit-count)
                            bit-count = bit-count + code-size
                            {
                                bit-count >= 8 -> {
                                    encoded.push(bit-buf & 255)
                                    bit-buf = bit-buf >> 8
                                    bit-count = bit-count - 8
                                }
                            } (bit-count >= 8)

                            ; Add new entry to dictionary
                            {
                                dict-len < 4096 -> {
                                    dict-prefix[dict-len] = cur-code
                                    dict-suffix[dict-len] = next-byte
                                    dict-len = dict-len + 1
                                    {
                                        dict-len == (1 << code-size) && code-size < 12 -> {
                                            code-size = code-size + 1
                                        }
                                    }
                                }

                                -> {
                                    ; Dictionary full: output clear code
                                    bit-buf = bit-buf | (clear-code << bit-count)
                                    bit-count = bit-count + code-size
                                    {
                                        bit-count >= 8 -> {
                                            encoded.push(bit-buf & 255)
                                            bit-buf = bit-buf >> 8
                                            bit-count = bit-count - 8
                                        }
                                    } (bit-count >= 8)
                                    dict-len = end-code + 1
                                    code-size = min-code + 1
                                }
                            }
                            cur-code = next-byte
                        }
                    }

                    i = i + 1
                }
            } (i < data.len)

            ; Output the last code
            bit-buf = bit-buf | (cur-code << bit-count)
            bit-count = bit-count + code-size
            {
                bit-count >= 8 -> {
                    encoded.push(bit-buf & 255)
                    bit-buf = bit-buf >> 8
                    bit-count = bit-count - 8
                }
            } (bit-count >= 8)
        }
    }

    ; Output end code
    bit-buf = bit-buf | (end-code << bit-count)
    bit-count = bit-count + code-size
    {
        bit-count >= 8 -> {
            encoded.push(bit-buf & 255)
            bit-buf = bit-buf >> 8
            bit-count = bit-count - 8
        }
    } (bit-count >= 8)
    {
        bit-count > 0 -> {
            encoded.push(bit-buf & 255)
        }
    }
}

; ── GIF Animation (multi-frame) ──

; gif.save-frames: save multiple frames as an animated GIF
; path str: output file path
; frames []image: array of image frames (all same size, 3+ bands)
; delays []i64: delay per frame in centiseconds (1/100 sec)
; returns ok bool: true on success
save-frames = (path str, frames []image, delays []i64) (ok bool) {
    n-frames = frames.len
    {
        n-frames == 0 -> {
            ok = false
            return
        }
    }
    w = frames[0].width
    h = frames[0].height
    npix = w * h

    ; Build a shared global palette from the first frame
    palette, indexed0 = gif-median-cut(frames[0], 256)
    n-colors = palette.len / 3

    ; Pad palette to 256 entries
    full-palette str = with-len(768)
    i <- [0..n-colors * 3): {
        full-palette[i] = palette[i]
    }

    ; Build output buffer
    buf []byte = with-cap(13 + 768 + 32 + n-frames * (npix * 2 + 20))

    ; GIF header
    buf.push(71); G
    buf.push(73); I
    buf.push(50); F
    buf.push(56); 8
    buf.push(57); 9
    buf.push(97); a

    ; Logical screen descriptor
    buf.push(w & 255)
    buf.push((w >> 8) & 255)
    buf.push(h & 255)
    buf.push((h >> 8) & 255)
    buf.push(247); GCT present, 256 colors
    buf.push(0); background color index
    buf.push(0); pixel aspect ratio

    ; Global color table
    i <- [0..768): {
        buf.push(full-palette[i])
    }

    ; Netscape extension for animation looping
    buf.push(33); extension
    buf.push(255); application
    buf.push(11); block size
    buf.push(78); N
    buf.push(69); E
    buf.push(84); T
    buf.push(83); S
    buf.push(67); C
    buf.push(65); A
    buf.push(80); P
    buf.push(69); E
    buf.push(50); 2
    buf.push(46); .
    buf.push(48); 0
    buf.push(3); sub-block size
    buf.push(1); loop count follows
    buf.push(0); loop count LE (0 = infinite)
    buf.push(0)
    buf.push(0); block terminator

    ; Write each frame
    fi <- [0..n-frames): {
        frame = frames[fi]
        delay = delays[fi]
        {
            delay < 2 -> delay = 2
        }

        ; Quantize this frame using the shared palette
        ; (re-use global palette for consistency)
        indexed = gif-quantize-with-palette(frame, palette, n-colors)

        ; Graphic control extension
        buf.push(33); extension
        buf.push(249); graphic control
        buf.push(4); block size
        ; packed: disposal=2 (restore to background), no user input, no transparency
        disposal = 2
        gce-packed = (disposal << 2)
        {
            fi == n-frames - 1 -> {
                gce-packed = (3 << 2)
            }
        }
        buf.push(gce-packed)
        buf.push(delay & 255)
        buf.push((delay >> 8) & 255)
        buf.push(0); transparent color index (none)
        buf.push(0); block terminator

        ; Image descriptor
        buf.push(44); 0x2C
        buf.push(0); left LE
        buf.push(0)
        buf.push(0); top LE
        buf.push(0)
        buf.push(w & 255)
        buf.push((w >> 8) & 255)
        buf.push(h & 255)
        buf.push((h >> 8) & 255)
        buf.push(0); no local color table

        ; LZW minimum code size
        buf.push(8)

        ; LZW encode
        lzw-data = gif-lzw-encode(indexed, npix, 8)

        ; Write sub-blocks
        si = 0
        {
            si < lzw-data.len -> {
                block-size = lzw-data.len - si
                block-size > 255 -> block-size = 255
                buf.push(block-size)
                j <- [0..block-size): {
                    buf.push(lzw-data[si + j])
                }
                si = si + block-size
            }
        } (si < lzw-data.len)
        buf.push(0); block terminator
    }

    ; Trailer
    buf.push(59); 0x3B

    ; Write file
    wfd = fs.open-write(path)
    {
        wfd < 0 -> {
            ok = false
            return
        }
    }
    fs.write(wfd, buf, buf.len)
    fs.close(wfd)
    ok = true
}

; gif-quantize-with-palette: quantize an image using a pre-existing palette
; img image: source image
; palette []byte: palette data (n_colors * 3 bytes)
; n-colors i64: number of colors in palette
; returns indexed []byte: indexed pixel data
gif-quantize-with-palette = (img image, palette []byte, n-colors i64) (indexed []byte) {
    npix = img.width * img.height
    indexed = with-len(npix)
    i <- [0..npix): {
        r = img.data[i * img.bands]
        {
            img.bands >= 3 -> {
                g = img.data[i * img.bands + 1]
                b = img.data[i * img.bands + 2]
            }

            -> {
                g = r
                b = r
            }
        }
        ; Find nearest palette entry
        best-idx = 0
        best-dist = 1000000
        ci <- [0..n-colors): {
            pr = palette[ci * 3]
            pg = palette[ci * 3 + 1]
            pb = palette[ci * 3 + 2]
            dr = r - pr
            dg = g - pg
            db = b - pb
            dist = dr * dr + dg * dg + db * db
            {
                dist < best-dist -> {
                    best-dist = dist
                    best-idx = ci
                }
            }
        }
        indexed[i] = best-idx
    }
}
