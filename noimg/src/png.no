; png.no — PNG (Portable Network Graphics) format read/write
; Supports:
;   Color types: 0 (gray), 2 (RGB), 6 (RGBA)
;   Bit depths: 8
;   Compression: zlib (using std zlib module)
;   Interlacing: non-interlaced + Adam7 interlaced
;
; PNG file layout:
;   Signature (8 bytes): 137 80 78 71 13 10 26 10
;   Chunks: each = length(4) + type(4) + data(length) + CRC(4)
;   Critical chunks: IHDR, IDAT, IEND
;   Ancillary chunks: tEXt, tRNS, gAMA, etc.

; PNG signature bytes
# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.new-u16
# /noimg/src/image.copy
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

; ── CRC32 ──
; CRC-32 (IEEE 802.3) using bitwise computation
; Polynomial: 0xEDB88320 (reflected)

; png-crc32: compute CRC32 of data (bitwise)
; data str: input
; start i64: starting position
; len i64: length
; returns crc i64
png-crc32 = (data str, start i64, len i64) (crc i64) {
    crc = 4294967295
    i <- [0..len): {
        b = data[start + i] & 255
        crc = crc ^ b
        j <- [0..8): {
            {
                crc & 1 != 0 -> {
                    crc = (crc >> 1) ^ 3988292384
                }

                -> {
                    crc = crc >> 1
                }
            }
        }
    }
    crc = crc ^ 4294967295
}

; ── Load ──

; png.load: load a PNG file
; path str: file path
; returns img ?image: loaded image, nil on error
load = (path str) (img ?image) {
    ; CRC32 uses bitwise computation, no table init needed
    data = fs.read-file(path)
    data.len < 24 -> {
        img = nil
        return
    }

    ; Check PNG signature
    (data[0] & 255) == 137 && (data[1] & 255) == 80 && (data[2] & 255) == 78 && (data[3] & 255) == 71 -> {}

    -> {
        img = nil
        return
    }
    pos = 8
    w = 0
    h = 0
    bit-depth = 0
    color-type = 0
    compression = 0
    filter = 0
    interlace = 0
    idat-data []byte = with-cap(0)
    trns []byte = with-cap(0)
    palette []byte = with-cap(0)
    has-trns = false
    has-palette = false

    ; Parse chunks
    {
        pos < data.len -> {
            {
                pos + 8 > data.len -> break
            }

            ; Read chunk length (big-endian 32-bit)
            chunk-len = ((data[pos] & 255) << 24) | ((data[pos + 1] & 255) << 16) | ((data[pos + 2] & 255) << 8) | (data[pos + 3] & 255)
            pos = pos + 4

            ; Read chunk type (4 bytes)
            chunk-type = data.slice(pos, pos + 4)
            pos = pos + 4
            chunk-type == 'IHDR' -> {

                ; IHDR: width(4) height(4) bitdepth(1) colortype(1) compression(1) filter(1) interlace(1)
                w = ((data[pos] & 255) << 24) | ((data[pos + 1] & 255) << 16) | ((data[pos + 2] & 255) << 8) | (data[pos + 3] & 255)
                h = ((data[pos + 4] & 255) << 24) | ((data[pos + 5] & 255) << 16) | ((data[pos + 6] & 255) << 8) | (data[pos + 7] & 255)
                bit-depth = data[pos + 8] & 255
                color-type = data[pos + 9] & 255
                compression = data[pos + 10] & 255
                filter = data[pos + 11] & 255
                interlace = data[pos + 12] & 255
            }
            chunk-type == 'IDAT' -> {

                ; Append to idat-data
                i <- [0..chunk-len): {
                    idat-data.push(data[pos + i] & 255)
                }
            }
            chunk-type == 'PLTE' -> {
                has-palette = true
                i <- [0..chunk-len): {
                    palette.push(data[pos + i] & 255)
                }
            }
            chunk-type == 'tRNS' -> {
                has-trns = true
                i <- [0..chunk-len): {
                    trns.push(data[pos + i] & 255)
                }
            }
            chunk-type == 'IEND' -> {
                break
            }
            pos = pos + chunk-len + 4
        }
    } (pos < data.len)
    {
w <= 0 || h <= 0 || w > 65535 || h > 65535 -> {
img = nil
            return
        }
        {
            bit-depth != 8 && bit-depth != 16 -> {
                img = nil
                return
            }
        }
    }

    ; Determine bands from color type
    bands = 4
    {
        color-type == 0 -> bands = 1

        color-type == 2 -> bands = 3

        color-type == 6 -> bands = 4

        color-type == 3 -> bands = 3

        -> {
            img = nil
            return
        }
    }

    ; bytes-per-pixel depends on bit depth
    bytes-per-pixel = bands
    {
        bit-depth == 16 -> {
            bytes-per-pixel = bands * 2
        }
    }
    {
        color-type == 3 -> bytes-per-pixel = 1
    }
    ; Decompress IDAT using zlib
    raw = gzip.gzip-decompress(idat-data)

    ; Create output image — U16 if bit-depth == 16
    is-u16 = false
    {
        bit-depth == 16 -> is-u16 = true
    }
    {
        is-u16 -> {
            _d str = with-len(w * h * bands * 2)
            tmp = image.new-u16(w, h, bands)
        }

        -> {
            _d str = with-len(w * h * bands)
            tmp = image.new-from-data(w, h, bands, _d)
        }
    }

    ; Initialize image to zero
    {
        is-u16 -> {
            i <- [0..w * h * bands * 2): {
                tmp.data[i] = 0
            }
        }

        -> {
            i <- [0..w * h * bands): {
                tmp.data[i] = 0
            }
        }
    }

    {
        interlace == 1 -> {
            ; Adam7 interlacing: 7 passes
            ; Each pass has different starting offset and step
            ; Pass:  start_x, start_y, step_x, step_y
            ;   0:     0,      0,      8,      8
            ;   1:     4,      0,      8,      8
            ;   2:     0,      4,      4,      8
            ;   3:     2,      0,      4,      4
            ;   4:     0,      2,      2,      4
            ;   5:     1,      0,      2,      2
            ;   6:     0,      1,      1,      2
            pass-starts-x [7] = [0, 4, 0, 2, 0, 1, 0]
            pass-starts-y [7] = [0, 0, 4, 0, 2, 0, 1]
            pass-steps-x [7] = [8, 8, 4, 4, 2, 2, 1]
            pass-steps-y [7] = [8, 8, 8, 4, 4, 2, 2]

            raw-pos = 0
            pass <- [0..7): {
                sx-start = pass-starts-x[pass]
                sy-start = pass-starts-y[pass]
                sx-step = pass-steps-x[pass]
                sy-step = pass-steps-y[pass]

                ; Number of pixels per row in this pass
                pass-w = (w - sx-start + sx-step - 1) / sx-step
                pass-h = (h - sy-start + sy-step - 1) / sy-step

                {
                    pass-w > 0 && pass-h > 0 -> {
                        pass-stride = pass-w * bytes-per-pixel
                        pass-row-len = pass-stride + 1

                        ; Allocate previous row for filtering
                        pass-prev str = with-len(pass-stride)
                        pi <- [0..pass-stride): {
                            pass-prev[pi] = 0
                        }

                        py <- [0..pass-h): {
                            {
                                raw-pos + pass-row-len > raw.len -> break
                            }
                            img-y = sy-start + py * sy-step

                            ; Read filter type
                            filter-type = raw[raw-pos]

                            ; Copy current row
                            pass-cur str = with-len(pass-stride)
                            pi <- [0..pass-stride): {
                                pass-cur[pi] = raw[raw-pos + 1 + pi]
                            }

                            ; Apply filter
                            {
                                filter-type == 0 -> {
                                    ; None
                                }

                                filter-type == 1 -> {
                                    pi <- [bytes-per-pixel..pass-stride): {
                                        pass-cur[pi] = pass-cur[pi] + pass-cur[pi - bytes-per-pixel]
                                    }
                                }

                                filter-type == 2 -> {
                                    pi <- [0..pass-stride): {
                                        pass-cur[pi] = pass-cur[pi] + pass-prev[pi]
                                    }
                                }

                                filter-type == 3 -> {
                                    pi <- [0..pass-stride): {
                                        left = 0
                                        pi >= bytes-per-pixel -> {
                                            left = pass-cur[pi - bytes-per-pixel]
                                        }
                                        above = pass-prev[pi]
                                        pass-cur[pi] = pass-cur[pi] + (left + above) / 2
                                    }
                                }

                                filter-type == 4 -> {
                                    pi <- [0..pass-stride): {
                                        left = 0
                                        pi >= bytes-per-pixel -> {
                                            left = pass-cur[pi - bytes-per-pixel]
                                        }
                                        above = pass-prev[pi]
                                        above-left = 0
                                        pi >= bytes-per-pixel -> {
                                            above-left = pass-prev[pi - bytes-per-pixel]
                                        }
                                        p = left + above - above-left
                                        pa = left - above-left
                                        {
                                            pa < 0 -> pa = -pa
                                        }
                                        pb = above - above-left
                                        {
                                            pb < 0 -> pb = -pb
                                        }
                                        pc = p - above-left
                                        {
                                            pc < 0 -> pc = -pc
                                        }
                                        predictor = 0
                                        {
                                            pa <= pb && pa <= pc -> {
                                                predictor = left
                                            }

                                            pb <= pc -> {
                                                predictor = above
                                            }

                                            -> {
                                                predictor = above-left
                                            }
                                        }
                                        pass-cur[pi] = pass-cur[pi] + predictor
                                    }
                                }
                            }

                            ; Write pixels to image at correct positions
                            px <- [0..pass-w): {
                                img-x = sx-start + px * sx-step
                                {
                                    img-x < w && img-y < h -> {
                                        {
                                            color-type == 3 -> {
                                                idx = pass-cur[px]
                                                {
                                                    idx * 3 + 2 < palette.len -> {
                                                        dst = (img-y * w + img-x) * 3
                                                        tmp.data[dst] = palette[idx * 3]
                                                        tmp.data[dst + 1] = palette[idx * 3 + 1]
                                                        tmp.data[dst + 2] = palette[idx * 3 + 2]
                                                    }
                                                }
                                            }

                                            color-type == 0 -> {
                                                dst = img-y * w + img-x
                                                tmp.data[dst] = pass-cur[px]
                                            }

                                            -> {
                                                dst = (img-y * w + img-x) * bands
                                                b <- [0..bands): {
                                                    tmp.data[dst + b] = pass-cur[px * bytes-per-pixel + b]
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            ; Save current row as prev
                            pi <- [0..pass-stride): {
                                pass-prev[pi] = pass-cur[pi]
                            }

                            raw-pos = raw-pos + pass-row-len
                        }
                    }
                }
            }
        }

        -> {
            ; Non-interlaced
            stride = w * bytes-per-pixel
            row-len = stride + 1

            ; Allocate filtered row buffers
            prev-row str = with-len(stride)
            i <- [0..stride): {
                prev-row[i] = 0
            }
            y <- [0..h): {
                row-start = y * row-len
                {
                    row-start + row-len > raw.len -> break
                }
                filter-type = raw[row-start]

                ; Copy current row
                cur-row str = with-len(stride)
                i <- [0..stride): {
                    cur-row[i] = raw[row-start + 1 + i]
                }

                ; Apply filter
                {
                    filter-type == 0 -> {
                        ; None
                    }

                    filter-type == 1 -> {

                        ; Sub: raw + left
                        x <- [bytes-per-pixel..stride): {
                            cur-row[x] = cur-row[x] + cur-row[x - bytes-per-pixel]
                        }
                    }

                    filter-type == 2 -> {

                        ; Up: raw + above
                        x <- [0..stride): {
                            cur-row[x] = cur-row[x] + prev-row[x]
                        }
                    }

                    filter-type == 3 -> {

                        ; Average: raw + (left + above) / 2
                        x <- [0..stride): {
                            left = 0
                            x >= bytes-per-pixel -> {
                                left = cur-row[x - bytes-per-pixel]
                            }
                            above = prev-row[x]
                            cur-row[x] = cur-row[x] + (left + above) / 2
                        }
                    }

                    filter-type == 4 -> {

                        ; Paeth: raw + Paeth predictor
                        x <- [0..stride): {
                            left = 0
                            x >= bytes-per-pixel -> {
                                left = cur-row[x - bytes-per-pixel]
                            }
                            above = prev-row[x]
                            above-left = 0
                            x >= bytes-per-pixel -> {
                                above-left = prev-row[x - bytes-per-pixel]
                            }

                            ; Paeth predictor
                            p = left + above - above-left
                            pa = left - above-left
                            {
                                pa < 0 -> pa = -pa
                            }
                            pb = above - above-left
                            {
                                pb < 0 -> pb = -pb
                            }
                            pc = p - above-left
                            {
                                pc < 0 -> pc = -pc
                            }
                            predictor = 0
                            {
                                pa <= pb && pa <= pc -> {
                                    predictor = left
                                }

                                pb <= pc -> {
                                    predictor = above
                                }

                                -> {
                                    predictor = above-left
                                }
                            }
                            cur-row[x] = cur-row[x] + predictor
                        }
                    }
                }

                ; Write pixels to image
                {
                    color-type == 3 -> {

                        ; Indexed color (always 8-bit)
                        x <- [0..w): {
                            idx = cur-row[x]
                            {
                                idx * 3 + 2 < palette.len -> {
                                    image.set-pixel(tmp, x, y, 0, palette[idx * 3])
                                    image.set-pixel(tmp, x, y, 1, palette[idx * 3 + 1])
                                    image.set-pixel(tmp, x, y, 2, palette[idx * 3 + 2])
                                }
                            }
                        }
                    }

                    color-type == 0 -> {

                        ; Grayscale
                        x <- [0..w): {
                            {
                                is-u16 -> {
                                    v = (cur-row[x * 2] & 255) << 8 | (cur-row[x * 2 + 1] & 255)
                                    image.set-pixel(tmp, x, y, 0, v)
                                }

                                -> {
                                    image.set-pixel(tmp, x, y, 0, cur-row[x])
                                }
                            }
                        }
                    }

                    -> {

                        ; RGB / RGBA
                        x <- [0..w): {
                            b <- [0..bands): {
                                {
                                    is-u16 -> {
                                        v = (cur-row[x * bytes-per-pixel + b * 2] & 255) << 8 | (cur-row[x * bytes-per-pixel + b * 2 + 1] & 255)
                                        image.set-pixel(tmp, x, y, b, v)
                                    }

                                    -> {
                                        image.set-pixel(tmp, x, y, b, cur-row[x * bands + b])
                                    }
                                }
                            }
                        }
                    }
                }

                ; Save current row as prev
                i <- [0..stride): {
                    prev-row[i] = cur-row[i]
                }
            }
        }
    }

    ; Apply tRNS transparency if present
    {
        has-trns -> {
            {
                color-type == 0 -> {
                    ; Grayscale tRNS: 2 bytes (16-bit gray value)
                    ; Pixels matching this value get alpha=0, others alpha=255
                    {
                        trns.len >= 2 -> {
                            trns-val = ((trns[0] & 255) << 8) | (trns[1] & 255)
                            ; Create RGBA image
                            rgba-img = image.new(w, h, 4)
                            i <- [0..w * h): {
                                g = tmp.data[i]
                                a = 255
                                {
                                    is-u16 -> {
                                        {
                                            g == trns-val -> a = 0
                                        }
                                    }

                                    -> {
                                        {
                                            g == (trns-val >> 8) -> a = 0
                                        }
                                    }
                                }
                                rgba-img.data[i * 4] = g
                                rgba-img.data[i * 4 + 1] = g
                                rgba-img.data[i * 4 + 2] = g
                                rgba-img.data[i * 4 + 3] = a
                            }
                            tmp = rgba-img
                        }
                    }
                }

                color-type == 2 -> {
                    ; RGB tRNS: 6 bytes (R, G, B — each 16-bit)
                    ; Pixels matching get alpha=0, others alpha=255
                    {
                        trns.len >= 6 -> {
                            trns-r = ((trns[0] & 255) << 8) | (trns[1] & 255)
                            trns-g = ((trns[2] & 255) << 8) | (trns[3] & 255)
                            trns-b = ((trns[4] & 255) << 8) | (trns[5] & 255)
                            rgba-img = image.new(w, h, 4)
                            i <- [0..w * h): {
                                r = tmp.data[i * 3]
                                g = tmp.data[i * 3 + 1]
                                b = tmp.data[i * 3 + 2]
                                a = 255
                                {
                                    is-u16 -> {
                                        {
                                            r == trns-r && g == trns-g && b == trns-b -> a = 0
                                        }
                                    }

                                    -> {
                                        {
                                            r == (trns-r >> 8) && g == (trns-g >> 8) && b == (trns-b >> 8) -> a = 0
                                        }
                                    }
                                }
                                rgba-img.data[i * 4] = r
                                rgba-img.data[i * 4 + 1] = g
                                rgba-img.data[i * 4 + 2] = b
                                rgba-img.data[i * 4 + 3] = a
                            }
                            tmp = rgba-img
                        }
                    }
                }

                color-type == 3 -> {
                    ; Indexed tRNS: one alpha byte per palette entry
                    ; Expand to RGBA
                    {
                        has-palette -> {
                            rgba-img = image.new(w, h, 4)
                            i <- [0..w * h): {
                                idx = tmp.data[i * 3]  ; This was set from palette R
                                ; Actually for indexed, tmp already has RGB expanded.
                                ; We need the original index, but it's lost.
                                ; Instead, match by RGB value to find the index.
                                ; This is inefficient but correct for tRNS on indexed.
                                ; Better: store indices during decode.
                                ; For now, copy RGB and set alpha from palette tRNS
                                r = tmp.data[i * 3]
                                g = tmp.data[i * 3 + 1]
                                b = tmp.data[i * 3 + 2]
                                a = 255
                                ; Search palette for matching entry
                                pi <- [0..palette.len / 3): {
                                    {
                                        palette[pi * 3] == r && palette[pi * 3 + 1] == g && palette[pi * 3 + 2] == b -> {
                                            {
                                                pi < trns.len -> a = trns[pi]
                                            }
                                        }
                                    }
                                }
                                rgba-img.data[i * 4] = r
                                rgba-img.data[i * 4 + 1] = g
                                rgba-img.data[i * 4 + 2] = b
                                rgba-img.data[i * 4 + 3] = a
                            }
                            tmp = rgba-img
                        }
                    }
                }
            }
        }
    }

    img = tmp
}

; ── Save ──

; png.save: save an image as PNG (8-bit or 16-bit, color type auto-selected)
; path str: output path
; img image: image to save
; returns ok bool
save = (path str, img image) (ok bool) {
    ; Determine bit depth
    bit-depth = 8
    {
        img.depth == 2 -> bit-depth = 16
    }
    color-type = 2
    bands = 3
    {
        img.bands == 1 -> {
            color-type = 0
            bands = 1
        }

        img.bands == 4 -> {
            color-type = 6
            bands = 4
        }
    }

    ; Build raw data with filter bytes (filter=0 for all rows)
    bytes-per-channel = 1
    {
        bit-depth == 16 -> bytes-per-channel = 2
    }
    stride = img.width * bands * bytes-per-channel
    row-len = stride + 1
    raw str = with-len(row-len * img.height)
    y <- [0..img.height): {
        raw[y * row-len] = 0
        {
            img.bands == bands -> {
                x <- [0..img.width): {
                    b <- [0..bands): {
                        v = image.get-pixel(img, x, y, b)
                        {
                            bit-depth == 16 -> {
                                raw[y * row-len + 1 + (x * bands + b) * 2] = (v >> 8) & 255
                                raw[y * row-len + 1 + (x * bands + b) * 2 + 1] = v & 255
                            }

                            -> {
                                raw[y * row-len + 1 + x * bands + b] = v
                            }
                        }
                    }
                }
            }

            -> {

                ; Need conversion
                x <- [0..img.width): {
                    {
                        bands == 1 -> {
                            {
                                img.bands >= 3 -> {
                                    r = image.get-pixel(img, x, y, 0)
                                    g = image.get-pixel(img, x, y, 1)
                                    b = image.get-pixel(img, x, y, 2)
                                    v = (r * 299 + g * 587 + b * 114) / 1000
                                }

                                -> {
                                    v = image.get-pixel(img, x, y, 0)
                                }
                            }
                            {
                                bit-depth == 16 -> {
                                    raw[y * row-len + 1 + x * 2] = (v >> 8) & 255
                                    raw[y * row-len + 1 + x * 2 + 1] = v & 255
                                }

                                -> {
                                    raw[y * row-len + 1 + x] = v
                                }
                            }
                        }

                        -> {
                            i <- [0..bands): {
                                {
                                    i < img.bands -> {
                                        v = image.get-pixel(img, x, y, i)
                                    }

                                    -> {
                                        v = 255
                                        {
                                            bit-depth == 16 -> v = 65535
                                        }
                                    }
                                }
                                {
                                    bit-depth == 16 -> {
                                        raw[y * row-len + 1 + (x * bands + i) * 2] = (v >> 8) & 255
                                        raw[y * row-len + 1 + (x * bands + i) * 2 + 1] = v & 255
                                    }

                                    -> {
                                        raw[y * row-len + 1 + x * bands + i] = v
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    ; Compress with zlib
    compressed = gzip.gzip-compress(raw)

    ; Build PNG file
    buf []byte = with-cap(8 + 25 + 12 + compressed.len + 12 + 12)

    ; PNG signature
    buf.push(137)
    buf.push(80)
    buf.push(78)
    buf.push(71)
    buf.push(13)
    buf.push(10)
    buf.push(26)
    buf.push(10)

    ; IHDR chunk (13 bytes data)
    png-write-chunk(buf, 'IHDR', png-build-ihdr(img.width, img.height, bit-depth, color-type))

    ; IDAT chunk
    png-write-chunk-raw(buf, 'IDAT', compressed)

    ; IEND chunk (0 bytes data)
    iend-data []byte = with-cap(0)
    png-write-chunk(buf, 'IEND', iend-data)

    ; Write file
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, buf.len)
    fs.close(wfd)
    ok = true
}

; png-build-ihdr: build IHDR chunk data (13 bytes)
; w i64: width
; h i64: height
; bit-depth i64: bit depth
; color-type i64: color type
; returns data []byte
png-build-ihdr = (w i64, h i64, bit-depth i64, color-type i64) (data []byte) {
    data []byte = with-len(13)
    data[0] = (w >> 24) & 255
    data[1] = (w >> 16) & 255
    data[2] = (w >> 8) & 255
    data[3] = w & 255
    data[4] = (h >> 24) & 255
    data[5] = (h >> 16) & 255
    data[6] = (h >> 8) & 255
    data[7] = h & 255
    data[8] = bit-depth & 255
    data[9] = color-type & 255
    data[10] = 0; compression (zlib)
    data[11] = 0; filter (adaptive)
    data[12] = 0; interlace (none)
}

; png-write-chunk: write a chunk to output buffer (with CRC)
; out []byte: output buffer
; type-str str: 4-char chunk type
; data []byte: chunk data
png-write-chunk = (out []byte, type-str str, data []byte) {

    ; Length (big-endian)
    len = data.len
    out.push((len >> 24) & 255)
    out.push((len >> 16) & 255)
    out.push((len >> 8) & 255)
    out.push(len & 255)

    ; Type
    type-bytes = type-str.to-bytes()
    i <- [0..4): {
        out.push(type-bytes[i])
    }

    ; Data
    i <- [0..data.len): {
        out.push(data[i])
    }

    ; CRC (over type + data)
    crc-data = type-str.to-bytes()

    ; Build a combined buffer for CRC
    combined []byte = with-cap(4 + data.len)
    i <- [0..4): {
        combined.push(type-bytes[i])
    }
    i <- [0..data.len): {
        combined.push(data[i])
    }
    crc = png-crc32-combined(combined, combined.len)
    out.push((crc >> 24) & 255)
    out.push((crc >> 16) & 255)
    out.push((crc >> 8) & 255)
    out.push(crc & 255)
}

; png-write-chunk-raw: write chunk from raw []byte data
; out []byte: output buffer
; type-str str: chunk type
; data []byte: chunk data (already byte array)
png-write-chunk-raw = (out []byte, type-str str, data []byte) {
    len = data.len
    out.push((len >> 24) & 255)
    out.push((len >> 16) & 255)
    out.push((len >> 8) & 255)
    out.push(len & 255)
    type-bytes = type-str.to-bytes()
    i <- [0..4): {
        out.push(type-bytes[i])
    }
    i <- [0..data.len): {
        out.push(data[i])
    }

    ; CRC
    combined []byte = with-cap(4 + data.len)
    i <- [0..4): {
        combined.push(type-bytes[i])
    }
    i <- [0..data.len): {
        combined.push(data[i])
    }
    crc = png-crc32-combined(combined, combined.len)
    out.push((crc >> 24) & 255)
    out.push((crc >> 16) & 255)
    out.push((crc >> 8) & 255)
    out.push(crc & 255)
}

; png-crc32-combined: compute CRC32 from a []byte buffer (bitwise)
; data []byte: input data
; len i64: data length
; returns crc i64
png-crc32-combined = (data []byte, len i64) (crc i64) {
    crc = 4294967295
    i <- [0..len): {
        b = data[i]
        crc = crc ^ b
        j <- [0..8): {
            {
                crc & 1 != 0 -> {
                    crc = (crc >> 1) ^ 3988292384
                }

                -> {
                    crc = crc >> 1
                }
            }
        }
    }
    crc = crc ^ 4294967295
}
