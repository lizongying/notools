; png.no — PNG (Portable Network Graphics) format read/write
; Supports:
;   Color types: 0 (gray), 2 (RGB), 6 (RGBA)
;   Bit depths: 8
;   Compression: zlib (using std zlib module)
;   Interlacing: non-interlaced + Adam7 interlaced
;
; PNG file layout:
;   Signature (8 bytes): 137 80 78 71 13 10 26 10
;   Chunks: each = length(4) + type(4) + data(length) + CRC(4)
;   Critical chunks: IHDR, IDAT, IEND
;   Ancillary chunks: tEXt, tRNS, gAMA, etc.

; PNG signature bytes

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.new-u16
# /noimg/src/image.copy
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

; png-byte-at: read data[o + delta] as a concrete i64
png-byte-at = (d []byte, o i64, delta i64) (v i64) {

    #{overflow=wrap}
    idx-opt = o + delta
    idx = idx-opt: {
        ok -> it

        -> 0
    }
    v = d[idx]: {
        ok -> it

        -> 0
    }
}

; png-u32: big-endian u32 at data[o]
png-u32 = (d []byte, o i64) (v i64) {
    v = (png-byte-at(d, o, 0) << 24) | (png-byte-at(d, o, 1) << 16) | (png-byte-at(d, o, 2) << 8) | png-byte-at(d, o, 3)
}

; png-u32-at: big-endian u32 at data[o + delta]
png-u32-at = (d []byte, o i64, delta i64) (v i64) {

    #{overflow=wrap}
    base-opt = o + delta
    base = base-opt: {
        ok -> it

        -> 0
    }
    v = png-u32(d, base)
}

; ── CRC32 ──
; CRC-32 (IEEE 802.3) using bitwise computation
; Polynomial: 0xEDB88320 (reflected)

; png-crc32: compute CRC32 of data (bitwise)
; data str: input
; start i64: starting position
; len i64: length
; returns crc i64
png-crc32 = (data []byte, start i64, len i64) (crc i64) {
    crc = 4294967295
    i <- [0..len): {
        b = png-byte-at(data, start, i)
        crc = crc ^ b
        j <- [0..8): {
            {
                crc & 1 != 0 -> {
                    crc = (crc >> 1) ^ 3988292384
                }

                -> {
                    crc = crc >> 1
                }
            }
        }
    }
    crc = crc ^ 4294967295
}

; ── Load ──

; png.load: load a PNG file
; path str: file path
; returns img ?image: loaded image, nil on error
load = (path str) (img ?image) {

    ; CRC32 uses bitwise computation, no table init needed
    data = fs.read-file(path)
    {
        data.len() < 24 -> {
            img = nil
            return
        }

        ; Check PNG signature
        png-byte-at(data, 0, 0) == 137 && png-byte-at(data, 0, 1) == 80 && png-byte-at(data, 0, 2) == 78 && png-byte-at(data, 0, 3) == 71 -> {
        }

        -> {
            img = nil
            return
        }
    }
    pos = 8
    w = 0
    h = 0
    bit-depth = 0
    color-type = 0
    compression = 0
    filter = 0
    interlace = 0
    idat-data []byte = with-cap(0)
    trns []byte = with-cap(0)
    palette []byte = with-cap(0)
    has-trns = false
    has-palette = false

    ; Parse chunks
    (pos < data.len()) {
        pos < data.len() -> {

            #{overflow=wrap}
            {
                pos + 8 > data.len() -> break
            }

            ; Read chunk length (big-endian 32-bit)
            chunk-len = png-u32(data, pos)

            ; Validate the whole chunk (length + type + data + CRC) fits in the
            ; file before any per-byte loop runs over chunk-len. An IDAT that
            ; declares 0x7FFFFFFF would otherwise loop billions of times.
            #{overflow=wrap}
            chunk-end = pos + chunk-len + 12
            chunk-end > data.len() -> {
                img = nil
                return
            }

            ; Verify chunk CRC (computed over type + data, stored big-endian
            ; right after the data). Reject corrupted/malformed chunks.
            crc-computed = png-crc32(data, pos + 4, chunk-len + 4)
            #{overflow=wrap}
            crc-stored = png-u32(data, pos + 8 + chunk-len)
            crc-computed != crc-stored -> {
                img = nil
                return
            }

            #{overflow=wrap}
            pos = pos + 4: {
                ok -> it

                -> _
            }

            ; Read chunk type (4 bytes) as byte comparisons
            is-ihdr = png-byte-at(data, pos, 0) == 73 && png-byte-at(data, pos, 1) == 72 && png-byte-at(data, pos, 2) == 68 && png-byte-at(data, pos, 3) == 82
            is-idat = png-byte-at(data, pos, 0) == 73 && png-byte-at(data, pos, 1) == 68 && png-byte-at(data, pos, 2) == 65 && png-byte-at(data, pos, 3) == 84
            is-plte = png-byte-at(data, pos, 0) == 80 && png-byte-at(data, pos, 1) == 76 && png-byte-at(data, pos, 2) == 84 && png-byte-at(data, pos, 3) == 69
            is-trns = png-byte-at(data, pos, 0) == 116 && png-byte-at(data, pos, 1) == 82 && png-byte-at(data, pos, 2) == 78 && png-byte-at(data, pos, 3) == 83
            is-iend = png-byte-at(data, pos, 0) == 73 && png-byte-at(data, pos, 1) == 69 && png-byte-at(data, pos, 2) == 78 && png-byte-at(data, pos, 3) == 68

            #{overflow=wrap}
            pos = pos + 4: {
                ok -> it

                -> _
            }
            is-ihdr -> {

                ; IHDR: width(4) height(4) bitdepth(1) colortype(1) compression(1) filter(1) interlace(1)
                w = png-u32(data, pos)
                h = png-u32-at(data, pos, 4)
                bit-depth = png-byte-at(data, pos, 8)
                color-type = png-byte-at(data, pos, 9)
                compression = png-byte-at(data, pos, 10)
                filter = png-byte-at(data, pos, 11)
                interlace = png-byte-at(data, pos, 12)
            }
            is-idat -> {

                ; Append to idat-data
                i <- [0..chunk-len): {
                    idat-data.push(png-byte-at(data, pos, i))
                }
            }
            is-plte -> {
                has-palette = true
                i <- [0..chunk-len): {
                    palette.push(png-byte-at(data, pos, i))
                }
            }
            is-trns -> {
                has-trns = true
                i <- [0..chunk-len): {
                    trns.push(png-byte-at(data, pos, i))
                }
            }
            is-iend -> {
                break
            }

            #{overflow=wrap}
            pos = pos + chunk-len + 4: {
                ok -> it

                -> _
            }
        }
    }
    {
        w <= 0 || h <= 0 || w > 65535 || h > 65535 -> {
            img = nil
            return
        }
        {
            bit-depth != 8 && bit-depth != 16 -> {
                img = nil
                return
            }
        }
    }

    ; Determine bands from color type
    bands = 4
    {
        color-type == 0 -> bands = 1

        color-type == 2 -> bands = 3

        color-type == 6 -> bands = 4

        color-type == 3 -> bands = 3

        -> {
            img = nil
            return
        }
    }

    ; bytes-per-pixel depends on bit depth
    bytes-per-pixel = bands
    {
        bit-depth == 16 -> {
            bpp16 i64 = 0
            bpp16-opt = bands * 2
            bpp16-opt: {
                ok -> {
                    bpp16 = it
                }

                -> {
                    bpp16 = 0
                }
            }
            bytes-per-pixel = bpp16
        }
    }
    {
        color-type == 3 -> bytes-per-pixel = 1
    }

    ; Reject output sizes wildly larger than the compressed input (allocation
    ; bomb from a tiny file that declares enormous dimensions). 512 MiB slack
    ; keeps legitimate, highly-compressible large images working.
    #{overflow=wrap}
    out-bytes = w * h * bytes-per-pixel
    #{overflow=wrap}
    out-limit = idat-data.len() * 256 + 536870912
    out-bytes > out-limit -> {
        img = nil
        return
    }

    ; Decompress IDAT (zlib datastream per PNG spec; legacy gzip accepted).
    ; Cap the DEFLATE output at the maximum the declared geometry can hold
    ; plus one extra row for filter bytes, so a zip bomb cannot expand freely.
    #{overflow=wrap}
    raw-limit = w * h * bytes-per-pixel + h
    raw = png-zlib-decompress(idat-data, raw-limit)

    ; Create output image — U16 if bit-depth == 16
    is-u16 = false
    {
        bit-depth == 16 -> is-u16 = true
    }
    {
        is-u16 -> {
            ; image.new-u16 allocates its own buffer; the previous
            ; with-len(w*h*bands*2) here was never used (pure memory waste).
            tmp = image.new-u16(w, h, bands)
        }

        -> {

            #{overflow=wrap}
            pix-data []byte = with-len(w * h * bands)
            tmp = image.new-from-data(w, h, bands, pix-data)
        }
    }

    ; Initialize image to zero
    {
        is-u16 -> {
            i <- [0..w * h * bands * 2): {
                tmp.data[i] = 0
            }
        }

        -> {
            i <- [0..w * h * bands): {
                tmp.data[i] = 0
            }
        }
    }

    {
        interlace == 1 -> {

            ; Adam7 interlacing: 7 passes
            ; Each pass has different starting offset and step
            ; Pass:  start_x, start_y, step_x, step_y
            ;   0:     0,      0,      8,      8
            ;   1:     4,      0,      8,      8
            ;   2:     0,      4,      4,      8
            ;   3:     2,      0,      4,      4
            ;   4:     0,      2,      2,      4
            ;   5:     1,      0,      2,      2
            ;   6:     0,      1,      1,      2
            pass-starts-x [7] = [0, 4, 0, 2, 0, 1, 0]
            pass-starts-y [7] = [0, 0, 4, 0, 2, 0, 1]
            pass-steps-x [7] = [8, 8, 4, 4, 2, 2, 1]
            pass-steps-y [7] = [8, 8, 8, 4, 4, 2, 2]

            raw-pos = 0
            pass <- [0..7): {
                sx-start = pass-starts-x[pass]
                sy-start = pass-starts-y[pass]
                sx-step = pass-steps-x[pass]
                sy-step = pass-steps-y[pass]

                ; Number of pixels per row in this pass
                ; 15w45dqk：#{overflow=wrap} 结果仍是 ?i64，两段式解包后才能给 i64 变量
                pw-opt = (w - sx-start + sx-step - 1) / sx-step
                pass-w i64 = 0
                pass-w = pw-opt: {
                    ok -> it

                    -> 0
                }

                ph-opt = (h - sy-start + sy-step - 1) / sy-step
                pass-h i64 = 0
                pass-h = ph-opt: {
                    ok -> it

                    -> 0
                }

                {
                    pass-w > 0 && pass-h > 0 -> {
                        pass-stride i64 = 0
                        pass-stride-opt = pass-w * bytes-per-pixel
                        pass-stride-opt: {
                            ok -> {
                                pass-stride = it
                            }

                            -> {
                                pass-stride = 0
                            }
                        }

                        pass-row-len i64 = 0
                        pass-row-len-opt = pass-stride + 1
                        pass-row-len-opt: {
                            ok -> {
                                pass-row-len = it
                            }

                            -> {
                                pass-row-len = 0
                            }
                        }

                        ; Allocate previous row for filtering
                        pass-prev []byte = with-len(pass-stride)
                        pi <- [0..pass-stride): {
                            pass-prev[pi]: {
                                ok -> it = 0

                                -> _
                            }
                        }

                        py <- [0..pass-h): {

                            #{overflow=wrap}
                            {
                                raw-pos + pass-row-len > raw.len() -> break
                            }

                            #{overflow=wrap}
                            img-y = sy-start + py * sy-step

                            ; Read filter type (must be 0..4)
                            filter-type = raw[raw-pos]
                            filter-type > 4 -> {
                                img = nil
                                return
                            }

                            ; Copy current row
                            pass-cur []byte = with-len(pass-stride)
                            pi <- [0..pass-stride): {
                                d9v1 byte = raw[raw-pos + 1 + pi]: {
                                    ok -> it

                                    -> 0
                                }

                                pass-cur[pi]: {
                                    ok -> it = d9v1

                                    -> _
                                }
                            }

                            ; Apply filter
                            {
                                filter-type == 0 -> {
                                    ; None
                                }

                                filter-type == 1 -> {
                                    pi <- [bytes-per-pixel..pass-stride): {
                                        d9v2 byte = pass-cur[pi]: {
                                            ok -> it

                                            -> 0
                                        }

                                        d9v3 byte = pass-cur[pi - bytes-per-pixel]: {
                                            ok -> it

                                            -> 0
                                        }

                                        #{overflow=wrap}
                                        pass-cur[pi]: {
                                            ok -> it = d9v2 + d9v3

                                            -> _
                                        }
                                    }
                                }

                                filter-type == 2 -> {
                                    pi <- [0..pass-stride): {
                                        d9v4 byte = pass-cur[pi]: {
                                            ok -> it

                                            -> 0
                                        }

                                        d9v5 byte = pass-prev[pi]: {
                                            ok -> it

                                            -> 0
                                        }

                                        #{overflow=wrap}
                                        pass-cur[pi]: {
                                            ok -> it = d9v4 + d9v5

                                            -> _
                                        }
                                    }
                                }

                                filter-type == 3 -> {
                                    pi <- [0..pass-stride): {
                                        left = 0
                                        pi >= bytes-per-pixel -> {
                                            left = pass-cur[pi - bytes-per-pixel]: {
                                                ok -> it

                                                -> 0
                                            }
                                        }

                                        above = pass-prev[pi]: {
                                            ok -> it

                                            -> 0
                                        }

                                        d9v6 byte = pass-cur[pi]: {
                                            ok -> it

                                            -> 0
                                        }

                                        pass-cur[pi]: {
                                            ok -> it = (d9v6 + (left + above) / 2): {
                                                ok -> it

                                                -> 0
                                            }

                                            -> _
                                        }
                                    }
                                }

                                filter-type == 4 -> {
                                    pi <- [0..pass-stride): {
                                        left = 0
                                        pi >= bytes-per-pixel -> {
                                            left = pass-cur[pi - bytes-per-pixel]: {
                                                ok -> it

                                                -> 0
                                            }
                                        }

                                        above = pass-prev[pi]: {
                                            ok -> it

                                            -> 0
                                        }
                                        above-left = 0
                                        pi >= bytes-per-pixel -> {
                                            above-left = pass-prev[pi - bytes-per-pixel]: {
                                                ok -> it

                                                -> 0
                                            }
                                        }

                                        #{overflow=wrap}
                                        p = left + above - above-left

                                        #{overflow=wrap}
                                        pa = left - above-left
                                        {
                                            pa < 0 -> pa = -pa
                                        }

                                        #{overflow=wrap}
                                        pb = above - above-left
                                        {
                                            pb < 0 -> pb = -pb
                                        }

                                        #{overflow=wrap}
                                        pc = p - above-left
                                        {
                                            pc < 0 -> pc = -pc
                                        }
                                        predictor = 0
                                        {
                                            pa <= pb && pa <= pc -> {
                                                predictor = left
                                            }

                                            pb <= pc -> {
                                                predictor = above
                                            }

                                            -> {
                                                predictor = above-left
                                            }
                                        }

                                        d9v7 byte = pass-cur[pi]: {
                                            ok -> it

                                            -> 0
                                        }

                                        pass-cur[pi]: {
                                            ok -> it = (d9v7 + predictor): {
                                                ok -> it

                                                -> 0
                                            }

                                            -> _
                                        }
                                    }
                                }
                            }

                            ; Write pixels to image at correct positions
                            px <- [0..pass-w): {

                                #{overflow=wrap}
                                img-x = sx-start + px * sx-step
                                {
                                    img-x < w && img-y < h -> {
                                        color-type == 3 -> {
                                            idx = pass-cur[px]

                                            #{overflow=wrap}
                                            {
                                                idx * 3 + 2 < palette.len() -> {

                                                    #{overflow=wrap}
                                                    dst = (img-y * w + img-x) * 3

                                                    tmp.data[dst] = (palette[idx * 3]: {
                                                        ok -> it

                                                        -> 0
                                                    })

                                                    tmp.data[dst + 1] = (palette[idx * 3 + 1]: {
                                                        ok -> it

                                                        -> 0
                                                    })

                                                    tmp.data[dst + 2] = (palette[idx * 3 + 2]: {
                                                        ok -> it

                                                        -> 0
                                                    })
                                                }
                                            }
                                        }

                                        color-type == 0 -> {

                                            #{overflow=wrap}
                                            dst = img-y * w + img-x
                                            tmp.data[dst] = pass-cur[px]: {
                                                ok -> it

                                                -> 0
                                            }
                                        }

                                        -> {

                                            #{overflow=wrap}
                                            dst = (img-y * w + img-x) * bands
                                            b <- [0..bands): {

                                                #{overflow=wrap}
                                                tmp.data[dst + b] = pass-cur[px * bytes-per-pixel + b]: {
                                                    ok -> it

                                                    -> 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            ; Save current row as prev
                            pi <- [0..pass-stride): {
                                d9v8 byte = pass-cur[pi]: {
                                    ok -> it

                                    -> 0
                                }
                                pass-prev[pi]: {
                                    ok -> it = d9v8

                                    -> _
                                }
                            }

                            #{overflow=wrap}
                            raw-pos = raw-pos + pass-row-len: {
                                ok -> it

                                -> _
                            }
                        }
                    }
                }
            }
        }

        -> {

            ; Non-interlaced
            #{overflow=wrap}
            stride = w * bytes-per-pixel

            #{overflow=wrap}
            row-len = stride + 1

            ; Allocate filtered row buffers
            prev-row []byte = with-len(stride)
            i <- [0..stride): {
                prev-row[i]: {
                    ok -> it = 0

                    -> _
                }
            }
            y <- [0..h): {

                #{overflow=wrap}
                row-start = y * row-len

                #{overflow=wrap}
                {
                    row-start + row-len > raw.len() -> break
                }
                filter-type = raw[row-start]
                filter-type > 4 -> {
                    img = nil
                    return
                }

                ; Copy current row
                cur-row []byte = with-len(stride)
                i <- [0..stride): {
                    d9v9 byte = raw[row-start + 1 + i]: {
                        ok -> it

                        -> 0
                    }

                    cur-row[i]: {
                        ok -> it = d9v9

                        -> _
                    }
                }

                ; Apply filter
                {
                    filter-type == 0 -> {
                        ; None
                    }

                    filter-type == 1 -> {

                        ; Sub: raw + left
                        x <- [bytes-per-pixel..stride): {
                            d9v10 byte = cur-row[x]: {
                                ok -> it

                                -> 0
                            }

                            d9v11 byte = cur-row[x - bytes-per-pixel]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            cur-row[x]: {
                                ok -> it = d9v10 + d9v11

                                -> _
                            }
                        }
                    }

                    filter-type == 2 -> {

                        ; Up: raw + above
                        x <- [0..stride): {
                            d9v12 byte = cur-row[x]: {
                                ok -> it

                                -> 0
                            }

                            d9v13 byte = prev-row[x]: {
                                ok -> it

                                -> 0
                            }

                            #{overflow=wrap}
                            cur-row[x]: {
                                ok -> it = d9v12 + d9v13

                                -> _
                            }
                        }
                    }

                    filter-type == 3 -> {

                        ; Average: raw + (left + above) / 2
                        x <- [0..stride): {
                            left = 0
                            x >= bytes-per-pixel -> {
                                left = cur-row[x - bytes-per-pixel]: {
                                    ok -> it

                                    -> 0
                                }
                            }

                            above = prev-row[x]: {
                                ok -> it

                                -> 0
                            }

                            d9v14 byte = cur-row[x]: {
                                ok -> it

                                -> 0
                            }

                            cur-row[x]: {
                                ok -> it = (d9v14 + (left + above) / 2): {
                                    ok -> it

                                    -> 0
                                }

                                -> _
                            }
                        }
                    }

                    filter-type == 4 -> {

                        ; Paeth: raw + Paeth predictor
                        x <- [0..stride): {
                            left = 0
                            x >= bytes-per-pixel -> {
                                left = cur-row[x - bytes-per-pixel]: {
                                    ok -> it

                                    -> 0
                                }
                            }

                            above = prev-row[x]: {
                                ok -> it

                                -> 0
                            }
                            above-left = 0
                            x >= bytes-per-pixel -> {
                                above-left = prev-row[x - bytes-per-pixel]: {
                                    ok -> it

                                    -> 0
                                }
                            }

                            ; Paeth predictor
                            #{overflow=wrap}
                            p = left + above - above-left

                            #{overflow=wrap}
                            pa = left - above-left
                            {
                                pa < 0 -> pa = -pa
                            }

                            #{overflow=wrap}
                            pb = above - above-left
                            {
                                pb < 0 -> pb = -pb
                            }

                            #{overflow=wrap}
                            pc = p - above-left
                            {
                                pc < 0 -> pc = -pc
                            }
                            predictor = 0
                            {
                                pa <= pb && pa <= pc -> {
                                    predictor = left
                                }

                                pb <= pc -> {
                                    predictor = above
                                }

                                -> {
                                    predictor = above-left
                                }
                            }

                            d9v15 byte = cur-row[x]: {
                                ok -> it

                                -> 0
                            }

                            cur-row[x]: {
                                ok -> it = (d9v15 + predictor): {
                                    ok -> it

                                    -> 0
                                }

                                -> _
                            }
                        }
                    }
                }

                ; Write pixels to image
                {
                    color-type == 3 -> {

                        ; Indexed color (always 8-bit)
                        x <- [0..w): {
                            idx = cur-row[x]

                            #{overflow=wrap}
                            {
                                idx * 3 + 2 < palette.len() -> {

                                    #{overflow=wrap}
                                    image.set-pixel(tmp, x, y, 0, png-byte-at(palette, idx * 3, 0))

                                    #{overflow=wrap}
                                    image.set-pixel(tmp, x, y, 1, png-byte-at(palette, idx * 3 + 1, 0))

                                    #{overflow=wrap}
                                    image.set-pixel(tmp, x, y, 2, png-byte-at(palette, idx * 3 + 2, 0))
                                }
                            }
                        }
                    }

                    color-type == 0 -> {

                        ; Grayscale
                        x <- [0..w): {
                            {
                                is-u16 -> {
                                    v i64 = (png-byte-at(cur-row, x * 2, 0) << 8) | png-byte-at(cur-row, x * 2 + 1, 0)
                                    image.set-pixel(tmp, x, y, 0, v)
                                }

                                -> {
                                    image.set-pixel(tmp, x, y, 0, png-byte-at(cur-row, x, 0))
                                }
                            }
                        }
                    }

                    -> {

                        ; RGB / RGBA
                        x <- [0..w): {
                            b <- [0..bands): {
                                {
                                    is-u16 -> {
                                        v i64 = (png-byte-at(cur-row, x * bytes-per-pixel + b * 2, 0) << 8) | png-byte-at(cur-row, x * bytes-per-pixel + b * 2 + 1, 0)
                                        image.set-pixel(tmp, x, y, b, v)
                                    }

                                    -> {

                                        #{overflow=wrap}
                                        image.set-pixel(tmp, x, y, b, png-byte-at(cur-row, x * bands + b, 0))
                                    }
                                }
                            }
                        }
                    }
                }

                ; Save current row as prev
                i <- [0..stride): {
                    d9v16 byte = cur-row[i]: {
                        ok -> it

                        -> 0
                    }
                    prev-row[i]: {
                        ok -> it = d9v16

                        -> _
                    }
                }
            }
        }
    }

    ; Apply tRNS transparency if present
    {
        has-trns -> {
            color-type == 0 -> {

                ; Grayscale tRNS: 2 bytes (16-bit gray value)
                ; Pixels matching this value get alpha=0, others alpha=255
                {
                    trns.len() >= 2 -> {
                        trns-val i64 = (png-byte-at(trns, 0, 0) << 8) | png-byte-at(trns, 1, 0)

                        ; Create RGBA image
                        rgba-img = image.new(w, h, 4)
                        i <- [0..w * h): {
                            g = tmp.data[i]
                            a = 255
                            {
                                is-u16 -> {
                                    g == trns-val -> a = 0
                                }

                                -> {
                                    g == (trns-val >> 8) -> a = 0
                                }
                            }

                            #{overflow=wrap}
                            rgba-img.data[i * 4] = g

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 1] = g

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 2] = g

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 3] = a
                        }
                        tmp = rgba-img
                    }
                }
            }

            color-type == 2 -> {

                ; RGB tRNS: 6 bytes (R, G, B — each 16-bit)
                ; Pixels matching get alpha=0, others alpha=255
                {
                    trns.len() >= 6 -> {
                        trns-r i64 = (png-byte-at(trns, 0, 0) << 8) | png-byte-at(trns, 1, 0)
                        trns-g i64 = (png-byte-at(trns, 2, 0) << 8) | png-byte-at(trns, 3, 0)
                        trns-b i64 = (png-byte-at(trns, 4, 0) << 8) | png-byte-at(trns, 5, 0)
                        rgba-img = image.new(w, h, 4)
                        i <- [0..w * h): {

                            #{overflow=wrap}
                            r = tmp.data[i * 3]

                            #{overflow=wrap}
                            g = tmp.data[i * 3 + 1]

                            #{overflow=wrap}
                            b = tmp.data[i * 3 + 2]
                            a = 255
                            {
                                is-u16 -> {
                                    r == trns-r && g == trns-g && b == trns-b -> a = 0
                                }

                                -> {
                                    r == (trns-r >> 8) && g == (trns-g >> 8) && b == (trns-b >> 8) -> a = 0
                                }
                            }

                            #{overflow=wrap}
                            rgba-img.data[i * 4] = r

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 1] = g

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 2] = b

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 3] = a
                        }
                        tmp = rgba-img
                    }
                }
            }

            color-type == 3 -> {

                ; Indexed tRNS: one alpha byte per palette entry
                ; Expand to RGBA
                {
                    has-palette -> {
                        rgba-img = image.new(w, h, 4)
                        i <- [0..w * h): {
                            ; Removed dead assignment `idx = tmp.data[i * 3]`
                            ; (value was never read).

                            ; Actually for indexed, tmp already has RGB expanded.
                            ; We need the original index, but it's lost.
                            ; Instead, match by RGB value to find the index.
                            ; This is inefficient but correct for tRNS on indexed.
                            ; Better: store indices during decode.
                            ; For now, copy RGB and set alpha from palette tRNS
                            #{overflow=wrap}
                            r = tmp.data[i * 3]

                            #{overflow=wrap}
                            g = tmp.data[i * 3 + 1]

                            #{overflow=wrap}
                            b = tmp.data[i * 3 + 2]
                            a = 255

                            ; Search palette for matching entry
                            pi <- [0..palette.len() / 3): {

                                #{overflow=wrap}
                                {
                                    png-byte-at(palette, pi * 3, 0) == r && png-byte-at(palette, pi * 3 + 1, 0) == g && png-byte-at(palette, pi * 3 + 2, 0) == b -> {
                                        pi < trns.len() -> {
                                            a = trns[pi]: {
                                                ok -> it

                                                -> 0
                                            }
                                        }
                                    }
                                }
                            }

                            #{overflow=wrap}
                            rgba-img.data[i * 4] = r

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 1] = g

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 2] = b

                            #{overflow=wrap}
                            rgba-img.data[i * 4 + 3] = a
                        }
                        tmp = rgba-img
                    }
                }
            }
        }
    }

    img = tmp
}

; ── zlib wrapper (RFC 1950) ──
; PNG spec requires IDAT to hold a zlib datastream: 2-byte header
; (CMF=0x78, FLG=0x01 — check bits valid since 0x7801 % 31 == 0),
; a raw DEFLATE stream (RFC 1951), and an Adler-32 checksum
; of the uncompressed data (big-endian).

; png-adler32: Adler-32 checksum of a byte buffer
; data []byte: input
; returns sum i64: Adler-32 value
png-adler32 = (data []byte) (sum i64) {
    a = 1
    b = 0
    i <- [0..data.len()): {

        #{overflow=wrap}
        a = (a + png-byte-at(data, i, 0)) % 65521

        #{overflow=wrap}
        b = (b + a) % 65521: {
            ok -> it

            -> _
        }
    }

    #{overflow=wrap}
    sum = b * 65536 + a: {
        ok -> it

        -> _
    }
}

; png-zlib-compress: wrap raw DEFLATE stored blocks in a zlib container
; data []byte: uncompressed data
; returns out []byte: zlib datastream
png-zlib-compress = (data []byte) (out []byte) {
    deflated = gzip.deflate-stored(data)
    ad = png-adler32(data)
    out = with-cap(2 + deflated.len() + 4)
    out.push(120); 0x78 CMF: deflate, 32K window
    out.push(1); 0x01 FLG: check bits valid, fastest level
    i <- [0..deflated.len()): {
        out.push(png-byte-at(deflated, i, 0))
    }
    out.push((ad >> 24) & 255)
    out.push((ad >> 16) & 255)
    out.push((ad >> 8) & 255)
    out.push(ad & 255)
}

; png-zlib-decompress: decompress a zlib datastream (with gzip fallback for
; files written by older noimg versions, which wrapped IDAT in gzip)
; data []byte: zlib (or legacy gzip) datastream
; returns out []byte: decompressed data
png-zlib-decompress = (data []byte, limit i64) (out []byte) {
    is-gzip = false
    data.len() >= 2 -> {
        png-byte-at(data, 0, 0) == 31 && png-byte-at(data, 1, 0) == 139 -> {
            is-gzip = true
        }
    }
    {
        is-gzip -> {
            ; gzip.gzip-decompress was removed in compiler v0.4.24.
            ; Strip the 10-byte gzip header and 8-byte trailer, then inflate raw DEFLATE.
            data.len() > 18 -> {
                out = gzip.inflate-decompress(data.slice(10, data.len() - 8), limit)
            }
        }

        -> {
            data.len() > 6 -> {
                out = gzip.inflate-decompress(data.slice(2, data.len() - 4), limit)
            }
        }
    }
}

; ── Save ──

; png.save: save an image as PNG (8-bit or 16-bit, color type auto-selected)
; path str: output path
; img image: image to save
; returns ok bool
save = (path str, img image) (ok bool) {

    ; Determine bit depth
    bit-depth = 8
    {
        img.depth == 2 -> bit-depth = 16
    }
    color-type = 2
    bands = 3
    {
        img.bands == 1 -> {
            color-type = 0
            bands = 1
        }

        img.bands == 4 -> {
            color-type = 6
            bands = 4
        }
    }

    ; Build raw data with filter bytes (filter=0 for all rows)
    bytes-per-channel = 1
    {
        bit-depth == 16 -> bytes-per-channel = 2
    }

    #{overflow=wrap}
    stride = img.width * bands * bytes-per-channel

    #{overflow=wrap}
    row-len = stride + 1

    #{overflow=wrap}
    raw []byte = with-len(row-len * img.height)
    y <- [0..img.height): {

        #{overflow=wrap}
        raw[y * row-len]: {
            ok -> it = 0

            -> _
        }
        {
            img.bands == bands -> {
                x <- [0..img.width): {
                    b <- [0..bands): {
                        v = image.get-pixel(img, x, y, b)
                        {
                            bit-depth == 16 -> {

                                #{overflow=wrap}
                                raw[y * row-len + 1 + (x * bands + b) * 2]: {
                                    ok -> it = (v >> 8) & 255

                                    -> _
                                }

                                #{overflow=wrap}
                                raw[y * row-len + 1 + (x * bands + b) * 2 + 1]: {
                                    ok -> it = v & 255

                                    -> _
                                }
                            }

                            -> {

                                #{overflow=wrap}
                                raw[y * row-len + 1 + x * bands + b]: {
                                    ok -> it = v

                                    -> _
                                }
                            }
                        }
                    }
                }
            }

            -> {

                ; Need conversion
                x <- [0..img.width): {
                    {
                        bands == 1 -> {
                            {
                                img.bands >= 3 -> {
                                    r = image.get-pixel(img, x, y, 0)
                                    g = image.get-pixel(img, x, y, 1)
                                    b = image.get-pixel(img, x, y, 2)

                                    #{overflow=wrap}
                                    v = (r * 299 + g * 587 + b * 114) / 1000
                                }

                                -> {
                                    v = image.get-pixel(img, x, y, 0)
                                }
                            }
                            {
                                bit-depth == 16 -> {

                                    #{overflow=wrap}
                                    raw[y * row-len + 1 + x * 2]: {
                                        ok -> it = (v >> 8) & 255

                                        -> _
                                    }

                                    #{overflow=wrap}
                                    raw[y * row-len + 1 + x * 2 + 1]: {
                                        ok -> it = v & 255

                                        -> _
                                    }
                                }

                                -> {

                                    #{overflow=wrap}
                                    raw[y * row-len + 1 + x]: {
                                        ok -> it = v

                                        -> _
                                    }
                                }
                            }
                        }

                        -> {
                            i <- [0..bands): {
                                {
                                    i < img.bands -> {
                                        v = image.get-pixel(img, x, y, i)
                                    }

                                    -> {
                                        v = 255
                                        {
                                            bit-depth == 16 -> v = 65535
                                        }
                                    }
                                }
                                {
                                    bit-depth == 16 -> {

                                        #{overflow=wrap}
                                        raw[y * row-len + 1 + (x * bands + i) * 2]: {
                                            ok -> it = (v >> 8) & 255

                                            -> _
                                        }

                                        #{overflow=wrap}
                                        raw[y * row-len + 1 + (x * bands + i) * 2 + 1]: {
                                            ok -> it = v & 255

                                            -> _
                                        }
                                    }

                                    -> {

                                        #{overflow=wrap}
                                        raw[y * row-len + 1 + x * bands + i]: {
                                            ok -> it = v

                                            -> _
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    ; Compress with zlib (PNG spec: IDAT holds a zlib datastream)
    compressed = png-zlib-compress(raw)

    ; Build PNG file
    #{overflow=wrap}
    buf []byte = with-cap(8 + 25 + 12 + compressed.len() + 12 + 12)

    ; PNG signature
    buf.push(137)
    buf.push(80)
    buf.push(78)
    buf.push(71)
    buf.push(13)
    buf.push(10)
    buf.push(26)
    buf.push(10)

    ; IHDR chunk (13 bytes data)
    png-write-chunk(buf, 73, 72, 68, 82, png-build-ihdr(img.width, img.height, bit-depth, color-type))

    ; IDAT chunk
    png-write-chunk-raw(buf, 73, 68, 65, 84, compressed)

    ; IEND chunk (0 bytes data)
    iend-data []byte = with-cap(0)
    png-write-chunk(buf, 73, 69, 78, 68, iend-data)

    ; Write file
    wfd = fs.open-write(path)
    wfd < 0 -> {
        ok = false
        return
    }
    fs.write(wfd, buf, buf.len())
    fs.close(wfd)
    ok = true
}

; png-build-ihdr: build IHDR chunk data (13 bytes)
; w i64: width
; h i64: height
; bit-depth i64: bit depth
; color-type i64: color type
; returns data []byte
png-build-ihdr = (w i64, h i64, bit-depth i64, color-type i64) (data []byte) {
    data = with-cap(13)
    w0 = (w >> 24) & 255
    w1 = (w >> 16) & 255
    w2 = (w >> 8) & 255
    w3 = w & 255
    h0 = (h >> 24) & 255
    h1 = (h >> 16) & 255
    h2 = (h >> 8) & 255
    h3 = h & 255
    bd = bit-depth & 255
    ct = color-type & 255
    data.push(w0)
    data.push(w1)
    data.push(w2)
    data.push(w3)
    data.push(h0)
    data.push(h1)
    data.push(h2)
    data.push(h3)
    data.push(bd)
    data.push(ct)
    data.push(0)
    data.push(0)
    data.push(0)
}

; png-write-chunk: write a chunk to output buffer (with CRC)
; out []byte: output buffer
; type-str str: 4-char chunk type
; data []byte: chunk data
png-write-chunk = (out []byte, t0 i64, t1 i64, t2 i64, t3 i64, data []byte) {

    ; Length (big-endian)
    len = data.len()
    l0 i64 = (len >> 24) & 255
    l1 i64 = (len >> 16) & 255
    l2 i64 = (len >> 8) & 255
    l3 i64 = len & 255
    out.push(l0)
    out.push(l1)
    out.push(l2)
    out.push(l3)

    ; Type
    out.push(t0)
    out.push(t1)
    out.push(t2)
    out.push(t3)

    ; Data
    i <- [0..data.len()): {
        dv i64 = data[i]: {
            ok -> it

            -> 0
        }
        out.push(dv)
    }

    ; CRC (over type + data)
    ; Build a combined buffer for CRC
    #{overflow=wrap}
    combined []byte = with-cap(4 + data.len())
    combined.push(t0)
    combined.push(t1)
    combined.push(t2)
    combined.push(t3)
    i <- [0..data.len()): {
        dv i64 = data[i]: {
            ok -> it

            -> 0
        }
        combined.push(dv)
    }
    crc = png-crc32-combined(combined, combined.len())
    c0 i64 = (crc >> 24) & 255
    c1 i64 = (crc >> 16) & 255
    c2 i64 = (crc >> 8) & 255
    c3 i64 = crc & 255
    out.push(c0)
    out.push(c1)
    out.push(c2)
    out.push(c3)
}

; png-write-chunk-raw: write chunk from raw []byte data
; out []byte: output buffer
; type-str str: chunk type
; data []byte: chunk data (already byte array)
png-write-chunk-raw = (out []byte, t0 i64, t1 i64, t2 i64, t3 i64, data []byte) {
    len = data.len()
    out.push((len >> 24) & 255)
    out.push((len >> 16) & 255)
    out.push((len >> 8) & 255)
    out.push(len & 255)
    out.push(t0)
    out.push(t1)
    out.push(t2)
    out.push(t3)
    i <- [0..data.len()): {
        dv i64 = data[i]: {
            ok -> it

            -> 0
        }
        out.push(dv)
    }

    ; CRC
    #{overflow=wrap}
    combined []byte = with-cap(4 + data.len())
    combined.push(t0)
    combined.push(t1)
    combined.push(t2)
    combined.push(t3)
    i <- [0..data.len()): {
        dv i64 = data[i]: {
            ok -> it

            -> 0
        }
        combined.push(dv)
    }
    crc = png-crc32-combined(combined, combined.len())
    c0 i64 = (crc >> 24) & 255
    c1 i64 = (crc >> 16) & 255
    c2 i64 = (crc >> 8) & 255
    c3 i64 = crc & 255
    out.push(c0)
    out.push(c1)
    out.push(c2)
    out.push(c3)
}

; png-crc32-combined: compute CRC32 from a []byte buffer (bitwise)
; data []byte: input data
; len i64: data length
; returns crc i64
png-crc32-combined = (data []byte, len i64) (crc i64) {
    crc = 4294967295
    i <- [0..len): {
        b = data[i]: {
            ok -> it

            -> 0
        }
        crc = crc ^ b
        j <- [0..8): {
            {
                crc & 1 != 0 -> {
                    crc = (crc >> 1) ^ 3988292384
                }

                -> {
                    crc = crc >> 1
                }
            }
        }
    }
    crc = crc ^ 4294967295
}
