; gen-cross.no — generate test images and save via noimg, then round-trip decode.
; Cross-validated against Pillow in cross_check.py.
; Output dir: /tmp/cross/
# /noimg/src/image.new
# /noimg/src/image.set-pixel
# /noimg/src/pnm.save
# /noimg/src/png.save
# /noimg/src/png.load
# /noimg/src/jpeg.save
# /noimg/src/jpeg.load
# /noimg/src/jpeg.save-quality
# /noimg/src/jpeg.save-quality-subsampling

main = () {
    print('--- gen_cross ---')
    dir = '/tmp/cross'

    ; ---- A: RGB 64x48 ----
    a = image.new(64, 48, 3)
    y <- [0..48): {
        x <- [0..64): {
            #{overflow=wrap}
            image.set-pixel(a, x, y, 0, (x * 4) & 255)
            #{overflow=wrap}
            image.set-pixel(a, x, y, 1, (y * 5) & 255)
            #{overflow=wrap}
            image.set-pixel(a, x, y, 2, (x * y) & 255)
        }
    }
    pnm.save(dir + '/A.ppm', a)
    png.save(dir + '/A.png', a)
    jpeg.save(dir + '/A.jpg', a)
    jpeg.save-quality(dir + '/A_q40.jpg', a, 40)
    jpeg.save-quality-subsampling(dir + '/A_444.jpg', a, 90, 1)
    ra = png.load(dir + '/A.png')
    ra: {
        nil -> { print('FAIL: A png.load nil') }
        err -> { print('FAIL: A png.load err') }
        ok -> { pnm.save(dir + '/A_png_rt.ppm', it) }
    }
    raj = jpeg.load(dir + '/A.jpg')
    raj: {
        nil -> { print('FAIL: A jpeg.load nil') }
        err -> { print('FAIL: A jpeg.load err') }
        ok -> { pnm.save(dir + '/A_jpg_rt.ppm', it) }
    }

    ; ---- B: RGBA 32x32 ----
    b = image.new(32, 32, 4)
    yb <- [0..32): {
        xb <- [0..32): {
            #{overflow=wrap}
            image.set-pixel(b, xb, yb, 0, (xb * 8) & 255)
            #{overflow=wrap}
            image.set-pixel(b, xb, yb, 1, (yb * 8) & 255)
            #{overflow=wrap}
            image.set-pixel(b, xb, yb, 2, (xb + yb) & 255)
            #{overflow=wrap}
            image.set-pixel(b, xb, yb, 3, (xb * yb + 100) & 255)
        }
    }
    png.save(dir + '/B.png', b)
    jpeg.save(dir + '/B.jpg', b)
    jpeg.save-quality(dir + '/B_q40.jpg', b, 40)
    jpeg.save-quality-subsampling(dir + '/B_444.jpg', b, 90, 1)
    rb = png.load(dir + '/B.png')
    rb: {
        nil -> { print('FAIL: B png.load nil') }
        err -> { print('FAIL: B png.load err') }
        ok -> { png.save(dir + '/B_png_rt.png', it) }
    }
    rbj = jpeg.load(dir + '/B.jpg')
    rbj: {
        nil -> { print('FAIL: B jpeg.load nil') }
        err -> { print('FAIL: B jpeg.load err') }
        ok -> { png.save(dir + '/B_jpg_rt.png', it) }
    }

    ; ---- C: Grayscale 48x48 ----
    c = image.new(48, 48, 1)
    yc <- [0..48): {
        xc <- [0..48): {
            #{overflow=wrap}
            image.set-pixel(c, xc, yc, 0, (xc + yc * 3) & 255)
        }
    }
    pnm.save(dir + '/C.ppm', c)
    png.save(dir + '/C.png', c)
    jpeg.save(dir + '/C.jpg', c)
    rc = png.load(dir + '/C.png')
    rc: {
        nil -> { print('FAIL: C png.load nil') }
        err -> { print('FAIL: C png.load err') }
        ok -> { pnm.save(dir + '/C_png_rt.ppm', it) }
    }
    rcj = jpeg.load(dir + '/C.jpg')
    rcj: {
        nil -> { print('FAIL: C jpeg.load nil') }
        err -> { print('FAIL: C jpeg.load err') }
        ok -> { pnm.save(dir + '/C_jpg_rt.ppm', it) }
    }

    ; ---- D: small RGB 8x8 (MCU edge) ----
    d = image.new(8, 8, 3)
    yd <- [0..8): {
        xd <- [0..8): {
            #{overflow=wrap}
            image.set-pixel(d, xd, yd, 0, (xd * 20) & 255)
            #{overflow=wrap}
            image.set-pixel(d, xd, yd, 1, (yd * 20) & 255)
            #{overflow=wrap}
            image.set-pixel(d, xd, yd, 2, (xd * yd) & 255)
        }
    }
    pnm.save(dir + '/D.ppm', d)
    png.save(dir + '/D.png', d)
    jpeg.save(dir + '/D.jpg', d)
    jpeg.save-quality-subsampling(dir + '/D_444.jpg', d, 90, 1)
    rd = png.load(dir + '/D.png')
    rd: {
        nil -> { print('FAIL: D png.load nil') }
        err -> { print('FAIL: D png.load err') }
        ok -> { pnm.save(dir + '/D_png_rt.ppm', it) }
    }
    rdj = jpeg.load(dir + '/D.jpg')
    rdj: {
        nil -> { print('FAIL: D jpeg.load nil') }
        err -> { print('FAIL: D jpeg.load err') }
        ok -> { pnm.save(dir + '/D_jpg_rt.ppm', it) }
    }

    ; ---- E: larger RGB 100x80 ----
    e = image.new(100, 80, 3)
    ye <- [0..80): {
        xe <- [0..100): {
            #{overflow=wrap}
            image.set-pixel(e, xe, ye, 0, (128 + xe) & 255)
            #{overflow=wrap}
            image.set-pixel(e, xe, ye, 1, (255 - ye * 3) & 255)
            #{overflow=wrap}
            image.set-pixel(e, xe, ye, 2, (xe * ye + 200) & 255)
        }
    }
    pnm.save(dir + '/E.ppm', e)
    png.save(dir + '/E.png', e)
    jpeg.save(dir + '/E.jpg', e)
    jpeg.save-quality(dir + '/E_q40.jpg', e, 40)
    jpeg.save-quality-subsampling(dir + '/E_444.jpg', e, 90, 1)
    re = png.load(dir + '/E.png')
    re: {
        nil -> { print('FAIL: E png.load nil') }
        err -> { print('FAIL: E png.load err') }
        ok -> { pnm.save(dir + '/E_png_rt.ppm', it) }
    }
    rej = jpeg.load(dir + '/E.jpg')
    rej: {
        nil -> { print('FAIL: E jpeg.load nil') }
        err -> { print('FAIL: E jpeg.load err') }
        ok -> { pnm.save(dir + '/E_jpg_rt.ppm', it) }
    }

    print('gen_cross done')
}
