; interop-gen.no — generate originals + noimg-encoded WebP files for
; libwebp (dwebp) interoperability testing. Outputs to /tmp/webp-interop/.
; Run: no run tests/interop-gen.no
# /noimg/src/image.new
# /noimg/src/image.set-pixel
# /noimg/src/webp.save
# /noimg/src/pnm.save
# /noimg/src/pam.save

main = () {
    dir = '/tmp/webp-interop'
    n-fail = 0

    ; ---- 1. small RGB gradient (12x8), opaque ----
    g1 = image.new(12, 8, 3)
    y <- [0..8): {
        x <- [0..12): {
            #{overflow=wrap}
            image.set-pixel(g1, x, y, 0, (128 + x * 10) & 255)
            #{overflow=wrap}
            image.set-pixel(g1, x, y, 1, (255 - y * 20) & 255)
            #{overflow=wrap}
            image.set-pixel(g1, x, y, 2, (x * y + 200) & 255)
        }
    }
    pnm.save(dir + '/orig1.ppm', g1)
    saved = webp.save(dir + '/g1.webp', g1)
    {
        saved -> {}
        -> { print('FAIL: save g1.webp'); #{overflow=wrap} n-fail = n-fail + 1 }
    }

    ; ---- 2. palette-friendly 64x64 (<= 256 distinct colors) ----
    g2 = image.new(64, 64, 3)
    y <- [0..64): {
        x <- [0..64): {
            #{overflow=wrap}
            idx = (x + y * 4) & 255
            image.set-pixel(g2, x, y, 0, idx)
            #{overflow=wrap}
            image.set-pixel(g2, x, y, 1, idx / 2)
            #{overflow=wrap}
            image.set-pixel(g2, x, y, 2, 255 - idx)
        }
    }
    pnm.save(dir + '/orig2.ppm', g2)
    saved2 = webp.save(dir + '/g2.webp', g2)
    {
        saved2 -> {}
        -> { print('FAIL: save g2.webp'); #{overflow=wrap} n-fail = n-fail + 1 }
    }

    ; ---- 3. truecolor gradient 64x48 (> 256 colors, SG path) ----
    g3 = image.new(64, 48, 3)
    y <- [0..48): {
        x <- [0..64): {
            #{overflow=wrap}
            image.set-pixel(g3, x, y, 0, (x * 4) & 255)
            #{overflow=wrap}
            image.set-pixel(g3, x, y, 1, (y * 5) & 255)
            #{overflow=wrap}
            image.set-pixel(g3, x, y, 2, (x * y) & 255)
        }
    }
    pnm.save(dir + '/orig3.ppm', g3)
    saved3 = webp.save(dir + '/g3.webp', g3)
    {
        saved3 -> {}
        -> { print('FAIL: save g3.webp'); #{overflow=wrap} n-fail = n-fail + 1 }
    }

    ; ---- 4. RGBA 10x10 with alpha ramp ----
    g4 = image.new(10, 10, 4)
    y <- [0..10): {
        x <- [0..10): {
            image.set-pixel(g4, x, y, 0, x * 25)
            image.set-pixel(g4, x, y, 1, y * 25)
            #{overflow=wrap}
            image.set-pixel(g4, x, y, 2, 255 - x * 25)
            #{overflow=wrap}
            image.set-pixel(g4, x, y, 3, x * y + 100)
        }
    }
    pam.save(dir + '/orig4.pam', g4)
    saved4 = webp.save(dir + '/g4.webp', g4)
    {
        saved4 -> {}
        -> { print('FAIL: save g4.webp'); #{overflow=wrap} n-fail = n-fail + 1 }
    }

    print('--- Results: generated 4 originals + 4 webp, {n-fail} failures ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
