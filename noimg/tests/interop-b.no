; interop-b.no — direction B: decode cwebp-lossless WebP files via noimg
; webp.load and write decoded images as PPM (RGB) / PAM (RGBA) for comparison.
; Run: no run tests/interop-b.no
# /noimg/src/webp.load
# /noimg/src/pnm.save
# /noimg/src/pam.save

main = () {
    dir = '/tmp/webp-interop'
    names = ['1', '2', '3', '4']
    n-fail = 0

    i <- [0..4): {
        name = names[i]
        r = webp.load(dir + '/cb' + name + '.webp')
        r: {
            nil -> {
                print('FAIL: load cb' + name + '.webp returned nil')

                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            err -> {
                print('FAIL: load cb' + name + '.webp returned error')

                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            ok -> {
                rt = it
                (rt.bands == 4) -> {
                    pam.save(dir + '/b' + name + '.pam', rt)
                    print('decoded cb' + name + '.webp -> b' + name + '.pam')
                }

                -> {
                    pnm.save(dir + '/b' + name + '.ppm', rt)
                    print('decoded cb' + name + '.webp -> b' + name + '.ppm')
                }
            }
        }
    }

    print('--- Results: {n-fail} failures ---')
    {
        n-fail == 0 -> print('ALL PASS')

        -> os.exit(1)
    }
}
