; test-jpeg.no — JPEG (baseline) self round-trip test
; Builds images with known pixels, encodes them via our JPEG encoder
; (4:2:0 / 4:4:4 / quality variants / grayscale), decodes them back via
; our decoder, and verifies the mean absolute error stays within the
; tolerance implied by lossy quantization. Exercises the full
; encode -> decode pipeline without external tools in CI.
; NOTE: jpeg.load returns a plain ?image option; consuming the unwrapped
; value requires the explicit-variant match form `r: { nil -> ... err -> ...
; ok -> { v = it ... } }` — the implicit `r -> {}` match mis-lowers when
; the unwrapped struct is used in nested loops (compiler bug #85).
; Run: no run tests/test-jpeg.no

# /noimg/src/image.new
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/jpeg.load
# /noimg/src/jpeg.save
# /noimg/src/jpeg.save-quality
# /noimg/src/jpeg.save-quality-subsampling

main = () {
    print('--- Testing JPEG baseline round-trip ---')
    n-pass = 0
    n-fail = 0

    ; ---- 1. RGB gradient, 4:2:0 default quality ----
    img = image.new(64, 48, 3)
    y <- [0..48): {
        x <- [0..64): {
            #{overflow=wrap}
            image.set-pixel(img, x, y, 0, (x * 4) & 255)
            #{overflow=wrap}
            image.set-pixel(img, x, y, 1, (y * 5) & 255)
            #{overflow=wrap}
            image.set-pixel(img, x, y, 2, (x * y) & 255)
        }
    }

    saved = jpeg.save('/tmp/noimg-test.jpg', img)
    {
        saved -> {
            print('PASS: JPEG save (RGB 4:2:0)')
            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: JPEG save (RGB 4:2:0)')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    loaded = jpeg.load('/tmp/noimg-test.jpg')
    loaded: {
        nil -> {
            print('FAIL: JPEG load (RGB 4:2:0) returned nil')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        err -> {
            print('FAIL: JPEG load (RGB 4:2:0) returned error')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        ok -> {
            rt = it
            print('PASS: JPEG load (RGB 4:2:0)')
            #{overflow=wrap}
            n-pass = n-pass + 1
            sum = 0
            yy <- [0..48): {
                xx <- [0..64): {
                    b <- [0..3): {
                        a = image.get-pixel(img, xx, yy, b)
                        v = image.get-pixel(rt, xx, yy, b)
                        #{overflow=wrap}
                        d = a - v
                        d < 0 -> {
                            #{overflow=wrap}
                            d = 0 - d
                        }
                        #{overflow=wrap}
                        sum = sum + d
                    }
                }
            }
            ; MAE in per-mille of 255: sum * 1000 / (w*h*bands*255)
            #{overflow=wrap}
            mae-mille = sum * 1000 / (64 * 48 * 3 * 255)
            ; default quality is fairly aggressive on the x*y channel
            {
                mae-mille < 100 -> {
                    print('PASS: JPEG round-trip MAE (RGB 4:2:0), mae-mille={mae-mille}')
                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }

                -> {
                    print('FAIL: JPEG round-trip MAE too high (RGB 4:2:0), mae-mille={mae-mille}')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
    }

    ; ---- 2. RGB gradient, 4:4:4 quality 90 ----
    saved2 = jpeg.save-quality-subsampling('/tmp/noimg-test-444.jpg', img, 90, 1)
    {
        saved2 -> {
            print('PASS: JPEG save (RGB 4:4:4 q90)')
            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: JPEG save (RGB 4:4:4 q90)')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    loaded2 = jpeg.load('/tmp/noimg-test-444.jpg')
    loaded2: {
        nil -> {
            print('FAIL: JPEG load (RGB 4:4:4) returned nil')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        err -> {
            print('FAIL: JPEG load (RGB 4:4:4) returned error')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        ok -> {
            rt2 = it
            print('PASS: JPEG load (RGB 4:4:4 q90)')
            #{overflow=wrap}
            n-pass = n-pass + 1
            sum2 = 0
            yy <- [0..48): {
                xx <- [0..64): {
                    b <- [0..3): {
                        a = image.get-pixel(img, xx, yy, b)
                        v = image.get-pixel(rt2, xx, yy, b)
                        #{overflow=wrap}
                        d = a - v
                        d < 0 -> {
                            #{overflow=wrap}
                            d = 0 - d
                        }
                        #{overflow=wrap}
                        sum2 = sum2 + d
                    }
                }
            }
            #{overflow=wrap}
            mae-mille2 = sum2 * 1000 / (64 * 48 * 3 * 255)
            ; 4:4:4 at q90 keeps chroma detail
            {
                mae-mille2 < 50 -> {
                    print('PASS: JPEG round-trip MAE (RGB 4:4:4), mae-mille={mae-mille2}')
                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }

                -> {
                    print('FAIL: JPEG round-trip MAE too high (RGB 4:4:4), mae-mille={mae-mille2}')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
    }

    ; ---- 3. RGB gradient, low quality 30 ----
    saved3 = jpeg.save-quality('/tmp/noimg-test-q30.jpg', img, 30)
    {
        saved3 -> {
            print('PASS: JPEG save (RGB q30)')
            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: JPEG save (RGB q30)')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    loaded3 = jpeg.load('/tmp/noimg-test-q30.jpg')
    loaded3: {
        nil -> {
            print('FAIL: JPEG load (RGB q30) returned nil')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        err -> {
            print('FAIL: JPEG load (RGB q30) returned error')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        ok -> {
            rt3 = it
            print('PASS: JPEG load (RGB q30)')
            #{overflow=wrap}
            n-pass = n-pass + 1
            sum3 = 0
            yy <- [0..48): {
                xx <- [0..64): {
                    b <- [0..3): {
                        a = image.get-pixel(img, xx, yy, b)
                        v = image.get-pixel(rt3, xx, yy, b)
                        #{overflow=wrap}
                        d = a - v
                        d < 0 -> {
                            #{overflow=wrap}
                            d = 0 - d
                        }
                        #{overflow=wrap}
                        sum3 = sum3 + d
                    }
                }
            }
            #{overflow=wrap}
            mae-mille3 = sum3 * 1000 / (64 * 48 * 3 * 255)
            ; q30 is aggressively quantized
            {
                mae-mille3 < 200 -> {
                    print('PASS: JPEG round-trip MAE (RGB q30), mae-mille={mae-mille3}')
                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }

                -> {
                    print('FAIL: JPEG round-trip MAE too high (RGB q30), mae-mille={mae-mille3}')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
    }

    ; ---- 4. Grayscale round trip ----
    gray = image.new(48, 48, 1)
    yy <- [0..48): {
        xx <- [0..48): {
            #{overflow=wrap}
            image.set-pixel(gray, xx, yy, 0, (xx * 3 + yy * 2) & 255)
        }
    }
    savedg = jpeg.save('/tmp/noimg-test-gray.jpg', gray)
    {
        savedg -> {
            print('PASS: JPEG save (grayscale)')
            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: JPEG save (grayscale)')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    loadedg = jpeg.load('/tmp/noimg-test-gray.jpg')
    loadedg: {
        nil -> {
            print('FAIL: JPEG load (grayscale) returned nil')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        err -> {
            print('FAIL: JPEG load (grayscale) returned error')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        ok -> {
            rtg = it
            print('PASS: JPEG load (grayscale)')
            #{overflow=wrap}
            n-pass = n-pass + 1
            sumg = 0
            yy <- [0..48): {
                xx <- [0..48): {
                    a = image.get-pixel(gray, xx, yy, 0)
                    v = image.get-pixel(rtg, xx, yy, 0)
                    #{overflow=wrap}
                    d = a - v
                    d < 0 -> {
                        #{overflow=wrap}
                        d = 0 - d
                    }
                    #{overflow=wrap}
                    sumg = sumg + d
                }
            }
            #{overflow=wrap}
            mae-milleg = sumg * 1000 / (48 * 48 * 255)
            ; grayscale at default quality is near-exact on smooth ramps
            {
                mae-milleg < 40 -> {
                    print('PASS: JPEG round-trip MAE (grayscale), mae-mille={mae-milleg}')
                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }

                -> {
                    print('FAIL: JPEG round-trip MAE too high (grayscale), mae-mille={mae-milleg}')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
    }

    ; ---- 5. loading a non-JPEG file fails gracefully ----
    bad = jpeg.load('/tmp/noimg-test-definitely-missing.jpg')
    bad: {
        nil -> {
            print('PASS: JPEG load of missing file fails gracefully')
            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        err -> {
            print('PASS: JPEG load of missing file fails gracefully (err)')
            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        ok -> {
            print('FAIL: JPEG load of missing file should fail')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')

        -> os.exit(1)
    }
}
