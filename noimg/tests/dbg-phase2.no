; dbg-phase2.no — decode Pillow-encoded reference JPEGs and save round-trip PPMs
; for cross_check.py --phase2.
# /noimg/src/pnm.save
# /noimg/src/jpeg.load

main = () {
    dir = '/tmp/cross'
    names = [
        'A',
        'A_q30',
        'A_444',
        'C',
        'C_q30',
        'D',
        'D_q30',
        'D_444',
        'E',
        'E_q30',
        'E_444',
    ]
    i <- [0..11): {
        name = names[i]
        r = jpeg.load(dir + '/P_' + name + '.jpg')
        r: {
            nil -> {
                print('FAIL: P_' + name + ' load nil')
            }

            err -> {
                print('FAIL: P_' + name + ' load err')
            }

            ok -> {
                pnm.save(dir + '/P_' + name + '_rt.ppm', it)
                print('rt: P_' + name)
            }
        }
    }
}
