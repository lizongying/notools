; test-colour.no — Colour space conversion tests
; Tests: rgb2gray, gray2rgb, rgb2hsv, hsv2rgb, rgb2hsl, hsl2rgb, threshold, otsu-threshold,
;   brightness, contrast, gamma, posterize, solarize, sepia
; Run: no run tests/test-colour.no

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.get-pixel
# /noimg/src/colour.rgb2gray
# /noimg/src/colour.gray2rgb
# /noimg/src/colour.rgb2hsv
# /noimg/src/colour.hsv2rgb
# /noimg/src/colour.rgb2hsl
# /noimg/src/colour.hsl2rgb
# /noimg/src/colour.threshold
# /noimg/src/colour.otsu-threshold
# /noimg/src/colour.brightness
# /noimg/src/colour.contrast
# /noimg/src/colour.gamma
# /noimg/src/colour.posterize
# /noimg/src/colour.solarize
# /noimg/src/colour.sepia

main = () {
    print('--- Testing colour operations ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: rgb2gray
    img = image.new(2, 2, 3)
    image.fill(img, 0)
    image.set-pixel(img, 0, 0, 0, 255)
    image.set-pixel(img, 0, 0, 1, 255)
    image.set-pixel(img, 0, 0, 2, 255)
    gray = colour.rgb2gray(img)
    {
        gray.bands == 1 -> {
            v = image.get-pixel(gray, 0, 0, 0)
            {
                v == 255 -> {
                    print('PASS: rgb2gray (white -> 255)')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: rgb2gray (white -> {v})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: rgb2gray bands ({gray.bands})')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: gray2rgb
    gray2 = image.new(2, 2, 1)
    image.fill(gray2, 128)
    rgb = colour.gray2rgb(gray2)
    {
        rgb.bands == 3 -> {
            r = image.get-pixel(rgb, 0, 0, 0)
            g = image.get-pixel(rgb, 0, 0, 1)
            b = image.get-pixel(rgb, 0, 0, 2)
            {
                r == 128 && g == 128 && b == 128 -> {
                    print('PASS: gray2rgb')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: gray2rgb ({r},{g},{b})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: gray2rgb bands')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: threshold
    img3 = image.new(4, 4, 1)
    image.fill(img3, 0)
    image.set-pixel(img3, 0, 0, 0, 200)
    image.set-pixel(img3, 1, 0, 0, 50)
    out3 = colour.threshold(img3, 128)
    v1 = image.get-pixel(out3, 0, 0, 0)
    v2 = image.get-pixel(out3, 1, 0, 0)
    {
        v1 == 255 && v2 == 0 -> {
            print('PASS: threshold')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: threshold ({v1},{v2})')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: otsu-threshold
    img4 = image.new(4, 4, 1)
    image.fill(img4, 0)
    image.set-pixel(img4, 0, 0, 0, 200)
    image.set-pixel(img4, 1, 0, 0, 210)
    image.set-pixel(img4, 2, 0, 0, 220)
    t = colour.otsu-threshold(img4)
    {
        t >= 0 && t <= 255 -> {
            print('PASS: otsu-threshold (t={t})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: otsu-threshold (t={t})')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: brightness
    img5 = image.new(2, 2, 1)
    image.fill(img5, 100)
    out5 = colour.brightness(img5, 50)
    v5 = image.get-pixel(out5, 0, 0, 0)
    {
        v5 == 150 -> {
            print('PASS: brightness')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: brightness (got {v5})')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: posterize
    img6 = image.new(2, 2, 1)
    image.fill(img6, 0)
    image.set-pixel(img6, 0, 0, 0, 100)
    out6 = colour.posterize(img6, 2)
    v6 = image.get-pixel(out6, 0, 0, 0)
    {
        v6 == 64 || v6 == 128 || v6 == 192 || v6 == 0 -> {
            print('PASS: posterize (2 levels, got {v6})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: posterize (got {v6})')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: sepia
    img7 = image.new(2, 2, 3)
    image.fill(img7, 128)
    out7 = colour.sepia(img7)
    {
        out7.bands == 3 -> {
            print('PASS: sepia (bands=3)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: sepia (bands={out7.bands})')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: RGB -> HSV -> RGB round trip
    img8 = image.new(2, 2, 3)
    image.fill(img8, 0)
    image.set-pixel(img8, 0, 0, 0, 255)
    image.set-pixel(img8, 0, 0, 1, 0)
    image.set-pixel(img8, 0, 0, 2, 0)
    hsv = colour.rgb2hsv(img8)
    rgb8 = colour.hsv2rgb(hsv)
    r8 = image.get-pixel(rgb8, 0, 0, 0)
    {
        r8 >= 250 && r8 <= 255 -> {
            print('PASS: RGB->HSV->RGB round trip (red)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: RGB->HSV->RGB round trip (r={r8})')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
