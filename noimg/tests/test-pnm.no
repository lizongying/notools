; test-pnm.no — PNM (PPM/PGM) format round-trip test
; Creates a test image, saves as PPM, reads back, verifies pixel data
; Run: no run tests/test-pnm.no

# /noimg/src/image.new
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/pnm.load
# /noimg/src/pnm.save

main = () {
    print('--- Testing PNM round-trip ---')
    n-pass = 0
    n-fail = 0

    ; Create a test image
    img = image.new(10, 10, 3)
    y <- [0..10): {
        x <- [0..10): {
            #{overflow=wrap}
            image.set-pixel(img, x, y, 0, x * 25)
            #{overflow=wrap}
            image.set-pixel(img, x, y, 1, y * 25)
            image.set-pixel(img, x, y, 2, 128)
        }
    }

    ; Save as PPM
    ok = pnm.save('/tmp/noimg-test.ppm', img)
    {
        ok == true -> {
            print('PASS: PNM save')
            #{overflow=wrap}
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: PNM save')
            #{overflow=wrap}
            n-fail = n-fail + 1
            return
        }
    }

    ; Load back
    result = pnm.load('/tmp/noimg-test.ppm')
    result: {
        nil -> {
            print('FAIL: PNM load returned nil')
            #{overflow=wrap}
            n-fail = n-fail + 1
            return
        }
        err -> {
            print('FAIL: PNM load returned error')
            #{overflow=wrap}
            n-fail = n-fail + 1
            return
        }
        ok -> {
            loaded = it
            {
                loaded.width == 10 && loaded.height == 10 && loaded.bands == 3 -> {
                    print('PASS: PNM load dimensions')
                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: PNM load dimensions ({loaded.width}x{loaded.height}x{loaded.bands})')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }

            ; Verify pixel data
            all-match = true
            y <- [0..10): {
                x <- [0..10): {
                    r = image.get-pixel(loaded, x, y, 0)
                    g = image.get-pixel(loaded, x, y, 1)
                    b = image.get-pixel(loaded, x, y, 2)
                    #{overflow=wrap}
                    {
                        r != x * 25 || g != y * 25 || b != 128 -> {
                            all-match = false
                        }
                    }
                }
            }
            {
                all-match == true -> {
                    print('PASS: PNM pixel data round-trip')
                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: PNM pixel data mismatch')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
