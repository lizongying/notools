; test-filter.no — Filter operations regression tests
; Tests: gauss-blur, gauss-blur-separable, sharpen, sobel, emboss, median,
;   dilate, erode, gradient, unsharp-mask, vignette, box-blur, laplacian
; Run: no run tests/test-filter.no

# /noimg/src/image.new
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/filter.gauss-blur
# /noimg/src/filter.gauss-blur-separable
# /noimg/src/filter.sharpen
# /noimg/src/filter.sobel
# /noimg/src/filter.emboss
# /noimg/src/filter.median
# /noimg/src/filter.dilate
# /noimg/src/filter.erode
# /noimg/src/filter.gradient
# /noimg/src/filter.unsharp-mask
# /noimg/src/filter.vignette
# /noimg/src/filter.box-blur
# /noimg/src/filter.laplacian

main = () {
    print('--- Testing filter operations ---')
    n-pass = 0
    n-fail = 0

    ; Create a test image (8x8 with a white square on black)
    img = image.new(8, 8, 3)
    image.fill(img, 0)
    y <- [2..6): {
        x <- [2..6): {
            image.set-pixel(img, x, y, 0, 255)
            image.set-pixel(img, x, y, 1, 255)
            image.set-pixel(img, x, y, 2, 255)
        }
    }

    ; Test 1: gauss-blur produces same dimensions
    out1 = filter.gauss-blur(img, 10)
    {
        out1.width == 8 && out1.height == 8 && out1.bands == 3 -> {
            print('PASS: gauss-blur dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: gauss-blur dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: gauss-blur-separable produces same dimensions
    out2 = filter.gauss-blur-separable(img, 10)
    {
        out2.width == 8 && out2.height == 8 -> {
            print('PASS: gauss-blur-separable dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: gauss-blur-separable dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: sharpen produces same dimensions
    out3 = filter.sharpen(img, 15, 150)
    {
        out3.width == 8 && out3.height == 8 -> {
            print('PASS: sharpen dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: sharpen dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: sobel produces same dimensions
    out4 = filter.sobel(img)
    {
        out4.width == 8 && out4.height == 8 -> {
            print('PASS: sobel dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: sobel dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: emboss produces same dimensions
    out5 = filter.emboss(img)
    {
        out5.width == 8 && out5.height == 8 -> {
            print('PASS: emboss dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: emboss dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: median produces same dimensions
    out6 = filter.median(img, 1)
    {
        out6.width == 8 && out6.height == 8 -> {
            print('PASS: median dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: median dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: dilate should not shrink bright region
    out7 = filter.dilate(img, 1)
    {
        out7.width == 8 && out7.height == 8 -> {
            ; Center pixel should still be 255
            v = image.get-pixel(out7, 4, 4, 0)
            {
                v == 255 -> {
                    print('PASS: dilate (center stays 255)')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: dilate center (got {v})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: dilate dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: erode should shrink bright region
    out8 = filter.erode(img, 1)
    {
        out8.width == 8 && out8.height == 8 -> {
            ; Corner pixel (1,1) which was 0 should stay 0
            v = image.get-pixel(out8, 0, 0, 0)
            {
                v == 0 -> {
                    print('PASS: erode (corner stays 0)')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: erode corner (got {v})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: erode dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: gradient produces same dimensions
    out9 = filter.gradient(img, 1)
    {
        out9.width == 8 && out9.height == 8 -> {
            print('PASS: gradient dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: gradient dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 10: unsharp-mask produces same dimensions
    out10 = filter.unsharp-mask(img, 10, 150, 0)
    {
        out10.width == 8 && out10.height == 8 -> {
            print('PASS: unsharp-mask dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: unsharp-mask dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 11: vignette produces same dimensions
    out11 = filter.vignette(img, 30)
    {
        out11.width == 8 && out11.height == 8 -> {
            print('PASS: vignette dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: vignette dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 12: box-blur produces same dimensions
    out12 = filter.box-blur(img, 1)
    {
        out12.width == 8 && out12.height == 8 -> {
            print('PASS: box-blur dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: box-blur dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 13: laplacian produces same dimensions
    out13 = filter.laplacian(img)
    {
        out13.width == 8 && out13.height == 8 -> {
            print('PASS: laplacian dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: laplacian dimensions')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
