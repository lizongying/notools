; test-image-bytes.no — high-byte (>=128) binary buffer round-trip guard
; The image pixel buffer (image.data) is a []byte. Historically some code
; paths treated it as a str / signed byte and silently corrupted any channel
; value >= 128. This test builds an RGB image whose channels deliberately
; cover the full 0..255 range and verifies a lossless save->load round-trip
; through every plain RGB-capable codec yields byte-exact pixels.
; It has no external-tool dependency: noimg encodes and decodes itself.
; Run: no run tests/test-image-bytes.no

# /noimg/src/image.new
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/pnm.load
# /noimg/src/pnm.save
# /noimg/src/bmp.load
# /noimg/src/bmp.save
# /noimg/src/tga.load
# /noimg/src/tga.save
# /noimg/src/png.load
# /noimg/src/png.save

main = () {
    print('--- Testing high-byte (>=128) buffer round-trip ---')
    n-pass = 0
    n-fail = 0

    ; 16x16 RGB image exercising the entire 0..255 byte range per channel.
    w = 16
    h = 16
    src = image.new(w, h, 3)
    y <- [0..h): {
        x <- [0..w): {
            #{overflow=wrap}
            k = y * w + x
            #{overflow=wrap}
            base = (k * 7) & 255
            #{overflow=wrap}
            image.set-pixel(src, x, y, 0, base)
            #{overflow=wrap}
            image.set-pixel(src, x, y, 1, base + 128)
            #{overflow=wrap}
            image.set-pixel(src, x, y, 2, base + 200)
        }
    }

    ; ---- PNM ----
    {
        pnm.save('/tmp/noimg-hb.ppm', src) -> {
            r = pnm.load('/tmp/noimg-hb.ppm')
            r: {
                ok -> {
                    loaded = it
                    bad = 0
                    yy <- [0..h): {
                        xx <- [0..w): {
                            #{overflow=wrap}
                            kk = yy * w + xx
                            #{overflow=wrap}
                            bb = (kk * 7) & 255
                            #{overflow=wrap}
                            g0 = (bb + 128) & 255
                            #{overflow=wrap}
                            bl = (bb + 200) & 255
                            {
                                image.get-pixel(loaded, xx, yy, 0) != bb ||
                                image.get-pixel(loaded, xx, yy, 1) != g0 ||
                                image.get-pixel(loaded, xx, yy, 2) != bl -> {
                                    #{overflow=wrap}
                                    bad = bad + 1
                                }
                            }
                        }
                    }
                    {
                        bad == 0 -> {
                            print('PASS: pnm high-byte round-trip exact')
                            #{overflow=wrap}
                            n-pass = n-pass + 1
                        }
                        -> {
                            print('FAIL: pnm high-byte round-trip ({bad} px differ)')
                            #{overflow=wrap}
                            n-fail = n-fail + 1
                        }
                    }
                }

                -> {
                    print('FAIL: pnm load nil/err')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: pnm save')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; ---- BMP ----
    {
        bmp.save('/tmp/noimg-hb.bmp', src) -> {
            r = bmp.load('/tmp/noimg-hb.bmp')
            r: {
                ok -> {
                    loaded = it
                    bad = 0
                    yy <- [0..h): {
                        xx <- [0..w): {
                            #{overflow=wrap}
                            kk = yy * w + xx
                            #{overflow=wrap}
                            bb = (kk * 7) & 255
                            #{overflow=wrap}
                            g0 = (bb + 128) & 255
                            #{overflow=wrap}
                            bl = (bb + 200) & 255
                            {
                                image.get-pixel(loaded, xx, yy, 0) != bb ||
                                image.get-pixel(loaded, xx, yy, 1) != g0 ||
                                image.get-pixel(loaded, xx, yy, 2) != bl -> {
                                    #{overflow=wrap}
                                    bad = bad + 1
                                }
                            }
                        }
                    }
                    {
                        bad == 0 -> {
                            print('PASS: bmp high-byte round-trip exact')
                            #{overflow=wrap}
                            n-pass = n-pass + 1
                        }
                        -> {
                            print('FAIL: bmp high-byte round-trip ({bad} px differ)')
                            #{overflow=wrap}
                            n-fail = n-fail + 1
                        }
                    }
                }

                -> {
                    print('FAIL: bmp load nil/err')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: bmp save')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; ---- TGA ----
    {
        tga.save('/tmp/noimg-hb.tga', src) -> {
            r = tga.load('/tmp/noimg-hb.tga')
            r: {
                ok -> {
                    loaded = it
                    bad = 0
                    yy <- [0..h): {
                        xx <- [0..w): {
                            #{overflow=wrap}
                            kk = yy * w + xx
                            #{overflow=wrap}
                            bb = (kk * 7) & 255
                            #{overflow=wrap}
                            g0 = (bb + 128) & 255
                            #{overflow=wrap}
                            bl = (bb + 200) & 255
                            {
                                image.get-pixel(loaded, xx, yy, 0) != bb ||
                                image.get-pixel(loaded, xx, yy, 1) != g0 ||
                                image.get-pixel(loaded, xx, yy, 2) != bl -> {
                                    #{overflow=wrap}
                                    bad = bad + 1
                                }
                            }
                        }
                    }
                    {
                        bad == 0 -> {
                            print('PASS: tga high-byte round-trip exact')
                            #{overflow=wrap}
                            n-pass = n-pass + 1
                        }
                        -> {
                            print('FAIL: tga high-byte round-trip ({bad} px differ)')
                            #{overflow=wrap}
                            n-fail = n-fail + 1
                        }
                    }
                }

                -> {
                    print('FAIL: tga load nil/err')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: tga save')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; ---- PNG ----
    {
        png.save('/tmp/noimg-hb.png', src) -> {
            r = png.load('/tmp/noimg-hb.png')
            r: {
                ok -> {
                    loaded = it
                    bad = 0
                    yy <- [0..h): {
                        xx <- [0..w): {
                            #{overflow=wrap}
                            kk = yy * w + xx
                            #{overflow=wrap}
                            bb = (kk * 7) & 255
                            #{overflow=wrap}
                            g0 = (bb + 128) & 255
                            #{overflow=wrap}
                            bl = (bb + 200) & 255
                            {
                                image.get-pixel(loaded, xx, yy, 0) != bb ||
                                image.get-pixel(loaded, xx, yy, 1) != g0 ||
                                image.get-pixel(loaded, xx, yy, 2) != bl -> {
                                    #{overflow=wrap}
                                    bad = bad + 1
                                }
                            }
                        }
                    }
                    {
                        bad == 0 -> {
                            print('PASS: png high-byte round-trip exact')
                            #{overflow=wrap}
                            n-pass = n-pass + 1
                        }
                        -> {
                            print('FAIL: png high-byte round-trip ({bad} px differ)')
                            #{overflow=wrap}
                            n-fail = n-fail + 1
                        }
                    }
                }

                -> {
                    print('FAIL: png load nil/err')
                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: png save')
            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')

        -> os.exit(1)
    }
}
