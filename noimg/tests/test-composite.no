; test-composite.no — Composite operations regression tests
; Tests: crop, pad, embed, band-extract, bandjoin2, blend, flatten, replicate, roi-blend
; Run: no run tests/test-composite.no

# /noimg/src/image.new
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/composite.crop
# /noimg/src/composite.pad
# /noimg/src/composite.embed
# /noimg/src/composite.band-extract
# /noimg/src/composite.bandjoin2
# /noimg/src/composite.blend
# /noimg/src/composite.flatten
# /noimg/src/composite.replicate
# /noimg/src/composite.roi-blend

main = () {
    print('--- Testing composite operations ---')
    n-pass = 0
    n-fail = 0

    ; Create a 10x10 test image
    img = image.new(10, 10, 3)
    image.fill(img, 100)
    y <- [0..10): {
        x <- [0..10): {
            image.set-pixel(img, x, y, 0, x * 25)
            image.set-pixel(img, x, y, 1, y * 25)
            image.set-pixel(img, x, y, 2, 50)
        }
    }

    ; Test 1: crop
    out1 = composite.crop(img, 2, 2, 5, 5)
    {
        out1.width == 5 && out1.height == 5 && out1.bands == 3 -> {
            v = image.get-pixel(out1, 0, 0, 0)
            {
                v == 50 -> {
                    print('PASS: crop dimensions + pixel')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: crop pixel (got {v})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: crop dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: pad
    bg []byte = with-len(3)
    bg[0] = 0
    bg[1] = 0
    bg[2] = 0
    out2 = composite.pad(img, 2, bg)
    {
        out2.width == 14 && out2.height == 14 -> {
            print('PASS: pad dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: pad dimensions ({out2.width}x{out2.height})')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: embed
    out3 = composite.embed(img, 5, 5, 20, 20, bg)
    {
        out3.width == 20 && out3.height == 20 -> {
            print('PASS: embed dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: embed dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: band-extract
    out4 = composite.band-extract(img, 0)
    {
        out4.bands == 1 -> {
            print('PASS: band-extract (bands=1)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: band-extract (bands={out4.bands})')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: bandjoin2
    img2 = image.new(10, 10, 1)
    image.fill(img2, 200)
    out5 = composite.bandjoin2(img, img2)
    {
        out5.bands == 4 -> {
            print('PASS: bandjoin2 (bands=4)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: bandjoin2 (bands={out5.bands})')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: blend
    overlay = image.new(10, 10, 3)
    image.fill(overlay, 255)
    out6 = composite.blend(img, overlay, 0, 0, 0, 128)
    {
        out6.width == 10 && out6.height == 10 -> {
            print('PASS: blend dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: blend dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: flatten
    rgba = image.new(4, 4, 4)
    image.fill(rgba, 0)
    y <- [0..4): {
        x <- [0..4): {
            image.set-pixel(rgba, x, y, 0, 255)
            image.set-pixel(rgba, x, y, 1, 0)
            image.set-pixel(rgba, x, y, 2, 0)
            image.set-pixel(rgba, x, y, 3, 128)
        }
    }
    bg3 []byte = with-len(3)
    bg3[0] = 255
    bg3[1] = 255
    bg3[2] = 255
    out7 = composite.flatten(rgba, bg3)
    {
        out7.bands == 3 -> {
            print('PASS: flatten (bands=3)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: flatten (bands={out7.bands})')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: replicate
    small = image.new(2, 2, 3)
    image.fill(small, 255)
    out8 = composite.replicate(small, 4, 4)
    {
        out8.width == 4 && out8.height == 4 -> {
            v = image.get-pixel(out8, 3, 3, 0)
            {
                v == 255 -> {
                    print('PASS: replicate')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: replicate (got {v})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: replicate dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: roi-blend (alias for blend)
    out9 = composite.roi-blend(img, overlay, 0, 0, 0, 255)
    {
        out9.width == 10 -> {
            print('PASS: roi-blend dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: roi-blend dimensions')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
