; test-histogram.no — Histogram operations regression tests
; Tests: find, find-band, find-cumulative, norm, equalize, stretch, apply-lut,
;   mean, variance, stddev, auto-level, auto-contrast, cdf, cdf-normalize,
;   entropy, percentile
; Run: no run tests/test-histogram.no

# /noimg/src/image.new
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/histogram.find
# /noimg/src/histogram.find-band
# /noimg/src/histogram.find-cumulative
# /noimg/src/histogram.norm
# /noimg/src/histogram.equalize
# /noimg/src/histogram.stretch
# /noimg/src/histogram.apply-lut
# /noimg/src/histogram.mean
# /noimg/src/histogram.variance
# /noimg/src/histogram.stddev
# /noimg/src/histogram.auto-level
# /noimg/src/histogram.auto-contrast
# /noimg/src/histogram.cdf
# /noimg/src/histogram.cdf-normalize
# /noimg/src/histogram.entropy
# /noimg/src/histogram.percentile

main = () {
    print('--- Testing histogram operations ---')
    n-pass = 0
    n-fail = 0

    ; Create a test image with known pixel values
    img = image.new(4, 4, 1)
    image.fill(img, 0)
    image.set-pixel(img, 0, 0, 0, 0)
    image.set-pixel(img, 1, 0, 0, 50)
    image.set-pixel(img, 2, 0, 0, 100)
    image.set-pixel(img, 3, 0, 0, 150)
    image.set-pixel(img, 0, 1, 0, 200)
    image.set-pixel(img, 1, 1, 0, 250)
    image.set-pixel(img, 2, 1, 0, 100)
    image.set-pixel(img, 3, 1, 0, 50)
    image.set-pixel(img, 0, 2, 0, 0)
    image.set-pixel(img, 1, 2, 0, 100)
    image.set-pixel(img, 2, 2, 0, 200)
    image.set-pixel(img, 3, 2, 0, 250)
    image.set-pixel(img, 0, 3, 0, 50)
    image.set-pixel(img, 1, 3, 0, 150)
    image.set-pixel(img, 2, 3, 0, 0)
    image.set-pixel(img, 3, 3, 0, 100)

    ; Test 1: find
    hist = histogram.find(img)
    {
        hist.len == 256 -> {
            {
                hist[0] == 3 && hist[50] == 3 && hist[100] == 4 && hist[150] == 2 && hist[200] == 2 && hist[250] == 2 -> {
                    print('PASS: find histogram counts')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: find histogram counts (0={hist[0]}, 50={hist[50]}, 100={hist[100]})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: find histogram length')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: mean
    m = histogram.mean(img)
    {
        m >= 0 && m <= 255 -> {
            print('PASS: mean ({m})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: mean ({m})')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: stddev
    sd = histogram.stddev(img)
    {
        sd >= 0 -> {
            print('PASS: stddev ({sd})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: stddev ({sd})')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: variance
    v = histogram.variance(img)
    {
        v >= 0 -> {
            print('PASS: variance ({v})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: variance ({v})')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: cdf
    cdf = histogram.cdf(hist)
    {
        cdf[255] == 16 -> {
            print('PASS: cdf (total=16)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: cdf (total={cdf[255]})')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: percentile
    p50 = histogram.percentile(img, 50)
    {
        p50 >= 0 && p50 <= 255 -> {
            print('PASS: percentile 50th ({p50})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: percentile ({p50})')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: entropy
    ent = histogram.entropy(img)
    {
        ent >= 0 -> {
            print('PASS: entropy ({ent})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: entropy ({ent})')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: norm produces same dimensions
    out8 = histogram.norm(img)
    {
        out8.width == 4 && out8.height == 4 && out8.bands == 1 -> {
            print('PASS: norm dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: norm dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: equalize produces same dimensions
    out9 = histogram.equalize(img)
    {
        out9.width == 4 && out9.height == 4 -> {
            print('PASS: equalize dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: equalize dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 10: stretch produces same dimensions
    out10 = histogram.stretch(img, 1)
    {
        out10.width == 4 && out10.height == 4 -> {
            print('PASS: stretch dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: stretch dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 11: auto-level produces same dimensions
    out11 = histogram.auto-level(img)
    {
        out11.width == 4 && out11.height == 4 -> {
            print('PASS: auto-level dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: auto-level dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 12: auto-contrast produces same dimensions
    out12 = histogram.auto-contrast(img, 1)
    {
        out12.width == 4 && out12.height == 4 -> {
            print('PASS: auto-contrast dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: auto-contrast dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 13: apply-lut
    lut []byte = with-len(256)
    i <- [0..256): {
        lut[i] = 255 - i
    }
    out13 = histogram.apply-lut(img, lut)
    v13 = image.get-pixel(out13, 0, 0, 0)
    {
        v13 == 255 -> {
            print('PASS: apply-lut (invert: 0 -> 255)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: apply-lut (got {v13})')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
