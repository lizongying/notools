; test-resize-rotate.no — Resize and rotate operations regression tests
; Tests: resize (nearest/bilinear), thumbnail, rot90/180/270, flip, transpose
; Run: no run tests/test-resize-rotate.no

# /noimg/src/image.new
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel
# /noimg/src/resize.resize
# /noimg/src/resize.thumbnail
# /noimg/src/rotate.rot
# /noimg/src/rotate.rot90
# /noimg/src/rotate.rot180
# /noimg/src/rotate.rot270
# /noimg/src/rotate.flip
# /noimg/src/rotate.transpose

main = () {
    print('--- Testing resize and rotate operations ---')
    n-pass = 0
    n-fail = 0

    ; Create a 10x10 test image
    img = image.new(10, 10, 3)
    image.fill(img, 0)
    image.set-pixel(img, 0, 0, 0, 255)

    ; Test 1: resize nearest
    out1 = resize.resize(img, 5, 5, 0)
    {
        out1.width == 5 && out1.height == 5 && out1.bands == 3 -> {
            print('PASS: resize nearest (5x5)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: resize nearest ({out1.width}x{out1.height})')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: resize bilinear
    out2 = resize.resize(img, 20, 20, 1)
    {
        out2.width == 20 && out2.height == 20 -> {
            print('PASS: resize bilinear (20x20)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: resize bilinear ({out2.width}x{out2.height})')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: resize bicubic
    out3 = resize.resize(img, 15, 15, 2)
    {
        out3.width == 15 && out3.height == 15 -> {
            print('PASS: resize bicubic (15x15)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: resize bicubic')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: thumbnail (max dimension)
    out4 = resize.thumbnail(img, 5)
    {
        out4.width <= 5 && out4.height <= 5 -> {
            print('PASS: thumbnail (max=5)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: thumbnail ({out4.width}x{out4.height})')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: rot90
    out5 = rotate.rot90(img)
    {
        out5.width == 10 && out5.height == 10 -> {
            print('PASS: rot90 dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: rot90 dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: rot180
    out6 = rotate.rot180(img)
    {
        out6.width == 10 && out6.height == 10 -> {
            print('PASS: rot180 dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: rot180 dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: rot270
    out7 = rotate.rot270(img)
    {
        out7.width == 10 && out7.height == 10 -> {
            print('PASS: rot270 dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: rot270 dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: rot with angle=90 (dispatcher)
    out8 = rotate.rot(img, 90)
    {
        out8.width == 10 && out8.height == 10 -> {
            print('PASS: rot(90) dispatcher')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: rot(90) dispatcher')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: flip horizontal
    out9 = rotate.flip(img, 0)
    {
        out9.width == 10 && out9.height == 10 -> {
            print('PASS: flip horizontal dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: flip horizontal dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 10: flip vertical
    out10 = rotate.flip(img, 1)
    {
        out10.width == 10 && out10.height == 10 -> {
            print('PASS: flip vertical dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: flip vertical dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 11: transpose
    ; Create a non-square image to test transpose
    wide = image.new(10, 4, 3)
    image.fill(wide, 0)
    out11 = rotate.transpose(wide)
    {
        out11.width == 4 && out11.height == 10 -> {
            print('PASS: transpose (10x4 -> 4x10)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: transpose ({out11.width}x{out11.height})')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
