; test-core.no — Core image operations regression tests
; Tests: image creation, pixel access, copy, fill, invert, add-const, sub-const, mul-const, clamp,
;   has-alpha, is-rgba, is-gray, is-rgb, add-alpha, remove-alpha, n-pixels, n-bytes
; Run: no run tests/test-core.no

# /noimg/src/image.new
# /noimg/src/image.new-from-data
# /noimg/src/image.copy
# /noimg/src/image.fill
# /noimg/src/image.invert
# /noimg/src/image.add-const
# /noimg/src/image.sub-const
# /noimg/src/image.mul-const
# /noimg/src/image.clamp
# /noimg/src/image.has-alpha
# /noimg/src/image.is-rgba
# /noimg/src/image.is-gray
# /noimg/src/image.is-rgb
# /noimg/src/image.add-alpha
# /noimg/src/image.remove-alpha
# /noimg/src/image.n-pixels
# /noimg/src/image.n-bytes
# /noimg/src/image.get-pixel
# /noimg/src/image.set-pixel

main = () {
    print('--- Testing core image operations ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: image.new creates correct dimensions
    img = image.new(10, 20, 3)
    {
        img.width == 10 && img.height == 20 && img.bands == 3 -> {
            print('PASS: image.new dimensions')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: image.new dimensions')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: n-pixels and n-bytes
    np = image.n-pixels(img)
    nb = image.n-bytes(img)
    {
        np == 200 && nb == 600 -> {
            print('PASS: n-pixels / n-bytes')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: n-pixels / n-bytes (got {np}/{nb})')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: fill and get-pixel
    image.fill(img, 128)
    v = image.get-pixel(img, 5, 5, 0)
    {
        v == 128 -> {
            print('PASS: fill + get-pixel')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: fill + get-pixel (got {v})')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: set-pixel
    image.set-pixel(img, 3, 4, 1, 200)
    v2 = image.get-pixel(img, 3, 4, 1)
    {
        v2 == 200 -> {
            print('PASS: set-pixel')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: set-pixel (got {v2})')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: copy
    img2 = image.copy(img)
    v3 = image.get-pixel(img2, 3, 4, 1)
    {
        v3 == 200 -> {
            print('PASS: copy')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: copy (got {v3})')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: invert
    image.fill(img, 100)
    image.invert(img)
    v4 = image.get-pixel(img, 0, 0, 0)
    {
        v4 == 155 -> {
            print('PASS: invert (255-100=155)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: invert (got {v4})')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: add-const
    image.fill(img, 100)
    image.add-const(img, 50)
    v5 = image.get-pixel(img, 0, 0, 0)
    {
        v5 == 150 -> {
            print('PASS: add-const')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: add-const (got {v5})')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: add-const clamp to 255
    image.fill(img, 200)
    image.add-const(img, 100)
    v6 = image.get-pixel(img, 0, 0, 0)
    {
        v6 == 255 -> {
            print('PASS: add-const clamp 255')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: add-const clamp 255 (got {v6})')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: sub-const
    image.fill(img, 100)
    image.sub-const(img, 30)
    v7 = image.get-pixel(img, 0, 0, 0)
    {
        v7 == 70 -> {
            print('PASS: sub-const')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: sub-const (got {v7})')
            n-fail = n-fail + 1
        }
    }

    ; Test 10: sub-const clamp to 0
    image.fill(img, 10)
    image.sub-const(img, 50)
    v8 = image.get-pixel(img, 0, 0, 0)
    {
        v8 == 0 -> {
            print('PASS: sub-const clamp 0')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: sub-const clamp 0 (got {v8})')
            n-fail = n-fail + 1
        }
    }

    ; Test 11: mul-const
    image.fill(img, 100)
    image.mul-const(img, 1500)
    v9 = image.get-pixel(img, 0, 0, 0)
    {
        v9 == 150 -> {
            print('PASS: mul-const (100*1.5=150)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: mul-const (got {v9})')
            n-fail = n-fail + 1
        }
    }

    ; Test 12: clamp
    image.fill(img, 50)
    image.clamp(img, 60, 200)
    v10 = image.get-pixel(img, 0, 0, 0)
    {
        v10 == 60 -> {
            print('PASS: clamp lower bound')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: clamp lower bound (got {v10})')
            n-fail = n-fail + 1
        }
    }

    ; Test 13: is-gray / is-rgb / is-rgba / has-alpha
    gray = image.new(5, 5, 1)
    rgb = image.new(5, 5, 3)
    rgba = image.new(5, 5, 4)
    {
        image.is-gray(gray) == true && image.is-rgb(rgb) == true && image.is-rgba(rgba) == true && image.has-alpha(rgba) == true -> {
            print('PASS: is-gray/is-rgb/is-rgba/has-alpha')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: is-gray/is-rgb/is-rgba/has-alpha')
            n-fail = n-fail + 1
        }
    }

    ; Test 14: add-alpha
    rgb3 = image.new(4, 4, 3)
    image.fill(rgb3, 200)
    rgba2 = image.add-alpha(rgb3)
    {
        rgba2.bands == 4 -> {
            a = image.get-pixel(rgba2, 0, 0, 3)
            {
                a == 255 -> {
                    print('PASS: add-alpha (bands=4, alpha=255)')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: add-alpha alpha value (got {a})')
                    n-fail = n-fail + 1
                }
            }
        }
        -> {
            print('FAIL: add-alpha bands (got {rgba2.bands})')
            n-fail = n-fail + 1
        }
    }

    ; Test 15: remove-alpha
    rgba3 = image.new(3, 3, 4)
    image.fill(rgba3, 100)
    rgb4 = image.remove-alpha(rgba3)
    {
        rgb4.bands == 3 -> {
            print('PASS: remove-alpha (bands=3)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: remove-alpha (got {rgb4.bands})')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('--- Results: {n-pass} passed, {n-fail} failed ---')
    {
        n-fail == 0 -> print('ALL PASS')
        -> os.exit(1)
    }
}
