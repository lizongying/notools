            os.exit(1)
        }
        out = image.add-alpha(img)
        save-image(out-path, out)
        print('Alpha added: {in-path} -> {out-path}')
    }
    cmd == 'flatten' -> {
        argc < 4 -> {
            print('Usage: img flatten <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        bg []byte = with-len(3)
        bg[0] = 255
        bg[1] = 255
        bg[2] = 255
        out = composite.flatten(img, bg)
        save-image(out-path, out)
        print('Flattened: {in-path} -> {out-path}')
    }
    cmd == 'noise' -> {
        argc < 5 -> {
            print('Usage: img noise <in> <out> <amount>')
