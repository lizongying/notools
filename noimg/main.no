; ── Helper: detect format and load ──

load-image = (path str) (img image, ok bool) {
    ok = false

    ; Check extension
    ext = ''
    dot = -1
    i <- [0..path.len): {
        c = path[i] & 255
        c == 46 -> dot = i
    }
    dot >= 0 -> {
        ext = path.slice(dot + 1, path.len)
    }
    {
        ext == 'ppm' || ext == 'pgm' || ext == 'pnm' || ext == 'PPM' || ext == 'PGM' || ext == 'PNM' -> {
            result = pnm.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'bmp' || ext == 'BMP' -> {
            result = bmp.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'tga' || ext == 'TGA' || ext == 'targa' -> {
            result = tga.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'pam' || ext == 'PAM' -> {
            result = pam.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'gif' || ext == 'GIF' -> {
            result = gif.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'png' || ext == 'PNG' -> {
            result = png.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'tif' || ext == 'tiff' || ext == 'TIF' || ext == 'TIFF' -> {
            result = tiff.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'jpg' || ext == 'jpeg' || ext == 'JPG' || ext == 'JPEG' -> {
            result = jpeg.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        ext == 'webp' || ext == 'WEBP' || ext == 'WebP' -> {
            result = webp.load(path)
            result: {
                nil -> return
                err -> return
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
        -> {

            ; Try all formats in order of commonality
            ; PNM first, then BMP, TGA, PNG, TIFF, GIF, PAM, JPEG, WebP
            result = pnm.load(path)
            result: {
                nil -> result2 = bmp.load(path)
                err -> result2 = bmp.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
            ok == false -> result2: {
                nil -> result3 = tga.load(path)
                err -> result3 = tga.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
            ok == false -> result3: {
                nil -> result4 = png.load(path)
                err -> result4 = png.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
            ok == false -> result4: {
                nil -> result5 = tiff.load(path)
                err -> result5 = tiff.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
            ok == false -> result5: {
                nil -> result6 = gif.load(path)
                err -> result6 = gif.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
            ok == false -> result6: {
                nil -> result7 = pam.load(path)
                err -> result7 = pam.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
            ok == false -> result7: {
                nil -> result8 = jpeg.load(path)
                err -> result8 = jpeg.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
            ok == false -> result8: {
                nil -> result9 = webp.load(path)
                err -> result9 = webp.load(path)
                ok -> {
                    img = it
                    ok = true
                }
            }
        }
    }
}

; ── Helper: save image with format detection ──

save-image = (path str, img image) (ok bool) {
    ok = false
    ext = ''
    dot = -1
    i <- [0..path.len): {
        c = path[i] & 255
        c == 46 -> dot = i
    }
    dot >= 0 -> {
        ext = path.slice(dot + 1, path.len)
    }
    {
        ext == 'bmp' || ext == 'BMP' -> {
            ok = bmp.save(path, img)
        }
        ext == 'tga' || ext == 'TGA' || ext == 'targa' -> {
            ok = tga.save(path, img)
        }
        ext == 'pam' || ext == 'PAM' -> {
            ok = pam.save(path, img)
        }
        ext == 'gif' || ext == 'GIF' -> {
            ok = gif.save(path, img)
        }
        ext == 'png' || ext == 'PNG' -> {
            ok = png.save(path, img)
        }
        ext == 'tif' || ext == 'tiff' || ext == 'TIF' || ext == 'TIFF' -> {
            ok = tiff.save(path, img)
        }
        ext == 'jpg' || ext == 'jpeg' || ext == 'JPG' || ext == 'JPEG' -> {
            ok = jpeg.save(path, img)
        }
        ext == 'webp' || ext == 'WEBP' || ext == 'WebP' -> {
            ok = webp.save(path, img)
        }
        -> {

            ; Default to PNM (PPM/PGM)
            ok = pnm.save(path, img)
        }
    }
}

; ── Entry point ──

argc = args()

{
    argc < 2 -> {
        print-usage()
        os.exit(1)
    }
}
cmd = arg(1)

{
    cmd == 'version' -> {
        print('img v0.1.0 (pure Nolang image processing)')
    }
    cmd == 'help' -> {
        print-usage()
    }
    cmd == 'info' -> {
        argc < 3 -> {
            print('Usage: img info <file>')
            os.exit(1)
        }
        path = arg(2)
        img, ok = load-image(path)
        ok == false -> {
            print('error: could not load {path}')
            os.exit(1)
        }
        print('File: {path}')
        print('Width: {img.width}')
        print('Height: {img.height}')
        print('Bands: {img.bands}')
        print('Format: {img.format}')
        print('Interpretation: {img.interpretation}')
        mn = image.min-val(img)
        mx = image.max-val(img)
        avg = image.avg(img)
        print('Min: {mn}')
        print('Max: {mx}')
        print('Avg: {avg}')
    }
    cmd == 'convert' -> {
        argc < 4 -> {
            print('Usage: img convert <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        save-image(out-path, img)
        print('Converted: {in-path} -> {out-path}')
    }
    cmd == 'resize' -> {
        argc < 6 -> {
            print('Usage: img resize <in> <out> <width> <height> [method]')
            print('  method: 0=nearest-neighbor, 1=bilinear (default), 2=bicubic')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        w = parse-i64(arg(4))
        h = parse-i64(arg(5))
        method = 1
        {
            argc >= 7 -> {
                method = parse-i64(arg(6))
            }
        }
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = resize.resize(img, w, h, method)
        save-image(out-path, out)
        print('Resized: {in-path} -> {out-path} ({w}x{h}, method={method})')
    }
    cmd == 'thumbnail' -> {
        argc < 5 -> {
            print('Usage: img thumbnail <in> <out> <max-size>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        sz = parse-i64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = resize.thumbnail(img, sz, sz)
        save-image(out-path, out)
        print('Thumbnail: {in-path} -> {out-path}')
    }
    cmd == 'rotate' -> {
        argc < 5 -> {
            print('Usage: img rotate <in> <out> <90|180|270>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        angle = parse-i64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = rotate.rot(img, angle)
        save-image(out-path, out)
        print('Rotated {angle}°: {in-path} -> {out-path}')
    }
    cmd == 'rot-free' -> {
        argc < 5 -> {
            print('Usage: img rot-free <in> <out> <angle-degrees>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        angle = parse-f64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = rotate.rot-free(img, angle)
        save-image(out-path, out)
        print('Rotated {angle}°: {in-path} -> {out-path}')
    }
    cmd == 'flip' -> {
        argc < 5 -> {
            print('Usage: img flip <in> <out> <h|v|both>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        dir-s = arg(4)
        dir = 0
        dir-s == 'h' -> dir = 0
        dir-s == 'v' -> dir = 1
        dir-s == 'both' -> dir = 2
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = rotate.flip(img, dir)
        save-image(out-path, out)
        print('Flipped {dir-s}: {in-path} -> {out-path}')
    }
    cmd == 'crop' -> {
        argc < 8 -> {
            print('Usage: img crop <in> <out> <x> <y> <w> <h>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        cx = parse-i64(arg(4))
        cy = parse-i64(arg(5))
        cw = parse-i64(arg(6))
        ch = parse-i64(arg(7))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = composite.crop(img, cx, cy, cw, ch)
        save-image(out-path, out)
        print('Cropped: {in-path} -> {out-path}')
    }
    cmd == 'grayscale' -> {
        argc < 4 -> {
            print('Usage: img grayscale <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = colour.rgb2gray(img)
        save-image(out-path, out)
        print('Grayscale: {in-path} -> {out-path}')
    }
    cmd == 'invert' -> {
        argc < 4 -> {
            print('Usage: img invert <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        image.invert(img)
        save-image(out-path, img)
        print('Inverted: {in-path} -> {out-path}')
    }
    cmd == 'sepia' -> {
        argc < 4 -> {
            print('Usage: img sepia <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = colour.sepia(img)
        save-image(out-path, out)
        print('Sepia: {in-path} -> {out-path}')
    }
    cmd == 'blur' -> {
        argc < 5 -> {
            print('Usage: img blur <in> <out> <sigma*10>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        sigma = parse-i64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = filter.gauss-blur(img, sigma)
        save-image(out-path, out)
        print('Blurred: {in-path} -> {out-path}')
    }
    cmd == 'sharpen' -> {
        argc < 4 -> {
            print('Usage: img sharpen <in> <out> [amount*100]')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        amount = 150
        argc >= 5 -> amount = parse-i64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = filter.sharpen(img, 15, amount)
        save-image(out-path, out)
        print('Sharpened: {in-path} -> {out-path}')
    }
    cmd == 'edge' -> {
        argc < 4 -> {
            print('Usage: img edge <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = filter.sobel(img)
        save-image(out-path, out)
        print('Edge detected: {in-path} -> {out-path}')
    }
