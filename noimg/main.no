    cmd == 'otsu' -> {
        argc < 4 -> {
            print('Usage: img otsu <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        t = colour.otsu-threshold(img)
        out = colour.threshold(img, t)
        save-image(out-path, out)
        print('Otsu threshold={t}: {in-path} -> {out-path}')
    }
    cmd == 'adjust-hsv' -> {
        argc < 7 -> {
            print('Usage: img adjust-hsv <in> <out> <hue> <sat> <val>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        hue = parse-i64(arg(4))
        sat = parse-i64(arg(5))
        val = parse-i64(arg(6))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = colour.adjust-hsv(img, hue, sat, val)
        save-image(out-path, out)
        print('HSV adjusted: {in-path} -> {out-path}')
    }
    cmd == 'transpose' -> {
        argc < 4 -> {
            print('Usage: img transpose <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = rotate.transpose(img)
        save-image(out-path, out)
        print('Transposed: {in-path} -> {out-path}')
    }
    cmd == 'scale' -> {
        argc < 6 -> {
            print('Usage: img scale <in> <out> <sx*100> <sy*100>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        sx = parse-i64(arg(4))
        sy = parse-i64(arg(5))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        new-w = img.width * sx / 100
        new-h = img.height * sy / 100
        new-w < 1 -> new-w = 1
        new-h < 1 -> new-h = 1
        out = resize.resize(img, new-w, new-h, 1)
        save-image(out-path, out)
        print('Scaled: {in-path} -> {out-path} ({new-w}x{new-h})')
    }
    cmd == 'embed' -> {
        argc < 8 -> {
            print('Usage: img embed <in> <out> <x> <y> <w> <h>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        ex = parse-i64(arg(4))
        ey = parse-i64(arg(5))
        ew = parse-i64(arg(6))
        eh = parse-i64(arg(7))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        bg []byte = with-len(img.bands)
        i <- [0..img.bands): {
            bg[i] = 0
        }
        out = composite.embed(img, ex, ey, ew, eh, bg)
        save-image(out-path, out)
        print('Embedded: {in-path} -> {out-path}')
    }
    cmd == 'bandjoin2' -> {
        argc < 6 -> {
            print('Usage: img bandjoin2 <in1> <in2> <out>')
            os.exit(1)
        }
        in1-path = arg(2)
        in2-path = arg(3)
        out-path = arg(4)
        img1, ok1 = load-image(in1-path)
        img2, ok2 = load-image(in2-path)
        {
            ok1 == false || ok2 == false -> {
                print('error: could not load images')
                os.exit(1)
            }
        }
        out = composite.bandjoin2(img1, img2)
        save-image(out-path, out)
        print('Band joined: {in1-path} + {in2-path} -> {out-path}')
    }
    cmd == 'roi-blend' -> {
        argc < 9 -> {
            print('Usage: img roi-blend <base> <overlay> <out> <x> <y> <mode> <alpha>')
            os.exit(1)
        }
        base-path = arg(2)
        overlay-path = arg(3)
        out-path = arg(4)
        x = parse-i64(arg(5))
        y = parse-i64(arg(6))
        mode = parse-i64(arg(7))
        alpha = parse-i64(arg(8))
        base, ok1 = load-image(base-path)
        overlay, ok2 = load-image(overlay-path)
        {
            ok1 == false || ok2 == false -> {
                print('error: could not load images')
                os.exit(1)
            }
        }
        out = composite.roi-blend(base, overlay, x, y, mode, alpha)
        save-image(out-path, out)
        print('ROI blended: {overlay-path} onto {base-path} -> {out-path}')
    }
    -> {
        print('Unknown command: {cmd}')
        print-usage()
        os.exit(1)
    }
}
