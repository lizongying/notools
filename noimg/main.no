        argc < 5 -> {
            print('Usage: img auto-contrast <in> <out> <clip-percent>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        clip = parse-i64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = histogram.auto-contrast(img, clip)
        save-image(out-path, out)
        print('Auto-contrast: {in-path} -> {out-path}')
    }
    cmd == 'histogram' -> {
        argc < 3 -> {
            print('Usage: img histogram <file>')
            os.exit(1)
        }
        in-path = arg(2)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        hist = histogram.find(img)
        histogram.hist-print(hist, in-path)
    }
    cmd == 'stats' -> {
        argc < 3 -> {
            print('Usage: img stats <file>')
            os.exit(1)
        }
        in-path = arg(2)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        mn = image.min-val(img)
        mx = image.max-val(img)
        avg = image.avg(img)
        mean = histogram.mean(img)
        sd = histogram.stddev(img)
        print('Image: {in-path}')
        print('Dimensions: {img.width}x{img.height}x{img.bands}')
        print('Min: {mn}')
        print('Max: {mx}')
        print('Avg: {avg}')
        print('Mean: {mean}')
        print('StdDev: {sd}')
    }
    cmd == 'entropy' -> {
        argc < 3 -> {
            print('Usage: img entropy <file>')
            os.exit(1)
        }
        in-path = arg(2)
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        ent = histogram.entropy(img)
        med = histogram.percentile(img, 50)
        print('Image: {in-path}')
        print('Entropy: {ent} bits')
        print('Median: {med}')
    }
    cmd == 'composite' -> {
        argc < 7 -> {
            print('Usage: img composite <base> <overlay> <out> <x> <y>')
            os.exit(1)
        }
        base-path = arg(2)
        overlay-path = arg(3)
        out-path = arg(4)
        x = parse-i64(arg(5))
        y = parse-i64(arg(6))
        base, ok1 = load-image(base-path)
        overlay, ok2 = load-image(overlay-path)
        {
            ok1 == false || ok2 == false -> {
                print('error: could not load images')
                os.exit(1)
            }
        }
        out = composite.composite(base, overlay, x, y)
        save-image(out-path, out)
        print('Composited: {overlay-path} onto {base-path} -> {out-path}')
    }
    cmd == 'pad' -> {
        argc < 5 -> {
            print('Usage: img pad <in> <out> <border>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        border = parse-i64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        bg []byte = with-len(img.bands)
        i <- [0..img.bands): {
            bg[i] = 0
        }
        out = composite.pad(img, border, bg)
        save-image(out-path, out)
        print('Padded: {in-path} -> {out-path}')
    }
    cmd == 'band' -> {
        argc < 5 -> {
            print('Usage: img band <in> <out> <index>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        band = parse-i64(arg(4))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = composite.band-extract(img, band)
        save-image(out-path, out)
        print('Band {band} extracted: {in-path} -> {out-path}')
    }
    cmd == 'add-alpha' -> {
        argc < 4 -> {
            print('Usage: img add-alpha <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
