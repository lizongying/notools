        }
        out = filter.add-noise(img, amount)
        save-image(out-path, out)
        print('Noise added: {in-path} -> {out-path}')
    }
    cmd == 'unsharp-mask' -> {
        argc < 7 -> {
            print('Usage: img unsharp-mask <in> <out> <sigma> <amount> <threshold>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        sigma = parse-i64(arg(4))
        amount = parse-i64(arg(5))
        threshold = parse-i64(arg(6))
        img, ok = load-image(in-path)
        ok == false -> {
            print('error: could not load {in-path}')
            os.exit(1)
        }
        out = filter.unsharp-mask(img, sigma, amount, threshold)
        save-image(out-path, out)
        print('Unsharp masked: {in-path} -> {out-path}')
    }
    cmd == 'box-blur' -> {
        argc < 5 -> {
            print('Usage: img box-blur <in> <out> <radius>')
