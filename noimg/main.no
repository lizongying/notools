        }
        out = histogram.stretch(img, clip)
        save-image(out-path, out)
        print('Histogram stretched: {in-path} -> {out-path}')
    }
    cmd == 'auto-level' -> {
        argc < 4 -> {
            print('Usage: img auto-level <in> <out>')
            os.exit(1)
        }
        in-path = arg(2)
        out-path = arg(3)
        img, ok = load-image(in-path)
        ok == false -> {
