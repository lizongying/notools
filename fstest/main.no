# /git/src/util
# /git/src/oid
# /git/src/zlib
# /git/src/object
main = () {
    h = oid.object-header('blob', 5)
    print('H=[')
    print(h)
    print(']')
    p = object.str-to-proper(h)
    print('P=[')
    print(p)
    print(']')
    comp = zlib.zlib-compress(p)
    fd = fs.open-write('/tmp/wt.bin')
    j <- [0..comp.len): { c = comp[j]; cs = with-len(1); cs[0] = c; fs.write(fd, cs, 1) }
    fs.close(fd)
    print('WROTE')
}
