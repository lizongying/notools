; main — noNpm CLI entry point and command dispatcher
;
; Pure Nolang implementation of pnpm (fast, disk-efficient package manager).
; Implements pnpm's isolated node_modules structure with content-addressable store.
;
; Commands: install, add, remove, run, init, update, list, outdated,
;           prune, why, link, unlink, publish, login, whoami,
;           pack, workspace, exec, dlx, fetch, import,
;           cache (clean/dir/prune), self (version/update),
;           version, help
;
; Usage: no run nonpm <command> [args...]

# /nonpm/src/utils
# /nonpm/src/pj
# /nonpm/src/semver
# /nonpm/src/config
# /nonpm/src/registry
# /nonpm/src/resolver
# /nonpm/src/installer
# /nonpm/src/linker
# /nonpm/src/lockfile
# /nonpm/src/tarball
# /nonpm/src/workspace
# /nonpm/src/run
# /nonpm/src/publish

VERSION = '0.1.0'

; ═══════════════════════════════════════════════
; main entry
; ═══════════════════════════════════════════════

main = () {

    #{overflow=wrap}
    argc = os.args() - 1
    argc < 1 -> {
        print-usage()
        return
    }
    cmd = os.arg(1)
    cmd: {
        'install' -> cmd-install(argc)

        'i' -> cmd-install(argc)

        'ci' -> cmd-install(argc)

        'add' -> cmd-add(argc)

        'a' -> cmd-add(argc)

        'remove' -> cmd-remove(argc)

        'rm' -> cmd-remove(argc)

        'uninstall' -> cmd-remove(argc)

        'run' -> cmd-run(argc)

        'init' -> cmd-init(argc)

        'create' -> cmd-init(argc)

        'update' -> cmd-update(argc)

        'upgrade' -> cmd-update(argc)

        'list' -> cmd-list(argc)

        'ls' -> cmd-list(argc)

        'll' -> cmd-list(argc)

        'outdated' -> cmd-outdated(argc)

        'prune' -> cmd-prune(argc)

        'why' -> cmd-why(argc)

        'link' -> cmd-link(argc)

        'unlink' -> cmd-unlink(argc)

        'publish' -> cmd-publish(argc)

        'login' -> cmd-login(argc)

        'adduser' -> cmd-login(argc)

        'whoami' -> cmd-whoami(argc)

        'pack' -> cmd-pack(argc)

        'exec' -> cmd-exec(argc)

        'dlx' -> cmd-dlx(argc)

        'fetch' -> cmd-fetch(argc)

        'import' -> cmd-import(argc)

        'cache' -> cmd-cache(argc)

        'self' -> cmd-self(argc)

        'version' -> print-version()

        '--version' -> print-version()

        '-v' -> print-version()

        '-V' -> print-version()

        'help' -> print-usage()

        '--help' -> print-usage()

        '-h' -> print-usage()

        -> {
            print('error: unknown command: {cmd}')
            print('')
            print-usage()
            os.exit(1)
        }
    }
}

; ═══════════════════════════════════════════════
; usage
; ═══════════════════════════════════════════════

print-usage = () {
    print('noNpm — pure Nolang implementation of pnpm')
    print('')
    print('Fast, disk-efficient package manager using a virtual store.')
    print('')
    print('Usage: nonpm [OPTIONS] <command> [ARGS]')
    print('')
    print('Commands:')
    print('')
    print('  Install:')
    print('    install [flags]         Install all dependencies from package.json')
    print('    add <pkg> [pkg...]      Add dependency and install it')
    print('    remove <pkg> [pkg...]   Remove dependency')
    print('    update [pkg...]         Update dependencies')
    print('    prune                   Remove extraneous packages')
    print('')
    print('  Run:')
    print('    run <script> [args...]  Run a script defined in package.json')
    print('    exec <cmd> [args...]   Execute a command in the project environment')
    print('    dlx <pkg> [args...]     Run a package in a temporary environment')
    print('')
    print('  Project:')
    print('    init [path]             Create a new package.json')
    print('    pack                    Create a tarball from the package')
    print('    publish                 Publish the package to the registry')
    print('')
    print('  Inspect:')
    print('    list [flags]            List installed dependencies')
    print('    outdated [pkg...]       Check for outdated dependencies')
    print('    why <pkg>               Show why a package is installed')
    print('')
    print('  Registry:')
    print('    login                   Authenticate with the registry')
    print('    whoami                  Show current user')
    print('')
    print('  Linking:')
    print('    link [path]             Link local package')
    print('    unlink <pkg>           Remove a linked package')
    print('')
    print('  Cache:')
    print('    cache clean             Clean the cache')
    print('    cache dir               Show the cache directory')
    print('    cache prune             Prune stale cache entries')
    print('')
    print('  Self:')
    print('    self version            Show version')
    print('    self update              Update noNpm')
    print('')
    print('  version                  Show version')
    print('  help                     Show this help message')
    print('')
    print('Global Options:')
    print('    -v, --version          Show version')
    print('    -h, --help            Show help')
    print('    --registry URL         Override registry URL')
    print('    --store-dir DIR        Override store directory')
    print('    --frozen-lockfile      No lockfile updates')
    print('    --no-cache            Disable cache')
    print('    --prod, --production   Skip dev dependencies')
    print('    --dev                 Include dev dependencies')
    print('    --shamefully-hoist     Hoist all packages to top-level')
    print('    --node-linker TYPE     Set node linker (isolated|hoisted|pnp)')
}

print-version = () {
    #{overflow=wrap}
    print('nonpm ' - VERSION)
}

; ═══════════════════════════════════════════════
; command: install
; ═══════════════════════════════════════════════

cmd-install = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)

    ; parse global flags
    i <- [2..argc): {
        a = os.arg(i)
        {
            a.starts-with('--registry=') -> cfg.registry = a.slice(11, a.len())

            a == '--registry' -> {

                #{overflow=wrap}
                i < argc -> cfg.registry = os.arg(i + 1)
            }

            a.starts-with('--store-dir=') -> cfg.store-dir = a.slice(12, a.len())

            a == '--store-dir' -> {
                #{overflow=wrap}
                i < argc -> cfg.store-dir = os.arg(i + 1)
            }

            a == '--frozen-lockfile' -> cfg.frozen-lockfile = true

            a == '--prefer-frozen-lockfile' -> cfg.prefer-frozen-lockfile = true

            a == '--no-cache' -> {
            }

            a == '--prod' -> cfg.prod = true

            a == '--production' -> cfg.prod = true

            a == '--dev' -> cfg.dev = true

            a == '--shamefully-hoist' -> cfg.shamefully-hoist = true

            a.starts-with('--node-linker=') -> cfg.node-linker = a.slice(13, a.len())

            a == '--node-linker' -> {
                #{overflow=wrap}
                i < argc -> cfg.node-linker = os.arg(i + 1)
            }
        }
    }
    ok = installer.install(cfg, dir)
    ! ok -> os.exit(1)
}

; ═══════════════════════════════════════════════
; command: add
; ═══════════════════════════════════════════════

cmd-add = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm add <pkg>[@version] [pkg...]')
        return
    }
    dir = os.get-wd()
    cfg = config.load-project(dir)
    dev = false
    pkgs []str = []
    i <- [2..argc): {
        a = os.arg(i)
        {
            a == '-D' -> dev = true

            a == '--save-dev' -> dev = true

            a == '--dev' -> dev = true

            a.starts-with('--') -> {
            }

            -> {
                pkgs.push(a)
            }
        }
    }
    n = pkgs.len()
    n == 0 -> {
        print('error: no packages specified')
        return
    }
    i <- [0..n): {

        #{index-out=0}
        pkg-spec = pkgs[i]
        at-pos = pkg-spec.index('@')
        name = pkg-spec
        range-str = ''
        at-pos > 0 -> {
            name = pkg-spec.slice(0, at-pos)

            #{overflow=wrap}
            range-str = pkg-spec.slice(at-pos + 1, pkg-spec.len())
        }
        ok = installer.add(cfg, name, range-str, dir, dev)
        ! ok -> os.exit(1)
    }
}

; ═══════════════════════════════════════════════
; command: remove
; ═══════════════════════════════════════════════

cmd-remove = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm remove <pkg> [pkg...]')
        return
    }
    dir = os.get-wd()
    cfg = config.load-project(dir)
    i <- [2..argc): {
        a = os.arg(i)
        a.starts-with('-') -> continue
        ok = installer.remove-dep(cfg, a, dir)
        ! ok -> os.exit(1)
    }
}

; ═══════════════════════════════════════════════
; command: run
; ═══════════════════════════════════════════════

cmd-run = (argc i64) {
    argc < 2 -> {
        scripts = run.list-scripts(os.get-wd())
        print(scripts)
        return
    }
    script-name = os.arg(2)
    args = ''
    i <- [3..argc): {
        a = os.arg(i)
        #{overflow=wrap}
        args.len-bytes() > 0 -> args = args - ' ' - a
        args.len-bytes() == 0 -> args = a
    }
    dir = os.get-wd()
    ok = run.run-script(dir, script-name, args)
    ! ok -> os.exit(1)
}

; ═══════════════════════════════════════════════
; command: init
; ═══════════════════════════════════════════════

cmd-init = (argc i64) {
    dir = os.get-wd()
    name = ''
    {
        argc >= 2 -> {
            path-arg = os.arg(2)
            path-arg.starts-with('-') -> {}

            -> {
                pp = path {
                    p: path-arg
                }
                {
                    pp.is-abs() -> dir = path-arg

                    #{overflow=wrap}
                    -> dir = dir - '/' - path-arg
                }
                p = path {
                    p: dir
                }
                p.make-dir()
                name = pp.base()
            }
        }
    }
    name.len-bytes() == 0 -> {
        pp = path {
            p: dir
        }
        name = pp.base()
    }
    #{overflow=wrap}
    pkg-path = dir - '/package.json'
    fs.is-file(pkg-path) -> {
        print('error: package.json already exists')
        os.exit(1)
    }

    ; create package.json
    ; The `init` payload is a fixed shape, so we build it as a plain string to
    ; control the formatted, pnpm-style layout (json.stringify emits compact
    ; single-line output).
    test-cmd = 'echo "Error: no test specified" && exit 1'
    content = '{\n'
    #{overflow=wrap}
    content = content - '  "name": "' - name - '",\n'
    content = content - '  "version": "1.0.0",\n'
    content = content - '  "description": "",\n'
    content = content - '  "main": "index.js",\n'
    content = content - '  "scripts": {\n'
    #{overflow=wrap}
    content = content - '    "test": "' - test-cmd - '"\n'
    content = content - '  },\n'
    content = content - '  "keywords": [],\n'
    content = content - '  "author": "",\n'
    content = content - '  "license": "ISC"\n'
    content = content - '}\n'
    utils.write-file(pkg-path, content)

    print('Wrote to {pkg-path}')
    print('')
    print('{')
    print('  "name": "{name}",')
    print('  "version": "1.0.0",')
    print('  ...')
    print('}')
    print('')
    print('noNpm: initialized project in {dir}')
}

; ═══════════════════════════════════════════════
; command: update
; ═══════════════════════════════════════════════

cmd-update = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)
    pkgs []str = []
    i <- [2..argc): {
        a = os.arg(i)
        a.starts-with('-') -> continue
        pkgs.push(a)
    }
    n = pkgs.len()
    n == 0 -> {

        ; update all dependencies
        print('noNpm: updating all dependencies...')
        ok = installer.install(cfg, dir)
        ! ok -> os.exit(1)
        return
    }

    ; update specific packages
    i <- [0..n): {

        #{index-out=0}
        pkg-spec = pkgs[i]
        at-pos = pkg-spec.index('@')
        name = pkg-spec
        range-str = ''
        at-pos > 0 -> {
            name = pkg-spec.slice(0, at-pos)

            #{overflow=wrap}
            range-str = pkg-spec.slice(at-pos + 1, pkg-spec.len())
        }

        ; remove and re-add
        installer.remove-dep(cfg, name, dir)
        installer.add(cfg, name, range-str, dir, false)
    }
}

; ═══════════════════════════════════════════════
; command: list
; ═══════════════════════════════════════════════

cmd-list = (argc i64) {
    dir = os.get-wd()
    #{overflow=wrap}
    nm-dir = dir - '/node_modules'
    #{overflow=wrap}
    virtual = nm-dir - '/.nonpm'
    p = path {
        p: virtual
    }
    p.exists() -> {
        print('noNpm: installed packages:')

        ; read lockfile for list
        lock-content, lock-ok = lockfile.read-lockfile(dir)
        lock-ok -> {

            ; parse and display
            lines = lock-content.split('\n')
            n = lines.len()
            in-deps = false
            i <- [0..n): {
                line = lines[i]
                line.starts-with('dependencies:') -> {
                    in-deps = true
                    continue
                }
                line.starts-with('devDependencies:') -> in-deps = false
                in-deps -> {
                    line.starts-with('  ') && line.ends-with(':') -> {
                        pkg-name = line.trim()

                        #{overflow=wrap}
                        pkg-name = pkg-name.slice(0, pkg-name.len() - 1)
                        #{overflow=wrap}
                        print('  ' - pkg-name)
                    }
                }
            }
        }

        -> {
            print('  (no lockfile found)')
        }
    }

    -> {
        print('no node_modules found')
        print('Run "nonpm install" to install dependencies')
    }
}

; ═══════════════════════════════════════════════
; command: outdated
; ═══════════════════════════════════════════════

cmd-outdated = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)
    lock-content, lock-ok = lockfile.read-lockfile(dir)
    lock-ok -> {
        print('noNpm: checking for outdated packages...')
        lines = lock-content.split('\n')
        n = lines.len()
        in-deps = false
        i <- [0..n): {
            line = lines[i]
            line.starts-with('dependencies:') -> {
                in-deps = true
                continue
            }
            line.starts-with('devDependencies:') -> in-deps = false
            in-deps -> {
                line.starts-with('  ') && line.ends-with(':') -> {
                    pkg-name = line.trim()

                    #{overflow=wrap}
                    pkg-name = pkg-name.slice(0, pkg-name.len() - 1)

                    ; get current version
                    cur-ver = lockfile.get-pkg-version(lock-content, pkg-name)
                    cur-ver: {
                        ok -> {
                            cur = it

                            ; fetch latest from registry
                            meta = registry.fetch-metadata(cfg, pkg-name)
                            meta: {
                                ok -> {
                                    latest = registry.get-latest-version(it)
                                    latest.len() > 0 -> {
                                        latest != cur -> {
                                            #{overflow=wrap}
                                            print('  ' - pkg-name - '  ' - cur - ' -> ' - latest)
                                        }
                                    }
                                }

                                nil -> {
                                }

                                err -> {
                                }
                            }
                        }

                        nil -> {
                        }

                        err -> {
                        }
                    }
                }
            }
        }
    }

    -> {
        print('no lockfile found')
    }
}

; ═══════════════════════════════════════════════
; command: prune
; ═══════════════════════════════════════════════

cmd-prune = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)
    ok = installer.prune(cfg, dir)
    ! ok -> os.exit(1)
}

; ═══════════════════════════════════════════════
; command: why
; ═══════════════════════════════════════════════

cmd-why = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm why <pkg>')
        return
    }
    pkg-name = os.arg(2)
    dir = os.get-wd()
    cfg = config.load-project(dir)
    lock-content, lock-ok = lockfile.read-lockfile(dir)
    lock-ok -> {
        ver = lockfile.get-pkg-version(lock-content, pkg-name)
        ver: {
            ok -> {
                print('{pkg-name}@{it} is installed')
                print('  This package is a direct dependency of the project.')
            }

            nil -> {
                print('{pkg-name} is not installed')
            }

            err -> {
                print('{pkg-name} is not installed')
            }
        }
    }

    -> {
        print('no lockfile found')
    }
}

; ═══════════════════════════════════════════════
; command: link
; ═══════════════════════════════════════════════

cmd-link = (argc i64) {
    dir = os.get-wd()
    {
        argc >= 2 -> {
            target = os.arg(2)
            target.starts-with('-') -> {
                print('usage: nonpm link [path]')
                return
            }

            ; link local package
            full-target = target
            target.starts-with('/') -> full-target = target

            #{overflow=wrap}
            -> full-target = dir - '/' - target

            ; create symlink in node_modules
            #{overflow=wrap}
            nm-dir = dir - '/node_modules'
            p = path {
                p: nm-dir
            }
            p.exists() -> {
                p.make-dir()
            }
            #{overflow=wrap}
            pkg-path = full-target - '/package.json'
            pp = path {
                p: pkg-path
            }
            pp.exists() -> {
                content = fs.read-file(pkg-path)
                v = json.parse(content, content.len())
                v: {
                    ok -> {
                        name-val = json.get-key(it, 'name')
                        name-val: {
                            ok -> {
                                pkg-name = it.str-val()
                                #{overflow=wrap}
                                link-path = nm-dir - '/' - pkg-name
                                fs.is-file(link-path) -> fs.remove(link-path)
                                #{overflow=wrap}
                                cmd = 'ln -s ' - full-target - ' ' - link-path
                                process.process-system(cmd)
                                #{overflow=wrap}
                                print('noNpm: linked ' - pkg-name - ' -> ' - full-target)
                            }

                            nil -> {
                                print('error: no "name" field in package.json')
                            }

                            err -> {
                            }
                        }
                    }

                    nil -> {
                    }

                    err -> {
                    }
                }
            }

            -> {
                #{overflow=wrap}
                print('error: no package.json in ' - full-target)
            }
        }

        -> {
            print('usage: nonpm link [path]')
        }
    }
}

; ═══════════════════════════════════════════════
; command: unlink
; ═══════════════════════════════════════════════

cmd-unlink = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm unlink <pkg>')
        return
    }
    pkg-name = os.arg(2)
    dir = os.get-wd()
    #{overflow=wrap}
    nm-dir = dir - '/node_modules'

    #{overflow=wrap}
    link-path = nm-dir - '/' - pkg-name
    fs.is-file(link-path) -> fs.remove(link-path)
    #{overflow=wrap}
    fs.is-dir(link-path) -> process.process-system('rm -rf ' - link-path)
    #{overflow=wrap}
    print('noNpm: unlinked ' - pkg-name)
}

; ═══════════════════════════════════════════════
; command: publish
; ═══════════════════════════════════════════════

cmd-publish = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)

    ; get token from env or .npmrc
    token = os.get-env('NPM_TOKEN')
    token.len() == 0 -> {
        token = os.get-env('NONPM_TOKEN')
    }
    token.len() == 0 -> {
        print('error: no auth token found')
        print('Set NPM_TOKEN environment variable or run "nonpm login"')
        os.exit(1)
    }
    ok = publish.publish(cfg, dir, token)
    ! ok -> os.exit(1)
}

; ═══════════════════════════════════════════════
; command: login
; ═══════════════════════════════════════════════

cmd-login = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)
    #{overflow=wrap}
    print('noNpm: login to ' - cfg.registry)
    print('Username: ', '')

    ; fs.get-line returns ?str; destructure into (payload, ok) so `username`
    ; is a plain str — a bare ?str argument is rejected by the checker
    ; (fxxoptarg) because implicit unwrap of option arguments is not allowed.
    username = ''
    uok = false
    username, uok = fs.get-line()
    ! uok -> {
        print('error: failed to read username')
        os.exit(1)
    }
    print('Password: ', '')
    password = ''
    pok = false
    password, pok = fs.get-line()
    ! pok -> {
        print('error: failed to read password')
        os.exit(1)
    }
    token = registry.login(cfg, username, password)
    token: {
        ok -> {
            print('Logged in as ' - username)
            #{overflow=wrap}
            print('Token: ' - it)
            print('Save this token as NPM_TOKEN environment variable')
        }

        nil -> {
            print('error: login failed')
            os.exit(1)
        }

        err -> {
            #{overflow=wrap}
            print('error: ' - it)
            os.exit(1)
        }
    }
}

; ═══════════════════════════════════════════════
; command: whoami
; ═══════════════════════════════════════════════

cmd-whoami = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)
    token = os.get-env('NPM_TOKEN')
    token.len() == 0 -> {
        token = os.get-env('NONPM_TOKEN')
    }
    token.len() == 0 -> {
        print('not logged in')
        os.exit(1)
    }
    username = registry.whoami(cfg, token)
    username: {
        ok -> {
            print(it)
        }

        nil -> {
            print('not logged in')
            os.exit(1)
        }

        err -> {
            #{overflow=wrap}
            print('error: ' - it)
            os.exit(1)
        }
    }
}

; ═══════════════════════════════════════════════
; command: pack
; ═══════════════════════════════════════════════

cmd-pack = (argc i64) {
    dir = os.get-wd()
    dest = dir
    {
        argc >= 2 -> {
            dest = os.arg(2)
            dest.starts-with('-') -> dest = dir
        }
    }
    tgz-path, ok = publish.pack(dir, dest)
    ok -> {
        #{overflow=wrap}
        print('noNpm: created ' - tgz-path)
    }

    -> {
        print('error: failed to create tarball')
        os.exit(1)
    }
}

; ═══════════════════════════════════════════════
; command: exec
; ═══════════════════════════════════════════════

cmd-exec = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm exec <cmd> [args...]')
        return
    }
    dir = os.get-wd()
    cmd-str = ''
    i <- [2..argc): {
        a = os.arg(i)
        #{overflow=wrap}
        cmd-str.len-bytes() > 0 -> cmd-str = cmd-str - ' ' - a
        cmd-str.len-bytes() == 0 -> cmd-str = a
    }
    #{overflow=wrap}
    nm-dir = dir - '/node_modules/.bin'
    path-env = os.get-env('PATH')

    #{overflow=wrap}
    full-path = nm-dir - ':' - path-env
    os.set-env('PATH', full-path)
    #{overflow=wrap}
    code = process.process-system('cd ' - dir - ' && ' - cmd-str)
    code != 0 -> os.exit(code)
}

; ═══════════════════════════════════════════════
; command: dlx
; ═══════════════════════════════════════════════

cmd-dlx = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm dlx <pkg> [args...]')
        return
    }
    dir = os.get-wd()
    cfg = config.load-project(dir)
    pkg-spec = os.arg(2)
    at-pos = pkg-spec.index('@')
    name = pkg-spec
    range-str = ''
    at-pos > 0 -> {
        name = pkg-spec.slice(0, at-pos)

        #{overflow=wrap}
        range-str = pkg-spec.slice(at-pos + 1, pkg-spec.len())
    }

    ; create temporary directory
    #{overflow=wrap}
    tmp-dir = '/tmp/nonpm-dlx-' - os.now-ms().to-str()
    #{overflow=wrap}
    process.process-system('mkdir -p ' - tmp-dir)

    ; install package to tmp dir
    ok = installer.install-pkg(cfg, name, range-str, tmp-dir)
    ! ok -> {
        #{overflow=wrap}
        process.process-system('rm -rf ' - tmp-dir)
        os.exit(1)
    }

    ; run the package's bin
    #{overflow=wrap}
    bin-dir = tmp-dir - '/node_modules/.bin'
    cmd-str = ''
    i <- [3..argc): {
        a = os.arg(i)
        #{overflow=wrap}
        cmd-str.len-bytes() > 0 -> cmd-str = cmd-str - ' ' - a
        cmd-str.len-bytes() == 0 -> cmd-str = a
    }
    #{overflow=wrap}
    full-cmd = 'cd ' - tmp-dir - ' && ' - bin-dir - '/' - name - ' ' - cmd-str
    code = process.process-system(full-cmd)
    #{overflow=wrap}
    process.process-system('rm -rf ' - tmp-dir)
    code != 0 -> os.exit(code)
}

; ═══════════════════════════════════════════════
; command: fetch
; ═══════════════════════════════════════════════

cmd-fetch = (argc i64) {
    dir = os.get-wd()
    cfg = config.load-project(dir)

    ; resolve and download without linking
    graph, resolve-ok = resolver.resolve-project(cfg, dir)
    ! resolve-ok -> {
        print('error: failed to resolve dependencies')
        os.exit(1)
    }
    store-dir = cfg.store-dir
    #{overflow=wrap}
    nm-dir = dir - '/node_modules'
    #{overflow=wrap}
    virtual-store = nm-dir - '/.nonpm'
    n = graph.node-count
    i <- [0..n): {
        node = graph.nodes[i]
        pkg-store-path = linker.package-dir(virtual-store, node.name, node.version)
        pkg-exists = fs.is-dir(pkg-store-path)
        ! pkg-exists -> {
            #{overflow=wrap}
            print('noNpm: fetching ' - node.name - '@' - node.version - '...')
            dl-ok = tarball.download-and-extract(node.resolved, pkg-store-path)
            ! dl-ok -> {
                #{overflow=wrap}
                print('error: failed to fetch ' - node.name)
            }
        }
    }
    print('noNpm: fetched all packages to virtual store')
}

; ═══════════════════════════════════════════════
; command: import
; ═══════════════════════════════════════════════

cmd-import = (argc i64) {
    dir = os.get-wd()
    print('noNpm: importing from existing node_modules...')

    ; TODO: generate lockfile from existing node_modules
    cfg = config.load-project(dir)
    graph, resolve-ok = resolver.resolve-project(cfg, dir)
    resolve-ok -> {
        lockfile.generate(cfg, dir, graph)
    }

    -> {
        print('error: could not resolve project')
        os.exit(1)
    }
}

; ═══════════════════════════════════════════════
; command: cache
; ═══════════════════════════════════════════════

cmd-cache = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm cache <subcommand>')
        print('  cache clean    Clean the cache')
        print('  cache dir      Show the cache directory')
        print('  cache prune    Prune stale cache entries')
        return
    }
    sub = os.arg(2)
    sub: {
        'clean' -> {
            home = os.get-env('HOME')
            #{overflow=wrap}
            cache-dir = home - '/.nonpm/cache'
            #{overflow=wrap}
            process.process-system('rm -rf ' - cache-dir - '/*')
            print('noNpm: cache cleaned')
        }

        'dir' -> {
            home = os.get-env('HOME')
            #{overflow=wrap}
            print(home - '/.nonpm/cache')
        }

        'prune' -> {
            print('noNpm: pruning cache...')

            ; TODO: scan cache and remove old entries
            print('noNpm: cache pruned')
        }

        -> {
            print('unknown cache subcommand: {sub}')
        }
    }
}

; ═══════════════════════════════════════════════
; command: self
; ═══════════════════════════════════════════════

cmd-self = (argc i64) {
    argc < 2 -> {
        print('usage: nonpm self <subcommand>')
        print('  self version   Show version')
        print('  self update    Update noNpm')
        return
    }
    sub = os.arg(2)
    sub: {
        'version' -> print-version()

        'update' -> {
            print('noNpm: updating...')
            code = process.process-system('no install nonpm -u')
            code == 0 -> {
                print('noNpm: updated successfully')
            }

            -> {
                print('noNpm: update failed')
                os.exit(1)
            }
        }

        -> {
            print('unknown self subcommand: {sub}')
        }
    }
}
