# /nonpm/src/utils

main = () {
    content = '{"name":"test","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的引用
            ; 获取子对象
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj
                    it.delete-key('foo')
                    ; 不 stringify dep-obj，直接返回
                }
                nil -> {}
                err -> {}
            }
            ; it 现在是 dep-obj（被 match 重新绑定）
            ; 但如果 get 返回的 dep-obj 和原 it 共享 pool
            ; 那 v 的 pool 中 dependencies 的 foo 应该已被删除
            ; 可惜 it 已经不是 root 了
        }
        nil -> print('nil')
        err -> print('err')
    }
    ; v 在 match 后可能被 move 了
    ; 但试试看
    out = v.stringify()
    print('v: ' - out)
}
main()
