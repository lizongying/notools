# /nonpm/src/semver

; Simplified: just loop + conditional struct assign, no compare
test-fn = (versions []str) (best str) {
    best = ''
    best-v semver
    best-set = false
    n = versions.len()
    i <- [0..n): {
        v semver
        parse-ok bool = false
        semver.parse(versions[i]): {
            ok -> {
                v = it
                parse-ok = true
            }

            -> _
        }
        parse-ok -> {
            {
                ! best-set -> {
                    best = versions[i]
                    best-v = v
                    best-set = true
                }

                -> {
                    best = versions[i]
                    best-v = v
                }
            }
        }
    }
}

versions = ['1.0.0-a', '1.0.0-b']
best = test-fn(versions)
print('best=' - best)
