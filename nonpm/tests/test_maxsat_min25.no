# /nonpm/src/semver

; Just compare, no reassign
test-fn = (versions []str) (best str) {
    best = ''
    best-v semver
    best-set = false
    n = versions.len
    i <- [0..n): {
        v, parse-ok = semver.parse(versions[i])
        parse-ok == true -> {
            best-set == false -> {
                best = versions[i]
                best-v = v
                best-set = true
            }
            -> {
                c = semver.compare(v, best-v)
                ; no reassign of best-v
            }
        }
    }
}

main = () {
    versions []str = ['1.0.0-a', '1.0.0-b']
    best = test-fn(versions)
    print('best=' - best)
}
