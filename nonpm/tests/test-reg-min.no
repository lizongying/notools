# /nonpm/src/registry
# /nonpm/src/pj

main = () {
    print('start')
    meta-json = '{"name":"foo"}'
    print('before parse')
    meta = json.parse(meta-json, meta-json.len-bytes())
    print('after parse')
    meta: {
        ok -> {
            print('parse ok')
        }
        nil -> {
            print('parse nil')
        }
        err -> {
            print('parse err')
        }
    }
    print('done')
}
