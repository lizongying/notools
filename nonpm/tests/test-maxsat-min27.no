# /nonpm/src/semver

; Minimal: just parse two versions and compare
v1 semver
ok1 = false
semver.parse('1.0.0-a'): {
    ok -> {
        v1 = it
        ok1 = true
    }

    -> _
}
v2 semver
ok2 = false
semver.parse('1.0.0-b'): {
    ok -> {
        v2 = it
        ok2 = true
    }

    -> _
}
c = semver.compare(v1, v2)
print('c=' - c.to-str())
