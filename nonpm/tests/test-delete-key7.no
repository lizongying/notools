# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的副本
            ; 获取 dependencies
            dep-obj ?json = it.get('dependencies')
            ; 不用 match，直接在 dep-obj 上操作
            ; 如果 dep-obj 是 ok 的，pool 应该包含正确数据
            ; 用 dep-obj 作为 self 调用 delete-key
            ; 但 dep-obj 是 ?json 类型...
            ; 试试用 match 但在 match 内同时做 delete 和 set-key
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj
                    it.delete-key('foo')
                    ; 把修改后的 dep-obj 设回外层的 v
                    ; 但外层的 v 变量可能不可用（it 已变）
                    ; 用 json.set-key(v, 'dependencies', it)
                    ; v 在外层定义，应该可以引用
                    ; 但 v 的 pool 是原始的，it 的 pool 是副本
                    ; set-key 只更新索引，不复制 pool 数据
                    ; 所以不会生效
                }
                nil -> {}
                err -> {}
            }
            ; 试试直接在 it 上操作
            ; it 现在是 dep-obj 的值（被 match 重新绑定）
            ; 不是 v 了
            ; 需要在 dep-obj match 之前保存 v 的引用
            ; 但 json 是值类型...
            out = it.stringify()
            print('result: ' - out)
        }
    }
}
main()
