# /nonpm/src/pj

main = () {
    print('--- Testing json module ---')
    n-pass = 0
    n-fail = 0

    ; ── parse basic JSON ──
    v1 = pj.parse('{"name":"foo","version":"1.0.0"}')
    {
        v1: {
            ok -> {
                name = pj.get-str(it, 'name')
                {
                    name == 'foo' -> {
                        print('PASS: parse and get-str')

                        #{overflow=wrap}
                        n-pass = n-pass + 1
                    }

                    -> {
                        #{overflow=wrap}
                        print('FAIL: parse and get-str, got ' - name)
                        #{overflow=wrap}
                        n-fail = n-fail + 1
                    }
                }
            }

            nil -> {
                print('FAIL: parse should not return nil')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            err -> {
                print('FAIL: parse should not return error')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }
    }

    ; ── parse invalid JSON ──
    v2 = pj.parse('not json')
    {
        v2: {
            ok -> {
                print('FAIL: invalid JSON should not parse')

                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            nil -> {
                print('PASS: invalid JSON returns nil')
                #{overflow=wrap}
                n-pass = n-pass + 1
            }

            err -> {
                print('PASS: invalid JSON returns error')
                #{overflow=wrap}
                n-pass = n-pass + 1
            }
        }
    }

    ; ── get-num ──
    v3 = pj.parse('{"count":42}')
    {
        v3: {
            ok -> {
                n = pj.get-num(it, 'count')
                {
                    n == 42 -> {
                        print('PASS: get-num')

                        #{overflow=wrap}
                        n-pass = n-pass + 1
                    }

                    -> {
                        print('FAIL: get-num')
                        #{overflow=wrap}
                        n-fail = n-fail + 1
                    }
                }
            }

            nil -> {
                print('FAIL: get-num parse nil')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            err -> {
                print('FAIL: get-num parse error')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-bool ──
    v4 = pj.parse('{"flag":true}')
    {
        v4: {
            ok -> {
                b = pj.get-bool(it, 'flag')
                {
                    b -> {
                        print('PASS: get-bool true')

                        #{overflow=wrap}
                        n-pass = n-pass + 1
                    }

                    -> {
                        print('FAIL: get-bool should be true')
                        #{overflow=wrap}
                        n-fail = n-fail + 1
                    }
                }
            }

            nil -> {
                print('FAIL: get-bool parse nil')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            err -> {
                print('FAIL: get-bool parse error')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-bool false ──
    v5 = pj.parse('{"flag":false}')
    {
        v5: {
            ok -> {
                b = pj.get-bool(it, 'flag')
                {
                    ! b -> {
                        print('PASS: get-bool false')

                        #{overflow=wrap}
                        n-pass = n-pass + 1
                    }

                    -> {
                        print('FAIL: get-bool should be false')
                        #{overflow=wrap}
                        n-fail = n-fail + 1
                    }
                }
            }

            nil -> {
                print('FAIL: get-bool false parse nil')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            err -> {
                print('FAIL: get-bool false parse error')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-str not found ──
    v6 = pj.parse('{"a":"b"}')
    {
        v6: {
            ok -> {
                s = pj.get-str(it, 'nonexistent')
                {
                    s == '' -> {
                        print('PASS: get-str not found returns empty')

                        #{overflow=wrap}
                        n-pass = n-pass + 1
                    }

                    -> {
                        print('FAIL: get-str not found should return empty')
                        #{overflow=wrap}
                        n-fail = n-fail + 1
                    }
                }
            }

            nil -> {
                print('FAIL: get-str not found parse nil')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            err -> {
                print('FAIL: get-str not found parse error')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-obj ──
    v7 = pj.parse('{"deps":{"foo":"^1.0.0"}}')
    {
        v7: {
            ok -> {
                deps = it.get('deps')
                {
                    deps: {
                        ok -> {
                            foo-ver = pj.get-str(deps, 'foo')
                            {
                                foo-ver == '^1.0.0' -> {
                                    print('PASS: get-obj nested')

                                    #{overflow=wrap}
                                    n-pass = n-pass + 1
                                }

                                -> {
                                    print('FAIL: get-obj nested value')
                                    #{overflow=wrap}
                                    n-fail = n-fail + 1
                                }
                            }
                        }

                        nil -> {
                            print('FAIL: get-obj should not be nil')
                            #{overflow=wrap}
                            n-fail = n-fail + 1
                        }

                        err -> {
                            print('FAIL: get-obj should not be error')
                            #{overflow=wrap}
                            n-fail = n-fail + 1
                        }
                    }
                }
            }

            nil -> {
                print('FAIL: get-obj parse nil')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }

            err -> {
                print('FAIL: get-obj parse error')
                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }
    }

    print('done')
}
