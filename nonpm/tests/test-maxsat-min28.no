# /nonpm/src/semver

; compare inside a function
my-test-fn = () (c i64) {
    v1 semver
    ok1 = false
    semver.parse('1.0.0-a'): {
        ok -> {
            v1 = it
            ok1 = true
        }

        -> _
    }
    v2 semver
    ok2 = false
    semver.parse('1.0.0-b'): {
        ok -> {
            v2 = it
            ok2 = true
        }

        -> _
    }
    c = semver.compare(v1, v2)
}

c = my-test-fn()
print('c=' - c.to-str())
