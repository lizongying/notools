# /nonpm/src/semver

; compare inside a function
my-test-fn = () (c i64) {
    v1-opt = semver.parse('1.0.0-a')
    v1 semver
    ok1 = false
    v1-opt: {
        ok -> {
            v1 = v1-opt
            ok1 = true
        }

        nil || err -> {
        }
    }
    v2-opt = semver.parse('1.0.0-b')
    v2 semver
    ok2 = false
    v2-opt: {
        ok -> {
            v2 = v2-opt
            ok2 = true
        }

        nil || err -> {
        }
    }
    c = semver.compare(v1, v2)
}

main = () {
    c = my-test-fn()
    print('c=' - c.to-str())
}
