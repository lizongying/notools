semver.parse('1.0.0'): {
    ok -> {
        b38 = it
        ok38b = true
    }

    -> _
}
{
    semver.gt(a38, b38) -> {
        print('PASS: gt(2.0.0, 1.0.0)')

        #{overflow=wrap}
        n-pass = n-pass + 1
    }

    -> {
        print('FAIL: gt(2.0.0, 1.0.0)')

        #{overflow=wrap}
        n-fail = n-fail + 1
    }
}

