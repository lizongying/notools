    best32 = semver.max-satisfying(versions, '*')
    {
        best32 == '4.0.0' -> {
            print('PASS: max-satisfying * = 4.0.0 (v4.0.0 parsed)')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: max-satisfying * should be 4.0.0, got ' - best32)

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 33: max-satisfying with no match
    best33 = semver.max-satisfying(versions, '^9.0.0')
    {
        best33 == '' -> {
            print('PASS: max-satisfying ^9.0.0 = empty (no match)')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: max-satisfying ^9.0.0 should be empty, got ' - best33)

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 34: max-satisfying with exact version
    best34 = semver.max-satisfying(versions, '2.0.0')
    {
        best34 == '2.0.0' -> {
            print('PASS: max-satisfying 2.0.0 = 2.0.0')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: max-satisfying 2.0.0 should be 2.0.0, got ' - best34)

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; ── to-string ──

    ; Test 35: to-string roundtrip
    v35-opt = semver.parse('1.2.3')
    v35 semver
    ok35 = false
    v35-opt: {
        ok -> {
            v35 = v35-opt
            ok35 = true
        }

        nil || err -> {
        }
    }
    s35 = semver.to-string(v35)
    {
        s35 == '1.2.3' -> {
            print('PASS: to-string 1.2.3')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: to-string 1.2.3, got ' - s35)

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 36: to-string with pre-release
    v36-opt = semver.parse('1.0.0-beta.1')
    v36 semver
    ok36 = false
    v36-opt: {
        ok -> {
            v36 = v36-opt
            ok36 = true
        }

        nil || err -> {
        }
    }
    s36 = semver.to-string(v36)
    {
        s36 == '1.0.0-beta.1' -> {
            print('PASS: to-string with pre-release')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: to-string with pre-release, got ' - s36)

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 37: to-string with build metadata
    v37-opt = semver.parse('1.2.3+build.1')
    v37 semver
    ok37 = false
    v37-opt: {
        ok -> {
            v37 = v37-opt
            ok37 = true
        }

        nil || err -> {
        }
    }
    s37 = semver.to-string(v37)
    {
        s37 == '1.2.3+build.1' -> {
            print('PASS: to-string with build metadata')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: to-string with build metadata, got ' - s37)

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; ── gt / lt / eq ──

    ; Test 38: gt
    a38-opt = semver.parse('2.0.0')
    a38 semver
    ok38a = false
    a38-opt: {
        ok -> {
            a38 = a38-opt
            ok38a = true
        }

        nil || err -> {
        }
    }
    b38-opt = semver.parse('1.0.0')
    b38 semver
    ok38b = false
    b38-opt: {
        ok -> {
            b38 = b38-opt
            ok38b = true
        }

        nil || err -> {
        }
    }
    {
        semver.gt(a38, b38) -> {
            print('PASS: gt(2.0.0, 1.0.0)')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: gt(2.0.0, 1.0.0)')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 39: lt
    a39-opt = semver.parse('1.0.0')
    a39 semver
    ok39a = false
    a39-opt: {
        ok -> {
            a39 = a39-opt
            ok39a = true
        }

        nil || err -> {
        }
    }
    b39-opt = semver.parse('2.0.0')
    b39 semver
    ok39b = false
    b39-opt: {
        ok -> {
            b39 = b39-opt
            ok39b = true
        }

        nil || err -> {
        }
    }
    {
        semver.lt(a39, b39) -> {
            print('PASS: lt(1.0.0, 2.0.0)')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: lt(1.0.0, 2.0.0)')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 40: eq
    a40-opt = semver.parse('1.2.3')
    a40 semver
    ok40a = false
    a40-opt: {
        ok -> {
            a40 = a40-opt
            ok40a = true
        }

        nil || err -> {
        }
    }
    b40-opt = semver.parse('1.2.3')
    b40 semver
    ok40b = false
    b40-opt: {
        ok -> {
            b40 = b40-opt
            ok40b = true
        }

        nil || err -> {
        }
    }
    {
        semver.eq(a40, b40) -> {
            print('PASS: eq(1.2.3, 1.2.3)')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: eq(1.2.3, 1.2.3)')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 41: eq with build metadata (equal in semver)
    a41-opt = semver.parse('1.2.3+build.1')
    a41 semver
    ok41a = false
    a41-opt: {
        ok -> {
            a41 = a41-opt
            ok41a = true
        }

        nil || err -> {
        }
    }
    b41-opt = semver.parse('1.2.3+build.2')
    b41 semver
    ok41b = false
    b41-opt: {
        ok -> {
            b41 = b41-opt
            ok41b = true
        }

        nil || err -> {
        }
    }
    {
        semver.eq(a41, b41) -> {
            print('PASS: eq with different build metadata')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: 1.2.3+build.1 should eq 1.2.3+build.2')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; ── summary ──
    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}

main()
