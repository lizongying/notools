; test-semver.no — comprehensive tests for the semver module
;
; Mirrors pnpm's pickVersionByVersionRange.test.ts and parseBareSpecifier.test.ts
; Tests: parsing, comparison, range matching (^, ~, >=, <=, >, <, *, =),
;   prerelease, build metadata, max-satisfying, to-string, gt, lt, eq
; Run: no run nonpm/tests/test-semver.no

# /nonpm/src/semver

main = () {
    print('--- Testing semver module ---')
    n-pass = 0
    n-fail = 0

    ; ── parse tests ──

    ; Test 1: parse basic version
    v1-opt = semver.parse('1.2.3')
    v1 semver
    ok1 = false
    v1-opt: {
        ok -> {
            v1 = v1-opt
            ok1 = true
        }

        nil || err -> {
        }
    }
    {
        ok1 && v1.major == 1 && v1.minor == 2 && v1.patch == 3 -> {
            print('PASS: parse 1.2.3')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: parse 1.2.3')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

