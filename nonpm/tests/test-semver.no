; Test 41: eq with build metadata (equal in semver)
a41 semver
ok41a = false
semver.parse('1.2.3+build.1'): {
    ok -> {
        a41 = it
        ok41a = true
    }

    -> _
}
b41 semver
ok41b = false
semver.parse('1.2.3+build.2'): {
    ok -> {
        b41 = it
        ok41b = true
    }

    -> _
}
{
    semver.eq(a41, b41) -> {
        print('PASS: eq with different build metadata')

        #{overflow=wrap}
        n-pass = n-pass + 1
    }

    -> {
        print('FAIL: 1.2.3+build.1 should eq 1.2.3+build.2')

        #{overflow=wrap}
        n-fail = n-fail + 1
    }
}

; ── summary ──
print('')
print('Results: {n-pass} passed, {n-fail} failed')
{
    n-fail > 0 -> exit(1)
}
