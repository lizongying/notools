# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 就是 v 的引用
            ; 直接在 it 上获取 dependencies
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 现在是 dep-obj 的引用
                    ; delete-key 在 dep-obj 上操作
                    del-ok = it.delete-key('foo')
                    print('delete-key returned: {del-ok}')
                    ; it 现在是修改后的 dep-obj
                    ; 需要把它 set-key 回 v
                    ; 但 v 在外层，it 已经变了
                    ; 用 json.set-key(v, 'dependencies', it) 不行
                    ; 因为 v 的 pool 和 it 的 pool 是同一个（引用）
                    ; 所以 it 的修改应该已经反映在 v 上了
                }
                nil -> print('dep-obj nil')
                err -> print('dep-obj err')
            }
            ; it 现在是 dep-obj（被 match 重新绑定了）
            ; 但 v 仍然是外层变量
            ; 如果 it 是引用，v 的 pool 应该已被修改
            out = v.stringify()
            print('v result: ' - out)
        }
        nil -> print('parse nil')
        err -> print('parse err')
    }
}
main()
