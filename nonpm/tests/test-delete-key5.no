# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; 直接在 v 上调用 delete-key 不行（v 是顶层对象）
            ; 需要获取子对象然后操作
            ; 试试直接用 v（it）的 pool 操作
            ; it 就是 v 的值，修改 it 应该等于修改 v？
            ; 不，it 是 v 的副本
            ; 
            ; 但如果 Nolang 中 ?json match 不是复制而是引用...
            ; 让我试试直接修改 it
            it.set-str('name', 'modified')
            ; 用 it stringify
            out = it.stringify()
            print('it result: ' - out)
        }
        nil -> print('parse nil')
        err -> print('parse err')
    }
    
    ; 用 v stringify
    out2 = v.stringify()
    print('v result: ' - out2)
}
main()
