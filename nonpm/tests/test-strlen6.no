# /nonpm/src/pj

main = () {
    print('start')
    s8 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n","o":"p","q":"r"}'
    #{overflow=wrap}
    print('s8 len: ' - s8.len-bytes().to-str())
    v8 = pj.parse(s8)
    v8: {
        ok -> print('s8 ok')
        nil -> print('s8 nil')
        err -> print('s8 err')
    }
    s9 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n","o":"p","q":"r","s":"t"}'
    #{overflow=wrap}
    print('s9 len: ' - s9.len-bytes().to-str())
    v9 = pj.parse(s9)
    v9: {
        ok -> print('s9 ok')
        nil -> print('s9 nil')
        err -> print('s9 err')
    }
    s10 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n","o":"p","q":"r","s":"t","u":"v"}'
    #{overflow=wrap}
    print('s10 len: ' - s10.len-bytes().to-str())
    v10 = pj.parse(s10)
    v10: {
        ok -> print('s10 ok')
        nil -> print('s10 nil')
        err -> print('s10 err')
    }
    print('done')
}
