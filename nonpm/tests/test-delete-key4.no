# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的值
            ; 直接在 it 上操作
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj
                    ; delete-key 在 dep-obj 上操作
                    it.delete-key('foo')
                    ; 现在 set-key 在 v 上操作 (用外层的 v 变量)
                    ; 但 it 已经变成了 dep-obj 的值...
                    ; 需要引用外层的 v
                }
                nil -> {}
                err -> {}
            }
            ; 用 v（不是 it）来 set-key
            ; 但 dep-obj 在 match 分支里被修改了
            ; dep-obj 的 pool 是 it(v) pool 的副本
            ; v.set-key 用 v 的 pool
            ; dep-obj.root 指向 v pool 中的索引
            ; 但 dep-obj pool 中的修改不会反映到 v pool
            ; 试试直接用 v 操作
            out = v.stringify()
            print('result1: ' - out)
        }
        nil -> print('parse nil')
        err -> print('parse err')
    }
}
main()
