# /nonpm/src/utils

main = () {
    content = '{"name":"test","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的引用
            ; 获取子对象
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj
                    it.delete-key('foo')
                    ; 不用 it 了，用 dep-obj 变量
                    ; dep-obj 和 it 是同一个吗？
                }
                nil -> {}
                err -> {}
            }
            ; it 是 dep-obj 了
            ; 但 dep-obj 变量呢？
            ; dep-obj 是 ?json，在 match 分支中被 move 了
            ; 
            ; 关键测试：如果 get 返回的 dep-obj 和 it(root) 共享 pool
            ; 那 delete-key 修改了 pool 中 dependencies 节点
            ; it(root) 的 pool 也被修改了
            ; 但 it 现在是 dep-obj...
            ;
            ; 试试：在 dep-obj match 前保存 it 的 root 索引
            ; 然后用 root 索引在 pool 中查找
            ; 但 pool 是 json 的字段...
        }
        nil -> print('nil')
        err -> print('err')
    }
}
main()
