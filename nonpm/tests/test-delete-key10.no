# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的引用
            ; 直接在 it 上修改 name
            it.set-str('name', 'modified')
            ; 用 it stringify
            out1 = it.stringify()
            #{overflow=wrap}
            print('it after set: ' - out1)
            
            ; 获取 dep-obj 并直接在 it 上操作
            ; 不用中间变量
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj
                    it.delete-key('foo')
                    #{overflow=wrap}
                    print('dep-obj after delete: ' - it.stringify())
                    ; it 是 dep-obj，set-key 回去
                    ; 但 it 已经不是 root 了
                }
                nil -> {}
                err -> {}
            }
        }
        nil -> print('parse nil')
        err -> print('parse err')
    }
}
main()
