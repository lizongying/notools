# /nonpm/src/semver

main = () {
    v1-opt = semver.parse('1.0.0-a')
    v1 semver
    ok1 bool = false
    v1-opt: {
        ok -> {
            v1 = v1-opt
            ok1 = true
        }
        nil || err -> { }
    }
    v2-opt = semver.parse('1.0.0-b')
    v2 semver
    ok2 bool = false
    v2-opt: {
        ok -> {
            v2 = v2-opt
            ok2 = true
        }
        nil || err -> { }
    }
    best-v semver = v1
    best-v = v2
    print('done')
}
