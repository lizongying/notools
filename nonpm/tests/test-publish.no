; test-publish.no — tests for the publish module
;
; Mirrors pnpm's pack and publish tests
; Tests: pack (creates tarball from package dir), get-publish-files
; Run: no run nonpm/tests/test-publish.no

# /nonpm/src/publish
# /nonpm/src/utils

main = () {
    print('--- Testing publish module ---')
    n-pass = 0
    n-fail = 0

    ; ── pack: create tarball from package dir ──
    pkg-dir = '/tmp/nonpm-test-pub-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - pkg-dir)
    utils.write-file(pkg-dir - '/package.json', '{"name":"test-pkg","version":"1.0.0"}')
    utils.write-file(pkg-dir - '/index.js', 'module.exports = {};')
    utils.write-file(pkg-dir - '/README.md', '# Test Package')

    dest-dir = '/tmp/nonpm-test-pub-dest-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - dest-dir)

    tgz-path, pack-ok = publish.pack(pkg-dir, dest-dir)
    {
        pack-ok && tgz-path.len > 0 -> {
            print('PASS: pack creates tarball')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: pack should create tarball')
            n-fail = n-fail + 1
        }
    }

    ; ── pack: tarball path should contain name and version ──
    {
        tgz-path.contains('test-pkg') && tgz-path.contains('1.0.0') -> {
            print('PASS: pack tarball path contains name and version')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: pack tarball path should contain name and version, got ' - tgz-path)
            n-fail = n-fail + 1
        }
    }

    ; ── pack: tarball file should exist ──
    {
        utils.file-exists(tgz-path) -> {
            print('PASS: pack tarball file exists')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: pack tarball file should exist')
            n-fail = n-fail + 1
        }
    }

    ; ── pack: no package.json ──
    empty-dir = '/tmp/nonpm-test-pub-empty-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - empty-dir)
    tgz2, pack-ok2 = publish.pack(empty-dir, dest-dir)
    {
        pack-ok2 == false -> {
            print('PASS: pack no package.json returns false')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: pack should return false for no package.json')
            n-fail = n-fail + 1
        }
    }

    ; ── pack: scoped package ──
    scoped-dir = '/tmp/nonpm-test-pub-scoped-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - scoped-dir)
    utils.write-file(scoped-dir - '/package.json', '{"name":"@scope/my-pkg","version":"2.1.0"}')
    utils.write-file(scoped-dir - '/index.js', 'module.exports = {};')
    tgz-path2, pack-ok3 = publish.pack(scoped-dir, dest-dir)
    {
        pack-ok3 && tgz-path2.contains('scope-my-pkg') && tgz-path2.contains('2.1.0') -> {
            print('PASS: pack scoped package')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: pack scoped package')
            n-fail = n-fail + 1
        }
    }

    ; ── get-publish-files: with files field ──
    files-dir = '/tmp/nonpm-test-pub-files-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - files-dir)
    utils.write-file(files-dir - '/package.json', '{"name":"files-pkg","version":"1.0.0","files":["src","dist","README.md"]}')
    files-result = publish.get-publish-files(files-dir)
    {
        files-result.contains('src') && files-result.contains('dist') && files-result.contains('README.md') -> {
            print('PASS: get-publish-files with files field')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-publish-files with files field')
            n-fail = n-fail + 1
        }
    }

    ; ── get-publish-files: no files field ──
    no-files-dir = '/tmp/nonpm-test-pub-nofiles-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - no-files-dir)
    utils.write-file(no-files-dir - '/package.json', '{"name":"no-files","version":"1.0.0"}')
    files-result2 = publish.get-publish-files(no-files-dir)
    {
        files-result2 == '' -> {
            print('PASS: get-publish-files no files field returns empty')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-publish-files no files should return empty')
            n-fail = n-fail + 1
        }
    }

    ; ── get-publish-files: no package.json ──
    files-result3 = publish.get-publish-files('/tmp/nonpm-nonexistent-' - os.now-ms().to-str())
    {
        files-result3 == '' -> {
            print('PASS: get-publish-files no package.json returns empty')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-publish-files no package.json should return empty')
            n-fail = n-fail + 1
        }
    }

    ; cleanup
    process.process-system('rm -rf ' - pkg-dir - ' ' - dest-dir - ' ' - empty-dir - ' ' - scoped-dir - ' ' - files-dir - ' ' - no-files-dir)

    ; ── summary ──
    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}

main()
