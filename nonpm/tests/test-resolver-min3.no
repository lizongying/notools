# /nonpm/src/resolver
# /nonpm/src/utils
# /nonpm/src/pj

main = () {
    print('--- Testing resolver module ---')
    test-dir = '/tmp/nonpm-test-resolver-min3'
    process.process-system('mkdir -p ' - test-dir)
    pkg-content = '{"name":"test","version":"1.0.0","dependencies":{"express":"^4.17.1","lodash":"^4.0.0"},"devDependencies":{"jest":"^29.0.0"}}'
    utils.write-file(test-dir - '/package.json', pkg-content)
    print('file written')
    
    ; Try parsing directly
    content = fs.read-str(test-dir - '/package.json')
    {
        content: {
            ok -> {
                #{overflow=wrap}
                print('read ok, len: ' - it.len().to-str())
                v = json.parse(it)
                print('parsed')
                {
                    v: {
                        ok -> {
                            print('parse ok')
                            root json = it
                            dep-obj = root.get('dependencies')
                            {
                                dep-obj: {
                                    ok -> {
                                        print('got deps')
                                        deps = dep-obj.stringify()
                                        #{overflow=wrap}
                                        print('stringified: ' - deps)
                                    }
                                    nil -> print('deps nil')
                                    err -> print('deps err')
                                }
                            }
                        }
                        nil -> print('parse nil')
                        err -> print('parse err')
                    }
                }
            }
            nil -> print('read nil')
            err -> print('read err')
        }
    }
    print('done')
}
