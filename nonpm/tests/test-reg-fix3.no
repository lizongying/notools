# /nonpm/src/pj

main = () {
    print('start')
    ; Test with a medium-length string
    s1 = '{"name":"foo","dist-tags":{"latest":"1.0.0"},"versions":{"1.0.0":{"name":"foo","version":"1.0.0","dependencies":{"bar":"^1.0.0"},"bin":{"foo":"./bin/foo.js"},"dist":{"tarball":"https://registry.npmjs.org/foo/-/foo-1.0.0.tgz","integrity":"sha512-ABCDEF"}},"1.1.0":{"name":"foo","version":"1.1.0","dist":{"tarball":"https://registry.npmjs.org/foo/-/foo-1.1.0.tgz","integrity":"sha512-GHIJKL"}}}}'
    print('len: ' - s1.len.to-str())
    ; Try building the string by concatenation
    part1 = '{"name":"foo","dist-tags":{"latest":"1.0.0"},"versions":{"1.0.0":{"name":"foo","version":"1.0.0","dependencies":{"bar":"^1.0.0"},"bin":{"foo":"./bin/foo.js"},"dist":{"tarball":"https://registry.npmjs.org/foo/-/foo-1.0.0.tgz","integrity":"sha512-ABCDEF"}}'
    part2 = ',"1.1.0":{"name":"foo","version":"1.1.0","dist":{"tarball":"https://registry.npmjs.org/foo/-/foo-1.1.0.tgz","integrity":"sha512-GHIJKL"}}}}'
    combined = part1 - part2
    print('combined len: ' - combined.len.to-str())
    v2 = pj.parse(combined)
    {
        v2: {
            ok -> print('combined parse ok')
            nil -> print('combined parse nil')
            err -> print('combined parse err')
        }
    }
    ; Write to file and read back
    utils.write-file('/tmp/test-reg-json.txt', s1)
    result = fs.read-str('/tmp/test-reg-json.txt')
    {
        result: {
            ok -> {
                file-content = it
                print('file len: ' - file-content.len.to-str())
                v3 = pj.parse(file-content)
                {
                    v3: {
                        ok -> print('file parse ok')
                        nil -> print('file parse nil')
                        err -> print('file parse err')
                    }
                }
            }
            nil -> print('file read nil')
            err -> print('file read err')
        }
    }
    print('done')
}
