# /nonpm/src/pj
# /nonpm/src/utils

; 用独立函数提取数组元素字符串值，避免 it 作用域冲突
get-arr-str = (arr json, idx i64) (s str) {
    s = ''
    entry = arr.arr-get(idx)
    entry: {
        ok -> {
            s, ok = it.str()
        }
        nil -> {}
        err -> {}
    }
}

main = () {
    #{overflow=wrap}
    files-dir = '/tmp/nonpm-debug7-' - os.now-ms().to-str()
    #{overflow=wrap}
    process.process-system('mkdir -p ' - files-dir)
    #{overflow=wrap}
    utils.write-file(files-dir - '/package.json', '{"name":"files-pkg","version":"1.0.0","files":["src","dist","README.md"]}')
    
    #{overflow=wrap}
    pkg-path = files-dir - '/package.json'
    result = fs.read-str(pkg-path)
    result: {
        ok -> content = it
        nil -> content = ''
        err -> content = ''
    }
    
    v = json.parse(content)
    v: {
        ok -> {
            files-arr = it.get('files')
            files-arr: {
                ok -> {
                    n = it.arr-len()
                    print('array len: {n}')
                    i = 0
                    {
                        i >= n -> break
                        pat = get-arr-str(it, i)
                        print('entry[{i}]: pat={pat}')
                        #{overflow=wrap}
                        i = i + 1
                    } (i < n)
                }
                nil -> print('files-arr: nil')
                err -> print('files-arr: err')
            }
        }
        nil -> print('parse: nil')
        err -> print('parse: err')
    }
    
    #{overflow=wrap}
    process.process-system('rm -rf ' - files-dir)
}
main()
