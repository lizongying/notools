# /nonpm/src/workspace

main = () {
    print('start')
    test-dir = '/tmp/nonpm-test-ws-' - os.now-ms().to-str()
    print('test-dir: ' - test-dir)
    process.process-system('mkdir -p ' - test-dir)
    print('mkdir done')
    pkg-content = '{"name":"test-pkg","version":"1.2.3"}'
    utils.write-file(test-dir - '/package.json', pkg-content)
    print('write done')
    name, ver, info-ok = workspace.get-package-info(test-dir)
    print('get-package-info done')
    print('name: ' - name)
    print('ver: ' - ver)
    {
        info-ok && name == 'test-pkg' && ver == '1.2.3' -> {
            print('PASS: get-package-info from package.json')
        }
        -> {
            print('FAIL: get-package-info')
        }
    }
    print('done')
}
