# /nonpm/src/semver

max-satisfying-dbg = (versions []str, range-str str) (best str) {
    best = ''
    best-v semver
    best-set = false
    n = versions.len
    i <- [0..n): {
        v, parse-ok = parse(versions[i])
        parse-ok == true -> {
            ok = satisfies(v, range-str)
            ok == true -> {
                best-set == false -> {
                    best = versions[i]
                    best-v = v
                    best-set = true
                    print('dbg: first match i=' - i.to-str() - ' best-v.pre=' - best-v.pre-release)
                }
                -> {
                    c = compare(v, best-v)
                    print('dbg: compare i=' - i.to-str() - ' c=' - c.to-str())
                    c > 0 -> {
                        print('dbg: before clone best-v.pre=' - best-v.pre-release)
                        best = versions[i]
                        best-v = v
                        print('dbg: after clone best-v.pre=' - best-v.pre-release)
                    }
                }
            }
        }
    }
    print('dbg: end best-v.pre=' - best-v.pre-release)
}

main = () {
    versions []str = ['1.0.0-alpha.1', '1.0.0-beta.2']
    best2 = semver.max-satisfying-dbg(versions, '*')
    print('best2=' - best2)
}
