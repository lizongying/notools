# /nonpm/src/pj
# /nonpm/src/utils

main = () {
    #{overflow=wrap}
    files-dir = '/tmp/nonpm-debug6-' - os.now-ms().to-str()
    #{overflow=wrap}
    process.process-system('mkdir -p ' - files-dir)
    #{overflow=wrap}
    utils.write-file(files-dir - '/package.json', '{"name":"files-pkg","version":"1.0.0","files":["src","dist","README.md"]}')
    
    #{overflow=wrap}
    pkg-path = files-dir - '/package.json'
    result = fs.read-str(pkg-path)
    result: {
        ok -> content = it
        nil -> content = ''
        err -> content = ''
    }
    
    v = json.parse(content)
    v: {
        ok -> {
            files-arr = it.get('files')
            files-arr: {
                ok -> {
                    ; 直接用 it，不赋值给中间变量
                    n = it.arr-len()
                    print('array len: {n}')
                    ; 测试直接调用
                    e0 = it.arr-get(0)
                    e0: {
                        ok -> {
                            p0, ok0 = it.str()
                            print('e0: pat={p0} ok={ok0}')
                        }
                        nil -> print('e0: nil')
                        err -> print('e0: err')
                    }
                    ; 再次调用 it.arr-get
                    e1 = it.arr-get(1)
                    e1: {
                        ok -> {
                            p1, ok1 = it.str()
                            print('e1: pat={p1} ok={ok1}')
                        }
                        nil -> print('e1: nil')
                        err -> print('e1: err')
                    }
                }
                nil -> print('files-arr: nil')
                err -> print('files-arr: err')
            }
        }
        nil -> print('parse: nil')
        err -> print('parse: err')
    }
    
    #{overflow=wrap}
    process.process-system('rm -rf ' - files-dir)
}
main()
