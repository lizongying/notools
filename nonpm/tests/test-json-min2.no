; test-json-min2.no — minimal test for json.parse segfault
# /nonpm/src/pj

main = () {
    print('before json.parse')
    v1 = json.parse('{"name":"foo"}')
    print('after json.parse')
    {
        v1: {
            ok -> {
                print('got ok from parse')
                name = json.get-str(it, 'name')
                print('got name: ' - name)
            }
            nil -> {
                print('got nil')
            }
            err -> {
                print('got err')
            }
        }
    }
    print('done')
}

main()
