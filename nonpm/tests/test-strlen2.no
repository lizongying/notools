# /nonpm/src/pj

main = () {
    print('start')
    s1 = '{"a":"bcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz"}'
    #{overflow=wrap}
    print('s1 len: ' - s1.len-bytes().to-str())
    v1 = pj.parse(s1)
    {
        v1: {
            ok -> print('s1 ok')
            nil -> print('s1 nil')
            err -> print('s1 err')
        }
    }
    s2 = '{"a":"bcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz"}'
    #{overflow=wrap}
    print('s2 len: ' - s2.len-bytes().to-str())
    v2 = pj.parse(s2)
    {
        v2: {
            ok -> print('s2 ok')
            nil -> print('s2 nil')
            err -> print('s2 err')
        }
    }
    print('done')
}
