# /nonpm/src/pj

main = () {
    print('start')

    ; ── get-obj ──
    v7 = pj.parse('{"deps":{"foo":"^1.0.0"}}')
    {
        v7: {
            ok -> {
                deps = it.get('deps')
                {
                    deps: {
                        ok -> {
                            foo-ver = pj.get-str(deps, 'foo')
                            {
                                foo-ver == '^1.0.0' -> {
                                    print('PASS: get-obj nested')
                                }

                                -> {
                                    print('FAIL: get-obj nested value')
                                }
                            }
                        }

                        nil -> {
                            print('FAIL: get-obj should not be nil')
                        }

                        err -> {
                            print('FAIL: get-obj should not be error')
                        }
                    }
                }
            }

            nil -> {
                print('FAIL: get-obj parse nil')
            }

            err -> {
                print('FAIL: get-obj parse error')
            }
        }
    }
    print('done')
}
