# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的引用，pool 在 it 中
            ; 不用 root json = it（避免可能的拷贝）
            ; 直接用 it
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj 的引用
                    ; dep-obj 和 root 共享 pool（如果 get 不拷贝 pool）
                    it.delete-key('foo')
                    ; it 是 dep-obj，stringify 看 dep-obj
                    #{overflow=wrap}
                    print('dep-obj: ' - it.stringify())
                }
                nil -> {}
                err -> {}
            }
            ; it 现在是 dep-obj（被 match 重新绑定了）
            ; 但外层的 v 变量——如果 it 是引用，v 应该也被修改
            ; v 的 pool 中 dependencies 节点的 foo 应该被删了
            ; 但 v 在 match 后可能被 move 了
        }
        nil -> print('parse nil')
        err -> print('parse err')
    }
    ; 在 match 外面用 v
    ; v 可能被 move 了，但如果 it 是引用，v 的数据应该被修改
    out = v.stringify()
    #{overflow=wrap}
    print('v outside: ' - out)
}
main()
