; test-run.no — tests for the run module
;
; Mirrors pnpm's run-script and list-scripts tests
; Tests: get-script, list-scripts, run-script-with-args
; Run: no run nonpm/tests/test-run.no

# /nonpm/src/run
# /nonpm/src/utils

main = () {
    print('--- Testing run module ---')
    n-pass = 0
    n-fail = 0

    ; ── get-script basic ──
    test-dir = '/tmp/nonpm-test-run-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - test-dir)
    pkg-content = '{"name":"test","scripts":{"build":"tsc","test":"jest","dev":"vite"}}'
    utils.write-file(test-dir - '/package.json', pkg-content)

    cmd1 = run.get-script(test-dir, 'build')
    {
        cmd1 == 'tsc' -> {
            print('PASS: get-script build')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-script build, got ' - cmd1)
            n-fail = n-fail + 1
        }
    }

    ; ── get-script test ──
    cmd2 = run.get-script(test-dir, 'test')
    {
        cmd2 == 'jest' -> {
            print('PASS: get-script test')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-script test, got ' - cmd2)
            n-fail = n-fail + 1
        }
    }

    ; ── get-script dev ──
    cmd3 = run.get-script(test-dir, 'dev')
    {
        cmd3 == 'vite' -> {
            print('PASS: get-script dev')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-script dev, got ' - cmd3)
            n-fail = n-fail + 1
        }
    }

    ; ── get-script nonexistent ──
    cmd4 = run.get-script(test-dir, 'nonexistent')
    {
        cmd4 == '' -> {
            print('PASS: get-script nonexistent returns empty')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-script nonexistent should return empty')
            n-fail = n-fail + 1
        }
    }

    ; ── get-script no package.json ──
    test-dir2 = '/tmp/nonpm-test-run2-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - test-dir2)
    cmd5 = run.get-script(test-dir2, 'build')
    {
        cmd5 == '' -> {
            print('PASS: get-script no package.json returns empty')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-script no package.json should return empty')
            n-fail = n-fail + 1
        }
    }

    ; ── list-scripts basic ──
    scripts1 = run.list-scripts(test-dir)
    {
        scripts1.contains('build') && scripts1.contains('test') && scripts1.contains('dev') -> {
            print('PASS: list-scripts basic')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: list-scripts basic')
            n-fail = n-fail + 1
        }
    }

    ; ── list-scripts no scripts ──
    test-dir3 = '/tmp/nonpm-test-run3-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - test-dir3)
    utils.write-file(test-dir3 - '/package.json', '{"name":"no-scripts","version":"1.0.0"}')
    scripts2 = run.list-scripts(test-dir3)
    {
        scripts2.contains('No scripts') -> {
            print('PASS: list-scripts no scripts available')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: list-scripts should say no scripts available')
            n-fail = n-fail + 1
        }
    }

    ; ── list-scripts no package.json ──
    scripts3 = run.list-scripts(test-dir2)
    {
        scripts3.contains('No scripts') -> {
            print('PASS: list-scripts no package.json')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: list-scripts no package.json should say no scripts')
            n-fail = n-fail + 1
        }
    }

    ; ── run-script-with-args ──
    test-dir4 = '/tmp/nonpm-test-run4-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - test-dir4)
    utils.write-file(test-dir4 - '/package.json', '{"name":"run-test","scripts":{"echo":"echo hello"}}')
    args []str = ['world']
    ok1 = run.run-script-with-args(test-dir4, 'echo', args)
    {
        ok1 -> {
            print('PASS: run-script-with-args')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: run-script-with-args')
            n-fail = n-fail + 1
        }
    }

    ; ── run-script nonexistent script ──
    ok2 = run.run-script(test-dir4, 'nonexistent', '')
    {
        ok2 == false -> {
            print('PASS: run-script nonexistent returns false')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: run-script nonexistent should return false')
            n-fail = n-fail + 1
        }
    }

    ; cleanup
    process.process-system('rm -rf ' - test-dir - ' ' - test-dir2 - ' ' - test-dir3 - ' ' - test-dir4)

    ; ── summary ──
    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}

main()
