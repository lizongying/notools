# /nonpm/src/pj

main = () {
    print('start')
    s1 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n","o":"p","q":"r","s":"t","u":"v","w":"x","y":"z"}'
    #{overflow=wrap}
    print('s1 len: ' - s1.len-bytes().to-str())
    v1 = pj.parse(s1)
    {
        v1: {
            ok -> print('s1 ok')

            nil -> print('s1 nil')

            err -> print('s1 err')
        }
    }
    s2 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n","o":"p","q":"r","s":"t","u":"v"}'
    #{overflow=wrap}
    print('s2 len: ' - s2.len-bytes().to-str())
    v2 = pj.parse(s2)
    {
        v2: {
            ok -> print('s2 ok')

            nil -> print('s2 nil')

            err -> print('s2 err')
        }
    }
    s3 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n","o":"p","q":"r"}'
    #{overflow=wrap}
    print('s3 len: ' - s3.len-bytes().to-str())
    v3 = pj.parse(s3)
    {
        v3: {
            ok -> print('s3 ok')

            nil -> print('s3 nil')

            err -> print('s3 err')
        }
    }
    print('done')
}
