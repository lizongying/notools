# /nonpm/src/utils

remove-key-test = (v json, dep-key str, name str) {
    dep-obj = json.get(v, dep-key)
    dep-obj: {
        ok -> {
            json.delete-key(it, name)
            json.set-key(v, dep-key, it)
        }
        nil -> {}
        err -> {}
    }
}

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            root json = it
            remove-key-test(root, 'dependencies', 'foo')
            out = root.stringify()
            #{overflow=wrap}
            print('result: ' - out)
        }
        nil -> print('parse nil')
        err -> print('parse err')
    }
}
main()
