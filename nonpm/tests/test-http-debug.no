main = () {
    print('testing http.get to invalid port...')
    resp = http.get('http://localhost:99999/nonexistent-pkg')
    print('got response')
    resp: {
        ok -> {
            print('ok: status=' - it.status-code.to-str())
        }
        nil -> {
            print('nil: connection failed')
        }
        err -> {
            print('err: ' - it)
        }
    }
    print('done')
}
main()
