# /nonpm/src/pj
# /nonpm/src/utils

main = () {
    #{overflow=wrap}
    files-dir = '/tmp/nonpm-debug4-' - os.now-ms().to-str()
    #{overflow=wrap}
    process.process-system('mkdir -p ' - files-dir)
    #{overflow=wrap}
    utils.write-file(files-dir - '/package.json', '{"name":"files-pkg","version":"1.0.0","files":["src","dist","README.md"]}')

    #{overflow=wrap}
    pkg-path = files-dir - '/package.json'
    result = fs.read-str(pkg-path)
    result: {
        ok -> content = it

        nil -> content = ''

        err -> content = ''
    }

    v = json.parse(content)
    v: {
        ok -> {
            files-arr = it.get('files')
            files-arr: {
                ok -> {
                    n = it.arr-len()
                    print('array len: {n}')
                    i = 0
                    (i < n) {
                        i >= n -> break

                        ; 不用 match, 直接赋值
                        entry ?json = it.arr-get(i)

                        ; 用 is-ok 判断
                        entry-ok bool = entry.is-ok()
                        {
                            entry-ok -> {
                                pat, str-ok = entry.str()
                                print('entry[{i}]: pat={pat} ok={str-ok}')
                            }

                            -> {
                                print('entry[{i}]: nil/err')
                            }
                        }

                        #{overflow=wrap}
                        i = i + 1
                    }
                }

                nil -> print('files-arr: nil')

                err -> print('files-arr: err')
            }
        }

        nil -> print('parse: nil')

        err -> print('parse: err')
    }

    #{overflow=wrap}
    process.process-system('rm -rf ' - files-dir)
}
main()
