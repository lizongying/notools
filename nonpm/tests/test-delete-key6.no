# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的副本，但包含完整的 pool
            ; 所有操作都在 it 上进行
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj 的副本
                    it.delete-key('foo')
                    ; 但 dep-obj 的 pool 是 it(v副本) pool 的副本
                    ; dep-obj 的修改不会反映到 it(v副本) 的 pool
                    ; 需要 set-key 回去
                    ; 但 set-key 也要在正确的对象上
                }
                nil -> {}
                err -> {}
            }
            ; 问题：dep-obj: match 后 it 变了
            ; 需要在 dep-obj match 前保存 it
            out = it.stringify()
            print('after delete: ' - out)
        }
        nil -> print('parse nil')
        err -> print('parse err')
    }
}
main()
