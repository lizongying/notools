# /nonpm/src/utils

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {

            ; it 是 v 的引用
            root json = it

            ; 用 root 操作，避免 it 被重新绑定
            dep-obj = root.get('dependencies')
            dep-obj: {
                ok -> {

                    ; it 是 dep-obj
                    it.delete-key('foo')

                    ; 把修改后的 dep-obj 设回 root
                    root.set-key('dependencies', it)
                }

                nil -> {
                }

                err -> {
                }
            }

            ; 用 root stringify（root 没被 match 重新绑定）
            out = root.stringify()
            #{overflow=wrap}
            print('result: ' - out)
        }

        nil -> print('parse nil')

        err -> print('parse err')
    }
}
main()
