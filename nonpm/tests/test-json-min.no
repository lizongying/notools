# /nonpm/src/pj

main = () {
    print('start')
    v1 = json.parse('{"name":"foo","version":"1.0.0"}')
    print('parsed')
    v1: {
        ok -> {
            print('got ok')
            name = json.get-str(it, 'name')
            print('got name: ' - name)
        }
        nil -> {
            print('got nil')
        }
        err -> {
            print('got err')
        }
    }
    print('done')
}
