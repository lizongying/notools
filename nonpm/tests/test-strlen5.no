# /nonpm/src/pj

main = () {
    print('start')
    s4 = '{"a":"b","c":"d","e":"f","g":"h","i":"j"}'
    #{overflow=wrap}
    print('s4 len: ' - s4.len-bytes().to-str())
    v4 = pj.parse(s4)
    v4: {
        ok -> print('s4 ok')

        nil -> print('s4 nil')

        err -> print('s4 err')
    }
    s5 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l"}'
    #{overflow=wrap}
    print('s5 len: ' - s5.len-bytes().to-str())
    v5 = pj.parse(s5)
    v5: {
        ok -> print('s5 ok')

        nil -> print('s5 nil')

        err -> print('s5 err')
    }
    s6 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n"}'
    #{overflow=wrap}
    print('s6 len: ' - s6.len-bytes().to-str())
    v6 = pj.parse(s6)
    v6: {
        ok -> print('s6 ok')

        nil -> print('s6 nil')

        err -> print('s6 err')
    }
    s7 = '{"a":"b","c":"d","e":"f","g":"h","i":"j","k":"l","m":"n","o":"p"}'
    #{overflow=wrap}
    print('s7 len: ' - s7.len-bytes().to-str())
    v7 = pj.parse(s7)
    v7: {
        ok -> print('s7 ok')

        nil -> print('s7 nil')

        err -> print('s7 err')
    }
    print('done')
}
