# /nonpm/src/pj

main = () {
    print('start')

    ; ── parse basic JSON ──
    v1 = pj.parse('{"name":"foo","version":"1.0.0"}')
    {
        v1: {
            ok -> {
                name = pj.get-str(it, 'name')
                {
                    name == 'foo' -> {
                        print('PASS: parse and get-str')
                    }

                    -> {
                        print('FAIL: parse and get-str')
                    }
                }
            }

            nil -> {
                print('FAIL: nil')
            }

            err -> {
                print('FAIL: err')
            }
        }
    }

    ; ── parse invalid JSON ──
    v2 = pj.parse('not json')
    {
        v2: {
            ok -> {
                print('FAIL: invalid JSON should not parse')
            }

            nil -> {
                print('PASS: invalid JSON returns nil')
            }

            err -> {
                print('PASS: invalid JSON returns error')
            }
        }
    }

    ; ── get-num ──
    v3 = pj.parse('{"count":42}')
    {
        v3: {
            ok -> {
                n = pj.get-num(it, 'count')
                {
                    n == 42 -> {
                        print('PASS: get-num')
                    }

                    -> {
                        print('FAIL: get-num')
                    }
                }
            }

            nil -> {
                print('FAIL: nil')
            }

            err -> {
                print('FAIL: err')
            }
        }
    }

    ; ── get-bool ──
    v4 = pj.parse('{"flag":true}')
    {
        v4: {
            ok -> {
                b = pj.get-bool(it, 'flag')
                {
                    b -> {
                        print('PASS: get-bool true')
                    }

                    -> {
                        print('FAIL: get-bool')
                    }
                }
            }

            nil -> {
                print('FAIL: nil')
            }

            err -> {
                print('FAIL: err')
            }
        }
    }

    ; ── get-bool false ──
    v5 = pj.parse('{"flag":false}')
    {
        v5: {
            ok -> {
                b = pj.get-bool(it, 'flag')
                {
                    ! b -> {
                        print('PASS: get-bool false')
                    }

                    -> {
                        print('FAIL: get-bool false')
                    }
                }
            }

            nil -> {
                print('FAIL: nil')
            }

            err -> {
                print('FAIL: err')
            }
        }
    }

    ; ── get-str not found ──
    v6 = pj.parse('{"a":"b"}')
    {
        v6: {
            ok -> {
                s = pj.get-str(it, 'nonexistent')
                {
                    s == '' -> {
                        print('PASS: get-str not found')
                    }

                    -> {
                        print('FAIL: get-str not found')
                    }
                }
            }

            nil -> {
                print('FAIL: nil')
            }

            err -> {
                print('FAIL: err')
            }
        }
    }

    ; ── get-obj ──
    v7 = pj.parse('{"deps":{"foo":"^1.0.0"}}')
    {
        v7: {
            ok -> {
                deps = it.get('deps')
                {
                    deps: {
                        ok -> {
                            print('PASS: get-obj nested')
                        }

                        nil -> {
                            print('FAIL: get-obj nil')
                        }

                        err -> {
                            print('FAIL: get-obj err')
                        }
                    }
                }
            }

            nil -> {
                print('FAIL: get-obj parse nil')
            }

            err -> {
                print('FAIL: get-obj parse err')
            }
        }
    }
    print('done')
}
