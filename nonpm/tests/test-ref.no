# /nonpm/src/utils

main = () {
    content = '{"name":"test","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            ; it 是 v 的引用
            ; 先 set-str 试试
            it.set-str('name', 'modified')
            print('after set-str: ' - it.stringify())
            
            ; 然后获取子对象
            dep-obj = it.get('dependencies')
            dep-obj: {
                ok -> {
                    ; it 是 dep-obj
                    it.delete-key('foo')
                    print('dep-obj after delete: ' - it.stringify())
                }
                nil -> {}
                err -> {}
            }
            ; it 现在是 dep-obj 了（被 match 重新绑定）
            ; 但 v 的 pool 中——set-str 修改了 name（如果 it 是引用）
            ; delete-key 修改了 dep-obj 的 pool（如果 get 不共享 pool）
        }
        nil -> print('nil')
        err -> print('err')
    }
}
main()
