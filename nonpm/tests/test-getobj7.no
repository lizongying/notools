# /nonpm/src/pj

main = () {
    print('start')
    v7 = pj.parse('{"deps":{"foo":"^1.0.0"}}')
    print('parsed')
    {
        v7: {
            ok -> {
                print('v7 ok')
                deps = it.get('deps')
                print('got deps')
                {
                    deps: {
                        ok -> {
                            print('deps ok')
                            foo-ver = pj.get-str(deps, 'foo')
                            #{overflow=wrap}
                            print('got foo-ver: ' - foo-ver)
                        }
                        nil -> { print('deps nil') }
                        err -> { print('deps err') }
                    }
                }
            }
            nil -> { print('v7 nil') }
            err -> { print('v7 err') }
        }
    }
    print('done')
}
