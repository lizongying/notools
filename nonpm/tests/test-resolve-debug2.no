# /nonpm/src/resolver
# /nonpm/src/config
# /nonpm/src/utils

main = () {
    print('--- Debug with resolver only ---')
    cfg config.config
    cfg = config.default-config()
    cfg.registry = 'http://localhost:99999/'

    print('calling resolve-pkg...')
    ver-opt = resolver.resolve-pkg(cfg, 'nonexistent-pkg', '1.0.0')
    ver str
    pkg-ok = false
    ver-opt: {
        ok -> {
            ver = ver-opt
            pkg-ok = true
        }

        nil || err -> {
        }
    }
    print('resolve-pkg returned: ver={ver} ok={pkg-ok}')
}
main()
