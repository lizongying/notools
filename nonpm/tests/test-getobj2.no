# /nonpm/src/pj

main = () {
    print('start')

    ; ── get-str not found ──
    v6 = pj.parse('{"a":"b"}')
    {
        v6: {
            ok -> {
                s = pj.get-str(it, 'nonexistent')
                {
                    s == '' -> {
                        print('PASS: get-str not found returns empty')
                    }

                    -> {
                        print('FAIL')
                    }
                }
            }

            nil -> {
                print('FAIL: nil')
            }

            err -> {
                print('FAIL: err')
            }
        }
    }

    ; ── get-obj ──
    v7 = pj.parse('{"deps":{"foo":"^1.0.0"}}')
    print('parsed v7')
    {
        v7: {
            ok -> {
                print('v7 ok')
                deps = it.get('deps')
                print('got deps')
                {
                    deps: {
                        ok -> {
                            print('deps ok')
                        }

                        nil -> {
                            print('deps nil')
                        }

                        err -> {
                            print('deps err')
                        }
                    }
                }
            }

            nil -> {
                print('v7 nil')
            }

            err -> {
                print('v7 err')
            }
        }
    }
    print('done')
}
