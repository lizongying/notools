# /nonpm/src/pj

main = () {
    print('start')
    s1 = '{"name":"foo"}'
    v1 = pj.parse(s1)
    {
        v1: {
            ok -> print('short parse ok')

            nil -> print('short parse nil')

            err -> print('short parse err')
        }
    }
    s2 = '{"name":"foo","dist-tags":{"latest":"1.0.0"},"versions":{"1.0.0":{"name":"foo","version":"1.0.0","dependencies":{"bar":"^1.0.0"},"bin":{"foo":"./bin/foo.js"},"dist":{"tarball":"https://registry.npmjs.org/foo/-/foo-1.0.0.tgz","integrity":"sha512-ABCDEF"}},"1.1.0":{"name":"foo","version":"1.1.0","dist":{"tarball":"https://registry.npmjs.org/foo/-/foo-1.1.0.tgz","integrity":"sha512-GHIJKL"}}}}'
    #{overflow=wrap}
    print('long json len: ' - s2.len-bytes().to-str())
    v2 = pj.parse(s2)
    {
        v2: {
            ok -> print('long parse ok')

            nil -> print('long parse nil')

            err -> print('long parse err')
        }
    }
    print('done')
}
