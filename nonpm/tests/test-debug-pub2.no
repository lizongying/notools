# /nonpm/src/pj
# /nonpm/src/utils

main = () {
    files-dir = '/tmp/nonpm-debug2-' - os.now-ms().to-str()
    process.process-system('mkdir -p ' - files-dir)
    utils.write-file(files-dir - '/package.json', '{"name":"files-pkg","version":"1.0.0","files":["src","dist","README.md"]}')
    
    pkg-path = files-dir - '/package.json'
    result = fs.read-str(pkg-path)
    result: {
        ok -> content = it
        nil -> content = ''
        err -> content = ''
    }
    print('content: ' - content)
    
    v = json.parse(content)
    v: {
        ok -> {
            files-arr = it.get('files')
            files-arr: {
                ok -> {
                    arr json = it
                    n = arr.arr-len()
                    print('array len: {n}')
                    i <- [0..n): {
                        entry = arr.arr-get(i)
                        entry: {
                            ok -> {
                                pat, str-ok = it.str()
                                print('entry[{i}]: pat={pat} ok={str-ok}')
                            }
                            nil -> print('entry[{i}]: nil')
                            err -> print('entry[{i}]: err')
                        }
                    }
                }
                nil -> print('files-arr: nil')
                err -> print('files-arr: err')
            }
        }
        nil -> print('parse: nil')
        err -> print('parse: err')
    }
    
    process.process-system('rm -rf ' - files-dir)
}
main()
