# /nonpm/src/semver

main = () {
    versions []str = ['1.0.0', '2.0.0', '3.0.0']
    best1 = semver.max-satisfying(versions, '^1.0.0')
    print('best1=' - best1)
    best2 = semver.max-satisfying(versions, '*')
    print('best2=' - best2)
    best3 = semver.max-satisfying(versions, '^9.0.0')
    print('best3=[' - best3 - ']')
    best4 = semver.max-satisfying(versions, '2.0.0')
    print('best4=' - best4)
}
