# /nonpm/src/resolver
# /nonpm/src/registry
# /nonpm/src/semver
# /nonpm/src/config
# /nonpm/src/utils

main = () {
    print('--- Debug resolve-pkg ---')
    cfg config.config
    cfg = config.default-config()
    cfg.registry = 'http://localhost:99999/'
    print('calling resolve-pkg...')
    ver, ok = resolver.resolve-pkg(cfg, 'nonexistent-pkg', '1.0.0')
    print('resolve-pkg returned: ver={ver} ok={ok}')
}
main()
