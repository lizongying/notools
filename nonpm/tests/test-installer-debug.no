# /nonpm/src/installer
# /nonpm/src/utils
# /nonpm/src/config

main = () {
    print('--- Debug installer ---')
    cfg config.config
    cfg = config.default-config()
    cfg.registry = 'http://localhost:99999/'
    print('calling install-pkg...')
    ok1 = installer.install-pkg(cfg, 'nonexistent-pkg', '1.0.0', '/tmp/nonpm-nonexistent-123')
    print('install-pkg returned: {ok1}')
}
main()
