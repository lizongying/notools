; test-lockfile.no — comprehensive tests for the lockfile module
;
; Mirrors pnpm's lockfile read/sortKeys/get-pkg-version tests
; Tests: get-pkg-version, get-pkg-resolved, get-pkg-integrity, read (file-based)
; Run: no run nonpm/tests/test-lockfile.no

# /nonpm/src/lockfile

main = () {
    print('--- Testing lockfile module ---')
    n-pass = 0
    n-fail = 0

    ; ── get-pkg-version basic ──
    lock1 = 'lockfileVersion: 6.0\n\ndependencies:\n  express:\n    version: 4.17.1\n    resolved: https://registry.npmjs.org/express/-/express-4.17.1.tgz\n    integrity: sha512-xxx\n'
    ver1 = lockfile.get-pkg-version(lock1, 'express')
    {
        ver1: {
            ok -> {
                it == '4.17.1' -> {
                    print('PASS: get-pkg-version basic')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: get-pkg-version basic, got ' - it)
                    n-fail = n-fail + 1
                }
            }
            nil -> {
                print('FAIL: get-pkg-version should not be nil')
                n-fail = n-fail + 1
            }
            err -> {
                print('FAIL: get-pkg-version should not be error')
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-pkg-version from v9 format (importers) ──
    ; Mirrors pnpm __fixtures__/general/pnpm-lock.yaml format
    lock2 = 'lockfileVersion: 9.0\n\nimporters:\n\n  .:\n    dependencies:\n      minimatch:\n        specifier: ^3.0.4\n        version: 3.0.4\n      rimraf:\n        specifier: 2.5.1\n        version: 2.5.1\n'
    ver2 = lockfile.get-pkg-version(lock2, 'minimatch')
    {
        ver2: {
            ok -> {
                it == '3.0.4' -> {
                    print('PASS: get-pkg-version v9 importers format')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: get-pkg-version v9 format, got ' - it)
                    n-fail = n-fail + 1
                }
            }
            nil -> {
                print('FAIL: get-pkg-version v9 should not be nil')
                n-fail = n-fail + 1
            }
            err -> {
                print('FAIL: get-pkg-version v9 should not be error')
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-pkg-version not found ──
    ver3 = lockfile.get-pkg-version(lock1, 'nonexistent')
    {
        ver3: {
            ok -> {
                print('FAIL: get-pkg-version should not find nonexistent')
                n-fail = n-fail + 1
            }
            nil -> {
                print('PASS: get-pkg-version not found returns nil')
                n-pass = n-pass + 1
            }
            err -> {
                print('PASS: get-pkg-version not found returns err')
                n-pass = n-pass + 1
            }
        }
    }

    ; ── get-pkg-resolved basic ──
    lock3 = 'dependencies:\n  express:\n    version: 4.17.1\n    resolved: https://registry.npmjs.org/express/-/express-4.17.1.tgz\n    integrity: sha512-xxx\n'
    url1 = lockfile.get-pkg-resolved(lock3, 'express')
    {
        url1: {
            ok -> {
                it == 'https://registry.npmjs.org/express/-/express-4.17.1.tgz' -> {
                    print('PASS: get-pkg-resolved basic')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: get-pkg-resolved basic, got ' - it)
                    n-fail = n-fail + 1
                }
            }
            nil -> {
                print('FAIL: get-pkg-resolved should not be nil')
                n-fail = n-fail + 1
            }
            err -> {
                print('FAIL: get-pkg-resolved should not be error')
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-pkg-resolved not found ──
    url2 = lockfile.get-pkg-resolved(lock3, 'nonexistent')
    {
        url2: {
            ok -> {
                print('FAIL: get-pkg-resolved should not find nonexistent')
                n-fail = n-fail + 1
            }
            nil -> {
                print('PASS: get-pkg-resolved not found returns nil')
                n-pass = n-pass + 1
            }
            err -> {
                print('PASS: get-pkg-resolved not found returns err')
                n-pass = n-pass + 1
            }
        }
    }

    ; ── get-pkg-integrity basic ──
    int1 = lockfile.get-pkg-integrity(lock3, 'express')
    {
        int1: {
            ok -> {
                it == 'sha512-xxx' -> {
                    print('PASS: get-pkg-integrity basic')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: get-pkg-integrity basic, got ' - it)
                    n-fail = n-fail + 1
                }
            }
            nil -> {
                print('FAIL: get-pkg-integrity should not be nil')
                n-fail = n-fail + 1
            }
            err -> {
                print('FAIL: get-pkg-integrity should not be error')
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-pkg-integrity v9 format (packages section) ──
    ; Mirrors pnpm __fixtures__/general/pnpm-lock.yaml packages section
    lock4 = 'packages:\n\n  balanced-match@1.0.0:\n    resolution: {integrity: sha512-9Y0g0Q8rmSt+H33DfKv7FOc3v+iRI+o1lbzt8jGcIosYW37IIW/2XVYq5NPdmaD5NQ59Nk26Kl/vZbwW9Fr8vg==}\n\n  is-positive@1.0.0:\n    resolution: {integrity: sha512-xxzPGZ4P2uN6rROUa5N9Z7zTX6ERuE0hs6GUOc/cKBLF2NqKc16UwqHMt3tFg4CO6EBTE5UecUasg+3jZx3Ckg==}\n    engines: {node: \'>=0.10.0\'}\n'
    int2 = lockfile.get-pkg-integrity(lock4, 'balanced-match@1.0.0')
    {
        int2: {
            ok -> {
                it == 'sha512-9Y0g0Q8rmSt+H33DfKv7FOc3v+iRI+o1lbzt8jGcIosYW37IIW/2XVYq5NPdmaD5NQ59Nk26Kl/vZbwW9Fr8vg==' -> {
                    print('PASS: get-pkg-integrity v9 packages format')
                    n-pass = n-pass + 1
                }
                -> {
                    print('FAIL: get-pkg-integrity v9 format, got ' - it)
                    n-fail = n-fail + 1
                }
            }
            nil -> {
                print('FAIL: get-pkg-integrity v9 should not be nil')
                n-fail = n-fail + 1
            }
            err -> {
                print('FAIL: get-pkg-integrity v9 should not be error')
                n-fail = n-fail + 1
            }
        }
    }

    ; ── get-pkg-integrity not found ──
    int3 = lockfile.get-pkg-integrity(lock3, 'nonexistent')
    {
        int3: {
            ok -> {
                print('FAIL: get-pkg-integrity should not find nonexistent')
                n-fail = n-fail + 1
            }
            nil -> {
                print('PASS: get-pkg-integrity not found returns nil')
                n-pass = n-pass + 1
            }
            err -> {
                print('PASS: get-pkg-integrity not found returns err')
                n-pass = n-pass + 1
            }
        }
    }

    ; NOTE: file I/O tests (read-lockfile from file) skipped
    ; due to Nolang LLVM str-long vs vec type mismatch.
    ; Tracked as Nolang issue.

    ; ── summary ──
    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}

main()
