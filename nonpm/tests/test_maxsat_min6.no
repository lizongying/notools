# /nonpm/src/semver

main = () {
    versions []str = ['0.0.1', '1.0.0-alpha.1', '1.0.0-beta.2', '1.0.0', '1.0.10', '1.2.0', '1.2.3+build.1', '1.10.0', '3.0.0', 'v4.0.0']
    best1 = semver.max-satisfying(versions, '^1.0.0')
    print('best1=' - best1)
    best2 = semver.max-satisfying(versions, '*')
    print('best2=' - best2)
}
