# /nonpm/src/semver

; No loop, just two parse + compare + return
my-test-fn = () (best str) {
    best = ''
    best-v semver

    v1 semver
    ok1 = false
    semver.parse('1.0.0-a'): {
        ok -> {
            v1 = it
            ok1 = true
        }

        -> _
    }
    best = '1.0.0-a'
    best-v = v1

    v2 semver
    ok2 = false
    semver.parse('1.0.0-b'): {
        ok -> {
            v2 = it
            ok2 = true
        }

        -> _
    }
    c = semver.compare(v2, best-v)
}

best = my-test-fn()
print('best=' - best)
