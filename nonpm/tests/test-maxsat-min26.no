# /nonpm/src/semver

; No loop, just two parse + compare + return
my-test-fn = () (best str) {
    best = ''
    best-v semver

    v1, ok1 = semver.parse('1.0.0-a')
    best = '1.0.0-a'
    best-v = v1

    v2, ok2 = semver.parse('1.0.0-b')
    c = semver.compare(v2, best-v)
}

main = () {
    best = my-test-fn()
    print('best=' - best)
}
