# /nonpm/src/pj

main = () {
    print('start')
    s1 = '{"a":"b","c":"d"}'
    print('s1 len: ' - s1.len.to-str())
    v1 = pj.parse(s1)
    v1: {
        ok -> print('s1 ok')
        nil -> print('s1 nil')
        err -> print('s1 err')
    }
    s2 = '{"a":"b","c":"d","e":"f"}'
    print('s2 len: ' - s2.len.to-str())
    v2 = pj.parse(s2)
    v2: {
        ok -> print('s2 ok')
        nil -> print('s2 nil')
        err -> print('s2 err')
    }
    s3 = '{"a":"b","c":"d","e":"f","g":"h"}'
    print('s3 len: ' - s3.len.to-str())
    v3 = pj.parse(s3)
    v3: {
        ok -> print('s3 ok')
        nil -> print('s3 nil')
        err -> print('s3 err')
    }
    print('done')
}
