# /nonpm/src/utils

remove-key-test = (v json, dep-key str, name str) (ok bool) {
    ok = false
    dep-obj = json.get(v, dep-key)
    dep-obj: {
        ok -> {

            ; 直接用方法调用而不是 json.xxx(it, ...) 格式
            it.delete-key(name)
            ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
}

main = () {
    content = '{"name":"test","version":"1.0.0","dependencies":{"foo":"^1.0.0","bar":"^2.0.0"}}'
    v = json.parse(content)
    v: {
        ok -> {
            root json = it
            ok = remove-key-test(root, 'dependencies', 'foo')
            print('remove-key-test ok={ok}')
            out = root.stringify()
            #{overflow=wrap}
            print('result: ' - out)
        }

        nil -> print('parse nil')

        err -> print('parse err')
    }
}
main()
