; json.no — JSON parsing and generation helpers for noNpm
;
; Wraps the standard library json module with convenience functions
; for reading/writing package.json and other JSON files.
;
; Standard library json API:
;   json.parse(s str) (?json)           — parse JSON string
;   j.stringify() (out str)             — serialize to compact JSON
;   j.get(key) (?json)                   — get child as json
;   j.get-str(key) (val str, ok bool)    — get string value
;   j.get-num(key) (val f64, ok bool)    — get numeric value
;   j.get-bool(key) (val bool, ok bool)  — get boolean value
;   j.get-i64(key) (val i64, ok bool)    — get integer value
;   j.set-str(key, val) (ok bool)        — set string value
;   j.set-num(key, val) (ok bool)        — set numeric value
;   j.set-bool(key, val) (ok bool)       — set boolean value
;   j.arr-get(idx) (?json)               — get array element
;   j.arr-len() (n i64)                  — get array length
;   j.arr-push(val json) (ok bool)       — push to array
;   j.arr-push-str(val str) (ok bool)    — push string to array
;   j.kind() (k i64)                     — get value kind
;   j.str() (val str, ok bool)           — get scalar string
;   j.num() (val f64, ok bool)           — get scalar number
;   j.bool() (val bool, ok bool)         — get scalar boolean

; ═══════════════════════════════════════════════
; parse — parse JSON string
; s str — JSON text
; returns val ?json — parsed value (ok=json, nil=empty, err=invalid)
; ═══════════════════════════════════════════════

parse = (s str) (val ?json) {
    val = json.parse(s)
}

; ═══════════════════════════════════════════════
; parse-file — read and parse a JSON file
; path str — file path
; returns val ?json — parsed value (nil=not found, err=parse error)
; ═══════════════════════════════════════════════

parse-file = (path str) (val ?json) {
    val = nil
    p = path{
        p: path,
    }
    p.exists() -> {
        raw = fs.read-file(path)
        val = json.parse(raw)
    }
}

; ═══════════════════════════════════════════════
; stringify — serialize json to compact JSON string
; val json — value to serialize
; returns s str — JSON text
; NOTE: skipped due to standard library f64.to-str() LLVM codegen bug
; ═══════════════════════════════════════════════

; stringify = (val json) (s str) {
;     s = val.stringify()
; }

; ═══════════════════════════════════════════════
; stringify-pretty — serialize json to indented JSON string
; val json — value to serialize
; indent i64 — number of spaces per indent level
; returns s str — pretty JSON text
; NOTE: skipped due to standard library f64.to-str() LLVM codegen bug
; ═══════════════════════════════════════════════

; stringify-pretty = (val json, indent i64) (s str) {
;     s = val.stringify()
; }

; ═══════════════════════════════════════════════
; write-json — write json value to file as pretty JSON
; path str — file path
; val json — value to write
; returns ok bool — true on success
; NOTE: skipped due to standard library f64.to-str() LLVM codegen bug
; ═══════════════════════════════════════════════

; write-json = (path str, val json) (ok bool) {
;     ok = false
;     s = val.stringify()
;     fd = fs.open-write(path)
;     {
;         fd <= 0 -> return
;         -> {
;             fs.write(fd, s, s.len)
;             fs.close(fd)
;             ok = true
;         }
;     }
; }

; ═══════════════════════════════════════════════
; get-str — get string value from JSON object by key
; val json — JSON object
; key str — property key
; returns s str — string value (empty if not found)
; ═══════════════════════════════════════════════

get-str = (val json, key str) (s str) {
    s = ''
    s, ok = val.get-str(key)
}

; ═══════════════════════════════════════════════
; get-obj — get object value from JSON object by key
; val json — JSON object
; key str — property key
; returns child ?json — object value (nil if not found)
; ═══════════════════════════════════════════════

get-obj = (val json, key str) (child ?json) {
    child = val.get(key)
}

; ═══════════════════════════════════════════════
; get-arr — get array value from JSON object by key
; val json — JSON object
; key str — property key
; returns child ?json — array value (nil if not found)
; ═══════════════════════════════════════════════

get-arr = (val json, key str) (child ?json) {
    child = val.get(key)
}

; ═══════════════════════════════════════════════
; get-num — get numeric value from JSON object by key
; val json — JSON object
; key str — property key
; returns n i64 — numeric value (0 if not found)
; ═══════════════════════════════════════════════

get-num = (val json, key str) (n i64) {
    n = 0
    f, ok = val.get-i64(key)
    {
        ok -> n = f
    }
}

; ═══════════════════════════════════════════════
; get-bool — get boolean value from JSON object by key
; val json — JSON object
; key str — property key
; returns b bool — boolean value (false if not found)
; ═══════════════════════════════════════════════

get-bool = (val json, key str) (b bool) {
    b = false
    b, ok = val.get-bool(key)
}

; ═══════════════════════════════════════════════
; arr-length — get JSON array length
; val json — JSON array
; returns n i64 — array length
; ═══════════════════════════════════════════════

arr-length = (val json) (n i64) {
    n = val.arr-len()
}

; ═══════════════════════════════════════════════
; arr-get — get element from JSON array by index
; val json — JSON array
; idx i64 — index
; returns child ?json — element (nil if out of bounds)
; ═══════════════════════════════════════════════

arr-get = (val json, idx i64) (child ?json) {
    child = val.arr-get(idx)
}

; ═══════════════════════════════════════════════
; obj-keys — get all keys from JSON object
; val json — JSON object
; returns keys []str — array of key strings
; ═══════════════════════════════════════════════

; NOTE: Standard library json does not have obj-keys-str method.
; This function is a placeholder.

; ═══════════════════════════════════════════════
; create-obj — create a new empty JSON object
; returns val json — new JSON object
; ═══════════════════════════════════════════════

create-obj = () (val json) {
    val = json.new()
}

; ═══════════════════════════════════════════════
; create-arr — create a new empty JSON array
; returns val json — new JSON array
; ═══════════════════════════════════════════════

create-arr = () (val json) {
    val = json.new()
}

; ═══════════════════════════════════════════════
; set-str — set string property on JSON object
; val json — JSON object
; key str — property key
; s str — string value
; ═══════════════════════════════════════════════

set-str = (val json, key str, s str) {
    val.set-str(key, s)
}

; ═══════════════════════════════════════════════
; set-num — set numeric property on JSON object
; val json — JSON object
; key str — property key
; n i64 — numeric value
; ═══════════════════════════════════════════════

set-num = (val json, key str, n i64) {
    val.set-i64(key, n)
}

; ═══════════════════════════════════════════════
; set-bool — set boolean property on JSON object
; val json — JSON object
; key str — property key
; b bool — boolean value
; ═══════════════════════════════════════════════

set-bool = (val json, key str, b bool) {
    val.set-bool(key, b)
}

; ═══════════════════════════════════════════════
; arr-push — append string value to JSON array
; val json — JSON array
; s str — string to append
; ═══════════════════════════════════════════════

arr-push = (val json, s str) {
    val.arr-push-str(s)
}

; ═══════════════════════════════════════════════
; new-str — parse a JSON string value from a str
; s str — string value
; returns val ?json — JSON string value
; ═══════════════════════════════════════════════

new-str = (s str) (val ?json) {
    quoted = '"' - s - '"'
    val = json.parse(quoted)
}
