; ═══════════════════════════════════════════════
; login — authenticate with registry, return token
; cfg config — configuration
; username str — npm username
; password str — npm password
; returns token ?str — auth token (nil=failed, err=error)
; ═══════════════════════════════════════════════

login = (cfg config, username str, password str) (token ?str) {
    token = nil
    url = cfg.registry - '-/v1/login'
    body = '{"username":"' - username - '","password":"' - password - '"}'
    req = http.request {
        method: 'PUT'
        url: url
        body: body
    }
    req.add-header('Content-Type', 'application/json')
    resp = http.do-req(req)
    resp: {
        ok -> {
            sc = it.status-code
            sc != 200 -> {
                token = err('login failed: status ' - sc.to-str())
                return
            }
            v = json.parse(it.body)
            v: {
                ok -> {
                    tok = it.get('token')
                    tok: {
                        ok -> {
                            s, found = it.str()
                            found -> token = s
                        }

                        nil -> token = nil

                        err -> token = err('network error')
                    }
                }

                nil -> token = nil

                err -> token = err('network error')
            }
        }

        nil -> {
            token = err('network error during login')
            return
        }

        err -> {
            token = err('network error')
            return
        }
    }
}

; ═══════════════════════════════════════════════
; whoami — check authentication, return username
; cfg config — configuration
; token str — auth token
; returns username ?str — username (nil=not authed, err=error)
; ═══════════════════════════════════════════════

whoami = (cfg config, token str) (username ?str) {
    username = nil
    url = cfg.registry - '-/whoami'

    ; send the auth token — /-/whoami is authenticated and returns the identity
    ; tied to the token; without the header the registry reports the anonymous
    ; user (or 401), which made `whoami` always wrong.
    req = http.request {
        method: 'GET'
        url: url
        body: ''
    }
    http.set-bearer-auth(req, token)
    resp = http.do-req(req)
    resp: {
        ok -> {
            it.status-code != 200 -> {
                username = nil
                return
            }

            ; npm's /-/whoami returns either {"username":"..."} JSON or a bare name
            body = it.body
            v = json.parse(body)
            got = false
            v: {
                ok -> {
                    un = it.get('username')
                    un: {
                        ok -> {
                            s, found = it.str()
                            found -> {
                                username = s
                                got = true
                            }
                        }

                        nil -> {
                        }

                        err -> {
                        }
                    }
                }

                nil -> {
                }

                err -> {
                }
            }
            got == false -> {
                t = body.trim()
                t.len() > 0 -> username = t
            }
        }

        nil -> {
            username = err('network error')
            return
        }

        err -> {
            username = err('network error')
            return
        }
    }
}
