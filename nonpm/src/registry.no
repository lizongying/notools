; registry.no — npm registry HTTP interaction for noNpm
;
; Provides functions for communicating with the npm registry:
; - Fetching package metadata (all versions, dist info)
; - Downloading tarballs
; - Publishing packages
; - User authentication
;
; API:
;   fetch-metadata(cfg config, pkg str) (meta ?json) — get package metadata
;   fetch-version(cfg config, pkg str, ver str) (meta ?json) — get specific version metadata
;   get-tarball-url(meta json, ver str) (url str) — extract tarball URL
;   get-dist-info(meta json, ver str) (url str, shasum str, ok bool) — get dist info
;   login(cfg config, username str, password str) (token ?str) — authenticate
;   whoami(cfg config, token str) (username ?str) — check auth

# /nonpm/src/utils
# /nonpm/src/pj
# /nonpm/src/semver
# /nonpm/src/config

; ═══════════════════════════════════════════════
; encode-pkg — registry path-safe package name
; The npm registry requires the '/' inside a scoped name ('@scope/name') to be
; percent-encoded, otherwise it is read as an extra path segment (404).
; pkg str — package name
; returns out str — name with '/' -> '%2F' for scoped packages
; ═══════════════════════════════════════════════

encode-pkg = (pkg str) (out str) {
    out = pkg
    pkg.starts-with('@') -> out = utils.replace(pkg, '/', '%2F')
}

; ═══════════════════════════════════════════════
; fetch-json — GET a URL and parse JSON, retrying transient failures
; cfg config — configuration (fetch-retries / fetch-retry-mintimeout)
; url str — full request URL
; returns meta ?json — parsed body (nil on 404 / terminal / exhausted retries)
; 5xx responses and network errors are retried up to cfg.fetch-retries times;
; 404 and 2xx are terminal (never retried).
; ═══════════════════════════════════════════════

fetch-json = (cfg config, url str) (meta ?json) {
    meta = nil

    #{overflow=wrap}
    attempts = cfg.fetch-retries + 1
    attempts < 1 -> attempts = 1
    i <- [0..attempts): {
        resp = http.get(url)
        got = false
        is-404 = false
        retryable = false
        parsed ?json = nil
        resp: {
            ok -> {
                sc = it.status-code
                sc == 404 -> is-404 = true
                sc >= 200 && sc < 300 -> {
                    parsed = json.parse(it.body)
                    got = true
                }
                sc >= 500 -> retryable = true
            }

            err -> retryable = true

            nil -> retryable = true
        }
        is-404 -> return
        got -> {
            meta = parsed
            return
        }

        #{overflow=wrap}
        retryable && i + 1 < attempts -> {
            time.sleep-ms(cfg.fetch-retry-mintimeout)
            continue
        }
        return
    }
}

; ═══════════════════════════════════════════════
; fetch-metadata — fetch full package metadata from registry
; cfg config — configuration (contains registry URL)
; pkg str — package name
; returns meta ?json — parsed metadata (nil=not found, err=error)
; ═══════════════════════════════════════════════

fetch-metadata = (cfg config, pkg str) (meta ?json) {
    meta = nil

    #{overflow=wrap}
    url = cfg.registry - encode-pkg(pkg)
    meta = fetch-json(cfg, url)
}

; ═══════════════════════════════════════════════
; fetch-version — fetch metadata for a specific version
; cfg config — configuration
; pkg str — package name
; ver str — version string (or "latest")
; returns meta ?json — version metadata (nil=not found, err=error)
; ═══════════════════════════════════════════════

fetch-version = (cfg config, pkg str, ver str) (meta ?json) {
    meta = nil
    version-path = ver
    ver == 'latest' -> version-path = 'latest'
    ver == '' -> version-path = 'latest'

    #{overflow=wrap}
    url = cfg.registry - encode-pkg(pkg) - '/' - version-path
    meta = fetch-json(cfg, url)
}

; ═══════════════════════════════════════════════
; get-tarball-url — extract tarball URL from version metadata
; meta json — version metadata
; returns url str — tarball download URL
; ═══════════════════════════════════════════════

get-tarball-url = (meta json) (url str) {
    url = ''
    dist = meta.get('dist')
    dist: {
        ok -> {
            tarball = it.get('tarball')
            tarball: {
                ok -> {
                    s, found = it.str()
                    found -> url = s
                }

                nil -> {
                }

                err -> {
                }
            }
        }

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; get-dist-info — get dist info (url, shasum) from version metadata
; meta json — version metadata
; returns url str — tarball URL
; returns shasum str — SHA-512 hex digest
; returns ok bool — true if found
; ═══════════════════════════════════════════════

get-dist-info = (meta json) (url str, shasum str, ok bool) {
    url = ''
    shasum = ''
    ok = false
    dist = meta.get('dist')
    dist: {
        ok -> {

            ; Save dist child reference before `it` gets reassigned by nested matches
            dist-val json = it

            ; Read shasum and integrity first (before `it` changes)
            sh = dist-val.get('shasum')
            sh: {
                ok -> {
                    s, found = it.str()
                    found -> shasum = s
                }

                nil -> {
                }

                err -> {
                }
            }
            int-val = dist-val.get('integrity')
            int-val: {
                ok -> {
                    int-str, found = it.str()
                    found && int-str.len() > 0 -> shasum = int-str
                }

                nil -> {
                }

                err -> {
                }
            }

            ; Read tarball URL last
            tarball = dist-val.get('tarball')
            tarball: {
                ok -> {
                    s, found = it.str()
                    found -> url = s
                }

                nil -> return

                err -> return
            }
            ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; get-versions — get all available versions from package metadata
; meta json — package metadata
; returns versions []str — list of version strings
; ═══════════════════════════════════════════════

get-versions = (meta json) (versions []str) {
    versions = []
    versions-obj = meta.get('versions')
    versions-obj: {
        ok -> {
            cnt = it.obj-len()
            j <- [0..cnt): {
                k, kok = it.obj-key(j)
                kok -> versions.push(k)
            }
        }

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; get-latest-version — get the "latest" dist-tag
; meta json — package metadata
; returns ver str — latest version string
; ═══════════════════════════════════════════════

get-latest-version = (meta json) (ver str) {
    ver = ''
    dist-tags = meta.get('dist-tags')
    dist-tags: {
        ok -> {
            latest = it.get('latest')
            latest: {
                ok -> {
                    s, found = it.str()
                    found -> ver = s
                }

                nil -> {
                }

                err -> {
                }
            }
        }

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; get-deps — get dependencies from version metadata
; meta json — version metadata
; returns deps str — JSON string of dependencies
; ═══════════════════════════════════════════════

get-deps = (meta json) (deps str) {
    deps = ''
    dep-obj = meta.get('dependencies')
    dep-obj: {
        ok -> {
            deps = it.stringify()
        }

        nil -> {
        }

        err -> {
        }
    }
}

