; lockfile.no — pnpm-lock.yaml generation and reading for noNpm
;
; Generates a lockfile in pnpm-lock.yaml format (YAML) that records:
; - All resolved dependencies and their exact versions
; - The integrity checksums for verification
; - The dependency tree structure
;
; API:
;   (lockfile 內容由各呼叫方 inline 建立，見 installer.install / installer.add /
;    main.cmd-import；不提供共用 build 函式，原因見下方 NOTE)
;   check-valid(cfg config, dir str, graph dep-graph) (ok bool) — check if lockfile matches
;   read(dir str) (content ?str) — read lockfile content
;   get-pkg-version(content str, name str) (ver ?str) — get version from lockfile

# /nonpm/src/utils
# /nonpm/src/config

; ═══════════════════════════════════════════════
; check-valid — check if existing lockfile matches the graph
; cfg config — configuration
; dir str — project root directory
; graph dep-graph — resolved dependency graph
; returns ok bool — true if lockfile is valid
; returns ok bool — true on success
; ═══════════════════════════════════════════════
; NOTE: lockfile 內容建立（pnpm-lock.yaml）目前由各呼叫方「在本函式內直接
; 遍歷 graph.nodes」完成（見 installer.install / installer.add / cmd-import），
; 不提供共用 build 函式——因 Nolang 編譯器對「含 slice 欄位的結構
; (dep-node 含 deps []dep-node) 按值拷貝」在第二次/重分配後遍歷、或作為函式
; 引數傳遞時會產生壞拷貝（欄位被清零 → `signal: abort trap`）。故 lockfile
; 內容必須在 graph 剛解析完、尚未發生重分配（下載/解壓等）之前，於同一個
; 呼叫框架內 inline 建立。

; ═══════════════════════════════════════════════
; check-valid — check if existing lockfile matches the resolved graph
; cfg config — configuration
; dir str — project root directory
; resolved-map str — "name=version\n..." from the freshly resolved graph (a
;   plain str, safe to pass across the call boundary; we do NOT take the
;   dep-graph struct here to avoid the struct-with-slice copy bug)
; returns ok bool — true if every resolved node is present in the lockfile
; ═══════════════════════════════════════════════

check-valid = (cfg config, dir str, resolved-map str) (ok bool) {
    ok = false
    lock-opt = read-lockfile(dir)
    content str
    have = false
    lock-opt: {
        ok -> {
            content = it
            have = true
        }

        -> {
        }
    }

    ; no lockfile on disk → nothing is locked → not valid
    ! have -> return
    content.len() == 0 -> return

    ; empty graph: valid as long as a lockfile exists
    resolved-map.len() == 0 -> {
        ok = true
        return
    }

    ; every "name=ver" must appear as a packages: entry "name@ver:"
    lines = resolved-map.split('\n')
    n = lines.len()
    i <- [0..n): {
        line = lines[i].trim()
        line.len() == 0 -> continue
        eq = line.index('=')
        eq < 0 -> continue

        name = line.slice(0, eq)
        ver = line.slice(eq + 1, line.len()).trim()
        marker = name - '@' - ver - ':'
        content.index(marker) < 0 -> {
            ok = false
            return
        }
    }
    ok = true
}

; ═══════════════════════════════════════════════
; read — read lockfile content
; dir str — project root directory
; returns content ?str — lockfile content (nil=not found)
; ═══════════════════════════════════════════════

read-lockfile = (dir str) (content ?str) {
    content = nil
    lock-path = dir - '/pnpm-lock.yaml'
    p = path {
        p: lock-path
    }
    p.exists() -> {
        result = fs.read-str(lock-path)
        result: {
            ok -> {
                content = it
            }

            nil -> {
            }

            err -> {
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-pkg-version — get a package's version from lockfile
; content str — lockfile content
; name str — package name
; returns ver ?str — version string (nil=not found)
; ═══════════════════════════════════════════════

get-pkg-version = (content str, name str) (ver ?str) {
    ver = nil

    ; search for "  name:\n    version: X.Y.Z"
    search = name - ':\n'
    pos = content.index(search)
    pos >= 0 -> {

        #{overflow=wrap}
        rest = content.slice(pos + search.len-bytes(), content.len-bytes())
        ver-line = rest.index('version:')
        ver-line >= 0 -> {

            #{overflow=wrap}
            after = rest.slice(ver-line + 8, rest.len())
            after = after.trim()
            nl = after.index('\n')
            version-str = after
            nl >= 0 -> version-str = after.slice(0, nl)
            version-str = version-str.trim()
            ver = version-str
        }
    }
}

; ═══════════════════════════════════════════════
; get-pkg-resolved — get a package's resolved URL from lockfile
; content str — lockfile content
; name str — package name
; returns url ?str — resolved URL (nil=not found)
; ═══════════════════════════════════════════════

get-pkg-resolved = (content str, name str) (url ?str) {
    url = nil
    search = name - ':\n'
    pos = content.index(search)
    pos >= 0 -> {

        #{overflow=wrap}
        rest = content.slice(pos + search.len-bytes(), content.len-bytes())
        resolved-line = rest.index('resolved:')
        resolved-line >= 0 -> {

            #{overflow=wrap}
            after = rest.slice(resolved-line + 10, rest.len())
            after = after.trim()
            nl = after.index('\n')
            url-str = after
            nl >= 0 -> url-str = after.slice(0, nl)
            url-str = url-str.trim()
            url = url-str
        }
    }
}

; ═══════════════════════════════════════════════
; get-pkg-integrity — get a package's integrity hash from lockfile
; content str — lockfile content
; name str — package name
; returns integrity ?str — integrity string (nil=not found)
; ═══════════════════════════════════════════════

get-pkg-integrity = (content str, name str) (integrity ?str) {
    integrity = nil
    search = name - ':\n'
    pos = content.index(search)
    pos >= 0 -> {

        #{overflow=wrap}
        rest = content.slice(pos + search.len-bytes(), content.len-bytes())
        int-line = rest.index('integrity:')
        int-line >= 0 -> {

            #{overflow=wrap}
            after = rest.slice(int-line + 10, rest.len())
            after = after.trim()
            nl = after.index('\n')
            int-str = after
            nl >= 0 -> int-str = after.slice(0, nl)
            int-str = int-str.trim()

            ; v9 內聯 mapping 格式：`resolution: {integrity: sha512-...==}` 的值後會帶一個結尾 `}`，需剝除
            int-str.ends-with('}') -> {

                #{overflow=wrap}
                int-str = int-str.slice(0, int-str.len-bytes() - 1)
                int-str = int-str.trim()
            }
            integrity = int-str
        }
    }
}
