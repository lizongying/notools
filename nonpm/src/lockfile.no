; cfg config — configuration
; dir str — project root directory
; graph dep-graph — resolved dependency graph
; returns ok bool — true on success
; ═══════════════════════════════════════════════

generate = (cfg config, dir str, graph dep-graph) (ok bool) {
    ok = false
    ; TODO: implement using fs.write
}

