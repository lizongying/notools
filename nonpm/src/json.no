; json.no — JSON parsing and generation helpers for noNpm
;
; Wraps the standard library json module with convenience functions
; for reading/writing package.json and other JSON files.

# /nonpm/src/utils

; ═══════════════════════════════════════════════
; parse — parse JSON string into json-value
; s str — JSON text
; returns val ?json-value — parsed value (nil=empty, err=invalid)
; ═══════════════════════════════════════════════

parse = (s str) (val ?json-value) {
    n = s.len
    val = json.parse(s, n)
}

; ═══════════════════════════════════════════════
; parse-file — read and parse a JSON file
; path str — file path
; returns val ?json-value — parsed value (nil=not found, err=parse error)
; ═══════════════════════════════════════════════

parse-file = (path str) (val ?json-value) {
    p = path{
        p: path,
    }
    p.exists() -> {
        raw = fs.read-file(path)
        n = raw.len
        val = json.parse(raw, n)
    }
    -> {
        val = nil
    }
}

; ═══════════════════════════════════════════════
; stringify — serialize json-value to compact JSON string
; val json-value — value to serialize
; returns s str — JSON text
; ═══════════════════════════════════════════════

stringify = (val json-value) (s str) {
    s = ''
    ; NOTE: json.stringify with str buffer causes LLVM type mismatch (str-long vs vec)
    ; This is a Nolang compiler bug tracked separately.
}

; ═══════════════════════════════════════════════
; stringify-pretty — serialize json-value to indented JSON string
; val json-value — value to serialize
; indent i64 — number of spaces per indent level
; returns s str — pretty JSON text
; ═══════════════════════════════════════════════

stringify-pretty = (val json-value, indent i64) (s str) {
    s = ''
    ; NOTE: json.stringify-pretty with str buffer causes LLVM type mismatch (str-long vs vec)
    ; This is a Nolang compiler bug tracked separately.
}

; ═══════════════════════════════════════════════
; write-file — write json-value to file as pretty JSON
; path str — file path
; val json-value — value to write
; returns ok bool — true on success
; ═══════════════════════════════════════════════

write-json = (path str, val json-value) (ok bool) {
    ok = false
    ; NOTE: stringify-pretty and utils.write-file cause LLVM type mismatch
}

; ═══════════════════════════════════════════════
; get-str — get string value from JSON object by key
; val json-value — JSON object
; key str — property key
; returns s str — string value (empty if not found)
; ═══════════════════════════════════════════════

get-str = (val json-value, key str) (s str) {
    s = ''
    child = json.get-key(val, key)
    child: {
        ok -> {
            it.kind() == json-kind.str -> s = it.str-val()
        }
        nil -> {}
        err -> {}
    }
}

; ═══════════════════════════════════════════════
; get-obj — get object value from JSON object by key
; val json-value — JSON object
; key str — property key
; returns child ?json-value — object value (nil if not found)
; ═══════════════════════════════════════════════

get-obj = (val json-value, key str) (child ?json-value) {
    child = json.get-key(val, key)
}

; ═══════════════════════════════════════════════
; get-arr — get array value from JSON object by key
; val json-value — JSON object
; key str — property key
; returns child ?json-value — array value (nil if not found)
; ═══════════════════════════════════════════════

get-arr = (val json-value, key str) (child ?json-value) {
    child = json.get-key(val, key)
}

; ═══════════════════════════════════════════════
; get-num — get numeric value from JSON object by key
; val json-value — JSON object
; key str — property key
; returns n i64 — numeric value (0 if not found)
; ═══════════════════════════════════════════════

get-num = (val json-value, key str) (n i64) {
    n = 0
    child = json.get-key(val, key)
    child: {
        ok -> {
            it.kind() == json-kind.num -> n = it.num-val()
        }
        nil -> {}
        err -> {}
    }
}

; ═══════════════════════════════════════════════
; get-bool — get boolean value from JSON object by key
; val json-value — JSON object
; key str — property key
; returns b bool — boolean value (false if not found)
; ═══════════════════════════════════════════════

get-bool = (val json-value, key str) (b bool) {
    b = false
    child = json.get-key(val, key)
    child: {
        ok -> {
            it.kind() == json-kind.bool -> b = it.bool-val()
        }
        nil -> {}
        err -> {}
    }
}

; ═══════════════════════════════════════════════
; arr-length — get JSON array length
; val json-value — JSON array
; returns n i64 — array length
; ═══════════════════════════════════════════════

arr-length = (val json-value) (n i64) {
    n = val.arr-len()
}

; ═══════════════════════════════════════════════
; arr-get — get element from JSON array by index
; val json-value — JSON array
; idx i64 — index
; returns child ?json-value — element (nil if out of bounds)
; ═══════════════════════════════════════════════

arr-get = (val json-value, idx i64) (child ?json-value) {
    child = val.arr-get(idx)
}

; ═══════════════════════════════════════════════
; obj-keys — get all keys from JSON object
; val json-value — JSON object
; returns keys []str — array of key strings
; ═══════════════════════════════════════════════

obj-keys = (val json-value) (keys []str) {
    keys = val.obj-keys-str()
}

; ═══════════════════════════════════════════════
; create-obj — create a new empty JSON object
; returns val json-value — new JSON object
; ═══════════════════════════════════════════════

create-obj = () (val json-value) {
    val = json.new-obj()
}

; ═══════════════════════════════════════════════
; create-arr — create a new empty JSON array
; returns val json-value — new JSON array
; ═══════════════════════════════════════════════

create-arr = () (val json-value) {
    val = json.new-arr()
}

; ═══════════════════════════════════════════════
; set-str — set string property on JSON object
; val json-value — JSON object
; key str — property key
; s str — string value
; ═══════════════════════════════════════════════

set-str = (val json-value, key str, s str) {
    json.set-key(val, key, json.from-str(s))
}

; ═══════════════════════════════════════════════
; set-num — set numeric property on JSON object
; val json-value — JSON object
; key str — property key
; n i64 — numeric value
; ═══════════════════════════════════════════════

set-num = (val json-value, key str, n i64) {
    json.set-key(val, key, json.from-num(n))
}

; ═══════════════════════════════════════════════
; set-bool — set boolean property on JSON object
; val json-value — JSON object
; key str — property key
; b bool — boolean value
; ═══════════════════════════════════════════════

set-bool = (val json-value, key str, b bool) {
    json.set-key(val, key, json.from-bool(b))
}

; ═══════════════════════════════════════════════
; arr-push — append value to JSON array
; val json-value — JSON array
; child json-value — value to append
; ═══════════════════════════════════════════════

arr-push = (val json-value, child json-value) {
    val.arr-push(child)
}

; ═══════════════════════════════════════════════
; new-str — create a JSON string value from a str
; s str — string value
; returns val json-value — JSON string value
; ═══════════════════════════════════════════════

new-str = (s str) (val json-value) {
    val = json.from-str(s)
}

; ═══════════════════════════════════════════════
; new-num — create a JSON numeric value from an i64
; n i64 — numeric value
; returns val json-value — JSON numeric value
; ═══════════════════════════════════════════════

new-num = (n i64) (val json-value) {
    val = json.from-num(n)
}

; ═══════════════════════════════════════════════
; new-bool — create a JSON boolean value from a bool
; b bool — boolean value
; returns val json-value — JSON boolean value
; ═══════════════════════════════════════════════

new-bool = (b bool) (val json-value) {
    val = json.from-bool(b)
}
