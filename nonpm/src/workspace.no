; workspace.no — workspace multi-package management for noNpm
;
; Manages monorepo workspaces with pnpm-workspace.yaml:
; - Discovers workspace packages via glob patterns
; - Supports recursive commands across all packages
; - Handles inter-package dependencies
;
; API:
;   discover(dir str) (packages ?[]str) — find all workspace packages
;   get-package-info(dir str) (name str, ver str, ok bool) — read package info
;   is-workspace-root(dir str) (ok bool) — check if directory is workspace root
;   exec-recursive(dir str, cmd str) (ok bool) — run command in all packages
;   resolve-local-dep(dir str, name str) (path ?str) — resolve local package path

# /nonpm/src/utils
# /nonpm/src/pj

; ═══════════════════════════════════════════════
; discover — discover all workspace packages
; dir str — workspace root directory
; returns paths ?[]str — list of package directories (nil=not found)
; ═══════════════════════════════════════════════

discover = (dir str) (paths ?[]str) {
    paths = nil
    found = false
    acc []str
    ws-path = dir - '/pnpm-workspace.yaml'
    p = path {
        p: ws-path
    }
    p.exists() -> {
        result = fs.read-str(ws-path)
        result: {
            ok -> content = it

            nil -> content = ''

            err -> content = ''
        }
        patterns = parse-packages-field(content)

        ; expand each glob pattern
        pat-lines = patterns.split('\n')
        n = pat-lines.len()
        i <- [0..n): {
            pat = pat-lines[i].trim()
            pat.len() > 0 -> {
                expand-pattern(dir, pat, acc)
            }
        }
        found = true
    }

    -> {

        ; check package.json for "workspaces" field
        pkg-path = dir - '/package.json'
        pp = path {
            p: pkg-path
        }
        pp.exists() -> {
            result = fs.read-str(pkg-path)
            result: {
                ok -> content = it

                nil -> content = ''

                err -> content = ''
            }
            v = json.parse(content)
            v: {
                ok -> {
                    ws ?json = it.get('workspaces')
                    ws: {
                        ok -> {
                            it.is-arr() -> {
                                n = it.arr-len()
                                i <- [0..n): {
                                    entry ?json = it.arr-get(i)
                                    entry: {
                                        ok -> {
                                            pat, str-ok = it.str()
                                            expand-pattern(dir, pat, acc)
                                        }

                                        nil -> {
                                        }

                                        err -> {
                                        }
                                    }
                                }
                                found = true
                            }

                            it.is-obj() -> {
                                packages ?json = it.get('packages')
                                packages: {
                                    ok -> {
                                        n = packages.arr-len()
                                        i <- [0..n): {
                                            entry ?json = packages.arr-get(i)
                                            entry: {
                                                ok -> {
                                                    pat, str-ok = it.str()
                                                    expand-pattern(dir, pat, acc)
                                                }

                                                nil -> {
                                                }

                                                err -> {
                                                }
                                            }
                                        }
                                        found = true
                                    }

                                    nil -> {
                                    }

                                    err -> {
                                    }
                                }
                            }
                        }

                        nil -> {
                        }

                        err -> {
                        }
                    }
                }

                nil -> {
                }

                err -> {
                }
            }
        }
    }
    found -> paths = acc
}

; ═══════════════════════════════════════════════
; parse-packages-field — extract package patterns from yaml
; content str — pnpm-workspace.yaml content
; returns patterns str — newline-separated glob patterns
; ═══════════════════════════════════════════════

parse-packages-field = (content str) (patterns str) {
    patterns = ''
    lines = content.split('\n')
    n = lines.len()
    in-packages = false
    i <- [0..n): {

        #{index-out=zero}
        line = lines[i]
        trimmed = line.trim()
        trimmed.starts-with('packages:') -> {
            in-packages = true
            continue
        }
        in-packages -> {
            trimmed.starts-with('-') -> {
                val = trimmed.slice(1, trimmed.len()).trim()
                val.starts-with('"') -> val = val.slice(1, val.len())

                #{overflow=wrap}
                val.ends-with('"') -> val = val.slice(0, val.len() - 1)
                val.starts-with("'") -> val = val.slice(1, val.len())

                #{overflow=wrap}
                val.ends-with("'") -> val = val.slice(0, val.len() - 1)
                patterns = patterns - val - '\n'
            }

            -> {
                in-packages = false
            }
        }
    }
}

; ═══════════════════════════════════════════════
; expand-pattern — expand a glob pattern and add matching dirs to paths
; base-dir str — workspace root
; pattern str — glob pattern (e.g. "packages/*", "packages/**", "apps/a")
; paths []str — array to append matches to (mutated in place)
; NOTE: walks the pattern segment-by-segment instead of a fixed `-maxdepth 2`
; find, which previously missed package.json at packages/<name>/ (depth 3).
; '*' = one immediate directory level; '**' = all descendant directories.
; ═══════════════════════════════════════════════

expand-pattern = (base-dir str, pattern str, paths []str) {
    pat = pattern.trim()
    pat.len() == 0 -> return

    ; tolerate the common "packages/*/package.json" glob form
    pat.ends-with('/package.json') -> {

        #{overflow=wrap}
        pat = pat.slice(0, pat.len() - 13)
    }
    segs = pat.split('/')
    n = segs.len()
    current []str
    current.push(base-dir)
    s <- [0..n): {
        seg = segs[s].trim()
        seg.len() == 0 -> continue
        next []str
        m = current.len()
        k <- [0..m): {

            #{index-out=zero}
            cur = current[k]
            seg == '*' -> {
                entries = fs.dir-entries(cur)
                e = entries.len()
                q <- [0..e): {
                    sub = cur - '/' - entries[q]
                    fs.is-dir(sub) -> next.push(sub)
                }
            }

            seg == '**' -> {
                collect-dirs(cur, next)
            }

            -> {
                cand = cur - '/' - seg
                fs.is-dir(cand) -> next.push(cand)
            }
        }
        current = next
    }
    d = current.len()
    z <- [0..d): {

        #{index-out=zero}
        pd = current[z]
        fs.is-file(pd - '/package.json') -> paths.push(pd)
    }
}

; ═══════════════════════════════════════════════
; collect-dirs — recursively collect a directory and all its descendants
; dir str — starting directory
; acc []str — output accumulator (mutated in place); skips node_modules
; ═══════════════════════════════════════════════

collect-dirs = (dir str, acc []str) {
    acc.push(dir)
    entries = fs.dir-entries(dir)
    e = entries.len()
    i <- [0..e): {

        #{index-out=zero}
        name = entries[i]
        name == 'node_modules' -> continue
        sub = dir - '/' - name
        fs.is-dir(sub) -> collect-dirs(sub, acc)
    }
}

; ═══════════════════════════════════════════════
; get-package-info — read package name and version
; dir str — package directory
; returns name str — package name
; returns ver str — package version
; returns ok bool — true if package.json found
; ═══════════════════════════════════════════════

get-package-info = (dir str) (name str, ver str, ok bool) {
    name = ''
    ver = ''
    ok = false
    pkg-path = dir - '/package.json'
    p = path {
        p: pkg-path
    }
    p.exists() -> {
        result = fs.read-str(pkg-path)
        result: {
            ok -> content = it

            nil -> content = ''

            err -> content = ''
        }
        v = json.parse(content)
        v: {
            ok -> {
                root = it
                name-val = root.get('name')
                name-val: {
                    ok -> {
                        name, str-ok = it.str()
                    }

                    nil -> {
                    }

                    err -> {
                    }
                }
                ver-val = root.get('version')
                ver-val: {
                    ok -> {
                        ver, str-ok = it.str()
                    }

                    nil -> {
                    }

                    err -> {
                    }
                }
                ok = true
            }

            nil -> {
            }

            err -> {
            }
        }
    }
}

; ═══════════════════════════════════════════════
; is-workspace-root — check if directory is workspace root
; dir str — directory to check
; returns ok bool — true if workspace root
; ═══════════════════════════════════════════════

is-workspace-root = (dir str) (ok bool) {
    ok = false
    ws-path = dir - '/pnpm-workspace.yaml'
    p = path {
        p: ws-path
    }
    p.exists() -> {
        ok = true
        return
    }

    ; check package.json workspaces field
    pkg-path = dir - '/package.json'
    pp = path {
        p: pkg-path
    }
    pp.exists() -> {
        result = fs.read-str(pkg-path)
        result: {
            ok -> content = it

            nil -> content = ''

            err -> content = ''
        }
        v = json.parse(content)
        v: {
            ok -> {
                ws = it.get('workspaces')
                ws: {
                    ok -> ok = true

                    nil -> {
                    }

                    err -> {
                    }
                }
            }

            nil -> {
            }

            err -> {
            }
        }
    }
}

; ═══════════════════════════════════════════════
; resolve-local-dep — resolve a local workspace dependency
; dir str — workspace root
; name str — package name
; returns path ?str — path to local package (nil=not found)
; ═══════════════════════════════════════════════

resolve-local-dep = (dir str, name str) (p ?str) {
    p = nil
    packages []str
    found = discover(dir)
    found: {
        ok -> packages = it

        nil -> {
        }

        err -> {
        }
    }
    packages.len() > 0 -> {
        n = packages.len()
        i <- [0..n): {

            #{index-out=zero}
            pkg-dir = packages[i]
            pkg-name, pkg-ver, info-ok = get-package-info(pkg-dir)
            info-ok -> {
                pkg-name == name -> {
                    p = pkg-dir
                    return
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; exec-recursive — run a command in all workspace packages
; dir str — workspace root
; cmd str — command to run
; returns ok bool — true if all succeeded
; ═══════════════════════════════════════════════

exec-recursive = (dir str, cmd str) (ok bool) {
    ok = true
    packages []str
    found = discover(dir)
    found: {
        ok -> packages = it

        nil -> {
        }

        err -> {
        }
    }
    packages.len() > 0 -> {
        n = packages.len()
        i <- [0..n): {

            #{index-out=zero}
            pkg-dir = packages[i]
            pkg-name, pkg-ver, info-ok = get-package-info(pkg-dir)
            info-ok -> {
                print('> ' - pkg-name - ' $ ' - cmd)
                code = process.process-system('cd ' - pkg-dir - ' && ' - cmd)
                code != 0 -> ok = false
            }
        }
    }
}
