; ═══════════════════════════════════════════════
; run-dev — convenience: run "dev" script
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

run-dev = (dir str) (ok bool) {
    ok = run-script(dir, 'dev', '')
}
