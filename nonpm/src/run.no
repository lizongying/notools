; run.no — script runner for noNpm
;
; Runs scripts defined in package.json:
; - npm run <script-name>
; - npm start, npm test (built-in shortcuts)
; - Passes extra args to the script
;
; API:
;   run-script(dir str, script str, args str) (ok bool) — run a script
;   list-scripts(dir str) (scripts str) — list available scripts
;   run-script-with-args(dir str, script str, args []str) (ok bool) — run with args

# /nonpm/src/utils
# /nonpm/src/pj

; ═══════════════════════════════════════════════
; run-script — run a script from package.json
; dir str — project root directory
; script str — script name
; args str — extra arguments to pass
; returns ok bool — true on success
; ═══════════════════════════════════════════════

run-script = (dir str, script-name str, args str) (ok bool) {
    ok = false
    cmd = get-script(dir, script-name)
    cmd.len == 0 -> {
        print('error: no script named "{script-name}"')
        return
    }
    full-cmd = cmd
    args.len > 0 -> full-cmd = full-cmd - ' ' - args
    print('> ' - script-name)
    print('> ' - full-cmd)
    code = process.process-system('cd ' - dir - ' && ' - full-cmd)
    ok = code == 0
}

; ═══════════════════════════════════════════════
; get-script — get a script command from package.json
; dir str — project root directory
; script-name str — script name
; returns cmd str — script command (empty if not found)
; ═══════════════════════════════════════════════

get-script = (dir str, script-name str) (cmd str) {
    cmd = ''
    pkg-path = dir - '/package.json'
    p = path{
        p: pkg-path,
    }
    p.exists() -> {
        result = fs.read-str(pkg-path)
        result: {
            ok -> content = it
            nil -> content = ''
            err -> content = ''
        }
        v = json.parse(content, content.len)
        v: {
            ok -> {
                scripts = json.get-key(it, 'scripts')
                scripts: {
                    ok -> {
                        script = json.get-key(it, script-name)
                        script: {
                            ok -> cmd = it.str-val()
                            nil -> {}
                            err -> {}
                        }
                    }
                    nil -> {}
                    err -> {}
                }
            }
            nil -> {}
            err -> {}
        }
    }
}

; ═══════════════════════════════════════════════
; list-scripts — list all available scripts
; dir str — project root directory
; returns scripts str — formatted list of scripts
; ═══════════════════════════════════════════════

list-scripts = (dir str) (scripts str) {
    scripts = ''
    pkg-path = dir - '/package.json'
    p = path{
        p: pkg-path,
    }
    p.exists() -> {
        result = fs.read-str(pkg-path)
        result: {
            ok -> content = it
            nil -> content = ''
            err -> content = ''
        }
        v = json.parse(content, content.len)
        v: {
            ok -> {
                scripts-obj = json.get-key(it, 'scripts')
                scripts-obj: {
                    ok -> {
                        keys = it.obj-keys-str()
                        n = keys.len
                        i <- [0..n): {
                            key = keys[i]
                            val = json.get-key(it, key)
                            val: {
                                ok -> {
                                    val-str = it.str-val()
                                    scripts = scripts - '  ' - key - '\n    ' - val-str - '\n'
                                }
                                nil -> {}
                                err -> {}
                            }
                        }
                    }
                    nil -> {
                        scripts = 'No scripts available'
                    }
                    err -> {
                        scripts = 'No scripts available'
                    }
                }
            }
            nil -> {}
            err -> {}
        }
    }
    scripts.len == 0 -> scripts = 'No scripts available'
}

; ═══════════════════════════════════════════════
; run-script-with-args — run script with argument array
; dir str — project root directory
; script-name str — script name
; args []str — arguments array
; returns ok bool — true on success
; ═══════════════════════════════════════════════

run-script-with-args = (dir str, script-name str, args []str) (ok bool) {
    args-str = utils.join(args, ' ')
    ok = run-script(dir, script-name, args-str)
}

; ═══════════════════════════════════════════════
; run-start — convenience: run "start" script
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

run-start = (dir str) (ok bool) {
    ok = run-script(dir, 'start', '')
}

; ═══════════════════════════════════════════════
; run-test — convenience: run "test" script
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

run-test = (dir str) (ok bool) {
    ok = run-script(dir, 'test', '')
}

; ═══════════════════════════════════════════════
; run-build — convenience: run "build" script
