; publish.no — package publishing to npm registry for noNpm
;
; Handles publishing packages to the npm registry:
; - Packs the package into a tarball
; - Uploads to the registry with auth token
; - Supports scoped packages
;
; API:
;   publish(cfg config, dir str, token str) (ok bool) — publish package
;   pack(dir str, dest str) (tgz-path ?str) — create tarball
;   get-publish-files(dir str) (files str) — get files to publish

# /nonpm/src/utils
# /nonpm/src/pj
# /nonpm/src/config
# /nonpm/src/tarball

; ═══════════════════════════════════════════════
; pack — create a tarball from package directory
; dir str — package root directory
; dest str — destination directory for .tgz
; returns tgz-path ?str — path to created tarball (nil=failed)
; ═══════════════════════════════════════════════

pack = (dir str, dest str) (tgz-path ?str, ok bool) {
    tgz-path = nil
    ok = false

    ; read package.json for name and version
    pkg-path = dir - '/package.json'
    p = path {
        p: pkg-path
    }
    p.exists() -> {
        result = fs.read-str(pkg-path)
        result: {
            ok -> content = it

            nil -> content = ''

            err -> content = ''
        }
        v = json.parse(content)
        v: {
            ok -> {
                name-val = it.get('name')
                ver-val = it.get('version')
                name-val: {
                    ok -> {
                        pkg-name, str-ok = it.str()
                        ver-val: {
                            ok -> {
                                pkg-ver, str-ok = it.str()

                                ; create tarball name: name-version.tgz
                                safe-name = pkg-name
                                safe-name = utils.replace(safe-name, '/', '-')

                                tgz-name = safe-name - '-' - pkg-ver - '.tgz'
                                tgz-path = dest - '/' - tgz-name

                                ; create tarball excluding node_modules and .git
                                pack-ok = tarball.pack-tarball(dir, tgz-path)
                                pack-ok == false -> tgz-path = nil
                                pack-ok == true -> ok = true
                            }

                            nil -> {
                                print('error: no version in package.json')
                            }

                            err -> {
                            }
                        }
                    }

                    nil -> {
                        print('error: no name in package.json')
                    }

                    err -> {
                    }
                }
            }

            nil -> {
                print('error: invalid package.json')
            }

            err -> {
            }
        }
    }

    -> {
        print('error: no package.json found')
    }
}

; ═══════════════════════════════════════════════
; publish — publish package to registry
; cfg config — configuration
; dir str — package root directory
; token str — auth token
; returns ok bool — true on success
; ═══════════════════════════════════════════════

publish = (cfg config, dir str, token str) (ok bool) {
    ok = false

    ; read package.json
    pkg-path = dir - '/package.json'
    p = path {
        p: pkg-path
    }
    p.exists() -> {
        result = fs.read-str(pkg-path)
        result: {
            ok -> content = it

            nil -> content = ''

            err -> content = ''
        }
        v = json.parse(content)
        v: {
            ok -> {
                name-val = it.get('name')
                ver-val = it.get('version')
                name-val: {
                    ok -> {
                        pkg-name, str-ok = it.str()
                        ver-val: {
                            ok -> {
                                pkg-ver, str-ok = it.str()
                                print('noNpm: packing ' - pkg-name - '@' - pkg-ver - '...')

                                ; create tarball
                                tmp-dest = '/tmp/nonpm-publish-' - os.now-ms().to-str()
                                process.process-system('mkdir -p ' - tmp-dest)
                                tgz-path, pack-ok = pack(dir, tmp-dest)
                                ! pack-ok -> {
                                    print('error: failed to create tarball')
                                    process.process-system('rm -rf ' - tmp-dest)
                                    return
                                }
                                tgz-file str
                                tgz-path: {
                                    ok -> tgz-file = it

                                    nil -> tgz-file = ''

                                    err -> tgz-file = ''
                                }

                                ; construct publish URL
                                safe-name = pkg-name
                                safe-name.starts-with('@') -> {

                                    ; scoped package
                                    safe-name = utils.replace(safe-name, '/', '%2F')
                                }

                                #{overflow=wrap}
                                pub-url = cfg.registry - safe-name

                                ; upload via pure-Nolang HTTP PUT (no system curl)
                                tgz-bytes = fs.read-file(tgz-file)
                                tgz-bytes.len() == 0 -> {
                                    print('error: failed to read tarball')
                                    process.process-system('rm -rf ' - tmp-dest)
                                    return
                                }
                                body = tgz-bytes.to-bytes-str()
                                req = http.request {
                                    method: 'PUT'
                                    url: pub-url
                                    body: body
                                }
                                req.add-header('Authorization', 'Bearer ' - token)
                                req.add-header('Content-Type', 'application/octet-stream')
                                resp = http.do-req(req)

                                ; cleanup
                                process.process-system('rm -rf ' - tmp-dest)

                                resp: {
                                    ok -> {
                                        sc = it.status-code
                                        sc >= 200 && sc < 300 -> {
                                            print('noNpm: published ' - pkg-name - '@' - pkg-ver)
                                            ok = true
                                        }

                                        -> {
                                            print('error: publish failed: status ' - sc.to-str())
                                        }
                                    }

                                    -> {
                                        print('error: publish failed')
                                    }
                                }
                            }

                            nil -> {
                            }

                            err -> {
                            }
                        }
                    }

                    nil -> {
                    }

                    err -> {
                    }
                }
            }

            nil -> {
            }

            err -> {
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-arr-str-at — helper: get string from json array element
; arr json — json array
; idx i64 — index
; returns s str — string value (empty if not found)
; ═══════════════════════════════════════════════

get-arr-str-at = (arr json, idx i64) (s str) {
    s = ''
    entry = json.arr-get(arr, idx)
    entry: {
        ok -> {
            s, ok = json.str(it)
        }

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; get-publish-files — get list of files to publish
; dir str — package root directory
; returns files str — newline-separated file list
; ═══════════════════════════════════════════════

get-publish-files = (dir str) (files str) {
    files = ''

    ; read "files" field from package.json
    pkg-path = dir - '/package.json'
    p = path {
        p: pkg-path
    }
    p.exists() -> {
        result = fs.read-str(pkg-path)
        result: {
            ok -> content = it

            nil -> content = ''

            err -> content = ''
        }
        v = json.parse(content)
        v: {
            ok -> {
                files-arr = it.get('files')
                files-arr: {
                    ok -> {
                        n = it.arr-len()
                        i = 0
                        (i < n) {
                            i >= n -> break
                            pat = get-arr-str-at(it, i)
                            files = files - pat - '\n'

                            #{overflow=wrap}
                            i = i + 1
                        }
                    }

                    nil -> {
                    }

                    err -> {
                    }
                }
            }

            nil -> {
            }

            err -> {
            }
        }
    }
}
