; installer.no — package installation and node_modules management for noNpm
;
; Implements the pnpm installation workflow:
; - Resolve all dependencies from package.json
; - Download and extract packages to virtual store
; - Create symlinks in node_modules
; - Link peer dependencies
; - Create bin links
;
; API:
;   install(cfg config, dir str) (ok bool) — full install from package.json
;   install-pkg(cfg config, name str, range str, dir str) (ok bool) — install single package
;   add(cfg config, name str, range str, dir str, dev bool) (ok bool) — add dependency
;   remove(cfg config, name str, dir str) (ok bool) — remove dependency
;   prune(cfg config, dir str) (ok bool) — remove extraneous packages

# /nonpm/src/utils
# /nonpm/src/pj
# /nonpm/src/semver
# /nonpm/src/registry
# /nonpm/src/resolver
# /nonpm/src/tarball
# /nonpm/src/linker
# /nonpm/src/lockfile

; ═══════════════════════════════════════════════
; install — full installation from package.json
; cfg config — configuration
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

install = (cfg config, dir str) (ok bool) {
    ok = false
    print('noNpm: resolving dependencies...')

    ; resolve all dependencies
    graph-opt = resolver.resolve-project(cfg, dir)
    graph dep-graph
    resolve-ok = false
    graph-opt: {
        ok -> {
            graph = graph-opt
            resolve-ok = true
        }

        -> {
        }
    }
    ! resolve-ok -> {
        print('error: failed to resolve dependencies')
        return
    }

    print('noNpm: resolved ' - graph.node-count.to-str() - ' packages')

    ; set up virtual store
    store-dir = cfg.store-dir
    store-dir.len() == 0 -> {
        home = os.get-env('HOME')
        store-dir = home - '/.nonpm/store'
    }
    nm-dir = dir - '/node_modules'
    virtual-store = nm-dir - '/.nonpm'

    ; ensure directories exist
    p = path {
        p: store-dir
    }
    p.make-dir()
    vp = path {
        p: virtual-store
    }
    vp.make-dir()
    nmp = path {
        p: nm-dir
    }
    nmp.make-dir()

    ; check if lockfile exists and is valid
    lock-ok = lockfile.check-valid(cfg, dir, graph)
    lock-ok -> {
        print('noNpm: lockfile is up to date')
    }

    ; download + extract + link + 累積 lockfile 全部在「同一個」迴圈內完成。
    ; NOTE: Nolang 編譯器對「含 slice 欄位的結構按值拷貝」(dep-node 含
    ; deps []dep-node) 在第二次 slice 遍歷時會產生壞拷貝（字段被清零），因此
    ; graph.nodes 只能在一次迴圈內讀取；lockfile 內容直接在此次迴圈累積，
    ; 避免結尾再次遍歷 graph.nodes。
    n = graph.node-count
    lf-lock = 'lockfileVersion: 9.0\n\n'
    lf-deps-sec = ''
    lf-dev-sec = ''
    lf-pkgs-sec = ''
    lf-has-prod = false
    lf-has-dev = false
    i <- [0..n): {
        node = graph.nodes[i]

        ; 拷貝標量欄位到局部變數（node 是 struct-with-slice 的值拷貝，局部
        ; 副本在當次迴圈內穩定）
        nm = node.name
        vr = node.version
        rs = node.resolved
        ig = node.integrity
        dp = node.depth
        dv = node.is-dev

        print('  ' - nm - '@' - vr)

        ; download and extract to virtual store
        pkg-store-path = linker.package-dir(virtual-store, nm, vr)
        pkg-exists = fs.is-dir(pkg-store-path)
        ! pkg-exists -> {
            dl-ok = tarball.download-and-extract(rs, pkg-store-path)
            ! dl-ok -> {
                print('error: failed to download ' - nm)
                ok = false
                return
            }
        }

        ; link to top-level node_modules
        linker.link-package(virtual-store, nm, vr, nm-dir)

        ; create bin links
        bin-dir = nm-dir - '/.bin'
        linker.create-bin-links(virtual-store, nm, vr, bin-dir)

        ; link package dependencies
        vmeta = registry.fetch-version(cfg, nm, vr)
        vmeta: {
            ok -> {
                deps = registry.get-deps(it)
                deps.len() > 0 -> {
                    linker.link-deps(virtual-store, nm, vr, deps)
                }
            }

            nil -> {
            }

            err -> {
            }
        }

        ; ── lockfile 累積（graph.nodes 唯一可靠的一次遍歷內完成）──
        dp == 1 && dv == false -> {
            lf-has-prod = true
            lf-deps-sec = lf-deps-sec - '  ' - nm - ':\n    version: ' - vr - '\n    resolved: ' - rs - '\n    integrity: ' - ig - '\n'
        }
        dp == 1 && dv == true -> {
            lf-has-dev = true
            lf-dev-sec = lf-dev-sec - '  ' - nm - ':\n    version: ' - vr - '\n    resolved: ' - rs - '\n    integrity: ' - ig - '\n'
        }
        lf-pkgs-sec = lf-pkgs-sec - '  ' - nm - '@' - vr - ':\n'
        rs != '' -> lf-pkgs-sec = lf-pkgs-sec - '    resolution: {integrity: ' - ig - ', tarball: ' - rs - '}\n'
        rs == '' && ig != '' -> lf-pkgs-sec = lf-pkgs-sec - '    resolution: {integrity: ' - ig - '}\n'
    }

    ; 組裝並寫入 lockfile（不再遍歷 graph.nodes）
    lf-lock = lf-lock - 'dependencies:\n'
    lf-has-prod -> lf-lock = lf-lock - lf-deps-sec
    lf-has-prod == false -> lf-lock = lf-lock - '  {}\n'
    lf-has-dev -> {
        lf-lock = lf-lock - '\ndevDependencies:\n'
        lf-lock = lf-lock - lf-dev-sec
    }
    lf-lock = lf-lock - '\npackages:\n'
    lf-lock = lf-lock - lf-pkgs-sec
    utils.write-file(dir - '/pnpm-lock.yaml', lf-lock)

    print('noNpm: installation complete')
    ok = true
}

; ═══════════════════════════════════════════════
; install-pkg — install a single package
; cfg config — configuration
; name str — package name
; range str — version range
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

install-pkg = (cfg config, name str, range-str str, dir str) (ok bool) {
    ok = false
    print('noNpm: resolving ' - name - '@' - range-str - '...')

    ; resolve version
    ver = ''
    resolved = resolver.resolve-pkg(cfg, name, range-str)
    resolved: {
        ok -> ver = it

        nil -> {
            print('error: could not resolve ' - name - '@' - range-str)
            return
        }

        err -> {
            print('error: could not resolve ' - name - '@' - range-str)
            return
        }
    }

    ; fetch version metadata
    vmeta = registry.fetch-version(cfg, name, ver)
    vmeta: {
        ok -> {
            url, integrity, dist-ok = registry.get-dist-info(it)
            ! dist-ok -> {
                print('error: could not get dist info for ' - name)
                return
            }

            ; set up directories
            nm-dir = dir - '/node_modules'
            virtual-store = nm-dir - '/.nonpm'
            p = path {
                p: nm-dir
            }
            p.make-dir()
            vp = path {
                p: virtual-store
            }
            vp.make-dir()

            ; download and extract
            pkg-store-path = linker.package-dir(virtual-store, name, ver)
            pkg-exists = fs.is-dir(pkg-store-path)
            ! pkg-exists -> {
                print('noNpm: downloading ' - name - '@' - ver - '...')
                dl-ok = tarball.download-and-extract(url, pkg-store-path)
                ! dl-ok -> {
                    print('error: failed to download ' - name)
                    return
                }
            }

            ; create symlink
            linker.link-package(virtual-store, name, ver, nm-dir)

            ; create bin links
            bin-dir = nm-dir - '/.bin'
            linker.create-bin-links(virtual-store, name, ver, bin-dir)

            ; link dependencies
            deps = registry.get-deps(it)
            deps.len() > 0 -> {
                linker.link-deps(virtual-store, name, ver, deps)
            }

            print('noNpm: installed ' - name - '@' - ver)
            ok = true
        }

        nil -> {
            print('error: package ' - name - '@' - ver - ' not found')
        }

        err -> {
            print('error: ' - it)
        }
    }
}

; ═══════════════════════════════════════════════
; add — add a dependency to package.json and install
; cfg config — configuration
; name str — package name
; range str — version range
; dir str — project root directory
; dev bool — true if dev dependency
; returns ok bool — true on success
; ═══════════════════════════════════════════════

add = (cfg config, name str, range-str str, dir str, dev bool) (ok bool) {
    ok = false

    ; resolve version
    ver = ''
    resolved = resolver.resolve-pkg(cfg, name, range-str)
    resolved: {
        ok -> ver = it

        nil -> {
            print('error: could not resolve ' - name - '@' - range-str)
            return
        }

        err -> {
            print('error: could not resolve ' - name - '@' - range-str)
            return
        }
    }

    ; update package.json first（so the subsequent re-resolve includes the new dep）
    pkg-path = dir - '/package.json'
    p = path {
        p: pkg-path
    }
    p.exists() -> {
        result = fs.read-str(pkg-path)
        content = ''
        result: {
            ok -> content = it

            -> content = ''
        }

        ; determine save version
        save-ver = range-str
        range-str == '' -> {

            save-ver = cfg.save-prefix - ver
            cfg.save-exact -> save-ver = ver
        }

        ; set dependency in package.json
        dep-key = 'dependencies'
        dev -> dep-key = 'devDependencies'
        updated ?str = pj.set-dep(content, dep-key, name, save-ver)
        updated: {
            ok -> utils.write-file(pkg-path, it)

            -> print('warn: could not update package.json')
        }
    }

    ; resolve full project graph and build lockfile content in ONE pass,
    ; BEFORE any heavy op（install-pkg 的下载/解壓會觸發分配器狀態變化，
    ; 導致之後再讀 graph.nodes 時 struct-with-slice 按值拷貝壞掉；故必須在
    ; 重分配前的「第一次」遍歷內抓取值，之後再安裝、最後寫入）。
    ; NOTE: 必須在「本函式內」直接遍歷 graph.nodes（inline），不可把
    ; graph.nodes 當引數傳給另一個函式——Nolang 編譯器對「含 slice 欄位的
    ; 結構 slice 作為函式引數傳遞」也會觸發壞拷貝。
    graph-opt = resolver.resolve-project(cfg, dir)
    graph dep-graph
    g-ok = false
    graph-opt: {
        ok -> {
            graph = graph-opt
            g-ok = true
        }

        -> {
        }
    }
    lf-ready = false
    lf-lock = ''
    g-ok -> {
        lf-deps-sec = ''
        lf-dev-sec = ''
        lf-pkgs-sec = ''
        lf-has-prod = false
        lf-has-dev = false
        n = graph.node-count
        i <- [0..n): {
            node = graph.nodes[i]
            nm = node.name
            vr = node.version
            rs = node.resolved
            ig = node.integrity
            dp = node.depth
            dv = node.is-dev
            dp == 1 && dv == false -> {
                lf-has-prod = true
                lf-deps-sec = lf-deps-sec - '  ' - nm - ':\n    version: ' - vr - '\n    resolved: ' - rs - '\n    integrity: ' - ig - '\n'
            }
            dp == 1 && dv == true -> {
                lf-has-dev = true
                lf-dev-sec = lf-dev-sec - '  ' - nm - ':\n    version: ' - vr - '\n    resolved: ' - rs - '\n    integrity: ' - ig - '\n'
            }
            lf-pkgs-sec = lf-pkgs-sec - '  ' - nm - '@' - vr - ':\n'
            rs != '' -> lf-pkgs-sec = lf-pkgs-sec - '    resolution: {integrity: ' - ig - ', tarball: ' - rs - '}\n'
            rs == '' && ig != '' -> lf-pkgs-sec = lf-pkgs-sec - '    resolution: {integrity: ' - ig - '}\n'
        }
        lf-lock = 'lockfileVersion: 9.0\n\n'
        lf-lock = lf-lock - 'dependencies:\n'
        lf-has-prod -> lf-lock = lf-lock - lf-deps-sec
        lf-has-prod == false -> lf-lock = lf-lock - '  {}\n'
        lf-has-dev -> {
            lf-lock = lf-lock - '\ndevDependencies:\n'
            lf-lock = lf-lock - lf-dev-sec
        }
        lf-lock = lf-lock - '\npackages:\n'
        lf-lock = lf-lock - lf-pkgs-sec
        lf-ready = true
    }

    ; install the package (heavy ops AFTER lockfile data capture)
    install-ok = install-pkg(cfg, name, range-str, dir)
    ! install-ok -> return

    ; write lockfile（局部字串寫入，重分配後仍安全）
    lf-ready -> utils.write-file(dir - '/pnpm-lock.yaml', lf-lock)

    ok = true
}

; ═══════════════════════════════════════════════
; remove — remove a dependency from package.json and node_modules
; cfg config — configuration
; name str — package name
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; remove-dep — remove a dependency from package.json and node_modules
; cfg config — configuration
; name str — package name
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

remove-dep = (cfg config, name str, dir str) (ok bool) {
    ok = false

    ; remove from package.json using sed
    ; this avoids json pool copy issues with json.get/delete-key
    pkg-path = dir - '/package.json'
    p = path {
        p: pkg-path
    }
    p.exists() -> {

        ; use sed to remove the dependency key from JSON
        ; handles: "name":"value" with optional trailing comma, then cleans a dangling `,}`
        ; -E 用 ERE（`?`/`+` 才有效）；sed 程式以單引號包住，路徑與 name 串接
        sed-cmd = 'sed -i \'\' -E \'s/[[:space:]]*"' - name - '"[[:space:]]*:[[:space:]]*"[^"]*",?//g; s/,([[:space:]]*})/\1/g\' ' - pkg-path
        process.process-system(sed-cmd)
    }

    ; remove symlink from node_modules
    nm-dir = dir - '/node_modules'
    link-path = nm-dir - '/' - name
    fs.is-file(link-path) -> fs.remove(link-path)
    fs.is-dir(link-path) -> process.process-system('rm -rf ' - link-path)

    print('noNpm: removed ' - name)
    ok = true
}

; ═══════════════════════════════════════════════
; prune — remove extraneous packages not in lockfile
; cfg config — configuration
; dir str — project root directory
; returns ok bool — true on success
; ═══════════════════════════════════════════════

prune = (cfg config, dir str) (ok bool) {
    ok = true
    virtual-store = dir - '/node_modules/.nonpm'
    p = path {
        p: virtual-store
    }
    p.exists() -> {

        ; read lockfile to know which packages should exist
        graph-opt = resolver.resolve-project(cfg, dir)
        graph dep-graph
        resolve-ok bool = false
        graph-opt: {
            ok -> {
                graph = graph-opt
                resolve-ok = true
            }

            -> {
            }
        }
        resolve-ok -> {
            ; TODO: scan virtual store and remove packages not in graph
        }
    }
    print('noNpm: pruned extraneous packages')
}
