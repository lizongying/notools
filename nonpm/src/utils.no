; utils.no — utility functions for noNpm
;
; Provides helpers for string manipulation, file I/O, path handling,
; and process execution used across all noNpm modules.

; ═══════════════════════════════════════════════
; String utilities
; ═══════════════════════════════════════════════

; trim — remove leading and trailing whitespace
; s str — input string
; returns out str — trimmed string
trim = (s str) (out str) {
    out = s.trim()
}

; split — split string by separator into []str
; s str — input string
; sep str — separator
; returns parts []str — split parts
split = (s str, sep str) (parts []str) {
    parts = s.split(sep)
}

; join — join []str with separator
; parts []str — parts to join
; sep str — separator
; returns out str — joined string
join = (parts []str, sep str) (out str) {
    out = parts.join(sep)
}

; starts-with is removed — use s.starts-with(prefix) str method directly

; ends-with — check if string ends with suffix
; s str — input string
; suffix str — suffix to check
; returns ok bool — true if ends with suffix
ends-with = (s str, suffix str) (ok bool) {
    ok = s.ends-with(suffix)
}

; contains — check if string contains substring
; s str — input string
; sub str — substring to check
; returns ok bool — true if contains
contains = (s str, sub str) (ok bool) {
    ok = s.contains(sub)
}

; index-of — find position of substring
; s str — input string
; sub str — substring to find
; returns pos i64 — position (-1 if not found)
index-of = (s str, sub str) (pos i64) {
    pos = s.index(sub)
}

; slice is removed — use s.slice(start, end) str method directly

; replace — replace all occurrences of old with new
; s str — input string
; old str — old substring
; new str — new substring
; returns out str — result string
replace = (s str, old-str str, new-str str) (out str) {
    out = ''
    i = 0
    old-len = old-str.len
    {
        i > s.len -> break
        i <= s.len - old-len -> {
            sub = s.slice(i, i + old-len)
            sub == old-str -> {
                out = out - new-str
                i = i + old-len
            }
            -> {
                ch = s.slice(i, i + 1)
                out = out - ch
                i = i + 1
            }
        }
        -> {
            ch = s.slice(i, i + 1)
            out = out - ch
            i = i + 1
        }
    } (true)
}

; to-lower — convert string to lowercase
; s str — input string
; returns out str — lowercase string
to-lower = (s str) (out str) {
    out = s.to-lower()
}

; to-upper — convert string to uppercase
; s str — input string
; returns out str — uppercase string
to-upper = (s str) (out str) {
    out = s.to-upper()
}

; ═══════════════════════════════════════════════
; File I/O utilities
; ═══════════════════════════════════════════════

; read-file — read entire file content as string
; path str — file path
; returns content str — file content
read-file = (path str) (content str) {
    content = ''
    result = fs.read-str(path)
    result: {
        ok -> content = it
        nil -> {}
        err -> {}
    }
}

; write-file — write string content to file
; path str — file path
; data str — content to write
; returns ok bool — true on success
write-file = (path str, data str) (ok bool) {
    ok = false
    fd = fs.open-write(path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, data, data.len)
            fs.close(fd)
            ok = true
        }
    }
}

; read-json-file — read and parse JSON file
; path str — file path
; returns val ?json — parsed JSON value (nil=not found, err=parse error)
read-json-file = (path str) (val ?json) {
    p = path{
        p: path,
    }
    p.exists() -> {
        result = fs.read-str(path)
        result: {
            ok -> val = json.parse(it)
            nil -> val = nil
            err -> val = nil
        }
    }
    -> {
        val = nil
    }
}

; write-json-file — write JSON value to file with pretty printing
; path str — file path
; val json — JSON value to write
; returns ok bool — true on success
write-json-file = (path str, val json) (ok bool) {
    ok = false
    ; NOTE: json.stringify with str buffer causes LLVM type mismatch (str-long vs vec)
    ; This is a Nolang compiler bug tracked separately.
}

; file-exists — check if file exists
; path str — file path
; returns ok bool — true if exists
file-exists = (path str) (ok bool) {
    p = path{
        p: path,
    }
    ok = p.exists()
}

; is-dir — check if path is a directory
; path str — path to check
; returns ok bool — true if directory
is-dir = (path str) (ok bool) {
    ok = fs.is-dir(path)
}

; is-file — check if path is a file
; path str — path to check
; returns ok bool — true if file
is-file = (path str) (ok bool) {
    ok = fs.is-file(path)
}

; mkdir-p — create directory recursively
; path str — directory path
; returns ok bool — true on success
mkdir-p = (path str) (ok bool) {
    p = path{
        p: path,
    }
    ok = p.make-dir()
}

; rm-rf — remove directory recursively
; path str — path to remove
rm-rf = (path str) {
    process.process-system('rm -rf ' - path)
}

; cp-r — copy directory recursively
; src str — source path
; dst str — destination path
cp-r = (src str, dst str) {
    process.process-system('cp -r ' - src - ' ' - dst)
}

; ═══════════════════════════════════════════════
; Path utilities
; ═══════════════════════════════════════════════

; path-join — join path components
; base str — base path
; sub str — sub path
; returns out str — joined path
path-join = (base str, sub str) (out str) {
    p = path{
        p: base,
    }
    p.join(sub)
    out = p.p
}

; path-dir — get directory of a path
; p str — file path
; returns out str — directory path
path-dir = (p str) (out str) {
    pp = path{
        p: p,
    }
    pp.dir()
    out = pp.p
}

; path-base — get filename from path
; p str — file path
; returns out str — filename
path-base = (p str) (out str) {
    pp = path{
        p: p,
    }
    out = pp.base()
}

; path-ext — get file extension
; p str — file path
; returns out str — extension (without dot)
path-ext = (p str) (out str) {
    pp = path{
        p: p,
    }
    out = pp.ext()
}

; ═══════════════════════════════════════════════
; Process utilities
; ═══════════════════════════════════════════════

; run-cmd — execute shell command, return exit code
; cmd str — command to execute
; returns code i64 — exit code (raw wait status from system())
run-cmd = (cmd str) (code i64) {
    code = process.process-system(cmd)
}

; run-cmd-output — execute command, return stdout
; cmd str — command to execute
; returns out str — stdout output
run-cmd-output = (cmd str) (out str) {
    out = ''
    tmp = '/tmp/nonpm-out-' - os.now-ms().to-str()
    full-cmd = cmd - ' > ' - tmp - ' 2>/dev/null'
    process.process-system(full-cmd)
    result = fs.read-str(tmp)
    result: {
        ok -> out = it
        nil -> out = ''
        err -> out = ''
    }
    fs.remove(tmp)
}

; chmod — make file executable
; path str — file path
; mode str — permission mode (e.g. '755')
chmod = (path str, mode str) {
    process.process-system('chmod ' - mode - ' ' - path)
}

; ═══════════════════════════════════════════════
; Time utilities
; ═══════════════════════════════════════════════

; now-ms — current time in milliseconds
; returns ms i64 — milliseconds since epoch
now-ms = () (ms i64) {
    ms = os.now-ms()
}

; now-s — current time in seconds
; returns sec i64 — seconds since epoch
now-s = () (sec i64) {
    sec = os.now()
}

; ═══════════════════════════════════════════════
; Hash utilities
; ═══════════════════════════════════════════════

; sha1-hex — compute SHA-1 hash, return hex string
; data str — input data
; returns hex str — 40-char hex string
sha1-hex = (data str) (hex str) {
    b = data.to-bytes()
    hex = sha1.sha1-hex(b)
}

; sha256-hex — compute SHA-256 hash, return hex string
; data str — input data
; returns hex str — 64-char hex string
sha256-hex = (data str) (hex str) {
    b = data.to-bytes()
    hex = sha256.sha256-hex(b)
}

; ═══════════════════════════════════════════════
; Array utilities
; ═══════════════════════════════════════════════

; arr-contains — check if []str contains a value
; arr []str — array to search
; val str — value to find
; returns ok bool — true if found
arr-contains = (arr []str, val str) (ok bool) {
    ok = false
    n = arr.len
    i <- [0..n): {
        arr[i] == val -> {
            ok = true
            break
        }
    }
}

; arr-join — join []str with separator (alias for join)
; arr []str — array to join
; sep str — separator
; returns out str — joined string
arr-join = (arr []str, sep str) (out str) {
    out = join(arr, sep)
}

; ═══════════════════════════════════════════════
; Format utilities
; ═══════════════════════════════════════════════

; i64-to-str — convert integer to string
; n i64 — integer value
; returns s str — string representation
i64-to-str = (n i64) (s str) {
    s = n.to-str()
}

; str-to-i64 — parse string to integer
; s str — string to parse
; returns n ?i64 — parsed integer (nil=empty, err=invalid)
str-to-i64 = (s str) (n ?i64) {
    n = s.to-i64()
}
