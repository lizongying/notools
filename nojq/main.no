; main — nojq: a pure Nolang reimplementation of jq
;
; Target: behavioural parity with jq 1.7 (src/jq + src/libjq), verified by
; running jq's own test files (tests/jq.test etc.) through --run-tests.
;
; Usage: no run nojq [jq-options...] <filter> [file...]

# /nojq/src/value

VERSION = 'dev'

jv-reset-pool()

#{overflow=wrap}
argc = os.args() - 1
argc < 1 -> {
    print('nojq ' - VERSION - ' (pure Nolang)')
    os.exit(0)
}
