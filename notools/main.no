// main.no — Unix utilities dispatcher
// Entry point: routes subcommands to utility implementations
// Usage: no run main.no <command> [args]

# /src/echo.echo-run
# /src/cat.cat-run
# /src/ls.ls-run
# /src/rm.rm-run
# /src/tree.tree-run
# /src/mv.mv-run
# /src/touch.touch-run
# /src/find.find-run
# /src/grep.grep-run
# /src/wc.wc-run
# /src/sort.sort-run
# /src/uniq.uniq-run
# /src/sed.sed-run
# /src/awk.awk-run
# /src/chmod.chmod-run
# /src/tar.tar-run
# /src/zip.zip-run
# /src/unzip.unzip-run
# /src/ps.ps-run
# /src/top.top-run
# /src/mkdir.mkdir-run
# /src/stat.stat-run
# /src/chown.chown-run
# /src/cp.cp-run
# /src/head.head-run
# /src/tail.tail-run
# /src/date.date-run
# /src/pwd.pwd-run
# /src/du.du-run
# /src/df.df-run
# /src/ln.ln-run
# /src/cut.cut-run
# /src/tr.tr-run
# /src/tee.tee-run
# /src/sleep.sleep-run
# /src/whoami.whoami-run
# /src/curl.curl-run
# /src/ping.ping-run
// 哈希/编码命令。注意：编译器不解析传递导入（A 导 B、B 导 C 时
// 入口必须显式导入 C），故底层 *x 实现与 hashutil 也要在此导入
# /src/md5x.md5x
# /src/sha224x.sha224x
# /src/sha384x.sha384x
# /src/hashutil.hash-cmd
# /src/hashutil.bytes-to-hex
# /src/md5.md5-run
# /src/sha1.sha1-run
# /src/sha224.sha224-run
# /src/sha256.sha256-run
# /src/sha384.sha384-run
# /src/sha512.sha512-run
# /src/base64.base64-run
# /src/hmac.hmac-run

print-usage = () {
    print('Usage: notools <command> [args]')
    print('')
    print('Commands:')
    print('  echo    Print arguments to stdout')
    print('  cat     Concatenate and print file contents')
    print('  ls      List directory contents')
    print('  rm      Remove files or directories')
    print('  tree    Display directory tree')
    print('  mv      Move or rename files')
    print('  touch   Create empty files or update timestamps')
    print('  find    Recursively search for files')
    print('  grep    Search for patterns in files')
    print('  wc      Count lines, words, and bytes')
    print('  sort    Sort lines alphabetically')
    print('  uniq    Remove duplicate consecutive lines')
    print('  sed     Stream editor for text replacement')
    print('  awk     Pattern scanning and field extraction')
    print('  chmod   Change file permissions')
    print('  tar     Create and extract tar archives')
    print('  zip     Create zip archives')
    print('  unzip   Extract zip archives')
    print('  ps      List running processes')
    print('  top     Display system processes')
    print('  mkdir   Create directories')
    print('  stat    Display file status')
    print('  chown   Change file owner and group')
    print('  cp      Copy files and directories')
    print('  head    Output the first part of files')
    print('  tail    Output the last part of files')
    print('  date    Display the system date')
    print('  pwd     Print the current working directory')
    print('  du      Estimate file space usage')
    print('  df      Report disk space usage')
    print('  ln      Make links between files')
    print('  cut     Remove sections from each line')
    print('  tr      Translate or delete characters')
    print('  tee     Read stdin and write to stdout and files')
    print('  sleep   Delay for a specified time')
    print('  whoami  Print the effective user name')
    print('  curl    Transfer a URL (pure-Nolang HTTP/1.1 client over net)')
    print('  ping    Send ICMP echo requests (pure-Nolang, built-in net.ping)')
    print('  md5     Compute MD5 message digest')
    print('  sha1    Compute SHA-1 message digest')
    print('  sha224  Compute SHA-224 message digest')
    print('  sha256  Compute SHA-256 message digest')
    print('  sha384  Compute SHA-384 message digest')
    print('  sha512  Compute SHA-512 message digest')
    print('  base64  Base64 encode/decode (-d to decode)')
    print('  hmac    HMAC keyed digest (-a md5|sha1|sha256|sha512, -k key)')
}

argc = args()

{
    argc < 2 -> {
        print-usage()
        os.exit(1)
    }
}

cmd = arg(1)

{
    cmd == 'echo' -> echo.echo-run()
    cmd == 'cat' -> cat.cat-run()
    cmd == 'ls' -> ls.ls-run()
    cmd == 'rm' -> rm.rm-run()
    cmd == 'tree' -> tree.tree-run()
    cmd == 'mv' -> mv.mv-run()
    cmd == 'touch' -> touch.touch-run()
    cmd == 'find' -> find.find-run()
    cmd == 'grep' -> grep.grep-run()
    cmd == 'wc' -> wc.wc-run()
    cmd == 'sort' -> sort.sort-run()
    cmd == 'uniq' -> uniq.uniq-run()
    cmd == 'sed' -> sed.sed-run()
    cmd == 'awk' -> awk.awk-run()
    cmd == 'chmod' -> chmod.chmod-run()
    cmd == 'tar' -> tar.tar-run()
    cmd == 'zip' -> zip.zip-run()
    cmd == 'unzip' -> unzip.unzip-run()
    cmd == 'ps' -> ps.ps-run()
    cmd == 'top' -> top.top-run()
    cmd == 'mkdir' -> mkdir.mkdir-run()
    cmd == 'stat' -> stat.stat-run()
    cmd == 'chown' -> chown.chown-run()
    cmd == 'cp' -> cp.cp-run()
    cmd == 'head' -> head.head-run()
    cmd == 'tail' -> tail.tail-run()
    cmd == 'date' -> date.date-run()
    cmd == 'pwd' -> pwd.pwd-run()
    cmd == 'du' -> du.du-run()
    cmd == 'df' -> df.df-run()
    cmd == 'ln' -> ln.ln-run()
    cmd == 'cut' -> cut.cut-run()
    cmd == 'tr' -> tr.tr-run()
    cmd == 'tee' -> tee.tee-run()
    cmd == 'sleep' -> sleep.sleep-run()
    cmd == 'whoami' -> whoami.whoami-run()
    cmd == 'curl' -> curl.curl-run()
    cmd == 'ping' -> ping.ping-run()
    cmd == 'md5' -> md5-run()
    cmd == 'sha1' -> sha1-run()
    cmd == 'sha224' -> sha224-run()
    cmd == 'sha256' -> sha256-run()
    cmd == 'sha384' -> sha384-run()
    cmd == 'sha512' -> sha512-run()
    cmd == 'base64' -> base64-run()
    cmd == 'hmac' -> hmac-run()
    -> {
        print('Unknown command: ' - cmd)
        print-usage()
        os.exit(1)
    }
}