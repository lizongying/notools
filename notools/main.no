    cmd == 'uuencode' -> uuencode.uuencode-run()
    cmd == 'uudecode' -> uudecode.uudecode-run()
    cmd == 'uuidgen' -> uuidgen.uuidgen-run()
    cmd == 'uuidparse' -> uuidparse.uuidparse-run()
    cmd == 'mcookie' -> mcookie.mcookie-run()
    cmd == 'md5sum' -> md5sum.md5sum-run()
    cmd == 'sha1sum' -> sha1sum.sha1sum-run()
    cmd == 'sha256sum' -> sha256sum.sha256sum-run()
    cmd == 'sha512sum' -> sha512sum.sha512sum-run()
    cmd == 'link' -> link.link-run()
    cmd == 'unlink' -> unlink.unlink-run()
    cmd == 'install' -> install.install-run()
    cmd == 'rmdir' -> rmdir.rmdir-run()
    cmd == 'truncate' -> truncate-cmd.truncate-run()
    cmd == 'sync' -> sync-cmd.sync-run()
    cmd == 'mknod' -> mknod.mknod-run()
    cmd == 'pathchk' -> pathchk.pathchk-run()
    cmd == 'dir' -> dir-cmd.dir-run()
    cmd == 'vdir' -> vdir.vdir-run()
    cmd == 'dircolors' -> dircolors.dircolors-run()
    cmd == 'namei' -> namei.namei-run()
    cmd == 'logname' -> logname.logname-run()
    cmd == 'hostid' -> hostid.hostid-run()
    cmd == 'domainname' -> domainname.domainname-run()
    cmd == 'logger' -> logger.logger-run()
    cmd == 'nice' -> nice.nice()
    cmd == 'renice' -> renice.renice()
    cmd == 'watch' -> watch.watch()
    cmd == 'time' -> time-cmd.time-run()
    cmd == 'setsid' -> setsid.setsid-run()
    cmd == 'flock' -> flock-cmd.flock-run()
    cmd == 'test' -> test-cmd.test-run()
    cmd == '[' -> lbracket.lbracket()
    cmd == 'getopt' -> getopt.getopt()
    cmd == 'reset' -> reset.reset()
    cmd == 'locale' -> locale.locale()
    cmd == 'envsubst' -> envsubst.envsubst()
    cmd == 'egrep' -> egrep.egrep()
    cmd == 'fgrep' -> fgrep.fgrep()
    cmd == 'chgrp' -> chgrp.chgrp()
    cmd == 'strings' -> strings.strings()
    cmd == 'more' -> more.more()
    cmd == 'gzip' -> gzip.gzip-cmd()
    cmd == 'gunzip' -> gunzip.gunzip()
    cmd == 'zcat' -> zcat.zcat()
    cmd == 'free' -> free.free-cmd()
    cmd == 'lscpu' -> lscpu.lscpu()
    cmd == 'dmesg' -> dmesg.dmesg()
    cmd == 'patch' -> patch.patch-cmd()
    cmd == 'diff3' -> diff3.diff3()
    cmd == 'sha224sum' -> sha224sum.sha224sum-run()
    cmd == 'sha384sum' -> sha384sum.sha384sum-run()
    cmd == 'b2sum' -> b2sum.b2sum-run()
    cmd == 'bzip2' -> bzip2.bzip2-cmd()
    cmd == 'bunzip2' -> bunzip2.bunzip2-cmd()
    cmd == 'bzcat' -> bzcat.bzcat-cmd()
    cmd == 'xz' -> xz.xz-cmd()
    cmd == 'unxz' -> unxz.unxz-cmd()
    cmd == 'xzcat' -> xzcat.xzcat-cmd()
    cmd == 'lzma' -> lzma.lzma-cmd()
    cmd == 'unlzma' -> unlzma.unlzma-cmd()
    cmd == 'lzcat' -> lzcat.lzcat-cmd()
    cmd == 'zstd' -> zstd.zstd-cmd()
    cmd == 'unzstd' -> unzstd.unzstd-cmd()
    cmd == 'zstdcat' -> zstdcat.zstdcat-cmd()
    cmd == 'compress' -> compress.compress-cmd()
    cmd == 'uncompress' -> uncompress.uncompress-cmd()
    cmd == 'less' -> less.less-cmd()
    cmd == 'stty' -> stty.stty-cmd()
    cmd == 'chroot' -> chroot.chroot-cmd()
    cmd == 'stdbuf' -> stdbuf.stdbuf-cmd()
    cmd == 'who' -> who.who-cmd()
    cmd == 'users' -> users.users-cmd()
    cmd == 'pinky' -> pinky.pinky-cmd()
    cmd == 'locate' -> locate.locate-run()
    cmd == 'updatedb' -> updatedb.updatedb-run()
    cmd == 'ptx' -> ptx.ptx-run()
    -> {
        print('Unknown command: ' - cmd)
        print-usage()
        os.exit(1)
    }
}
