print-usage = () {
    print('Usage: notools <command> [args]')
    print('')
    print('Commands:')
    print('  echo     Print arguments to stdout')
    print('  cat      Concatenate and print file contents')
    print('  ls       List directory contents')
    print('  rm       Remove files or directories')
    print('  tree     Display directory tree')
    print('  mv       Move or rename files')
    print('  touch    Create empty files or update timestamps')
    print('  find     Recursively search for files')
    print('  grep     Search for patterns in files')
    print('  wc       Count lines, words, and bytes')
    print('  sort     Sort lines alphabetically')
    print('  uniq     Remove duplicate consecutive lines')
    print('  sed      Stream editor for text replacement')
    print('  awk      Pattern scanning and field extraction')
    print('  chmod    Change file permissions')
    print('  tar      Create and extract tar archives')
    print('  zip      Create zip archives')
    print('  unzip    Extract zip archives')
    print('  ps       List running processes')
    print('  top      Display system processes')
    print('  mkdir    Create directories')
    print('  stat     Display file status')
    print('  chown    Change file owner and group')
    print('  cp       Copy files and directories')
    print('  head     Output the first part of files')
    print('  tail     Output the last part of files')
    print('  date     Display the system date')
    print('  pwd      Print the current working directory')
    print('  du       Estimate file space usage')
    print('  df       Report disk space usage')
    print('  ln       Make links between files')
    print('  cut      Remove sections from each line')
    print('  tr       Translate or delete characters')
    print('  tee      Read stdin and write to stdout and files')
    print('  sleep    Delay for a specified time')
    print('  whoami   Print the effective user name')
    print('  curl     Transfer a URL (pure-Nolang HTTP/1.1 client over net)')
    print('  ping     Send ICMP echo requests (pure-Nolang, built-in net.ping)')
    print('  realpath Print resolved absolute path')
    print('  readlink Print target of symbolic link')
    print('  mktemp   Create temporary file or directory')
    print('  tempfile Create temporary file (alias for mktemp)')
    print('  mkfifo   Create named pipes (FIFOs)')
    print('  rename   Batch rename files using sed-style substitution')
    print('  file     Identify file type')
    print('  md5      Compute MD5 message digest')
    print('  sha1     Compute SHA-1 message digest')
    print('  sha224   Compute SHA-224 message digest')
    print('  sha256   Compute SHA-256 message digest')
    print('  sha384   Compute SHA-384 message digest')
    print('  sha512   Compute SHA-512 message digest')
    print('  base64   Base64 encode/decode (-d to decode)')
    print('  --- Text processing ---')
    print('  basename Strip directory and suffix from filenames')
    print('  dirname  Strip last component from file path')
    print('  true     Exit with status 0')
    print('  false    Exit with status 1')
    print('  yes      Repeatedly output a line until killed')
    print('  seq      Print a sequence of numbers')
    print('  tac      Concatenate and print lines in reverse')
    print('  rev      Reverse lines character by character')
    print('  nl       Number lines of files')
    print('  paste    Merge lines of files')
    print('  fold     Wrap input lines to fit in specified width')
    print('  expand   Convert tabs to spaces')
    print('  unexpand Convert spaces to tabs')
    print('  comm     Compare two sorted files line by line')
    print('  join     Join lines of two files on a common field')
    print('  tsort    Topological sort')
    print('  shuf     Generate random permutations')
    print('  factor   Print prime factors')
    print('  expr     Evaluate expressions')
    print('  column   Columnate lists')
    print('  fmt      Reformat paragraph text')
    print('  pr       Convert text files for printing')
    print('  clear    Clear the terminal screen')
    print('  --- Text comparison ---')
    print('  diff     Compare files line by line')
    print('  cmp      Compare two files byte by byte')
    print('  sdiff    Side-by-side merge of two files')
    print('  --- Argument building ---')
    print('  xargs    Build and execute command lines from stdin')
    print('  --- Path lookup ---')
    print('  which    Locate a command in PATH')
    print('  whereis  Locate binary, source, and manual for a command')
    print('  --- System info ---')
    print('  uname    Print system information')
    print('  hostname Print or set system hostname')
    print('  id       Print real and effective user and group IDs')
    print('  groups   Print group IDs')
    print('  env      Run command in modified environment')
    print('  printenv Print environment variables')
    print('  arch     Print machine architecture')
    print('  nproc    Print number of processors')
    print('  getconf  Query system configuration variables')
    print('  tty      Print terminal name')
    print('  uptime   Tell how long the system has been running')
    print('  --- Process control ---')
    print('  kill     Send signals to processes')
    print('  pkill    Signal processes by name')
    print('  killall  Kill processes by name')
    print('  pgrep    List processes by name')
    print('  pidof    Find PID of a running program')
    print('  nohup    Run command ignoring SIGHUP')
    print('  timeout  Run command with time limit')
    print('  --- Encoding/conversion ---')
    print('  od       Dump files in octal/hex')
    print('  xxd      Hexadecimal dump')
    print('  hexdump  ASCII/decimal/hex/octal dump')
    print('  base32   Base32 encode/decode')
    print('  cksum    Print POSIX CRC checksum')
    print('  sum      Print checksum and block count')
    print('  --- Misc ---')
    print('  cal      Display a calendar')
    print('  hmac     HMAC keyed digest (-a md5|sha1|sha256|sha512, -k key)')
}

argc = args()

{
    argc < 2 -> {
        print-usage()
        os.exit(1)
    }
}

cmd = arg(1)

{
    cmd == 'echo' -> echo.echo-run()
    cmd == 'cat' -> cat.cat-run()
    cmd == 'ls' -> ls.ls-run()
    cmd == 'rm' -> rm.rm-run()
    cmd == 'tree' -> tree.tree-run()
    cmd == 'mv' -> mv.mv-run()
    cmd == 'touch' -> touch.touch-run()
    cmd == 'find' -> find.find-run()
    cmd == 'grep' -> grep.grep-run()
    cmd == 'wc' -> wc.wc-run()
    cmd == 'sort' -> sort.sort-run()
    cmd == 'uniq' -> uniq.uniq-run()
    cmd == 'sed' -> sed.sed-run()
    cmd == 'awk' -> awk.awk-run()
    cmd == 'chmod' -> chmod.chmod-run()
    cmd == 'tar' -> tar.tar-run()
    cmd == 'zip' -> zip.zip-run()
    cmd == 'unzip' -> unzip.unzip-run()
    cmd == 'ps' -> ps.ps-run()
    cmd == 'top' -> top.top-run()
    cmd == 'mkdir' -> mkdir.mkdir-run()
    cmd == 'stat' -> stat.stat-run()
    cmd == 'chown' -> chown.chown-run()
    cmd == 'cp' -> cp.cp-run()
    cmd == 'head' -> head.head-run()
    cmd == 'tail' -> tail.tail-run()
    cmd == 'date' -> date.date-run()
    cmd == 'pwd' -> pwd.pwd-run()
    cmd == 'du' -> du.du-run()
    cmd == 'df' -> df.df-run()
    cmd == 'ln' -> ln.ln-run()
    cmd == 'cut' -> cut.cut-run()
    cmd == 'tr' -> tr.tr-run()
    cmd == 'tee' -> tee.tee-run()
    cmd == 'sleep' -> sleep.sleep-run()
    cmd == 'whoami' -> whoami.whoami-run()
    cmd == 'curl' -> curl.curl-run()
    cmd == 'ping' -> ping.ping-run()
    cmd == 'realpath' -> realpath.realpath-run()
    cmd == 'readlink' -> readlink.readlink-run()
    cmd == 'mktemp' -> mktemp.mktemp-run()
    cmd == 'tempfile' -> tempfile.tempfile-run()
    cmd == 'mkfifo' -> mkfifo.mkfifo-run()
    cmd == 'rename' -> rename.rename-run()
    cmd == 'file' -> file.file-run()
    cmd == 'basename' -> basename.basename-run()
    cmd == 'dirname' -> dirname.dirname-run()
    cmd == 'yes' -> yes.yes-run()
    cmd == 'seq' -> seq.seq-run()
    cmd == 'tac' -> tac.tac-run()
    cmd == 'rev' -> rev.rev-run()
    cmd == 'nl' -> nl.nl-run()
    cmd == 'paste' -> paste.paste-run()
    cmd == 'fold' -> fold.fold-run()
    cmd == 'expand' -> expand.expand-run()
    cmd == 'unexpand' -> unexpand.unexpand-run()
    cmd == 'comm' -> comm.comm-run()
    cmd == 'join' -> join.join-run()
    cmd == 'tsort' -> tsort.tsort-run()
    cmd == 'shuf' -> shuf.shuf-run()
    cmd == 'factor' -> factor.factor-run()
    cmd == 'expr' -> expr.expr-run()
    cmd == 'column' -> column.column-run()
    cmd == 'fmt' -> fmt.fmt-run()
    cmd == 'pr' -> pr.pr-run()
    cmd == 'clear' -> clear.clear-run()
    cmd == 'true' -> true-cmd.true-cmd-run()
    cmd == 'false' -> false-cmd.false-cmd-run()
    cmd == 'uname' -> uname.uname-run()
    cmd == 'hostname' -> hostname.hostname-run()
    cmd == 'id' -> id.id-run()
    cmd == 'groups' -> groups.groups-run()
    cmd == 'env' -> env.env-run()
    cmd == 'printenv' -> printenv.printenv-run()
    cmd == 'arch' -> arch.arch-run()
    cmd == 'nproc' -> nproc.nproc-run()
    cmd == 'getconf' -> getconf.getconf-run()
    cmd == 'tty' -> tty.tty-run()
    cmd == 'uptime' -> uptime.uptime-run()
    cmd == 'kill' -> kill.kill-run()
    cmd == 'pkill' -> pkill.pkill-run()
    cmd == 'killall' -> killall.killall-run()
    cmd == 'pgrep' -> pgrep.pgrep-run()
    cmd == 'pidof' -> pidof.pidof-run()
    cmd == 'nohup' -> nohup.nohup-run()
    cmd == 'timeout' -> timeout.timeout-run()
    cmd == 'od' -> od.od-run()
    cmd == 'xxd' -> xxd.xxd-run()
    cmd == 'hexdump' -> hexdump.hexdump-run()
    cmd == 'base32' -> base32.base32-run()
    cmd == 'cksum' -> cksum.cksum-run()
    cmd == 'sum' -> sum.sum-run()
    cmd == 'cal' -> cal.cal-run()
    cmd == 'md5' -> md5-run()
    cmd == 'sha1' -> sha1-run()
    cmd == 'sha224' -> sha224-run()
    cmd == 'sha256' -> sha256-run()
    cmd == 'sha384' -> sha384-run()
    cmd == 'sha512' -> sha512-run()
    cmd == 'base64' -> base64-run()
    cmd == 'hmac' -> hmac-run()
    cmd == 'diff' -> diff.diff-run()
    cmd == 'cmp' -> cmp.cmp-run()
    cmd == 'sdiff' -> sdiff.sdiff-run()
    cmd == 'xargs' -> xargs.xargs-run()
    cmd == 'which' -> which.which-run()
    cmd == 'whereis' -> whereis.whereis-run()
    -> {
        print('Unknown command: ' - cmd)
        print-usage()
        os.exit(1)
    }
}
