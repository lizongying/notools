# /src/md5x.md5x
# /src/sha224x.sha224x
# /src/sha384x.sha384x
# /src/hashutil.hash-cmd
# /src/hashutil.bytes-to-hex
# /src/md5.md5-run
# /src/sha1.sha1-run
# /src/sha224.sha224-run
# /src/sha256.sha256-run
# /src/sha384.sha384-run
# /src/sha512.sha512-run
# /src/base64.base64-run
# /src/hmac.hmac-run
{
    cmd = arg(1)
    {
        cmd == 'md5' -> md5-run()
        cmd == 'sha1' -> sha1-run()
        cmd == 'sha224' -> sha224-run()
        cmd == 'sha256' -> sha256-run()
        cmd == 'sha384' -> sha384-run()
        cmd == 'sha512' -> sha512-run()
        cmd == 'base64' -> base64-run()
        cmd == 'hmac' -> hmac-run()
    }
}
