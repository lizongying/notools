; sha1x: 完整 SHA-1 雜湊，返回 40 字元 hex 字串
sha1x = (data []byte) (hex str) {
    h0 u32 = 1732584193
    h1 u32 = 4023233417
    h2 u32 = 2562383102
    h3 u32 = 271733878
    h4 u32 = 3285377520
    mask u32 = 4294967295
    dlen = data.len()

    #{overflow=wrap}
    bit-len = dlen * 8
    mod-val = (dlen + 9) % 64
    pad-len = 0

    #{overflow=wrap}
    mod-val != 0 -> pad-len = 64 - mod-val

    #{overflow=wrap}
    total-len = dlen + 1 + pad-len + 8
    padded []byte = with-len(total-len)
    i <- [0..total-len): {
        padded[i]: {
            ok -> it = 0
            -> _
        }
    }
    i <- [0..dlen): {
        #{index-out=zero}
        d9v1 byte = data[i]
        padded[i]: {
            ok -> it = d9v1
            -> _
        }
    }
    padded[dlen]: {
        ok -> it = 128
        -> _
    }
    i <- [dlen + 1..total-len - 8): {
        padded[i]: {
            ok -> it = 0
            -> _
        }
    }
    i <- [0..8): {

        #{overflow=wrap}
        padded[total-len - 8 + i]: {
            ok -> it = (bit-len >> (56 - i * 8)) & 255
            -> _
        }
    }
    w []u32 = with-len(80)
    k0 u32 = 1518500249
    k1 u32 = 1859775393
    k2 u32 = 2400959708
    k3 u32 = 3395469782
    offset = 0
    (offset < total-len) {
        i <- [0..16): {

            #{index-out=zero}
            d9v2 byte = padded[offset + i * 4]
            #{index-out=zero}
            d9v3 byte = padded[offset + i * 4 + 1]
            #{index-out=zero}
            d9v4 byte = padded[offset + i * 4 + 2]
            #{index-out=zero}
            d9v5 byte = padded[offset + i * 4 + 3]
            #{overflow=wrap}
            w[i]: {
                ok -> it = (d9v2 << 24) | (d9v3 << 16) | (d9v4 << 8) | d9v5
                -> _
            }
        }
        i <- [16..80): {

            #{index-out=zero}
            w3 = w[i - 3]
            #{index-out=zero}
            w8 = w[i - 8]
            #{index-out=zero}
            w14 = w[i - 14]
            #{index-out=zero}
            w16 = w[i - 16]
            ww u32 = w3 ^ w8 ^ w14 ^ w16
            w[i]: {
                ok -> it = math.rotate-left(ww, 1) & mask
                -> _
            }
        }
        a u32 = h0
        b u32 = h1
        c u32 = h2
        d u32 = h3
        e u32 = h4
        f u32
        ar u32
        br u32
        temp u32
        i <- [0..20): {
            f = (b & c) | ((mask ^ b) & d)
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            #{overflow=wrap}
            temp = ar + f + e + k0 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [20..40): {
            f = b ^ c ^ d
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            #{overflow=wrap}
            temp = ar + f + e + k1 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [40..60): {
            f = (b & c) | (b & d) | (c & d)
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            #{overflow=wrap}
            temp = ar + f + e + k2 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [60..80): {
            f = b ^ c ^ d
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            #{overflow=wrap}
            temp = ar + f + e + k3 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        h0 = (h0 + a) & mask
        h1 = (h1 + b) & mask
        h2 = (h2 + c) & mask
        h3 = (h3 + d) & mask
        h4 = (h4 + e) & mask

        #{overflow=wrap}
        offset = offset + 64
    }
    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(40)
    #{index-out=zero}
    d9v6 str = hex-chars[(h0 >> 28) & 15]
    hex[0]: {
        ok -> it = d9v6
        -> _
    }
    #{index-out=zero}
    d9v7 str = hex-chars[(h0 >> 24) & 15]
    hex[1]: {
        ok -> it = d9v7
        -> _
    }
    #{index-out=zero}
    d9v8 str = hex-chars[(h0 >> 20) & 15]
    hex[2]: {
        ok -> it = d9v8
        -> _
    }
    #{index-out=zero}
    d9v9 str = hex-chars[(h0 >> 16) & 15]
    hex[3]: {
        ok -> it = d9v9
        -> _
    }
    #{index-out=zero}
    d9v10 str = hex-chars[(h0 >> 12) & 15]
    hex[4]: {
        ok -> it = d9v10
        -> _
    }
    #{index-out=zero}
    d9v11 str = hex-chars[(h0 >> 8) & 15]
    hex[5]: {
        ok -> it = d9v11
        -> _
    }
    #{index-out=zero}
    d9v12 str = hex-chars[(h0 >> 4) & 15]
    hex[6]: {
        ok -> it = d9v12
        -> _
    }
    #{index-out=zero}
    d9v13 str = hex-chars[(h0 >> 0) & 15]
    hex[7]: {
        ok -> it = d9v13
        -> _
    }
    #{index-out=zero}
    d9v14 str = hex-chars[(h1 >> 28) & 15]
    hex[8]: {
        ok -> it = d9v14
        -> _
    }
    #{index-out=zero}
    d9v15 str = hex-chars[(h1 >> 24) & 15]
    hex[9]: {
        ok -> it = d9v15
        -> _
    }
    #{index-out=zero}
    d9v16 str = hex-chars[(h1 >> 20) & 15]
    hex[10]: {
        ok -> it = d9v16
        -> _
    }
    #{index-out=zero}
    d9v17 str = hex-chars[(h1 >> 16) & 15]
    hex[11]: {
        ok -> it = d9v17
        -> _
    }
    #{index-out=zero}
    d9v18 str = hex-chars[(h1 >> 12) & 15]
    hex[12]: {
        ok -> it = d9v18
        -> _
    }
    #{index-out=zero}
    d9v19 str = hex-chars[(h1 >> 8) & 15]
    hex[13]: {
        ok -> it = d9v19
        -> _
    }
    #{index-out=zero}
    d9v20 str = hex-chars[(h1 >> 4) & 15]
    hex[14]: {
        ok -> it = d9v20
        -> _
    }
    #{index-out=zero}
    d9v21 str = hex-chars[(h1 >> 0) & 15]
    hex[15]: {
        ok -> it = d9v21
        -> _
    }
    #{index-out=zero}
    d9v22 str = hex-chars[(h2 >> 28) & 15]
    hex[16]: {
        ok -> it = d9v22
        -> _
    }
    #{index-out=zero}
    d9v23 str = hex-chars[(h2 >> 24) & 15]
    hex[17]: {
        ok -> it = d9v23
        -> _
    }
    #{index-out=zero}
    d9v24 str = hex-chars[(h2 >> 20) & 15]
    hex[18]: {
        ok -> it = d9v24
        -> _
    }
    #{index-out=zero}
    d9v25 str = hex-chars[(h2 >> 16) & 15]
    hex[19]: {
        ok -> it = d9v25
        -> _
    }
    #{index-out=zero}
    d9v26 str = hex-chars[(h2 >> 12) & 15]
    hex[20]: {
        ok -> it = d9v26
        -> _
    }
    #{index-out=zero}
    d9v27 str = hex-chars[(h2 >> 8) & 15]
    hex[21]: {
        ok -> it = d9v27
        -> _
    }
    #{index-out=zero}
    d9v28 str = hex-chars[(h2 >> 4) & 15]
    hex[22]: {
        ok -> it = d9v28
        -> _
    }
    #{index-out=zero}
    d9v29 str = hex-chars[(h2 >> 0) & 15]
    hex[23]: {
        ok -> it = d9v29
        -> _
    }
    #{index-out=zero}
    d9v30 str = hex-chars[(h3 >> 28) & 15]
    hex[24]: {
        ok -> it = d9v30
        -> _
    }
    #{index-out=zero}
    d9v31 str = hex-chars[(h3 >> 24) & 15]
    hex[25]: {
        ok -> it = d9v31
        -> _
    }
    #{index-out=zero}
    d9v32 str = hex-chars[(h3 >> 20) & 15]
    hex[26]: {
        ok -> it = d9v32
        -> _
    }
    #{index-out=zero}
    d9v33 str = hex-chars[(h3 >> 16) & 15]
    hex[27]: {
        ok -> it = d9v33
        -> _
    }
    #{index-out=zero}
    d9v34 str = hex-chars[(h3 >> 12) & 15]
    hex[28]: {
        ok -> it = d9v34
        -> _
    }
    #{index-out=zero}
    d9v35 str = hex-chars[(h3 >> 8) & 15]
    hex[29]: {
        ok -> it = d9v35
        -> _
    }
    #{index-out=zero}
    d9v36 str = hex-chars[(h3 >> 4) & 15]
    hex[30]: {
        ok -> it = d9v36
        -> _
    }
    #{index-out=zero}
    d9v37 str = hex-chars[(h3 >> 0) & 15]
    hex[31]: {
        ok -> it = d9v37
        -> _
    }
    #{index-out=zero}
    d9v38 str = hex-chars[(h4 >> 28) & 15]
    hex[32]: {
        ok -> it = d9v38
        -> _
    }
    #{index-out=zero}
    d9v39 str = hex-chars[(h4 >> 24) & 15]
    hex[33]: {
        ok -> it = d9v39
        -> _
    }
    #{index-out=zero}
    d9v40 str = hex-chars[(h4 >> 20) & 15]
    hex[34]: {
        ok -> it = d9v40
        -> _
    }
    #{index-out=zero}
    d9v41 str = hex-chars[(h4 >> 16) & 15]
    hex[35]: {
        ok -> it = d9v41
        -> _
    }
    #{index-out=zero}
    d9v42 str = hex-chars[(h4 >> 12) & 15]
    hex[36]: {
        ok -> it = d9v42
        -> _
    }
    #{index-out=zero}
    d9v43 str = hex-chars[(h4 >> 8) & 15]
    hex[37]: {
        ok -> it = d9v43
        -> _
    }
    #{index-out=zero}
    d9v44 str = hex-chars[(h4 >> 4) & 15]
    hex[38]: {
        ok -> it = d9v44
        -> _
    }
    #{index-out=zero}
    d9v45 str = hex-chars[(h4 >> 0) & 15]
    hex[39]: {
        ok -> it = d9v45
        -> _
    }
}
