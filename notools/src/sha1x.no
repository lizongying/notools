; sha1x: 完整 SHA-1 雜湊，返回 40 字元 hex 字串
sha1x = (data []byte) (hex str) {
    h0 u32 = 1732584193
    h1 u32 = 4023233417
    h2 u32 = 2562383102
    h3 u32 = 271733878
    h4 u32 = 3285377520
    mask u32 = 4294967295
    dlen = data.len
    bit-len = dlen * 8
    mod-val = (dlen + 9) % 64
    pad-len = 0
    mod-val != 0 -> pad-len = 64 - mod-val
    total-len = dlen + 1 + pad-len + 8
    padded []byte = with-len(total-len)
    i <- [0..total-len): { padded[i] = 0 }
    i <- [0..dlen): { padded[i] = data[i] }
    padded[dlen] = 128
    i <- [dlen + 1..total-len - 8): { padded[i] = 0 }
    i <- [0..8): { padded[total-len - 8 + i] = (bit-len >> (56 - i * 8)) & 255 }
    w []u32 = with-len(80)
    k0 u32 = 1518500249
    k1 u32 = 1859775393
    k2 u32 = 2400959708
    k3 u32 = 3395469782
    offset = 0
    {
        i <- [0..16): { w[i] = (padded[offset + i * 4] << 24) | (padded[offset + i * 4 + 1] << 16) | (padded[offset + i * 4 + 2] << 8) | padded[offset + i * 4 + 3] }
        i <- [16..80): {
            ww = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]
            w[i] = ((ww << 1) | (ww >> 31)) & mask
        }
        a u32 = h0
        b u32 = h1
        c u32 = h2
        d u32 = h3
        e u32 = h4
        i <- [0..20): {
            f = (b & c) | ((mask ^ b) & d)
            ar = ((a << 5) | (a >> 27)) & mask
            br = ((b << 30) | (b >> 2)) & mask
            temp = ar + f + e + k0 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [20..40): {
            f = b ^ c ^ d
            ar = ((a << 5) | (a >> 27)) & mask
            br = ((b << 30) | (b >> 2)) & mask
            temp = ar + f + e + k1 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [40..60): {
            f = (b & c) | (b & d) | (c & d)
            ar = ((a << 5) | (a >> 27)) & mask
            br = ((b << 30) | (b >> 2)) & mask
            temp = ar + f + e + k2 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [60..80): {
            f = b ^ c ^ d
            ar = ((a << 5) | (a >> 27)) & mask
            br = ((b << 30) | (b >> 2)) & mask
            temp = ar + f + e + k3 + w[i]
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        h0 = (h0 + a) & mask
        h1 = (h1 + b) & mask
        h2 = (h2 + c) & mask
        h3 = (h3 + d) & mask
        h4 = (h4 + e) & mask
        offset = offset + 64
    } (offset < total-len)
    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(40)
    hex[0] = hex-chars[(h0 >> 28) & 15]
    hex[1] = hex-chars[(h0 >> 24) & 15]
    hex[2] = hex-chars[(h0 >> 20) & 15]
    hex[3] = hex-chars[(h0 >> 16) & 15]
    hex[4] = hex-chars[(h0 >> 12) & 15]
    hex[5] = hex-chars[(h0 >> 8) & 15]
    hex[6] = hex-chars[(h0 >> 4) & 15]
    hex[7] = hex-chars[(h0 >> 0) & 15]
    hex[8] = hex-chars[(h1 >> 28) & 15]
    hex[9] = hex-chars[(h1 >> 24) & 15]
    hex[10] = hex-chars[(h1 >> 20) & 15]
    hex[11] = hex-chars[(h1 >> 16) & 15]
    hex[12] = hex-chars[(h1 >> 12) & 15]
    hex[13] = hex-chars[(h1 >> 8) & 15]
    hex[14] = hex-chars[(h1 >> 4) & 15]
    hex[15] = hex-chars[(h1 >> 0) & 15]
    hex[16] = hex-chars[(h2 >> 28) & 15]
    hex[17] = hex-chars[(h2 >> 24) & 15]
    hex[18] = hex-chars[(h2 >> 20) & 15]
    hex[19] = hex-chars[(h2 >> 16) & 15]
    hex[20] = hex-chars[(h2 >> 12) & 15]
    hex[21] = hex-chars[(h2 >> 8) & 15]
    hex[22] = hex-chars[(h2 >> 4) & 15]
    hex[23] = hex-chars[(h2 >> 0) & 15]
    hex[24] = hex-chars[(h3 >> 28) & 15]
    hex[25] = hex-chars[(h3 >> 24) & 15]
    hex[26] = hex-chars[(h3 >> 20) & 15]
    hex[27] = hex-chars[(h3 >> 16) & 15]
    hex[28] = hex-chars[(h3 >> 12) & 15]
    hex[29] = hex-chars[(h3 >> 8) & 15]
    hex[30] = hex-chars[(h3 >> 4) & 15]
    hex[31] = hex-chars[(h3 >> 0) & 15]
    hex[32] = hex-chars[(h4 >> 28) & 15]
    hex[33] = hex-chars[(h4 >> 24) & 15]
    hex[34] = hex-chars[(h4 >> 20) & 15]
    hex[35] = hex-chars[(h4 >> 16) & 15]
    hex[36] = hex-chars[(h4 >> 12) & 15]
    hex[37] = hex-chars[(h4 >> 8) & 15]
    hex[38] = hex-chars[(h4 >> 4) & 15]
    hex[39] = hex-chars[(h4 >> 0) & 15]
}
