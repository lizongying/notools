; sha1x: 完整 SHA-1 雜湊，返回 40 字元 hex 字串
sha1x = (data []byte) (hex str) {
    h0 u32 = 1732584193
    h1 u32 = 4023233417
    h2 u32 = 2562383102
    h3 u32 = 271733878
    h4 u32 = 3285377520
    mask u32 = 4294967295
    dlen = data.len()

    #{overflow=wrap}
    bit-len = dlen * 8
    mod-val = (dlen + 9) % 64
    pad-len = 0

    #{overflow=wrap}
    mod-val != 0 -> pad-len = 64 - mod-val

    #{overflow=wrap}
    total-len = dlen + 1 + pad-len + 8
    padded []byte = with-len(total-len)
    i <- [0..total-len): {
        padded[i]: {
            ok -> it = 0

            -> _
        }
    }
    i <- [0..dlen): {
        d9v1 byte = data[i]: {
            ok -> it

            -> 0
        }
        padded[i]: {
            ok -> it = d9v1

            -> _
        }
    }
    padded[dlen]: {
        ok -> it = 128

        -> _
    }
    i <- [dlen + 1..total-len - 8): {
        padded[i]: {
            ok -> it = 0

            -> _
        }
    }
    i <- [0..8): {

        #{overflow=wrap}
        padded[total-len - 8 + i]: {
            ok -> it = (bit-len >> (56 - i * 8)) & 255

            -> _
        }
    }
    w []u32 = with-len(80)
    k0 u32 = 1518500249
    k1 u32 = 1859775393
    k2 u32 = 2400959708
    k3 u32 = 3395469782
    offset = 0
    (offset < total-len) {
        i <- [0..16): {
            d9v2 byte = padded[offset + i * 4]: {
                ok -> it

                -> 0
            }
            d9v3 byte = padded[offset + i * 4 + 1]: {
                ok -> it

                -> 0
            }
            d9v4 byte = padded[offset + i * 4 + 2]: {
                ok -> it

                -> 0
            }
            d9v5 byte = padded[offset + i * 4 + 3]: {
                ok -> it

                -> 0
            }
            w[i]: {
                ok -> it = (d9v2 << 24) | (d9v3 << 16) | (d9v4 << 8) | d9v5

                -> _
            }
        }
        i <- [16..80): {
            w3 = w[i - 3]

            w8 = w[i - 8]

            w14 = w[i - 14]

            w16 = w[i - 16]
            ww u32 = w3 ^ w8 ^ w14 ^ w16
            w[i]: {
                ok -> it = math.rotate-left(ww, 1) & mask

                -> _
            }
        }
        a u32 = h0
        b u32 = h1
        c u32 = h2
        d u32 = h3
        e u32 = h4
        f u32
        ar u32
        br u32
        temp u32
        i <- [0..20): {
            f = (b & c) | ((mask ^ b) & d)
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            wi u32 = w[i]: {
                ok -> it

                -> 0
            }
            temp = ar + f + e + k0 + wi
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [20..40): {
            f = b ^ c ^ d
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            wi1 u32 = w[i]: {
                ok -> it

                -> 0
            }
            temp = ar + f + e + k1 + wi1
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [40..60): {
            f = (b & c) | (b & d) | (c & d)
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            wi2 u32 = w[i]: {
                ok -> it

                -> 0
            }
            temp = ar + f + e + k2 + wi2
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        i <- [60..80): {
            f = b ^ c ^ d
            ar = math.rotate-left(a, 5) & mask
            br = math.rotate-left(b, 30) & mask

            wi3 u32 = w[i]: {
                ok -> it

                -> 0
            }
            temp = ar + f + e + k3 + wi3
            temp = temp & mask
            e = d
            d = c
            c = br
            b = a
            a = temp
        }
        h0 = (h0 + a) & mask
        h1 = (h1 + b) & mask
        h2 = (h2 + c) & mask
        h3 = (h3 + d) & mask
        h4 = (h4 + e) & mask

        offset = offset + 64: {
            ok -> it

            -> _
        } #{overflow=wrap}
    }
    ; 逐 nibble 用字符串拼接输出（str 的 option 索引赋值会写入 tag 字节 0x01 而非字符，勿用）
    hex-chars = '0123456789abcdef'
    hex = ''

    hex = hex - hex-chars[(h0 >> 28) & 15]

    hex = hex - hex-chars[(h0 >> 24) & 15]

    hex = hex - hex-chars[(h0 >> 20) & 15]

    hex = hex - hex-chars[(h0 >> 16) & 15]

    hex = hex - hex-chars[(h0 >> 12) & 15]

    hex = hex - hex-chars[(h0 >> 8) & 15]

    hex = hex - hex-chars[(h0 >> 4) & 15]

    hex = hex - hex-chars[(h0 >> 0) & 15]

    hex = hex - hex-chars[(h1 >> 28) & 15]

    hex = hex - hex-chars[(h1 >> 24) & 15]

    hex = hex - hex-chars[(h1 >> 20) & 15]

    hex = hex - hex-chars[(h1 >> 16) & 15]

    hex = hex - hex-chars[(h1 >> 12) & 15]

    hex = hex - hex-chars[(h1 >> 8) & 15]

    hex = hex - hex-chars[(h1 >> 4) & 15]

    hex = hex - hex-chars[(h1 >> 0) & 15]

    hex = hex - hex-chars[(h2 >> 28) & 15]

    hex = hex - hex-chars[(h2 >> 24) & 15]

    hex = hex - hex-chars[(h2 >> 20) & 15]

    hex = hex - hex-chars[(h2 >> 16) & 15]

    hex = hex - hex-chars[(h2 >> 12) & 15]

    hex = hex - hex-chars[(h2 >> 8) & 15]

    hex = hex - hex-chars[(h2 >> 4) & 15]

    hex = hex - hex-chars[(h2 >> 0) & 15]

    hex = hex - hex-chars[(h3 >> 28) & 15]

    hex = hex - hex-chars[(h3 >> 24) & 15]

    hex = hex - hex-chars[(h3 >> 20) & 15]

    hex = hex - hex-chars[(h3 >> 16) & 15]

    hex = hex - hex-chars[(h3 >> 12) & 15]

    hex = hex - hex-chars[(h3 >> 8) & 15]

    hex = hex - hex-chars[(h3 >> 4) & 15]

    hex = hex - hex-chars[(h3 >> 0) & 15]

    hex = hex - hex-chars[(h4 >> 28) & 15]

    hex = hex - hex-chars[(h4 >> 24) & 15]

    hex = hex - hex-chars[(h4 >> 20) & 15]

    hex = hex - hex-chars[(h4 >> 16) & 15]

    hex = hex - hex-chars[(h4 >> 12) & 15]

    hex = hex - hex-chars[(h4 >> 8) & 15]

    hex = hex - hex-chars[(h4 >> 4) & 15]

    hex = hex - hex-chars[(h4 >> 0) & 15]
}
