; mv.no — mv utility
; Moves or renames files and directories
; Usage: mv <source> <destination>
;   - If destination is a directory, moves source into that directory
;   - Otherwise, renames source to destination

; base-name: extract filename from path (last segment after /)
base-name = (p str) (out str) {
    out = p
    i = p.len - 1
    {
        i < 0 -> break
        p[i] == 47 -> {
            out = p.slice(i + 1, p.len)
            break
        }
        i = i - 1
    } (true)
}

mv-run = () {
    argc = args()

    {
        argc < 4 -> {
            print('Usage: mv <source> <destination>')
            os.exit(1)
        }
    }

    src = arg(2)
    dest = arg(3)

    src-exists = fs.is-file(src) || fs.is-dir(src)
    {
        src-exists == false -> {
            print('mv: ' - src - ': No such file or directory')
            os.exit(1)
        }
    }

    final-dest = dest
    {
        fs.is-dir(dest) -> {

            ; Inline base-name: find last '/' in src
            filename = src
            si = src.len - 1
            {
                si < 0 -> break
                src[si] == 47 -> {
                    filename = src.slice(si + 1, src.len)
                    break
                }
                si = si - 1
            } (true)
            final-dest = dest - '/' - filename
        }
    }

    ok = fs.rename(src, final-dest)
    {
        ok == false -> {
            print('mv: ' - src - ': cannot move to ' - final-dest)
            os.exit(1)
        }
    }
}
