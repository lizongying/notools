// mv.no — mv utility
// Moves or renames files and directories
// Usage: mv <source> <destination>
//   - If destination is a directory, moves source into that directory
//   - Otherwise, renames source to destination

mv-run = () {
    argc = args()

    argc < 4 -> {
        print('Usage: mv <source> <destination>')
        os.exit(1)
    }

    src = arg(2)
    dest = arg(3)

    src-exists = fs.is-file(src) || fs.is-dir(src)
    src-exists == false -> {
        print('mv: ' - src - ': No such file or directory')
        os.exit(1)
    }

    final-dest = dest
    fs.is-dir(dest) -> {
        // Move source into directory, keeping filename
        src-path = path{
            p: src
        }
        filename = src-path.base()
        dst-path = path{
            p: dest
        }
        dst-path.join(filename)
        final-dest = dst-path.p
    }

    ok = fs.rename(src, final-dest)
    ok == false -> {
        print('mv: ' - src - ': cannot move to ' - final-dest)
        os.exit(1)
    }
}