; awk.no — awk utility
; Basic pattern scanning and field extraction
; Usage: awk '{print $1}' [files...]

awk-run = () {
    argc = args()

    action = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a.starts-with('{') && a.ends-with('}') -> action = a
        ! (a.starts-with('{') && a.ends-with('}')) && ! a.starts-with('-') -> files.push(a)
    }

    {
        action.len == 0 -> {
            print('awk: no action specified')
            os.exit(1)
        }
    }

    field-num i64 = 1
    dollar-pos = action.index('$')
    {
        dollar-pos >= 0 -> {
            next-pos = dollar-pos + 1
            next-pos < action.len -> {
                digit = action[next-pos]
                digit >= "1" -> {
                    digit <= "9" -> field-num = digit - "0"
                }
            }
        }

        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            process(content, field-num)
        }

        files.len > 0 -> {
            i <- [0..files.len): {
                ! fs.is-file(files[i]) -> {
                    print('awk: ' - files[i] - ': No such file or directory')
                    os.exit(1)
                }
                content = fs.read-file(files[i])
                process(content, field-num)
            }
        }
    }
}

process = (content str, field-num i64) {
    lines = content.split('\n')
    j <- [0..lines.len): {
        fields = split-by-whitespace(lines[j])
        fields.len >= field-num -> print(fields[field-num - 1])
    }
}

split-by-whitespace = (line str) (fields []str) {
    start = 0
    in-field = false

    i <- [0..line.len): {
        c = line[i]
        is-space = c == " " || c == "\t"
        is-space && in-field -> {
            fields.push(line.slice(start, i))
            in-field = false
        }
        ! is-space && ! in-field -> {
            start = i
            in-field = true
        }
    }
    in-field -> fields.push(line.slice(start, line.len))
}
