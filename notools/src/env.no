; env.no — env utility
; Run a command in a modified environment, or print environment
; Usage: env [-i] [NAME=VALUE...] [command [args]]
;   -i: start with an empty environment (simplified: skip printing initial env)
;   NAME=VALUE: set environment variable before running command

env-run = () {
    argc = args()

    ignore-env = false
    cmd-start = -1

    i <- [2..argc): {
        a = arg(i)
        a == '-i' -> ignore-env = true
        a.contains('=') -> {
            eq-pos = a.index('=')
            key = a.slice(0, eq-pos)
            val = a.slice(eq-pos + 1, a.len)
            os.set-env(key, val)
        }
        -> {
            cmd-start = i
            break
        }
    }

    {
        cmd-start < 0 -> {
            ignore-env == false -> {
                names []str
                names.push('PATH')
                names.push('HOME')
                names.push('USER')
                names.push('LOGNAME')
                names.push('SHELL')
                names.push('TERM')
                names.push('LANG')
                names.push('LC_ALL')
                names.push('LC_CTYPE')
                names.push('EDITOR')
                names.push('VISUAL')
                names.push('PWD')
                names.push('TMPDIR')
                names.push('SHLVL')
                names.push('PAGER')
                names.push('MAIL')
                names.push('HOSTNAME')
                names.push('HOST')
                names.push('DOMAIN')
                names.push('OSTYPE')
                names.push('MACHTYPE')
                names.push('DISPLAY')
                names.push('COLORTERM')
                names.push('LS_COLORS')
                names.push('LSCOLORS')
                names.push('MANPATH')
                names.push('INFOPATH')
                names.push('CPATH')
                names.push('LIBRARY_PATH')
                names.push('LD_LIBRARY_PATH')
                names.push('DYLD_LIBRARY_PATH')
                names.push('GOPATH')
                names.push('GOROOT')
                names.push('JAVA_HOME')
                names.push('PYTHONPATH')
                names.push('RUSTUP_HOME')
                names.push('CARGO_HOME')
                names.push('NVM_DIR')
                names.push('NVM_HOME')
                names.push('NODE_PATH')
                names.push('PNPM_HOME')
                names.push('XDG_CONFIG_HOME')
                names.push('XDG_DATA_HOME')
                names.push('XDG_CACHE_HOME')
                names.push('XDG_RUNTIME_DIR')
                names.push('XDG_STATE_HOME')

                j <- [0..names.len): {
                    name = names[j]
                    val = os.get-env(name)
                    val.len > 0 -> {
                        envstr = name - '=' - val
                        print(envstr)
                    }
                }
            }
            return
        }
    }

    cmd = arg(cmd-start)
    i <- [cmd-start + 1..argc): {
        cmd = cmd - ' ' - arg(i)
    }
    process.process-system(cmd)
}
