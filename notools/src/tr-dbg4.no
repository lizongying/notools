tr-run = () {
    argc = args()
    dmode = 0
    i <- [2..argc): { a = arg(i); a == '-d' -> dmode = 1 }
    sets []str
    i <- [2..argc): { a = arg(i); a == '-d' -> { continue }; ! a.starts-with('-') -> sets.push(a) }
    set1 = sets[0]
    set2 = ''
    sets.len > 1 -> set2 = sets[1]
    content = fs.read-file('/dev/stdin')
    printf('content.len=%d set1=%s set2=%s\n', content.len, set1, set2)
    j <- [0..content.len): {
        c = content[j]
        outc = c
        x <- [0..set1.len): { set1[x] == c -> outc = c; set2.len > x -> outc = set2[x] }
        printf('char=%d outc=%d\n', c, outc)
    }
    print('DONE')
}
main = () { tr-run() }
