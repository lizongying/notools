; readlink.no — readlink utility
; Print the target of a symbolic link
; Usage: readlink [-f] [-n] LINK...
;   -f: follow all symlinks recursively to the final target
;   -n: do not output the trailing newline
;   Default: print the link target (error if link does not exist)

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
readlink-run = () {
    argc = args()

    follow = false
    no-newline = false
    has-link = false
    had-error = false

    i = 2
    {
        a = arg(i)
        {
            a.starts-with('-') -> {
                a.contains('f') -> follow = true
                a.contains('n') -> no-newline = true
                i = i + 1
                continue
            }
        }

        ; Process this link
        has-link = true
        p = a

        {
            follow -> {

                ; -f 模式：遞迴跟隨所有連結直到最終目標
                cur = p
                done = false
                {
                    done -> break
                    target, ok = fs.readlink(cur)
                    {
                        ok -> {
                            cur = target
                        }

                        -> {

                            ; 不是符號連結或讀取失敗
                            exists = fs.is-file(cur) || fs.is-dir(cur)
                            {
                                exists -> {
                                    {
                                        no-newline -> io.out(cur)

                                        -> print(cur)
                                    }

                                    done = true
                                }

                                -> {
                                    eprint('readlink: ' - p - ': No such file or directory')
                                    had-error = true
                                    done = true
                                }
                            }
                        }
                    }
                } (done == false)
            }

            -> {

                ; 預設模式：直接讀取連結目標
                target, ok = fs.readlink(p)
                {
                    ok == false -> {
                        eprint('readlink: ' - p - ': No such file or directory')
                        had-error = true
                    }

                    -> {
                        no-newline -> io.out(target)

                        -> print(target)
                    }
                }
            }
        }

        i = i + 1
    } (i < argc)

    {
        has-link == false -> {
            eprint('Usage: readlink [-f] [-n] LINK...')
            os.exit(1)
        }

        had-error -> os.exit(1)
    }
}

#{win-amd64, win-arm64}
readlink-run = () {
    eprint('readlink-run: not supported on this platform')
    os.exit(1)
}
