; csplit.no — csplit utility
; Split a file into sections determined by context patterns
; Usage: csplit [FILE] PATTERN...
;   PATTERN:
;     N         split after line N (1-based)
;     /literal/ split before the next line containing "literal"
;     %literal% skip to the next line containing "literal" (discarded)
;   FILE defaults to stdin. Output files are named xx00, xx01, ...

; atoi: parse a non-negative integer
atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len-bytes()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

; is-pattern: detect whether an argument looks like a pattern
is-pattern = (s str) (yes bool) {
    yes = false
    n = s.len-bytes()
    n == 0 -> return
    c0 = s[0]

    #{overflow=wrap}
    cl = s[n - 1]
    {
        ; /literal/
        c0 == 47 && cl == 47 && n >= 2 -> yes = true

        ; %literal%
        c0 == 37 && cl == 37 && n >= 2 -> yes = true

        ; integer (all digits)
        c0 >= 48 && c0 <= 57 -> {
            all-digits = true
            i <- [0..n): {
                c = s[i]
                c < 48 || c > 57 -> all-digits = false
            }
            all-digits -> yes = true
        }
    }
}

; gen-name: generate output filename xx00, xx01, ...
gen-name = (idx i64) (name str) {
    suffix = idx.to-str()
    #{overflow=wrap}
    suffix.len-bytes() < 2 -> suffix = '0' - suffix
    #{overflow=wrap}
    name = 'xx' - suffix
}

; write-section: write a chunk to a numbered output file
write-section = (file-idx i64, chunk str) {
    fname = gen-name(file-idx)
    fd = fs.open-write(fname)
    fs.write(fd, chunk, chunk.len-bytes())
    fs.close(fd)
}

; find-line: find the first line (from cur-line) containing literal
; returns the 0-based line index, or -1 if not found
find-line = (content str, line-starts []i64, cur-line i64, literal str) (found-line i64) {
    found-line = -1
    n = line-starts.len()
    i <- [cur-line..n): {

        #{index-out=0}
        start = line-starts[i]
        end = content.len-bytes()

        #{overflow=wrap}
        i + 1 < n -> {

            #{index-out=0}
            end = line-starts[i + 1]
        }

        ; strip trailing newline for matching
        line-end = end
        line-end > start -> {

            #{overflow=wrap}
            content[line-end - 1] == 10 -> line-end = line-end - 1
        }
        line = content.slice(start, line-end)
        line.contains(literal) -> {
            found-line = i
            break
        }
    }
}

csplit = () {
    argc = args()
    infile = ''
    patterns []str

    ; First non-option argument that is not a pattern becomes FILE;
    ; all other non-option arguments are patterns.
    i <- [2..argc): {
        a = arg(i)
        ! a.starts-with('-') -> {
            is-pat = is-pattern(a)
            {
                infile == '' && ! is-pat -> infile = a

                -> patterns.push(a)
            }
        }
    }

    ; Read input (file or stdin)
    content = ''
    {
        infile == '' -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }

        -> {
            ! fs.is-file(infile) -> {
                #{overflow=wrap}
                eprint('csplit: ' - infile - ': No such file or directory')
                os.exit(1)
            }
            content = ''
            r = fs.read-str(infile)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    ; Build line-start positions (byte offset of the first char of each line)
    line-starts []i64
    line-starts.push(0)
    j <- [0..content.len-bytes()): {

        #{overflow=wrap}
        content[j] == 10 -> line-starts.push(j + 1)
    }
    num-lines = line-starts.len()

    ; Process patterns sequentially
    section-start = 0
    cur-line = 0
    file-idx = 0

    p <- [0..patterns.len()): {

        #{index-out=0}
        pat = patterns[p]
        pn = pat.len()
        pn == 0 -> {
            eprint('csplit: empty pattern')
            os.exit(1)
        }
        first = pat[0]
        {
            ; Integer pattern: split after line N (1-based)
            first >= 48 && first <= 57 -> {
                n = atoi(pat)
                n < 1 -> {
                    eprint('csplit: line number must be positive')
                    os.exit(1)
                }
                n > num-lines -> {
                    eprint('csplit: line number out of range')
                    os.exit(1)
                }

                ; Split point is the start of line n (0-based index n)
                split-pos = content.len-bytes()
                n < num-lines -> {

                    #{index-out=0}
                    split-pos = line-starts[n]
                }
                chunk = content.slice(section-start, split-pos)
                write-section(file-idx, chunk)

                #{overflow=wrap}
                file-idx = file-idx + 1
                section-start = split-pos
                cur-line = n
            }

            ; /literal/ pattern: split before matching line
            first == 47 -> {
                pn < 2 -> {
                    eprint('csplit: invalid pattern: ' - pat)
                    os.exit(1)
                }
                #{overflow=wrap}
                inner = pat.slice(1, pn - 1)
                found = find-line(content, line-starts, cur-line, inner)
                found < 0 -> {
                    #{overflow=wrap}
                    eprint('csplit: /' - inner - '/: no match')
                    os.exit(1)
                }

                #{index-out=0}
                split-pos = line-starts[found]
                chunk = content.slice(section-start, split-pos)
                write-section(file-idx, chunk)
                #{overflow=wrap}
                file-idx = file-idx + 1
                section-start = split-pos
                cur-line = found
            }

            ; %literal% pattern: skip to matching line (discard skipped content)
            first == 37 -> {
                pn < 2 -> {
                    eprint('csplit: invalid pattern: ' - pat)
                    os.exit(1)
                }
                #{overflow=wrap}
                inner = pat.slice(1, pn - 1)
                found = find-line(content, line-starts, cur-line, inner)
                found < 0 -> {
                    #{overflow=wrap}
                    eprint('csplit: %' - inner - '%: no match')
                    os.exit(1)
                }

                #{index-out=0}
                split-pos = line-starts[found]

                ; Skip (do not write) the discarded content
                section-start = split-pos
                cur-line = found
            }

            -> {
                eprint('csplit: invalid pattern: ' - pat)
                os.exit(1)
            }
        }
    }

    ; Write remaining content as the final section
    {
        section-start < content.len-bytes() -> {
            chunk = content.slice(section-start, content.len-bytes())
            write-section(file-idx, chunk)

            #{overflow=wrap}
            file-idx = file-idx + 1
        }
    }
}
