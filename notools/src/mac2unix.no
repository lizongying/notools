; mac2unix.no — mac2unix utility
; Convert CR line endings to LF
; Usage: mac2unix [FILE...]
;   No FILE: read stdin, write stdout
;   With FILE: modify in place

mac2unix-convert = (content str) (out str) {
    n = content.len()
    out = with-cap(n)
    j = 0
    i <- [0..n): {
        c = content[i]
        {
            c == 13 -> {

                ; CR: check if next is LF
                next-is-lf = false

                #{overflow=wrap}
                i + 1 < n -> {
                    content[i + 1] == 10 -> next-is-lf = true
                }
                ! next-is-lf -> {

                    ; standalone CR -> convert to LF
                    out[j]: {
                        ok -> it = 10

                        -> _
                    }

                    #{overflow=wrap}
                    j = j + 1: {
                        ok -> it

                        -> _
                    }
                }
                next-is-lf -> {

                    ; CRLF: keep CR (LF handled next iteration)
                    out[j]: {
                        ok -> it = 13

                        -> _
                    }

                    #{overflow=wrap}
                    j = j + 1: {
                        ok -> it

                        -> _
                    }
                }
            }

            -> {
                out[j]: {
                    ok -> it = c

                    -> _
                }

                #{overflow=wrap}
                j = j + 1: {
                    ok -> it

                    -> _
                }
            }
        }
    }
}

mac2unix-run = () {
    argc = os.args().len()
    {
        argc <= 2 -> {
            inp = ''
            r = fs.read-stdin-str()
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            out = mac2unix-convert(inp)
            print(out)
        }

        -> {
            i <- [2..argc): {
                path-opt = os.arg(i)
                path = path-opt: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(path) -> {
                    eprint('mac2unix: ' - path - ': No such file')
                    exit(1)
                }
                inp = ''
                r = fs.read-str(path)
                r: {
                    ok -> inp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                out = mac2unix-convert(inp)
                data = out
                fs.write-file(path, data)
            }
        }
    }
}
