; seq.no — seq utility
; Print a sequence of numbers
; Usage: seq [-w] [FIRST [STEP]] LAST
;   -w:      equalize widths by padding with leading zeros
;   1 arg:   seq LAST       → 1..LAST (step 1)
;   2 args:  seq FIRST LAST → FIRST..LAST (step 1)
;   3 args:  seq FIRST STEP LAST

atoi = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    {
        s.len > 0 -> {
            s[0] == 45 -> {
                neg = true
                start = 1
            }
        }
    }
    i <- [start..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
    neg == true -> v = 0 - v
}

; pad-zero: left-pad s with '0' to reach width
pad-zero = (s str, width i64) (out str) {
    out = s
    {
        s.len < width -> {
            pad = width - s.len
            prefix = '0'.repeat(pad)
            out = prefix - s
        }
    }
}

seq-run = () {
    argc = args()

    width-flag = false
    nums []str
    i <- [2..argc): {
        a = arg(i)
        a == '-w' -> width-flag = true
        a != '-w' -> nums.push(a)
    }

    {
        nums.len == 0 -> {
            eprint('Usage: seq [-w] [FIRST [STEP]] LAST')
            os.exit(1)
        }
    }

    first = 1
    step = 1
    last = 1

    {
        nums.len == 1 -> last = atoi(nums[0])

        nums.len == 2 -> {
            first = atoi(nums[0])
            last = atoi(nums[1])
        }

        nums.len >= 3 -> {
            first = atoi(nums[0])
            step = atoi(nums[1])
            last = atoi(nums[2])
        }
    }

    {
        step == 0 -> {
            eprint('seq: step cannot be 0')
            os.exit(1)
        }
    }

    ; Determine output width when -w is set
    max-width = 1
    {
        width-flag == true -> {
            fstr = first.to-str()
            lstr = last.to-str()
            max-width = fstr.len
            lstr.len > max-width -> max-width = lstr.len
        }
    }

    ; Generate sequence
    cont = true
    {
        cont == false -> break
        step > 0 -> {
            first <= last -> {
                s = first.to-str()
                width-flag == true -> s = pad-zero(s, max-width)
                print(s)
                first = first + step
            }
            first > last -> cont = false
        }
        step < 0 -> {
            first >= last -> {
                s = first.to-str()
                width-flag == true -> s = pad-zero(s, max-width)
                print(s)
                first = first + step
            }
            first < last -> cont = false
        }
    } (true)
}
