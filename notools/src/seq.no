; seq.no — seq utility
; Print a sequence of numbers
; Usage: seq [-w] [-s SEP] [FIRST [STEP]] LAST
;   -w:      equalize widths by padding with leading zeros
;   -s SEP:  use SEP as the separator printed after every number (default \n)
;   1 arg:   seq LAST       → 1..LAST (step 1)
;   2 args:  seq FIRST LAST → FIRST..LAST (step 1)
;   3 args:  seq FIRST STEP LAST

atoi = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    {
        s.len-bytes() > 0 -> {
            s[0] == 45 -> {
                neg = true
                start = 1
            }

            -> {
            }
        }

        -> {
        }
    }
    i <- [start..s.len-bytes()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)

        -> {}
    }

    {
        neg -> {

            #{overflow=wrap}
            v = 0 - v
        }

        -> {
        }
    }
}

; pad-zero: left-pad s with '0' to reach width
pad-zero = (s str, width i64) (out str) {
    out = s
    {
        s.len-bytes() < width -> {

            #{overflow=wrap}
            pad = width - s.len-bytes()
            prefix = '0'.repeat(pad)
            out = prefix - s
        }

        -> {
        }
    }
}

seq-run = () {
    argc = os.args()

    width-flag = false
    sep = '\n'
    nums []str
    skip-next = false
    i <- [2..argc): {
        a = os.arg(i)
        {
            skip-next -> {
                skip-next = false
                continue
            }

            -> {
            }
        }
        {
            a == '-w' -> width-flag = true

            a == '-s' -> {

                #{overflow=wrap}
                i + 1 < argc -> {
                    sep = os.arg(i + 1)
                    skip-next = true
                }

                -> {}
            }

            a == '-f' -> {

                ; format option: consume its argument (format string not applied)
                #{overflow=wrap}
                i + 1 < argc -> {
                    skip-next = true
                }

                -> {}
            }

            a != '-w' && a != '-s' && a != '-f' -> nums.push(a)

            -> {
            }
        }
    }

    {
        nums.len() == 0 -> {
            eprint('Usage: seq [-w] [-s SEP] [FIRST [STEP]] LAST')
            os.exit(1)
        }

        -> {
        }
    }

    first = 1
    step = 1
    last = 1

    {
        nums.len() == 1 -> {

            #{index-out=zero}
            last = atoi(nums[0])
        }

        -> {
        }
    }
    {
        nums.len() == 2 -> {

            #{index-out=zero}
            first = atoi(nums[0])

            #{index-out=1}
            last = atoi(nums[1])
        }

        -> {
        }
    }
    {
        nums.len() >= 3 -> {

            #{index-out=zero}
            first = atoi(nums[0])

            #{index-out=1}
            step = atoi(nums[1])

            #{index-out=2}
            last = atoi(nums[2])
        }

        -> {
        }
    }

    {
        step == 0 -> {
            eprint('seq: step cannot be 0')
            os.exit(1)
        }

        -> {
        }
    }

    ; Determine output width when -w is set
    max-width = 1
    {
        width-flag -> {
            fstr = first.to-str()
            lstr = last.to-str()
            max-width = fstr.len-bytes()
            lstr.len-bytes() > max-width -> max-width = lstr.len-bytes()

            -> {}
        }

        -> {
        }
    }

    ; Generate sequence: print number then separator (BSD appends after every term)
    cont = true
    !! {
        ! cont -> break
        step > 0 -> {
            first <= last -> {
                s = first.to-str()
                width-flag -> s = pad-zero(s, max-width)
                io.out(s - sep)

                #{overflow=wrap}
                first = first + step
            }
            first > last -> cont = false

            -> {}
        }
        step < 0 -> {
            first >= last -> {
                s = first.to-str()
                width-flag -> s = pad-zero(s, max-width)
                io.out(s - sep)

                #{overflow=wrap}
                first = first + step
            }
            first < last -> cont = false

            -> {}
        }

        -> {}
    }
}
