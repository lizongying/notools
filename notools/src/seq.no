; seq.no — seq utility
; Print a sequence of numbers
; Usage: seq [-w] [-s SEP] [FIRST [STEP]] LAST
;   -w:      equalize widths by padding with leading zeros
;   -s SEP:  use SEP as the separator printed after every number (default \n)
;   1 arg:   seq LAST       → 1..LAST (step 1)
;   2 args:  seq FIRST LAST → FIRST..LAST (step 1)
;   3 args:  seq FIRST STEP LAST

atoi = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    {
        s.len() > 0 -> {
            s[0] == 45 -> {
                neg = true
                start = 1
            }

            -> {
            }
        }

        -> {
        }
    }
    i <- [start..s.len()): {
        c = s[i]

        {
            c >= 48 && c <= 57 -> {

                #{overflow=wrap}
                v = v * 10 + (c - 48)
            }

            -> {
            }
        }
    }

    {
        neg -> {

            #{overflow=wrap}
            v = 0 - v: {
                ok -> it

                -> _
            }
        }

        -> {
        }
    }
}

; pad-zero: left-pad s with '0' to reach width
pad-zero = (s str, width i64) (out str) {
    out = s
    {
        s.len() < width -> {

            #{overflow=wrap}
            pad = width - s.len()
            prefix = '0'.repeat(pad)
            out = prefix - s
        }

        -> {
        }
    }
}

seq-run = () {
    argc = os.args().len()

    width-flag = false
    sep = '\n'
    nums []str
    skip-next = false
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            skip-next -> {
                skip-next = false
                continue
            }

            -> {
            }
        }
        {
            a == '-w' -> width-flag = true

            a == '-s' -> {
                i + 1 < argc -> {

                    #{overflow=wrap}
                    sep-opt = os.arg(i + 1)
                    sep = sep-opt: {
                        ok -> it

                        -> ''
                    }
                    skip-next = true
                }

                -> {
                }
            }

            a == '-f' -> {

                ; format option: consume its argument (format string not applied)
                {
                    i + 1 < argc -> {
                        skip-next = true
                    }

                    -> {
                    }
                }
            }

            a != '-w' && a != '-s' && a != '-f' -> nums.push(a)

            -> {
            }
        }
    }

    {
        nums.len() == 0 -> {
            eprint('Usage: seq [-w] [-s SEP] [FIRST [STEP]] LAST')
            exit(1)
        }

        -> {
        }
    }

    first = 1
    step = 1
    last = 1

    {
        nums.len() == 1 -> {
            n0 = nums[0]: {
                ok -> it

                -> ''
            }
            last = atoi(n0)
        }

        -> {
        }
    }
    {
        nums.len() == 2 -> {
            n0 = nums[0]: {
                ok -> it

                -> ''
            }
            n1 = nums[1]: {
                ok -> it

                -> ''
            }
            first = atoi(n0)
            last = atoi(n1)
        }

        -> {
        }
    }
    {
        nums.len() >= 3 -> {
            n0 = nums[0]: {
                ok -> it

                -> ''
            }
            n1 = nums[1]: {
                ok -> it

                -> ''
            }
            n2 = nums[2]: {
                ok -> it

                -> ''
            }
            first = atoi(n0)
            step = atoi(n1)
            last = atoi(n2)
        }

        -> {
        }
    }

    {
        step == 0 -> {
            eprint('seq: step cannot be 0')
            exit(1)
        }

        -> {
        }
    }

    ; Determine output width when -w is set
    max-width = 1
    {
        width-flag -> {
            fstr = first.to-str()
            lstr = last.to-str()
            max-width = fstr.len()
            {
                lstr.len() > max-width -> max-width = lstr.len()

                -> {
                }
            }
        }

        -> {
        }
    }

    ; Generate sequence: print number then separator (BSD appends after every term)
    cont = true
    !! {
        {
            ! cont -> break

            step > 0 -> {
                first <= last -> {
                    s = first.to-str()
                    width-flag -> s = pad-zero(s, max-width)
                    io.out(s - sep)

                    #{overflow=wrap}
                    first = first + step: {
                        ok -> it

                        -> _
                    }
                }

                first > last -> cont = false

                -> {
                }
            }

            step < 0 -> {
                first >= last -> {
                    s = first.to-str()
                    width-flag -> s = pad-zero(s, max-width)
                    io.out(s - sep)

                    #{overflow=wrap}
                    first = first + step: {
                        ok -> it

                        -> _
                    }
                }

                first < last -> cont = false

                -> {
                }
            }

            -> {
            }
        }
    }
}
