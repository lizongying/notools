; zcat.no — zcat utility
; 將 gzip 壓縮檔解壓到標準輸出。等同 gunzip -c。
; Usage: zcat <file.gz...>
;   - 無參數: 從 stdin 讀取並解壓
;   - 多檔案: 依次解壓輸出
;   - 不存在的檔案: 報錯並繼續，最終退出碼 1

zcat = () {
    argc = args()

    ; 無檔案參數時從 stdin 讀取
    {
        argc <= 2 -> {
            content = fs.read-file('/dev/stdin')
            data = content
            out []byte = gzip.gzip-decompress(data)
            fs.write(1, out, out.len)
            io.out('')
            return
        }
    }

    had-error = false
    i = 2
    {
        a = arg(i)
        {
            a.starts-with('-') == false -> {
                f = a

                fs.is-file(f) == false -> {
                    eprint('zcat: ' - f - ': No such file')
                    had-error = true
                    i = i + 1
                    continue
                }
                content = fs.read-file(f)
                data = content
                out []byte = gzip.gzip-decompress(data)
                fs.write(1, out, out.len)
                io.out('')
            }
        }

        i = i + 1
    } (i < argc)

    had-error -> os.exit(1)
}
