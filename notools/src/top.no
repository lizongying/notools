; top.no — top utility
; Display system processes and resource usage
; Usage: top [-n count]

top-run = () {
    argc = args()

    count = 10
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a == '-n' -> {
            i + 1 < argc -> {
                n-str = arg(i + 1)
                count = 0
                j <- [0..n-str.len): {
                    digit = n-str[j]
                    digit >= "0" && digit <= "9" -> count = count * 10 + (digit - "0")
                }
            }
            skip-next = true
        }
    }

    cmd = 'top -l 1 -n ' - count.to-str()
    process.process-system(cmd)
}