; top.no — top utility
; Display system processes and resource usage
; Usage: top [-n count]

top-run = () {
    argc = os.args().len()

    count = 10
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-n' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                n-str-opt = os.arg(i + 1)
                n-str = n-str-opt: {
                    ok -> it

                    -> ''
                }
                count = 0
                j <- [0..n-str.len()): {
                    digit = n-str[j]
                    digit >= "0" && digit <= "9" -> count = count * 10 + (digit - "0")
                }
            }
            skip-next = true
        }
    }

    cmd = 'top -l 1 -n ' - count.to-str()
    process.process-system(cmd)
}
