// realpath.no — realpath utility
// Print the resolved absolute path
// Usage: realpath [-e] [-m] PATH...
//   -e: require all components of the path to exist
//   -m: allow non-existent path (no error)
//   Default: error if path does not exist

realpath-run = () {
    argc = args()

    allow-missing = false
    paths []str

    i <- [2..argc): {
        a = arg(i)
        a.starts-with('-') -> {
            a.contains('m') -> allow-missing = true
        }
        -> paths.push(a)
    }

    {
        paths.len == 0 -> {
            eprint('Usage: realpath [-e] [-m] PATH...')
            os.exit(1)
        }
    }

    had-error = false
    i <- [0..paths.len): {
        p = paths[i]
        abs = fs.realpath(p)
        abs.len > 0 -> print(abs)
        abs.len == 0 && allow-missing -> {
            p.starts-with('/') -> print(p)
            -> print(os.get-wd() - '/' - p)
        }
        abs.len == 0 && allow-missing == false -> {
            eprint('realpath: ' - p - ': No such file or directory')
            had-error = true
        }
    }

    had-error -> os.exit(1)
}
