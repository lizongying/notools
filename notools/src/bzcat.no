; bzcat.no — bzcat utility: decompress .bz2 to stdout (native Nolang)
; Usage: bzcat FILE...

bzcat-cmd = () {
    argc = args()

    has-file = false

    i = 2
    {
        a = arg(i)
        {
            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    eprint('bzcat: ' - f - ': No such file')
                    i = i + 1
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it
                    nil -> {
                    }
                    err -> {
                    }
                }
                data = content
                out []byte = bzip2.bzip2-decompress(data)
                s = out.to-str()
                io.out(s)
            }
        }

        i = i + 1
    } (i < argc)

    {
        has-file == false -> {
            eprint('bzcat: no input files')
            os.exit(1)
        }
    }
}
