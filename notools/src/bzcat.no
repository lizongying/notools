; bzcat.no — bzcat utility: decompress .bz2 to stdout (native Nolang)
; Usage: bzcat FILE...

bzcat-cmd = () {
    argc = args()

    has-file = false

    i = 2
    (i < argc) {
        a = arg(i)
        {
            ! a.starts-with('-') -> {
                has-file = true
                f = a

                ! fs.is-file(f) -> {
                    #{overflow=wrap}
                    eprint('bzcat: ' - f - ': No such file')

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = content
                out []byte = bzip2.bzip2-decompress(data)
                s = out.to-bytes-str()
                io.out(s)
            }
        }

        #{overflow=wrap}
        i = i + 1
    }

    {
        ! has-file -> {
            eprint('bzcat: no input files')
            os.exit(1)
        }
    }
}
