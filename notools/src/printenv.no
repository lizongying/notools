; printenv.no — printenv utility
; Print all or part of the environment
; Usage: printenv [VAR...]
;   No args: print all known environment variables (KEY=VALUE per line)
;   VAR: print value of each specified variable

printenv-run = () {
    argc = args()

    {
        argc <= 2 -> {
            names []str
            names.push('PATH')
            names.push('HOME')
            names.push('USER')
            names.push('LOGNAME')
            names.push('SHELL')
            names.push('TERM')
            names.push('LANG')
            names.push('LC_ALL')
            names.push('LC_CTYPE')
            names.push('EDITOR')
            names.push('VISUAL')
            names.push('PWD')
            names.push('TMPDIR')
            names.push('SHLVL')
            names.push('PAGER')
            names.push('MAIL')
            names.push('HOSTNAME')
            names.push('HOST')
            names.push('DOMAIN')
            names.push('OSTYPE')
            names.push('MACHTYPE')
            names.push('DISPLAY')
            names.push('COLORTERM')
            names.push('LS_COLORS')
            names.push('LSCOLORS')
            names.push('MANPATH')
            names.push('INFOPATH')
            names.push('CPATH')
            names.push('LIBRARY_PATH')
            names.push('LD_LIBRARY_PATH')
            names.push('DYLD_LIBRARY_PATH')
            names.push('GOPATH')
            names.push('GOROOT')
            names.push('JAVA_HOME')
            names.push('PYTHONPATH')
            names.push('RUSTUP_HOME')
            names.push('CARGO_HOME')
            names.push('NVM_DIR')
            names.push('NVM_HOME')
            names.push('NODE_PATH')
            names.push('PNPM_HOME')
            names.push('XDG_CONFIG_HOME')
            names.push('XDG_DATA_HOME')
            names.push('XDG_CACHE_HOME')
            names.push('XDG_RUNTIME_DIR')
            names.push('XDG_STATE_HOME')

            i <- [0..names.len): {
                name = names[i]
                val = os.get-env(name)
                val.len > 0 -> {
                    pavstr = name - '=' - val
                    print(pavstr)
                }
            }
            return
        }
    }

    had-error = false
    i <- [2..argc): {
        name = arg(i)
        val = os.get-env(name)
        val.len > 0 -> print(val)
        val.len == 0 -> had-error = true
    }
    had-error -> os.exit(1)
}
