; xzcat.no — xzcat utility: decompress .xz to stdout (native Nolang)
; Usage: xzcat FILE...

xzcat-cmd = () {
    argc = os.args().len()

    has-file = false

    i = 2
    (i < argc) {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            ! a.starts-with('-') -> {
                has-file = true
                f = a

                ! fs.is-file(f) -> {
                    eprint('xzcat: ' - f - ': No such file')

                    #{overflow=wrap}
                    i = i + 1: {
                        ok -> it

                        -> _
                    }
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = content
                out []byte = xz.decompress(data)
                s = out.to-bytes-str()
                io.out(s)
            }
        }

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }

    {
        ! has-file -> {
            eprint('xzcat: no input files')
            exit(1)
        }
    }
}
