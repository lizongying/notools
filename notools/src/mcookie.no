; mcookie.no — mcookie utility
; Generate a 128-bit random cookie (32 hex chars)
; Usage: mcookie

mcookie-run = () {
    state = os.get-pid() ^ os.now-ns()
    hex-chars = '0123456789abcdef'
    ; 不能用索引写 str/[]byte 拼 hex：option 索引写会把 0x01 tag 字节写进
    ; 目标而非字符载荷（实测输出 32 个 0x01）。改用字符串拼接。
    out = ''
    i <- [0..16): {

        #{overflow=wrap}
        state = state * 1103515245 + 12345
        b = (state >> 16) & 255
        out = out - hex-chars[(b >> 4) & 15]
        out = out - hex-chars[b & 15]
    }
    print(out)
}
