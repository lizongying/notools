; mcookie.no — mcookie utility
; Generate a 128-bit random cookie (32 hex chars)
; Usage: mcookie

mcookie-run = () {
    state = os.get-pid() ^ os.now-ns()
    hex-chars = '0123456789abcdef'
    out []byte = with-cap(32)
    i <- [0..16): {

        #{overflow=wrap}
        state = state * 1103515245 + 12345
        b = (state >> 16) & 255

        #{index-out=zero}
        d9v1 str = hex-chars[(b >> 4) & 15]
        #{overflow=wrap}
        out[i * 2]: {
            ok -> it = d9v1
            -> _
        }

        #{index-out=zero}
        d9v2 str = hex-chars[b & 15]
        #{overflow=wrap}
        out[i * 2 + 1]: {
            ok -> it = d9v2
            -> _
        }
    }
    print(out.to-bytes-str())
}
