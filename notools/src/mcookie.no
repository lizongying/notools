// mcookie.no — mcookie utility
// Generate a 128-bit random cookie (32 hex chars)
// Usage: mcookie

mcookie-run = () {
    state = os.get-pid() ^ os.now-ns()
    hex-chars = '0123456789abcdef'
    out []byte = with-cap(32)
    i <- [0..16): {
        state = state * 1103515245 + 12345
        b = (state >> 16) & 255
        out[i * 2] = hex-chars[(b >> 4) & 15]
        out[i * 2 + 1] = hex-chars[b & 15]
    }
    print(out.to-str())
}
