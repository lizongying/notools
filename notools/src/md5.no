; md5.no — MD5 哈希
; 计算文件或 stdin 的 MD5（十六进制，32 字符）
; 用法：md5 [file...]   无参数时读取 stdin
; 注意：不经 hashutil.do-hash 中转 —— md5x 的 str 返回值跨两层调用
; 且输入超过短字符串阈值时会丢失（B13 变体），直接单层调用则正常
# /notools/src/md5x.md5x

md5-run = () {
    argc = args()
    {
        argc <= 2 -> {

            ; fs.read-file('/dev/stdin') uses stat to get size, which returns 0
            ; for pipes. Use fs.get-line() which uses fgets (no stat needed).
            inp, ok = fs.get-line()
            data = inp.to-bytes()
            h = md5x(data)
            print(h)
        }

        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    fs.is-file(path) == false -> {
                        emsg = 'md5: ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                inp = fs.read-file(path)
                data = inp.to-bytes()
                h = md5x(data)
                line = h - '  ' - path
                print(line)
            }
        }
    }
}
