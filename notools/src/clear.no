// clear.no — clear utility
// Clear the terminal screen
// Usage: clear [-x] [-T TYPE]
//   -x:       do not clear scrollback (E3 capability)
//   -T TYPE:  override terminal type (ignored in this simple impl)
// Output: ANSI clear-screen + cursor-home sequence

clear-run = () {
    argc = args()
    clear-scrollback = true

    i <- [2..argc): {
        a = arg(i)
        a == '-x' -> clear-scrollback = false
        a.starts-with('-T') -> continue
    }

    // ESC[2J = clear entire screen
    // ESC[H  = move cursor to home (top-left)
    // ESC[3J = clear scrollback (xterm extension); only emit when not -x
    io.out('\033[2J')
    io.out('\033[H')
    clear-scrollback == true -> io.out('\033[3J')
    io.out('\n')
}
