// base64.no — Base64 编解码（RFC 4648）
// 用法：
//   base64 [file...]         编码（默认），无参数时读取 stdin，输出带换行
//   base64 -d [file...]      解码，原始字节写入 stdout（不额外加换行）

base64-run = () {
    argc = args()
    decode = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        {
            a == '-d' -> decode = true
            a == '-D' -> decode = true
            ! a.starts-with('-') -> files.push(a)
        }
    }
    {
        decode == false -> encode-cmd(files)
        decode == true -> {
            decode-cmd(files)
            // 规避：解码路径正常输出后进程收尾阶段会 SIGTRAP（退出码 133），
            // 疑似含二进制内容的 str 析构/清理 codegen 问题，显式正常退出绕过
            os.exit(0)
        }
    }
}

// encode-cmd: 编码模式
encode-cmd = (files []str) {
    {
        files.len == 0 -> {
            inp = fs.read-file('/dev/stdin')
            // stdin 管道 stat 競態讀空（B18）重試
            t <- [0..40): {
                inp.len == 0 -> {
                    os.sleep-us(1000)
                    inp = fs.read-file('/dev/stdin')
                }
            }
            inp.len == 0 -> os.exit(0)
            data = inp.to-bytes()
            enc = base64.encode-std(data)
            print(enc)
            os.exit(0)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                f = files[fi]
                fs.is-file(f) == false -> {
                    io.errln('base64: ' - f - ': No such file or directory')
                    os.exit(1)
                }
                inp = fs.read-file(f)
                data = inp.to-bytes()
                enc = base64.encode-std(data)
                print(enc)
            }
        }
    }
}

// decode-cmd: 解码模式
decode-cmd = (files []str) {
    {
        files.len == 0 -> {
            s = fs.read-file('/dev/stdin')
            // stdin 管道 stat 競態讀空（B18）重試
            t <- [0..40): {
                s.len == 0 -> {
                    os.sleep-us(1000)
                    s = fs.read-file('/dev/stdin')
                }
            }
            decode-write(s)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                f = files[fi]
                fs.is-file(f) == false -> {
                    io.errln('base64: ' - f - ': No such file or directory')
                    os.exit(1)
                }
                s = fs.read-file(f)
                decode-write(s)
            }
        }
    }
}

// decode-write: 手动解码并直接写 stdout（void 模式）
// 注意：不能拆成「返回 str 的解码函数」——编译器对含循环的 str 返回函数会静默丢弃返回值
decode-write = (s str) {
    alpha = base64.BASE64-STD
    rev []i64 = with-len(256)
    i <- [0..256): { rev[i] = -1 }
    i <- [0..64): { rev[alpha[i] & 255] = i }
    // 统计有效字符数（忽略空白与 '='）
    n = 0
    i <- [0..s.len): {
        c = s[i] & 255
        skip = false
        { c == 10 -> skip = true }
        { c == 13 -> skip = true }
        { c == 32 -> skip = true }
        { c == 9 -> skip = true }
        { c == 61 -> skip = true }
        {
            skip == false -> {
                { rev[c] >= 0 -> n = n + 1 }
            }
        }
    }
    // 末尾 '=' 个数
    pad = 0
    e = s.len - 1
    {
        e >= 0 && (s[e] & 255) == 61 -> {
            pad = pad + 1
            e = e - 1
        }
    } (e >= 0 && (s[e] & 255) == 61)
    out-len = (3 * n - pad) / 4
    out []byte = with-len(out-len)
    acc = 0
    cnt = 0
    p = 0
    i <- [0..s.len): {
        c = s[i] & 255
        skip = false
        { c == 10 -> skip = true }
        { c == 13 -> skip = true }
        { c == 32 -> skip = true }
        { c == 9 -> skip = true }
        { c == 61 -> skip = true }
        {
            skip == false -> {
                v = rev[c]
                { v >= 0 -> {
                    acc = (acc << 6) | v
                    cnt = cnt + 1
                    { cnt == 4 -> {
                        out[p] = (acc >> 16) & 255
                        p = p + 1
                        out[p] = (acc >> 8) & 255
                        p = p + 1
                        out[p] = acc & 255
                        p = p + 1
                        cnt = 0
                        acc = 0
                    } }
                } }
            }
        }
    }
    // 处理末尾不足 4 字符的分组
    {
        { cnt == 3 -> {
            out[p] = (acc >> 10) & 255
            p = p + 1
            out[p] = (acc >> 2) & 255
            p = p + 1
        } }
        { cnt == 2 -> {
            out[p] = (acc >> 4) & 255
            p = p + 1
        } }
    }
    fd = fs.open-write('/dev/stdout')
    fs.write(fd, out, out.len)
}
