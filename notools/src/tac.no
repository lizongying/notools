; tac.no — tac utility
; Output lines in reverse order
; Usage: tac [file...]
;   No args: reads stdin, outputs lines in reverse
;   Files:   concatenates then outputs in reverse

tac-run = () {
    argc = args()
    files []str
    i <- [2..argc): {
        a = arg(i)
        ! a.starts-with('-') -> files.push(a)
    }

    lines []str

    ; Read all input into a single line list
    {
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            split(content, lines)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                fs.is-file(files[fi]) == false -> {
                    io.errln('tac: ' - files[fi] - ': No such file or directory')
                    continue
                }
                content = fs.read-file(files[fi])
                split(content, lines)
            }
        }
    }

    ; Output in reverse order
    i <- [0..lines.len): {
        idx = lines.len - 1 - i
        print(lines[idx])
    }
}

; split: split content into lines (manual scan for '\n')
split = (content str, lines []str) {
    start = 0
    i <- [0..content.len): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))
            start = i + 1
        }
    }
    start < content.len -> lines.push(content.slice(start, content.len))
}
