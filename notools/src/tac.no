; tac.no — tac utility
; Output lines in reverse order
; Usage: tac [file...]
;   No args: reads stdin, outputs lines in reverse
;   Files:   concatenates then outputs in reverse

tac-run = () {
    argc = os.args().len()
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        ! a.starts-with('-') -> files.push(a)
    }

    lines []str

    ; Read all input into a single line list
    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            split(content, lines)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                fp = files[fi]: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(fp) -> {
                    io.errln('tac: ' - fp - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(fp)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                split(content, lines)
            }
        }
    }

    ; Output in reverse order
    i <- [0..lines.len()): {

        #{overflow=wrap}
        idx = lines.len() - 1 - i
        ln = lines[idx]: {
            ok -> it

            -> ''
        }
        print(ln)
    }
}

; split: split content into lines (manual scan for '\n')
split = (content str, lines []str) {
    start = 0
    i <- [0..content.len()): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len() -> lines.push(content.slice(start, content.len()))
}
