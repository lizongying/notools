// wc.no — wc utility
// Count lines, words, and bytes in files
// Usage: wc [-l] [-w] [-c] [files...]
//   -l: count lines only
//   -w: count words only
//   -c: count bytes only
//   files: files to count (read from stdin if none)

wc-run = () {
    argc = args()

    count-lines = false
    count-words = false
    count-bytes = false
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-l' -> count-lines = true
        a == '-w' -> count-words = true
        a == '-c' -> count-bytes = true
        !a.starts-with('-') -> files.push(a)
    }

    count-lines == false -> {
        count-words == false -> {
            count-bytes == false -> {
                count-lines = true
                count-words = true
                count-bytes = true
            }
        }
    }

    total-lines = 0
    total-words = 0
    total-bytes = 0

    files.len == 0 -> {
        lines, words, bytes = stdin(count-lines, count-words, count-bytes)
        print-result(lines, words, bytes, count-lines, count-words, count-bytes, '')
    }
    files.len > 0 -> {
        i <- [0..files.len): {
            lines, words, bytes = file(files[i], count-lines, count-words, count-bytes)
            print-result(lines, words, bytes, count-lines, count-words, count-bytes, files[i])
            total-lines = total-lines + lines
            total-words = total-words + words
            total-bytes = total-bytes + bytes
        }
        files.len > 1 -> {
            print-result(total-lines, total-words, total-bytes, count-lines, count-words, count-bytes, 'total')
        }
    }
}

stdin = (count-lines bool, count-words bool, count-bytes bool) (lines i64, words i64, bytes i64) {
    content = fs.read-file('/dev/stdin')
    bytes = content.len
    lines = 0
    words = 0

    count-lines -> {
        in-word = false
        i <- [0..content.len): {
            c = content[i]
            is-ws = c == 10 || c == 32 || c == 9 || c == 13
            c == 10 -> lines = lines + 1
            is-ws -> in-word = false
            !is-ws -> {
                !in-word -> {
                    in-word = true
                    words = words + 1
                }
            }
        }
        content.len > 0 -> {
            content[content.len - 1] != 10 -> lines = lines + 1
        }
    }
    !count-lines && count-words -> {
        in-word = false
        i <- [0..content.len): {
            c = content[i]
            is-ws = c == 10 || c == 32 || c == 9 || c == 13
            c == 10 -> lines = lines + 1
            is-ws -> in-word = false
            !is-ws -> {
                !in-word -> {
                    in-word = true
                    words = words + 1
                }
            }
        }
        content.len > 0 -> {
            content[content.len - 1] != 10 -> lines = lines + 1
        }
    }

    !count-lines -> lines = 0
    !count-words -> words = 0
    !count-bytes -> bytes = 0
}

file = (file str, count-lines bool, count-words bool, count-bytes bool) (lines i64, words i64, bytes i64) {
    content = fs.read-file(file)
    bytes = content.len
    lines = 0
    words = 0

    count-lines -> {
        in-word = false
        i <- [0..content.len): {
            c = content[i]
            is-ws = c == 10 || c == 32 || c == 9 || c == 13
            c == 10 -> lines = lines + 1
            is-ws -> in-word = false
            !is-ws -> {
                !in-word -> {
                    in-word = true
                    words = words + 1
                }
            }
        }
        content.len > 0 -> {
            content[content.len - 1] != 10 -> lines = lines + 1
        }
    }
    !count-lines && count-words -> {
        in-word = false
        i <- [0..content.len): {
            c = content[i]
            is-ws = c == 10 || c == 32 || c == 9 || c == 13
            c == 10 -> lines = lines + 1
            is-ws -> in-word = false
            !is-ws -> {
                !in-word -> {
                    in-word = true
                    words = words + 1
                }
            }
        }
        content.len > 0 -> {
            content[content.len - 1] != 10 -> lines = lines + 1
        }
    }

    !count-lines -> lines = 0
    !count-words -> words = 0
    !count-bytes -> bytes = 0
}

// pad8: right-align integer in 8-character field (space-padded)
pad8 = (n i64) (out str) {
    raw = n.to-str()
    pad-count = 8 - raw.len
    {
        pad-count > 0 -> {
            spaces = '        '
            out = spaces.slice(0, pad-count) - raw
        }
        -> out = raw
    }
}

print-result = (lines i64, words i64, bytes i64, show-lines bool, show-words bool, show-bytes bool, name str) {
    show-lines -> io.out(pad8(lines))
    show-words -> io.out(pad8(words))
    show-bytes -> io.out(pad8(bytes))
    name.len > 0 -> {
        prefix = ' ' - name
        io.out(prefix)
    }
    print('')
}
