; hostname.no — hostname utility
; Print the system hostname
; Usage: hostname [-s] [-f]
;   -s: short name (up to the first dot)
;   -f: long name (default)

hostname-run = () {
    argc = os.args()
    short = false

    i <- [2..argc): {
        a = os.arg(i)
        a == '-s' -> short = true
        a == '-f' -> short = false
    }

    name = os.host-name()
    {
        short -> {
            pos = name.index('.')
            pos >= 0 -> name = name.slice(0, pos)
        }
    }
    print(name)
}
