// touch.no — touch utility
// Creates empty files or updates file timestamps
// Usage: touch <file...>
//   - If file does not exist: creates an empty file
//   - If file exists: updates access and modification times to current time

touch-run = () {
    argc = args()

    {
        argc < 3 -> {
            print('Usage: touch <file...>')
            os.exit(1)
        }
    }

    i <- [2..argc): {
        path = arg(i)

        {
            fs.is-file(path) -> {
                // File exists: update timestamp
                ok = fs.touch-file(path)
                {
                    ok == false -> {
                        io.errln('touch: ' - path - ': failed to update timestamp')
                    }
                }
            }
            -> {
                // File does not exist: create empty file
                fd = fs.open-write(path)
                {
                    fd < 0 -> {
                        io.errln('touch: ' - path - ': cannot create file')
                    }
                    -> {
                        fs.close(fd)
                    }
                }
            }
        }
    }
}
