; touch.no — touch utility
; Creates empty files or updates file timestamps
; Usage: touch <file...>

touch-run = () {
    argc = args()

    has-file = false

    i <- [2..argc): {
        a = arg(i)
        ! a.starts-with('-') -> {
            has-file = true
            path = a

            {
                fs.is-file(path) -> {
                    ok = fs.touch-file(path)
                    ! ok -> {
                        #{overflow=wrap}
                        msg = 'touch: ' - path - ': failed to update timestamp'
                        io.errln(msg)
                    }
                }

                -> {
                    fd = fs.open-write(path)
                    fd < 0 -> {
                        #{overflow=wrap}
                        msg = 'touch: ' - path - ': cannot create file'
                        io.errln(msg)
                    }
                    fd >= 0 -> {
                        fs.close(fd)
                    }
                }
            }
        }
    }

    {
        ! has-file -> {
            io.errln('Usage: touch <file...>')
            os.exit(1)
        }
    }
}
