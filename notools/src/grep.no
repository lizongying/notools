// grep.no — grep utility
// Search for patterns in files or stdin
// Usage: grep [-n] pattern [files...]
//   -n: show line numbers

grep-run = () {
    argc = args()

    show-line-num = false
    pattern = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-n' -> show-line-num = true
        !a.starts-with('-') -> {
            {
                pattern.len == 0 -> pattern = a
                -> files.push(a)
            }
        }
    }

    pattern.len == 0 -> {
        print('grep: no pattern specified')
        os.exit(1)
    }

    files.len == 0 -> {
        content = fs.read-file('/dev/stdin')
        grep-search(content, pattern, show-line-num, false, '')
    }
    files.len > 0 -> {
        i <- [0..files.len): {
            ! fs.is-file(files[i]) -> {
                print('grep: ' - files[i] - ': No such file or directory')
                os.exit(1)
            }
            content = fs.read-file(files[i])
            grep-search(content, pattern, show-line-num, files.len > 1, files[i])
        }
    }
}

grep-search = (content str, pattern str, show-line-num bool, show-filename bool, filename str) {
    lines = content.split('\n')
    i <- [0..lines.len): {
        line = lines[i]
        pos = line.index(pattern)
        pos >= 0 -> {
            show-filename -> printf('%s:', filename)
            show-line-num -> printf('%d:', i + 1)
            print(line)
        }
    }
}
