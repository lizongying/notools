; grep.no — grep utility
; Search for patterns in files or stdin
; Usage: grep [-n] pattern [files...]
;   -n: show line numbers

grep-run = () {
    argc = args()

    show-line-num = false
    pattern = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-n' -> show-line-num = true
        ! a.starts-with('-') -> {
            {
                pattern.len-bytes() == 0 -> pattern = a

                -> files.push(a)
            }
        }
    }

    {
        pattern.len-bytes() == 0 -> {
            print('grep: no pattern specified')
            os.exit(1)
        }

        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            search(content, pattern, show-line-num, false, '')
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {

                #{index-out=0}
                f = files[fi]
                ! fs.is-file(f) -> {
                    #{overflow=wrap}
                    print('grep: ' - f - ': No such file or directory')
                    os.exit(1)
                }
                content = ''
                r = fs.read-str(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                search(content, pattern, show-line-num, files.len() > 1, f)
            }
        }
    }
}

search = (content str, pattern str, show-line-num bool, show-filename bool, filename str) {
    lines []str
    start = 0
    i <- [0..content.len-bytes()): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len-bytes() -> lines.push(content.slice(start, content.len-bytes()))
    j <- [0..lines.len()): {

        #{index-out=0}
        line = lines[j]
        pos = line.index(pattern)
        pos >= 0 -> {
            show-filename -> {
                prefix = filename - ':'
                io.out(prefix)
            }
            show-line-num -> {

                #{overflow=wrap}
                lineno = j + 1
                #{overflow=wrap}
                io.out(lineno.to-str() - ':')
            }
            print(line)
        }
    }
}
