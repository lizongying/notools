; xargs.no — xargs utility
; Build and execute command lines from stdin
; Usage: xargs [-0] [-I REPL] [-n MAX] [-t] [-r] COMMAND [INITIAL-ARGS...]
;   -0: input items are NUL-terminated
;   -I REPL: replace REPL string in command with input item
;   -n MAX: use at most MAX args per command
;   -t: print command to stderr before executing
;   -r: do not run if no input

; split-input: read stdin and split into tokens
; mode 0 = whitespace, mode 1 = NUL
; Note: returns tokens via input parameter (output-param slice push is buggy in codegen)
split-input = (mode i64, tokens []str) {
    content = ''
    r = fs.read-stdin-str()
    r: {
        ok -> content = it
        nil -> {
        }
        err -> {
        }
    }
    {
        content.len == 0 -> return

        mode == 1 -> {

            ; NUL-separated
            start = 0
            i <- [0..content.len): {
                content[i] == 0 -> {
                    tokens.push(content.slice(start, i))
                    start = i + 1
                }
            }
            start < content.len -> tokens.push(content.slice(start, content.len))
        }

        mode == 0 -> {

            ; Whitespace-separated
            start = 0
            in-field = false
            i <- [0..content.len): {
                c = content[i]
                is-space = c == 32 || c == 9 || c == 10 || c == 13
                is-space && in-field -> {
                    tokens.push(content.slice(start, i))
                    in-field = false
                }
                ! is-space && ! in-field -> {
                    start = i
                    in-field = true
                }
            }
            in-field -> tokens.push(content.slice(start, content.len))
        }
    }
}

; run-cmd: build and run a command string via sh -c, returns exit code
run-cmd = (cmd str, trace bool) (code i64) {
    {
        trace == true -> {
            eprint(cmd)
        }
    }
    pid = spawn(cmd)
    {
        pid < 0 -> {
            eprint('xargs: failed to spawn command')
            code = 1
            return
        }
    }
    code = wait(pid)
}

; join: join a vec of strings with separator
join = (parts []str, sep str) (out str) {
    n = parts.len
    n == 0 -> return
    out = parts[0]
    i <- [1..n): {
        out = out - sep - parts[i]
    }
}

xargs-run = () {
    argc = args()

    mode = 0
    replace-str = ''
    max-args = 0
    trace = false
    no-run-if-empty = false
    cmd-start = 2

    i <- [2..argc): {
        a = arg(i)
        a == '-0' -> mode = 1
        a == '-t' -> trace = true
        a == '-r' -> no-run-if-empty = true
        a == '--no-run-if-empty' -> no-run-if-empty = true
        a == '-I' -> {
            i = i + 1
            i < argc -> replace-str = arg(i)
            cmd-start = i + 1
        }
        a.starts-with('-I') && a.len > 2 -> {
            replace-str = a.slice(2, a.len)
        }
        a == '-n' -> {
            i = i + 1
            i < argc -> {
                v = arg(i).to-i64()
                v: {
                    ok -> max-args = it

                    nil -> *

                    err -> *
                }
            }
            cmd-start = i + 1
        }
        a.starts-with('-n') && a.len > 2 -> {
            s = a.slice(2, a.len)
            n = 0
            j <- [0..s.len): {
                c = s[j]
                c >= 48 && c <= 57 -> n = n * 10 + (c - 48)
            }
            n > 0 -> max-args = n
        }
        ! a.starts-with('-') -> {
            cmd-start = i
            break
        }
    }

    ; Build base command from remaining args
    base-args []str
    i <- [cmd-start..argc): {
        base-args.push(arg(i))
    }

    ; If no command, default to /bin/echo
    {
        base-args.len == 0 -> {
            base-args.push('echo')
        }
    }

    ; Read tokens from stdin
    tokens []str = with-cap(64)
    split-input(mode, tokens)

    {
        tokens.len == 0 -> {
            no-run-if-empty -> os.exit(0)
            ; Run command with no extra args
            cmd = join(base-args, ' ')
            code = run-cmd(cmd, trace)
            os.exit(code)
        }

        ; Mode 1: -I replace mode
        replace-str.len > 0 -> {
            j <- [0..tokens.len): {
                parts []str
                k <- [0..base-args.len): {
                    arg-str = base-args[k]
                    arg-str == replace-str -> {
                        parts.push(tokens[j])
                    }
                    arg-str != replace-str -> {

                        ; Check if replace-str is substring
                        pos = arg-str.index(replace-str)
                        pos >= 0 -> {

                            ; Replace all occurrences
                            result = ''
                            start = 0
                            {
                                result = result - arg-str.slice(start, pos)
                                result = result - tokens[j]
                                start = pos + replace-str.len
                                pos = arg-str.index-from(replace-str, start)
                            } (pos >= 0)
                            result = result - arg-str.slice(start, arg-str.len)
                            parts.push(result)
                        }
                        pos < 0 -> {
                            parts.push(arg-str)
                        }
                    }
                }
                cmd = join(parts, ' ')
                code = run-cmd(cmd, trace)
                code != 0 -> os.exit(code)
            }
            os.exit(0)
        }

        ; Mode 2: -n max-args mode
        max-args > 0 -> {
            idx = 0
            {
                idx < tokens.len -> {
                    batch []str
                    k <- [0..base-args.len): {
                        batch.push(base-args[k])
                    }
                    end = idx + max-args
                    end > tokens.len -> end = tokens.len
                    k <- [idx..end): {
                        batch.push(tokens[k])
                    }
                    cmd = join(batch, ' ')
                    code = run-cmd(cmd, trace)
                    code != 0 -> os.exit(code)
                    idx = idx + max-args
                }
            } (idx < tokens.len)
            os.exit(0)
        }
    }

    ; Mode 3: default — all tokens at once
    all-args []str
    k <- [0..base-args.len): {
        all-args.push(base-args[k])
    }
    k <- [0..tokens.len): {
        all-args.push(tokens[k])
    }
    cmd = join(all-args, ' ')
    code = run-cmd(cmd, trace)
    os.exit(code)
}
