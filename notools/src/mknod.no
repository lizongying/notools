; mknod.no — mknod utility
; Create special files (FIFO, character device, block device)
; Usage: mknod PATH TYPE [MAJOR MINOR]

mknod-parse-int = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
mknod-run = () {
    argc = args()
    {
        argc < 4 -> {
            eprint('Usage: mknod PATH TYPE [MAJOR MINOR]')
            os.exit(1)
        }
    }
    path = arg(2)
    typ = arg(3)
    {
        typ == 'p' -> {

            ; FIFO: use fs.mkfifo
            ok = os.mkfifo(path, 438)
            ok == false -> {
                eprint('mknod: cannot create ' - path)
                os.exit(1)
            }
        }

        typ == 'c' -> {

            ; character device: requires mknod syscall (not available in this compiler)
            eprint('mknod: device node creation not supported')
            os.exit(1)
        }

        typ == 'b' -> {

            ; block device: requires mknod syscall (not available in this compiler)
            eprint('mknod: device node creation not supported')
            os.exit(1)
        }

        -> {
            eprint('mknod: invalid device type ' - typ)
            os.exit(1)
        }
    }
}

#{win-amd64, win-arm64}
mknod-run = () {
    eprint('mknod-run: not supported on this platform')
    os.exit(1)
}
