; mknod.no — mknod utility
; Create special files (FIFO, character device, block device)
; Usage: mknod PATH TYPE [MAJOR MINOR]

mknod-parse-int = (s str) (v i64) {
    v = 0
    i <- [0..s.len()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
mknod-run = () {
    argc = os.args()
    {
        argc < 4 -> {
            print("N")
            exit(1)
        }
    }
    path = os.arg(2)
    typ = os.arg(3)
    {
        typ == 'p' -> {

            ; FIFO: use fs.mkfifo
            ok = os.mkfifo(path, 438)
            ! ok -> {
                print("N")
                exit(1)
            }
        }

        typ == 'c' -> {

            ; character device: requires mknod syscall (not available in this compiler)
            print("N")
            exit(1)
        }

        typ == 'b' -> {

            ; block device: requires mknod syscall (not available in this compiler)
            print("N")
            exit(1)
        }

        -> {
            print("N")
            exit(1)
        }
    }
}

#{win-amd64, win-arm64}
mknod-run = () {
    print("N")
    exit(1)
}
