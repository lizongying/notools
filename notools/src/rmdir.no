; rmdir.no — rmdir utility
; Remove empty directories
; Usage: rmdir DIR...

rmdir-run = () {
    argc = os.args()
    {
        argc < 3 -> {
            eprint('Usage: rmdir DIR...')
            os.exit(1)
        }
    }
    had-error = false
    i <- [2..argc): {
        dir = os.arg(i)
        ok = os.rmdir(dir)
        ! ok -> {
            eprint('rmdir: failed to remove ' - dir)
            had-error = true
        }
    }
    had-error -> os.exit(1)
}
