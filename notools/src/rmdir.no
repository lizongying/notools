// rmdir.no — rmdir utility
// Remove empty directories
// Usage: rmdir DIR...

rmdir-run = () {
    argc = args()
    argc < 3 -> {
        eprint('Usage: rmdir DIR...')
        os.exit(1)
    }
    had-error = false
    i <- [2..argc): {
        dir = arg(i)
        ok = os.rmdir(dir)
        ok == false -> {
            eprint('rmdir: failed to remove ' - dir)
            had-error = true
        }
    }
    had-error -> os.exit(1)
}
