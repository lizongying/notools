; rmdir.no — rmdir utility
; Remove empty directories
; Usage: rmdir DIR...

rmdir-run = () {
    argc = os.args().len()
    {
        argc < 3 -> {
            eprint('Usage: rmdir DIR...')
            exit(1)
        }
    }
    had-error = false
    i <- [2..argc): {
        dir-opt = os.arg(i)
        dir = dir-opt: {
            ok -> it

            -> ''
        }
        ok = os.rmdir(dir)
        ! ok -> {
            eprint('rmdir: failed to remove ' - dir)
            had-error = true
        }
    }
    had-error -> exit(1)
}
