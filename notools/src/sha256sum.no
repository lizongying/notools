; sha256sum.no — sha256sum utility (coreutils alias)
; Compute SHA-256 checksums
; Usage: sha256sum [FILE...]   (no FILE: read stdin)
;        sha256sum -c CHECKFILE   (verify checksums)
# /notools/src/hashutil.do-hash

sha256sum-run = () {
    argc = args()
    {
        argc >= 3 -> {
            arg(2) == '-c' -> {
                checkfile = arg(3)
                content = ''
                rc = fs.read-str(checkfile)
                rc: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                lines []str
                start = 0
                i <- [0..content.len-bytes()): {
                    content[i] == 10 -> {
                        lines.push(content.slice(start, i))

                        #{overflow=wrap}
                        start = i + 1
                    }
                }
                start < content.len-bytes() -> lines.push(content.slice(start, content.len-bytes()))
                any-failed = false
                i <- [0..lines.len()): {
                    line = lines[i]
                    line.len() == 0 -> *
                    sp = line.index('  ')
                    sp < 0 -> *
                    expected = line.slice(0, sp)
                    #{overflow=wrap}
                    fname = line.slice(sp + 2, line.len())
                    ! fs.is-file(fname) -> {
                        #{overflow=wrap}
                        print(fname - ': FAILED (no such file)')
                        any-failed = true
                        *
                    }
                    cinp []byte
                    rcb = fs.read-bytes(fname)
                    rcb: {
                        ok -> cinp = it

                        nil -> {
                        }

                        err -> {
                        }
                    }
                    cdata = cinp
                    actual = do-hash('sha256', cdata)
                    {
                        actual == expected -> {
                            #{overflow=wrap}
                            print(fname - ': OK')
                        }

                        -> {
                            #{overflow=wrap}
                            print(fname - ': FAILED')
                            any-failed = true
                        }
                    }
                }
                any-failed -> os.exit(1)
                return
            }
        }
    }
    {
        argc <= 2 -> {
            sinp []byte
            sr = fs.read-stdin()
            sr: {
                ok -> sinp = it

                nil -> {
                }

                err -> {
                }
            }
            sdata = sinp
            h = do-hash('sha256', sdata)
            #{overflow=wrap}
            print(h - '  -')
        }

        -> {
            i <- [2..argc): {
                path = arg(i)
                ! fs.is-file(path) -> {
                    #{overflow=wrap}
                    eprint('sha256sum: ' - path - ': No such file')
                    os.exit(1)
                }
                finp []byte
                fr = fs.read-bytes(path)
                fr: {
                    ok -> finp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                fdata = finp
                h = do-hash('sha256', fdata)

                #{overflow=wrap}
                print(h - '  ' - path)
            }
        }
    }
}
