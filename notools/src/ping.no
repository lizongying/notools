// ping.no — send ICMP ECHO_REQUEST (pure Nolang, built-in net.ping)
// Usage: ping [-c count] <host>
//
// Uses the standard-library ICMP implementation (net.ping / net.ping-count),
// which builds the Echo packet and computes the checksum in pure Nolang and
// sends it over a (SOCK_DGRAM on macOS / SOCK_RAW on Linux) ICMP socket.
// No system `ping` binary and no libc shell-out is involved.
//
// Note: net.ping-count expects an IP address (it does NOT do DNS). Hostname
// resolution currently crashes the compiler's dns-resolve, so pass an IP or
// wait for the DNS bug to be fixed. See NOLANG_STDLIB_ISSUES.md.

ping-run = () {
    argc = args()
    argc < 3 -> {
        print('Usage: ping [-c count] <host>')
        os.exit(1)
    }
    count = 4
    host = ''
    i <- [2..argc): {
        a = arg(i)
        a == '-c' -> { i + 1 < argc -> count = atoi(arg(i + 1)) }
        a.starts-with('-c') -> a.len > 2 -> count = atoi(a.slice(2, a.len))
        ! a.starts-with('-') -> host = a
    }
    host == '' -> {
        print('Usage: ping [-c count] <host>')
        os.exit(1)
    }
    net.ping-count(host, count)
}
