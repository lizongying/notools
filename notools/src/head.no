; head.no — head utility
; Output the first part of files
; Usage: head [-n N] [-c N] [-N] [file...]
;   -n N / -N: print the first N lines (default 10)
;   -c N:      print the first N bytes

; atoi parses a decimal string via the standard library (str.to-i64),
; yielding 0 for empty / non-numeric / out-of-range input.
atoi = (s str) (v i64) {
    r = s.to-i64()
    r: {
        ok -> v = it

        nil -> v = 0

        err -> v = 0
    }
}

; parse-count accepts an optional leading '-' then digits.
parse-count = (s str) (v i64) {
    slen = s.len-bytes()
    neg = false
    off = 0
    {
        slen > 0 && s[0] == 45 -> {
            neg = true
            off = 1
        }

        -> {
        }
    }
    v = atoi(s.slice(off, slen))
    {
        neg -> {

            #{overflow=wrap}
            v = 0 - v
        }

        -> {
        }
    }
}

; head-emit-bytes: output raw bytes (byte mode)
head-emit-bytes = (data []byte, cbytes i64) {
    n = data.len()
    end = cbytes
    end > n -> end = n
    {
        end > 0 -> {
            fd = fs.open-write('/dev/stdout')
            fs.write(fd, data, end)
            fs.close(fd)
        }

        -> {
        }
    }
}

; head-emit: output content respecting n (lines)
head-emit = (content str, n i64) {
    clen = content.len-bytes()
    start = 0
    count = 0
    i <- [0..clen): {
        {
            content[i] == 10 -> {
                {
                    count < n -> print(content.slice(start, i))

                    -> {
                    }
                }

                #{overflow=wrap}
                start = i + 1

                #{overflow=wrap}
                count = count + 1
            }

            -> {
            }
        }
    }
    {
        start < clen -> {
            count < n -> print(content.slice(start, clen))

            -> {
            }
        }

        -> {
        }
    }
}

head-run = () {
    argc = os.args()
    n = 10
    cbytes = -999999
    cset = false
    files []str
    i <- [2..argc): {
        a = os.arg(i)

        #{overflow=wrap}
        prev = os.arg(i - 1)
        {
            prev == '-n' || prev == '-c' -> {
            }

            -> {
                a == '-n' -> {

                    #{overflow=wrap}
                    i + 1 < argc -> {
                        n = parse-count(os.arg(i + 1))
                    }
                }

                a == '-c' -> {

                    #{overflow=wrap}
                    i + 1 < argc -> {
                        cset = true
                        cbytes = parse-count(os.arg(i + 1))
                    }
                }

                a.starts-with('-') -> {
                    a != '-n' && a != '-c' -> {
                        alen = a.len-bytes()
                        {
                            alen > 2 && a[1] == 99 -> {
                                cset = true
                                cbytes = parse-count(a.slice(2, alen))
                            }

                            -> {
                                alen > 1 -> n = parse-count(a.slice(1, alen))

                                -> {
                                }
                            }
                        }
                    }

                    -> {
                    }
                }

                ! a.starts-with('-') -> files.push(a)

                -> {
                }
            }
        }
    }

    ; BSD head: -c requires a positive byte count
    {
        cset && cbytes <= 0 -> {
            io.errln('head: illegal byte count -- ' - cbytes.to-str())
            os.exit(1)
        }

        -> {
        }
    }
    {
        n < 0 -> n = 0
    }
    {
        cset -> {

            ; byte mode
            {
                files.len() == 0 -> {
                    raw []byte
                    r = fs.read-stdin()
                    r: {
                        ok -> raw = it

                        nil -> {
                        }

                        err -> {
                        }
                    }
                    head-emit-bytes(raw, cbytes)
                }

                -> {
                    fi <- [0..files.len()): {
                        ! fs.is-file(files[fi]) -> {
                            io.errln('head: ' - files[fi] - ': No such file or directory')
                            continue
                        }
                        {
                            files.len() > 1 -> {
                                {
                                    fi > 0 -> print('') -> {}
                                }
                                print('==> ' - files[fi] - ' <==')
                            }

                            -> {
                            }
                        }
                        raw []byte
                        r = fs.read-bytes(files[fi])
                        r: {
                            ok -> raw = it

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        head-emit-bytes(raw, cbytes)
                    }
                }
            }
        }

        -> {

            ; line mode
            {
                files.len() == 0 -> {
                    content = ''
                    r = fs.read-stdin-str()
                    r: {
                        ok -> content = it

                        nil -> {
                        }

                        err -> {
                        }
                    }
                    head-emit(content, n)
                }

                -> {
                    fi <- [0..files.len()): {
                        ! fs.is-file(files[fi]) -> {
                            io.errln('head: ' - files[fi] - ': No such file or directory')
                            continue
                        }
                        {
                            files.len() > 1 -> {
                                {
                                    fi > 0 -> print('') -> {}
                                }
                                print('==> ' - files[fi] - ' <==')
                            }

                            -> {
                            }
                        }
                        content = ''
                        r = fs.read-str(files[fi])
                        r: {
                            ok -> content = it

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        head-emit(content, n)
                    }
                }
            }
        }
    }
}
