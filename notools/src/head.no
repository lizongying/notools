; head.no — head utility
; Output the first part of files
; Usage: head [-n N] [-N] [file...]
;   -n N / -N: print the first N lines (default 10)

; atoi parses a decimal string via the standard library (str.to-i64),
; yielding 0 for empty / non-numeric / out-of-range input.
atoi = (s str) (v i64) {
    r = s.to-i64()
    r: {
        ok -> v = it

        nil -> v = 0

        err -> v = 0
    }
}

head-run = () {
    argc = args()
    n = 10
    files []str
    i <- [2..argc): {
        a = arg(i)

        #{overflow=wrap}
        prev = arg(i - 1)
        prev == '-n' -> {
            continue
        }
        a == '-n' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                n = atoi(arg(i + 1))
            }
        }
        a.starts-with('-') -> {
            a != '-n' -> {
                a.len-bytes() > 1 -> n = atoi(a.slice(1, a.len-bytes()))
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        n < 0 -> n = 0

        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            start = 0
            count = 0
            i <- [0..content.len-bytes()): {
                content[i] == 10 -> {
                    count < n -> print(content.slice(start, i))

                    #{overflow=wrap}
                    start = i + 1
                    #{overflow=wrap}
                    count = count + 1
                }
            }
            start < content.len-bytes() -> {
                count < n -> print(content.slice(start, content.len-bytes()))
            }
        }

        files.len() > 0 -> {
            i <- [0..files.len()): {
                ! fs.is-file(files[i]) -> {
                    #{overflow=wrap}
                    io.errln('head: ' - files[i] - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(files[i])
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                start = 0
                count = 0
                k <- [0..content.len-bytes()): {
                    content[k] == 10 -> {
                        count < n -> print(content.slice(start, k))
                        #{overflow=wrap}
                        start = k + 1
                        #{overflow=wrap}
                        count = count + 1
                    }
                }
                start < content.len-bytes() -> {
                    count < n -> print(content.slice(start, content.len-bytes()))
                }
            }
        }
    }
}
