; head.no — head utility
; Output the first part of files
; Usage: head [-n N] [-N] [file...]
;   -n N / -N: print the first N lines (default 10)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= "0" && c <= "9" -> v = v * 10 + (c - "0")
    }
}

head-run = () {
    argc = args()
    n = 10
    files []str
    i <- [2..argc): {
        a = arg(i)
        prev = arg(i - 1)
        prev == '-n' -> {
            continue
        }
        a == '-n' -> {
            i + 1 < argc -> {
                n = atoi(arg(i + 1))
            }
        }
        a.starts-with('-') -> {
            a != '-n' -> {
                a.len > 1 -> n = atoi(a.slice(1, a.len))
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        n < 0 -> n = 0

        files.len == 0 -> {
            content str = fs.read-file('/dev/stdin')
            start = 0
            count = 0
            i <- [0..content.len): {
                content[i] == 10 -> {
                    count < n -> print(content.slice(start, i))
                    start = i + 1
                    count = count + 1
                }
            }
            start < content.len -> {
                count < n -> print(content.slice(start, content.len))
            }
        }

        files.len > 0 -> {
            i <- [0..files.len): {
                fs.is-file(files[i]) == false -> {
                    io.errln('head: ' - files[i] - ': No such file or directory')
                    continue
                }
                content str = fs.read-file(files[i])
                start = 0
                count = 0
                k <- [0..content.len): {
                    content[k] == 10 -> {
                        count < n -> print(content.slice(start, k))
                        start = k + 1
                        count = count + 1
                    }
                }
                start < content.len -> {
                    count < n -> print(content.slice(start, content.len))
                }
            }
        }
    }
}
