; strings.no — strings utility
; 從檔案中提取可列印字串序列（預設最短 4 字元）。
; 可列印字元定義：ASCII 32..126（含空白，不含控制字元）。
; Usage: strings [-n <len>] [files...]
;   -n <len>: 最短字串長度（預設 4）

strings = () {
    argc = args()

    min-len = 4
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-n' -> {
            i = i + 1
            i < argc -> {
                len-str = arg(i)
                n = 0
                j <- [0..len-str.len): {
                    c = len-str[j]
                    n = n * 10 + (c - 48)
                }
                min-len = n
            }
        }
        !a.starts-with('-') -> files.push(a)
    }

    {
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            strings-extract(content, min-len)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                ! fs.is-file(files[fi]) -> {
                    eprint('strings: ' - files[fi] - ': No such file')
                    os.exit(1)
                }
                content = fs.read-file(files[fi])
                strings-extract(content, min-len)
            }
        }
    }
}

strings-extract = (content str, min-len i64) {
    start = 0
    i <- [0..content.len): {
        c = content[i]
        printable = c >= 32 && c <= 126
        printable == false -> {
            len = i - start
            len >= min-len -> {
                io.outln(content.slice(start, i))
            }
            start = i + 1
        }
    }
    last-len = content.len - start
    {
        last-len >= min-len -> {
            io.outln(content.slice(start, content.len))
        }
    }
}
