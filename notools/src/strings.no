; strings.no — strings utility
; 從檔案中提取可列印字串序列（預設最短 4 字元）。
; 可列印字元定義：ASCII 32..126（含空白，不含控制字元）。
; Usage: strings [-n <len>] [files...]
;   -n <len>: 最短字串長度（預設 4）

strings = () {
    argc = os.args().len()

    min-len = 4
    files []str

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-n' -> {

            #{overflow=wrap}
            i = i + 1
            i < argc -> {
                len-str-opt = os.arg(i)
                len-str = len-str-opt: {
                    ok -> it

                    -> ''
                }
                n = 0
                j <- [0..len-str.len()): {
                    c = len-str[j]

                    #{overflow=wrap}
                    n = n * 10 + (c - 48)
                }
                min-len = n
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            strings-extract(content, min-len)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                fname = files[fi]: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(fname) -> {
                    fp = files[fi]: {
                        ok -> it

                        -> ''
                    }
                    eprint('strings: ' - fp - ': No such file')
                    exit(1)
                }
                content = ''
                r = fs.read-str(fname)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                strings-extract(content, min-len)
            }
        }
    }
}

strings-extract = (content str, min-len i64) {
    start = 0
    i <- [0..content.len()): {
        c = content[i]: {
            ok -> it

            -> 0
        }
        printable bool = c >= 32 && c <= 126
        ! printable -> {

            #{overflow=wrap}
            len = i - start
            len >= min-len -> {
                io.outln(content.slice(start, i))
            }

            #{overflow=wrap}
            start = i + 1
        }
    }

    #{overflow=wrap}
    last-len = content.len() - start
    {
        last-len >= min-len -> {
            io.outln(content.slice(start, content.len()))
        }
    }
}
