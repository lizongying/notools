; hexdump.no — hexdump utility (BSD/macOS /usr/bin/hexdump compatible)
; Usage: hexdump [-C] [-v] [-n LENGTH] [-s OFFSET] [file]
;   -C  canonical hex+ASCII display
;   -v  do not collapse identical lines to '*'
;   -n  only LENGTH bytes
;   -s  skip OFFSET bytes from the start

# /notools/src/hexdump.hexdump

atoi = (s str) (v i64) {
    v = 0

    #{overflow=wrap}
    i <- [0..s.len-bytes()): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

; safe arithmetic wrappers (overflow=wrap only binds at function-body top level,
; so +/-/*/% inside loop/conditional arms must go through these).
safe-add = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    r = a + b
}

safe-mod = (a i64, b i64) (r i64) {

    #{overflow=wrap}
    r = a % b
}

; lowercase hex, left-padded with zeros to at least w digits.
addrhex = (v i64, w i64) (s str) {
    hx = '0123456789abcdef'
    s = ''
    x = v
    x == 0 -> s = '0'
    (x > 0) {
        d = x & 15
        dc char = hx.byte(d) & 255
        s = dc.to-str() - s
        x = x >> 4
    }

    #{overflow=wrap}
    pad = w - s.len-bytes()
    pad > 0 -> s = '0'.repeat(pad) - s
}

hexdump-run = () {
    argc = args()
    canonical = false
    vflag = false
    length = -1
    skip = 0
    files []str
    skip-next = false
    i <- [2..argc): {
        handled = false
        {
            skip-next -> {
                skip-next = false
                handled = true
            }
        }
        {
            ! handled -> {
                a = arg(i)
                {
                    a == '-C' -> {
                        canonical = true
                        handled = true
                    }

                    a == '-v' -> {
                        vflag = true
                        handled = true
                    }

                    a == '-n' -> {

                        #{overflow=wrap}
                        i + 1 < argc -> {
                            length = atoi(arg(i + 1))
                            skip-next = true
                        }
                        handled = true
                    }

                    a == '-s' -> {

                        #{overflow=wrap}
                        i + 1 < argc -> {
                            skip = atoi(arg(i + 1))
                            skip-next = true
                        }
                        handled = true
                    }

                    a.starts-with('-n') -> {
                        a.len-bytes() > 2 -> {
                            length = atoi(a.slice(2, a.len-bytes()))
                            handled = true
                        }
                    }

                    a.starts-with('-s') -> {
                        a.len-bytes() > 2 -> {
                            skip = atoi(a.slice(2, a.len-bytes()))
                            handled = true
                        }
                    }
                }
                {
                    ! handled -> ! a.starts-with('-') -> files.push(a)
                }
            }
        }
    }

    data []byte
    {
        files.len() == 0 -> {
            inp []byte
            r = fs.read-stdin()
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            data = inp
        }

        -> {
            fi <- [0..files.len()): {

                #{index-out=zero}
                f = files[fi]
                ! fs.is-file(f) -> {
                    io.errln('hexdump: ' - f - ': No such file or directory')
                    os.exit(1)
                }
                inp []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> inp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                b = inp
                k <- [0..b.len()): {
                    data.push(b[k])
                }
            }
        }
    }

    n = data.len()
    start-off = skip
    {
        start-off > n -> start-off = n
    }
    end-off = n
    {
        length >= 0 -> {

            #{overflow=wrap}
            end-off = start-off + length
            end-off > n -> end-off = n
        }
    }

    {
        canonical -> render-canonical(data, start-off, end-off, vflag)

        -> render-default(data, start-off, end-off, vflag)
    }
}

; render-canonical: BSD hexdump -C layout
; 00000000  XX XX XX XX XX XX XX XX  XX XX XX XX XX XX XX XX  |................|
; 8-hex offset, 2 spaces, 50-col hex region (2 groups of 8), then |ascii| (padded
; hex region only; ascii is exactly the line's bytes). A final total-offset line.
render-canonical = (data []byte, s i64, e i64, vf bool) {
    hx = '0123456789abcdef'
    space = ' '
    offset = s
    have = false
    supp = false
    prev = ''
    (offset < e) {

        #{overflow=wrap}
        ln = e - offset
        ln > 16 -> ln = 16

        ; hex region: fixed 50 cols, bytes right-placed at stride 3 (+1 group gap)
        reg = space.repeat(50)
        key = ''
        j <- [0..ln): {

            #{overflow=wrap}
            b = data[offset + j] & 255

            #{overflow=wrap}
            r0 = 3 * j
            j >= 8 -> {

                #{overflow=wrap}
                r0 = r0 + 1
            }
            reg[r0] = hx[(b >> 4) & 15]

            #{overflow=wrap}
            reg[r0 + 1] = hx[b & 15]

            ; ascii + collapse key
            {
                b >= 32 && b < 127 -> {
                    bc char = b
                    key = key - bc.to-str()
                }

                -> key = key - '.'
            }
        }
        line = addrhex(offset, 8) - '  ' - reg - '|' - key - '|'
        cur = reg - '|' - key - '|'

        repeat = ! vf && have && cur == prev
        {
            repeat -> {
                supp -> {
                }

                -> {
                    print('*')
                    supp = true
                }
            }

            ! repeat -> {
                print(line)
                supp = false
            }
        }
        prev = cur
        have = true

        #{overflow=wrap}
        offset = offset + 16
    }
    {
        e > 0 -> print(addrhex(e, 8))
    }
}

; render-default: BSD hexdump (no -C) layout
; 0000000 XXXX XXXX ... (8 little-endian shorts per line, "%04x"), 7-hex offset,
; short lines padded to full width; final total-offset line.
render-default = (data []byte, s i64, e i64, vf bool) {
    hx = '0123456789abcdef'
    space = ' '
    offset = s
    have = false
    supp = false
    prev = ''
    (offset < e) {

        #{overflow=wrap}
        ln = e - offset
        ln > 16 -> ln = 16

        ; shorts in this line = ceil(ln / 2)
        #{overflow=wrap}
        nshort = ln / 2
        safe-mod(ln, 2) != 0 -> nshort = safe-add(nshort, 1)

        region = ''
        j <- [0..8): {
            j < nshort -> {
                lo = 0
                hi = 0

                #{overflow=wrap}
                p0 = offset + j * 2
                p1 = safe-add(p0, 1)
                p0 < e -> lo = data[p0] & 255
                p1 < e -> hi = data[p1] & 255
                v = lo | (hi << 8)

                ; build 4 hex digits, left-zero-padded
                d0 = (v >> 12) & 15
                d1 = (v >> 8) & 15
                d2 = (v >> 4) & 15
                d3 = v & 15
                c0 char = hx.byte(d0) & 255
                c1 char = hx.byte(d1) & 255
                c2 char = hx.byte(d2) & 255
                c3 char = hx.byte(d3) & 255
                shex = '' - c0.to-str() - c1.to-str() - c2.to-str() - c3.to-str()
                region = region - ' ' - shex
            }
            j >= nshort -> region = region - '     '
        }
        line = addrhex(offset, 7) - region

        repeat = ! vf && have && region == prev
        {
            repeat -> {
                supp -> {
                }

                -> {
                    print('*')
                    supp = true
                }
            }

            ! repeat -> {
                print(line)
                supp = false
            }
        }
        prev = region
        have = true

        #{overflow=wrap}
        offset = offset + 16
    }
    {
        e > 0 -> print(addrhex(e, 7))
    }
}

hexdump-run()
