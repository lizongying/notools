// ln.no — ln utility
// Make links between files (delegates to the system `ln` command)
// Usage: ln [-s] <target> <link>
//   -s: create a symbolic link

main = () {
    argc = args()
    argc < 3 -> {
        print('Usage: ln [-s] <target> <link>')
        os.exit(1)
    }
    cmd = 'ln'
    i <- [2..argc): {
        cmd = cmd - ' ' - arg(i)
    }
    process.process-system(cmd)
}
