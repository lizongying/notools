; ln.no — ln utility (pure Nolang, uses fs.symlink/fs.link built-ins)
; Usage: ln [-s] [-f] <target> [<link>]
;
; NOTE: conditionals of the form `mode == 1 -> ok = fs.symlink(...)` get
; dead-code-eliminated by the optimizer when mode is initialized to a
; constant. Call fs.symlink/fs.link directly inside the arg-matching
; conditional block instead.

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
ln-run = () {
    a2 = arg(2)
    a3 = arg(3)
    a4 = arg(4)

    {
        a2 == '-s' -> {

            ; symlink: ln -s target link
            a3 == '' -> {
                eprint('ln: missing file operand')
                os.exit(1)
            }
            link = a4
            link == '' -> link = a3
            ok = fs.symlink(a3, link)
            ok == false -> {
                eprint('ln: failed to create ' - link - ' -> ' - a3)
                os.exit(1)
            }
        }

        a2 == '-sf' -> {

            ; symlink + force: ln -sf target link
            a3 == '' -> {
                eprint('ln: missing file operand')
                os.exit(1)
            }
            link = a4
            link == '' -> link = a3
            fs.remove(link)
            ok = fs.symlink(a3, link)
            ok == false -> {
                eprint('ln: failed to create ' - link - ' -> ' - a3)
                os.exit(1)
            }
        }

        a2 == '-fs' -> {
            a3 == '' -> {
                eprint('ln: missing file operand')
                os.exit(1)
            }
            link = a4
            link == '' -> link = a3
            fs.remove(link)
            ok = fs.symlink(a3, link)
            ok == false -> {
                eprint('ln: failed to create ' - link - ' -> ' - a3)
                os.exit(1)
            }
        }

        a2 == '-f' -> {

            ; hard link + force: ln -f target link
            a3 == '' -> {
                eprint('ln: missing file operand')
                os.exit(1)
            }
            link = a4
            link == '' -> link = a3
            fs.remove(link)
            ok = fs.link(a3, link)
            ok == false -> {
                eprint('ln: failed to create ' - link - ' -> ' - a3)
                os.exit(1)
            }
        }

        a2 != '-s' && a2 != '-sf' && a2 != '-fs' && a2 != '-f' -> {

            ; hard link: ln target link
            a2 == '' -> {
                eprint('ln: missing file operand')
                os.exit(1)
            }
            link = a3
            link == '' -> link = a2
            ok = fs.link(a2, link)
            ok == false -> {
                eprint('ln: failed to create ' - link - ' -> ' - a2)
                os.exit(1)
            }
        }
    }
}

#{win-amd64, win-arm64}
ln-run = () {
    eprint('ln-run: not supported on this platform')
    os.exit(1)
}
