; lzma.no — lzma compression utility (native Nolang)
; Compresses files to .lzma format using archive/xz.no.
; Usage: lzma [-c] [-d] [-k] <file...>
;   預設：壓縮檔案，生成 .lzma 並刪除原檔
;   -c  寫到標準輸出
;   -d  解壓（等同 unlzma）
;   -k  保留原檔

lzma-cmd = () {
    argc = args()

    to-stdout = false
    decompress = false
    keep = false
    has-file = false

    i = 2
    for i < argc {
        a = arg(i)
        {
            a == '-c' -> to-stdout = true
            a == '-d' -> decompress = true
            a == '-k' -> keep = true
            a == '-f' -> {}
            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    eprint('lzma: ' - f - ': No such file')
                    i = i + 1
                    continue
                }
                content = fs.read-file(f)
                data = content.to-bytes()

                decompress -> {
                    out []byte = xz.lzma-decompress(data)
                    to-stdout -> {
                        s = out.to-str()
                        io.out(s)
                    }
                    -> {
                        out-name = f
                        f.ends-with('.lzma') -> out-name = f.slice(0, f.len - 5)
                        fs.write-file(out-name, out)
                        keep == false -> fs.remove(f)
                    }
                }
                -> {
                    ; lzma 壓縮使用 xz-compress 作為基本實現
                    out []byte = xz.xz-compress(data)
                    to-stdout -> {
                        s = out.to-str()
                        io.out(s)
                    }
                    -> {
                        out-name = f - '.lzma'
                        fs.write-file(out-name, out)
                        keep == false -> fs.remove(f)
                    }
                }
            }
        }

        i = i + 1
    }

    {
        has-file == false -> {
            eprint('lzma: no input files')
            os.exit(1)
        }
    }
}
