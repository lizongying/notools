; lzcat.no — lzcat utility: decompress .lzma to stdout (native Nolang)
; Usage: lzcat FILE...

lzcat-cmd = () {
    argc = args()

    has-file = false

    i = 2
    for i < argc {
        a = arg(i)
        a.starts-with('-') == false -> {
            has-file = true
            f = a

            fs.is-file(f) == false -> {
                eprint('lzcat: ' - f - ': No such file')
                i = i + 1
                continue
            }
            content = fs.read-file(f)
            data = content.to-bytes()
            out []byte = xz.lzma-decompress(data)
            s = out.to-str()
            io.out(s)
        }

        i = i + 1
    }

    has-file == false -> {
        eprint('lzcat: no input files')
        os.exit(1)
    }
}
