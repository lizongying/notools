// sleep.no — sleep utility
// Delay for a specified amount of time
// Usage: sleep <duration> [duration...]
//   duration: integer or fractional seconds, with optional suffix s/m/h
//             e.g. 1, 0.5, 2s, 3m, 1h (multiple durations are summed)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= "0" && c <= "9" -> v = v * 10 + (c - "0")
    }
}

sleep-run = () {
    argc = args()
    argc < 3 -> {
        print('Usage: sleep <duration> [duration...]')
        os.exit(1)
    }
    total-us = 0
    i <- [2..argc): {
        a = arg(i)
        total-us = total-us + parse-duration(a)
    }
    os.sleep-us(total-us)
}

parse-duration = (a str) (us i64) {
    suffix = 's'
    num = a
    a.ends-with('s') -> {
        suffix = 's'
        num = a.slice(0, a.len - 1)
    }
    a.ends-with('m') -> {
        suffix = 'm'
        num = a.slice(0, a.len - 1)
    }
    a.ends-with('h') -> {
        suffix = 'h'
        num = a.slice(0, a.len - 1)
    }
    dot = num.index('.')
    sec = 0
    frac = 0
    nd = 0
    dot < 0 -> sec = atoi(num)
    dot >= 0 -> {
        sec = atoi(num.slice(0, dot))
        frac-str = num.slice(dot + 1, num.len)
        frac = atoi(frac-str)
        nd = frac-str.len
    }
    base-us = sec * 1000000
    pow = 1
    k <- [0..nd): { pow = pow * 10 }
    frac-us = 0
    nd > 0 -> frac-us = frac * (1000000 / pow)
    us = base-us + frac-us
    suffix == 'm' -> us = us * 60
    suffix == 'h' -> us = us * 3600
}
