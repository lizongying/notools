; tree.no — tree utility
; Displays directory tree structure recursively
; Usage: tree [-a] [-L n] [path]
;   -a: show hidden files (starting with '.')
;   -L n: limit depth to n levels
;   path: directory to display (defaults to '.')

; count-entries: count visible entries in a directory
; path str: directory path
; show-hidden bool: whether to show entries starting with '.'
; returns count i64: number of visible entries
count-entries = (path str, show-hidden bool) (count i64) {
    count = 0
    dirp = fs.open-dir(path)
    dirp == 0 -> return

    ok = true
    (ok) {
        name, ok = fs.read-dir(dirp)
        {
            ok -> {
                skip = name == '.' || name == '..'
                ! skip -> {
                    hidden = name.starts-with('.')

                    #{overflow=wrap}
                    show-hidden || ! hidden -> count = count + 1
                }
            }
        }
    }
    fs.close-dir(dirp)
}

; walk recursively traverses a directory and prints its entries
; in a tree-like format with proper indentation and connectors.
; path str: directory path to walk
; prefix str: indentation prefix accumulated from ancestors
; depth i64: current depth (1-based for entries)
; max-depth i64: maximum depth (0 means unlimited)
; show-hidden bool: whether to show entries starting with '.'
; returns dir-count i64, file-count i64: counts of directories and files
walk = (path str, prefix str, depth i64, max-depth i64, show-hidden bool) (dir-count i64, file-count i64) {
    dir-count = 0
    file-count = 0

    ; First pass: count visible entries
    n = count-entries(path, show-hidden)
    n == 0 -> return

    ; Second pass: open directory and process entries one at a time
    dirp = fs.open-dir(path)
    dirp == 0 -> return

    idx = 0
    ok = true
    (ok) {
        name, ok = fs.read-dir(dirp)
        {
            ok -> {
                skip = name == '.' || name == '..'
                ! skip -> {
                    hidden = name.starts-with('.')
                    visible = show-hidden || ! hidden
                    visible -> {

                        #{overflow=wrap}
                        is-last = idx == n - 1

                        ; Build connector and child prefix (defaults for non-last entry)
                        connector = '├── '
                        child-prefix = prefix - '│   '
                        is-last -> {
                            connector = '└── '
                            child-prefix = prefix - '    '
                        }

                        ; Print this entry (store concatenation in variable first)
                        #{overflow=wrap}
                        line = prefix - connector - name
                        print(line)

                        ; Count and recurse if directory
                        #{overflow=wrap}
                        full = path - '/' - name
                        is-d = fs.is-dir(full)
                        is-d -> {
                            #{overflow=wrap}
                            dir-count = dir-count + 1

                            ; Recurse if depth allows: max-depth == 0 means unlimited
                            recurse = max-depth == 0 || depth < max-depth
                            recurse -> {
                                #{overflow=wrap}
                                sub-dirs, sub-files = walk(full, child-prefix, depth + 1, max-depth, show-hidden)
                                #{overflow=wrap}
                                dir-count = dir-count + sub-dirs
                                #{overflow=wrap}
                                file-count = file-count + sub-files
                            }
                        }
                        #{overflow=wrap}
                        ! is-d -> file-count = file-count + 1
                        #{overflow=wrap}
                        idx = idx + 1
                    }
                }
            }
        }
    }
    fs.close-dir(dirp)
}

; run is the main entry point for the tree utility.
; Parses arguments and dispatches to walk.
tree-run = () {
    argc = args()

    show-hidden = false
    max-depth = 0
    dir = '.'

    ; Parse arguments after the 'tree' subcommand
    ; arg(0)=program, arg(1)='tree', arg(2)+=arguments
    i = 2
    (i < argc) {
        a = arg(i)
        {
            a == '-a' -> show-hidden = true

            a == '-L' -> {

                ; Next argument is the depth number
                #{overflow=wrap}
                i = i + 1
                i < argc -> {
                    val-str = arg(i)
                    val = val-str.to-i64()
                    val: {
                        ok -> max-depth = it

                        -> max-depth = 0
                    }
                }
            }

            a.starts-with('-') -> show-hidden = show-hidden || a.contains('a')

            ! a.starts-with('-') -> dir = a
        }

        #{overflow=wrap}
        i = i + 1
    }

    ; Print root
    print(dir)
    dir-count, file-count = walk(dir, '', 1, max-depth, show-hidden)

    ; Print summary
    print('')
    dc = dir-count
    fc = file-count

    #{overflow=wrap}
    summary = dc.to-str() - ' directories, ' - fc.to-str() - ' files'
    print(summary)
}

#{win-amd64, win-arm64}
tree-run-win = () {
    eprint('tree-run: not supported on this platform')
    os.exit(1)
}
