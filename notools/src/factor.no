// factor.no — factor utility
// Print prime factors of each given integer
// Usage: factor NUMBER...
//   NUMBER: non-negative integer (decimal)
// Output: "N: p1 p2 p3 ..." with factors in ascending order
// Example: factor 60 → "60: 2 2 3 5"

// atoi: parse a non-negative decimal integer string into i64
// Returns -1 on invalid input
atoi = (s str) (v i64) {
    v = 0
    {
        s.len == 0 -> {
            v = -1
            return
        }
    }
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
        c < 48 || c > 57 -> {
            v = -1
            return
        }
    }
}

// one: factor a single non-negative integer n, append factors to out
one = (n i64, out []i64) {
    {
        n < 2 -> {
            out.push(n)
            return
        }
    }
    m = n
    // Extract factors of 2 (do-while: divide while even)
    {
        m % 2 != 0 -> break
        out.push(2)
        m = m / 2
    } (m % 2 == 0)
    // Extract odd factors from 3 upward
    d = 3
    {
        d * d > m -> break
        m % d == 0 -> {
            out.push(d)
            m = m / d
        }
        m % d != 0 -> d = d + 2
    } (true)
    // Remaining m is a prime (and > 1)
    m > 1 -> out.push(m)
}

factor-run = () {
    argc = args()

    {
        argc < 3 -> {
            eprint('Usage: factor NUMBER...')
            os.exit(1)
        }
    }

    i <- [2..argc): {
        s = arg(i)
        n = atoi(s)
        n < 0 -> {
            eprint('factor: \'' - s - '\' is not a valid non-negative integer')
            os.exit(1)
        }
        factors []i64
        one(n, factors)
        // Build output line: "N: f1 f2 f3 ..."
        line = n.to-str() - ':'
        j <- [0..factors.len): {
            f = factors[j]
            line = line - ' ' - f.to-str()
        }
        print(line)
    }
}
