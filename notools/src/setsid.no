// setsid.no — setsid utility
// Run a command in a new session
// Usage: setsid COMMAND [ARGS...]
//   Calls os.set-sid() to create a new session and process group,
//   then spawns the command and waits for it.
//   Exit status: the command's exit status, or 1 on session/spawn failure.

setsid-run = () {
    argc = args()

    {
        argc < 3 -> {
            eprint('Usage: setsid COMMAND [ARGS...]')
            os.exit(1)
        }
    }

    // Build command string from remaining args
    cmd = ''
    i <- [2..argc): {
        i > 2 -> cmd = cmd - ' '
        cmd = cmd - arg(i)
    }

    // Create a new session; we become session leader + process group leader.
    sid = os.set-sid()
    {
        sid < 0 -> {
            eprint('setsid: failed to create new session')
            os.exit(1)
        }
    }

    pid = process-spawn(cmd)
    {
        pid < 0 -> {
            eprint('setsid: failed to start command')
            os.exit(1)
        }
    }
    status = process-wait(pid)
    os.exit(status)
}
