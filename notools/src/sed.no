// sed.no — sed utility
// Basic stream editor for text replacement
// Usage: sed 's/pattern/replacement/[g]' [files...]

sed-run = () {
    argc = args()

    command = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a.starts-with('s/') -> command = a
        ! a.starts-with('s/') && ! a.starts-with('-') -> files.push(a)
    }

    {
        command.len == 0 -> {
            print('sed: no command specified')
            os.exit(1)
        }
    }

    slash1 = command.index-from('/', 2)
    {
        slash1 < 0 -> {
            print('sed: invalid command')
            os.exit(1)
        }
    }
    pattern = command.slice(2, slash1)

    slash2 = command.index-from('/', slash1 + 1)
    {
        slash2 < 0 -> {
            print('sed: invalid command')
            os.exit(1)
        }
    }
    replacement = command.slice(slash1 + 1, slash2)

    global = false
    {
        slash2 + 1 < command.len -> global = command[slash2 + 1] == 'g'
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            process(content, pattern, replacement, global)
        }
        files.len > 0 -> {
            i <- [0..files.len): {
                ! fs.is-file(files[i]) -> {
                    print('sed: ' - files[i] - ': No such file or directory')
                    os.exit(1)
                }
                content = fs.read-file(files[i])
                process(content, pattern, replacement, global)
            }
        }
    }
}

process = (content str, pattern str, replacement str, global bool) {
    lines = content.split('\n')
    j <- [0..lines.len): {
        result = lines[j]
        global -> result = replace-all(lines[j], pattern, replacement)
        ! global -> result = replace-first(lines[j], pattern, replacement)
        print(result)
    }
}

replace-first = (line str, pattern str, replacement str) (result str) {
    pos = line.index(pattern)
    {
        pos < 0 -> {
            result = line
            return
        }
    }

    prefix = line.slice(0, pos)
    suffix = line.slice(pos + pattern.len, line.len)
    result = prefix - replacement - suffix
}

replace-all = (line str, pattern str, replacement str) (result str) {
    {
        pattern.len == 0 || pattern.len > line.len -> {
            result = line
            return
        }
    }

    temp str = line
    result = ''
    i <- [0..line.len + 1): {
        idx = temp.index(pattern)
        idx < 0 -> {
            result = result - temp
            return
        }
        result = result - temp.slice(0, idx) - replacement
        temp = temp.slice(idx + pattern.len, temp.len)
    }
}