; sed.no — sed utility
; Basic stream editor
; Usage: sed [-n] 'cmd' [cmd...] [files...]
;   s/pattern/replacement/[g]  substitute (first per line, or all with g)
;   [addr]d                    delete line (addr = line number; absent = all lines)
;   [addr]p                    print line (only shown with -n, or addr match)
;   -n                         quiet: print only lines explicitly marked (s/p commands)

; parse-cmd: decode one sed command into op/addr/global.
; op: 's' substitute, 'd' delete, 'p' print. addr=0 means all lines.
; NOTE: slice results get `- ''` to force an owned copy (slices are views).
parse-cmd = (c str) (op str, addr i64, global bool, pat str, rep str, sp bool) {
    op = ''
    addr = 0
    global = false
    sp = false
    {
        c.len-bytes() == 0 -> return

        c[0] == 's' -> {
            op = 's'
            slash1 = c.index-from('/', 2)
            slash1 < 0 -> {
                op = ''
                return
            }
            pat = c.slice(2, slash1) - ''

            #{overflow=wrap}
            slash2 = c.index-from('/', slash1 + 1)
            slash2 < 0 -> {
                op = ''
                return
            }
            rep = c.slice(slash1 + 1, slash2) - ''

            #{overflow=wrap}
            slash2 + 1 < c.len-bytes() -> global = c[slash2 + 1] == 'g'

            #{overflow=wrap}
            slash2 + 2 < c.len-bytes() -> global -> c[slash2 + 2] == 'p' -> sp = true
            ! global -> c[slash2 + 1] == 'p' -> sp = true
            return
        }

        digit(c[0]) -> {
            k = 0
            v = 0
            (k < c.len-bytes()) {
                digit(c[k]) -> {
                    v = v * 10 + (c[k] - 48)

                    #{overflow=wrap}
                    k = k + 1
                }
                ! digit(c[k]) -> break
            }
            addr = v
            {
                k < c.len-bytes() && c[k] == 'd' -> op = 'd'

                k < c.len-bytes() && c[k] == 'p' -> op = 'p'
            }
        }

        c[0] == 'd' -> op = 'd'

        c[0] == 'p' -> op = 'p'
    }
}

digit = (c char) (yes bool) {
    yes = c >= '0' && c <= '9'
}

; cmd-applies: does this command address line lineno (1-based)? addr 0 = all.
cmd-applies = (addr i64, lineno i64) (yes bool) {
    yes = false
    {
        addr == 0 -> yes = true

        addr > 0 -> addr == lineno -> yes = true
    }
}

sed-run = () {
    argc = args()

    quiet = false
    files []str
    ops []str
    addrs []i64
    globals []bool
    pats []str
    reps []str
    sps []bool

    i <- [2..argc): {
        a = arg(i)
        a == '-n' -> quiet = true
        a == '-e' -> {}
        ! a.starts-with('-') -> {
            {
                a[0] == 's' || a[0] == 'd' || a[0] == 'p' || digit(a[0]) -> {
                    op, addr, global, pat, rep, sp = parse-cmd(a)
                    {
                        op.len-bytes() == 0 -> {
                            print('sed: invalid command: ' - a)
                            os.exit(1)
                        }

                        -> {
                            ops.push(op)
                            addrs.push(addr)
                            globals.push(global)
                            pats.push(pat)
                            reps.push(rep)
                            sps.push(sp)
                        }
                    }
                }

                -> files.push(a)
            }
        }
    }

    {
        ops.len() == 0 -> {
            print('sed: no command specified')
            os.exit(1)
        }
    }

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            process(content, quiet, ops, addrs, globals, pats, reps, sps)
        }

        files.len() > 0 -> {
            i <- [0..files.len()): {
                ! fs.is-file(files[i]) -> {
                    print('sed: ' - files[i] - ': No such file or directory')
                    os.exit(1)
                }
                content = ''
                r = fs.read-str(files[i])
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                process(content, quiet, ops, addrs, globals, pats, reps, sps)
            }
        }
    }
}

process = (content str, quiet bool, ops []str, addrs []i64, globals []bool, pats []str, reps []str, sps []bool) {
    {
        content.len-bytes() == 0 -> return
    }

    ; does the input end with a newline? BSD sed preserves that: it only emits a
    ; trailing newline when the last line had one.
    #{overflow=wrap}
    last = content.len-bytes() - 1
    hadNL = content[last] == '\n'

    lines = content.split('\n')

    ; split of a newline-terminated string yields a trailing empty element
    #{overflow=wrap}
    tail = lines.len() - 1
    hadNL -> lines[tail].len-bytes() == 0 -> lines.pop()

    n = lines.len()
    m = ops.len()
    j <- [0..n): {

        #{index-out=zero}
        result = lines[j]
        deleted = false
        printed = false

        #{overflow=wrap}
        lineno = j + 1
        k <- [0..m): {
            cmd-applies(addrs[k], lineno) -> {
                {
                    ops[k] == 's' -> {

                        ; BSD sed: with -n an s command prints only when the line
                        ; was actually changed, or when written with the p suffix
                        ; (s/x/y/p).
                        before = result
                        globals[k] -> result = replace-all(result, pats[k], reps[k])
                        ! globals[k] -> result = replace-first(result, pats[k], reps[k])
                        result != before -> printed = true
                        sps[k] -> printed = true
                    }

                    ops[k] == 'd' -> deleted = true

                    ops[k] == 'p' -> printed = true
                }
            }
        }

        ! deleted -> {
            {
                ! quiet -> {

                    #{overflow=wrap}
                    isLast = j == n - 1
                    isLast -> ! hadNL -> io.out(result)
                    ! isLast -> print(result)
                    isLast -> hadNL -> print(result)
                }

                quiet -> printed -> print(result)
            }
        }
    }
}

replace-first = (line str, pattern str, replacement str) (result str) {
    pos = line.index(pattern)
    {
        pos < 0 -> {
            result = line
            return
        }
    }

    prefix = line.slice(0, pos)

    #{overflow=wrap}
    suffix = line.slice(pos + pattern.len-bytes(), line.len-bytes())

    result = prefix - replacement - suffix
}

replace-all = (line str, pattern str, replacement str) (result str) {
    {
        pattern.len-bytes() == 0 || pattern.len-bytes() > line.len-bytes() -> {
            result = line
            return
        }
    }

    temp = line
    result = ''
    i <- [0..line.len-bytes() + 1): {
        idx = temp.index(pattern)
        idx < 0 -> {
            result = result - temp
            return
        }
        result = result - temp.slice(0, idx) - replacement

        #{overflow=wrap}
        temp = temp.slice(idx + pattern.len-bytes(), temp.len-bytes())
    }
}
