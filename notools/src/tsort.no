; tsort.no — tsort utility
; Topological sort
; Usage: tsort [file]
;   Reads pairs "A B" meaning edge A→B, outputs topological order

; split: split content into whitespace-separated tokens
split = (content str, tokens []str) {
    start = 0
    in-field = false
    i <- [0..content.len()): {
        c = content[i]: {
            ok -> it

            -> _
        }
        is-space bool = c == 32 || c == 9 || c == 10 || c == 13
        is-space && in-field -> {
            tokens.push(content.slice(start, i))
            in-field = false
        }
        ! is-space && ! in-field -> {
            start = i
            in-field = true
        }
    }
    in-field -> tokens.push(content.slice(start, content.len()))
}

; find-or-add: find node index by name, or add it; returns index
find-or-add = (nodes []str, name str) (idx i64) {
    i <- [0..nodes.len()): {
        nd = nodes[i]: {
            ok -> it

            -> ''
        }
        nd == name -> {
            idx = i
            return
        }
    }
    idx = nodes.len()
    nodes.push(name)
}

tsort-run = () {
    argc = os.args().len()
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        ! a.starts-with('-') -> files.push(a)
    }

    content = ''
    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }

        files.len() > 0 -> {
            f0 = files[0]: {
                ok -> it

                -> ''
            }
            ! fs.is-file(f0) -> {
                eprint('tsort: ' - f0 - ': No such file or directory')
                exit(1)
            }
            content = ''
            r = fs.read-str(f0)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    ; Parse tokens
    tokens []str
    split(content, tokens)

    ; Build node list and edge list (process in pairs)
    nodes []str
    edges-from []i64
    edges-to []i64

    #{overflow=wrap}
    pair-count = tokens.len() / 2
    p <- [0..pair-count): {

        #{overflow=wrap}
        ai = p * 2: {
            ok -> it

            -> _
        }
        a = tokens[ai]: {
            ok -> it

            -> ''
        }

        #{overflow=wrap}
        bi = p * 2 + 1: {
            ok -> it

            -> _
        }
        b = tokens[bi]: {
            ok -> it

            -> ''
        }

        ; Skip self-loops (A A)
        a == b -> continue

        idx-from = find-or-add(nodes, a)
        idx-to = find-or-add(nodes, b)
        edges-from.push(idx-from)
        edges-to.push(idx-to)
    }

    n = nodes.len()
    n == 0 -> return

    ; Compute in-degrees
    in-deg []i64 = with-len(n)
    j <- [0..n): {
        in-deg[j]: {
            ok -> it = 0

            -> _
        }
    }
    e <- [0..edges-to.len()): {
        to = edges-to[e]: {
            ok -> it

            -> _
        }
        d9v1 = in-deg[to]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        nv = d9v1 + 1: {
            ok -> it

            -> _
        }
        in-deg[to]: {
            ok -> it = nv

            -> _
        }
    }

    ; Build adjacency list (flat: for each node, list of successors)
    #{overflow=wrap}
    adj-count []i64 = with-len(n + 1)
    j <- [0..n + 1): {
        adj-count[j]: {
            ok -> it = 0

            -> _
        }
    }
    e <- [0..edges-from.len()): {
        from = edges-from[e]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        fp1 = from + 1: {
            ok -> it

            -> _
        }
        d9v2 = adj-count[fp1]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        nv = d9v2 + 1: {
            ok -> it

            -> _
        }
        adj-count[fp1]: {
            ok -> it = nv

            -> _
        }
    }

    ; Prefix sum to get offsets
    j <- [1..n + 1): {
        d9v3 = adj-count[j]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        jm1 = j - 1: {
            ok -> it

            -> _
        }
        d9v4 = adj-count[jm1]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        nv = d9v3 + d9v4: {
            ok -> it

            -> _
        }
        adj-count[j]: {
            ok -> it = nv

            -> _
        }
    }
    adj []i64 = with-len(edges-from.len())
    pos []i64 = with-len(n)
    j <- [0..n): {
        pos[j]: {
            ok -> it = 0

            -> _
        }
    }
    e <- [0..edges-from.len()): {
        from = edges-from[e]: {
            ok -> it

            -> _
        }
        acf = adj-count[from]: {
            ok -> it

            -> _
        }
        pf = pos[from]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        slot = acf + pf: {
            ok -> it

            -> _
        }

        d9v5 = edges-to[e]: {
            ok -> it

            -> _
        }
        adj[slot]: {
            ok -> it = d9v5

            -> _
        }

        d9v6 = pos[from]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        nv = d9v6 + 1: {
            ok -> it

            -> _
        }
        pos[from]: {
            ok -> it = nv

            -> _
        }
    }

    ; Kahn's algorithm: queue of nodes with in-degree 0
    ; Use head index to avoid modifying slice .len (read-only)
    queue []i64
    j <- [0..n): {
        dg = in-deg[j]: {
            ok -> it

            -> _
        }
        dg == 0 -> queue.push(j)
    }
    queue-head = 0

    output-count = 0
    (queue.len() > queue-head) {
        queue.len() > queue-head -> {

            ; Pop front (just advance head index)
            node = queue[queue-head]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            queue-head = queue-head + 1: {
                ok -> it

                -> _
            }

            nn = nodes[node]: {
                ok -> it

                -> ''
            }
            print(nn)

            #{overflow=wrap}
            output-count = output-count + 1: {
                ok -> it

                -> _
            }

            ; Decrease in-degree of successors
            start-adj = adj-count[node]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            np1 = node + 1: {
                ok -> it

                -> _
            }
            end-adj = adj-count[np1]: {
                ok -> it

                -> _
            }
            k <- [start-adj..end-adj): {
                succ = adj[k]: {
                    ok -> it

                    -> _
                }
                d9v7 = in-deg[succ]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                nv = d9v7 - 1: {
                    ok -> it

                    -> _
                }
                in-deg[succ]: {
                    ok -> it = nv

                    -> _
                }
                id7 = in-deg[succ]: {
                    ok -> it

                    -> _
                }
                id7 == 0 -> queue.push(succ)
            }
        }
    }

    {
        output-count < n -> {
            eprint('tsort: input contains a cycle')
            exit(1)
        }
    }
}
