; tsort.no — tsort utility
; Topological sort
; Usage: tsort [file]
;   Reads pairs "A B" meaning edge A→B, outputs topological order

; split: split content into whitespace-separated tokens
split = (content str, tokens []str) {
    start = 0
    in-field = false
    i <- [0..content.len()): {

        #{index-out=zero}
        c = content[i]
        is-space bool = c == 32 || c == 9 || c == 10 || c == 13
        is-space && in-field -> {
            tokens.push(content.slice(start, i))
            in-field = false
        }
        ! is-space && ! in-field -> {
            start = i
            in-field = true
        }
    }
    in-field -> tokens.push(content.slice(start, content.len()))
}

; find-or-add: find node index by name, or add it; returns index
find-or-add = (nodes []str, name str) (idx i64) {
    i <- [0..nodes.len()): {
        nodes[i] == name -> {
            idx = i
            return
        }
    }
    idx = nodes.len()
    nodes.push(name)
}

tsort-run = () {
    argc = os.args().len()
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        ! a.starts-with('-') -> files.push(a)
    }

    content = ''
    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }

        files.len() > 0 -> {
            ! fs.is-file(files[0]) -> {
                f0 = files[0]
                msg str = ''
                f0: {
                    ok -> msg = 'tsort: ' - it - ': No such file or directory'

                    -> {
                        msg = 'tsort: : No such file or directory'
                    }
                }
                eprint(msg)
                exit(1)
            }
            content = ''
            r = fs.read-str(files[0])
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    ; Parse tokens
    tokens []str
    split(content, tokens)

    ; Build node list and edge list (process in pairs)
    nodes []str
    edges-from []i64
    edges-to []i64

    #{overflow=wrap}
    pair-count = tokens.len() / 2
    p <- [0..pair-count): {

        #{overflow=wrap}
        a = tokens[p * 2] - ''

        #{overflow=wrap}
        b = tokens[p * 2 + 1] - ''

        ; Skip self-loops (A A)
        a == b -> continue

        idx-from = find-or-add(nodes, a)
        idx-to = find-or-add(nodes, b)
        edges-from.push(idx-from)
        edges-to.push(idx-to)
    }

    n = nodes.len()
    n == 0 -> return

    ; Compute in-degrees
    in-deg []i64 = with-len(n)
    j <- [0..n): {
        in-deg[j]: {
            ok -> it = 0

            -> _
        }
    }
    e <- [0..edges-to.len()): {

        #{index-out=zero}
        to = edges-to[e]

        #{index-out=zero}
        d9v1 i64 = in-deg[to]

        #{overflow=wrap}
        in-deg[to]: {
            ok -> it = d9v1 + 1

            -> _
        }
    }

    ; Build adjacency list (flat: for each node, list of successors)
    #{overflow=wrap}
    adj-count []i64 = with-len(n + 1)
    j <- [0..n + 1): {
        adj-count[j]: {
            ok -> it = 0

            -> _
        }
    }
    e <- [0..edges-from.len()): {

        #{index-out=zero}
        from = edges-from[e]

        #{index-out=zero}
        d9v2 i64 = adj-count[from + 1]

        #{overflow=wrap}
        adj-count[from + 1]: {
            ok -> it = d9v2 + 1

            -> _
        }
    }

    ; Prefix sum to get offsets
    j <- [1..n + 1): {

        #{index-out=zero}
        d9v3 i64 = adj-count[j]

        #{index-out=zero}
        d9v4 i64 = adj-count[j - 1]

        #{overflow=wrap}
        adj-count[j]: {
            ok -> it = d9v3 + d9v4

            -> _
        }
    }
    adj []i64 = with-len(edges-from.len())
    pos []i64 = with-len(n)
    j <- [0..n): {
        pos[j]: {
            ok -> it = 0

            -> _
        }
    }
    e <- [0..edges-from.len()): {

        #{index-out=zero}
        from = edges-from[e]

        #{overflow=wrap}
        slot = adj-count[from] + pos[from]

        #{index-out=zero}
        d9v5 i64 = edges-to[e]
        adj[slot]: {
            ok -> it = d9v5

            -> _
        }

        #{index-out=zero}
        d9v6 i64 = pos[from]

        #{overflow=wrap}
        pos[from]: {
            ok -> it = d9v6 + 1

            -> _
        }
    }

    ; Kahn's algorithm: queue of nodes with in-degree 0
    ; Use head index to avoid modifying slice .len (read-only)
    queue []i64
    j <- [0..n): {
        in-deg[j] == 0 -> queue.push(j)
    }
    queue-head = 0

    output-count = 0
    (queue.len() > queue-head) {
        queue.len() > queue-head -> {

            ; Pop front (just advance head index)
            #{index-out=zero}
            node = queue[queue-head]

            #{overflow=wrap}
            queue-head = queue-head + 1

            print(nodes[node])

            #{overflow=wrap}
            output-count = output-count + 1

            ; Decrease in-degree of successors
            #{index-out=zero}
            start-adj = adj-count[node]

            #{index-out=zero, overflow=wrap}
            end-adj = adj-count[node + 1]
            k <- [start-adj..end-adj): {

                #{index-out=zero}
                succ = adj[k]

                #{index-out=zero}
                d9v7 i64 = in-deg[succ]

                #{overflow=wrap}
                in-deg[succ]: {
                    ok -> it = d9v7 - 1

                    -> _
                }
                in-deg[succ] == 0 -> queue.push(succ)
            }
        }
    }

    {
        output-count < n -> {
            eprint('tsort: input contains a cycle')
            exit(1)
        }
    }
}
