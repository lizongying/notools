; unix2mac.no — unix2mac utility
; Convert LF line endings to CR
; Usage: unix2mac [FILE...]
;   No FILE: read stdin, write stdout
;   With FILE: modify in place

unix2mac-convert = (content str) (out str) {
    n = content.len()
    out = with-cap(n)
    j = 0
    i <- [0..n): {
        c = content[i]
        {
            c == 10 -> {

                ; LF: check if prev was CR (avoid double-converting CRLF)
                prev-is-cr = false
                i > 0 -> {

                    #{overflow=wrap}
                    content[i - 1] == 13 -> prev-is-cr = true
                }
                ! prev-is-cr -> {

                    ; standalone LF -> convert to CR
                    out = out.set-byte(j, 13)

                    #{overflow=wrap}
                    j = j + 1: {
                        ok -> it

                        -> _
                    }
                }
                prev-is-cr -> {

                    ; CRLF: keep LF (CR already emitted)
                    out = out.set-byte(j, 10)

                    #{overflow=wrap}
                    j = j + 1: {
                        ok -> it

                        -> _
                    }
                }
            }

            -> {
                out = out.set-byte(j, c)

                #{overflow=wrap}
                j = j + 1: {
                    ok -> it

                    -> _
                }
            }
        }
    }
}

unix2mac-run = () {
    argc = os.args().len()
    {
        argc <= 2 -> {
            inp = ''
            r = fs.read-stdin-str()
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            out = unix2mac-convert(inp)
            print(out)
        }

        -> {
            i <- [2..argc): {
                path-opt = os.arg(i)
                path = path-opt: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(path) -> {
                    eprint('unix2mac: ' - path - ': No such file')
                    exit(1)
                }
                inp = ''
                r = fs.read-str(path)
                r: {
                    ok -> inp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                out = unix2mac-convert(inp)
                data = out
                fs.write-file(path, data)
            }
        }
    }
}
