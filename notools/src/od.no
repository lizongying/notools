; od - dump files in octal and other formats (BSD-compatible layout)
; 用法：od [-A FORMAT] [-t FORMAT] [-N N] [-v] [-bcdox] [file]
;   -A FORMAT  地址格式：d=十进制 o=八进制 x=十六进制 n=无（默认 o）
;   -t FORMAT  数据类型：[ouxdc][1|2|4]，如 o2 x2 u1 c d2 o1 ...（默认 o2）
;   -N N       只处理前 N 字节
;   -v         不用 '*' 折叠重复行
;   -b/-c/-d/-o/-x  BSD obsolescent 别名：o1 / c / u2 / o2 / x2
;   file       指定文件，否则读取 stdin

atoi = (s str) (v i64) {
    v = 0

    #{overflow=wrap}
    i <- [0..s.len-bytes()): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

; parse-format: normalize a -t / legacy token into (size, kind, fw).
; kind: 'o'=octal 'x'=hex 'u'=unsigned dec 'd'=signed dec 'c'=char
; Returns via out params size (bytes/unit), kind, fw (zero-pad width, 0 = none).
size-of = (fmt str) (s i64) {
    s = 2
    fmt == 'o1' || fmt == 'x1' || fmt == 'u1' || fmt == 'd1' || fmt == 'c' -> s = 1
    fmt == 'o4' || fmt == 'x4' || fmt == 'u4' || fmt == 'd4' -> s = 4
    fmt == 'c' -> s = 1
}

kind-of = (fmt str) (k str) {
    k = 'o'
    fmt.starts-with('x') -> k = 'x'
    fmt.starts-with('u') -> k = 'u'
    fmt.starts-with('d') -> k = 'd'
    fmt == 'c' -> k = 'c'
}

; octal field width (digits) for a given unit size: ceil(bits/3).
oct-fw = (size i64) (w i64) {
    w = 3
    size == 2 -> w = 6
    size == 4 -> w = 11
}

; hex field width: 2 digits per byte.
hex-fw = (size i64) (w i64) {
    w = 2
    size == 2 -> w = 4
    size == 4 -> w = 8
}

; base right edge (1-based col of the last char of the FIRST cell).
base-right = (fmt str, size i64, kind str) (b i64) {
    b = 13
    size == 2 -> b = 17
    size == 4 -> b = 25
    kind == 'c' -> b = 12
}

; stride (columns) between successive cell right edges.
stride-of = (size i64) (st i64) {
    st = 4
    size == 2 -> st = 8
    size == 4 -> st = 16
}

fmt-octal = (v i64, fw i64) (s str) {
    digits = '01234567'
    space = ' '
    s = space.repeat(fw)
    x = v
    k <- [0..fw): {

        #{overflow=wrap}
        s[fw - 1 - k] = digits[x & 7]
        x = x >> 3
    }
}

fmt-hex = (v i64, fw i64) (s str) {
    digits = '0123456789abcdef'
    space = ' '
    s = space.repeat(fw)
    x = v
    k <- [0..fw): {

        #{overflow=wrap}
        s[fw - 1 - k] = digits[x & 15]
        x = x >> 4
    }
}

; unsigned decimal, right-justified naturally (no zero pad).
fmt-dec = (v i64) (s str) {
    s = v.to-str()
}

; signed decimal, two's complement over the unit size.
fmt-dec-signed = (v i64, size i64) (s str) {

    #{overflow=wrap}
    bits = size * 8
    signbit = 1 << (bits - 1)
    mod = signbit << 1

    #{overflow=wrap}
    adj = v - mod
    out = v
    v >= signbit -> out = adj
    s = out.to-str()
}

; char cell: BSD -c escape rules. Escapes are emitted as literal two-char
; sequences (backslash + letter), NOT raw control bytes, so build them from a
; backslash string rather than '\0' / '\a' literals (which Nolang resolves to
; the real control byte).
fmt-char = (b i64) (s str) {
    bs = '\\'
    {
        b == 0 -> s = bs - '0'

        b == 7 -> s = bs - 'a'

        b == 8 -> s = bs - 'b'

        b == 9 -> s = bs - 't'

        b == 10 -> s = bs - 'n'

        b == 11 -> s = bs - 'v'

        b == 12 -> s = bs - 'f'

        b == 13 -> s = bs - 'r'

        b >= 32 && b < 127 -> {
            bc char = b
            s = bc.to-str()
        }

        -> s = fmt-octal(b, 3)
    }
}

; render the address field into a fixed 7-column string.
addr-str = (val i64, fmt str) (s str) {
    space = ' '
    {
        fmt == 'd' -> {
            s = space.repeat(7)
            x = val
            k <- [0..7): {

                #{overflow=wrap}
                s[6 - k] = 48 + (x % 10)

                #{overflow=wrap}
                x = x / 10
            }
        }

        fmt == 'x' -> {
            hex-digits = '0123456789abcdef'
            s = space.repeat(7)
            x = val
            k <- [0..7): {

                #{overflow=wrap}
                s[6 - k] = hex-digits[x & 15]
                x = x >> 4
            }
        }

        -> {
            oct-digits = '01234567'
            s = space.repeat(7)
            x = val
            k <- [0..7): {

                #{overflow=wrap}
                s[6 - k] = oct-digits[x & 7]
                x = x >> 3
            }
        }
    }
}

od-run = () {
    argc = args()
    addr-fmt = 'o'
    data-fmt = 'o2'
    nbytes = -1
    vflag = false
    files []str
    all-rest = false
    skip-next = false
    i <- [2..argc): {
        handled = false
        {
            skip-next -> {
                skip-next = false
                handled = true
            }
        }
        {
            ! handled -> {
                a = arg(i)
                {
                    all-rest -> files.push(a)

                    a == '--' -> {
                        all-rest = true
                        handled = true
                    }

                    a == '-' && ! all-rest -> {
                        files.push(a)
                        handled = true
                    }

                    a == '-A' -> {

                        #{overflow=wrap}
                        i + 1 < argc -> {
                            addr-fmt = arg(i + 1)
                            skip-next = true
                        }
                        handled = true
                    }

                    a == '-t' -> {

                        #{overflow=wrap}
                        i + 1 < argc -> {
                            data-fmt = arg(i + 1)
                            skip-next = true
                        }
                        handled = true
                    }

                    a == '-N' -> {

                        #{overflow=wrap}
                        i + 1 < argc -> {
                            nbytes = atoi(arg(i + 1))
                            skip-next = true
                        }
                        handled = true
                    }

                    a == '-v' -> {
                        vflag = true
                        handled = true
                    }

                    a == '-b' -> {
                        data-fmt = 'o1'
                        handled = true
                    }

                    a == '-c' -> {
                        data-fmt = 'c'
                        handled = true
                    }

                    a == '-d' -> {
                        data-fmt = 'u2'
                        handled = true
                    }

                    a == '-o' -> {
                        data-fmt = 'o2'
                        handled = true
                    }

                    a == '-x' -> {
                        data-fmt = 'x2'
                        handled = true
                    }

                    a.starts-with('-A') -> {
                        a.len-bytes() > 2 -> {
                            addr-fmt = a.slice(2, a.len-bytes())
                            handled = true
                        }
                    }

                    a.starts-with('-t') -> {
                        a.len-bytes() > 2 -> {
                            data-fmt = a.slice(2, a.len-bytes())
                            handled = true
                        }
                    }

                    a.starts-with('-N') -> {
                        a.len-bytes() > 2 -> {
                            nbytes = atoi(a.slice(2, a.len-bytes()))
                            handled = true
                        }
                    }
                }

                {
                    ! handled -> ! all-rest -> ! a.starts-with('-') -> files.push(a)
                }
            }
        }
    }

    data []byte
    {
        files.len() == 0 -> {
            inp []byte
            r = fs.read-stdin()
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            data = inp
        }

        -> {
            fi <- [0..files.len()): {

                #{index-out=0}
                f = files[fi]

                ; BSD od treats '-' as a literal file operand (not stdin), so
                ; every non-flag operand goes through the file path.
                ! fs.is-file(f) -> {
                    io.errln('od: ' - f - ': No such file or directory')
                    os.exit(1)
                }
                inp3 []byte
                r3 = fs.read-bytes(f)
                r3: {
                    ok -> inp3 = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                b = inp3
                k <- [0..b.len()): {
                    data.push(b[k])
                }
            }
        }
    }

    n = data.len()
    {
        nbytes >= 0 && nbytes < n -> n = nbytes
    }

    unit = size-of(data-fmt)
    kind = kind-of(data-fmt)
    base = base-right(data-fmt, unit, kind)
    stride = stride-of(unit)

    #{overflow=wrap}
    per-line = 16 / unit

    #{overflow=wrap}
    fullw = base + stride * (per-line - 1)

    offset = 0
    have-prev = false
    suppressed = false
    prevdata = ''
    (offset < n) {

        ; assemble one full-width line (addr + right-justified cells + pad)
        line = ''
        {
            addr-fmt != 'n' -> line = addr-str(offset, addr-fmt)

            -> line = ' '.repeat(7)
        }
        cursor = 7
        ci <- [0..per-line): {

            #{overflow=wrap}
            pos = offset + ci * unit
            pos < n -> {

                ; little-endian quantity
                val = 0
                k <- [0..unit): {

                    #{overflow=wrap}
                    p = pos + k
                    p < n -> val = val | ((data[p] & 255) << (k * 8))
                }

                ; render to string
                vs = ''
                {
                    kind == 'o' -> vs = fmt-octal(val, oct-fw(unit))

                    kind == 'x' -> vs = fmt-hex(val, hex-fw(unit))

                    kind == 'u' -> vs = fmt-dec(val)

                    kind == 'd' -> vs = fmt-dec-signed(val, unit)

                    kind == 'c' -> {
                        cv = 0
                        cv = data[pos] & 255
                        vs = fmt-char(cv)
                    }
                }

                ; right-justify to (base-1 + stride*ci) 0-based
                #{overflow=wrap}
                re0 = base - 1 + stride * ci

                #{overflow=wrap}
                start = re0 - vs.len-bytes() + 1

                #{overflow=wrap}
                pad = start - cursor
                pad > 0 -> line = line - ' '.repeat(pad)
                line = line - vs

                #{overflow=wrap}
                cursor = start + vs.len-bytes()
            }
        }

        ; pad short (partial) line out to full width
        #{overflow=wrap}
        tail = fullw - cursor
        tail > 0 -> line = line - ' '.repeat(tail)

        ; duplicate-line collapsing (unless -v)
        cur = line.slice(7, line.len-bytes())
        repeat = ! vflag && have-prev && cur == prevdata
        {
            repeat -> {
                suppressed -> {
                }

                -> {
                    print('*')
                    suppressed = true
                }
            }

            ! repeat -> {
                print(line)
                suppressed = false
            }
        }
        prevdata = cur
        have-prev = true

        #{overflow=wrap}
        offset = offset + 16
    }

    ; final offset line (BSD emits nothing at all for empty input)
    {
        n > 0 && addr-fmt != 'n' -> {
            fl = addr-str(n, addr-fmt)
            print(fl)
        }

        n > 0 && addr-fmt == 'n' -> print('')
    }
}

od-run()
