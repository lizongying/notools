; sha1.no — BSD sha1 工具（对齐 /sbin/sha1）
; 用法：sha1 [-pqrsx] [-c str] [-s str] [files ...]
;   无参数：读 stdin，打印裸哈希（-c 时无输出）
;   文件：  SHA1 (path) = hash（-r 改 hash path；-q 只打印 hash；-c 追加 [ Failed ] 且 rc=2）
;   -s str：打印 str 的裸哈希（忽略文件）
;   -p：原样回显 stdin 再打印其裸哈希
;   -x：先运行内置测试套件，再正常处理
; 注意：不经 hashutil.do-hash 中转 —— md5x 的 str 返回值跨两层调用
; 且输入超过短字符串阈值时会丢失（B13 变体），直接单层调用则正常

sha1-run = () {
    argc = args()
    rflag = false
    qflag = false
    sflag = false
    pflag = false
    xflag = false
    cflag = false
    sval = ''
    files []str
    status = 0
    suffix = ''
    emitted = false
    i = 2
    (i < argc) {
        a = arg(i)
        {
            a.len-bytes() > 2 && a[0] == 45 && a[1] == 45 -> {
                io.errln('sha1: unrecognized option `' - a - '\'')
                io.errln('usage: sha1 [-pqrtx] [-c string] [-s string] [files ...]')
                os.exit(1)
            }

            a.len-bytes() > 1 && a[0] == 45 -> {
                j <- [1..a.len-bytes()): {
                    ch i64 = a[j]
                    {
                        ch == 114 -> rflag = true

                        ch == 113 -> qflag = true

                        ch == 112 -> pflag = true

                        ch == 120 -> xflag = true

                        ch == 116 -> {
                        }

                        ch == 99 -> {
                            cflag = true

                            #{overflow=wrap}
                            i = i + 1
                        }

                        ch == 115 -> {
                            sflag = true

                            #{overflow=wrap}
                            i = i + 1
                            i < argc -> sval = arg(i)
                        }

                        -> {
                            chc char = ch
                            io.errln('sha1: invalid option -- ' - chc.to-str())
                            io.errln('usage: sha1 [-pqrtx] [-c string] [-s string] [files ...]')
                            os.exit(1)
                        }
                    }
                }
            }

            -> files.push(a)
        }

        #{overflow=wrap}
        i = i + 1
    }

    {
        xflag -> {
            print('SHA1 test suite:')
            ts []str
            ts.push('')
            ts.push('a')
            ts.push('abc')
            ts.push('message digest')
            ts.push('abcdefghijklmnopqrstuvwxyz')
            ts.push('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789')
            ts.push('12345678901234567890123456789012345678901234567890123456789012345678901234567890')
            ts.push('MD5 has not yet (2001-09-03) been broken, but sufficient attacks have been made that its security is in some doubt')
            ev []str
            ev.push('da39a3ee5e6b4b0d3255bfef95601890afd80709')
            ev.push('86f7e437faa5a7fce15d1ddcb9eaeaea377667b8')
            ev.push('a9993e364706816aba3e25717850c26c9cd0d89d')
            ev.push('c12252ceda8be8994d5fa0290a47231c1d16aae3')
            ev.push('32d10c7b8cf96570ca04ce37f2a19d84240d3a89')
            ev.push('761c457bf73b14d27e9e9265c46f4b4dda11f940')
            ev.push('50abf5706a150990a08b2c5ea40fa0e585554732')
            ev.push('18eca4333979c4181199b7b4fab8786d16cf2846')
            k <- [0..ts.len()): {

                #{index-out=0}
                tv = ts[k]
                tdata = tv.to-bytes()
                th = sha1.sha1-hex(tdata)
                res = ' - verified correct'

                #{index-out=0}
                th != ev[k] -> res = ' - NOT correct'
                print('SHA1 ("' - tv - '") = ' - th - res)
            }
        }
    }

    cflag -> suffix = ' [ Failed ]'

    {
        pflag -> {
            ! cflag -> {
                pinp []byte
                pr = fs.read-stdin()
                pr: {
                    ok -> pinp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                pdata = pinp
                fd = fs.open-write('/dev/stdout')
                fs.write(fd, pdata, pdata.len())
                ph = sha1.sha1-hex(pdata)
                print(ph)
            }
        }

        sflag -> {
            sdata = sval.to-bytes()
            sh = sha1.sha1-hex(sdata)
            print(sh - suffix)
            emitted = true
        }

        -> {
            files.len() == 0 && ! xflag -> {
                sinp []byte
                sr = fs.read-stdin()
                sr: {
                    ok -> sinp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                sdata2 = sinp
                sh2 = sha1.sha1-hex(sdata2)
                ! cflag -> print(sh2)
            }

            files.len() > 0 -> {
                k2 <- [0..files.len()): {

                    #{index-out=0}
                    path = files[k2]
                    ok2 = true
                    {
                        path == '-' -> {
                        }

                        ! fs.is-file(path) -> {
                            ok2 = false
                            fs.is-dir(path) -> io.errln('sha1: ' - path - ': Is a directory')

                            -> io.errln('sha1: ' - path - ': No such file or directory')
                            status = 1
                        }
                    }
                    ok2 -> {
                        data []byte
                        {
                            path == '-' -> {
                                rinp []byte
                                rr = fs.read-stdin()
                                rr: {
                                    ok -> rinp = it

                                    nil -> {
                                    }

                                    err -> {
                                    }
                                }
                                rb = rinp
                                m <- [0..rb.len()): {
                                    data.push(rb[m])
                                }
                            }

                            -> {
                                finp []byte
                                fr = fs.read-bytes(path)
                                fr: {
                                    ok -> finp = it

                                    nil -> {
                                    }

                                    err -> {
                                    }
                                }
                                fb = finp
                                m2 <- [0..fb.len()): {
                                    data.push(fb[m2])
                                }
                            }
                        }
                        h = sha1.sha1-hex(data)
                        {
                            qflag -> print(h - suffix)

                            rflag -> print(h - ' ' - path - suffix)

                            -> print('SHA1 (' - path - ') = ' - h - suffix)
                        }
                        emitted = true
                    }
                }
            }
        }
    }

    status != 0 -> os.exit(status)
    cflag && emitted -> os.exit(2)
}
