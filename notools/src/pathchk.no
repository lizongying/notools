; pathchk.no — pathchk utility
; Check path validity
; Usage: pathchk [-p] PATH...
;   Default: reject empty paths and paths longer than 256 bytes.
;   -p: also require all characters be in the POSIX portable set.

pathchk-is-portable = (c i64) (ok bool) {
    ok = false
    {
        c >= 65 && c <= 90 -> ok = true    // A-Z
        c >= 97 && c <= 122 -> ok = true   // a-z
        c >= 48 && c <= 57 -> ok = true    // 0-9
        c == 46 -> ok = true               // .
        c == 95 -> ok = true               // _
        c == 45 -> ok = true               // -
        c == 47 -> ok = true               // /
    }
}

pathchk-check = (p str, posix bool) (ok bool) {
    ok = true
    {
        p.len == 0 -> {
            ok = false
            return
        }
        p.len > 256 -> {
            ok = false
            return
        }
        posix == true -> {
            i <- [0..p.len): {
                c = p[i]
                good = pathchk-is-portable(c)
                good == false -> ok = false
            }
        }
    }
}

pathchk-run = () {
    argc = args()
    posix = false
    paths []str
    i <- [2..argc): {
        a = arg(i)
        a == '-p' -> posix = true
        a != '-p' -> paths.push(a)
    }
    {
        paths.len == 0 -> {
            eprint('Usage: pathchk [-p] PATH...')
            os.exit(1)
        }
    }
    had-error = false
    i <- [0..paths.len): {
        p = paths[i]
        good = pathchk-check(p, posix)
        good == false -> {
            eprint('pathchk: invalid path ' - p)
            had-error = true
        }
    }
    had-error -> os.exit(1)
}
