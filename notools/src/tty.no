// tty.no — tty utility
// Print the file name of the terminal connected to standard input
// Usage: tty

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}

tty-run = () {
    name = os.ttyname(0)
    name.len > 0 -> {
        print(name)
        return
    }
    eprint('not a tty')
    os.exit(1)
}

#{win-amd64, win-arm64}
tty-run = () {
    eprint('tty-run: not supported on this platform')
    os.exit(1)
}
