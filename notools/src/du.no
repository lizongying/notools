// du.no — du utility
// Estimate file space usage
// Usage: du [-a] [-s] [-h] [path...]
//   -a:      write counts for all files, not just directories
//   -s:      display only a total for each argument
//   -h:      print sizes in human readable format (B/K/M/G)

emit = (size i64, p str, human bool) {
    human -> {
        s = ''
        size >= 1073741824 -> {
            tmp = size / 1073741824
            s = format('{tmp}') - 'G'
        }
        size >= 1048576 -> {
            tmp = size / 1048576
            s = format('{tmp}') - 'M'
        }
        size >= 1024 -> {
            tmp = size / 1024
            s = format('{tmp}') - 'K'
        }
        size < 1024 -> s = format('{size}') - 'B'
        print(s - '  ' - p)
    }
    -> {
        tmp = (size + 1023) / 1024
        print(format('{tmp}') - '  ' - p)
    }
}

walk = (p str, top bool, all bool, summarize bool, human bool) (total i64) {
    is-f = fs.is-file(p)
    is-f -> {
        size, ok = os.stat-size(p)
        ok == false -> size = 0
        all -> emit(size, p, human)
        total = size
        return
    }
    total = 0
    names = fs.list-dir(p)
    i <- [0..names.len): {
        name = names[i]
        skip = name == '.' || name == '..'
        skip == false -> {
            full = p - '/' - name
            total = total + walk(full, false, all, summarize, human)
        }
    }
    summarize -> { top -> print(total, p, human) }
    summarize == false -> print(total, p, human)
}

main = () {
    argc = args()
    all = false
    summarize = false
    human = false
    paths []str
    i <- [2..argc): {
        a = arg(i)
        a == '-a' -> all = true
        a == '-s' -> summarize = true
        a == '-h' -> human = true
        ! a.starts-with('-') -> paths.push(a)
    }
    paths.len == 0 -> paths.push('.')
    i <- [0..paths.len): {
        p = paths[i]
        is-d = fs.is-dir(p)
        is-f = fs.is-file(p)
        is-d == false && is-f == false -> {
            io.errln('du: ' - p - ': No such file or directory')
            continue
        }
        walk(p, true, all, summarize, human)
    }
}
