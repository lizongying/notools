; nproc.no — nproc utility
; Print the number of available processors
; Usage: nproc [--all]

nproc-run = () {
    argc = os.args().len()

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '--all' -> {}
    }

    n = os.num-cpu()
    n <= 0 -> n = 1
    print(n)
}
