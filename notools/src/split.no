; split.no — split utility
; Split a file into pieces
; Usage: split [-l LINES] [-b SIZE] [-a SUFFIX_LEN] [FILE [PREFIX]]
;   -l N      put N lines per output file (default 1000)
;   -b N[K|M] put N bytes per output file (K=1024, M=1048576)
;   -a N      use suffix length N (default 2, producing aa, ab, ...)
;   FILE      input file (default: stdin)
;   PREFIX    output filename prefix (default: x)

; atoi: parse a non-negative integer from a string
atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

; parse-size: parse a size with optional K/M suffix
parse-size = (s str) (n i64) {
    n = 0

    #{overflow=wrap}
    last = s.len() - 1
    last < 0 -> return
    mult = 1
    c = s[last]
    {
        c == 107 -> mult = 1024; k

        c == 75 -> mult = 1024; K

        c == 109 -> mult = 1048576; m

        c == 77 -> mult = 1048576; M
    }

    #{overflow=wrap}
    end = last + 1
    mult > 1 -> end = last
    i <- [0..end): {
        ch = s[i]

        #{overflow=wrap}
        ch >= 48 && ch <= 57 -> n = n * 10 + (ch - 48)
    }

    #{overflow=wrap}
    n = n * mult: {
        ok -> it

        -> _
    }
}

; gen-suffix: generate suffix string for file index (aa, ab, ..., ba, ...)
gen-suffix = (idx i64, width i64) (suf str) {
    chars = 'abcdefghijklmnopqrstuvwxyz'
    buf = ' '.repeat(width)
    i <- [0..width): {

        ch = chars[idx % 26]: {
            ok -> it

            -> 'a'
        }
        buf[width - 1 - i]: {
            ok -> it = ch

            -> _
        }

        #{overflow=wrap}
        idx = idx / 26: {
            ok -> it

            -> _
        }
    }
    suf = buf
}

; write-chunk: write a chunk to a numbered output file
write-chunk = (prefix str, file-idx i64, suffix-len i64, chunk str) {
    suf = gen-suffix(file-idx, suffix-len)
    fname = prefix - suf
    fd = fs.open-write(fname)
    fs.write(fd, chunk, chunk.len())
    fs.close(fd)
}

split = () {
    argc = os.args().len()
    lines-per = 1000
    bytes-per = 0
    suffix-len = 2
    infile = ''
    prefix = 'x'
    skip-next = false
    i <- [2..argc): {
        {
            skip-next -> {
                skip-next = false
            }

            -> {
                a-opt = os.arg(i)
                a = a-opt: {
                    ok -> it

                    -> ''
                }
                {
                    a == '-l' -> {

                        {
                            i + 1 < argc -> {
                                la = os.arg(i + 1): {
                                    ok -> it

                                    -> ''
                                }
                                lines-per = atoi(la)
                                skip-next = true
                            }
                        }
                    }

                    a == '-b' -> {

                        {
                            i + 1 < argc -> {
                                ba = os.arg(i + 1): {
                                    ok -> it

                                    -> ''
                                }
                                bytes-per = parse-size(ba)
                                skip-next = true
                            }
                        }
                    }

                    a == '-a' -> {

                        {
                            i + 1 < argc -> {
                                sa = os.arg(i + 1): {
                                    ok -> it

                                    -> ''
                                }
                                suffix-len = atoi(sa)
                                skip-next = true
                            }
                        }
                    }

                    a.starts-with('-') && a.len() > 1 -> {
                    }

                    ! a.starts-with('-') -> {
                        infile == '' -> infile = a

                        -> prefix = a
                    }
                }
            }
        }
    }

    ; Read input (file or stdin)
    content = ''
    {
        infile == '' -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }

        -> {
            ! fs.is-file(infile) -> {
                eprint('split: ' - infile - ': No such file or directory')
                exit(1)
            }
            content = ''
            r = fs.read-str(infile)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    file-idx = 0
    end = 0
    {
        bytes-per > 0 -> {

            ; Split by bytes
            total = content.len()
            pos = 0
            (pos < total) {
                pos < total -> {

                    #{overflow=wrap}
                    end = pos + bytes-per: {
                        ok -> it

                        -> _
                    }
                    end > total -> end = total
                    chunk = content.slice(pos, end)
                    write-chunk(prefix, file-idx, suffix-len, chunk)

                    #{overflow=wrap}
                    file-idx = file-idx + 1: {
                        ok -> it

                        -> _
                    }
                    pos = end
                }
            }
        }

        -> {

            ; Split by lines
            start = 0
            line-count = 0
            j <- [0..content.len()): {
                content[j] == 10 -> {

                    #{overflow=wrap}
                    line-count = line-count + 1: {
                        ok -> it

                        -> _
                    }
                    line-count >= lines-per -> {

                        #{overflow=wrap}
                        end = j + 1
                        chunk = content.slice(start, end)
                        write-chunk(prefix, file-idx, suffix-len, chunk)

                        #{overflow=wrap}
                        file-idx = file-idx + 1: {
                            ok -> it

                            -> _
                        }
                        start = end
                        line-count = 0
                    }
                }
            }
            start < content.len() -> {
                chunk = content.slice(start, content.len())
                write-chunk(prefix, file-idx, suffix-len, chunk)

                #{overflow=wrap}
                file-idx = file-idx + 1: {
                    ok -> it

                    -> _
                }
            }
        }
    }
}
