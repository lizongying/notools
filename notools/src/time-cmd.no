// time-cmd.no — time utility
// Measure command execution time
// Usage: time COMMAND [ARGS...]
//   Prints "real X.XXs" to stderr (seconds with 2 decimal places)
//   Exits with the command's exit status.
//   (Function named time-run to avoid conflict with the std time module.)

time-run = () {
    argc = args()

    argc < 3 -> {
        eprint('Usage: time COMMAND [ARGS...]')
        os.exit(1)
    }

    // Build command string from remaining args
    cmd = ''
    i <- [2..argc): {
        i > 2 -> cmd = cmd - ' '
        cmd = cmd - arg(i)
    }

    start-ns = os.now-ns()
    pid = process-spawn(cmd)
    pid < 0 -> {
        eprint('time: failed to start command')
        os.exit(1)
    }
    status = process-wait(pid)
    end-ns = os.now-ns()

    elapsed-ns = end-ns - start-ns
    // Convert to seconds with 2 decimal places (manual, since format()
    // only does integer substitution).
    sec = elapsed-ns / 1000000000
    hundredths = (elapsed-ns / 10000000) % 100
    sec-str = sec.to-str()
    hstr = hundredths.to-str()
    hstr.len == 1 -> hstr = '0' - hstr
    eprint('real ' - sec-str - '.' - hstr - 's')

    os.exit(status)
}
