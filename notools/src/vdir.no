; vdir.no — vdir utility
; List directory contents (one entry per line, simple form)
; Usage: vdir [PATH...]
; NOTE: 用 fs.dir-entries 而非 fs.list-dir——後者遵循 POSIX readdir 會返回
;   '.'/'..'，直接 print 會把當前/父目錄當普通條目列出。dir-entries 已自動過濾。
;   遍歷/刪除類場景一律信任 dir-entries（見 fs.no list-dir 警示）。

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
vdir-run = () {
    argc = args()
    paths []str
    i <- [2..argc): {
        paths.push(arg(i))
    }
    paths.len() == 0 -> paths.push('.')
    i <- [0..paths.len()): {

        #{index-out=0}
        p = paths[i]
        fs.is-dir(p) -> {
            entries = fs.dir-entries(p)
            j <- [0..entries.len()): {
                print(entries[j])
            }
        }
        ! fs.is-dir(p) -> print(p)
    }
}

#{win-amd64, win-arm64}
vdir-run = () {
    eprint('vdir-run: not supported on this platform')
    os.exit(1)
}
