; vdir.no — vdir utility
; List directory contents (one entry per line, simple form)
; Usage: vdir [PATH...]

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}

vdir-run = () {
    argc = args()
    paths []str
    i <- [2..argc): {
        paths.push(arg(i))
    }
    paths.len == 0 -> paths.push('.')
    i <- [0..paths.len): {
        p = paths[i]
        fs.is-dir(p) -> {
            entries = fs.list-dir(p)
            j <- [0..entries.len): {
                print(entries[j])
            }
        }
        fs.is-dir(p) == false -> print(p)
    }
}

#{win-amd64, win-arm64}
vdir-run = () {
    eprint('vdir-run: not supported on this platform')
    os.exit(1)
}
