; locale.no — locale utility
; Print locale information
; Usage: locale [-a] [-m]
;   no args: print current locale settings (LANG, LC_*) from environment
;   -a: list available locales (simplified: only C and C.UTF-8)
;   -m: list charmap names (simplified: only UTF-8)

locale = () {
    argc = args()

    list-all    = false
    list-charmap = false

    i <- [2..argc): {
        a = arg(i)
        a == '-a' -> list-all = true
        a == '-m' -> list-charmap = true
        a.starts-with('-') && a.len > 1 -> {
            ; scan combined short flags like -am
            j <- [1..a.len): {
                c = a[j]
                c == 97  -> list-all = true       // 'a'
                c == 109 -> list-charmap = true    // 'm'
            }
        }
    }

    {
        list-all == true -> {
            print('C')
            print('C.UTF-8')
            print('POSIX')
            return
        }

        list-charmap == true -> {
            print('UTF-8')
            print('ASCII')
            return
        }
    }

    ; Default: print current locale settings from the environment.
    names []str
    names.push('LANG')
    names.push('LC_COLLATE')
    names.push('LC_CTYPE')
    names.push('LC_MESSAGES')
    names.push('LC_MONETARY')
    names.push('LC_NUMERIC')
    names.push('LC_TIME')
    names.push('LC_ALL')
    names.push('LC_ADDRESS')
    names.push('LC_IDENTIFICATION')
    names.push('LC_MEASUREMENT')
    names.push('LC_NAME')
    names.push('LC_PAPER')
    names.push('LC_TELEPHONE')

    ; LANG is always shown; LC_* only when set.
    lang = os.get-env('LANG')
    print('LANG=' - lang)

    lc-all = os.get-env('LC_ALL')
    lc-all.len > 0 -> print('LC_ALL=' - lc-all)

    i <- [1..names.len): {
        name = names[i]
        name == 'LC_ALL' -> continue
        val = os.get-env(name)
        val.len > 0 -> print(name - '=' - val)
    }
}
