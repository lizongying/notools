; uniq.no — uniq utility
; Remove duplicate consecutive lines
; Usage: uniq [-c] [-d] [files...]
;   -c: count occurrences
;   -d: show only duplicates
;   files: files to process (read from stdin if none)

uniq-run = () {
    argc = os.args().len()

    count = false
    duplicates-only = false
    files []str

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-c' -> count = true
        a == '-d' -> duplicates-only = true
        ! a.starts-with('-') -> files.push(a)
    }

    lines []str
    start = 0
    content str

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            start = 0
            i2 <- [0..content.len()): {
                content[i2] == 10 -> {
                    lines.push(content.slice(start, i2))

                    #{overflow=wrap}
                    start = i2 + 1
                }
            }
            start < content.len() -> lines.push(content.slice(start, content.len()))
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                fp = files[fi]: {
                    ok -> it

                    -> ''
                }
                content = ''
                r = fs.read-str(fp)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                start = 0
                i2 <- [0..content.len()): {
                    content[i2] == 10 -> {
                        lines.push(content.slice(start, i2))

                        #{overflow=wrap}
                        start = i2 + 1
                    }
                }
                start < content.len() -> lines.push(content.slice(start, content.len()))
            }
        }
    }

    lines.len() == 0 -> return

    p0 = ''
    lines[0]: {
        ok -> p0 = it

        -> _
    }
    prev = p0 - ''
    cnt = 1
    n = lines.len()
    i <- [1..n): {
        ci = ''
        lines[i]: {
            ok -> ci = it

            -> _
        }
        curr = ci - ''
        curr == prev -> {

            #{overflow=wrap}
            cnt = cnt + 1: {
                ok -> it

                -> _
            }
        }
        curr != prev -> {
            emit(prev, cnt, count, duplicates-only)
            prev = curr
            cnt = 1
        }
    }
    emit(prev, cnt, count, duplicates-only)
}

emit = (line str, cnt i64, show-count bool, dups-only bool) {
    dups-only -> cnt == 1 -> return
    show-count -> {
        cntstr = cnt.to-str()

        #{overflow=wrap}
        pad = 4 - cntstr.len()
        p <- [0..pad): {
            io.out(' ')
        }
        io.out(cntstr)
        io.out(' ')
    }
    print(line)
}
