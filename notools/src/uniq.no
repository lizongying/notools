// uniq.no — uniq utility
// Remove duplicate consecutive lines
// Usage: uniq [-c] [-d] [files...]
//   -c: count occurrences
//   -d: show only duplicates
//   files: files to process (read from stdin if none)

main = () {
    argc = args()

    count = false
    duplicates-only = false
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-c' -> count = true
        a == '-d' -> duplicates-only = true
        !a.starts-with('-') -> files.push(a)
    }

    lines []str
    start = 0
    content str

    files.len == 0 -> {
        content = fs.read-file('/dev/stdin')
        start = 0
        i2 <- [0..content.len): {
            content[i2] == 10 -> {
                lines.push(content.slice(start, i2))
                start = i2 + 1
            }
        }
        start < content.len -> lines.push(content.slice(start, content.len))
    }

    files.len > 0 -> {
        fi <- [0..files.len): {
            content = fs.read-file(files[fi])
            start = 0
            i2 <- [0..content.len): {
                content[i2] == 10 -> {
                    lines.push(content.slice(start, i2))
                    start = i2 + 1
                }
            }
            start < content.len -> lines.push(content.slice(start, content.len))
        }
    }

    lines.len == 0 -> return

    prev = lines[0] - ''
    cnt = 1
    n = lines.len
    i <- [1..n): {
        curr = lines[i] - ''
        curr == prev -> {
            cnt = cnt + 1
        }
        curr != prev -> {
            emit(prev, cnt, count, duplicates-only)
            prev = curr
            cnt = 1
        }
    }
    emit(prev, cnt, count, duplicates-only)
}

emit = (line str, cnt i64, show-count bool, dups-only bool) {
    dups-only && cnt == 1 -> return
    show-count -> {
        cntstr = format('{cnt}') - ' '
        io.out(cntstr)
    }
    print(line)
}
