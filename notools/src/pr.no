; pr.no — pr utility
; Paginate files for printing
; Usage: pr [-l LENGTH] [-w WIDTH] [-h HEADER] [-t] [-o MARGIN] [-d] [file...]
;   -l LENGTH:  page length in lines (default: 66)
;   -w WIDTH:   page width in chars (default: 72)
;   -h HEADER:  custom header text (default: filename)
;   -t:         omit header and footer (5-line each)
;   -o MARGIN:  left margin (spaces before each line)
;   -d:         double-space output
;   files:      input files (read from stdin if none)
; Default page: 66 lines = 5 header + 56 body + 5 footer

; split-lines: split content into lines
split-lines = (content str, lines []str) {
    start = 0
    i <- [0..content.len): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))
            start = i + 1
        }
    }
    start < content.len -> lines.push(content.slice(start, content.len))
}

; pad: right-pad or truncate line to width, with left margin
pad = (line str, width i64, margin i64) (out str) {
    out = ' '.repeat(margin)
    out = out - line
    ; Don't truncate; pr doesn't truncate by default (only -w affects header)
}

; print-page: print one page of lines
; Returns number of lines actually printed
print-page = (lines []str, start i64, count i64, margin i64, double bool) (next i64) {
    next = start
    printed = 0
    {
        printed < count -> {
            next >= lines.len -> break
            line = lines[next] - ''
            padded = pad(line, 0, margin)
            print(padded)
            printed = printed + 1
            next = next + 1
            ; Double-space: print a blank line after each text line
            double == true -> {
                printed < count -> {
                    bl = pad('', 0, margin)
                    print(bl)
                    printed = printed + 1
                }
            }
        }
    } (printed < count && next < lines.len)
}

pr-run = () {
    argc = args()
    page-len = 66
    page-width = 72
    header = ''
    no-header = false
    margin = 0
    double = false
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next == true -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a == '-t' -> no-header = true
        a == '-d' -> double = true
        a == '-h' -> {
            i + 1 < argc -> {
                header = arg(i + 1)
                skip-next = true
            }
        }
        a.starts-with('-h') -> {
            a.len > 2 -> header = a.slice(2, a.len)
        }
        a == '-l' -> {
            i + 1 < argc -> {
                v = 0
                s = arg(i + 1)
                j <- [0..s.len): {
                    c = s[j]
                    c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
                }
                v > 0 -> page-len = v
                skip-next = true
            }
        }
        a.starts-with('-l') -> {
            a.len > 2 -> {
                v = 0
                s = a.slice(2, a.len)
                j <- [0..s.len): {
                    c = s[j]
                    c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
                }
                v > 0 -> page-len = v
            }
        }
        a == '-w' -> {
            i + 1 < argc -> {
                v = 0
                s = arg(i + 1)
                j <- [0..s.len): {
                    c = s[j]
                    c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
                }
                v > 0 -> page-width = v
                skip-next = true
            }
        }
        a.starts-with('-w') -> {
            a.len > 2 -> {
                v = 0
                s = a.slice(2, a.len)
                j <- [0..s.len): {
                    c = s[j]
                    c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
                }
                v > 0 -> page-width = v
            }
        }
        a == '-o' -> {
            i + 1 < argc -> {
                v = 0
                s = arg(i + 1)
                j <- [0..s.len): {
                    c = s[j]
                    c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
                }
                v > 0 -> margin = v
                skip-next = true
            }
        }
        a.starts-with('-o') -> {
            a.len > 2 -> {
                v = 0
                s = a.slice(2, a.len)
                j <- [0..s.len): {
                    c = s[j]
                    c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
                }
                v > 0 -> margin = v
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }

    ; Determine body lines per page
    header-lines = 5
    footer-lines = 5
    {
        no-header == true -> {
            header-lines = 0
            footer-lines = 0
        }
    }
    body-lines = page-len - header-lines - footer-lines
    {
        body-lines < 1 -> body-lines = 1
        ; Process each file
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            lines []str
            split-lines(content, lines)
            output(lines, header, header-lines, footer-lines, body-lines, margin, double)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                fs.is-file(files[fi]) == false -> {
                    msg = 'pr: ' - files[fi] - ': No such file or directory'
                    io.errln(msg)
                    continue
                }
                content = fs.read-file(files[fi])
                lines []str
                split-lines(content, lines)
                hdr = header
                hdr.len == 0 -> hdr = files[fi]
                output(lines, hdr, header-lines, footer-lines, body-lines, margin, double)
            }
        }
    }
}

; output: paginate and output all lines
output = (lines []str, header str, header-lines i64, footer-lines i64, body-lines i64, margin i64, double bool) {
    n = lines.len
    n == 0 -> return

    page = 1
    pos = 0
    {
        pos >= n -> break

        ; Print header (5 lines: blank, date+filename+page, blank, separator-line, blank)
        header-lines > 0 -> {

            ; Line 1: blank
            print('')
            ; Line 2: date  filename  page (simplified: just filename + page)
            ; Format: "  <filename>  Page <N>"
            hdr-line = '  ' - header - '  Page ' - page.to-str()
            print(hdr-line)
            ; Line 3: blank
            print('')
            ; Line 4: separator (dashes)
            print('---------------------------------------------------------------')
            ; Line 5: blank
            print('')
        }

        ; Print body
        next = print-page(lines, pos, body-lines, margin, double)
        pos = next

        ; Print footer (5 blank lines)
        footer-lines > 0 -> {
            k <- [0..footer-lines): {
                print('')
            }
        }

        ; Form feed between pages (but not after last page)
        pos < n -> print('\f')

        page = page + 1
    } (pos < n)
}
