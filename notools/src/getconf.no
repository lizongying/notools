; getconf.no — getconf utility
; Query system configuration variables
; Usage: getconf VAR [PATH]
; Supported: LONG_BIT, PAGE_SIZE, ARG_MAX, CLK_TCK, NGROUPS_MAX,
;            OPEN_MAX, LINE_MAX, NPROCESSORS_ONLN, NPROCESSORS_CONF
;            (and their _SC_ prefixed aliases)

getconf-run = () {
    argc = os.args()

    {
        argc < 3 -> {
            eprint('Usage: getconf VAR [PATH]')
            os.exit(1)
        }
    }

    var = os.arg(2)

    ; LONG_BIT is the bit width of a C long on this platform (not a sysconf query)
    var == 'LONG_BIT' -> {
        print('64')
        return
    }

    ; sysconf-backed variables. macOS <unistd.h> _SC_ indices used below.
    sc = -1
    {
        var == 'PAGE_SIZE' || var == 'PAGE_SIZE' || var == '_SC_PAGESIZE' -> sc = 29

        var == 'ARG_MAX' || var == '_SC_ARG_MAX' -> sc = 1

        var == 'CLK_TCK' || var == '_SC_CLK_TCK' -> sc = 3

        var == 'NGROUPS_MAX' || var == '_SC_NGROUPS_MAX' -> sc = 4

        var == 'OPEN_MAX' || var == '_SC_OPEN_MAX' -> sc = 5

        var == 'LINE_MAX' || var == '_SC_LINE_MAX' -> sc = 15

        -> {
        }
    }
    sc > 0 -> {
        v = os.sysconf(sc)
        print(v.to-str())
        return
    }

    {
        var == '_SC_NPROCESSORS_ONLN' || var == 'NPROCESSORS_ONLN' -> {
            n = os.num-cpu()
            n <= 0 -> n = 1
            print(n.to-str())
            return
        }

        var == '_SC_NPROCESSORS_CONF' || var == 'NPROCESSORS_CONF' -> {
            n = os.num-cpu()
            n <= 0 -> n = 1
            print(n.to-str())
            return
        }
    }

    eprint('getconf: ' - var - ': unknown variable')
    os.exit(1)
}
