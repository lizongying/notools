; complete.no — shell subcommand completion for notools
;   notools __complete <prefix>   : print subcommand names matching <prefix> (one per line)
;   notools completion <shell>    : print a Tab-completion script for bash|zsh
; The candidate list is the local vec below; keep it in sync with the dispatch in main.no.

complete-run = () {
    verb-opt = os.arg(1)
    verb = verb-opt: {
        ok -> it

        -> ''
    }

    verb == 'completion' -> {
        shell str = ''
        na = os.args().len()
        na >= 3 -> shell = os.arg(2)
        print-script(shell)
        return
    }

    ; default path: __complete <prefix> -> emit matching subcommand names
    prefix str = ''
    nb = os.args().len()
    nb >= 3 -> prefix = os.arg(2)

    subs []str = [
        'arch',
        'awk',
        'b2sum',
        'base32',
        'base64',
        'basename',
        'bunzip2',
        'bzcat',
        'bzip2',
        'cal',
        'cat',
        'chgrp',
        'chmod',
        'chown',
        'chroot',
        'cksum',
        'clear',
        'cmp',
        'column',
        'comm',
        'completion',
        'compress',
        'cp',
        'csplit',
        'curl',
        'cut',
        'date',
        'dd',
        'df',
        'diff',
        'diff3',
        'dir',
        'dircolors',
        'dirname',
        'dmesg',
        'domainname',
        'dos2unix',
        'du',
        'echo',
        'egrep',
        'env',
        'envsubst',
        'expand',
        'expr',
        'factor',
        'false',
        'fgrep',
        'file',
        'find',
        'flock',
        'fmt',
        'fold',
        'free',
        'getconf',
        'getopt',
        'grep',
        'groups',
        'gunzip',
        'gzip',
        'head',
        'help',
        'hexdump',
        'hmac',
        'hostid',
        'hostname',
        'id',
        'install',
        'join',
        'kill',
        'killall',
        'less',
        'link',
        'ln',
        'locale',
        'locate',
        'logger',
        'logname',
        'ls',
        'lscpu',
        'lzcat',
        'lzma',
        'mac2unix',
        'mcookie',
        'md5',
        'md5sum',
        'mkdir',
        'mkfifo',
        'mknod',
        'mktemp',
        'more',
        'mv',
        'namei',
        'nice',
        'nl',
        'nohup',
        'nproc',
        'numfmt',
        'od',
        'paste',
        'patch',
        'pathchk',
        'pgrep',
        'pidof',
        'ping',
        'pinky',
        'pkill',
        'pr',
        'printenv',
        'printf',
        'ps',
        'ptx',
        'pwd',
        'readlink',
        'realpath',
        'rename',
        'renice',
        'reset',
        'rev',
        'rm',
        'rmdir',
        'sdiff',
        'sed',
        'seq',
        'setsid',
        'sha1',
        'sha1sum',
        'sha224',
        'sha224sum',
        'sha256',
        'sha256sum',
        'sha384',
        'sha384sum',
        'sha512',
        'sha512sum',
        'shred',
        'shuf',
        'sleep',
        'sort',
        'split',
        'stat',
        'stdbuf',
        'strings',
        'stty',
        'sum',
        'sync',
        'tac',
        'tail',
        'tar',
        'tee',
        'tempfile',
        'test',
        'time',
        'timeout',
        'top',
        'touch',
        'tr',
        'tree',
        'true',
        'truncate',
        'tsort',
        'tty',
        'uname',
        'uncompress',
        'unexpand',
        'uniq',
        'unix2dos',
        'unix2mac',
        'unlink',
        'unlzma',
        'unxz',
        'unzip',
        'unzstd',
        'updatedb',
        'uptime',
        'users',
        'uudecode',
        'uuencode',
        'uuidgen',
        'uuidparse',
        'vdir',
        'version',
        'watch',
        'wc',
        'whereis',
        'which',
        'who',
        'whoami',
        'xargs',
        'xxd',
        'xz',
        'xzcat',
        'yes',
        'zcat',
        'zip',
        'zstd',
        'zstdcat',
    ]

    s <- subs: {
        s.starts-with(prefix) -> print(s)
    }
}

; emit-line: print one raw line. The shell scripts contain {..} and $ which the
; print builtin would parse as format fields when passed a string LITERAL; routing
; the literal through a normal function argument keeps it verbatim.
emit-line = (t str) {
    print(t)
}

; print-script: emit a shell Tab-completion script (bash|zsh) that shells out
; to `notools __complete <prefix>`. Scripts are authored with no embedded single quotes.
print-script = (shell str) {
    shell == 'zsh' -> {
        emit-line('#compdef notools')
        emit-line('_notools() {')
        emit-line('  local -a _cmds')
        emit-line('  if (( CURRENT == 2 )); then')
        emit-line('    _cmds=(${(f)"$(${words[1]} __complete ${words[CURRENT]})"})')
        emit-line('    compadd -- $_cmds')
        emit-line('  fi')
        emit-line('}')
        emit-line('compdef _notools notools')
        return
    }
    shell == 'bash' -> {
        emit-line('# bash completion for notools')
        emit-line('_notools() {')
        emit-line('  local cur cmdword')
        emit-line('  cur="${COMP_WORDS[COMP_CWORD]}"')
        emit-line('  cmdword="${COMP_WORDS[0]}"')
        emit-line('  if [ "$COMP_CWORD" = "1" ]; then')
        emit-line('    _c=()')
        emit-line('    while IFS= read -r line; do _c+=("$line"); done < <("$cmdword" __complete "$cur")')
        emit-line('    COMPREPLY=( $(compgen -W "${_c[*]}" -- "$cur") )')
        emit-line('  fi')
        emit-line('}')
        emit-line('complete -F _notools notools')
        return
    }
    emit-line('notools: unsupported shell: ' - shell)
    emit-line('usage: notools completion <bash|zsh>')
}
