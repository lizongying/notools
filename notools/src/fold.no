; fold.no — fold utility
; Fold (wrap) each line to a specified width
; Usage: fold [-w WIDTH] [file...]
;   -w WIDTH: maximum line width (default: 80)
;   files:    files to fold (read from stdin if none)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len-bytes()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

fold-run = () {
    argc = args()
    width = 80
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a == '-w' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                width = atoi(arg(i + 1))
                skip-next = true
            }
        }
        a.starts-with('-w') -> {
            a.len-bytes() > 2 -> width = atoi(a.slice(2, a.len-bytes()))
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        width < 1 -> width = 1

        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            process(content, width)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                ! fs.is-file(files[fi]) -> {
                    #{overflow=wrap}
                    io.errln('fold: ' - files[fi] - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(files[fi])
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                process(content, width)
            }
        }
    }
}

; process: fold each line to width
process = (content str, width i64) {
    start = 0
    i <- [0..content.len-bytes()): {
        content[i] == 10 -> {
            emit(content.slice(start, i), width)

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len-bytes() -> emit(content.slice(start, content.len-bytes()), width)
}

; emit: fold a single line to the given width
emit = (line str, width i64) {
    n = line.len-bytes()
    {
        n == 0 -> {
            print('')
            return
        }
    }
    i = 0
    (i < n) {

        #{overflow=wrap}
        end = i + width
        end > n -> end = n
        chunk = ''
        j = i
        (j < end) {
            chunk = chunk - number.char-to-str(line[j])

            #{overflow=wrap}
            j = j + 1
        }
        print(chunk)

        #{overflow=wrap}
        i = i + width
    }
}
