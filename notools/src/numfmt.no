; numfmt.no — numfmt utility
; Format numbers with SI or IEC suffixes
; Usage: numfmt [--from=TYPE] [--to=TYPE] [NUMBER...]
;   --from=TYPE  interpret input: none (default), si, iec
;   --to=TYPE    format output:  none (default), si, iec
;   SI:  K=1000, M=1e6, G=1e9
;   IEC: K=1024, M=1048576, G=1073741824
;   No NUMBER args → read stdin, one number per line

; parse-num: parse a number with optional suffix
parse-num = (s str, from-type str) (val i64) {
    val = 0
    n = s.len
    n == 0 -> return
    last = s[n - 1]
    mult = 1
    num-end = n
    {
        from-type == 'si' -> {
            last == 75 || last == 107 -> mult = 1000; K or k

            last == 77 -> mult = 1000000; M

            last == 71 -> mult = 1000000000; G
        }

        from-type == 'iec' -> {
            last == 75 || last == 107 -> mult = 1024; K or k

            last == 77 -> mult = 1048576; M

            last == 71 -> mult = 1073741824; G
        }
    }

    mult > 1 -> num-end = n - 1
    i <- [0..num-end): {
        c = s[i]
        c >= 48 && c <= 57 -> val = val * 10 + (c - 48)
    }
    val = val * mult
}

; format-num: format a number with optional SI/IEC suffix
format-num = (val i64, to-type str) (out str) {
    {
        to-type == 'none' -> {
            out = val.to-str()
            return
        }
    }
    divisor = 1000
    units = 'KMG'
    to-type == 'iec' -> divisor = 1024
    ; Find the appropriate unit by repeated division
    v = val
    unit-idx = -1
    {
        v = v / divisor
        unit-idx = unit-idx + 1
    } (v >= divisor && unit-idx < 2)
    {
        unit-idx < 0 -> {
            out = val.to-str()
        }

        -> {

            ; Compute total divisor = divisor ^ (unit-idx + 1)
            total-div = 1
            k <- [0..unit-idx + 1): {
                total-div = total-div * divisor
            }
            ; Integer and fractional parts (one decimal place)
            whole = val / total-div
            remainder = val % total-div
            frac = (remainder * 10) / total-div
            out = whole.to-str() - '.' - frac.to-str() - number.char-to-str(units[unit-idx])
        }
    }
}

; process: parse and format one number
process = (s str, from-type str, to-type str) {
    val = parse-num(s, from-type)
    out = format-num(val, to-type)
    print(out)
}

numfmt = () {
    argc = args()
    from-type = 'none'
    to-type = 'none'
    nums []str

    i <- [2..argc): {
        a = arg(i)
        a.starts-with('--from=') -> from-type = a.slice(7, a.len)
        a.starts-with('--to=') -> to-type = a.slice(5, a.len)
        ! a.starts-with('-') -> nums.push(a)
    }

    {
        nums.len > 0 -> {
            i <- [0..nums.len): {
                process(nums[i], from-type, to-type)
            }
        }

        -> {

            ; Read from stdin, one number per line
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it
                nil -> {
                }
                err -> {
                }
            }
            start = 0
            j <- [0..content.len): {
                content[j] == 10 -> {
                    line = content.slice(start, j)
                    line = line.trim()
                    line.len > 0 -> process(line, from-type, to-type)
                    start = j + 1
                }
            }
            start < content.len -> {
                line = content.slice(start, content.len)
                line = line.trim()
                line.len > 0 -> process(line, from-type, to-type)
            }
        }
    }
}
