; domainname.no — domainname utility
; Print the domain name
; Usage: domainname

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
domainname-run = () {
    name = os.get-domain-name()
    print(name)
}

#{win-amd64, win-arm64}
domainname-run = () {
    eprint('domainname-run: not supported on this platform')
    os.exit(1)
}
