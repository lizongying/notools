// df.no — df utility
// Report file system disk space usage (delegates to the system `df` command)
// Usage: df [args]
//   Passes all arguments straight through to the system df.

df-run = () {
    argc = args()
    cmd = 'df'
    i <- [2..argc): {
        cmd = cmd - ' ' - arg(i)
    }
    process.process-system(cmd)
}
