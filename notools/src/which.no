; which.no — which utility
; Locate a command in PATH
; Usage: which [-a] COMMAND...
;   -a: print all matching executables, not just the first

; split-path: split PATH-style string by ':'
split-path = (path-str str, dirs []str) {
    path-str.len == 0 -> return
    start = 0
    i <- [0..path-str.len): {
        path-str[i] == 58 -> {
            seg = path-str.slice(start, i)
            seg.len > 0 -> dirs.push(seg)
            start = i + 1
        }
    }
    {
        start < path-str.len -> {
            seg = path-str.slice(start, path-str.len)
            seg.len > 0 -> dirs.push(seg)
        }
    }
}

; search: search for command in dirs list, print matches directly
; Returns count of matches found
search = (cmd str, dirs []str, find-all bool) (count i64) {
    count = 0
    n = dirs.len
    i <- [0..n): {
        d = dirs[i]
        full = d - '/' - cmd
        fs.is-file(full) -> {
            print(full)
            count = count + 1
            find-all == false -> return
        }
    }
}

which-run = () {
    argc = args()

    find-all = false
    cmds []str

    i <- [2..argc): {
        a = arg(i)
        a == '-a' -> find-all = true
        a == '--all' -> find-all = true
        a.starts-with('-') && a.len > 1 -> {}
        ! a.starts-with('-') -> cmds.push(a)
    }

    {
        cmds.len == 0 -> {
            eprint('Usage: which [-a] COMMAND...')
            os.exit(1)
        }
    }

    path-str = os.get-env('PATH')
    dirs []str
    split-path(path-str, dirs)

    any-not-found = false
    i <- [0..cmds.len): {
        cmd = cmds[i]
        cnt = search(cmd, dirs, find-all)
        cnt == 0 -> {
            any-not-found = true
        }
    }

    any-not-found -> os.exit(1)
}
