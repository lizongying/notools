; rev.no — rev utility
; Reverse the characters of each line
; Usage: rev [file...]
;   No args: reads stdin
;   Files:   reverses each file's lines

rev-run = () {
    argc = os.args().len()
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            process(content)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                fp = files[fi]: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(fp) -> {
                    io.errln('rev: ' - fp - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(fp)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                process(content)
            }
        }
    }
}

; process: reverse each line in content
process = (content str) {
    start = 0
    i <- [0..content.len()): {
        content[i] == 10 -> {
            emit(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len() -> emit(content.slice(start, content.len()))
}

; emit: reverse a single line and print it
emit = (line str) {
    n = line.len-bytes()
    out str = with-cap(n)
    j <- [0..n): {
        d9v1 str = line[n - 1 - j]: {
            ok -> it

            -> _
        }
        out[j]: {
            ok -> it = d9v1

            -> _
        }
    }
    print(out)
}
