; rev.no — rev utility
; Reverse the characters of each line
; Usage: rev [file...]
;   No args: reads stdin
;   Files:   reverses each file's lines

rev-run = () {
    argc = os.args().len()
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            process(content)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                fp = files[fi]: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(fp) -> {
                    io.errln('rev: ' - fp - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(fp)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                process(content)
            }
        }
    }
}

; process: reverse each line in content
process = (content str) {
    start = 0
    i <- [0..content.len()): {
        content[i] == 10 -> {
            emit(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len() -> emit(content.slice(start, content.len()))
}

; emit: reverse a single line and print it
emit = (line str) {
    n = line.len-bytes()
    out str = with-len(n)
    j <- [0..n): {
        d9v1 byte = line.byte(n - 1 - j): {
            ok -> it

            -> 0
        }
        out = set-byte-at(out, j, d9v1)
    }
    print(out)
}

; set-byte-at: replacement for std str.set-byte. The std body concatenates
; []byte slices, which v0.4.37 lowers to invalid LLVM IR; write through a
; []byte buffer with a place-match index store instead.
set-byte-at = (s str, i i64, b byte) (out str) {
    bs []byte = s.to-bytes()
    bs[i]: {
        ok -> it = b

        -> _
    }
    so = bs.to-str()
    out = so: {
        ok -> it

        nil || err -> ''
    }
}
