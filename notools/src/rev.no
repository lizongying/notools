; rev.no — rev utility
; Reverse the characters of each line
; Usage: rev [file...]
;   No args: reads stdin
;   Files:   reverses each file's lines

rev-run = () {
    argc = args()
    files []str
    i <- [2..argc): {
        a = arg(i)
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            process(content)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                fs.is-file(files[fi]) == false -> {
                    io.errln('rev: ' - files[fi] - ': No such file or directory')
                    continue
                }
                content = fs.read-file(files[fi])
                process(content)
            }
        }
    }
}

; process: reverse each line in content
process = (content str) {
    start = 0
    i <- [0..content.len): {
        content[i] == 10 -> {
            emit(content.slice(start, i))
            start = i + 1
        }
    }
    start < content.len -> emit(content.slice(start, content.len))
}

; emit: reverse a single line and print it
emit = (line str) {
    n = line.len
    out str = with-cap(n)
    j <- [0..n): {
        out[j] = line[n - 1 - j]
    }
    print(out)
}
