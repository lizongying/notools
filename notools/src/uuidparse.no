// uuidparse.no — uuidparse utility
// Parse/validate a UUID
// Usage: uuidparse UUID

uuidparse-run = () {
    argc = args()
    argc < 3 -> {
        eprint('Usage: uuidparse UUID')
        os.exit(1)
    }
    input = arg(2)
    ; Strip braces if present
    n = input.len
    n > 0 -> {
        input[0] == 123 -> {
            input = input.slice(1, n)
            n = input.len
        }
    }
    n > 0 -> {
        input[n - 1] == 125 -> {
            input = input.slice(0, n - 1)
            n = input.len
        }
    }
    ; Remove dashes
    clean = with-cap(n)
    j = 0
    i <- [0..n): {
        c = input[i]
        c != 45 -> {
            clean[j] = c
            j = j + 1
        }
    }
    ; Validate length = 32 hex chars
    valid = true
    j != 32 -> valid = false
    valid == true -> {
        i <- [0..32): {
            c = clean[i]
            is-hex = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
            is-hex == false -> valid = false
        }
    }
    valid == false -> {
        print('invalid')
        os.exit(1)
    }
    ; Extract version nibble at position 12
    vc = clean[12]
    ; Convert hex char to value
    vval = 0
    vc >= 48 && vc <= 57 -> vval = vc - 48
    vc >= 97 && vc <= 102 -> vval = vc - 87
    vc >= 65 && vc <= 70 -> vval = vc - 55
    ; Extract variant first nibble at position 16
    rc = clean[16]
    rval = 0
    rc >= 48 && rc <= 57 -> rval = rc - 48
    rc >= 97 && rc <= 102 -> rval = rc - 87
    rc >= 65 && rc <= 70 -> rval = rc - 55
    ; Variant: 10xx binary = RFC4122 (rval in 8..11)
    variant = 'unknown'
    rval >= 8 && rval <= 11 -> variant = 'RFC4122'
    ; Build output: "variant: RFC4122, version: 4"
    out = 'variant: ' - variant - ', version: ' - vval.to-str()
    print(out)
}
