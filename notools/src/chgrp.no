; chgrp.no — chgrp utility
; 改变文件的群组。基於 os.chown，uid 傳 -1 表示不改變 owner。
; Usage: chgrp <gid> <file...>
;   gid 為數字群組 ID

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
chgrp = () {
    argc = os.args()

    {
        argc < 3 -> {
            print("N")
            exit(1)
        }
    }

    gid-str = os.arg(2)
    gid = 0
    i <- [0..gid-str.len()): {
        c = gid-str[i]

        #{overflow=wrap}
        gid = gid * 10 + (c - '0')
    }

    ; uid=-1 表示不改變 owner
    uid = -1

    i <- [3..argc): {
        path = os.arg(i)
        ok = os.chown(path, uid, gid)
        ! ok -> {
            print("N")
            exit(1)
        }
    }
}

#{win-amd64, win-arm64}
chgrp = () {
    print("N")
    exit(1)
}
