; chgrp.no — chgrp utility
; 改变文件的群组。基於 os.chown，uid 傳 -1 表示不改變 owner。
; Usage: chgrp <gid> <file...>
;   gid 為數字群組 ID

chgrp = () {
    argc = args()

    argc < 3 -> {
        eprint('Usage: chgrp <gid> <file...>')
        os.exit(1)
    }

    gid-str = arg(2)
    gid = 0
    i <- [0..gid-str.len): {
        c = gid-str[i]
        gid = gid * 10 + (c - '0')
    }

    ; uid=-1 表示不改變 owner
    uid = -1

    i <- [3..argc): {
        path = arg(i)
        ok = os.chown(path, uid, gid)
        ok == false -> {
            eprint('chgrp: cannot change group of ' - path)
            os.exit(1)
        }
    }
}
