// uname.no — uname utility
// Print kernel and system information
// Usage: uname [-a] [-s] [-n] [-r] [-v] [-m]

uname-run = () {
    argc = args()

    show-all = false
    show-sysname = false
    show-nodename = false
    show-release = false
    show-version = false
    show-machine = false

    i <- [2..argc): {
        a = arg(i)
        a == '-a' -> show-all = true
        a == '-s' -> show-sysname = true
        a == '-n' -> show-nodename = true
        a == '-r' -> show-release = true
        a == '-v' -> show-version = true
        a == '-m' -> show-machine = true
    }

    u = os.uname()

    show-all -> {
        ; 直接逐个输出，避免 vec.push 结构体字段
        io.out(u.sysname)
        io.out(' ')
        io.out(u.nodename)
        io.out(' ')
        io.out(u.release)
        io.out(' ')
        io.out(u.version)
        io.out(' ')
        print(u.machine)
        return
    }

    has-flag = show-sysname || show-nodename || show-release || show-version || show-machine
    has-flag == false -> show-sysname = true

    ; 用 first 标志控制空格分隔，避免 vec.push
    first = true
    show-sysname -> {
        first == false -> io.out(' ')
        io.out(u.sysname)
        first = false
    }
    show-nodename -> {
        first == false -> io.out(' ')
        io.out(u.nodename)
        first = false
    }
    show-release -> {
        first == false -> io.out(' ')
        io.out(u.release)
        first = false
    }
    show-version -> {
        first == false -> io.out(' ')
        io.out(u.version)
        first = false
    }
    show-machine -> {
        first == false -> io.out(' ')
        io.out(u.machine)
        first = false
    }
    print('')
}
