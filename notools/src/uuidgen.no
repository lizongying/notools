; uuidgen.no — uuidgen utility
; Generate a UUID v4 (random)
; Usage: uuidgen

uuidgen-run = () {
    ; Seed with pid ^ time (non-zero)
    state = os.get-pid() ^ os.now-ns()
    state == 0 -> state = 1

    ; Generate 16 random bytes into a local array
    bytes []byte = with-len(16)
    i <- [0..16): {
        state, r = rand.rand(state)
        bytes[i] = r & 255
    }

    ; Set version 4: high nibble of byte[6] = 0x4
    b6 = bytes[6]
    b6 = (b6 & 15) | 64
    bytes[6] = b6
    ; Set variant RFC4122: high bits of byte[8] = 10xx
    b8 = bytes[8]
    b8 = (b8 & 63) | 128
    bytes[8] = b8

    ; Format as xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
    hex-chars = '0123456789abcdef'
    out str = with-len(36)
    pos = 0
    i <- [0..16): {
        b = bytes[i]
        out[pos] = hex-chars[(b >> 4) & 15]
        pos = pos + 1
        out[pos] = hex-chars[b & 15]
        pos = pos + 1
        i == 3 -> {
            out[pos] = 45
            pos = pos + 1
        }
        i == 5 -> {
            out[pos] = 45
            pos = pos + 1
        }
        i == 7 -> {
            out[pos] = 45
            pos = pos + 1
        }
        i == 9 -> {
            out[pos] = 45
            pos = pos + 1
        }
    }
    print(out)
}
