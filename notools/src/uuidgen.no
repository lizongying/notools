; uuidgen.no — uuidgen utility
; Generate a UUID v4 (random)
; Usage: uuidgen

uuidgen-run = () {

    ; Seed with pid ^ time (non-zero)
    state = os.get-pid() ^ os.now-ns()
    state == 0 -> state = 1

    ; Generate 16 random bytes into a local array
    bytes []byte = with-len(16)
    i <- [0..16): {
        state, r = rand.rand(state)
        bytes[i]: {
            ok -> it = r & 255

            -> _
        }
    }

    ; Set version 4: high nibble of byte[6] = 0x4
    b6 = bytes[6]: {
        ok -> it

        -> 0
    }
    b6 = (b6 & 15) | 64
    bytes[6]: {
        ok -> it = b6

        -> _
    }

    ; Set variant RFC4122: high bits of byte[8] = 10xx
    b8 = bytes[8]: {
        ok -> it

        -> 0
    }
    b8 = (b8 & 63) | 128
    bytes[8]: {
        ok -> it = b8

        -> _
    }

    ; Format as xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
    hex-chars = '0123456789abcdef'
    out str = with-len(36)
    pos = 0
    i <- [0..16): {
        b = bytes[i]

        d9v1 byte = hex-chars.byte((b >> 4) & 15): {
            ok -> it

            -> 0
        }
        out = set-byte-at(out, pos, d9v1)

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }

        d9v2 byte = hex-chars.byte(b & 15): {
            ok -> it

            -> 0
        }
        out = set-byte-at(out, pos, d9v2)

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }
        i == 3 -> {
            out = set-byte-at(out, pos, 45)

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
        i == 5 -> {
            out = set-byte-at(out, pos, 45)

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
        i == 7 -> {
            out = set-byte-at(out, pos, 45)

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
        i == 9 -> {
            out = set-byte-at(out, pos, 45)

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
    }
    print(out)
}

; set-byte-at: replacement for std str.set-byte. The std body concatenates
; []byte slices, which v0.4.37 lowers to invalid LLVM IR; write through a
; []byte buffer with a place-match index store instead.
set-byte-at = (s str, i i64, b byte) (out str) {
    bs []byte = s.to-bytes()
    bs[i]: {
        ok -> it = b

        -> _
    }
    so = bs.to-str()
    out = so: {
        ok -> it

        nil || err -> ''
    }
}
