; uuidgen.no — uuidgen utility
; Generate a UUID v4 (random)
; Usage: uuidgen

uuidgen-run = () {

    ; Seed with pid ^ time (non-zero)
    state = os.get-pid() ^ os.now-ns()
    state == 0 -> state = 1

    ; Generate 16 random bytes into a local array
    bytes []byte = with-len(16)
    i <- [0..16): {
        state, r = rand.rand(state)
        bytes[i]: {
            ok -> it = r & 255

            -> _
        }
    }

    ; Set version 4: high nibble of byte[6] = 0x4
    b6 = bytes[6]
    b6 = (b6 & 15) | 64
    bytes[6]: {
        ok -> it = b6

        -> _
    }

    ; Set variant RFC4122: high bits of byte[8] = 10xx
    b8 = bytes[8]
    b8 = (b8 & 63) | 128
    bytes[8]: {
        ok -> it = b8

        -> _
    }

    ; Format as xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
    hex-chars = '0123456789abcdef'
    out str = with-len(36)
    pos = 0
    i <- [0..16): {
        b = bytes[i]

        d9v1 str = ''
        hex-chars[(b >> 4) & 15]: {
            ok -> d9v1 = it

            -> {
            }
        }
        out[pos]: {
            ok -> it = d9v1

            -> _
        }

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }

        d9v2 str = ''
        hex-chars[b & 15]: {
            ok -> d9v2 = it

            -> {
            }
        }
        out[pos]: {
            ok -> it = d9v2

            -> _
        }

        #{overflow=wrap}
        pos = pos + 1: {
            ok -> it

            -> _
        }
        i == 3 -> {
            out[pos]: {
                ok -> it = 45

                -> _
            }

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
        i == 5 -> {
            out[pos]: {
                ok -> it = 45

                -> _
            }

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
        i == 7 -> {
            out[pos]: {
                ok -> it = 45

                -> _
            }

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
        i == 9 -> {
            out[pos]: {
                ok -> it = 45

                -> _
            }

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
    }
    print(out)
}
