; groups.no — groups utility
; Print group IDs a user belongs to
; Usage: groups [user]
;   user: optional (simplified — always prints current user groups)

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}

groups-run = () {
    gids, ngids = os.getgroups()
    out = ''
    i <- [0..gids.len): {
        i > 0 -> out = out - ' '
        g = gids[i]
        out = out - g.to-str()
    }
    out.len > 0 -> print(out)
}

#{win-amd64, win-arm64}
groups-run = () {
    eprint('groups-run: not supported on this platform')
    os.exit(1)
}
