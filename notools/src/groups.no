// groups.no — groups utility
// Print group IDs a user belongs to
// Usage: groups [user]
//   user: optional (simplified — always prints current user groups)

groups-run = () {
    gids, ngids = os.getgroups()
    out = ''
    i <- [0..gids.len): {
        i > 0 -> out = out - ' '
        g = gids[i]
        out = out - g.to-str()
    }
    out.len > 0 -> print(out)
}
