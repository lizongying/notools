// join.no — join utility
// Join lines of two files on a common field
// Usage: join [-1 F1] [-2 F2] [-t CHAR] file1 file2
//   -1 F1:   join field for file1 (default: 1)
//   -2 F2:   join field for file2 (default: 1)
//   -t CHAR: field separator (default: whitespace)
//   file1 file2: input files (must be sorted on join field)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

// split: split a line into fields by whitespace
split = (line str) (fields []str) {
    start = 0
    in-field = false
    i <- [0..line.len): {
        c = line[i]
        is-space = c == 32 || c == 9
        is-space && in-field -> {
            fields.push(line.slice(start, i))
            in-field = false
        }
        !is-space && !in-field -> {
            start = i
            in-field = true
        }
    }
    in-field -> fields.push(line.slice(start, line.len))
}

// split-char: split a line by a specific character
split-char = (line str, delim i64) (fields []str) {
    start = 0
    i <- [0..line.len): {
        line[i] == delim -> {
            fields.push(line.slice(start, i))
            start = i + 1
        }
    }
    fields.push(line.slice(start, line.len))
}

// content-split: split content into lines
content-split = (content str, lines []str) {
    start = 0
    i <- [0..content.len): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))
            start = i + 1
        }
    }
    start < content.len -> lines.push(content.slice(start, content.len))
}

join-run = () {
    argc = args()
    field1 = 1
    field2 = 1
    delim = 0   // 0 = whitespace
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next == true -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a == '-1' -> {
            i + 1 < argc -> {
                field1 = atoi(arg(i + 1))
                skip-next = true
            }
        }
        a == '-2' -> {
            i + 1 < argc -> {
                field2 = atoi(arg(i + 1))
                skip-next = true
            }
        }
        a == '-t' -> {
            i + 1 < argc -> {
                d = arg(i + 1)
                d.len > 0 -> delim = d[0]
                skip-next = true
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        field1 < 1 -> field1 = 1
        field2 < 1 -> field2 = 1

        files.len < 2 -> {
            eprint('Usage: join [-1 F1] [-2 F2] [-t CHAR] file1 file2')
            os.exit(1)
        }
    }

    content1 = fs.read-file(files[0])
    content2 = fs.read-file(files[1])
    lines1 []str
    lines2 []str
    content-split(content1, lines1)
    content-split(content2, lines2)

    // Merge join (assumes both sorted on join field)
    i1 = 0
    i2 = 0
    n1 = lines1.len
    n2 = lines2.len

    {
        i1 < n1 -> {
            i2 < n2 -> {
                // Get join keys
                f1 []str
                f2 []str
                delim == 0 -> {
                    f1 = split(lines1[i1])
                    f2 = split(lines2[i2])
                }
                delim != 0 -> {
                    f1 = split-char(lines1[i1], delim)
                    f2 = split-char(lines2[i2], delim)
                }
                key1 = ''
                key2 = ''
                field1 <= f1.len -> key1 = f1[field1 - 1]
                field2 <= f2.len -> key2 = f2[field2 - 1]

                cmp = key1.compare(key2)
                cmp < 0 -> i1 = i1 + 1
                cmp > 0 -> i2 = i2 + 1
                cmp == 0 -> {
                    // Join: output key + rest of line1 (minus key field) + rest of line2 (minus key field)
                    out = key1
                    sep = ' '
                    delim != 0 -> sep = line-sep-str(delim)

                    j <- [0..f1.len): {
                        j != field1 - 1 -> {
                            out = out - sep - f1[j]
                        }
                    }
                    j <- [0..f2.len): {
                        j != field2 - 1 -> {
                            out = out - sep - f2[j]
                        }
                    }
                    print(out)
                    i1 = i1 + 1
                    i2 = i2 + 1
                }
            }
            i2 >= n2 -> break
        }
        i1 >= n1 -> break
    } (i1 < n1 && i2 < n2)
}

// line-sep-str: convert a delimiter byte to a single-char string
line-sep-str = (delim i64) (s str) {
    s = ' '
    {
        delim == 9 -> s = '\t'
        delim != 9 -> {
            delim != 32 -> {
                // For other delimiters, build a single-char string
                s = with-cap(1)
                s[0] = delim
            }
        }
    }
}
