; join.no — join utility
; Join lines of two files on a common field
; Usage: join [-1 F1] [-2 F2] [-j F] [-t CHAR] [-o LIST] [-e STR] [-a1] [-a2] file1 file2
;   -1 F1:   join field for file1 (default: 1)
;   -2 F2:   join field for file2 (default: 1)
;   -j F:    use F as the join field for both files
;   -t CHAR: field separator (default: whitespace); also used as output separator
;   -o LIST: output format, comma-separated field specs (0 / F / F.N)
;   -e STR:  string replacing missing fields
;   -a1/-a2: also print unpairable lines from file1/file2

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len()): {
        c = s[i]

        {
            c >= 48 && c <= 57 -> {

                #{overflow=wrap}
                v = v * 10 + (c - 48)
            }

            -> {
            }
        }
    }
}

; split: split a line into fields by whitespace
split = (line str) (fields []str) {
    start = 0
    in-field = false
    i <- [0..line.len-bytes()): {
        c = line[i]: {
            ok -> it

            -> _
        }
        is-space bool = c == 32 || c == 9
        {
            is-space && in-field -> {
                fields.push(line.slice(start, i))
                in-field = false
            }

            ! is-space && ! in-field -> {
                start = i
                in-field = true
            }

            -> {
            }
        }
    }
    {
        in-field -> fields.push(line.slice(start, line.len-bytes())) -> {}
    }
}

; split-char: split a line by a specific character
split-char = (line str, delim i64) (fields []str) {
    start = 0
    i <- [0..line.len-bytes()): {
        {
            line[i] == delim -> {
                fields.push(line.slice(start, i))

                #{overflow=wrap}
                start = i + 1
            }

            -> {
            }
        }
    }
    fields.push(line.slice(start, line.len-bytes()))
}

; content-split: split content into lines
content-split = (content str, lines []str) {
    start = 0
    i <- [0..content.len()): {
        {
            content[i] == 10 -> {
                lines.push(content.slice(start, i))

                #{overflow=wrap}
                start = i + 1
            }

            -> {
            }
        }
    }
    {
        start < content.len() -> lines.push(content.slice(start, content.len())) -> {}
    }
}

; line-sep-str: convert a delimiter byte to a single-char string
line-sep-str = (delim i64) (s str) {
    s = ' '
    {
        delim == 9 -> s = '\t'

        delim != 9 -> {
            delim != 32 -> {
                s = with-len(1)
                s = set-byte-at(s, 0, delim)
            }

            -> {
            }
        }

        -> {
        }
    }
}

; jopts bundles the resolved option state passed to emit-row / get-field.
jopts {
    o-file []i64
    o-idx []i64
    has-ofmt bool
    delim i64
    estr str
    field1 i64
    field2 i64
}

; parse-spec: parse one -o field spec into file number and field index.
;   "0"    -> file 0 (join field), idx 0
;   "N"    -> file N, idx 0 (that file's join field)
;   "F.N"  -> file F, field N
parse-spec = (spec str) (file i64, idx i64) {
    file = 0
    idx = 0
    dot = -1
    k <- [0..spec.len()): {
        {
            spec[k] == 46 -> dot = k

            -> {
            }
        }
    }
    {
        dot < 0 -> {
            file = atoi(spec)
            idx = 0
        }

        dot >= 0 -> {
            a = spec.slice(0, dot)
            file = atoi(a)

            #{overflow=wrap}
            b = spec.slice(dot + 1, spec.len())
            idx = atoi(b)
        }

        -> {
        }
    }
}

; get-field: resolve one -o spec against the two field arrays.
;   file==0 -> join key; file==1/2 -> that file's field (idx==0 means its join field).
;   out-of-range -> o.estr (missing replacement).
get-field = (file i64, idx i64, key str, f1 []str, f2 []str, o jopts) (s str) {
    s = o.estr
    {
        file == 0 -> s = key

        file == 1 -> {
            n = idx
            {
                idx == 0 -> n = o.field1

                -> {
                }
            }
            {
                n >= 1 && n <= f1.len() -> {

                    #{overflow=wrap}
                    ni = n - 1: {
                        ok -> it

                        -> _
                    }
                    fv = f1[ni]: {
                        ok -> it

                        -> ''
                    }
                    s = fv
                }

                -> {
                }
            }
        }

        file == 2 -> {
            n = idx
            {
                idx == 0 -> n = o.field2

                -> {
                }
            }
            {
                n >= 1 && n <= f2.len() -> {

                    #{overflow=wrap}
                    ni = n - 1: {
                        ok -> it

                        -> _
                    }
                    fv = f2[ni]: {
                        ok -> it

                        -> ''
                    }
                    s = fv
                }

                -> {
                }
            }
        }

        -> {
        }
    }
}

; emit-row: print a joined line. Missing side is passed as an empty field array.
emit-row = (f1 []str, f2 []str, key str, o jopts) {
    sep = ' '
    {
        o.delim != 0 -> sep = line-sep-str(o.delim)

        -> {
        }
    }

    out = ''
    first = true
    {
        o.has-ofmt -> {
            m <- [0..o.o-file.len()): {
                file = o.o-file[m]
                idx = o.o-idx[m]
                v = get-field(file, idx, key, f1, f2, o)
                {
                    first -> {
                        out = v
                        first = false
                    }

                    ! first -> {
                        out = out - sep - v
                    }

                    -> {
                    }
                }
            }
        }

        ! o.has-ofmt -> {
            out = key

            #{overflow=wrap}
            skip1 = o.field1 - 1

            #{overflow=wrap}
            skip2 = o.field2 - 1
            j <- [0..f1.len()): {
                {
                    j != skip1 -> {
                        fv = f1[j]: {
                            ok -> it

                            -> ''
                        }
                        out = out - sep - fv
                    }

                    -> {
                    }
                }
            }
            j <- [0..f2.len()): {
                {
                    j != skip2 -> {
                        fv = f2[j]: {
                            ok -> it

                            -> ''
                        }
                        out = out - sep - fv
                    }

                    -> {
                    }
                }
            }
        }

        -> {
        }
    }
    print(out)
}

; fields-of: split a line into fields per the delimiter option.
fields-of = (line str, delim i64) (fs []str) {
    {
        delim == 0 -> fs = split(line)

        delim != 0 -> fs = split-char(line, delim)

        -> {
        }
    }
}

; key-of: extract the join key for a given file's fields.
key-of = (fs []str, field i64) (key str) {
    key = ''
    {
        field >= 1 && field <= fs.len() -> {

            #{overflow=wrap}
            fi = field - 1: {
                ok -> it

                -> _
            }
            fv = fs[fi]: {
                ok -> it

                -> ''
            }
            key = fv
        }

        -> {
        }
    }
}

join-run = () {
    argc = os.args().len()
    field1 = 1
    field2 = 1
    delim = 0
    estr = ''
    a1 = false
    a2 = false
    has-ofmt = false
    of []i64
    oi []i64
    files []str
    skip-next = false

    i <- [2..argc): {
        {
            skip-next -> {
                skip-next = false
                continue
            }

            -> {
            }
        }
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            a == '-1' -> {

                #{overflow=wrap}
                ni = i + 1: {
                    ok -> it

                    -> _
                }
                {
                    ni < argc -> {
                        aopt = os.arg(ni)
                        av = aopt: {
                            ok -> it

                            -> ''
                        }
                        field1 = atoi(av)
                        skip-next = true
                    }

                    -> {
                    }
                }
            }

            a == '-2' -> {

                #{overflow=wrap}
                ni = i + 1: {
                    ok -> it

                    -> _
                }
                {
                    ni < argc -> {
                        aopt = os.arg(ni)
                        av = aopt: {
                            ok -> it

                            -> ''
                        }
                        field2 = atoi(av)
                        skip-next = true
                    }

                    -> {
                    }
                }
            }

            a == '-j' -> {

                #{overflow=wrap}
                ni = i + 1: {
                    ok -> it

                    -> _
                }
                {
                    ni < argc -> {
                        aopt = os.arg(ni)
                        av = aopt: {
                            ok -> it

                            -> ''
                        }
                        jf = atoi(av)
                        field1 = jf
                        field2 = jf
                        skip-next = true
                    }

                    -> {
                    }
                }
            }

            a == '-t' -> {
                i + 1 < argc -> {

                    #{overflow=wrap}
                    d-opt = os.arg(i + 1)
                    d = d-opt: {
                        ok -> it

                        -> ''
                    }
                    {
                        d.len() > 0 -> delim = d[0]

                        -> {
                        }
                    }
                    skip-next = true
                }

                -> {
                }
            }

            a == '-e' -> {
                i + 1 < argc -> {

                    #{overflow=wrap}
                    estr-opt = os.arg(i + 1)
                    estr = estr-opt: {
                        ok -> it

                        -> ''
                    }
                    skip-next = true
                }

                -> {
                }
            }

            a == '-a1' -> a1 = true

            a == '-a2' -> a2 = true

            a == '-o' -> {
                i + 1 < argc -> {
                    has-ofmt = true

                    #{overflow=wrap}
                    kk i64 = 0
                    i + 1: {
                        ok -> kk = it

                        -> _
                    }
                    list-opt = os.arg(kk)
                    list = list-opt: {
                        ok -> it

                        -> ''
                    }
                    start = 0

                    #{overflow=wrap}
                    k <- [0..list.len()): {
                        last = k == list.len() - 1
                        {
                            list[k] == 44 || last -> {
                                end = k
                                {
                                    last -> end = list.len()

                                    -> {
                                    }
                                }
                                spec = list.slice(start, end)
                                {
                                    spec.len() > 0 -> {
                                        file, idx = parse-spec(spec)
                                        of.push(file)
                                        oi.push(idx)
                                    }

                                    -> {
                                    }
                                }

                                #{overflow=wrap}
                                start = k + 1
                            }

                            -> {
                            }
                        }
                    }
                    skip-next = true
                }

                -> {
                }
            }

            ! a.starts-with('-') -> files.push(a)

            -> {
            }
        }
    }

    {
        field1 < 1 -> field1 = 1

        -> {
        }
    }
    {
        field2 < 1 -> field2 = 1

        -> {
        }
    }
    {
        files.len() < 2 -> {
            eprint('Usage: join [-1 F1] [-2 F2] [-j F] [-t CHAR] [-o LIST] [-e STR] [-a1] [-a2] file1 file2')
            exit(1)
        }

        -> {
        }
    }

    o = jopts{
        o-file: of
        o-idx: oi
        has-ofmt: has-ofmt
        delim: delim
        estr: estr
        field1: field1
        field2: field2
    }

    content1 = ''
    f0 = files[0]: {
        ok -> it

        -> ''
    }
    r1 = fs.read-str(f0)
    r1: {
        ok -> content1 = it

        nil -> {
        }

        err -> {
        }
    }
    content2 = ''
    f1p = files[1]: {
        ok -> it

        -> ''
    }
    r2 = fs.read-str(f1p)
    r2: {
        ok -> content2 = it

        nil -> {
        }

        err -> {
        }
    }
    lines1 []str
    lines2 []str
    content-split(content1, lines1)
    content-split(content2, lines2)

    n1 = lines1.len()
    n2 = lines2.len()
    i1 = 0
    i2 = 0
    empty []str

    (i1 < n1 && i2 < n2) {
        j1 = lines1[i1]: {
            ok -> it

            -> ''
        }
        cf1 = fields-of(j1, delim)
        j2 = lines2[i2]: {
            ok -> it

            -> ''
        }
        cf2 = fields-of(j2, delim)
        key1 = key-of(cf1, field1)
        key2 = key-of(cf2, field2)
        cmp = key1.compare(key2)
        {
            cmp < 0 -> {
                {
                    a1 -> emit-row(cf1, empty, key1, o) -> {}
                }

                #{overflow=wrap}
                i1 = i1 + 1: {
                    ok -> it

                    -> _
                }
            }

            cmp > 0 -> {
                {
                    a2 -> emit-row(empty, cf2, key2, o) -> {}
                }

                #{overflow=wrap}
                i2 = i2 + 1: {
                    ok -> it

                    -> _
                }
            }

            cmp == 0 -> {
                b1-start = i1

                #{overflow=wrap}
                i1 = i1 + 1: {
                    ok -> it

                    -> _
                }
                (i1 < n1) {
                    j3 = lines1[i1]: {
                        ok -> it

                        -> ''
                    }
                    kk2 str = key-of(fields-of(j3, delim), field1)
                    {
                        kk2.compare(key1) == 0 -> {

                            #{overflow=wrap}
                            i1 = i1 + 1: {
                                ok -> it

                                -> _
                            }
                        }

                        -> {
                        }
                    }
                    {
                        kk2.compare(key1) != 0 -> break

                        -> {
                        }
                    }
                }
                b1-end = i1
                b2-start = i2

                #{overflow=wrap}
                i2 = i2 + 1: {
                    ok -> it

                    -> _
                }
                (i2 < n2) {
                    j4 = lines2[i2]: {
                        ok -> it

                        -> ''
                    }
                    kk2 = key-of(fields-of(j4, delim), field2)
                    {
                        kk2.compare(key1) == 0 -> {

                            #{overflow=wrap}
                            i2 = i2 + 1: {
                                ok -> it

                                -> _
                            }
                        }

                        -> {
                        }
                    }
                    {
                        kk2.compare(key1) != 0 -> break

                        -> {
                        }
                    }
                }
                b2-end = i2
                x <- [b1-start..b1-end): {
                    j5 = lines1[x]: {
                        ok -> it

                        -> ''
                    }
                    gf1 = fields-of(j5, delim)
                    gx = key-of(gf1, field1)
                    y <- [b2-start..b2-end): {
                        j6 = lines2[y]: {
                            ok -> it

                            -> ''
                        }
                        gf2 = fields-of(j6, delim)
                        emit-row(gf1, gf2, gx, o)
                    }
                }
            }

            -> {
            }
        }
    }
    (i1 < n1) {
        {
            a1 -> {
                j7 = lines1[i1]: {
                    ok -> it

                    -> ''
                }
                tf1 = fields-of(j7, delim)
                emit-row(tf1, empty, key-of(tf1, field1), o)
            }

            -> {
            }
        }

        #{overflow=wrap}
        i1 = i1 + 1: {
            ok -> it

            -> _
        }
    }
    (i2 < n2) {
        {
            a2 -> {
                j8 = lines2[i2]: {
                    ok -> it

                    -> ''
                }
                tf2 = fields-of(j8, delim)
                emit-row(empty, tf2, key-of(tf2, field2), o)
            }

            -> {
            }
        }

        #{overflow=wrap}
        i2 = i2 + 1: {
            ok -> it

            -> _
        }
    }
}

; set-byte-at: replacement for std str.set-byte. The std body concatenates
; []byte slices, which v0.4.37 lowers to invalid LLVM IR; write through a
; []byte buffer with a place-match index store instead.
set-byte-at = (s str, i i64, b byte) (out str) {
    bs []byte = s.to-bytes()
    bs[i]: {
        ok -> it = b

        -> _
    }
    so = bs.to-str()
    out = so: {
        ok -> it

        nil || err -> ''
    }
}
