; logger.no — logger utility
; Send a message to the system log
; Usage: logger [-t TAG] [-p PRIO] MESSAGE

logger-parse-int = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
logger-run = () {
    argc = args()
    priority = 4
    next-is-t = false
    next-is-p = false
    msg-parts []str
    i <- [2..argc): {
        a = arg(i)
        {
            next-is-t -> next-is-t = false
            next-is-p -> {
                priority = logger-parse-int(a)
                next-is-p = false
            }
            a == '-t' -> next-is-t = true
            a == '-p' -> next-is-p = true
            -> {
                msg-parts.push(a)
            }
        }
    }
    {
        msg-parts.len == 0 -> {
            eprint('Usage: logger [-t TAG] [-p PRIO] MESSAGE')
            os.exit(1)
        }
    }
    msg = ''
    i <- [0..msg-parts.len): {
        i > 0 -> msg = msg - ' '
        msg = msg - msg-parts[i]
    }
    syslog(priority, msg)
}

#{win-amd64, win-arm64}
logger-run = () {
    eprint('logger-run: not supported on this platform')
    os.exit(1)
}
