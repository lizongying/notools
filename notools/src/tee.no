# /src/tee.tee-run
write-one = (f str, data str) {
    fd = fs.open-write(f)
    n = data.len
    fs.write(fd, data, n)
    fs.close(fd)
}

tee-run = () {
    argc = args()
    append = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        a == '-a' -> append = true
        ! a.starts-with('-') -> files.push(a)
    }
    content = fs.read-file('/dev/stdin')
    printf('%s', content)
    i <- [0..files.len): {
        write-one(files[i], content)
    }
}