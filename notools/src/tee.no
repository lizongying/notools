// tee.no — tee utility
// Read from stdin and write to stdout and one or more files
// Usage: tee [-a] [file...]
//   -a: append to files instead of overwriting

tee-run = () {
    argc = args()
    append = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        a == '-a' -> append = true
        ! a.starts-with('-') -> files.push(a)
    }
    files.len == 0 -> {
        print('Usage: tee [-a] [file...]')
        os.exit(1)
    }
    content = fs.read-file('/dev/stdin')
    // mirror to stdout without adding a trailing newline
    printf('%s', content)
    i <- [0..files.len): {
        f = files[i]
        fd = 0
        append -> fd = fs.open-file(f, 521, 420)
        append == false -> fd = fs.open-write(f)
        fd < 0 -> {
            io.errln('tee: ' - f - ': cannot open file')
            continue
        }
        fs.write(fd, content, content.len)
        fs.close(fd)
    }
}
