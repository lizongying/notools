# /notools/src/tee.tee

write-one = (f str, data str) {
    fd = fs.open-write(f)
    n = data.len
    fs.write(fd, data, n)
    fs.close(fd)
}

tee-run = () {
    argc = args()
    append = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        a == '-a' -> append = true
        ! a.starts-with('-') -> files.push(a)
    }
    content = ''
    r = fs.read-stdin-str()
    r: {
        ok -> content = it
        nil -> {
        }
        err -> {
        }
    }
    io.out(content)
    i <- [0..files.len): {
        write-one(files[i], content)
    }
}
