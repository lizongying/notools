// tr 调试副本：打印关键中间值
tr-run = () {
    argc = args()
    dmode = 0
    i <- [2..argc): {
        a = arg(i)
        a == '-d' -> dmode = 1
    }
    sets []str
    i <- [2..argc): {
        a = arg(i)
        a == '-d' -> { continue }
        ! a.starts-with('-') -> sets.push(a)
    }
    printf('argc=%d dmode=%d sets.len=%d\n', argc, dmode, sets.len)
    set1 = sets[0]
    set2 = ''
    sets.len > 1 -> set2 = sets[1]
    printf('set1=%s set2=%s\n', set1, set2)
    content = fs.read-file('/dev/stdin')
    printf('content.len=%d\n', content.len)
    j <- [0..content.len): {
        c = content[j]
        dmode == 0 -> outc = c
        dmode == 0 -> { x <- [0..set1.len): { set1[x] == c -> outc = c; set2.len > x -> outc = set2[x] } }
        dmode == 0 -> printf('char=%d outc=%d\n', c, outc)
        dmode == 0 -> printf('%s', char-to-str(outc))
    }
    print('')
}
main = () { tr-run() }
