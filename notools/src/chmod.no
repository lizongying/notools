// chmod.no — chmod utility
// Change file permissions
// Usage: chmod <mode> <files...>
//   mode: octal permission mode (e.g., 644, 755)
//   files: files to change permissions

main = () {
    argc = args()

    argc < 3 -> {
        print('Usage: chmod <mode> <files...>')
        os.exit(1)
    }

    mode-str = arg(2)
    mode = 0
    i <- [0..mode-str.len): {
        c = mode-str[i]
        c >= '0' && c <= '7' -> mode = mode * 8 + (c - '0')
    }

    i <- [3..argc): {
        path = arg(i)
        ok = os.ch-mod(path, mode)
        ok == false -> {
            print('chmod: cannot change permissions of ' - path)
            os.exit(1)
        }
    }
}