; ls.no — ls utility
; Lists directory contents
; Usage: ls [-a] [-l] [path]
;   -a: show hidden files (starting with '.')
;   -l: long format (type size name)
;   path: directory to list (defaults to '.')

ls-run = () {
    argc = os.args().len()

    show-hidden = false
    long-format = false
    dir = '.'

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a.starts-with('-') -> {
            show-hidden = show-hidden || a.contains('a')
            long-format = long-format || a.contains('l')
        }
        ! a.starts-with('-') -> dir = a
    }

    dirp = fs.open-dir(dir)
    {
        dirp == 0 -> {
            io.errln('ls: cannot access ' - dir)
            exit(1)
        }
    }

    names []str
    ok = true
    (ok) {
        name-opt = fs.read-dir(dirp)
        name = ''
        ok = false
        name-opt: {
            ok -> {
                name = it
                ok = true
            }

            -> {
            }
        }
        {
            ok -> {
                hidden = name.starts-with('.')
                show-hidden || ! hidden -> {
                    names.push(name)
                }
            }
        }
    }
    fs.close-dir(dirp)

    ; bubble sort names lexicographically
    nl = names.len()
    bi <- [0..nl): {
        lim = (nl - bi - 1): {
            ok -> it

            -> _
        }
        bj <- [0..lim): {
            n1 str = names[bj]: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            bj1 = bj + 1: {
                ok -> it

                -> _
            }
            n2 str = names[bj1]: {
                ok -> it

                -> _
            }
            cmp = n1.compare(n2)
            {
                cmp > 0 -> {
                    tmp = names[bj]: {
                        ok -> it

                        -> _
                    }

                    #{overflow=wrap}
                    ni = bj + 1: {
                        ok -> it

                        -> _
                    }
                    nb = names[ni]: {
                        ok -> it

                        -> _
                    }
                    names[bj]: {
                        ok -> it = nb

                        -> _
                    }
                    names[bj + 1]: {
                        ok -> it = tmp

                        -> _
                    }
                }

                -> {
                }
            }
        }
    }
    idx <- [0..names.len()): {
        name = names[idx]: {
            ok -> it

            -> _
        }
        {
            long-format -> {
                full = dir - '/' - name
                type = '-'
                fs.is-dir(full) -> type = 'd'
                size = fs.stat-size(full)
                raw = size.to-str()

                #{overflow=wrap}
                pad-count = 8 - raw.len()
                pad-count > 0 -> {
                    spaces = '        '

                    #{overflow=wrap}
                    size-str = spaces.slice(0, pad-count) - raw
                }
                pad-count <= 0 -> {
                    size-str = raw
                }
                line = type - ' ' - size-str - ' ' - name
                print(line)
            }

            ! long-format -> print(name)
        }
    }
}

#{win-amd64, win-arm64}
ls-run-win = () {
    eprint('ls-run: not supported on this platform')
    exit(1)
}
