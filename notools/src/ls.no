// ls.no — ls utility
// Lists directory contents
// Usage: ls [-a] [-l] [path]
//   -a: show hidden files (starting with '.')
//   -l: long format (type size name)
//   path: directory to list (defaults to '.')

ls = () {
    argc = args()

    show-hidden = false
    long-format = false
    dir = '.'

    // Parse arguments after the 'ls' subcommand
    // arg(0)=program, arg(1)='ls', arg(2)+=arguments
    i <- [2..argc): {
        a = arg(i)
        a.starts-with('-') -> {
            show-hidden = show-hidden || a.contains('a')
            long-format = long-format || a.contains('l')
        }
        ! a.starts-with('-') -> dir = a
    }

    // Get directory entries (includes '.' and '..')
    names = fs.list-dir(dir)

    i <- [0..names.len): {
        name = names[i]
        // Skip hidden entries (starting with '.') unless -a flag is set
        hidden = name.starts-with('.')
        show-hidden || ! hidden -> {
            long-format -> {
                // Long format: type size name
                full = dir - '/' - name
                type = '-'
                fs.is-dir(full) -> type = 'd'
                size = fs.stat-size(full)
                size-str = format('{size:8d}')
                print(type - ' ' - size-str - ' ' - name)
            }
            ! long-format -> print(name)
        }
    }
}
