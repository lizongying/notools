// ls.no — ls utility
// Lists directory contents
// Usage: ls [-a] [-l] [path]
//   -a: show hidden files (starting with '.')
//   -l: long format (type size name)
//   path: directory to list (defaults to '.')

ls-run = () {
    argc = args()

    show-hidden = false
    long-format = false
    dir = '.'

    i <- [2..argc): {
        a = arg(i)
        a.starts-with('-') -> {
            show-hidden = show-hidden || a.contains('a')
            long-format = long-format || a.contains('l')
        }
        a.starts-with('-') == false -> dir = a
    }

    dirp = fs.open-dir(dir)
    dirp == 0 -> {
        io.errln('ls: cannot access ' - dir)
        os.exit(1)
    }

    ok = true
    for ok == true {
        name, ok = fs.read-dir(dirp)
        ok -> {
            hidden = name.starts-with('.')
            show-hidden || hidden == false -> {
                long-format -> {
                    full = dir - '/' - name
                    type = '-'
                    fs.is-dir(full) -> type = 'd'
                    size = fs.stat-size(full)
                    raw = size.to-str()
                    pad-count = 8 - raw.len
                    pad-count > 0 -> {
                        spaces = '        '
                        size-str = spaces.slice(0, pad-count) - raw
                    }
                    pad-count <= 0 -> {
                        size-str = raw
                    }
                    line = type - ' ' - size-str - ' ' - name
                    print(line)
                }
                long-format == false -> print(name)
            }
        }
    }
    fs.close-dir(dirp)
}

#{win-amd64, win-arm64}
ls-run-win = () {
    eprint('ls-run: not supported on this platform')
    os.exit(1)
}
