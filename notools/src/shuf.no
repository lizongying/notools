; shuf.no — shuf utility
; Randomly permute input lines
; Usage: shuf [-n N] [file...] | shuf -e arg...
;   -e:     treat arguments as input lines (not files)
;   -n N:   output at most N lines
;   files:  files to read (read from stdin if none)

; split: split content into lines
split = (content str, lines []str) {
    start = 0
    i <- [0..content.len()): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len() -> lines.push(content.slice(start, content.len()))
}

; atoi-shuf: parse a non-negative integer
atoi-shuf = (s str) (v i64) {
    v = 0
    i <- [0..s.len()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

shuf-run = () {
    argc = os.args().len()
    n-limit = 0
    echo-mode = false
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-e' -> echo-mode = true
        a == '-n' -> {
            #{overflow=wrap}
            ni = i + 1: {
                ok -> it

                -> _
            }
            {
                ni < argc -> {
                    nopt = os.arg(ni)
                    nv = nopt: {
                        ok -> it

                        -> ''
                    }
                    n-limit = atoi-shuf(nv)
                    skip-next = true
                }

                -> {
                }
            }
        }
        a.starts-with('-n') -> {
            a.len() > 2 -> n-limit = atoi-shuf(a.slice(2, a.len()))
        }
        ! a.starts-with('-') -> files.push(a)
    }

    ; Collect input lines
    lines []str
    {
        echo-mode -> {
            j <- [0..files.len()): {
                fj = files[j]: {
                    ok -> it

                    -> ''
                }
                lines.push(fj)
            }
        }

        ! echo-mode -> {
            files.len() == 0 -> {
                content = ''
                r = fs.read-stdin-str()
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                split(content, lines)
            }

            files.len() > 0 -> {
                fi <- [0..files.len()): {
                    fp = files[fi]: {
                        ok -> it

                        -> ''
                    }
                    ! fs.is-file(fp) -> {
                        msg = 'shuf: ' - fp - ': No such file or directory'
                        io.errln(msg)
                        continue
                    }
                    content = ''
                    r = fs.read-str(fp)
                    r: {
                        ok -> content = it

                        nil -> {
                        }

                        err -> {
                        }
                    }
                    split(content, lines)
                }
            }
        }
    }

    n = lines.len()
    n == 0 -> return

    ; Index array for indirect shuffle (avoids swapping heap-owned string elements)
    idx []i64
    x <- [0..n): idx.push(x)

    ; Fisher-Yates shuffle using crypto/rand
    state = os.now-ns()
    state = state | 1
    i <- [0..n - 1): {

        #{overflow=wrap}
        j-range = n - i
        state, rv = rand.rand(state)

        #{overflow=wrap}
        j = i + (rv % j-range)

        t = idx[i]: {
            ok -> it

            -> _
        }
        d9v1 = idx[j]: {
            ok -> it

            -> _
        }
        idx[i]: {
            ok -> it = d9v1

            -> _
        }
        idx[j]: {
            ok -> it = t

            -> _
        }
    }

    ; Output
    out-count = n
    {
        n-limit > 0 -> {
            n-limit < n -> out-count = n-limit
        }
    }
    i <- [0..out-count): {
        ii = idx[i]: {
            ok -> it

            -> _
        }
        ln = lines[ii]: {
            ok -> it

            -> ''
        }
        print(ln)
    }
}
