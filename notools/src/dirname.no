// dirname.no — dirname utility
// Return the directory portion of a path
// Usage: dirname <path>

dirname-run = () {
    argc = args()

    argc < 3 -> {
        eprint('Usage: dirname <path>')
        os.exit(1)
    }

    path-str = arg(2)

    // Find effective end: last non-'/' character position + 1
    end = path-str.len
    i <- [0..path-str.len): {
        idx = path-str.len - 1 - i
        end == path-str.len -> {
            // Still determining effective end
            path-str[idx] == 47 -> end = idx
            path-str[idx] != 47 -> break
        }
    }

    // If nothing left (all '/') or root '/', result is '/'
    end == 0 -> {
        print('/')
        return
    }

    // Find last '/' in the remaining string [0..end)
    last-sep = -1
    j <- [0..end): {
        path-str[j] == 47 -> last-sep = j
    }

    {
        last-sep < 0 -> {
            // No '/' found: directory is '.'
            print('.')
        }
        last-sep == 0 -> {
            // Root directory
            print('/')
        }
        -> {
            // Directory is everything before last '/'
            print(path-str.slice(0, last-sep))
        }
    }
}
