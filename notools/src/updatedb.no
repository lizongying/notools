; updatedb.no — updatedb utility (pure Nolang)
; Build a file path database for locate.
; Usage: updatedb [OPTIONS]
;   -U PATH     scan PATH instead of /
;   -o FILE     write to FILE instead of ~/.notools/locatedb
;   --prunepaths DIRS  skip directories (comma-separated)

; walk: recursively walk a directory and collect paths
walk-dir = (dir str, paths []str, prunes []str) {

    ; check if this dir is pruned
    j <- [0..prunes.len()): {
        pj = prunes[j]: {
            ok -> it

            -> ''
        }
        pj == dir -> return
    }

    paths.push(dir)

    dirp = fs.open-dir(dir)
    dirp == 0 -> return

    ok = true
    (ok) {
        name-opt = fs.read-dir(dirp)
        name = ''
        ok = false
        name-opt: {
            ok -> {
                name = it
                ok = true
            }

            -> {
            }
        }
        {
            ok -> {
                skip = name == '.' || name == '..'
                ! skip -> {

                    ; build child path with byte-copy join (B11-safe)
                    child = join-path(dir, name)
                    is-d = fs.is-dir(child)
                    is-d -> walk-dir(child, paths, prunes)
                    ! is-d -> {
                        is-f = fs.is-file(child)
                        is-f -> paths.push(child)
                    }
                }
            }
        }
    }
    fs.close-dir(dirp)
}

; join-path: dir + '/' + name, pure byte copy (B11-safe, no '-' concat in loop)
join-path = (dir str, name str) (out str) {
    need-sep = true
    {
        dir.len() == 0 -> need-sep = false

        dir.len() > 0 -> {

            #{overflow=wrap}
            {
                dir[dir.len() - 1] == 47 -> need-sep = false
            }
        }

        name.len() > 0 -> {
            name[0] == 47 -> need-sep = false
        }
    }

    total = dir.len()

    #{overflow=wrap}
    need-sep -> total = total + 1

    #{overflow=wrap}
    total = total + name.len()

    out = with-len(total)
    n = 0
    i <- [0..dir.len()): {
        di = dir[i]: {
            ok -> it

            -> 0
        }
        out[n]: {
            ok -> it = di

            -> _
        }

        #{overflow=wrap}
        n = n + 1: {
            ok -> it

            -> _
        }
    }
    {
        need-sep -> {
            out[n]: {
                ok -> it = 47

                -> _
            }

            #{overflow=wrap}
            n = n + 1: {
                ok -> it

                -> _
            }
        }
    }
    j <- [0..name.len()): {
        nj = name[j]: {
            ok -> it

            -> 0
        }
        out[n]: {
            ok -> it = nj

            -> _
        }

        #{overflow=wrap}
        n = n + 1: {
            ok -> it

            -> _
        }
    }
}

updatedb-run = () {
    argc = os.args().len()

    root = '/'
    outfile = ''
    prunes []str

    ; default prune paths
    prunes.push('/dev')
    prunes.push('/proc')
    prunes.push('/sys')
    prunes.push('/run')
    prunes.push('/tmp')

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-U' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                ro = os.arg(i + 1)
                root = ro: {
                    ok -> it

                    -> ''
                }
            }
        }
        a == '-o' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                of = os.arg(i + 1)
                outfile = of: {
                    ok -> it

                    -> ''
                }
            }
        }
        a == '--prunepaths' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                pp-opt = os.arg(i + 1)
                pp = pp-opt: {
                    ok -> it

                    -> ''
                }

                ; split by comma
                s = 0
                j <- [0..pp.len()): {
                    pp[j] == 44 -> {
                        prunes.push(pp.slice(s, j))
                        s = j + 1
                    }
                }
                s < pp.len() -> prunes.push(pp.slice(s, pp.len()))
            }
        }
    }

    {
        outfile.len() == 0 -> {
            home-opt = os.get-env('HOME')
            home = home-opt: {
                ok -> it

                -> ''
            }
            outfile = home - '/.notools/locatedb'
        }
    }

    ; ensure parent directory exists
    ; find last '/' in outfile
    last-slash = -1
    j <- [0..outfile.len()): {
        outfile[j] == 47 -> last-slash = j
    }
    {
        last-slash > 0 -> {
            parent = outfile.slice(0, last-slash)
            os.mkdir(parent, 511)
        }
    }

    ; walk filesystem
    paths []str
    walk-dir(root, paths, prunes)

    ; write database
    fd = fs.open-write(outfile)
    j <- [0..paths.len()): {
        line = paths[j]: {
            ok -> it

            -> _
        }
        fs.write(fd, line, line.len-bytes())
        nl []byte = [10]
        fs.write(fd, nl, 1)
    }
    fs.close(fd)

    eprint('updatedb: ' - paths.len().to-str() - ' paths written to ' - outfile)
}

#{win-amd64, win-arm64}
updatedb-run-win = () {
    eprint('updatedb-run: not supported on this platform')
    exit(1)
}
