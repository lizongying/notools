; more.no — more utility
; 簡易分頁器：每屏顯示 24 行，按 Enter 繼續，按 q 退出。
; Usage: more [files...]
;   預設每頁 24 行

MORE-PAGE-LINES = 24

more = () {
    argc = args()
    files []str

    i <- [2..argc): {
        a = arg(i)
        !a.starts-with('-') -> files.push(a)
    }

    {
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            more-display(content)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                ! fs.is-file(files[fi]) -> {
                    eprint('more: ' - files[fi] - ': No such file')
                    os.exit(1)
                }
                content = fs.read-file(files[fi])
                more-display(content)
            }
        }
    }
}

more-display = (content str) {
    lines []str
    start = 0
    i <- [0..content.len): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))
            start = i + 1
        }
    }
    start < content.len -> lines.push(content.slice(start, content.len))

    line-no = 0
    {
        line-no >= lines.len -> *
        ; 輸出一頁
        end = line-no + MORE-PAGE-LINES
        end > lines.len -> end = lines.len
        j <- [line-no..end): {
            print(lines[j])
        }
        line-no = end
        line-no >= lines.len -> *
        ; 提示並等待輸入
        io.out('--More--')
        s = ''
        ok = false
        s, ok = fs.get-line()
        quit = false
        ok -> {
            s.len > 0 -> s[0] == 'q' -> quit = true
        }
        quit -> *
    } ()
}
