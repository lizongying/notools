; more.no — more utility
; 簡易分頁器：每屏顯示 24 行，按 Enter 繼續，按 q 退出。
; Usage: more [files...]
;   預設每頁 24 行

MORE-PAGE-LINES = 24

more = () {
    argc = os.args().len()
    files []str

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            more-display(content)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                fname = files[fi]: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(fname) -> {
                    fp = ''
                    files[fi]: {
                        ok -> fp = it

                        -> _
                    }
                    eprint('more: ' - fp - ': No such file')
                    exit(1)
                }
                content = ''
                r = fs.read-str(fname)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                more-display(content)
            }
        }
    }
}

more-display = (content str) {
    lines []str
    start = 0
    i <- [0..content.len()): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len() -> lines.push(content.slice(start, content.len()))

    line-no = 0
    end = 0
    ! {
        line-no >= lines.len() -> continue

        ; 輸出一頁
        #{overflow=wrap}
        end-opt = line-no + MORE-PAGE-LINES
        end = 0
        end-opt: {
            ok -> end = it

            -> _
        }
        end > lines.len() -> end = lines.len()
        j <- [line-no..end): {
            ln = lines[j]: {
                ok -> it

                -> ''
            }
            print(ln)
        }
        line-no = end
        line-no >= lines.len() -> continue

        ; 提示並等待輸入
        io.out('--More--')
        s = ''
        ok = false
        s, ok = fs.get-line()
        quit = false
        ok -> {
            s.len() > 0 -> s[0] == 'q' -> quit = true
        }
        quit -> continue
    }
}
