// 验证 helper：顶层 range 循环内条件修改返回值能否透传
map-char = (c i64, s1 str, s2 str) (r i64) {
    r = c
    x <- [0..s1.len): {
        s1[x] == c -> r = s2[x]
        s2.len <= x -> r = c
    }
}
main = () {
    printf('%d\n', map-char(97, 'a', 'A'))
    printf('%d\n', map-char(98, 'a', 'A'))
    print('OK')
}
