// rm.no — rm utility
// Removes files or directories
// Usage: rm [-r] [-f] <path...>
//   -r: recursively remove directories and their contents
//   -f: force (ignore non-existent files, don't print errors)
//   -rf: combined flags (recursive + force)
//   path: file or directory to remove

// recursive removes a directory and all its contents.
// path str: directory path to remove recursively
remove-recursive = (path str) {
    names = fs.list-dir(path)
    i <- [0..names.len): {
        name = names[i]
        skip = name == '.' || name == '..'
        skip == false -> {
            full = path - '/' - name
            {
                fs.is-dir(full) -> remove-recursive(full)
                -> fs.remove(full)
            }
        }
    }
    fs.remove(path)
}

// run is the main entry point for the rm utility.
// Parses arguments and dispatches to the appropriate helper.
main = () {
    argc = args()

    recursive = false
    force = false

    // Collect file arguments (non-flag args starting at index 2)
    // arg(0)=program, arg(1)='rm', arg(2)+=arguments
    files []str
    i <- [2..argc): {
        a = arg(i)
        {
            a.starts-with('-') -> {
                recursive = recursive || a.contains('r')
                force = force || a.contains('f')
            }
            -> files.push(a)
        }
    }

    // No file arguments: print usage error
    files.len == 0 -> {
        print('Usage: rm [-r] [-f] <path...>')
        os.exit(1)
    }

    // Process each file argument
    i <- [0..files.len): {
        path = files[i]
        exists = fs.is-file(path) || fs.is-dir(path)
        {
            exists == false -> {
                force == false -> {
                    msg = 'rm: ' - path - ': No such file or directory'
                    io.errln(msg)
                }
            }
            fs.is-dir(path) -> {
                recursive -> remove-recursive(path)
                -> {
                    msg = 'rm: ' - path - ': is a directory'
                    io.errln(msg)
                }
            }
            -> fs.remove(path)
        }
    }
}