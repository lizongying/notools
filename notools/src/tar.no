// tar.no — tar utility
// Create and extract tar archives
// Usage: tar [-c|-x|-t] [-f archive] [-z] [files...]
//   -c: create archive
//   -x: extract archive
//   -t: list contents
//   -f: archive filename
//   -z: use gzip compression

tar-run = () {
    argc = args()

    create = false
    extract = false
    list = false
    gzip = false
    filename = ''
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a.starts-with('-') -> {
            j <- [1..a.len): {
                c = a[j]
                c == "c" -> create = true
                c == "x" -> extract = true
                c == "t" -> list = true
                c == "z" -> gzip = true
                c == "f" -> {
                    i + 1 < argc -> filename = arg(i + 1)
                    skip-next = true
                }
            }
        }
        -> files.push(a)
    }

    filename.len == 0 -> {
        print('tar: no archive filename specified')
        os.exit(1)
    }

    create -> {
        tar-create(filename, files, gzip)
    }
    extract -> {
        tar-extract(filename, gzip)
    }
    list -> {
        tar-list(filename, gzip)
    }
    !(create || extract || list) -> {
        print('tar: must specify one of -c, -x, -t')
        os.exit(1)
    }
}

tar-create = (filename str, files []str, gzip bool) {
    builder = tar-builder{}

    i <- [0..files.len): {
        path = files[i]
        fs.is-dir(path) -> {
            builder.add-dir(path - '/')
            tar-add-dir(builder, path)
        }
        fs.is-file(path) -> {
            content = fs.read-file(path)
            builder.add-file(path, content.to-bytes())
        }
    }

    archive = builder.finish()

    gzip -> {
        compressed = gzip.gzip-compress(archive.data)
        fs.write-file(filename, compressed)
    }
    !gzip -> {
        fs.write-file(filename, archive.data)
    }
}

tar-add-dir = (builder tar-builder, dir str) {
    entries = fs.list-dir(dir)
    i <- [0..entries.len): {
        name = entries[i]
        name == '.' || name == '..' -> continue
        full = dir - '/' - name
        fs.is-dir(full) -> {
            builder.add-dir(full - '/')
            tar-add-dir(builder, full)
        }
        fs.is-file(full) -> {
            content = fs.read-file(full)
            builder.add-file(full, content.to-bytes())
        }
    }
}

tar-extract = (filename str, gzip bool) {
    ! fs.is-file(filename) -> {
        print('tar: ' - filename - ': No such file or directory')
        os.exit(1)
    }
    raw = fs.read-file(filename)
    data = raw.to-bytes()

    gzip -> {
        data = gzip.gzip-decompress(data)
    }

    archive = tar{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        typ = archive.type(i)
        typ == 'dir' -> {
            os.mkdir(name, 493)
        }
        typ == 'file' -> {
            content = archive.read(i)
            fs.write-file(name, content)
        }
    }
}

tar-list = (filename str, gzip bool) {
    ! fs.is-file(filename) -> {
        print('tar: ' - filename - ': No such file or directory')
        os.exit(1)
    }
    raw = fs.read-file(filename)
    data = raw.to-bytes()

    gzip -> {
        data = gzip.gzip-decompress(data)
    }

    archive = tar{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        typ = archive.type(i)
        sz = archive.size(i)
        print(name - '  ' - typ - '  ' - sz.to-str())
    }
}