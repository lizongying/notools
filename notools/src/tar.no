// tar.no — tar utility
// Create and extract tar archives
// Usage: tar [-c|-x|-t] [-f archive] [-z] [files...]
//   -c: create archive
//   -x: extract archive
//   -t: list contents
//   -f: archive filename
//   -z: use gzip compression

tar-run = () {
    argc = args()

    create = false
    extract = false
    list = false
    use-gzip = false
    filename = ''
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a.starts-with('-') -> {
            j <- [1..a.len): {
                c = a[j]
                c == 'c' -> create = true
                c == 'x' -> extract = true
                c == 't' -> list = true
                c == 'z' -> use-gzip = true
                c == 'f' -> {
                    i + 1 < argc -> filename = arg(i + 1)
                    skip-next = true
                }
            }
        }
        files.push(a)
    }

    filename.len == 0 -> {
        print('tar: no archive filename specified')
        os.exit(1)
    }

    create -> do-create(filename, files, use-gzip)
    extract -> do-extract(filename, use-gzip)
    list -> do-list(filename, use-gzip)
    ! (create || extract || list) -> {
        print('tar: must specify one of -c, -x, -t')
        os.exit(1)
    }
}

// collect 遞迴收集目錄下的所有檔案與子目錄路徑
collect = (path str, out []str) {
    entries = fs.list-dir(path)
    i <- [0..entries.len): {
        name = entries[i]
        name == '.' -> continue
        name == '..' -> continue
        full = path - '/' - name
        fs.is-dir(full) -> {
            out.push(full)
            collect(full, out)
        }
        fs.is-file(full) -> out.push(full)
    }
}

do-create = (filename str, files []str, use-gzip bool) {
    // 收集所有檔案與目錄路徑
    all []str
    i <- [0..files.len): {
        path = files[i]
        fs.is-dir(path) -> {
            all.push(path)
            collect(path, all)
        }
        fs.is-file(path) -> all.push(path)
    }

    // 計算總大小以預分配緩衝區
    total = 1024
    i <- [0..all.len): {
        path = all[i]
        fs.is-file(path) -> {
            sz = fs.stat-size(path)
            blocks = (sz + 511) / 512
            total = total + 512 + blocks * 512
        }
        fs.is-dir(path) -> total = total + 512
    }

    // 構建歸檔
    builder = tar-builder{}
    builder.pre-alloc(total)
    i <- [0..all.len): {
        path = all[i]
        fs.is-file(path) -> {
            content = fs.read-file(path)
            builder.add-file(path, content.to-bytes())
        }
        fs.is-dir(path) -> builder.add-dir(path)
    }

    archive = builder.finish()

    use-gzip -> {
        compressed = gzip.gzip-compress(archive.data)
        fs.write-file(filename, compressed)
    }
    ! use-gzip -> fs.write-file(filename, archive.data)
}

do-extract = (filename str, use-gzip bool) {
    ! fs.is-file(filename) -> {
        print('tar: ' - filename - ': No such file or directory')
        os.exit(1)
    }
    raw = fs.read-file(filename)
    data = raw.to-bytes()

    use-gzip -> data = gzip.gzip-decompress(data)
    archive = tar{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        typ = archive.type(i)
        typ == 'dir' -> os.mkdir(name, 493)
        typ == 'file' -> {
            content = archive.read(i)
            fs.write-file(name, content)
        }
    }
}

do-list = (filename str, use-gzip bool) {
    ! fs.is-file(filename) -> {
        print('tar: ' - filename - ': No such file or directory')
        os.exit(1)
    }
    raw = fs.read-file(filename)
    data = raw.to-bytes()

    use-gzip -> data = gzip.gzip-decompress(data)
    archive = tar{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        typ = archive.type(i)
        sz = archive.size(i)
        print(name - '  ' - typ - '  ' - sz.to-str())
    }
}
