; tar.no — tar utility
; Create and extract tar archives
; Usage: tar [-c|-x|-t] [-f archive] [-z] [files...]
;   -c: create archive
;   -x: extract archive
;   -t: list contents
;   -f: archive filename
;   -z: use gzip compression

TAR-BLOCK = 512

; tar-write-octal: write octal number into data at offset
tar-write-octal = (data []byte, off i64, width i64, val i64) {

    ; fill with spaces
    i <- [0..width): {

        #{overflow=wrap}
        data[off + i]: {
            ok -> it = 32

            -> _
        }
    }

    ; fill digits from right to left
    v = val

    #{overflow=wrap}
    pos = width - 1
    (v > 0) {

        #{overflow=wrap}
        op = off + pos: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        dv = 48 + (v % 8): {
            ok -> it

            -> _
        }
        data[op]: {
            ok -> it = dv

            -> _
        }

        #{overflow=wrap}
        v = v / 8: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        pos = pos - 1
    }

    #{overflow=wrap}
    data[off + width]: {
        ok -> it = 0

        -> _
    }
}

; tar-write-header: write a 512-byte tar header into data
tar-write-header = (data []byte, name str, typ i64, sz i64, mode i64) {
    start = data.len()

    ; push 512 zeros for the header
    i <- [0..TAR-BLOCK): {
        data.push(0)
    }

    ; name (offset 0, up to 100 bytes)
    nl = name.len()
    nl > 100 -> nl = 100
    i <- [0..nl): {
        d9v1 str = name[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        data[start + i]: {
            ok -> it = d9v1

            -> _
        }
    }

    ; mode (offset 100, octal)
    #{overflow=wrap}
    tar-write-octal(data, start + 100, 7, mode)

    ; uid (offset 108)
    #{overflow=wrap}
    tar-write-octal(data, start + 108, 7, 0)

    ; gid (offset 116)
    #{overflow=wrap}
    tar-write-octal(data, start + 116, 7, 0)

    ; size (offset 124, 11 octal digits)
    #{overflow=wrap}
    tar-write-octal(data, start + 124, 11, sz)

    ; mtime (offset 136)
    #{overflow=wrap}
    tar-write-octal(data, start + 136, 11, 0)

    ; type (offset 156)
    #{overflow=wrap}
    data[start + 156]: {
        ok -> it = typ

        -> _
    }

    ; ustar magic (offset 257)
    #{overflow=wrap}
    data[start + 257]: {
        ok -> it = 117

        -> _
    }

    #{overflow=wrap}
    data[start + 258]: {
        ok -> it = 115

        -> _
    }

    #{overflow=wrap}
    data[start + 259]: {
        ok -> it = 116

        -> _
    }

    #{overflow=wrap}
    data[start + 260]: {
        ok -> it = 97

        -> _
    }

    #{overflow=wrap}
    data[start + 261]: {
        ok -> it = 114

        -> _
    }

    #{overflow=wrap}
    data[start + 262]: {
        ok -> it = 0

        -> _
    }

    ; checksum: fill with spaces first
    i <- [0..8): {

        #{overflow=wrap}
        data[start + 148 + i]: {
            ok -> it = 32

            -> _
        }
    }

    ; compute checksum
    checksum = 0
    i <- [0..TAR-BLOCK): {

        #{overflow=wrap}
        si = start + i: {
            ok -> it

            -> _
        }
        db byte = data[si]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        cs = checksum + (db & 255): {
            ok -> it

            -> _
        }
        checksum = cs
    }

    ; write checksum (6 octal digits + null + space)
    #{overflow=wrap}
    tar-write-octal(data, start + 148, 6, checksum)

    #{overflow=wrap}
    data[start + 154]: {
        ok -> it = 0

        -> _
    }

    #{overflow=wrap}
    data[start + 155]: {
        ok -> it = 32

        -> _
    }
}

; tar-add-file: write header + content + padding into data
tar-add-file = (data []byte, name str, content str) {
    sz = content.len()
    tar-write-header(data, name, 48, sz, 420)

    ; write content
    i <- [0..sz): {
        data.push(content[i])
    }

    ; pad to 512 boundary
    rem = sz % TAR-BLOCK
    {
        rem > 0 -> {

            #{overflow=wrap}
            pad = TAR-BLOCK - rem
            j <- [0..pad): {
                data.push(0)
            }
        }
    }
}

; tar-add-dir: write directory header into data
tar-add-dir = (data []byte, name str) {
    dname = name
    ! dname.ends-with('/') -> dname = dname - '/'
    tar-write-header(data, dname, 53, 0, 493)
}

; collect: recursively collect all files and dirs under path
collect = (path str, out []str) {
    entries = fs.list-dir(path)
    i <- [0..entries.len()): {
        name = entries[i]: {
            ok -> it

            -> _
        }
        name == '.' -> continue
        name == '..' -> continue
        full = path - '/' - name
        fs.is-dir(full) -> {
            out.push(full)
            collect(full, out)
        }
        fs.is-file(full) -> out.push(full)
    }
}

do-create = (filename str, files []str, use-gzip bool) {

    ; collect all files and dirs
    all []str
    i <- [0..files.len()): {
        path = files[i]: {
            ok -> it

            -> _
        }
        fs.is-dir(path) -> {
            all.push(path)
            collect(path, all)
        }
        fs.is-file(path) -> all.push(path)
    }

    ; build tar archive as local []byte
    data []byte
    i <- [0..all.len()): {
        path = all[i]: {
            ok -> it

            -> _
        }
        fs.is-file(path) -> {
            content = ''
            r = fs.read-str(path)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            tar-add-file(data, path, content)
        }
        fs.is-dir(path) -> tar-add-dir(data, path)
    }

    ; end markers: two 512-byte zero blocks
    i <- [0..TAR-BLOCK * 2): {
        data.push(0)
    }

    {
        use-gzip -> {
            compressed = gzip.compress(data)
            fs.write-file(filename, compressed)
        }

        ! use-gzip -> fs.write-file(filename, data)
    }
}

; is-skip-entry: 判断是否跳过此条目（PAX header / AppleDouble）
is-skip-entry = (name str, typ str) (skip bool) {
    skip = false
    {
        typ == 'unknown' -> skip = true

        skip -> return

        ; AppleDouble files (._ prefix)
        name.starts-with('._') -> skip = true

        name.contains('/._') -> skip = true
    }
}

; make-parent-dirs: 为文件路径创建父目录
tar-make-parent-dirs = (name str) {
    n = name.len()
    i <- [1..n): {
        name[i] == '/' -> {
            dir = name.slice(0, i)
            dir.len() > 0 -> {
                ! fs.is-dir(dir) -> os.mkdir(dir, 511)
            }
        }
    }
}

do-extract = (filename str, use-gzip bool) {
    {
        ! fs.is-file(filename) -> {
            print('tar: ' - filename - ': No such file or directory')
            exit(1)
        }
    }
    raw []byte
    r = fs.read-bytes(filename)
    r: {
        ok -> raw = it

        nil -> {
        }

        err -> {
        }
    }
    data = raw

    use-gzip -> data = gzip.decompress(data)
    archive = tar{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        typ = archive.type(i)
        skip = is-skip-entry(name, typ)
        skip -> continue
        typ == 'dir' -> os.mkdir(name, 493)
        typ == 'file' -> {
            tar-make-parent-dirs(name)

            ; read content directly from data (avoid archive.read which returns []byte)
            sz = archive.size(i)
            off = archive.offset(i)
            content []byte = with-len(sz)
            j <- [0..sz): {

                #{overflow=wrap}
                oi = off + TAR-BLOCK + j: {
                    ok -> it

                    -> _
                }
                d9v2 byte = data[oi]: {
                    ok -> it

                    -> _
                }
                content[j]: {
                    ok -> it = d9v2

                    -> _
                }
            }
            fs.write-file(name, content)
        }
    }
}

do-list = (filename str, use-gzip bool) {
    {
        ! fs.is-file(filename) -> {
            print('tar: ' - filename - ': No such file or directory')
            exit(1)
        }
    }
    raw []byte
    r = fs.read-bytes(filename)
    r: {
        ok -> raw = it

        nil -> {
        }

        err -> {
        }
    }
    data = raw

    use-gzip -> data = gzip.decompress(data)
    archive = tar{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        typ = archive.type(i)
        skip = is-skip-entry(name, typ)
        skip -> continue
        print(name)
    }
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
tar-run = () {
    argc = os.args().len()

    create = false
    extract = false
    list = false
    use-gzip = false
    filename = ''
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a.starts-with('-') -> {
            j <- [1..a.len()): {
                c = a[j]
                c == 'c' -> create = true
                c == 'x' -> extract = true
                c == 't' -> list = true
                c == 'z' -> use-gzip = true
                c == 'f' -> {

                    #{overflow=wrap}
                    ni = i + 1: {
                        ok -> it

                        -> _
                    }
                    ni < argc -> {
                        fn = os.arg(ni)
                        fn: {
                            ok -> filename = it

                            -> _
                        }
                    }
                    skip-next = true
                }
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }

    {
        filename.len() == 0 -> {
            print('tar: no archive filename specified')
            exit(1)
        }

        create -> do-create(filename, files, use-gzip)

        extract -> do-extract(filename, use-gzip)

        list -> do-list(filename, use-gzip)

        ! (create || extract || list) -> {
            print('tar: must specify one of -c, -x, -t')
            exit(1)
        }
    }
}

#{win-amd64, win-arm64}
tar-run = () {
    eprint('tar-run: not supported on this platform')
    exit(1)
}
