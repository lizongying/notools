// who.no — who utility
// Show who is logged on
// Usage: who
// Simplified: prints current user and terminal

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}

who-cmd = () {
    user = os.get-login()
    user.len == 0 -> {
        user = os.get-env('USER')
    }
    user.len == 0 -> {
        user = os.get-env('LOGNAME')
    }
    user.len == 0 -> {
        eprint('who: no users logged in')
        os.exit(1)
        return
    }
    term = os.ttyname(0)
    term.len == 0 -> {
        term = '?'
    }
    // Simplified format: "NAME  LINE"
    print(user - '  ' - term)
}

#{win-amd64, win-arm64}
who-cmd = () {
    eprint('who-cmd: not supported on this platform')
    os.exit(1)
}
