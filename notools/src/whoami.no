// whoami.no — whoami utility
// Print the effective user name
// Usage: whoami

whoami-run = () {
    u = os.get-env('USER')
    {
        u.len > 0 -> {
            print(u)
            return
        }
    }
    u = os.get-env('LOGNAME')
    {
        u.len > 0 -> {
            print(u)
            return
        }
    }
    print(os.get-env('USERNAME'))
}
