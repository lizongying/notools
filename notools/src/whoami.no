; whoami.no — whoami utility
; Print the effective user name
; Usage: whoami

whoami-run = () {
    u-opt = os.get-env('USER')
    u = u-opt: {
        ok -> it

        -> ''
    }
    {
        u.len() > 0 -> {
            print(u)
            return
        }
    }
    u-opt = os.get-env('LOGNAME')
    u = u-opt: {
        ok -> it

        -> ''
    }
    {
        u.len() > 0 -> {
            print(u)
            return
        }
    }
    print(os.get-env('USERNAME'))
}
