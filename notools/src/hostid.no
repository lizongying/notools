; hostid.no — hostid utility
; Print the host identifier as 8-digit lowercase hex
; Usage: hostid

hostid-run = () {
    id = os.get-host-id()
    hex = '0123456789abcdef'
    out = ''
    i <- [0..8): {

        #{overflow=wrap}
        shift = (7 - i) * 4
        nibble = (id >> shift) & 15

        #{overflow=wrap}
        out = out - hex.slice(nibble, nibble + 1)
    }
    print(out)
}
