; link.no — link utility
; Create a hard link
; Usage: link FILE LINKNAME

link-run = () {
    argc = os.args()
    {
        argc != 4 -> {
            eprint('Usage: link FILE LINKNAME')
            os.exit(1)
        }
    }
    file = os.arg(2)
    linkname = os.arg(3)
    ok = os.link(file, linkname)
    {
        ! ok -> {
            eprint('link: cannot create link ' - linkname - ' to ' - file)
            os.exit(1)
        }
    }
}
