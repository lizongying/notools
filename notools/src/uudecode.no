; uudecode.no — uudecode utility
; Decode a uuencoded file
; Usage: uudecode [FILE]   (reads stdin if no FILE)

uudecode-run = () {
    argc = os.args().len()
    content = ''
    {
        argc < 3 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }

        -> {
            path-opt = os.arg(2)
            path = path-opt: {
                ok -> it

                -> ''
            }
            ! fs.is-file(path) -> {
                eprint('uudecode: ' - path - ': No such file')
                exit(1)
            }
            content = ''
            r = fs.read-str(path)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    ; Find "begin MODE NAME" line
    lines []str
    start = 0
    i <- [0..content.len()): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len() -> lines.push(content.slice(start, content.len()))

    ; Find begin line
    begin-idx = -1
    out-name = ''
    i <- [0..lines.len()): {

        #{index-out=zero}
        line = lines[i]
        line.starts-with('begin ') -> {
            begin-idx = i

            ; Extract name: skip "begin MODE "
            rest = line.slice(7, line.len-bytes())
            sp = rest.index(' ')
            sp >= 0 -> {

                #{overflow=wrap}
                out-name = rest.slice(sp + 1, rest.len())
            }
            break
        }
    }
    {
        begin-idx < 0 -> {
            eprint('uudecode: no begin line')
            exit(1)
        }
    }

    ; Decode lines until 'end'
    out []byte = with-cap(1024)
    out-len = 0
    i <- [begin-idx + 1..lines.len()): {

        #{index-out=zero}
        line = lines[i]
        line == 'end' -> break
        line.len-bytes() == 0 -> continue

        ; First char = length
        first = line[0]

        count = first - 32
        count <= 0 -> continue

        ; Decode remaining chars (4 -> 3 bytes)
        j = 1
        remaining = count
        (remaining > 0) {

            #{overflow=wrap}
            remaining >= 3 && j + 3 < line.len-bytes() -> {
                c0 = line[j] - 32
                c1 = line[j + 1] - 32
                c2 = line[j + 2] - 32
                c3 = line[j + 3] - 32
                b0 = ((c0 << 2) | (c1 >> 4)) & 255
                b1 = ((c1 << 4) | (c2 >> 2)) & 255
                b2 = ((c2 << 6) | c3) & 255
                out[out-len]: {
                    ok -> it = b0

                    -> _
                }
                out[out-len + 1]: {
                    ok -> it = b1

                    -> _
                }
                out[out-len + 2]: {
                    ok -> it = b2

                    -> _
                }
                out-len = out-len + 3
                j = j + 4
                remaining = remaining - 3
            }

            #{overflow=wrap}
            remaining == 2 && j + 2 < line.len-bytes() -> {
                c0 = line[j] - 32
                c1 = line[j + 1] - 32
                c2 = line[j + 2] - 32
                b0 = ((c0 << 2) | (c1 >> 4)) & 255
                b1 = ((c1 << 4) | (c2 >> 2)) & 255
                out[out-len]: {
                    ok -> it = b0

                    -> _
                }
                out[out-len + 1]: {
                    ok -> it = b1

                    -> _
                }
                out-len = out-len + 2
                j = j + 3
                remaining = remaining - 2
            }

            #{overflow=wrap}
            remaining == 1 && j + 1 < line.len-bytes() -> {
                c0 = line[j] - 32
                c1 = line[j + 1] - 32
                b0 = ((c0 << 2) | (c1 >> 4)) & 255
                out[out-len]: {
                    ok -> it = b0

                    -> _
                }
                out-len = out-len + 1
                j = j + 2
                remaining = remaining - 1
            }
        }
    }

    ; Write to file
    {
        out-name == '' -> {

            ; No name: write to stdout
            data []byte = with-len(out-len)
            k <- [0..out-len): {

                #{index-out=zero}
                d9v1 byte = out[k]

                #{index-out=zero}
                data[k]: {
                    ok -> it = d9v1

                    -> _
                }
            }
            s = data.to-bytes-str()
            print(s)
        }

        out-name == '/dev/stdout' -> {
            data []byte = with-len(out-len)
            k <- [0..out-len): {

                #{index-out=zero}
                d9v2 byte = out[k]

                #{index-out=zero}
                data[k]: {
                    ok -> it = d9v2

                    -> _
                }
            }
            s = data.to-bytes-str()
            print(s)
        }

        -> {
            data []byte = with-len(out-len)
            k <- [0..out-len): {

                #{index-out=zero}
                d9v3 byte = out[k]

                #{index-out=zero}
                data[k]: {
                    ok -> it = d9v3

                    -> _
                }
            }
            fs.write-file(out-name, data)
        }
    }
}
