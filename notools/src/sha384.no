; sha384.no — BSD sha384 工具（对齐 /sbin/sha384）
; 用法：sha384 [-pqrsx] [-c str] [-s str] [files ...]
;   无参数：读 stdin，打印裸哈希（-c 时无输出）
;   文件：  SHA384 (path) = hash（-r 改 hash path；-q 只打印 hash；-c 追加 [ Failed ] 且 rc=2）
;   -s str：打印 str 的裸哈希（忽略文件）
;   -p：原样回显 stdin 再打印其裸哈希
;   -x：先运行内置测试套件，再正常处理
; 注意：不经 hashutil.do-hash 中转 —— md5x 的 str 返回值跨两层调用
; 且输入超过短字符串阈值时会丢失（B13 变体），直接单层调用则正常
# /notools/src/sha384x.sha384x

sha384-run = () {
    argc = args()
    rflag = false
    qflag = false
    sflag = false
    pflag = false
    xflag = false
    cflag = false
    sval = ''
    files []str
    status = 0
    suffix = ''
    emitted = false
    i = 2
    (i < argc) {
        a = arg(i)
        {
            a.len-bytes() > 2 && a[0] == 45 && a[1] == 45 -> {
                io.errln('sha384: unrecognized option `' - a - char-to-str(39))
                io.errln('usage: sha384 [-pqrtx] [-c string] [-s string] [files ...]')
                os.exit(1)
            }

            a.len-bytes() > 1 && a[0] == 45 -> {
                j <- [1..a.len-bytes()): {
                    ch i64 = a[j]
                    {
                        ch == 114 -> rflag = true

                        ch == 113 -> qflag = true

                        ch == 112 -> pflag = true

                        ch == 120 -> xflag = true

                        ch == 116 -> {
                        }

                        ch == 99 -> {
                            cflag = true

                            #{overflow=wrap}
                            i = i + 1
                        }

                        ch == 115 -> {
                            sflag = true

                            #{overflow=wrap}
                            i = i + 1
                            i < argc -> sval = arg(i)
                        }

                        -> {
                            io.errln('sha384: invalid option -- ' - char-to-str(ch))
                            io.errln('usage: sha384 [-pqrtx] [-c string] [-s string] [files ...]')
                            os.exit(1)
                        }
                    }
                }
            }

            -> files.push(a)
        }

        #{overflow=wrap}
        i = i + 1
    }

    {
        xflag -> {
            print('SHA384 test suite:')
            ts []str
            ts.push('')
            ts.push('a')
            ts.push('abc')
            ts.push('message digest')
            ts.push('abcdefghijklmnopqrstuvwxyz')
            ts.push('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789')
            ts.push('12345678901234567890123456789012345678901234567890123456789012345678901234567890')
            ts.push('MD5 has not yet (2001-09-03) been broken, but sufficient attacks have been made that its security is in some doubt')
            ev []str
            ev.push('38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b')
            ev.push('54a59b9f22b0b80880d8427e548b7c23abd873486e1f035dce9cd697e85175033caa88e6d57bc35efae0b5afd3145f31')
            ev.push('cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7')
            ev.push('473ed35167ec1f5d8e550368a3db39be54639f828868e9454c239fc8b52e3c61dbd0d8b4de1390c256dcbb5d5fd99cd5')
            ev.push('feb67349df3db6f5924815d6c3dc133f091809213731fe5c7b5f4999e463479ff2877f5f2936fa63bb43784b12f3ebb4')
            ev.push('1761336e3f7cbfe51deb137f026f89e01a448e3b1fafa64039c1464ee8732f11a5341a6f41e0c202294736ed64db1a84')
            ev.push('b12932b0627d1c060942f5447764155655bd4da0c9afa6dd9b9ef53129af1b8fb0195996d2de9ca0df9d821ffee67026')
            ev.push('99428d401bf4abcd4ee0695248c9858b7503853acfae21a9cffa7855f46d1395ef38596fcd06d5a8c32d41a839cc5dfb')
            k <- [0..ts.len()): {

                #{index-out=0}
                tv = ts[k]
                tdata = tv.to-bytes()
                th = sha384x(tdata)
                res = ' - verified correct'

                #{index-out=0}
                th != ev[k] -> res = ' - NOT correct'
                print('SHA384 ("' - tv - '") = ' - th - res)
            }
        }
    }

    cflag -> suffix = ' [ Failed ]'

    {
        pflag -> {
            ! cflag -> {
                pinp []byte
                pr = fs.read-stdin()
                pr: {
                    ok -> pinp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                pdata = pinp
                fd = fs.open-write('/dev/stdout')
                fs.write(fd, pdata, pdata.len())
                ph = sha384x(pdata)
                print(ph)
            }
        }

        sflag -> {
            sdata = sval.to-bytes()
            sh = sha384x(sdata)
            print(sh - suffix)
            emitted = true
        }

        -> {
            files.len() == 0 && ! xflag -> {
                sinp []byte
                sr = fs.read-stdin()
                sr: {
                    ok -> sinp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                sdata2 = sinp
                sh2 = sha384x(sdata2)
                ! cflag -> print(sh2)
            }

            files.len() > 0 -> {
                k2 <- [0..files.len()): {

                    #{index-out=0}
                    path = files[k2]
                    ok2 = true
                    {
                        path == '-' -> {
                        }

                        ! fs.is-file(path) -> {
                            ok2 = false
                            fs.is-dir(path) -> io.errln('sha384: ' - path - ': Is a directory')

                            -> io.errln('sha384: ' - path - ': No such file or directory')
                            status = 1
                        }
                    }
                    ok2 -> {
                        data []byte
                        {
                            path == '-' -> {
                                rinp []byte
                                rr = fs.read-stdin()
                                rr: {
                                    ok -> rinp = it

                                    nil -> {
                                    }

                                    err -> {
                                    }
                                }
                                rb = rinp
                                m <- [0..rb.len()): {
                                    data.push(rb[m])
                                }
                            }

                            -> {
                                finp []byte
                                fr = fs.read-bytes(path)
                                fr: {
                                    ok -> finp = it

                                    nil -> {
                                    }

                                    err -> {
                                    }
                                }
                                fb = finp
                                m2 <- [0..fb.len()): {
                                    data.push(fb[m2])
                                }
                            }
                        }
                        h = sha384x(data)
                        {
                            qflag -> print(h - suffix)

                            rflag -> print(h - ' ' - path - suffix)

                            -> print('SHA384 (' - path - ') = ' - h - suffix)
                        }
                        emitted = true
                    }
                }
            }
        }
    }

    status != 0 -> os.exit(status)
    cflag && emitted -> os.exit(2)
}
