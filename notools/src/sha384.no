// sha384.no — SHA-384 哈希
// 计算文件或 stdin 的 SHA-384（十六进制，96 字符）
// 用法：sha384 [file...]   无参数时读取 stdin
// 注意：标准库 sha384-hex 存在 str 返回丢失缺陷，改用本地 sha384x（void 直接打印）
# /src/sha384x.sha384x
sha384-run = () {
    argc = args()
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            data = inp.to-bytes()
            sha384x(data)
        }
        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    fs.is-file(path) == false -> {
                        emsg = 'sha384: ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                inp = fs.read-file(path)
                data = inp.to-bytes()
                sha384x(data)
            }
        }
    }
}
