; sha384.no — SHA-384 哈希
; 计算文件或 stdin 的 SHA-384（十六进制，96 字符）
; 用法：sha384 [file...]   无参数时读取 stdin
# /notools/src/sha384x.sha384x

sha384-run = () {
    argc = args()
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            ; stdin 為管道時 stat 大小競態可能讀空（B18），讀空則短暫重試
            t <- [0..40): {
                inp.len == 0 -> {
                    os.sleep-us(1000)
                    inp = fs.read-file('/dev/stdin')
                }
            }
            data = inp
            h = sha384x(data)
            print(h)
        }

        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    fs.is-file(path) == false -> {
                        emsg = 'sha384: ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                inp = fs.read-file(path)
                data = inp
                h = sha384x(data)
                line = h - '  ' - path
                print(line)
            }
        }
    }
}
