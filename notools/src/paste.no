; paste.no — paste utility
; Merge lines of files
; Usage: paste [-d DELIM] [-s] [file...]
;   -d DELIM: delimiter between columns (default: tab)
;   -s:       serial mode (one file at a time, lines joined by delim)
;   files:    files to merge (read from stdin if none)
;
; All logic is inlined into paste-run using only locals, because module-level
; globals cannot be reliably assigned from within functions (the assignment
; creates a local shadow that does not persist after the function returns).

paste-run = () {
    argc = os.args().len()
    delim = '\t'
    serial = false
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-s' -> serial = true
        a == '-d' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                delim-opt = os.arg(i + 1)
                delim = delim-opt: {
                    ok -> it

                    -> ''
                }
                skip-next = true
            }
        }
        a.starts-with('-d') -> {
            a.len() > 2 -> delim = a.slice(2, a.len())
        }
        ! a.starts-with('-') -> files.push(a)
    }

    ; No files: read stdin as the single input
    file-count = 1
    files.len() > 0 -> file-count = files.len()

    ; Flat storage of all lines across all files, with per-file counts.
    all-lines []str = with-cap(8192)
    counts []i64
    max-lines = 0

    fi <- [0..file-count): {
        read-path = '/dev/stdin'
        files.len() > 0 -> {

            read-path = files[fi]: {
                ok -> it

                -> '/dev/stdin'
            }
        }
        content = ''
        r = fs.read-str(read-path)
        r: {
            ok -> content = it

            nil -> {
            }

            err -> {
            }
        }

        ; Inline split: push lines from content into all-lines.
        prev = all-lines.len()
        content.len() > 0 -> {
            start = 0
            j <- [0..content.len()): {
                content[j] == 10 -> {
                    all-lines.push(content.slice(start, j))

                    #{overflow=wrap}
                    start = j + 1
                }
            }
            start < content.len() -> all-lines.push(content.slice(start, content.len()))
        }

        #{overflow=wrap}
        added = all-lines.len() - prev: {
            ok -> it

            -> _
        }
        counts.push(added)
        added > max-lines -> max-lines = added
    }

    {
        serial -> {

            ; Serial: each file's lines joined by delim on one output line
            offset = 0
            fi <- [0..file-count): {

                cnt = counts[fi]: {
                    ok -> it

                    -> _
                }
                j <- [0..cnt): {
                    j > 0 -> io.out(delim)

                    #{overflow=wrap}
                    oi = offset + j: {
                        ok -> it

                        -> _
                    }
                    line = all-lines[oi]: {
                        ok -> it

                        -> ''
                    }
                    io.out(line)
                }
                io.out('\n')

                #{overflow=wrap}
                offset = offset + cnt
            }
        }

        ! serial -> {

            ; Parallel: row N from each file joined by delim
            offsets []i64
            off = 0
            fi <- [0..file-count): {
                offsets.push(off)

                cf = counts[fi]: {
                    ok -> it

                    -> _
                }
                #{overflow=wrap}
                off = off + cf: {
                    ok -> it

                    -> _
                }
            }
            row <- [0..max-lines): {
                fi <- [0..file-count): {
                    fi > 0 -> io.out(delim)

                    cf = counts[fi]: {
                        ok -> it

                        -> _
                    }
                    {
                        row < cf -> {
                            #{overflow=wrap}
                            base = offsets[fi]: {
                                ok -> it

                                -> _
                            }
                            #{overflow=wrap}
                            ai = base + row: {
                                ok -> it

                                -> _
                            }
                            line = all-lines[ai]: {
                                ok -> it

                                -> ''
                            }
                            io.out(line)
                        }

                        -> {
                        }
                    }
                }
                io.out('\n')
            }
        }
    }
}
