; pgrep.no — pgrep utility
; List PIDs of processes by name
; Usage: pgrep [-f] [-l] [-q] NAME
;   -f: match against full command line (simplified: same as name match)
;   -l: list name along with PID
;   -q: quiet mode (no output, only exit status)
;   Exit status: 0 if at least one process matched, 1 otherwise
; Note: Process matching uses process.list-all() which only works on Linux.

pgrep-run = () {
    argc = args()

    list-mode = false
    quiet = false
    full-match = false
    names []str

    i <- [2..argc): {
        a = arg(i)
        {
            a == '-f' -> {
                full-match = true
            }

            a == '-l' -> {
                list-mode = true
            }

            a == '-q' -> {
                quiet = true
            }

            a.starts-with('-') && a.len > 1 -> {
            }

            -> names.push(a)
        }
    }

    {
        names.len == 0 -> {
            eprint('Usage: pgrep [-f] [-l] [-q] NAME')
            os.exit(1)
        }
    }

    any-match = false
    i <- [0..names.len): {
        name = names[i]
        pids = process.find-by-name(name)
        j <- [0..pids.len): {
            any-match = true
            quiet == false -> {
                {
                    list-mode -> {
                        p = pids[j]
                        print(p.to-str() - ' ' - name)
                    }

                    -> {
                        p = pids[j]
                        print(p.to-str())
                    }
                }
            }
        }
    }

    any-match == false -> os.exit(1)
}
