; stat.no — stat utility
; Display file status information
; Usage: stat <file>
;   file: path to the file to inspect
; Output: size, type, mode (octal), uid, gid, mtime
; Note: stat-* builtins return only one value despite declaring (i64, bool).
;       Use single-value assignment and check existence via is-file/is-dir.

stat-run = () {
    argc = args()

    argc < 3 -> {
        io.errln('Usage: stat <file>')
        os.exit(1)
    }

    path = arg(2)

    ; Check existence via is-file / is-dir
    is-f = fs.is-file(path)
    is-d = fs.is-dir(path)
    exists = is-f || is-d
    exists == false -> {
        msg = 'stat: cannot stat ' - path
        io.errln(msg)
        os.exit(1)
    }

    ; File size (single-value return; 0 on error but we already checked existence)
    size = fs.stat-size(path)

    ; File type
    type = 'file'
    is-d -> type = 'directory'

    ; Permission bits (lower 9 bits of st_mode), shown as octal
    mode = fs.stat-mode(path)
    m = mode & 511
    d1 = m / 64
    d2 = (m / 8) % 8
    d3 = m % 8
    s1 = d1.to-str()
    s2 = d2.to-str()
    s3 = d3.to-str()
    mode-str = '0' - s1 - s2 - s3

    ; Owner user id, group id, modification time (single-value returns)
    uid = fs.stat-uid(path)
    gid = fs.stat-gid(path)
    mtime = fs.stat-mtime(path)

    size-str = size.to-str()
    uid-str = uid.to-str()
    gid-str = gid.to-str()
    mtime-str = mtime.to-str()

    line1 = '  File: ' - path
    print(line1)
    line2 = '  Size: ' - size-str
    print(line2)
    line3 = '  Type: ' - type
    print(line3)
    line4 = '  Mode: ' - mode-str
    print(line4)
    line5 = '   UID: ' - uid-str
    print(line5)
    line6 = '   GID: ' - gid-str
    print(line6)
    line7 = ' Mtime: ' - mtime-str
    print(line7)
}
