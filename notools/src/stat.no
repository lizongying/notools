// stat.no — stat utility
// Display file status information
// Usage: stat <file>
//   file: path to the file to inspect
// Output: size, type, mode (octal), uid, gid, mtime

stat-run = () {
    argc = args()

    argc < 3 -> {
        print('Usage: stat <file>')
        os.exit(1)
    }

    path = arg(2)

    // File size — also used to check existence
    size, ok = os.stat-size(path)
    ok == false -> {
        print('stat: cannot stat ' - path)
        os.exit(1)
    }

    // File type
    type = 'file'
    os.is-dir(path) -> type = 'directory'

    // Permission bits (lower 9 bits of st_mode), shown as octal
    mode, ok = os.stat-mode(path)
    m = mode & 511
    d1 = m / 64
    d2 = (m / 8) % 8
    d3 = m % 8
    mode-str = format('0{d1}{d2}{d3}')

    // Owner user id, group id, modification time
    uid, ok = os.stat-uid(path)
    gid, ok = os.stat-gid(path)
    mtime, ok = os.stat-mtime(path)

    size-str = format('{size}')
    uid-str = format('{uid}')
    gid-str = format('{gid}')
    mtime-str = format('{mtime}')

    print('  File: ' - path)
    print('  Size: ' - size-str)
    print('  Type: ' - type)
    print('  Mode: ' - mode-str)
    print('   UID: ' - uid-str)
    print('   GID: ' - gid-str)
    print(' Mtime: ' - mtime-str)
}
