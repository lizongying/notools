// unlink.no — unlink utility
// Delete a file
// Usage: unlink FILE

unlink-run = () {
    argc = args()
    {
        argc != 3 -> {
            eprint('Usage: unlink FILE')
            os.exit(1)
        }
    }
    file = arg(2)
    ok = fs.remove(file)
    {
        ok == false -> {
            eprint('unlink: cannot remove ' - file)
            os.exit(1)
        }
    }
}
