; unlink.no — unlink utility
; Delete a file
; Usage: unlink FILE

unlink-run = () {
    argc = os.args()
    {
        argc != 3 -> {
            print("N")
            exit(1)
        }
    }
    file = os.arg(2)
    ok = fs.remove(file)
    {
        ! ok -> {
            print("N")
            exit(1)
        }
    }
}
