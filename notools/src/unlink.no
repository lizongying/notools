; unlink.no — unlink utility
; Delete a file
; Usage: unlink FILE

unlink-run = () {
    argc = os.args()
    {
        argc != 3 -> {
            eprint('Usage: unlink FILE')
            os.exit(1)
        }
    }
    file = os.arg(2)
    ok = fs.remove(file)
    {
        ! ok -> {
            eprint('unlink: cannot remove ' - file)
            os.exit(1)
        }
    }
}
