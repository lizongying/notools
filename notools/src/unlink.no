; unlink.no — unlink utility
; Delete a file
; Usage: unlink FILE

unlink-run = () {
    argc = os.args().len()
    {
        argc != 3 -> {
            eprint('Usage: unlink FILE')
            exit(1)
        }
    }
    file-opt = os.arg(2)
    file = file-opt: {
        ok -> it

        -> ''
    }
    ok = fs.remove(file)
    {
        ! ok -> {
            eprint('unlink: cannot remove ' - file)
            exit(1)
        }
    }
}
