; timeout.no — timeout utility
; Run a command with a time limit
; Usage: timeout [-s SIGNAL] DURATION COMMAND [ARGS...]
;   -s SIGNAL: signal to send on timeout (default TERM=15)
;   DURATION: integer seconds (supports suffix s/m/h, default seconds)
;   After DURATION, sends SIGNAL; if process still alive after 10s grace,
;   sends SIGKILL (9).
;   Exit status: 124 on timeout, otherwise the command's exit status.

; parse-sig: parse signal name or number (returns -1 on unknown)
parse-sig = (s str) (sig i64) {
    sig = -1
    s.len() == 0 -> return
    first = s[0]
    {
        first >= 48 && first <= 57 -> {
            v = 0
            i <- [0..s.len()): {
                c = s[i]

                #{overflow=wrap}
                c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
            }
            sig = v
            return
        }
    }
    upper = s.to-upper()
    {
        upper.starts-with('SIG-') -> upper = upper.slice(4, upper.len())

        upper.starts-with('SIG') -> upper = upper.slice(3, upper.len())
    }

    {
        upper == 'HUP' -> sig = 1

        upper == 'INT' -> sig = 2

        upper == 'QUIT' -> sig = 3

        upper == 'ILL' -> sig = 4

        upper == 'TRAP' -> sig = 5

        upper == 'ABRT' -> sig = 6

        upper == 'BUS' -> sig = 7

        upper == 'FPE' -> sig = 8

        upper == 'KILL' -> sig = 9

        upper == 'USR1' -> sig = 10

        upper == 'SEGV' -> sig = 11

        upper == 'USR2' -> sig = 12

        upper == 'PIPE' -> sig = 13

        upper == 'ALRM' -> sig = 14

        upper == 'TERM' -> sig = 15

        upper == 'STKFLT' -> sig = 16

        upper == 'CHLD' -> sig = 17

        upper == 'CONT' -> sig = 18

        upper == 'STOP' -> sig = 19

        upper == 'TSTP' -> sig = 20

        upper == 'TTIN' -> sig = 21

        upper == 'TTOU' -> sig = 22

        upper == 'URG' -> sig = 23

        upper == 'XCPU' -> sig = 24

        upper == 'XFSZ' -> sig = 25

        upper == 'VTALRM' -> sig = 26

        upper == 'PROF' -> sig = 27

        upper == 'WINCH' -> sig = 28

        upper == 'IO' -> sig = 29

        upper == 'PWR' -> sig = 30

        upper == 'SYS' -> sig = 31
    }
}

; quote-arg: POSIX single-quote a token for embedding into an `sh -c` command
; string, preserving argv boundaries and shell metacharacters. Each ' becomes
; the '\'' idiom. Returns the quoted token.
quote-arg = (s str) (q str) {
    q = '\''
    c <- s: {
        {
            c == '\'' -> {

                ; quote-slash-quote idiom: close quote, backslash, reopen quoted quote
                q = q - '\''
                q = q - "\\"
                q = q - '\''
                q = q - '\''
            }

            -> q = q - c
        }
    }
    q = q - '\''
}

; parse-duration: parse duration string to microseconds
; Supports: integer seconds, suffix s/m/h
parse-duration = (s str) (us i64) {
    us = 0
    s.len() == 0 -> return
    v = 0

    #{overflow=wrap}
    last = s[s.len() - 1]
    end = s.len()
    {
        last == 's' -> {

            #{overflow=wrap}
            end = s.len() - 1
        }

        last == 'm' -> {

            #{overflow=wrap}
            end = s.len() - 1
        }

        last == 'h' -> {

            #{overflow=wrap}
            end = s.len() - 1
        }
    }

    i <- [0..end): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
    {
        last == 'm' -> {

            #{overflow=wrap}
            v = v * 60
        }

        last == 'h' -> {

            #{overflow=wrap}
            v = v * 3600
        }
    }

    #{overflow=wrap}
    us = v * 1000000
}

timeout-run = () {
    argc = os.args().len()

    sig = 15 ; SIG-TERM default
    next-is-signal = false
    duration-str = ''
    cmd-start = 2
    have-duration = false

    i <- [2..argc): {
        handled = false
        {
            next-is-signal -> {
                a-opt = os.arg(i)
                a = a-opt: {
                    ok -> it

                    -> ''
                }
                parsed = parse-sig(a)
                parsed < 0 -> {
                    print('timeout: invalid signal: ' - a)
                    exit(1)
                }
                sig = parsed
                next-is-signal = false

                #{overflow=wrap}
                cmd-start = i + 1
                handled = true
            }
        }
        {
            handled == false -> {
                a-opt = os.arg(i)
                a = a-opt: {
                    ok -> it

                    -> ''
                }
                {
                    a == '-s' -> {
                        next-is-signal = true
                        handled = true
                    }

                    a.starts-with('-s') && a.len() > 2 -> {
                        cand = a.slice(2, a.len())
                        parsed = parse-sig(cand)
                        parsed < 0 -> {
                            print('timeout: invalid signal: ' - cand)
                            exit(1)
                        }
                        sig = parsed
                        handled = true
                    }

                    a.starts-with('-') && a.len() > 1 -> {
                        cand = a.slice(1, a.len())
                        parsed = parse-sig(cand)
                        parsed >= 0 -> {
                            sig = parsed
                            handled = true
                        }
                    }
                }

                {
                    handled == false -> {
                        have-duration == false -> {
                            duration-str = a
                            have-duration = true

                            #{overflow=wrap}
                            cmd-start = i + 1
                            handled = true
                        }
                    }
                }
            }
        }
    }

    {
        have-duration == false -> {
            print('timeout: missing duration operand')
            exit(1)
        }

        cmd-start >= argc -> {
            print('timeout: missing command')
            exit(1)
        }
    }

    ; Build command string from the remaining argv (program + args), shell-quoting
    ; each token so argv boundaries and metacharacters survive `sh -c`.
    cmd = ''
    i <- [cmd-start..argc): {
        i > cmd-start -> cmd = cmd - ' '
        cmd = cmd - quote-arg(os.arg(i))
    }

    duration-us = parse-duration(duration-str)
    {
        duration-us <= 0 -> {
            print('timeout: invalid duration: ' - duration-str)
            exit(1)
        }
    }

    ; Run the command via `spawn`, which forks + exec-sh-c without capturing
    ; stdout/stderr: the child inherits our streams, so output passes straight
    ; through and there is no pipe-buffer deadlock while we poll. The timeout
    ; signal and the real exit status reach the target. The command string is
    ; pre-quoted per argv (see quote-arg) so boundaries and metacharacters survive.
    pid = process.spawn(cmd)
    {
        pid < 0 -> {
            print('timeout: failed to run command: ' - cmd)
            exit(126)
        }
    }

    ; Watchdog: poll every 100ms until the child exits or the deadline passes.
    ; process-waitpid-nohang returns -1 while the child still runs, otherwise its
    ; exit code. A conditional loop with done-flags is used because break inside a
    ; nested match triggers a MIR codegen trap.
    step-us = 100000
    elapsed-us = 0
    finished = false
    timed-out = false
    final-code = 0
    ( ! finished ) {
        code = process.process-waitpid-nohang(pid)
        {
            code >= 0 -> {
                final-code = code
                finished = true
            }

            -> {
                elapsed-us >= duration-us -> {
                    timed-out = true
                    finished = true
                }

                ! timed-out -> {
                    os.sleep-us(step-us)

                    #{overflow=wrap}
                    elapsed-us = elapsed-us + step-us
                }
            }
        }
    }

    ; On timeout: send the configured signal, wait up to a 10s grace, then SIGKILL.
    timed-out -> {
        process.process-kill(pid, sig)

        grace-us = 0
        grace-limit = 10000000
        gone = false
        ( ! gone && grace-us < grace-limit ) {
            c2 = process.process-waitpid-nohang(pid)
            {
                c2 >= 0 -> gone = true

                -> {
                    os.sleep-us(step-us)

                    #{overflow=wrap}
                    grace-us = grace-us + step-us
                }
            }
        }

        ; Force kill if it survived the grace period, then reap it.
        c3 = process.process-waitpid-nohang(pid)
        {
            c3 < 0 -> {
                process.process-kill(pid, 9)
                final-code = process.wait(pid)
            }
        }
    }

    timed-out -> exit(124)
    exit(final-code)
}
