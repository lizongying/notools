; timeout.no — timeout utility
; Run a command with a time limit
; Usage: timeout [-s SIGNAL] DURATION COMMAND [ARGS...]
;   -s SIGNAL: signal to send on timeout (default TERM=15)
;   DURATION: integer seconds (supports suffix s/m/h, default seconds)
;   After DURATION, sends SIGNAL; if process still alive after 10s grace,
;   sends SIGKILL (9).
;   Exit status: 124 on timeout, otherwise the command's exit status.

; parse-sig: parse signal name or number (returns -1 on unknown)
parse-sig = (s str) (sig i64) {
    sig = -1
    s.len == 0 -> return
    first = s[0]
    {
        first >= 48 && first <= 57 -> {
            v = 0
            i <- [0..s.len): {
                c = s[i]
                c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
            }
            sig = v
            return
        }
    }
    upper = s.to-upper()
    {
        upper.starts-with('SIG-') -> upper = upper.slice(4, upper.len)
        upper.starts-with('SIG') -> upper = upper.slice(3, upper.len)
    }
    {
        upper == 'HUP' -> sig = 1
        upper == 'INT' -> sig = 2
        upper == 'QUIT' -> sig = 3
        upper == 'ILL' -> sig = 4
        upper == 'TRAP' -> sig = 5
        upper == 'ABRT' -> sig = 6
        upper == 'BUS' -> sig = 7
        upper == 'FPE' -> sig = 8
        upper == 'KILL' -> sig = 9
        upper == 'USR1' -> sig = 10
        upper == 'SEGV' -> sig = 11
        upper == 'USR2' -> sig = 12
        upper == 'PIPE' -> sig = 13
        upper == 'ALRM' -> sig = 14
        upper == 'TERM' -> sig = 15
        upper == 'STKFLT' -> sig = 16
        upper == 'CHLD' -> sig = 17
        upper == 'CONT' -> sig = 18
        upper == 'STOP' -> sig = 19
        upper == 'TSTP' -> sig = 20
        upper == 'TTIN' -> sig = 21
        upper == 'TTOU' -> sig = 22
        upper == 'URG' -> sig = 23
        upper == 'XCPU' -> sig = 24
        upper == 'XFSZ' -> sig = 25
        upper == 'VTALRM' -> sig = 26
        upper == 'PROF' -> sig = 27
        upper == 'WINCH' -> sig = 28
        upper == 'IO' -> sig = 29
        upper == 'PWR' -> sig = 30
        upper == 'SYS' -> sig = 31
    }
}

; parse-duration: parse duration string to microseconds
; Supports: integer seconds, suffix s/m/h
parse-duration = (s str) (us i64) {
    us = 0
    s.len == 0 -> return
    v = 0
    last = s[s.len - 1]
    end = s.len
    {
        last == 's' -> end = s.len - 1
        last == 'm' -> end = s.len - 1
        last == 'h' -> end = s.len - 1
    }
    i <- [0..end): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
    {
        last == 'm' -> v = v * 60
        last == 'h' -> v = v * 3600
    }
    us = v * 1000000
}

timeout-run = () {
    argc = args()

    sig = 15; SIG-TERM default
    next-is-signal = false
    duration-str = ''
    cmd-start = 2
    have-duration = false

    i <- [2..argc): {
        handled = false
        {
            next-is-signal -> {
                a = arg(i)
                parsed = parse-sig(a)
                parsed < 0 -> {
                    eprint('timeout: unknown signal ' - a)
                    os.exit(1)
                }
                sig = parsed
                next-is-signal = false
                cmd-start = i + 1
                handled = true
            }
        }
        {
            handled == false -> {
                a = arg(i)
                {
                    a == '-s' -> {
                        next-is-signal = true
                        handled = true
                    }
                    a.starts-with('-s') && a.len > 2 -> {
                        cand = a.slice(2, a.len)
                        parsed = parse-sig(cand)
                        parsed < 0 -> {
                            eprint('timeout: unknown signal ' - cand)
                            os.exit(1)
                        }
                        sig = parsed
                        handled = true
                    }
                    a.starts-with('-') && a.len > 1 -> {
                        cand = a.slice(1, a.len)
                        parsed = parse-sig(cand)
                        parsed >= 0 -> {
                            sig = parsed
                            handled = true
                        }
                    }
                }
                {
                    handled == false -> {
                        have-duration == false -> {
                            duration-str = a
                            have-duration = true
                            cmd-start = i + 1
                            handled = true
                        }
                    }
                }
            }
        }
    }

    {
        have-duration == false -> {
            eprint('Usage: timeout [-s SIGNAL] DURATION COMMAND [ARGS...]')
            os.exit(1)
        }
        cmd-start >= argc -> {
            eprint('timeout: no command specified')
            os.exit(1)
        }
    }

    ; Build command string
    cmd = ''
    i <- [cmd-start..argc): {
        i > cmd-start -> cmd = cmd - ' '
        cmd = cmd - arg(i)
    }

    duration-us = parse-duration(duration-str)
    {
        duration-us <= 0 -> {
            eprint('timeout: invalid duration ' - duration-str)
            os.exit(1)
        }
    }

    ; Start child process
    p = process {}
    ok = p.start('/bin/sh', '-c ' - cmd)
    {
        ok == false -> {
            eprint('timeout: failed to start command')
            os.exit(1)
        }
    }

    ; Poll for duration-us microseconds, checking every 100ms
    elapsed-us = 0
    step-us = 100000
    timed-out = false
    {
        elapsed-us >= duration-us -> *
        exited = p.wait-nohang()
        exited == true -> break
        os.sleep-us(step-us)
        elapsed-us = elapsed-us + step-us
    } (true)

    ; Check if process exited
    exited = p.wait-nohang()
    {
        exited == false -> {

            ; Send the configured signal
            p.kill(sig)
            timed-out = true
            ; Grace period: 10 seconds, poll every 100ms
            grace-us = 0
            grace-limit = 10000000
            {
                grace-us >= grace-limit -> *
                done = p.wait-nohang()
                done == true -> break
                os.sleep-us(step-us)
                grace-us = grace-us + step-us
            } (true)
            ; Force kill if still running
            still = p.wait-nohang()
            still == false -> {
                p.kill(9)
                p.wait()
            }
        }
    }

    code = p.exit-code
    p.close()
    timed-out -> os.exit(124)
    os.exit(code)
}
