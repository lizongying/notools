; unexpand.no — unexpand utility
; Convert spaces to tabs
; Usage: unexpand [-a] [-t N] [file...]
;   -a:   convert all sequences of spaces (default: only leading)
;   -t N: tab stop distance (default: 8)
;   files: files to process (read from stdin if none)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len-bytes()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

unexpand-run = () {
    argc = os.args()
    tabstop = 8
    all-flag = false
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next -> {
            skip-next = false
            continue
        }
        a = os.arg(i)
        a == '-a' -> all-flag = true
        a == '-t' -> {

            #{overflow=wrap}
            i + 1 < argc -> {
                tabstop = atoi(os.arg(i + 1))
                skip-next = true
            }
        }
        a.starts-with('-t') -> {
            a.len-bytes() > 2 -> tabstop = atoi(a.slice(2, a.len-bytes()))
        }
        a.starts-with('-') -> {
            a.contains('a') -> all-flag = true
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        tabstop < 1 -> tabstop = 8

        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            process(content, tabstop, all-flag)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                ! fs.is-file(files[fi]) -> {
                    io.errln('unexpand: ' - files[fi] - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(files[fi])
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                process(content, tabstop, all-flag)
            }
        }
    }
}

; process: convert spaces to tabs
process = (content str, tabstop i64, all-flag bool) {

    ; Process line by line
    start = 0
    i <- [0..content.len-bytes()): {
        content[i] == 10 -> {
            line(content.slice(start, i), tabstop, all-flag)
            io.out('\n')

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len-bytes() -> line(content.slice(start, content.len-bytes()), tabstop, all-flag)
}

; line: canonicalize whitespace in a single line, BSD-unexpand style.
;   Input spaces/tabs are expanded to a visual column span, then re-compressed:
;   a run is turned into tabs only where a tab covers >= 2 columns toward the
;   next tab stop; otherwise spaces. Leading runs are always compressed;
;   interior runs only with -a.
line = (line str, tabstop i64, all-flag bool) {
    n = line.len-bytes()
    col = 0
    i = 0
    (i < n) {
        c = line[i]
        {
            c == 32 || c == 9 -> {

                ; measure the run's end column
                start-col = col
                j = i
                (j < n) {
                    cj = line[j]
                    {
                        cj == 32 -> {

                            #{overflow=wrap}
                            col = col + 1

                            #{overflow=wrap}
                            j = j + 1
                        }

                        cj == 9 -> {

                            #{overflow=wrap}
                            rem = tabstop - (col % tabstop)
                            {
                                rem == 0 -> rem = tabstop

                                -> {
                                }
                            }

                            #{overflow=wrap}
                            col = col + rem

                            #{overflow=wrap}
                            j = j + 1
                        }

                        cj != 32 && cj != 9 -> break

                        -> {
                        }
                    }
                }
                end-col = col
                do-ws = all-flag || start-col == 0
                {
                    do-ws -> {
                        cc = start-col
                        (cc < end-col) {

                            #{overflow=wrap}
                            next-stop = cc + (tabstop - (cc % tabstop))

                            #{overflow=wrap}
                            span = next-stop - cc
                            fits = next-stop <= end-col && span >= 2
                            {
                                fits -> {
                                    io.out('\t')
                                    cc = next-stop
                                }

                                ! fits -> {
                                    io.out(' ')

                                    #{overflow=wrap}
                                    cc = cc + 1
                                }

                                -> {
                                }
                            }
                        }
                    }

                    ! do-ws -> {
                        k <- [start-col..end-col): {
                            io.out(' ')
                        }
                    }

                    -> {
                    }
                }
                i = j
            }

            c != 32 && c != 9 -> {

                #{overflow=wrap}
                io.out(line.slice(i, i + 1))

                #{overflow=wrap}
                col = col + 1

                #{overflow=wrap}
                i = i + 1
            }

            -> {
            }
        }
    }
}
