; unexpand.no — unexpand utility
; Convert spaces to tabs
; Usage: unexpand [-a] [-t N] [file...]
;   -a:   convert all sequences of spaces (default: only leading)
;   -t N: tab stop distance (default: 8)
;   files: files to process (read from stdin if none)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

unexpand-run = () {
    argc = args()
    tabstop = 8
    all-flag = false
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next == true -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a == '-a' -> all-flag = true
        a == '-t' -> {
            i + 1 < argc -> {
                tabstop = atoi(arg(i + 1))
                skip-next = true
            }
        }
        a.starts-with('-t') -> {
            a.len > 2 -> tabstop = atoi(a.slice(2, a.len))
        }
        a.starts-with('-') -> {
            a.contains('a') -> all-flag = true
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        tabstop < 1 -> tabstop = 8

        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            process(content, tabstop, all-flag)
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                fs.is-file(files[fi]) == false -> {
                    io.errln('unexpand: ' - files[fi] - ': No such file or directory')
                    continue
                }
                content = fs.read-file(files[fi])
                process(content, tabstop, all-flag)
            }
        }
    }
}

; process: convert spaces to tabs
process = (content str, tabstop i64, all-flag bool) {
    ; Process line by line
    start = 0
    i <- [0..content.len): {
        content[i] == 10 -> {
            line(content.slice(start, i), tabstop, all-flag)
            io.out('\n')
            start = i + 1
        }
    }
    start < content.len -> line(content.slice(start, content.len), tabstop, all-flag)
}

; line: convert spaces to tabs in a single line
line = (line str, tabstop i64, all-flag bool) {
    col = 0
    i = 0
    n = line.len
    in-leading = true

    {
        i < n -> {
            c = line[i]
            ; Check if we're still in leading whitespace (only when not -a)
            all-flag == false -> {
                c != 32 -> in-leading = false
            }
            all-flag == true -> {
                in-leading = true
            }

            ; Try to convert runs of spaces at tab stops to tabs
            c == 32 -> {
                in-leading == true -> {
                    ; Check if we're at a tab stop boundary
                    at-tab-stop = (col % tabstop) == 0
                    at-tab-stop == true -> {
                        ; Count how many spaces until next tab stop or non-space
                        space-run = 0
                        remaining = tabstop
                        j <- [0..remaining): {
                            idx = i + j
                            idx < n -> {
                                line[idx] == 32 -> space-run = space-run + 1
                                line[idx] != 32 -> break
                            }
                        }
                        ; If we have a full tab stop of spaces, emit a tab
                        space-run >= tabstop -> {
                            io.out('\t')
                            i = i + tabstop
                            col = col + tabstop
                        }
                        space-run < tabstop -> {
                            ; Not enough spaces for a tab, emit spaces
                            k <- [0..space-run): {
                                io.out(' ')
                            }
                            i = i + space-run
                            col = col + space-run
                        }
                    }
                    at-tab-stop == false -> {
                        ; Not at tab stop, emit single space
                        io.out(' ')
                        i = i + 1
                        col = col + 1
                    }
                }
                in-leading == false -> {
                    ; Not in leading whitespace, emit as-is
                    io.out(' ')
                    i = i + 1
                    col = col + 1
                }
            }
            c != 32 -> {
                io.out(line.slice(i, i + 1))
                i = i + 1
                col = col + 1
            }
        }
    } (i < n)
}
