; lbracket.no — [ utility
; Same as test but expects a closing ] argument
; Usage: [ EXPRESSION ]
;   See test-cmd.no for the expression grammar.
;   Exit 0 if true, 1 if false, 2 on syntax error.
; (Self-contained: duplicates the eval logic with lbracket- prefixes
;  so this file does not depend on test-cmd.no being loaded.)

atoi = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    {
        s.len > 0 -> {
            s[0] == 45 -> {
                neg = true
                start = 1
            }
        }
    }
    i <- [start..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
    neg == true -> v = 0 - v
}

; Evaluate expression occupying arg indices [start..end).
eval = (start i64, end i64) (result bool) {
    result = false
    n = end - start
    n <= 0 -> return

    first = arg(start)

    ; Leading negation
    {
        first == '!' -> {
            sub = eval(start + 1, end)
            sub == false -> result = true
            return
        }

        n == 1 -> {
            result = first.len > 0
            return
        }
    }

    ; n == 2: unary op + operand
    {
        first == '-f' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = fs.is-file(p)
            return
        }
        first == '-d' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = fs.is-dir(p)
            return
        }
        first == '-e' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = fs.is-file(p)
            result == false -> result = fs.is-dir(p)
            return
        }
        first == '-r' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = fs.is-file(p)
            result == false -> result = fs.is-dir(p)
            return
        }
        first == '-w' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = fs.is-file(p)
            result == false -> result = fs.is-dir(p)
            return
        }
        first == '-s' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = false
            fs.is-file(p) -> {
                size, ok = os.stat-size(p)
                ok == true && size > 0 -> result = true
            }
            return
        }
        first == '-z' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = p.len == 0
            return
        }
        first == '-n' -> {
            n != 2 -> return
            p = arg(start + 1)
            result = p.len > 0
            return
        }
    }

    ; n == 3: binary op
    {
        n == 3 -> {
            left  = arg(start)
            op    = arg(start + 1)
            right = arg(start + 2)
            {
                op == '=' -> {
                    result = left == right
                    return
                }
                op == '!=' -> {
                    result = left != right
                    return
                }
                op == '-eq' -> {
                    l = atoi(left)
                    r = atoi(right)
                    result = l == r
                    return
                }
                op == '-ne' -> {
                    l = atoi(left)
                    r = atoi(right)
                    result = l != r
                    return
                }
                op == '-gt' -> {
                    l = atoi(left)
                    r = atoi(right)
                    result = l > r
                    return
                }
                op == '-lt' -> {
                    l = atoi(left)
                    r = atoi(right)
                    result = l < r
                    return
                }
                op == '-ge' -> {
                    l = atoi(left)
                    r = atoi(right)
                    result = l >= r
                    return
                }
                op == '-le' -> {
                    l = atoi(left)
                    r = atoi(right)
                    result = l <= r
                    return
                }
            }
            result = false
            return
        }
    }

    result = false
}

lbracket = () {
    argc = args()
    n = argc - 2

    {
        n < 1 -> {
            eprint('lbracket: missing ]')
            os.exit(2)
        }
    }

    ; Last user arg must be ']'
    last = arg(argc - 1)
    {
        last != ']' -> {
            eprint('lbracket: missing ]')
            os.exit(2)
        }
    }

    ; Evaluate args at indices [2 .. argc-1)
    result = eval(2, argc - 1)
    result == true -> os.exit(0)
    os.exit(1)
}
