; gzip.no — gzip utility
; 使用 archive.gzip 模組進行 gzip 壓縮/解壓。
; Usage: gzip [-c] [-d] [-k] <file...>
;   預設：壓縮檔案，生成 .gz 並刪除原檔
;   -c  寫到標準輸出，不改動原檔
;   -d  解壓（等同 gunzip）
;   -k  保留原檔

gzip-cmd = () {
    argc = args()

    to-stdout = false
    decompress = false
    keep = false
    has-file = false

    i = 2
    for i < argc {
        a = arg(i)
        {
            a == '-c' -> to-stdout = true
            a == '-d' -> decompress = true
            a == '-k' -> keep = true
            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    eprint('gzip: ' - f - ': No such file')
                    i = i + 1
                    continue
                }
                content = fs.read-file(f)
                data = content.to-bytes()

                decompress -> {
                    out []byte = gzip.gzip-decompress(data)
                    to-stdout -> {
                        s = out.to-str()
                        io.out(s)
                    }
                    -> {
                        ; 去掉 .gz 後綴
                        out-name = f
                        f.ends-with('.gz') -> out-name = f.slice(0, f.len - 3)
                        fs.write-file(out-name, out)
                        keep == false -> fs.remove(f)
                    }
                }
                -> {
                    out []byte = gzip.gzip-compress(data)
                    to-stdout -> {
                        s = out.to-str()
                        io.out(s)
                    }
                    -> {
                        out-name = f - '.gz'
                        fs.write-file(out-name, out)
                        keep == false -> fs.remove(f)
                    }
                }
            }
        }

        i = i + 1
    }

    {
        has-file == false -> {
            eprint('gzip: no input files')
            os.exit(1)
        }
    }
}
