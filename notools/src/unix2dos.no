; unix2dos.no — unix2dos utility
; Convert LF line endings to CRLF
; Usage: unix2dos [FILE...]
;   No FILE: read stdin, write stdout
;   With FILE: modify in place

unix2dos-convert = (content str) (out str) {
    n = content.len()
    nl-count = 0
    i <- [0..n): {

        #{overflow=wrap}
        content[i] == 10 -> nl-count = nl-count + 1: {
            ok -> it

            -> _
        }
    }

    #{overflow=wrap}
    out = with-len(n + nl-count)
    j = 0
    i <- [0..n): {
        c = content[i]
        {
            c == 10 -> {
                prev-is-cr = false
                i > 0 -> {

                    #{overflow=wrap}
                    content[i - 1] == 13 -> prev-is-cr = true
                }
                ! prev-is-cr -> {
                    out = set-byte-at(out, j, 13)

                    #{overflow=wrap}
                    j = j + 1: {
                        ok -> it

                        -> _
                    }
                }
                out = set-byte-at(out, j, 10)

                #{overflow=wrap}
                j = j + 1: {
                    ok -> it

                    -> _
                }
            }

            -> {
                out = set-byte-at(out, j, c)

                #{overflow=wrap}
                j = j + 1: {
                    ok -> it

                    -> _
                }
            }
        }
    }
}

unix2dos-run = () {
    argc = os.args().len()
    {
        argc <= 2 -> {
            inp = ''
            r = fs.read-stdin-str()
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            out = unix2dos-convert(inp)
            print(out)
        }

        -> {
            i <- [2..argc): {
                path-opt = os.arg(i)
                path = path-opt: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(path) -> {
                    eprint('unix2dos: ' - path - ': No such file')
                    exit(1)
                }
                inp = ''
                r = fs.read-str(path)
                r: {
                    ok -> inp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                out = unix2dos-convert(inp)
                data = out
                fs.write-file(path, data)
            }
        }
    }
}

; set-byte-at: replacement for std str.set-byte. The std body concatenates
; []byte slices, which v0.4.37 lowers to invalid LLVM IR; write through a
; []byte buffer with a place-match index store instead.
set-byte-at = (s str, i i64, b byte) (out str) {
    bs []byte = s.to-bytes()
    bs[i]: {
        ok -> it = b

        -> _
    }
    so = bs.to-str()
    out = so: {
        ok -> it

        nil || err -> ''
    }
}
