; unix2dos.no — unix2dos utility
; Convert LF line endings to CRLF
; Usage: unix2dos [FILE...]
;   No FILE: read stdin, write stdout
;   With FILE: modify in place

unix2dos-convert = (content str) (out str) {
    n = content.len
    nl-count = 0
    i <- [0..n): {
        content[i] == 10 -> nl-count = nl-count + 1
    }
    out = with-cap(n + nl-count)
    j = 0
    i <- [0..n): {
        c = content[i]
        {
        c == 10 -> {
            prev-is-cr = false
            i > 0 -> {
                content[i - 1] == 13 -> prev-is-cr = true
            }
            prev-is-cr == false -> {
                out[j] = 13
                j = j + 1
            }
            out[j] = 10
            j = j + 1
        }
        -> {
            out[j] = c
            j = j + 1
        }
        }
    }
}

unix2dos-run = () {
    argc = args()
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            t <- [0..40): {
                inp.len == 0 -> {
                    os.sleep-us(1000)
                    inp = fs.read-file('/dev/stdin')
                }
            }
            out = unix2dos-convert(inp)
            print(out)
        }
        -> {
            i <- [2..argc): {
                path = arg(i)
                fs.is-file(path) == false -> {
                    eprint('unix2dos: ' - path - ': No such file')
                    os.exit(1)
                }
                inp = fs.read-file(path)
                out = unix2dos-convert(inp)
                data = out.to-bytes()
                fs.write-file(path, data)
            }
        }
    }
}
