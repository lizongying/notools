; basename.no — basename utility
; Strip directory and optional suffix from file path
; Usage: basename <path> [suffix]
;   path:   file path
;   suffix: optional suffix to remove from the result

basename-run = () {
    argc = args()

    {
        argc < 3 -> {
            eprint('Usage: basename <path> [suffix]')
            os.exit(1)
        }
    }

    path-str = arg(2)
    suffix = ''
    argc >= 4 -> suffix = arg(3)

    ; Find last '/' (ASCII 47)
    last-sep = -1
    i <- [0..path-str.len): {
        path-str[i] == 47 -> last-sep = i
    }

    ; base = everything after last '/'
    base = path-str
    {
        last-sep >= 0 -> base = path-str.slice(last-sep + 1, path-str.len)

        ; Strip suffix if provided and base ends with it (and base is longer than suffix)
        suffix.len > 0 -> {
            base.len > suffix.len -> {
                base.ends-with(suffix) -> base = base.slice(0, base.len - suffix.len)
            }
        }
    }

    print(base)
}
