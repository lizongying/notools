; basename.no — basename utility
; Strip directory and optional suffix from file path
; Usage: basename <path> [suffix]
;   path:   file path
;   suffix: optional suffix to remove from the result

basename-run = () {
    argc = os.args().len()

    {
        argc < 3 -> {
            eprint('Usage: basename <path> [suffix]')
            exit(1)
        }
    }

    path-str-opt = os.arg(2)
    path-str = path-str-opt: {
        ok -> it

        -> ''
    }
    suffix = ''
    {
        argc >= 4 -> {
            sfx = os.arg(3)
            sfx: {
                ok -> suffix = it

                -> _
            }
        }

        -> {
        }
    }

    ; Find last '/' (ASCII 47)
    last-sep = -1
    i <- [0..path-str.len()): {
        {
            path-str[i] == 47 -> last-sep = i

            -> {
            }
        }
    }

    ; base = everything after last '/'
    base = path-str
    {
        last-sep >= 0 -> {

            #{overflow=wrap}
            ls1 = last-sep + 1: {
                ok -> it

                -> _
            }
            base = path-str.slice(ls1, path-str.len())
        }

        -> {
        }
    }

    ; Strip suffix if provided and base ends with it (and base is longer than suffix).
    ; Separate block: must run even after the directory-strip branch above.
    {
        suffix.len() > 0 && base.len() > suffix.len() && base.ends-with(suffix) -> {
            end = (base.len() - suffix.len()): {
                ok -> it

                -> _
            }
            base = base.slice(0, end)
        }

        -> {
        }
    }

    print(base)
}
