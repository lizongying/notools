; uptime.no — uptime utility
; Tell how long the system has been running
; Usage: uptime
; Linux: reads /proc/uptime
; macOS/Windows: not supported

#{linux-amd64, linux-arm64}
uptime-run = () {
    ok = fs.is-file('/proc/uptime')
    {
        ok == false -> {
            eprint('uptime: /proc/uptime not available')
            os.exit(1)
        }
    }
    content = fs.read-file('/proc/uptime').to-str()
    pos = content.index(' ')
    {
        pos < 0 -> {
            eprint('uptime: cannot parse /proc/uptime')
            os.exit(1)
        }
    }
    sec-str = content.slice(0, pos)
    dot-pos = sec-str.index('.')
    dot-pos >= 0 -> sec-str = sec-str.slice(0, dot-pos)
    sec-val = sec-str.to-i64()
    sec-val: {
        -> {
            ok -> {
                print('up ' - sec-str - ' seconds')
                return
            }

            -> {
                eprint('uptime: cannot parse uptime value')
                os.exit(1)
            }
        }
    }
}

#{mac-amd64, mac-arm64}
uptime-run = () {
    eprint('uptime: not supported on this platform')
    os.exit(1)
}

#{win-amd64, win-arm64}
uptime-run = () {
    eprint('uptime: not supported on this platform')
    os.exit(1)
}
