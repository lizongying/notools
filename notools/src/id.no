; id.no — id utility
; Print real and effective user and group IDs
; Usage: id [-u] [-g] [-G] [-n] [-r]
;   -u: print effective UID
;   -g: print effective GID
;   -G: print all group IDs
;   -n: print name instead of number (use with -u/-g)
;   -r: print real ID instead of effective (simplified: same as effective)

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
id-run = () {
    argc = args()

    show-uid = false
    show-gid = false
    show-groups = false
    show-name = false
    use-real = false

    i <- [2..argc): {
        a = arg(i)
        a == '-u' -> show-uid = true
        a == '-g' -> show-gid = true
        a == '-G' -> show-groups = true
        a == '-n' -> show-name = true
        a == '-r' -> use-real = true
    }

    ruid = os.getuid()
    rgid = os.getgid()
    euid = os.geteuid()
    egid = os.getegid()
    ruser = os.getpwuid-name(ruid)
    gids, ngids = os.getgrouplist(ruser, rgid)
    gids.len() == 0 -> {
        gids, ngids = os.getgroups()
    }

    {
        show-uid -> {
            uid = euid
            use-real -> uid = ruid
            {
                show-name -> {
                    print(os.getpwuid-name(uid))
                    return
                }
                print(uid.to-str())
                return
            }
        }

        show-gid -> {
            gid = egid
            use-real -> gid = rgid
            {
                show-name -> {
                    print(os.getgrgid-name(gid))
                    return
                }
                print(gid.to-str())
                return
            }
        }

        show-groups -> {
            out = ''
            gi <- [0..gids.len()): {
                gi > 0 -> out = out - ' '
                gg = gids[gi]

                #{overflow=wrap}
                show-name -> out = out - os.getgrgid-name(gg)

                #{overflow=wrap}
                show-name == false -> out = out - gg.to-str()
            }
            print(out)
            return
        }
    }

    out = 'uid=' - ruid.to-str() - '(' - os.getpwuid-name(ruid) - ') gid=' - rgid.to-str() - '(' - os.getgrgid-name(rgid) - ') groups='
    di <- [0..gids.len()): {
        di > 0 -> out = out - ','
        dg = gids[di]

        #{overflow=wrap}
        out = out - dg.to-str() - '(' - os.getgrgid-name(dg) - ')'
    }
    print(out)
}

#{win-amd64, win-arm64}
id-run = () {
    eprint('id-run: not supported on this platform')
    os.exit(1)
}
