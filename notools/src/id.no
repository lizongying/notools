// id.no — id utility
// Print real and effective user and group IDs
// Usage: id [-u] [-g] [-G] [-n] [-r]
//   -u: print effective UID
//   -g: print effective GID
//   -G: print all group IDs
//   -n: print name instead of number (use with -u/-g)
//   -r: print real ID instead of effective (simplified: same as effective)

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}

id-run = () {
    argc = args()

    show-uid = false
    show-gid = false
    show-groups = false
    show-name = false

    i <- [2..argc): {
        a = arg(i)
        a == '-u' -> show-uid = true
        a == '-g' -> show-gid = true
        a == '-G' -> show-groups = true
        a == '-n' -> show-name = true
        a == '-r' -> {}
    }

    euid = os.geteuid()
    egid = os.getegid()
    gids, ngids = os.getgroups()
    user = os.get-env('USER')

    show-uid -> {
        show-name -> {
            print(user)
            return
        }
        print(euid.to-str())
        return
    }

    show-gid -> {
        show-name -> {
            print(user)
            return
        }
        print(egid.to-str())
        return
    }

    show-groups -> {
        out = ''
        i <- [0..gids.len): {
            i > 0 -> out = out - ' '
            g = gids[i]
            out = out - g.to-str()
        }
        print(out)
        return
    }

    out = 'uid=' - euid.to-str() - '(' - user - ') gid=' - egid.to-str() - '(' - user - ') groups='
    i <- [0..gids.len): {
        i > 0 -> out = out - ','
        g = gids[i]
        out = out - g.to-str()
    }
    print(out)
}

#{win-amd64, win-arm64}
id-run = () {
    eprint('id-run: not supported on this platform')
    os.exit(1)
}
