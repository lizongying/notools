; hmac.no — HMAC 消息认证码（RFC 2104）
; 用法：hmac [-a md5|sha1|sha256|sha512] -k KEY [message...]
;   无 message 参数时从 stdin 读取；有参数时以空格拼接为消息
; 输出：所选算法的 HMAC 十六进制字符串
; 注意：编译器会丢弃 `;` 分隔的第二条语句，本文件全部使用多行块
; 注意：标准库 hmac.hmac-sha* 不存在/不可用，且 stdlib hash 返回 [N]byte
; 跨包损坏，故全部用 -hex 辅助函数（返回 str）手工实现 HMAC
;   md5 无 -hex 辅助函数，由 md5x 处理
;   sha512 无 -hex 辅助函数，由 sha512x 处理

# /notools/src/md5x.md5x
# /notools/src/sha512x.sha512x

hmac-run = () {
    argc = os.args().len()
    algo = 'sha256'
    key = ''
    skip-next = false
    has-msg = false
    total = 0

    ; 单遍：解析 -a / -k，同时统计消息总长度、标记是否存在 message 参数
    i <- [2..argc): {
        handled = false
        {
            skip-next -> {
                skip-next = false
                handled = true
            }
        }
        {
            ! handled -> {
                a-opt = os.arg(i)
                a = a-opt: {
                    ok -> it

                    -> ''
                }
                isopt = false
                {
                    a == '-a' -> isopt = true
                }
                {
                    a == '-k' -> isopt = true
                }
                {
                    isopt -> {

                        #{overflow=wrap}
                        {
                            i + 1 < argc -> {

                                #{overflow=wrap}
                                val-opt = os.arg(i + 1)
                                val = val-opt: {
                                    ok -> it

                                    -> ''
                                }
                                {
                                    a == '-a' -> algo = val
                                }
                                {
                                    a == '-k' -> key = val
                                }
                                skip-next = true
                            }
                        }
                    }

                    ! isopt -> {
                        has-msg = true

                        #{overflow=wrap}
                        total = total + a.len()

                        #{overflow=wrap}
                        nt1 = total + 1: {
                            ok -> it

                            -> _
                        }
                        total = nt1
                    }
                }
            }
        }
    }
    mb []byte
    {
        ! has-msg -> {

            ; Read the ENTIRE stdin as an OWNED []byte. fs.read-stdin() returns a
            ; heap buffer that stays valid for the whole program, which avoids
            ; the get-line borrowed-buffer lifetime bug that corrupted the
            ; message before the HMAC ran.
            sr = fs.read-stdin()
            sr: {
                ok -> mb = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }
    {
        has-msg -> {
            {
                total > 0 -> {

                    #{overflow=wrap}
                    nt2 = total - 1: {
                        ok -> it

                        -> _
                    }
                    total = nt2
                }
            }
            mbuf []byte = with-len(total)
            p = 0
            skip2 = false
            i <- [2..argc): {
                handled = false
                {
                    skip2 -> {
                        skip2 = false
                        handled = true
                    }
                }
                {
                    ! handled -> {
                        a-opt = os.arg(i)
                        a = a-opt: {
                            ok -> it

                            -> ''
                        }
                        isopt = false
                        {
                            a == '-a' -> isopt = true
                        }
                        {
                            a == '-k' -> isopt = true
                        }
                        {
                            isopt -> {

                                #{overflow=wrap}
                                {
                                    i + 1 < argc -> skip2 = true
                                }
                            }

                            ! isopt -> {
                                b = a
                                k <- [0..b.len()): {
                                    d9v1 = b[k]: {
                                        ok -> it

                                        -> _
                                    }
                                    mbuf[p]: {
                                        ok -> it = d9v1

                                        -> _
                                    }

                                    #{overflow=wrap}
                                    np1 = p + 1: {
                                        ok -> it

                                        -> _
                                    }
                                    p = np1
                                }
                                {
                                    p < total -> {
                                        mbuf[p]: {
                                            ok -> it = 32

                                            -> _
                                        }

                                        #{overflow=wrap}
                                        np2 = p + 1: {
                                            ok -> it

                                            -> _
                                        }
                                        p = np2
                                    }
                                }
                            }
                        }
                    }
                }
            }
            mb = mbuf
        }
    }
    kb = key
    matched = false
    {
        algo == 'md5' -> {
            matched = true

            ; 手工 HMAC-MD5：md5x 返回 hex str，block-size=64，hash-len=16
            bsize = 64
            hlen = 16
            k0 []byte = with-len(bsize)
            i <- [0..bsize): {
                k0[i]: {
                    ok -> it = 0

                    -> _
                }
            }
            {
                kb.len() > bsize -> {
                    kh = md5x(kb)
                    i <- [0..hlen): {

                        #{overflow=wrap}
                        hi-c = kh[i * 2]

                        #{overflow=wrap}
                        lo-c = kh[i * 2 + 1]

                        #{overflow=wrap}
                        hi-v = hi-c - 48
                        {
                            hi-c >= 97 -> {

                                #{overflow=wrap}
                                hi-v = hi-c - 87
                            }
                        }

                        #{overflow=wrap}
                        lo-v = lo-c - 48
                        {
                            lo-c >= 97 -> {

                                #{overflow=wrap}
                                lo-v = lo-c - 87
                            }
                        }
                        k0[i]: {
                            ok -> it = (hi-v << 4) | lo-v

                            -> _
                        }
                    }
                }

                -> {
                    i <- [0..kb.len()): {
                        d9v2 = kb[i]: {
                            ok -> it

                            -> _
                        }
                        k0[i]: {
                            ok -> it = d9v2

                            -> _
                        }
                    }
                }
            }

            #{overflow=wrap}
            inner []byte = with-len(bsize + mb.len())
            i <- [0..bsize): {
                d9v3 = k0[i]: {
                    ok -> it

                    -> _
                }
                inner[i]: {
                    ok -> it = d9v3 ^ 54

                    -> _
                }
            }
            i <- [0..mb.len()): {
                d9v4 = mb[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                bi = bsize + i: {
                    ok -> it

                    -> _
                }
                inner[bi]: {
                    ok -> it = d9v4

                    -> _
                }
            }
            ih = md5x(inner)

            #{overflow=wrap}
            outer []byte = with-len(bsize + hlen)
            i <- [0..bsize): {
                d9v5 = k0[i]: {
                    ok -> it

                    -> _
                }
                outer[i]: {
                    ok -> it = d9v5 ^ 92

                    -> _
                }
            }
            i <- [0..hlen): {

                #{overflow=wrap}
                hi-c = ih[i * 2]

                #{overflow=wrap}
                lo-c = ih[i * 2 + 1]

                #{overflow=wrap}
                hi-v = hi-c - 48
                {
                    hi-c >= 97 -> {

                        #{overflow=wrap}
                        hi-v = hi-c - 87
                    }
                }

                #{overflow=wrap}
                lo-v = lo-c - 48
                {
                    lo-c >= 97 -> {

                        #{overflow=wrap}
                        lo-v = lo-c - 87
                    }
                }

                #{overflow=wrap}
                outer[bsize + i]: {
                    ok -> it = (hi-v << 4) | lo-v

                    -> _
                }
            }
            oh = md5x(outer)
            print(oh)
        }

        algo == 'sha1' -> {
            matched = true

            ; 手工 HMAC-SHA1：sha1.sha1-hex 返回 hex str，block-size=64，hash-len=20
            bsize = 64
            hlen = 20
            k0 []byte = with-len(bsize)
            i <- [0..bsize): {
                k0[i]: {
                    ok -> it = 0

                    -> _
                }
            }
            {
                kb.len() > bsize -> {
                    kh = sha1.sha1-hex(kb)
                    i <- [0..hlen): {

                        #{overflow=wrap}
                        hi-c = kh[i * 2]

                        #{overflow=wrap}
                        lo-c = kh[i * 2 + 1]

                        #{overflow=wrap}
                        hi-v = hi-c - 48
                        {
                            hi-c >= 97 -> {

                                #{overflow=wrap}
                                hi-v = hi-c - 87
                            }
                        }

                        #{overflow=wrap}
                        lo-v = lo-c - 48
                        {
                            lo-c >= 97 -> {

                                #{overflow=wrap}
                                lo-v = lo-c - 87
                            }
                        }
                        k0[i]: {
                            ok -> it = (hi-v << 4) | lo-v

                            -> _
                        }
                    }
                }

                -> {
                    i <- [0..kb.len()): {
                        d9v6 = kb[i]: {
                            ok -> it

                            -> _
                        }
                        k0[i]: {
                            ok -> it = d9v6

                            -> _
                        }
                    }
                }
            }

            #{overflow=wrap}
            inner []byte = with-len(bsize + mb.len())
            i <- [0..bsize): {
                d9v7 = k0[i]: {
                    ok -> it

                    -> _
                }
                inner[i]: {
                    ok -> it = d9v7 ^ 54

                    -> _
                }
            }
            i <- [0..mb.len()): {
                d9v8 = mb[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                inner[bsize + i]: {
                    ok -> it = d9v8

                    -> _
                }
            }
            ih = sha1.sha1-hex(inner)

            #{overflow=wrap}
            outer []byte = with-len(bsize + hlen)
            i <- [0..bsize): {
                d9v9 = k0[i]: {
                    ok -> it

                    -> _
                }
                outer[i]: {
                    ok -> it = d9v9 ^ 92

                    -> _
                }
            }
            i <- [0..hlen): {

                #{overflow=wrap}
                hi-c = ih[i * 2]

                #{overflow=wrap}
                lo-c = ih[i * 2 + 1]

                #{overflow=wrap}
                hi-v = hi-c - 48
                {
                    hi-c >= 97 -> {

                        #{overflow=wrap}
                        hi-v = hi-c - 87
                    }
                }

                #{overflow=wrap}
                lo-v = lo-c - 48
                {
                    lo-c >= 97 -> {

                        #{overflow=wrap}
                        lo-v = lo-c - 87
                    }
                }

                #{overflow=wrap}
                outer[bsize + i]: {
                    ok -> it = (hi-v << 4) | lo-v

                    -> _
                }
            }
            oh = sha1.sha1-hex(outer)
            print(oh)
        }

        algo == 'sha256' -> {
            matched = true

            ; 手工 HMAC-SHA256：sha256.sha256-hex 返回 hex str，block-size=64，hash-len=32
            bsize = 64
            hlen = 32
            k0 []byte = with-len(bsize)
            i <- [0..bsize): {
                k0[i]: {
                    ok -> it = 0

                    -> _
                }
            }
            {
                kb.len() > bsize -> {
                    kh = sha256.sha256-hex(kb)
                    i <- [0..hlen): {

                        #{overflow=wrap}
                        hi-c = kh[i * 2]

                        #{overflow=wrap}
                        lo-c = kh[i * 2 + 1]

                        #{overflow=wrap}
                        hi-v = hi-c - 48
                        {
                            hi-c >= 97 -> {

                                #{overflow=wrap}
                                hi-v = hi-c - 87
                            }
                        }

                        #{overflow=wrap}
                        lo-v = lo-c - 48
                        {
                            lo-c >= 97 -> {

                                #{overflow=wrap}
                                lo-v = lo-c - 87
                            }
                        }
                        k0[i]: {
                            ok -> it = (hi-v << 4) | lo-v

                            -> _
                        }
                    }
                }

                -> {
                    i <- [0..kb.len()): {
                        d9v10 = kb[i]: {
                            ok -> it

                            -> _
                        }
                        k0[i]: {
                            ok -> it = d9v10

                            -> _
                        }
                    }
                }
            }

            #{overflow=wrap}
            inner []byte = with-len(bsize + mb.len())
            i <- [0..bsize): {
                d9v11 = k0[i]: {
                    ok -> it

                    -> _
                }
                inner[i]: {
                    ok -> it = d9v11 ^ 54

                    -> _
                }
            }
            i <- [0..mb.len()): {
                d9v12 = mb[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                inner[bsize + i]: {
                    ok -> it = d9v12

                    -> _
                }
            }
            ih = sha256.sha256-hex(inner)
            outer []byte = with-len(bsize + hlen)
            i <- [0..bsize): {
                d9v13 = k0[i]: {
                    ok -> it

                    -> _
                }
                outer[i]: {
                    ok -> it = d9v13 ^ 92

                    -> _
                }
            }
            i <- [0..hlen): {

                #{overflow=wrap}
                hi-c = ih[i * 2]

                #{overflow=wrap}
                lo-c = ih[i * 2 + 1]

                #{overflow=wrap}
                hi-v = hi-c - 48
                {
                    hi-c >= 97 -> {

                        #{overflow=wrap}
                        hi-v = hi-c - 87
                    }
                }

                #{overflow=wrap}
                lo-v = lo-c - 48
                {
                    lo-c >= 97 -> {

                        #{overflow=wrap}
                        lo-v = lo-c - 87
                    }
                }

                #{overflow=wrap}
                outer[bsize + i]: {
                    ok -> it = (hi-v << 4) | lo-v

                    -> _
                }
            }
            oh = sha256.sha256-hex(outer)
            print(oh)
        }

        algo == 'sha512' -> {
            matched = true

            ; 手工 HMAC-SHA512：sha512x 返回 hex str，block-size=128，hash-len=64
            bsize = 128
            hlen = 64
            k0 []byte = with-len(bsize)
            i <- [0..bsize): {
                k0[i]: {
                    ok -> it = 0

                    -> _
                }
            }
            {
                kb.len() > bsize -> {
                    kh = sha512x(kb)
                    i <- [0..hlen): {

                        #{overflow=wrap}
                        hi-c = kh[i * 2]

                        #{overflow=wrap}
                        lo-c = kh[i * 2 + 1]

                        #{overflow=wrap}
                        hi-v = hi-c - 48
                        {
                            hi-c >= 97 -> {

                                #{overflow=wrap}
                                hi-v = hi-c - 87
                            }
                        }

                        #{overflow=wrap}
                        lo-v = lo-c - 48
                        {
                            lo-c >= 97 -> {

                                #{overflow=wrap}
                                lo-v = lo-c - 87
                            }
                        }
                        k0[i]: {
                            ok -> it = (hi-v << 4) | lo-v

                            -> _
                        }
                    }
                }

                -> {
                    i <- [0..kb.len()): {
                        d9v14 = kb[i]: {
                            ok -> it

                            -> _
                        }
                        k0[i]: {
                            ok -> it = d9v14

                            -> _
                        }
                    }
                }
            }

            #{overflow=wrap}
            inner []byte = with-len(bsize + mb.len())
            i <- [0..bsize): {
                d9v15 = k0[i]: {
                    ok -> it

                    -> _
                }
                inner[i]: {
                    ok -> it = d9v15 ^ 54

                    -> _
                }
            }
            i <- [0..mb.len()): {
                d9v16 = mb[i]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                inner[bsize + i]: {
                    ok -> it = d9v16

                    -> _
                }
            }
            ih = sha512x(inner)

            #{overflow=wrap}
            outer []byte = with-len(bsize + hlen)
            i <- [0..bsize): {
                d9v17 = k0[i]: {
                    ok -> it

                    -> _
                }
                outer[i]: {
                    ok -> it = d9v17 ^ 92

                    -> _
                }
            }
            i <- [0..hlen): {

                #{overflow=wrap}
                hi-c = ih[i * 2]

                #{overflow=wrap}
                lo-c = ih[i * 2 + 1]

                #{overflow=wrap}
                hi-v = hi-c - 48
                {
                    hi-c >= 97 -> {

                        #{overflow=wrap}
                        hi-v = hi-c - 87
                    }
                }

                #{overflow=wrap}
                lo-v = lo-c - 48
                {
                    lo-c >= 97 -> {

                        #{overflow=wrap}
                        lo-v = lo-c - 87
                    }
                }

                #{overflow=wrap}
                outer[bsize + i]: {
                    ok -> it = (hi-v << 4) | lo-v

                    -> _
                }
            }
            oh = sha512x(outer)
            print(oh)
        }
    }
    {
        ! matched -> {
            io.errln('hmac: unsupported algorithm (use md5|sha1|sha256|sha512)')
            exit(1)
        }
    }
}
