// curl.no — transfer a URL (pure Nolang HTTP/HTTPS client)
// Usage: curl [-s] [-o file] <url>
//
// Supports both http:// and https:// URLs.
// Uses std http module (http.get) which handles both HTTP and HTTPS internally.

curl-run = () {
    argc = args()
    {
        argc < 3 -> {
            print('Usage: curl [-s] [-o file] <url>')
            os.exit(1)
        }
    }
    silent = false
    outfile = ''
    url = ''
    i <- [2..argc): {
        a = arg(i)
        a == '-s' -> silent = true
        a == '-o' -> { i + 1 < argc -> outfile = arg(i + 1) }
        a.starts-with('-o') -> a.len > 2 -> outfile = a.slice(2, a.len)
        ! a.starts-with('-') -> url = a
    }
    {
        url == '' -> {
            print('Usage: curl [-s] [-o file] <url>')
            os.exit(1)
        }
    }
    ; --- perform HTTP/HTTPS request via std http module ---
    resp = http.get(url)
    resp: {
        nil -> {
            silent == false -> io.errln('curl: request failed for ' - url)
            os.exit(1)
        }
        -> {
            body = it.body
            outfile != '' -> {
                wfd = fs.open-write(outfile)
                fs.write(wfd, body, body.len)
                fs.close(wfd)
            }
            outfile == '' -> {
                silent == false -> print(body)
            }
        }
    }
    os.exit(0)
}
