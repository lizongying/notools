// echo.no — echo utility
// Prints arguments to stdout, separated by spaces
// Usage: echo [-n] [args...]

echo-run = () {
    no-newline = false
    n = args()

    {
        n <= 2 -> {
            // No arguments: read from stdin and print
            line, ok = fs.get-line()
            ok -> print(line)
            ok == false -> print('')
        }
        -> {
            // Check for -n flag
            i <- [2..n): {
                a = arg(i)
                a == '-n' -> no-newline = true
            }

            // Print arguments separated by spaces
            need-space = false
            i <- [2..n): {
                a = arg(i)
                a != '-n' -> {
                    need-space == true -> io.out(' ')
                    io.out(a)
                    need-space = true
                }
            }

            // Print trailing newline unless -n
            no-newline == false -> print('')
        }
    }
}
