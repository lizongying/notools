; mkdir.no — mkdir utility
; Create directories
; Usage: mkdir [-p] [-m mode] dir...
;   -p: create parent directories as needed (no error if directory exists)
;   -m mode: specify permission mode (octal, e.g. 755, 700)
;   dir: directory to create

; p creates a directory and all parent directories as needed.
; Scans the path for '/' separators; at each '/', creates the prefix
; directory if it does not yet exist. Finally creates the full path.
p = (path str, mode i64) {
    n = path.len
    i <- [1..n): {
        path[i] == '/' -> {
            cur = path.slice(0, i)
            cur.len > 0 -> {
                fs.is-dir(cur) == false -> {
                    ok = os.mkdir(cur, mode)
                    ok == false -> {
                        io.errln('mkdir: cannot create directory ' - cur)
                        os.exit(1)
                    }
                }
            }
        }
    }

    ; Create the final directory
    {
        path.len > 0 -> {
            fs.is-dir(path) == false -> {
                ok = os.mkdir(path, mode)
                ok == false -> {
                    io.errln('mkdir: cannot create directory ' - path)
                    os.exit(1)
                }
            }
        }
    }
}

; one creates a single directory without creating parents.
one = (path str, mode i64) {
    {
        fs.is-dir(path) -> {
            io.errln('mkdir: cannot create directory ' - path - ': File exists')
            os.exit(1)
        }
    }
    ok = os.mkdir(path, mode)
    {
        ok == false -> {
            io.errln('mkdir: cannot create directory ' - path)
            os.exit(1)
        }
    }
}

; run is the main entry point for the mkdir utility.
; Uses two passes: first to parse flags/mode, second to create directories.
; This avoids []str push (which causes memory corruption).
mkdir-run = () {
    argc = args()
    parents = false
    mode = 511
    has-mode = false
    has-dir = false

    ; First pass: parse flags and mode
    i <- [2..argc): {
        a = arg(i)
        has-mode -> {
            mode = 0
            j <- [0..a.len): {
                c = a[j]
                c >= '0' && c <= '7' -> mode = mode * 8 + (c - '0')
            }
            has-mode = false
        }
        a.starts-with('-') -> {
            parents = parents || a.contains('p')
            a.contains('m') -> has-mode = true
        }
    }

    ; Second pass: create directories
    has-mode = false
    i <- [2..argc): {
        a = arg(i)
        is-dir-arg = true
        has-mode -> {
            has-mode = false
            is-dir-arg = false
        }
        a.starts-with('-') -> {
            is-dir-arg = false
            a.contains('m') -> has-mode = true
        }
        is-dir-arg -> {
            has-dir = true
            parents -> p(a, mode)
            parents == false -> one(a, mode)
        }
    }

    {
        has-dir == false -> {
            io.errln('Usage: mkdir [-p] [-m mode] dir...')
            os.exit(1)
        }
    }
}
