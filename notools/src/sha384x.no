    rt10_hi = a >> 39
    rt10_lo = a << 25
    rt10 = rt10_hi | rt10_lo
            s0v = rt8 ^ rt9 ^ rt10
            maj = (a & b) ^ (a & c) ^ (b & c)
            t2 = s0v + maj
            hh = g
            g = f
            f = e
            e = d + t1
            d = c
            c = b
            b = a
            a = t1 + t2
        }
        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + hh
        offset = offset + 128
    } (offset < total-len)
    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(96)
    bb0_0 = (h0 >> 56) & 255
    bb0_1 = (h0 >> 48) & 255
    bb0_2 = (h0 >> 40) & 255
    bb0_3 = (h0 >> 32) & 255
    bb0_4 = (h0 >> 24) & 255
    bb0_5 = (h0 >> 16) & 255
    bb0_6 = (h0 >> 8) & 255
    bb0_7 = (h0 >> 0) & 255
    hex[0] = hex-chars[(bb0_0 >> 4) & 15]
    hex[1] = hex-chars[bb0_0 & 15]
    hex[2] = hex-chars[(bb0_1 >> 4) & 15]
    hex[3] = hex-chars[bb0_1 & 15]
    hex[4] = hex-chars[(bb0_2 >> 4) & 15]
    hex[5] = hex-chars[bb0_2 & 15]
    hex[6] = hex-chars[(bb0_3 >> 4) & 15]
    hex[7] = hex-chars[bb0_3 & 15]
    hex[8] = hex-chars[(bb0_4 >> 4) & 15]
    hex[9] = hex-chars[bb0_4 & 15]
    hex[10] = hex-chars[(bb0_5 >> 4) & 15]
    hex[11] = hex-chars[bb0_5 & 15]
    hex[12] = hex-chars[(bb0_6 >> 4) & 15]
    hex[13] = hex-chars[bb0_6 & 15]
    hex[14] = hex-chars[(bb0_7 >> 4) & 15]
    hex[15] = hex-chars[bb0_7 & 15]
    bb16_0 = (h1 >> 56) & 255
