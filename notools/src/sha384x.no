; sha384x: 完整 SHA-384 雜湊，返回 96 字元 hex 字串
sha384x = (data []byte) (hex str) {
    m u64 = 18446744073709551615
    h0 u64 = 14680500436340154072
    h1 u64 = 7105036623409894663
    h2 u64 = 10473403895298186519
    h3 u64 = 1526699215303891257
    h4 u64 = 7436329637833083697
    h5 u64 = 10282925794625328401
    h6 u64 = 15784041429090275239
    h7 u64 = 5167115440072839076
    dlen = data.len
    bit-len = dlen * 8
    mod-val = (dlen + 17) % 128
    pad-len = 0
    mod-val != 0 -> pad-len = 128 - mod-val
    total-len = dlen + 1 + pad-len + 16
    padded []byte = with-len(total-len)
    i <- [0..total-len): {
        padded[i] = 0
    }
    i <- [0..dlen): {
        padded[i] = data[i]
    }
    padded[dlen] = 128
    i <- [dlen + 1..total-len - 16): {
        padded[i] = 0
    }
    i <- [0..8): {
        padded[total-len - 8 + i] = (bit-len >> (56 - i * 8)) & 255
    }
    k []u64 = [
        4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156, 4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976,
        15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146, 8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548,
        16472876342353939154, 17275323862435702243, 1135362057144423861, 2597628984639134821, 3308224258029322869, 5365058923640841347, 6679025012923562964, 8573033837759648693,
        10970295158949994411, 12119686244451234320, 12683024718118986047, 13788192230050041572, 14330467153632333762, 15395433587784984357, 489312712824947311, 1452737877330783856,
        2861767655752347644, 3322285676063803686, 5560940570517711597, 5996557281743188959, 7280758554555802590, 8532644243296465576, 9350256976987008742, 10552545826968843579,
        11727347734174303076, 12113106623233404929, 14000437183269869457, 14369950271660146224, 15101387698204529176, 15463397548674623760, 17586052441742319658, 1182934255886127544,
        1847814050463011016, 2177327727835720531, 2830643537854262169, 3796741975233480872, 4115178125766777443, 5681478168544905931, 6601373596472566643, 7507060721942968483,
        8399075790359081724, 8693463985226723168, 9568029438360202098, 10144078919501101548, 10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635,
        14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208, 500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939,
        2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356, 5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127,
    ]
    w []u64 = with-len(640)
    offset = 0
    {
        i <- [0..16): {
            w[i] = (padded[offset + i * 8] << 56) | (padded[offset + i * 8 + 1] << 48) | (padded[offset + i * 8 + 2] << 40) | (padded[offset + i * 8 + 3] << 32) | (padded[offset + i * 8 + 4] << 24) | (padded[offset + i * 8 + 5] << 16) | (padded[offset + i * 8 + 6] << 8) | padded[offset + i * 8 + 7]
        }
        i <- [16..80): {
            s0 = rotate-left(w[i - 15], 63) ^ rotate-left(w[i - 15], 56) ^ (w[i - 15] >> 7)
            s1 = rotate-left(w[i - 2], 45) ^ rotate-left(w[i - 2], 3) ^ (w[i - 2] >> 6)
            w[i] = w[i - 16] + s0 + w[i - 7] + s1
        }
        a u64 = h0
        b u64 = h1
        c u64 = h2
        d u64 = h3
        e u64 = h4
        f u64 = h5
        g u64 = h6
        hh u64 = h7
        i <- [0..80): {
            s1v = rotate-left(e, 50) ^ rotate-left(e, 46) ^ rotate-left(e, 23)
            ch = (e & f) ^ ((m ^ e) & g)
            t1 = hh + s1v + ch + k[i] + w[i]
            s0v = rotate-left(a, 36) ^ rotate-left(a, 30) ^ rotate-left(a, 25)
            maj = (a & b) ^ (a & c) ^ (b & c)
            t2 = s0v + maj
            hh = g
            g = f
            f = e
            e = d + t1
            d = c
            c = b
            b = a
            a = t1 + t2
        }
        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + hh
        offset = offset + 128
    } (offset < total-len)
    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(96)
    bb0-0 = (h0 >> 56) & 255
    bb0-1 = (h0 >> 48) & 255
    bb0-2 = (h0 >> 40) & 255
    bb0-3 = (h0 >> 32) & 255
    bb0-4 = (h0 >> 24) & 255
    bb0-5 = (h0 >> 16) & 255
    bb0-6 = (h0 >> 8) & 255
    bb0-7 = (h0 >> 0) & 255
    hex[0] = hex-chars[(bb0-0 >> 4) & 15]
    hex[1] = hex-chars[bb0-0 & 15]
    hex[2] = hex-chars[(bb0-1 >> 4) & 15]
    hex[3] = hex-chars[bb0-1 & 15]
    hex[4] = hex-chars[(bb0-2 >> 4) & 15]
    hex[5] = hex-chars[bb0-2 & 15]
    hex[6] = hex-chars[(bb0-3 >> 4) & 15]
    hex[7] = hex-chars[bb0-3 & 15]
    hex[8] = hex-chars[(bb0-4 >> 4) & 15]
    hex[9] = hex-chars[bb0-4 & 15]
    hex[10] = hex-chars[(bb0-5 >> 4) & 15]
    hex[11] = hex-chars[bb0-5 & 15]
    hex[12] = hex-chars[(bb0-6 >> 4) & 15]
    hex[13] = hex-chars[bb0-6 & 15]
    hex[14] = hex-chars[(bb0-7 >> 4) & 15]
    hex[15] = hex-chars[bb0-7 & 15]
    bb16-0 = (h1 >> 56) & 255
    bb16-1 = (h1 >> 48) & 255
    bb16-2 = (h1 >> 40) & 255
    bb16-3 = (h1 >> 32) & 255
    bb16-4 = (h1 >> 24) & 255
    bb16-5 = (h1 >> 16) & 255
    bb16-6 = (h1 >> 8) & 255
    bb16-7 = (h1 >> 0) & 255
    hex[16] = hex-chars[(bb16-0 >> 4) & 15]
    hex[17] = hex-chars[bb16-0 & 15]
    hex[18] = hex-chars[(bb16-1 >> 4) & 15]
    hex[19] = hex-chars[bb16-1 & 15]
    hex[20] = hex-chars[(bb16-2 >> 4) & 15]
    hex[21] = hex-chars[bb16-2 & 15]
    hex[22] = hex-chars[(bb16-3 >> 4) & 15]
    hex[23] = hex-chars[bb16-3 & 15]
    hex[24] = hex-chars[(bb16-4 >> 4) & 15]
    hex[25] = hex-chars[bb16-4 & 15]
    hex[26] = hex-chars[(bb16-5 >> 4) & 15]
    hex[27] = hex-chars[bb16-5 & 15]
    hex[28] = hex-chars[(bb16-6 >> 4) & 15]
    hex[29] = hex-chars[bb16-6 & 15]
    hex[30] = hex-chars[(bb16-7 >> 4) & 15]
    hex[31] = hex-chars[bb16-7 & 15]
    bb32-0 = (h2 >> 56) & 255
    bb32-1 = (h2 >> 48) & 255
    bb32-2 = (h2 >> 40) & 255
    bb32-3 = (h2 >> 32) & 255
    bb32-4 = (h2 >> 24) & 255
    bb32-5 = (h2 >> 16) & 255
    bb32-6 = (h2 >> 8) & 255
    bb32-7 = (h2 >> 0) & 255
    hex[32] = hex-chars[(bb32-0 >> 4) & 15]
    hex[33] = hex-chars[bb32-0 & 15]
    hex[34] = hex-chars[(bb32-1 >> 4) & 15]
    hex[35] = hex-chars[bb32-1 & 15]
    hex[36] = hex-chars[(bb32-2 >> 4) & 15]
    hex[37] = hex-chars[bb32-2 & 15]
    hex[38] = hex-chars[(bb32-3 >> 4) & 15]
    hex[39] = hex-chars[bb32-3 & 15]
    hex[40] = hex-chars[(bb32-4 >> 4) & 15]
    hex[41] = hex-chars[bb32-4 & 15]
    hex[42] = hex-chars[(bb32-5 >> 4) & 15]
    hex[43] = hex-chars[bb32-5 & 15]
    hex[44] = hex-chars[(bb32-6 >> 4) & 15]
    hex[45] = hex-chars[bb32-6 & 15]
    hex[46] = hex-chars[(bb32-7 >> 4) & 15]
    hex[47] = hex-chars[bb32-7 & 15]
    bb48-0 = (h3 >> 56) & 255
    bb48-1 = (h3 >> 48) & 255
    bb48-2 = (h3 >> 40) & 255
    bb48-3 = (h3 >> 32) & 255
    bb48-4 = (h3 >> 24) & 255
    bb48-5 = (h3 >> 16) & 255
    bb48-6 = (h3 >> 8) & 255
    bb48-7 = (h3 >> 0) & 255
    hex[48] = hex-chars[(bb48-0 >> 4) & 15]
    hex[49] = hex-chars[bb48-0 & 15]
    hex[50] = hex-chars[(bb48-1 >> 4) & 15]
    hex[51] = hex-chars[bb48-1 & 15]
    hex[52] = hex-chars[(bb48-2 >> 4) & 15]
    hex[53] = hex-chars[bb48-2 & 15]
    hex[54] = hex-chars[(bb48-3 >> 4) & 15]
    hex[55] = hex-chars[bb48-3 & 15]
    hex[56] = hex-chars[(bb48-4 >> 4) & 15]
    hex[57] = hex-chars[bb48-4 & 15]
    hex[58] = hex-chars[(bb48-5 >> 4) & 15]
    hex[59] = hex-chars[bb48-5 & 15]
    hex[60] = hex-chars[(bb48-6 >> 4) & 15]
    hex[61] = hex-chars[bb48-6 & 15]
    hex[62] = hex-chars[(bb48-7 >> 4) & 15]
    hex[63] = hex-chars[bb48-7 & 15]
    bb64-0 = (h4 >> 56) & 255
    bb64-1 = (h4 >> 48) & 255
    bb64-2 = (h4 >> 40) & 255
    bb64-3 = (h4 >> 32) & 255
    bb64-4 = (h4 >> 24) & 255
    bb64-5 = (h4 >> 16) & 255
    bb64-6 = (h4 >> 8) & 255
    bb64-7 = (h4 >> 0) & 255
    hex[64] = hex-chars[(bb64-0 >> 4) & 15]
    hex[65] = hex-chars[bb64-0 & 15]
    hex[66] = hex-chars[(bb64-1 >> 4) & 15]
    hex[67] = hex-chars[bb64-1 & 15]
    hex[68] = hex-chars[(bb64-2 >> 4) & 15]
    hex[69] = hex-chars[bb64-2 & 15]
    hex[70] = hex-chars[(bb64-3 >> 4) & 15]
    hex[71] = hex-chars[bb64-3 & 15]
    hex[72] = hex-chars[(bb64-4 >> 4) & 15]
    hex[73] = hex-chars[bb64-4 & 15]
    hex[74] = hex-chars[(bb64-5 >> 4) & 15]
    hex[75] = hex-chars[bb64-5 & 15]
