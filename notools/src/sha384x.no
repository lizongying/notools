    w []u64 = with-len(640)
    offset = 0
    {
        i <- [0..16): { w[i] = (padded[offset + i * 8] << 56) | (padded[offset + i * 8 + 1] << 48) | (padded[offset + i * 8 + 2] << 40) | (padded[offset + i * 8 + 3] << 32) | (padded[offset + i * 8 + 4] << 24) | (padded[offset + i * 8 + 5] << 16) | (padded[offset + i * 8 + 6] << 8) | padded[offset + i * 8 + 7] }
        i <- [16..80): {
    rt1_hi = w[i - 15] >> 1
    rt1_lo = w[i - 15] << 63
    rt1 = rt1_hi | rt1_lo
    rt2_hi = w[i - 15] >> 8
    rt2_lo = w[i - 15] << 56
    rt2 = rt2_hi | rt2_lo
            s0 = rt1 ^ rt2 ^ (w[i - 15] >> 7)
    rt3_hi = w[i - 2] >> 19
    rt3_lo = w[i - 2] << 45
    rt3 = rt3_hi | rt3_lo
    rt4_hi = w[i - 2] >> 61
    rt4_lo = w[i - 2] << 3
    rt4 = rt4_hi | rt4_lo
            s1 = rt3 ^ rt4 ^ (w[i - 2] >> 6)
            w[i] = w[i - 16] + s0 + w[i - 7] + s1
        }
        a u64 = h0
        b u64 = h1
        c u64 = h2
        d u64 = h3
        e u64 = h4
        f u64 = h5
        g u64 = h6
