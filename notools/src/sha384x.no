    h6 = 15784041429090275239
    h7 = 5167115440072839076
    dlen = data.len
    bit-len = dlen * 8
    mod-val = (dlen + 17) % 128
    pad-len = 0
    mod-val != 0 -> pad-len = 128 - mod-val
    total-len = dlen + 1 + pad-len + 16
    padded []byte = with-len(total-len)
    i <- [0..total-len): { padded[i] = 0 }
    i <- [0..dlen): { padded[i] = data[i] }
    padded[dlen] = 128
    i <- [dlen + 1..total-len - 16): { padded[i] = 0 }
    i <- [0..8): { padded[total-len - 8 + i] = (bit-len >> (56 - i * 8)) & 255 }
    k []u64 = with-len(640)
