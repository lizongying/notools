    rt6_hi = e >> 18
    rt6_lo = e << 46
    rt6 = rt6_hi | rt6_lo
    rt7_hi = e >> 41
    rt7_lo = e << 23
    rt7 = rt7_hi | rt7_lo
            s1v = rt5 ^ rt6 ^ rt7
            ch = (e & f) ^ ((m ^ e) & g)
            t1 = hh + s1v + ch + k[i] + w[i]
    rt8_hi = a >> 28
    rt8_lo = a << 36
    rt8 = rt8_hi | rt8_lo
    rt9_hi = a >> 34
    rt9_lo = a << 30
