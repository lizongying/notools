    hex[77] = hex-chars[bb64-6 & 15]
    hex[78] = hex-chars[(bb64-7 >> 4) & 15]
    hex[79] = hex-chars[bb64-7 & 15]
    bb80-0 = (h5 >> 56) & 255
    bb80-1 = (h5 >> 48) & 255
    bb80-2 = (h5 >> 40) & 255
    bb80-3 = (h5 >> 32) & 255
    bb80-4 = (h5 >> 24) & 255
    bb80-5 = (h5 >> 16) & 255
    bb80-6 = (h5 >> 8) & 255
    bb80-7 = (h5 >> 0) & 255
    hex[80] = hex-chars[(bb80-0 >> 4) & 15]
    hex[81] = hex-chars[bb80-0 & 15]
    hex[82] = hex-chars[(bb80-1 >> 4) & 15]
    hex[83] = hex-chars[bb80-1 & 15]
    hex[84] = hex-chars[(bb80-2 >> 4) & 15]
    hex[85] = hex-chars[bb80-2 & 15]
    hex[86] = hex-chars[(bb80-3 >> 4) & 15]
    hex[87] = hex-chars[bb80-3 & 15]
    hex[88] = hex-chars[(bb80-4 >> 4) & 15]
    hex[89] = hex-chars[bb80-4 & 15]
    hex[90] = hex-chars[(bb80-5 >> 4) & 15]
    hex[91] = hex-chars[bb80-5 & 15]
    hex[92] = hex-chars[(bb80-6 >> 4) & 15]
    hex[93] = hex-chars[bb80-6 & 15]
    hex[94] = hex-chars[(bb80-7 >> 4) & 15]
    hex[95] = hex-chars[bb80-7 & 15]
}
