; namei.no — namei utility
; Resolve a path and print each component with its type
; Usage: namei PATH

namei-run = () {
    argc = os.args()
    {
        argc != 3 -> {
            print("N")
            exit(1)
        }
    }
    path = os.arg(2)
    {
        path.len() == 0 -> {
            print("N")
            exit(1)
        }
    }

    ; Split path into components by '/' (ASCII 47)
    comps []str
    comp = ''
    i <- [0..path.len()): {
        c = path[i]
        c == 47 -> {
            comp.len() > 0 -> {
                comps.push(comp)
                comp = ''
            }
        }
        c != 47 -> comp = comp - c.to-str()
    }
    {
        comp.len() > 0 -> {
            comps.push(comp)
            comp = ''
        }
    }
    absolute = false
    {
        path[0] == 47 -> absolute = true

        absolute -> print('f: /')
    }

    cur = ''
    absolute -> cur = '/'
    i <- [0..comps.len()): {

        #{index-out=zero}
        name = comps[i]
        {
            cur == '/' -> cur = cur - name

            cur == '' -> cur = name

            -> {
                cur = cur - '/' - name
            }
        }

        target, is-link = fs.readlink(cur)
        {
            is-link -> print(' l: ' - name - ' -> ' - target)

            fs.is-dir(cur) -> print('d: ' - name)

            -> {
                print(' f: ' - name)
            }
        }
    }
}
