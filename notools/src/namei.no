; namei.no — namei utility
; Resolve a path and print each component with its type
; Usage: namei PATH

namei-run = () {
    argc = os.args().len()
    {
        argc != 3 -> {
            eprint('Usage: namei PATH')
            exit(1)
        }
    }
    path-opt = os.arg(2)
    path = path-opt: {
        ok -> it

        -> ''
    }
    {
        path.len() == 0 -> {
            eprint('namei: empty path')
            exit(1)
        }
    }

    ; Split path into components by '/' (ASCII 47)
    comps []str
    comp = ''
    i <- [0..path.len()): {
        c = path[i]
        c == 47 -> {
            comp.len() > 0 -> {
                comps.push(comp)
                comp = ''
            }
        }
        c != 47 -> comp = comp - c.to-str()
    }
    {
        comp.len() > 0 -> {
            comps.push(comp)
            comp = ''
        }
    }
    absolute = false
    {
        path[0] == 47 -> absolute = true

        absolute -> print('f: /')
    }

    cur = ''
    absolute -> cur = '/'
    i <- [0..comps.len()): {

        name = comps[i]: {
            ok -> it

            -> ''
        }
        {
            cur == '/' -> cur = cur - name

            cur == '' -> cur = name

            -> {
                cur = cur - '/' - name
            }
        }

        target-opt = fs.readlink(cur)
        target = ''
        is-link = false
        target-opt: {
            ok -> {
                target = it
                is-link = true
            }

            -> {
            }
        }
        {
            is-link -> print(' l: ' - name - ' -> ' - target)

            fs.is-dir(cur) -> print('d: ' - name)

            -> {
                print(' f: ' - name)
            }
        }
    }
}
