; namei.no — namei utility
; Resolve a path and print each component with its type
; Usage: namei PATH

namei-run = () {
    argc = args()
    {
        argc != 3 -> {
            eprint('Usage: namei PATH')
            os.exit(1)
        }
    }
    path = arg(2)
    {
        path.len == 0 -> {
            eprint('namei: empty path')
            os.exit(1)
        }
    }
    ; Split path into components by '/' (ASCII 47)
    comps []str
    comp = ''
    i <- [0..path.len): {
        c = path[i]
        c == 47 -> {
            comp.len > 0 -> {
                comps.push(comp)
                comp = ''
            }
        }
        c != 47 -> comp = comp - number.char-to-str(c)
    }
    {
        comp.len > 0 -> {
            comps.push(comp)
            comp = ''
        }
    }
    absolute = false
    {
        path[0] == 47 -> absolute = true
        absolute -> print('f: /')
    }
    cur = ''
    absolute -> cur = '/'
    i <- [0..comps.len): {
        name = comps[i]
        {
            cur == '/' -> cur = cur - name
            cur == '' -> cur = name
            -> {
                cur = cur - '/' - name
            }
        }
        target, is-link = fs.readlink(cur)
        {
            is-link -> print(' l: ' - name - ' -> ' - target)
            fs.is-dir(cur) -> print('d: ' - name)
            -> {
                print(' f: ' - name)
            }
        }
    }
}
