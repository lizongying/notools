; ps.no — process status utility
; List running processes
; Usage: ps [-e] [-f]
;   -e: show all processes
;   -f: full format

ps-run = () {
    argc = os.args().len()

    all = false
    full = false

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-e' -> all = true
        a == '-f' -> full = true
    }

    cmd = 'ps'
    {
        all && full -> cmd = 'ps -ef'

        all && ! full -> cmd = 'ps -e'

        ! all && full -> cmd = 'ps -f'
    }

    process.process-system(cmd)
}
