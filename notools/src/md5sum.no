; md5sum.no — md5sum utility (coreutils alias)
; Compute MD5 checksums
; Usage: md5sum [FILE...]   (no FILE: read stdin)
;        md5sum -c CHECKFILE   (verify checksums)
# /notools/src/md5x.md5x

md5sum-run = () {
    argc = args()
    ; Check for -c mode
    {
        argc >= 3 -> {
            arg(2) == '-c' -> {
                checkfile = arg(3)
                content = fs.read-file(checkfile)
                lines []str
                start = 0
                i <- [0..content.len): {
                    content[i] == 10 -> {
                        lines.push(content.slice(start, i))
                        start = i + 1
                    }
                }
                start < content.len -> lines.push(content.slice(start, content.len))
                any-failed = false
                i <- [0..lines.len): {
                    line = lines[i]
                    line.len == 0 -> *
                    ; Line format: "<hash>  <file>"
                    sp = line.index('  ')
                    sp < 0 -> *
                    expected = line.slice(0, sp)
                    fname = line.slice(sp + 2, line.len)
                    fs.is-file(fname) == false -> {
                        print(fname - ': FAILED (no such file)')
                        any-failed = true
                        *
                    }
                    inp = fs.read-file(fname)
                    data = inp.to-bytes()
                    actual = md5x(data)
                    {
                    actual == expected -> {
                        print(fname - ': OK')
                    }
                    -> {
                        print(fname - ': FAILED')
                        any-failed = true
                    }
                    }
                }
                any-failed -> os.exit(1)
                return
            }
        }
    }
    ; Normal mode
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            t <- [0..40): {
                inp.len == 0 -> {
                    os.sleep-us(1000)
                    inp = fs.read-file('/dev/stdin')
                }
            }
            data = inp.to-bytes()
            h = md5x(data)
            print(h - '  -')
        }
        -> {
            i <- [2..argc): {
                path = arg(i)
                fs.is-file(path) == false -> {
                    eprint('md5sum: ' - path - ': No such file')
                    os.exit(1)
                }
                inp = fs.read-file(path)
                data = inp.to-bytes()
                h = md5x(data)
                print(h - '  ' - path)
            }
        }
    }
}
