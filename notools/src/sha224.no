; sha224.no — SHA-224 哈希
; 计算文件或 stdin 的 SHA-224（十六进制，56 字符）
; 用法：sha224 [file...]   无参数时读取 stdin
; 走本地 sha224x（标准库 sha224 目前返回未计算的 IV，不可用）
# /notools/src/sha224x.sha224x

sha224-run = () {
    argc = args()
    {
        argc <= 2 -> {
            sinp []byte
            sr = fs.read-stdin()
            sr: {
                ok -> sinp = it

                nil -> {
                }

                err -> {
                }
            }
            sdata = sinp
            h = sha224x(sdata)
            print(h)
        }

        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    ! fs.is-file(path) -> {
                        #{overflow=wrap}
                        emsg = 'sha224: ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                finp []byte
                fr = fs.read-bytes(path)
                fr: {
                    ok -> finp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                fdata = finp
                h = sha224x(fdata)

                #{overflow=wrap}
                line = h - '  ' - path
                print(line)
            }
        }
    }
}
