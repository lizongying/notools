; sha224.no — SHA-224 哈希
; 计算文件或 stdin 的 SHA-224（十六进制，56 字符）
; 用法：sha224 [file...]   无参数时读取 stdin
# /notools/src/sha224x.sha224x

sha224-run = () {
    argc = args()
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            ; stdin 為管道時 stat 大小競態可能讀空（B18），讀空則短暫重試
            t <- [0..40): {
                inp.len == 0 -> {
                    os.sleep-us(1000)
                    inp = fs.read-file('/dev/stdin')
                }
            }
            data = inp.to-bytes()
            h = sha224x(data)
            print(h)
        }

        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    fs.is-file(path) == false -> {
                        emsg = 'sha224: ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                inp = fs.read-file(path)
                data = inp.to-bytes()
                h = sha224x(data)
                line = h - '  ' - path
                print(line)
            }
        }
    }
}
