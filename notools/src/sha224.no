// sha224.no — SHA-224 哈希
// 计算文件或 stdin 的 SHA-224（十六进制，56 字符）
// 用法：sha224 [file...]   无参数时读取 stdin
// 注意：标准库 sha224-hex 存在 str 返回丢失缺陷，改用本地 sha224x（void 直接打印）
# /src/sha224x.sha224x
sha224-run = () {
    argc = args()
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            data = inp.to-bytes()
            sha224x(data)
        }
        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    fs.is-file(path) == false -> {
                        emsg = 'sha224: ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                inp = fs.read-file(path)
                data = inp.to-bytes()
                sha224x(data)
            }
        }
    }
}
