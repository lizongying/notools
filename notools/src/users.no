// users.no — users utility
// Print the user names of users currently logged in to the system
// Usage: users
// Simplified: prints the current user name (from os.get-login / USER env)

users-cmd = () {
    name = os.get-login()
    {
        name.len > 0 -> {
            print(name)
            return
        }
    }
    name = os.get-env('USER')
    {
        name.len > 0 -> {
            print(name)
            return
        }
    }
    name = os.get-env('LOGNAME')
    {
        name.len > 0 -> {
            print(name)
            return
        }
    }
    eprint('users: no users logged in')
    os.exit(1)
}
