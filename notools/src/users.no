; users.no — users utility
; Print the user names of users currently logged in to the system
; Usage: users
; Simplified: prints the current user name (from os.get-login / USER env)

users-cmd = () {
    name = os.get-login()
    {
        name.len() > 0 -> {
            print(name)
            return
        }
    }
    name-opt = os.get-env('USER')
    name = name-opt: {
        ok -> it

        -> ''
    }
    {
        name.len() > 0 -> {
            print(name)
            return
        }
    }
    name-opt = os.get-env('LOGNAME')
    name = name-opt: {
        ok -> it

        -> ''
    }
    {
        name.len() > 0 -> {
            print(name)
            return
        }
    }
    eprint('users: no users logged in')
    exit(1)
}
