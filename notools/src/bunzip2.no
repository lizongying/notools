; bunzip2.no — bunzip2 decompression utility (native Nolang)
; Decompresses .bz2 files using archive/bzip2.no.
; Usage: bunzip2 [-c] [-k] <file.bz2...>
;   -c  寫到標準輸出
;   -k  保留原檔

bunzip2-cmd = () {
    argc = args()

    to-stdout = false
    keep = false
    has-file = false

    i = 2
    (i < argc) {
        a = arg(i)
        {
            a == '-c' -> to-stdout = true

            a == '-k' -> keep = true

            a == '-f' -> {
            }

            ! a.starts-with('-') -> {
                has-file = true
                f = a

                ! fs.is-file(f) -> {
                    #{overflow=wrap}
                    eprint('bunzip2: ' - f - ': No such file')

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = content
                out []byte = bzip2.bzip2-decompress(data)

                {
                    to-stdout -> {
                        s = out.to-bytes-str()
                        io.out(s)
                    }

                    -> {
                        out-name = f
                        #{overflow=wrap}
                        f.ends-with('.bz2') -> out-name = f.slice(0, f.len-bytes() - 4)
                        fs.write-file(out-name, out)
                        ! keep -> fs.remove(f)
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }

    {
        ! has-file -> {
            eprint('bunzip2: no input files')
            os.exit(1)
        }
    }
}
