; bunzip2.no — bunzip2 decompression utility (native Nolang)
; Decompresses .bz2 files using archive/bzip2.no.
; Usage: bunzip2 [-c] [-k] <file.bz2...>
;   -c  寫到標準輸出
;   -k  保留原檔

bunzip2-cmd = () {
    argc = args()

    to-stdout = false
    keep = false
    has-file = false

    i = 2
    for i < argc {
        a = arg(i)
        {
            a == '-c' -> to-stdout = true
            a == '-k' -> keep = true
            a == '-f' -> {}
            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    eprint('bunzip2: ' - f - ': No such file')
                    i = i + 1
                    continue
                }
                content = fs.read-file(f)
                data = content.to-bytes()
                out []byte = bzip2.bzip2-decompress(data)

                to-stdout -> {
                    s = out.to-str()
                    io.out(s)
                }
                -> {
                    out-name = f
                    f.ends-with('.bz2') -> out-name = f.slice(0, f.len - 4)
                    fs.write-file(out-name, out)
                    keep == false -> fs.remove(f)
                }
            }
        }

        i = i + 1
    }

    {
        has-file == false -> {
            eprint('bunzip2: no input files')
            os.exit(1)
        }
    }
}
