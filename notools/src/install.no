; install.no — install utility
; Copy files and set ownership/permissions
; Usage: install [-m MODE] [-o UID] [-g GID] SOURCE DEST

install-parse-octal = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 55 -> v = v * 8 + (c - 48)
    }
}

install-parse-int = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
install-run = () {
    argc = args()
    mode = -1
    uid = -1
    gid = -1
    files []str
    next-is-m = false
    next-is-o = false
    next-is-g = false
    i <- [2..argc): {
        a = arg(i)
        {
            next-is-m -> {
                mode = install-parse-octal(a)
                next-is-m = false
            }

            next-is-o -> {
                uid = install-parse-int(a)
                next-is-o = false
            }

            next-is-g -> {
                gid = install-parse-int(a)
                next-is-g = false
            }

            a == '-m' -> next-is-m = true

            a == '-o' -> next-is-o = true

            a == '-g' -> next-is-g = true

            -> {
                files.push(a)
            }
        }
    }
    {
        files.len < 2 -> {
            eprint('Usage: install [-m MODE] [-o UID] [-g GID] SOURCE DEST')
            os.exit(1)
        }
    }
    src = files[0]
    dst = files[1]
    content []byte
    r = fs.read-bytes(src)
    r: {
        ok -> content = it
        nil -> {
        }
        err -> {
        }
    }
    data = content
    ok = fs.write-file(dst, data)
    {
        ok == false -> {
            eprint('install: cannot write to ' - dst)
            os.exit(1)
        }

        mode >= 0 -> os.ch-mod(dst, mode)

        uid >= 0 || gid >= 0 -> os.chown(dst, uid, gid)
    }
}

#{win-amd64, win-arm64}
install-run = () {
    argc = args()
    mode = -1
    files []str
    next-is-m = false
    next-is-o = false
    next-is-g = false
    i <- [2..argc): {
        a = arg(i)
        {
            next-is-m -> {
                mode = install-parse-octal(a)
                next-is-m = false
            }

            next-is-o -> {
                next-is-o = false
            }

            next-is-g -> {
                next-is-g = false
            }

            a == '-m' -> next-is-m = true

            a == '-o' -> next-is-o = true

            a == '-g' -> next-is-g = true

            -> {
                files.push(a)
            }
        }
    }
    {
        files.len < 2 -> {
            eprint('Usage: install [-m MODE] [-o UID] [-g GID] SOURCE DEST')
            os.exit(1)
        }
    }
    src = files[0]
    dst = files[1]
    content []byte
    r = fs.read-bytes(src)
    r: {
        ok -> content = it
        nil -> {
        }
        err -> {
        }
    }
    data = content
    ok = fs.write-file(dst, data)
    {
        ok == false -> {
            eprint('install: cannot write to ' - dst)
            os.exit(1)
        }

        mode >= 0 -> os.ch-mod(dst, mode)
    }
}
