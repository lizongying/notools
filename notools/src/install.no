; install.no — install utility
; Copy files and set ownership/permissions
; Usage: install [-m MODE] [-o UID] [-g GID] SOURCE DEST

install-parse-octal = (s str) (v i64) {
    v = 0
    i <- [0..s.len()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 55 -> v = v * 8 + (c - 48)
    }
}

install-parse-int = (s str) (v i64) {
    v = 0
    i <- [0..s.len()): {
        c = s[i]

        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
install-run = () {
    argc = os.args().len()
    mode = -1
    uid = -1
    gid = -1
    files []str
    next-is-m = false
    next-is-o = false
    next-is-g = false
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            next-is-m -> {
                mode = install-parse-octal(a)
                next-is-m = false
            }

            next-is-o -> {
                uid = install-parse-int(a)
                next-is-o = false
            }

            next-is-g -> {
                gid = install-parse-int(a)
                next-is-g = false
            }

            a == '-m' -> next-is-m = true

            a == '-o' -> next-is-o = true

            a == '-g' -> next-is-g = true

            -> {
                files.push(a)
            }
        }
    }
    {
        files.len() < 2 -> {
            eprint('Usage: install [-m MODE] [-o UID] [-g GID] SOURCE DEST')
            exit(1)
        }
    }

    src = files[0]: {
        ok -> it

        -> ''
    }

    dst = files[1]: {
        ok -> it

        -> ''
    }
    content []byte
    read-ok = false
    r = fs.read-bytes(src)
    r: {
        ok -> {
            content = it
            read-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    ; 读失败绝不写空文件覆盖目标（T-4）。
    ! read-ok -> {
        eprint('install: cannot read ' - src)
        exit(1)
    }
    data = content
    ok = fs.write-file(dst, data)
    {
        ! ok -> {
            eprint('install: cannot write to ' - dst)
            exit(1)
        }

        mode >= 0 -> os.ch-mod(dst, mode)

        uid >= 0 || gid >= 0 -> os.chown(dst, uid, gid)
    }
}

#{win-amd64, win-arm64}
install-run = () {
    argc = os.args().len()
    mode = -1
    files []str
    next-is-m = false
    next-is-o = false
    next-is-g = false
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            next-is-m -> {
                mode = install-parse-octal(a)
                next-is-m = false
            }

            next-is-o -> {
                next-is-o = false
            }

            next-is-g -> {
                next-is-g = false
            }

            a == '-m' -> next-is-m = true

            a == '-o' -> next-is-o = true

            a == '-g' -> next-is-g = true

            -> {
                files.push(a)
            }
        }
    }
    {
        files.len() < 2 -> {
            eprint('Usage: install [-m MODE] [-o UID] [-g GID] SOURCE DEST')
            exit(1)
        }
    }

    src = files[0]: {
        ok -> it

        -> ''
    }

    dst = files[1]: {
        ok -> it

        -> ''
    }
    content []byte
    read-ok = false
    r = fs.read-bytes(src)
    r: {
        ok -> {
            content = it
            read-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    ; 读失败绝不写空文件覆盖目标（T-4）。
    ! read-ok -> {
        eprint('install: cannot read ' - src)
        exit(1)
    }
    data = content
    ok = fs.write-file(dst, data)
    {
        ! ok -> {
            eprint('install: cannot write to ' - dst)
            exit(1)
        }

        mode >= 0 -> os.ch-mod(dst, mode)
    }
}
