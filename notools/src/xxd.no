; xxd.no — xxd 十六进制转储
; 用法：xxd [-p] [-r] [-c COLS] [-g GROUP] [file]
;   -p       纯十六进制模式（无地址、无 ASCII，按 -c 折行）
;   -r       反转模式（从十六进制还原为二进制）
;   -c COLS  每行字节数（默认 16；-p 模式默认 30）
;   -g GROUP 每组字节数（默认 2；-p 模式默认 1）
;   file     指定文件，否则读取 stdin

# /notools/src/xxd.xxd

; xxd-pnum: 解析（可帶負號）整數字串
xxd-pnum = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    slen = s.len()
    {
        slen > 0 && s[0] == 45 -> {
            neg = true
            start = 1
        }

        -> {
        }
    }
    i <- [start..slen): {
        c = s[i] & 255
        c >= 48 && c <= 57 -> {

            #{overflow=wrap}
            v = v * 10 + (c - 48)
        }
    }
    {
        neg -> {

            #{overflow=wrap}
            v = 0 - v: {
                ok -> it

                -> _
            }
        }

        -> {
        }
    }
}

; xxd-varname: 由完整路徑推導 C 識別字元（非 alnum/_ → _）；stdin（空）→ ''
xxd-varname = (infile str) (nm str) {
    nm = ''
    {
        infile == '' -> {
        }

        -> {
            j <- [0..infile.len()): {
                c i64 = infile[j] & 255
                alnum = c >= 48 && c <= 57
                upper = c >= 65 && c <= 90
                lower = c >= 97 && c <= 122
                us = c == 95
                okch = alnum || upper || lower || us
                {
                    okch -> {
                        cc char = c
                        nm = nm - cc.to-str()
                    }

                    -> nm = nm - '_'
                }
            }
        }
    }
}

xxd-run = () {
    argc = os.args().len()
    cols = 16
    group = 2
    pure = false
    rev = false
    autoskip = false
    include = false
    cols-set = false
    group-set = false
    skip = 0
    skip-set = false
    limit = -1
    ooff = 0
    iname = ''
    infile = ''
    outfile = ''
    npos = 0
    i = 2
    (i < argc) {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        alen = a.len()
        {
            alen >= 2 && a[0] == 45 -> {
                base = a.slice-bytes(1, alen)
                blen = base.len()
                f0 i64 = base[0]
                {
                    f0 == 99 || f0 == 103 || f0 == 108 || f0 == 115 || f0 == 111 || f0 == 110 -> {
                        rest = base.slice-bytes(1, blen)
                        val = rest
                        {
                            rest == '' -> {

                                #{overflow=wrap}
                                niopt = i + 1
                                ni i64 = 0
                                niopt: {
                                    ok -> {
                                        ni = it
                                    }

                                    -> {
                                    }
                                }
                                {
                                    ni < argc -> {
                                        val-opt = os.arg(ni)
                                        val = val-opt: {
                                            ok -> it

                                            -> ''
                                        }
                                        n0 = ni
                                        n0: {
                                            ok -> {
                                                i = it
                                            }

                                            -> {
                                            }
                                        }
                                    }

                                    -> {
                                    }
                                }
                            }

                            -> {
                            }
                        }
                        {
                            f0 == 99 -> {
                                cols = xxd-pnum(val)
                                cols-set = true
                            }

                            f0 == 103 -> {
                                group = xxd-pnum(val)
                                group-set = true
                            }

                            f0 == 108 -> limit = xxd-pnum(val)

                            f0 == 115 -> {
                                skip = xxd-pnum(val)
                                skip-set = true
                            }

                            f0 == 111 -> ooff = xxd-pnum(val)

                            -> iname = val
                        }
                    }

                    -> {
                        k <- [0..blen): {
                            ch i64 = base[k]
                            {
                                ch == 112 -> pure = true

                                ch == 114 -> rev = true

                                ch == 97 -> autoskip = true

                                ch == 105 -> include = true

                                -> {
                                }
                            }
                        }
                    }
                }
            }

            -> {
                {
                    npos == 0 -> infile = a

                    npos == 1 -> outfile = a

                    -> {
                    }
                }
                {
                    npos < 2 -> {

                        #{overflow=wrap}
                        npopt = npos + 1: {
                            ok -> it

                            -> _
                        }
                        npos = npopt
                    }

                    -> {
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }

    {
        pure && ! cols-set -> cols = 30

        include && ! cols-set -> cols = 12

        -> {
        }
    }
    {
        pure && ! group-set -> group = 1

        -> {
        }
    }
    cols < 1 -> cols = 16
    group == 0 -> group = cols
    group < 0 -> group = 2

    raw []byte
    {
        infile == '' -> {
            r = fs.read-stdin()
            r: {
                ok -> raw = it

                nil -> {
                }

                err -> {
                }
            }
        }

        -> {
            ! fs.is-file(infile) -> {
                io.errln('xxd: ' - infile - ': No such file or directory')
                exit(1)
            }
            r2 = fs.read-bytes(infile)
            r2: {
                ok -> raw = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    rl = raw.len()
    start = 0
    {
        ! skip-set -> {
        }

        skip >= 0 -> start = skip

        -> {

            #{overflow=wrap}
            s2 = rl + skip: {
                ok -> it

                -> _
            }
            s2 < 0 -> s2 = 0
            start = s2
        }
    }
    start > rl -> start = rl
    end = rl
    {
        limit >= 0 -> {

            #{overflow=wrap}
            cand = start + limit: {
                ok -> it

                -> _
            }
            {
                cand < end -> end = cand

                -> {
                }
            }
        }

        -> {
        }
    }
    data []byte
    m <- [start..end): {
        rm = raw[m]: {
            ok -> it

            -> _
        }
        data.push(rm)
    }

    #{overflow=wrap}
    disp-base-opt = start + ooff
    disp-base = start
    disp-base-opt: {
        ok -> {
            disp-base = it
        }

        -> {
        }
    }

    {
        rev -> reverse(data, pure)

        pure -> dump-pure(data, cols)

        include -> {
            nm = iname
            nm == '' -> nm = xxd-varname(infile)
            c-include(data, nm, cols)
        }

        -> canonical(data, cols, group, autoskip, disp-base)
    }
}

; pure: 纯十六进制模式输出
dump-pure = (data []byte, cols i64) {
    hex-digits = '0123456789abcdef'
    space = ' '
    offset = 0
    n = data.len()
    (offset < n) {
        offset < n -> {

            #{overflow=wrap}
            ln-t = n - offset
            line-n i64 = ln-t: {
                ok -> it

                -> 0
            }
            line-n > cols -> line-n = cols

            #{overflow=wrap}
            rp-t = line-n * 2
            rep i64 = rp-t: {
                ok -> it

                -> 0
            }
            ; 用字符串拼接构造整行：str 的 option 索引写会写入 0x01 tag 字节
            line = ''
            j <- [0..line-n): {

                #{overflow=wrap}
                di = offset + j: {
                    ok -> it

                    -> _
                }
                db = data[di]: {
                    ok -> it

                    -> _
                }
                b = db & 255

                hb = hex-digits[(b >> 4) & 15]: {
                    ok -> it

                    -> "0"
                }
                lb = hex-digits[b & 15]: {
                    ok -> it

                    -> "0"
                }
                line = line - hb - lb
            }
            print(line)

            #{overflow=wrap}
            offset = offset + cols: {
                ok -> it

                -> _
            }
        }
    }
}

; canonical: 默认带地址与 ASCII 的十六进制转储
; autoskip: >=4 连续全零满行始终折叠; ==3 仅当后续有非零数据时折叠
canonical = (data []byte, cols i64, group i64, autoskip bool, base i64) {
    hex-digits = '0123456789abcdef'
    space = ' '
    n = data.len()

    ngroups = 0
    ngroups-opt = cols / group
    ngroups-opt: {
        ok -> {
            ngroups = it
        }

        -> {
            ngroups = 0
        }
    }

    rem = 0
    rem-opt = cols - (ngroups * group)
    rem-opt: {
        ok -> {
            rem = it
        }

        -> {
            rem = 0
        }
    }
    hex-width = 0
    {
        rem > 0 -> {

            #{overflow=wrap}
            hw = ngroups * (group * 2 + 1) + rem * 2: {
                ok -> it

                -> _
            }
            hex-width = hw
        }

        rem == 0 -> {

            #{overflow=wrap}
            hw = ngroups * (group * 2 + 1) - 1: {
                ok -> it

                -> _
            }
            hex-width = hw
        }
    }

    ; compute total-lines
    total-lines = n / cols
    {
        n > total-lines * cols -> total-lines = total-lines + 1

        -> {
        }
    }
    n == 0 -> total-lines = 0

    ; first pass: mark zero-full per line
    zero-full []bool
    li <- [0..total-lines): {

        #{overflow=wrap}
        off = li * cols: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        line-n = n - off: {
            ok -> it

            -> _
        }
        line-n > cols -> line-n = cols
        is-full = line-n == cols
        all-zero = true
        j <- [0..line-n): {

            #{overflow=wrap}
            oi = off + j: {
                ok -> it

                -> _
            }
            dv = data[oi]: {
                ok -> it

                -> _
            }
            {
                dv != 0 -> {
                    all-zero = false
                    break
                }
            }
        }
        zero-full.push(is-full && all-zero)
    }

    ; compute skip-line marks
    skip-line []bool
    li <- [0..total-lines): {
        skip-line.push(false)
    }
    {
        autoskip && total-lines > 0 -> {

            ; scan runs
            ri = 0
            (ri < total-lines) {
                ri < total-lines -> {
                    zf = zero-full[ri]: {
                        ok -> it

                        -> _
                    }
                    {
                        zf -> {
                            start = ri
                            end = ri

                            #{overflow=wrap}
                            kstart = ri + 1: {
                                ok -> it

                                -> _
                            }
                            k <- [kstart..total-lines): {
                                zfk = zero-full[k]: {
                                    ok -> it

                                    -> _
                                }
                                {
                                    zfk -> end = k

                                    -> {
                                        break
                                    }
                                }
                            }

                            #{overflow=wrap}
                            run-len = end - start + 1: {
                                ok -> it

                                -> _
                            }

                            ; check nonzero after run
                            #{overflow=wrap}
                            ep1 = end + 1: {
                                ok -> it

                                -> _
                            }

                            #{overflow=wrap}
                            after-off = ep1 * cols: {
                                ok -> it

                                -> _
                            }
                            found-nz = false
                            k2 <- [after-off..n): {
                                dv2 = data[k2]: {
                                    ok -> it

                                    -> _
                                }
                                {
                                    dv2 != 0 -> {
                                        found-nz = true
                                        break
                                    }
                                }
                            }
                            qualified = false
                            {
                                run-len >= 4 -> qualified = true

                                run-len == 3 && found-nz -> qualified = true

                                -> {
                                }
                            }
                            {
                                qualified -> {
                                    skip-end = end
                                    {
                                        ! found-nz && end == total-lines - 1 -> {

                                            #{overflow=wrap}
                                            em1 = end - 1: {
                                                ok -> it

                                                -> _
                                            }
                                            skip-end = em1
                                        }

                                        -> {
                                        }
                                    }

                                    #{overflow=wrap}
                                    se1 = skip-end + 1: {
                                        ok -> it

                                        -> _
                                    }
                                    j2 <- [start + 1..se1): {
                                        skip-line[j2]: {
                                            ok -> it = true

                                            -> _
                                        }
                                    }
                                }
                            }

                            #{overflow=wrap}
                            ri = end + 1: {
                                ok -> it

                                -> _
                            }
                        }

                        -> {

                            #{overflow=wrap}
                            ri = ri + 1: {
                                ok -> it

                                -> _
                            }
                        }
                    }
                }
            }
        }

        -> {
        }
    }

    ; second pass: render
    offset = 0
    starred = false
    li <- [0..total-lines): {
        sk = skip-line[li]: {
            ok -> it

            -> _
        }
        {
            sk -> {
                ! starred -> {
                    print('*')
                    starred = true
                }
            }

            -> {
                starred = false

                #{overflow=wrap}
                line-n = n - offset: {
                    ok -> it

                    -> _
                }
                line-n > cols -> line-n = cols

                ; 用字符串拼接构造整行：str 的 option 索引写会写入 0x01 tag 字节。
                ; address: 8 位十六进制 + ':' + ' '
                #{overflow=wrap}
                a = base + offset
                addr = ''
                k3 <- [0..8): {
                    ; 注意：不要写 a & 15: { ok -> it; -> _ } —— 实测该 option-match
                    ; 对 & 运算恒走 fallback，使索引恒错（参照 od.no 的修复）。
                    ai = a & 15
                    ab = hex-digits[ai]: {
                        ok -> it

                        -> "0"
                    }
                    addr = ab - addr
                    a = a >> 4
                }
                line = addr - ':' - ' '

                ; hex section: 每 group 字节之间插入一个空格
                hexpart = ''
                j3 <- [0..line-n): {
                    {
                        j3 > 0 && (j3 % group == 0) -> {
                            hexpart = hexpart - ' '
                        }
                    }

                    #{overflow=wrap}
                    di = offset + j3: {
                        ok -> it

                        -> _
                    }
                    db3 = data[di]: {
                        ok -> it

                        -> _
                    }
                    b = db3 & 255

                    hidx = (b >> 4) & 15
                    hb3 = hex-digits[hidx]: {
                        ok -> it

                        -> "0"
                    }
                    ldx = b & 15
                    lb3 = hex-digits[ldx]: {
                        ok -> it

                        -> "0"
                    }
                    hexpart = hexpart - hb3 - lb3
                }
                line = line - hexpart

                ; 短行补齐 hex 列宽，再加与 ascii 列之间的两个空格
                #{overflow=wrap}
                pad = hex-width - hexpart.len-bytes() + 2
                pad > 0 -> {
                    line = line - space.repeat(pad)
                }

                ; ascii section
                j4 <- [0..line-n): {

                    #{overflow=wrap}
                    di = offset + j4: {
                        ok -> it

                        -> _
                    }
                    db4 = data[di]: {
                        ok -> it

                        -> _
                    }
                    b = db4 & 255
                    {
                        b >= 32 && b < 127 -> {
                            bc char = b
                            line = line - bc.to-str()
                        }

                        -> {
                            line = line - '.'
                        }
                    }
                }
                print(line)
            }
        }

        #{overflow=wrap}
        offset = offset + cols: {
            ok -> it

            -> _
        }
    }
}

; c-include: C 数组格式输出
; 有名: unsigned char NAME[] = {
; body

; 无名(stdin): 仅 body
c-include = (data []byte, nm str, cols i64) {
    hex-digits = '0123456789abcdef'
    n = data.len()
    n == 0 -> return
    {
        nm != '' -> print('unsigned char ' - nm - '[] = {')

        -> {
        }
    }
    ls = 0
    (ls < n) {
        ls < n -> {
            line-str = '  '

            #{overflow=wrap}
            le-opt = ls + cols
            line-end = n
            le-opt: {
                ok -> {
                    line-end = it
                }

                -> {
                }
            }
            line-end > n -> line-end = n
            j <- [ls..line-end): {
                {
                    j > ls -> line-str = line-str - ', '

                    -> {
                    }
                }
                dj = data[j]: {
                    ok -> it

                    -> _
                }
                b = dj & 255
                hi-idx = (b >> 4) & 15: {
                    ok -> it

                    -> _
                }
                lo-idx = b & 15: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                hip1 = hi-idx + 1: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                lop1 = lo-idx + 1: {
                    ok -> it

                    -> _
                }
                line-str = line-str - '0x' - hex-digits.slice-bytes(hi-idx, hip1) - hex-digits.slice-bytes(lo-idx, lop1)
            }
            {
                line-end < n -> line-str = line-str - ','

                -> {
                }
            }
            print(line-str)

            #{overflow=wrap}
            ls = ls + cols: {
                ok -> it

                -> _
            }
        }
    }
    {
        nm != '' -> {
            print('};')
            print('unsigned int ' - nm - '_len = ' - n.to-str() - ';')
        }

        -> {
        }
    }
}

; reverse: 从十六进制还原为二进制
reverse = (data []byte, pure-mode bool) {
    out []byte
    n = data.len()
    {
        pure-mode -> {

            ; 纯十六进制：扫描所有十六进制字符，按对组合
            cnt = 0
            hi-c = 0
            i <- [0..n): {
                di = data[i]: {
                    ok -> it

                    -> _
                }
                c = di & 255
                v = -1
                {
                    c >= 48 && c <= 57 -> {

                        #{overflow=wrap}
                        v = c - 48: {
                            ok -> it

                            -> 0
                        }
                    }

                    c >= 65 && c <= 70 -> {

                        #{overflow=wrap}
                        v = c - 55: {
                            ok -> it

                            -> 0
                        }
                    }

                    c >= 97 && c <= 102 -> {

                        #{overflow=wrap}
                        v = c - 87: {
                            ok -> it

                            -> 0
                        }
                    }
                }

                {
                    v >= 0 -> {
                        cnt == 0 -> {
                            hi-c = v
                            cnt = 1
                        }

                        -> {
                            hvo = hi-c << 4
                            hv = 0
                            hvo: {
                                ok -> hv = it

                                -> _
                            }
                            bvo = hv | v
                            bv = 0
                            bvo: {
                                ok -> bv = it

                                -> _
                            }
                            out.push(bv)
                            cnt = 0
                        }
                    }
                }
            }
        }

        -> {

            ; 格式模式：逐行处理，跳过地址，在 ':' 之后读取十六进制对
            line-start = 0
            i <- [0..n): {
                di = data[i]: {
                    ok -> it

                    -> _
                }
                c = di & 255
                c == 10 -> {
                    parse-format-line(data, line-start, i, out)

                    #{overflow=wrap}
                    line-start = i + 1: {
                        ok -> it

                        -> _
                    }
                }
            }
            line-start < n -> parse-format-line(data, line-start, n, out)
        }
    }

    ; 写入二进制到 stdout
    fd = fs.open-write('/dev/stdout')
    fs.write(fd, out, out.len())
}

; parse-format-line: 解析 xxd 格式行，提取十六进制字节
; 在 [start, end) 范围内查找 ':'，然后解析后续十六进制对，遇到连续 2+ 空格停止
parse-format-line = (data []byte, start i64, end i64, out []byte) {
    colon = -1
    j <- [start..end): {
        dj = data[j]: {
            ok -> it

            -> _
        }
        (dj & 255) == 58 -> {
            colon = j
            break
        }
    }
    {
        colon < 0 -> return
    }

    #{overflow=wrap}
    pos = colon + 1: {
        ok -> it

        -> _
    }
    cnt = 0
    hi-c = 0
    spaces = 0
    (pos < end) {
        pos < end -> {
            dp = data[pos]: {
                ok -> it

                -> _
            }
            c = dp & 255
            {
                c == 32 -> {

                    #{overflow=wrap}
                    spaces = spaces + 1: {
                        ok -> it

                        -> _
                    }
                    spaces >= 2 -> pos = end
                }

                -> spaces = 0
            }

            {
                pos < end -> {
                    v = -1
                    {
                        c >= 48 && c <= 57 -> {

                            #{overflow=wrap}
                            v = c - 48: {
                                ok -> it

                                -> 0
                            }
                        }

                        c >= 65 && c <= 70 -> {

                            #{overflow=wrap}
                            v = c - 55: {
                                ok -> it

                                -> 0
                            }
                        }

                        c >= 97 && c <= 102 -> {

                            #{overflow=wrap}
                            v = c - 87: {
                                ok -> it

                                -> 0
                            }
                        }
                    }

                    {
                        v >= 0 -> {
                            cnt == 0 -> {
                                hi-c = v
                                cnt = 1
                            }

                            -> {
                                hvo = hi-c << 4
                                hv = 0
                                hvo: {
                                    ok -> hv = it

                                    -> _
                                }
                                bvo = hv | v
                                bv = 0
                                bvo: {
                                    ok -> bv = it

                                    -> _
                                }
                                out.push(bv)
                                cnt = 0
                            }
                        }
                    }
                }
            }

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
    }
}
