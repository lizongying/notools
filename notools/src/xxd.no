; xxd.no — xxd 十六进制转储
; 用法：xxd [-p] [-r] [-c COLS] [-g GROUP] [file]
;   -p       纯十六进制模式（无地址、无 ASCII，按 -c 折行）
;   -r       反转模式（从十六进制还原为二进制）
;   -c COLS  每行字节数（默认 16；-p 模式默认 30）
;   -g GROUP 每组字节数（默认 2；-p 模式默认 1）
;   file     指定文件，否则读取 stdin

# /notools/src/xxd.xxd

; xxd-pnum: 解析（可帶負號）整數字串
xxd-pnum = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    slen = s.len-bytes()
    {
        slen > 0 && s[0] == 45 -> {
            neg = true
            start = 1
        }
        -> {
        }
    }
    i <- [start..slen): {
        c = s[i] & 255
        c >= 48 && c <= 57 -> {
            #{overflow=wrap}
            v = v * 10 + (c - 48)
        }
    }
    {
        neg -> {
            #{overflow=wrap}
            v = 0 - v
        }
        -> {
        }
    }
}

; xxd-varname: 由完整路徑推導 C 識別字元（非 alnum/_ → _）；stdin（空）→ ''
xxd-varname = (infile str) (nm str) {
    nm = ''
    {
        infile == '' -> {
        }
        -> {
            j <- [0..infile.len-bytes()): {
                c = infile[j] & 255
                alnum = c >= 48 && c <= 57
                upper = c >= 65 && c <= 90
                lower = c >= 97 && c <= 122
                us = c == 95
                okch = alnum || upper || lower || us
                {
                    okch -> nm = nm - number.char-to-str(c)
                    -> nm = nm - '_'
                }
            }
        }
    }
}

xxd-run = () {
    argc = args()
    cols = 16
    group = 2
    pure = false
    rev = false
    autoskip = false
    include = false
    cols-set = false
    group-set = false
    skip = 0
    skip-set = false
    limit = -1
    ooff = 0
    iname = ''
    infile = ''
    outfile = ''
    npos = 0
    i = 2
    (i < argc) {
        a = arg(i)
        alen = a.len-bytes()
        {
            alen >= 2 && a[0] == 45 -> {
                base = a.slice-bytes(1, alen)
                blen = base.len-bytes()
                f0 i64 = base[0]
                {
                    f0 == 99 || f0 == 103 || f0 == 108 || f0 == 115 || f0 == 111 || f0 == 110 -> {
                        rest = base.slice-bytes(1, blen)
                        val = rest
                        {
                            rest == '' -> {
                                #{overflow=wrap}
                                ni = i + 1
                                {
                                    ni < argc -> {
                                        val = arg(ni)
                                        i = ni
                                    }
                                    -> {
                                    }
                                }
                            }
                            -> {
                            }
                        }
                        {
                            f0 == 99 -> {
                                cols = xxd-pnum(val)
                                cols-set = true
                            }
                            f0 == 103 -> {
                                group = xxd-pnum(val)
                                group-set = true
                            }
                            f0 == 108 -> limit = xxd-pnum(val)
                            f0 == 115 -> {
                                skip = xxd-pnum(val)
                                skip-set = true
                            }
                            f0 == 111 -> ooff = xxd-pnum(val)
                            -> iname = val
                        }
                    }
                    -> {
                        k <- [0..blen): {
                            ch i64 = base[k]
                            {
                                ch == 112 -> pure = true
                                ch == 114 -> rev = true
                                ch == 97 -> autoskip = true
                                ch == 105 -> include = true
                                -> {
                                }
                            }
                        }
                    }
                }
            }
            -> {
                {
                    npos == 0 -> infile = a
                    npos == 1 -> outfile = a
                    -> {
                    }
                }
                {
                    npos < 2 -> npos = npos + 1
                    -> {
                    }
                }
            }
        }
        #{overflow=wrap}
        i = i + 1
    }

    {
        pure && ! cols-set -> cols = 30
        include && ! cols-set -> cols = 12
        -> {
        }
    }
    {
        pure && ! group-set -> group = 1
        -> {
        }
    }
    cols < 1 -> cols = 16
    group == 0 -> group = cols
    group < 0 -> group = 2

    raw []byte
    {
        infile == '' -> {
            r = fs.read-stdin()
            r: {
                ok -> raw = it

                nil -> {
                }

                err -> {
                }
            }
        }
        -> {
            ! fs.is-file(infile) -> {
                io.errln('xxd: ' - infile - ': No such file or directory')
                os.exit(1)
            }
            r2 = fs.read-bytes(infile)
            r2: {
                ok -> raw = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    rl = raw.len()
    start = 0
    {
        ! skip-set -> {
        }
        skip >= 0 -> start = skip
        -> {
            #{overflow=wrap}
            s2 = rl + skip
            s2 < 0 -> s2 = 0
            start = s2
        }
    }
    start > rl -> start = rl
    end = rl
    {
        limit >= 0 -> {
            #{overflow=wrap}
            cand = start + limit
            {
                cand < end -> end = cand
                -> {
                }
            }
        }
        -> {
        }
    }
    data []byte
    m <- [start..end): {
        data.push(raw[m])
    }
    #{overflow=wrap}
    disp-base = start + ooff

    {
        rev -> reverse(data, pure)

        pure -> dump-pure(data, cols)

        include -> {
            nm = iname
            nm == '' -> nm = xxd-varname(infile)
            c-include(data, nm, cols)
        }

        -> canonical(data, cols, group, autoskip, disp-base)
    }
}

; pure: 纯十六进制模式输出
dump-pure = (data []byte, cols i64) {
    hex-digits = '0123456789abcdef'
    space = ' '
    offset = 0
    n = data.len()
    (offset < n) {
        offset < n -> {

            #{overflow=wrap}
            line-n = n - offset
            line-n > cols -> line-n = cols
            #{overflow=wrap}
            line = space.repeat(line-n * 2)
            j <- [0..line-n): {
                #{overflow=wrap}
                b = data[offset + j] & 255
                #{overflow=wrap}
                line[j * 2] = hex-digits[(b >> 4) & 15]
                #{overflow=wrap}
                line[j * 2 + 1] = hex-digits[b & 15]
            }
            print(line)
            #{overflow=wrap}
            offset = offset + cols
        }
    }
}

; canonical: 默认带地址与 ASCII 的十六进制转储
; autoskip: >=4 连续全零满行始终折叠; ==3 仅当后续有非零数据时折叠
canonical = (data []byte, cols i64, group i64, autoskip bool, base i64) {
    hex-digits = '0123456789abcdef'
    space = ' '
    n = data.len()
    #{overflow=wrap}
    ngroups = cols / group
    #{overflow=wrap}
    rem = cols - (ngroups * group)
    hex-width = 0
    {
        rem > 0 -> hex-width = ngroups * (group * 2 + 1) + rem * 2
        rem == 0 -> hex-width = ngroups * (group * 2 + 1) - 1
    }
    ; compute total-lines
    total-lines = n / cols
    {
        n > total-lines * cols -> total-lines = total-lines + 1
        -> {}
    }
    n == 0 -> total-lines = 0

    ; first pass: mark zero-full per line
    zero-full []bool
    li <- [0..total-lines): {
        #{overflow=wrap}
        off = li * cols
        #{overflow=wrap}
        line-n = n - off
        line-n > cols -> line-n = cols
        is-full = line-n == cols
        all-zero = true
        j <- [0..line-n): {
            {
                data[off + j] != 0 -> {
                    all-zero = false
                    break
                }
            }
        }
        zero-full.push(is-full && all-zero)
    }

    ; compute skip-line marks
    skip-line []bool
    li <- [0..total-lines): { skip-line.push(false) }
    {
        autoskip && total-lines > 0 -> {
            ; scan runs
            ri = 0
            (ri < total-lines) {
                ri < total-lines -> {
                    {
                        zero-full[ri] -> {
                            start = ri
                            end = ri
                            k <- [ri + 1..total-lines): {
                                {
                                    zero-full[k] -> end = k
                                    -> { break }
                                }
                            }
                            #{overflow=wrap}
                            run-len = end - start + 1
                            ; check nonzero after run
                            #{overflow=wrap}
                            after-off = (end + 1) * cols
                            found-nz = false
                            k2 <- [after-off..n): {
                                {
                                    data[k2] != 0 -> {
                                        found-nz = true
                                        break
                                    }
                                }
                            }
                            qualified = false
                            {
                                run-len >= 4 -> qualified = true
                                run-len == 3 && found-nz -> qualified = true
                                -> {}
                            }
                            {
                                qualified -> {
                                    #{overflow=wrap}
                                    skip-end = end
                                    {
                                        ! found-nz && end == total-lines - 1 -> {
                                            #{overflow=wrap}
                                            skip-end = end - 1
                                        }
                                        -> {}
                                    }
                                    j2 <- [start + 1..skip-end + 1): {
                                        skip-line[j2] = true
                                    }
                                }
                            }
                            #{overflow=wrap}
                            ri = end + 1
                        }
                        -> {
                            #{overflow=wrap}
                            ri = ri + 1
                        }
                    }
                }
            }
        }
        -> {}
    }

    ; second pass: render
    offset = 0
    starred = false
    li <- [0..total-lines): {
        {
            skip-line[li] -> {
                {
                    ! starred -> {
                        print('*')
                        starred = true
                    }
                }
            }
            -> {
                starred = false
                #{overflow=wrap}
                line-n = n - offset
                line-n > cols -> line-n = cols
                #{overflow=wrap}
                line-len = 8 + 2 + hex-width + 2 + line-n
                line = space.repeat(line-len)
                ; address
                #{overflow=wrap}
                a = base + offset
                k3 <- [0..8): {
                    #{overflow=wrap}
                    line[7 - k3] = hex-digits[a & 15]
                    #{overflow=wrap}
                    a = a >> 4
                }
                line[8] = ':'
                line[9] = ' '
                ; hex section
                hi = 10
                j3 <- [0..line-n): {
                    {
                        j3 > 0 && (j3 % group == 0) -> {
                            line[hi] = ' '
                            #{overflow=wrap}
                            hi = hi + 1
                        }
                    }
                    #{overflow=wrap}
                    b = data[offset + j3] & 255
                    line[hi] = hex-digits[(b >> 4) & 15]
                    #{overflow=wrap}
                    hi = hi + 1
                    line[hi] = hex-digits[b & 15]
                    #{overflow=wrap}
                    hi = hi + 1
                }
                ; ascii section
                #{overflow=wrap}
                ascii-start = 10 + hex-width + 2
                j4 <- [0..line-n): {
                    #{overflow=wrap}
                    b = data[offset + j4] & 255
                    {
                        b >= 32 && b < 127 -> line[ascii-start + j4] = b
                        -> line[ascii-start + j4] = '.'
                    }
                }
                print(line)
            }
        }
        #{overflow=wrap}
        offset = offset + cols
    }
}

; c-include: C 数组格式输出
; 有名: unsigned char NAME[] = {
 body 
};
unsigned int NAME_len = N;

; 无名(stdin): 仅 body
c-include = (data []byte, nm str, cols i64) {
    hex-digits = '0123456789abcdef'
    n = data.len()
    n == 0 -> return
    {
        nm != '' -> print('unsigned char ' - nm - '[] = {')
        -> {}
    }
    ls = 0
    (ls < n) {
        ls < n -> {
            line-str = '  '
            #{overflow=wrap}
            line-end = ls + cols
            line-end > n -> line-end = n
            j <- [ls..line-end): {
                {
                    j > ls -> line-str = line-str - ', '
                    -> {}
                }
                #{overflow=wrap}
                b = data[j] & 255
                hi-idx = (b >> 4) & 15
                lo-idx = b & 15
                #{overflow=wrap}
                line-str = line-str - '0x' - hex-digits.slice-bytes(hi-idx, hi-idx + 1) - hex-digits.slice-bytes(lo-idx, lo-idx + 1)
            }
            {
                line-end < n -> line-str = line-str - ','
                -> {}
            }
            print(line-str)
            #{overflow=wrap}
            ls = ls + cols
        }
    }
    {
        nm != '' -> {
            print('};')
            print('unsigned int ' - nm - '_len = ' - n.to-str() - ';')
        }
        -> {}
    }
}

; reverse: 从十六进制还原为二进制
reverse = (data []byte, pure-mode bool) {
    out []byte
    n = data.len()
    {
        pure-mode -> {

            ; 纯十六进制：扫描所有十六进制字符，按对组合
            cnt = 0
            hi-c = 0
            i <- [0..n): {
                c = data[i] & 255
                v = -1
                {
                    c >= 48 && c <= 57 -> {

                        #{overflow=wrap}
                        v = c - 48
                    }

                    #{overflow=wrap}
                    c >= 65 && c <= 70 -> v = c - 55

                    #{overflow=wrap}
                    c >= 97 && c <= 102 -> v = c - 87
                }

                {
                    v >= 0 -> {
                        cnt == 0 -> {
                            hi-c = v
                            cnt = 1
                        }

                        -> {
                            out.push((hi-c << 4) | v)
                            cnt = 0
                        }
                    }
                }
            }
        }

        -> {

            ; 格式模式：逐行处理，跳过地址，在 ':' 之后读取十六进制对
            line-start = 0
            i <- [0..n): {
                c = data[i] & 255
                c == 10 -> {
                    parse-format-line(data, line-start, i, out)
                    #{overflow=wrap}
                    line-start = i + 1
                }
            }
            line-start < n -> parse-format-line(data, line-start, n, out)
        }
    }

    ; 写入二进制到 stdout
    fd = fs.open-write('/dev/stdout')
    fs.write(fd, out, out.len())
}

; parse-format-line: 解析 xxd 格式行，提取十六进制字节
; 在 [start, end) 范围内查找 ':'，然后解析后续十六进制对，遇到连续 2+ 空格停止
parse-format-line = (data []byte, start i64, end i64, out []byte) {
    colon = -1
    j <- [start..end): {
        (data[j] & 255) == 58 -> {
            colon = j
            break
        }
    }
    {
        colon < 0 -> return
    }

    #{overflow=wrap}
    pos = colon + 1
    cnt = 0
    hi-c = 0
    spaces = 0
    (pos < end) {
        pos < end -> {
            c = data[pos] & 255
            {
                c == 32 -> {

                    #{overflow=wrap}
                    spaces = spaces + 1
                    spaces >= 2 -> pos = end
                }

                -> spaces = 0
            }

            {
                pos < end -> {
                    v = -1
                    {
                        #{overflow=wrap}
                        c >= 48 && c <= 57 -> v = c - 48

                        #{overflow=wrap}
                        c >= 65 && c <= 70 -> v = c - 55

                        #{overflow=wrap}
                        c >= 97 && c <= 102 -> v = c - 87
                    }

                    {
                        v >= 0 -> {
                            cnt == 0 -> {
                                hi-c = v
                                cnt = 1
                            }

                            -> {
                                out.push((hi-c << 4) | v)
                                cnt = 0
                            }
                        }
                    }
                }
            }
            #{overflow=wrap}
            pos = pos + 1
        }
    }
}
