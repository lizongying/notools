; sum.no — 文件校验和
; 计算文件的 16-bit 校验和和块数
; 用法：sum [-r] [-s] [file...]
;   -r  System V 模式（每字节累加，块大小 512）
;   -s  BSD 模式（默认，每 2 字节 big-endian 累加，块大小 1024）
; 无参数时读取 stdin
; 输出格式：CHECKSUM BLOCKS FILENAME（stdin 时无 FILENAME）

sum-run = () {
    argc = args()
    sysv = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        {
            a == '-r' -> sysv = true

            a == '-s' -> sysv = false

            ! a.starts-with('-') -> files.push(a)
        }
    }

    {
        files.len == 0 -> {
            inp []byte
            r = fs.read-stdin()
            r: {
                ok -> inp = it
                nil -> {
                }
                err -> {
                }
            }
            data = inp
            {
                sysv == true -> {
                    checksum, blocks = calc-sysv(data)
                    line = checksum.to-str() - ' ' - blocks.to-str()
                    print(line)
                }

                -> {
                    checksum, blocks = bsd(data)
                    line = checksum.to-str() - ' ' - blocks.to-str()
                    print(line)
                }
            }
        }

        -> {
            fi <- [0..files.len): {
                f = files[fi]
                fs.is-file(f) == false -> {
                    io.errln('sum: ' - f - ': No such file or directory')
                    os.exit(1)
                }
                inp []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> inp = it
                    nil -> {
                    }
                    err -> {
                    }
                }
                data = inp
                {
                    sysv == true -> {
                        checksum, blocks = calc-sysv(data)
                        line = checksum.to-str() - ' ' - blocks.to-str() - ' ' - f
                        print(line)
                    }

                    -> {
                        checksum, blocks = bsd(data)
                        line = checksum.to-str() - ' ' - blocks.to-str() - ' ' - f
                        print(line)
                    }
                }
            }
        }
    }
}

; bsd: BSD 校验和
; 每 2 字节（big-endian）累加到 16-bit，溢出回绕
; blocks = ceil(size / 1024)，最少 1
bsd = (data []byte) (checksum i64, blocks i64) {
    checksum = 0
    n = data.len
    i = 0
    {
        i + 1 < n -> {
            checksum = checksum + (((data[i] & 255) << 8) | (data[i + 1] & 255))
            checksum = checksum & 0xffff
            i = i + 2
        }
        i < n -> {
            checksum = checksum + ((data[i] & 255) << 8)
            checksum = checksum & 0xffff
            i = i + 2
        }
    } (i < n)
    blocks = (n + 1023) / 1024
    blocks == 0 -> blocks = 1
}

; sysv: System V 校验和
; 每字节累加到 32-bit，最后回绕到 16-bit（r=1）
; blocks = ceil(size / 512)，最少 1
calc-sysv = (data []byte) (checksum i64, blocks i64) {
    checksum = 0
    n = data.len
    i <- [0..n): {
        checksum = checksum + (data[i] & 255)
    }
    ; 回绕：将高位折叠到低位
    {
        checksum > 0xffff -> {
            checksum = (checksum & 0xffff) + (checksum >> 16)
            checksum > 0xffff -> checksum = (checksum & 0xffff) + (checksum >> 16)
        }
    }
    blocks = (n + 511) / 512
    blocks == 0 -> blocks = 1
}
