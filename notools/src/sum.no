; sum.no — 文件校验和
; 计算文件的 16-bit 校验和和块数
; 用法：sum [-r] [-s] [file...]
;   -r  System V 模式（默认，与 macOS 一致：每字节 16-bit 右旋累加，块大小 512）
;   -s  BSD 模式（每 2 字节 big-endian 累加，块大小 1024）
; 无参数时读取 stdin
; 输出格式：CHECKSUM BLOCKS FILENAME（stdin 时无 FILENAME）

sum-run = () {
    argc = os.args().len()
    sysv = true
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            a == '-r' -> sysv = true

            a == '-s' -> sysv = false

            ! a.starts-with('-') -> files.push(a)
        }
    }

    {
        files.len() == 0 -> {
            inp []byte
            r = fs.read-stdin()
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            data = inp
            {
                sysv -> {
                    checksum, blocks = calc-sysv(data)

                    line = checksum.to-str() - ' ' - blocks.to-str()
                    print(line)
                }

                -> {
                    checksum, blocks = bsd(data)
                    line = checksum.to-str() - ' ' - blocks.to-str()
                    print(line)
                }
            }
        }

        -> {
            fi <- [0..files.len()): {
                f = files[fi]: {
                    ok -> it

                    -> ''
                }
                ! fs.is-file(f) -> {
                    io.errln('sum: ' - f - ': No such file or directory')
                    exit(1)
                }
                inp []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> inp = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = inp
                {
                    sysv -> {
                        checksum, blocks = calc-sysv(data)
                        line = checksum.to-str() - ' ' - blocks.to-str() - ' ' - f
                        print(line)
                    }

                    -> {
                        checksum, blocks = bsd(data)
                        line = checksum.to-str() - ' ' - blocks.to-str() - ' ' - f
                        print(line)
                    }
                }
            }
        }
    }
}

; bsd: BSD 校验和
; 每 2 字节（big-endian）累加到 16-bit，溢出回绕
; blocks = ceil(size / 1024)，最少 1
bsd = (data []byte) (checksum i64, blocks i64) {
    checksum = 0
    n = data.len()
    i = 0
    (i < n) {
        #{overflow=wrap}
        ip1 = i + 1: {
            ok -> it

            -> _
        }
        {
            ip1 < n -> {
                di = data[i]: {
                    ok -> it

                    -> _
                }
                dip1 = data[ip1]: {
                    ok -> it

                    -> _
                }
                #{overflow=wrap}
                hi = (di & 255) << 8: {
                    ok -> it

                    -> _
                }
                #{overflow=wrap}
                term = hi | (dip1 & 255): {
                    ok -> it

                    -> _
                }
                #{overflow=wrap}
                cs = checksum + term: {
                    ok -> it

                    -> _
                }
                checksum = cs & 0xffff
                #{overflow=wrap}
                i = i + 2: {
                    ok -> it

                    -> _
                }
            }
            i < n -> {
                di = data[i]: {
                    ok -> it

                    -> _
                }
                #{overflow=wrap}
                hi = (di & 255) << 8: {
                    ok -> it

                    -> _
                }
                #{overflow=wrap}
                cs = checksum + hi: {
                    ok -> it

                    -> _
                }
                checksum = cs & 0xffff

                #{overflow=wrap}
                i = i + 2: {
                    ok -> it

                    -> _
                }
            }
        }
    }

    #{overflow=wrap}
    np = n + 1023: {
        ok -> it

        -> _
    }
    blocks = np / 1024: {
        ok -> it

        -> _
    }
    blocks == 0 -> blocks = 1
}

; sysv: System V 校验和（macOS 实现）
; 每字节 16-bit 右旋后累加，mask 0xffff
; blocks = ceil(size / 1024)，空文件为 0
calc-sysv = (data []byte) (checksum i64, blocks i64) {
    checksum = 0
    n = data.len()
    i <- [0..n): {

        ; System V: 16-bit 右旋一位（lsb 回卷到 msb）后加字节
        low = checksum & 1
        #{overflow=wrap}
        sh = checksum >> 1: {
            ok -> it

            -> _
        }
        #{overflow=wrap}
        lsh = low << 15: {
            ok -> it

            -> _
        }
        rot = sh | lsh
        di = data[i]: {
            ok -> it

            -> _
        }
        #{overflow=wrap}
        sm = rot + (di & 255): {
            ok -> it

            -> _
        }
        checksum = sm & 0xffff
    }

    #{overflow=wrap}
    np = n + 1023: {
        ok -> it

        -> _
    }
    blocks = np / 1024: {
        ok -> it

        -> _
    }
}
