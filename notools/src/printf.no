// printf.no — printf utility
// POSIX printf(1): format and print arguments
// Usage: printf FORMAT [ARGS...]
//   Format specifiers: %s %d %i %x %X %o %c %% %f
//   Escape sequences:  \n \t \\ \r
//   If more args than specifiers, FORMAT is reused until args are exhausted.
//   If fewer args than specifiers, missing args are treated as empty/0.

// atoi: parse an integer (handles optional leading '-')
atoi = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    s.len > 0 -> {
        s[0] == 45 -> {
            neg = true
            start = 1
        }
    }
    i <- [start..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
    neg == true -> v = 0 - v
}

// int-to-hex-lower: convert i64 to lowercase hex string
int-to-hex-lower = (n i64) (out str) {
    n == 0 -> {
        out = '0'
        return
    }
    hex-chars = '0123456789abcdef'
    u = n
    u < 0 -> u = 0 - u
    out = ''
    for u > 0 {
        d = hex-chars[u & 15]
        out = number.char-to-str(d) - out
        u = u >> 4
    }
}

// int-to-hex-upper: convert i64 to uppercase hex string
int-to-hex-upper = (n i64) (out str) {
    n == 0 -> {
        out = '0'
        return
    }
    hex-chars = '0123456789ABCDEF'
    u = n
    u < 0 -> u = 0 - u
    out = ''
    for u > 0 {
        d = hex-chars[u & 15]
        out = number.char-to-str(d) - out
        u = u >> 4
    }
}

// int-to-octal: convert i64 to octal string
int-to-octal = (n i64) (out str) {
    n == 0 -> {
        out = '0'
        return
    }
    u = n
    u < 0 -> u = 0 - u
    out = ''
    for u > 0 {
        d = (u & 7) + 48
        out = number.char-to-str(d) - out
        u = u >> 3
    }
}

// emit: process FORMAT once, consuming args starting at arg-idx.
// Returns the output string, the next arg index, and whether any specifier
// (other than %%) was found.
emit = (fmt str, argc i64, arg-idx i64) (out str, next-idx i64, has-spec bool) {
    out = ''
    next-idx = arg-idx
    has-spec = false
    i = 0
    n = fmt.len
    {
        c = fmt[i]
        {
            c == 92 -> {
                // Escape sequence: \n \t \r \\ or \X (literal)
                i = i + 1
                i < n -> {
                    nc = fmt[i]
                    {
                        nc == 110 -> out = out - '\n'
                        nc == 116 -> out = out - '\t'
                        nc == 114 -> out = out - '\r'
                        nc == 92 -> out = out - '\\'
                        -> out = out - '\\' - number.char-to-str(nc)
                    }
                }
            }
            c == 37 -> {
                // Format specifier
                i = i + 1
                i < n -> {
                    spec = fmt[i]
                    {
                        spec == 37 -> {
                            // %% → literal percent
                            out = out - '%'
                        }
                        -> {
                            has-spec = true
                            // Fetch the next argument (empty string if none)
                            av = ''
                            next-idx < argc -> {
                                av = arg(next-idx)
                                next-idx = next-idx + 1
                            }
                            {
                                spec == 115 -> {
                                    // %s
                                    out = out - av
                                }
                                spec == 100 || spec == 105 -> {
                                    // %d or %i
                                    v = atoi(av)
                                    out = out - v.to-str()
                                }
                                spec == 120 -> {
                                    // %x (lowercase hex)
                                    v = atoi(av)
                                    out = out - int-to-hex-lower(v)
                                }
                                spec == 88 -> {
                                    // %X (uppercase hex)
                                    v = atoi(av)
                                    out = out - int-to-hex-upper(v)
                                }
                                spec == 111 -> {
                                    // %o (octal)
                                    v = atoi(av)
                                    out = out - int-to-octal(v)
                                }
                                spec == 99 -> {
                                    // %c (first character of arg)
                                    av.len > 0 -> out = out - av.slice(0, 1)
                                }
                                spec == 102 -> {
                                    // %f (simplified: output arg as-is)
                                    out = out - av
                                }
                                -> {
                                    // Unknown specifier: output %spec literally
                                    out = out - '%' - number.char-to-str(spec)
                                }
                            }
                        }
                    }
                }
            }
            -> {
                // Regular character
                out = out - number.char-to-str(c)
            }
        }
        i = i + 1
    } (i < n)
}

printf = () {
    argc = args()
    argc < 2 -> {
        eprint('printf: missing format string')
        os.exit(1)
    }
    fmt = arg(2)

    full-out = ''
    arg-idx = 3
    {
        iter-out, arg-idx, has-spec = emit(fmt, argc, arg-idx)
        full-out = full-out - iter-out
        // Stop if there were no specifiers (other than %%), or no more args.
        has-spec == false -> break
        arg-idx >= argc -> break
    } (true)
    io.out(full-out)
}
