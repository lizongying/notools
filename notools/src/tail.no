// tail.no — tail utility
// Output the last part of files
// Usage: tail [-n N] [-N] [file...]
//   -n N / -N: print the last N lines (default 10)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= "0" && c <= "9" -> v = v * 10 + (c - "0")
    }
}

tail-run = () {
    argc = args()
    n = 10
    files []str
    i <- [2..argc): {
        a = arg(i)
        prev = arg(i - 1)
        prev == '-n' -> { continue }
        a == '-n' -> { i + 1 < argc -> { n = atoi(arg(i + 1)) } }
        a.starts-with('-') -> { a != '-n' -> { a.len > 1 -> n = atoi(a.slice(1, a.len)) } }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        n < 0 -> n = 0
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            starts []i64
            starts.push(0)
            i <- [0..content.len): {
                content[i] == 10 -> {
                    ns = i + 1
                    ns < content.len -> starts.push(ns)
                }
            }
            skip = starts.len - n
            k <- [0..starts.len): {
                k >= skip -> {
                    end = content.len
                    nk = k + 1
                    nk < starts.len -> end = starts[nk]
                    io.out(content.slice(starts[k], end))
                }
            }
        }
        files.len > 0 -> {
            i <- [0..files.len): {
                fs.is-file(files[i]) == false -> {
                    io.errln('tail: ' - files[i] - ': No such file or directory')
                    continue
                }
                content = fs.read-file(files[i])
                starts []i64
                starts.push(0)
                j <- [0..content.len): {
                    content[j] == 10 -> {
                        ns = j + 1
                        ns < content.len -> starts.push(ns)
                    }
                }
                skip = starts.len - n
                k <- [0..starts.len): {
                    k >= skip -> {
                        end = content.len
                        nk = k + 1
                        nk < starts.len -> end = starts[nk]
                        io.out(content.slice(starts[k], end))
                    }
                }
            }
        }
    }
}
