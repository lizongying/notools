; tail.no — tail utility
; Output the last part of files
; Usage: tail [-n N] [-c N] [-N] [file...]
;   -n N / -N:  print the last N lines (default 10); -n -N drops the last N lines
;   -c N:       print the last N bytes;          -c -N drops the last N bytes

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len()): {
        c = s[i]

        #{overflow=wrap}
        c >= "0" && c <= "9" -> v = v * 10 + (c - "0")
    }
}

; atoi-signed parses an optionally negative decimal (e.g. "-3", "10").
atoi-signed = (s str) (v i64) {
    slen = s.len()
    neg = false
    off = 0
    {
        slen > 0 && s[0] == 45 -> {
            neg = true
            off = 1
        }

        -> {
        }
    }
    body = s.slice(off, slen)
    v = atoi(body)
    {
        neg -> {

            #{overflow=wrap}
            v = 0 - v: {
                ok -> it

                -> _
            }
        }

        -> {
        }
    }
}

; tail-last-lines: emit the last n lines of content raw (byte-exact slices).
; A negative n means "all lines except the last |n| lines".
tail-last-lines = (content str, n i64) {
    starts []i64
    starts.push(0)
    clen = content.len()
    li <- [0..clen): {
        {
            content[li] == 10 -> {

                #{overflow=wrap}
                ns = li + 1
                {
                    ns < clen -> starts.push(ns)

                    -> {
                    }
                }
            }

            -> {
            }
        }
    }
    total = starts.len()
    keep-from = 0
    {
        n >= 0 -> {

            #{overflow=wrap}
            keep-from = total - n: {
                ok -> it

                -> _
            }
            keep-from < 0 -> keep-from = 0
        }

        -> {

            #{overflow=wrap}
            abs-n = 0 - n: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            keep-from = total - abs-n: {
                ok -> it

                -> _
            }
            keep-from < 0 -> keep-from = 0
        }
    }
    k <- [0..total): {
        {
            k >= keep-from -> {
                end = clen

                #{overflow=wrap}
                nk = k + 1: {
                    ok -> it

                    -> _
                }

                ns = starts[nk]: {
                    ok -> it

                    -> _
                }
                {
                    nk < total -> end = ns

                    -> {
                    }
                }
                ss = starts[k]: {
                    ok -> it

                    -> _
                }
                io.out(content.slice(ss, end))
            }

            -> {
            }
        }
    }
}

; tail-last-bytes: emit bytes per BSD tail -c semantics.
;   cbytes > 0  -> the last cbytes bytes
;   cbytes == 0 -> nothing
;   cbytes < 0  -> the last |cbytes| bytes (BSD reverse offset)
tail-last-bytes = (content str, cbytes i64) {
    clen = content.len()
    start = clen
    {
        cbytes != 0 -> {
            abs-c = cbytes
            {
                cbytes < 0 -> {

                    #{overflow=wrap}
                    abs-c = 0 - cbytes: {
                        ok -> it

                        -> _
                    }
                }

                -> {
                }
            }

            #{overflow=wrap}
            start = clen - abs-c: {
                ok -> it

                -> _
            }
            start < 0 -> start = 0
        }

        -> {
        }
    }
    {
        clen > start -> {
            fd = fs.open-write('/dev/stdout')

            #{overflow=wrap}
            wlen = clen - start: {
                ok -> it

                -> _
            }
            fs.write(fd, content.slice-bytes(start, clen), wlen)
            fs.close(fd)
        }

        -> {
        }
    }
}

tail-run = () {
    argc = os.args().len()
    n = 10
    cbytes = -999999
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }

        #{overflow=wrap}
        prev-opt = os.arg(i - 1)
        prev = prev-opt: {
            ok -> it

            -> ''
        }
        {
            prev == '-n' || prev == '-c' -> {
                continue
            }

            -> {
            }
        }
        {
            a == '-n' -> {

                #{overflow=wrap}
                ni = i + 1: {
                    ok -> it

                    -> _
                }
                {
                    ni < argc -> {
                        aopt = os.arg(ni)
                        av = aopt: {
                            ok -> it

                            -> ''
                        }
                        n = atoi-signed(av)
                    }

                    -> {
                    }
                }
            }

            a == '-c' -> {

                #{overflow=wrap}
                ni = i + 1: {
                    ok -> it

                    -> _
                }
                {
                    ni < argc -> {
                        aopt = os.arg(ni)
                        av = aopt: {
                            ok -> it

                            -> ''
                        }
                        cbytes = atoi-signed(av)
                    }

                    -> {
                    }
                }
            }

            a.starts-with('-') -> {
                a != '-n' && a != '-c' -> {
                    alen = a.len()
                    {
                        alen > 2 && a[1] == 99 -> cbytes = atoi-signed(a.slice(2, alen))

                        -> {
                            alen > 1 -> n = atoi-signed(a.slice(1, alen))

                            -> {
                            }
                        }
                    }
                }

                -> {
                }
            }

            ! a.starts-with('-') -> files.push(a)

            -> {
            }
        }
    }
    byte-mode = cbytes != -999999
    {
        byte-mode -> {

            ; byte mode
            {
                files.len() == 0 -> {
                    content = ''
                    r = fs.read-stdin-str()
                    r: {
                        ok -> content = it

                        nil -> {
                        }

                        err -> {
                        }
                    }
                    tail-last-bytes(content, cbytes)
                }

                -> {
                    fi <- [0..files.len()): {
                        fp = files[fi]: {
                            ok -> it

                            -> ''
                        }
                        ! fs.is-file(fp) -> {
                            io.errln('tail: ' - fp - ': No such file or directory')
                            continue
                        }
                        {
                            files.len() > 1 -> {
                                {
                                    fi > 0 -> print('') -> {}
                                }
                                print('==> ' - fp - ' <==')
                            }

                            -> {
                            }
                        }
                        content = ''
                        r = fs.read-str(fp)
                        r: {
                            ok -> content = it

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        tail-last-bytes(content, cbytes)

                        ; byte mode: if emitted bytes lack a trailing newline, add one
                        {
                            cbytes > 0 -> {
                                clen = content.len()

                                #{overflow=wrap}
                                start = clen - cbytes
                                start < 0 -> start = 0
                                has-out = clen > start

                                #{overflow=wrap}
                                li = clen - 1: {
                                    ok -> it

                                    -> _
                                }
                                last-b = content[li]: {
                                    ok -> it

                                    -> _
                                }
                                ends-nl = has-out && last-b == 10
                                {
                                    ! ends-nl -> print('')

                                    -> {
                                    }
                                }
                            }

                            -> {
                            }
                        }
                    }
                }
            }
        }

        -> {

            ; line mode
            {
                files.len() == 0 -> {
                    content = ''
                    r = fs.read-stdin-str()
                    r: {
                        ok -> content = it

                        nil -> {
                        }

                        err -> {
                        }
                    }
                    tail-last-lines(content, n)
                }

                -> {
                    fi <- [0..files.len()): {
                        fp = files[fi]: {
                            ok -> it

                            -> ''
                        }
                        ! fs.is-file(fp) -> {
                            io.errln('tail: ' - fp - ': No such file or directory')
                            continue
                        }
                        {
                            files.len() > 1 -> {
                                {
                                    fi > 0 -> print('') -> {}
                                }
                                print('==> ' - fp - ' <==')
                            }

                            -> {
                            }
                        }
                        content = ''
                        r = fs.read-str(fp)
                        r: {
                            ok -> content = it

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        tail-last-lines(content, n)
                    }
                }
            }
        }
    }
}
