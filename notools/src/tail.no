; tail.no — tail utility
; Output the last part of files
; Usage: tail [-n N] [-N] [file...]
;   -n N / -N: print the last N lines (default 10)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len-bytes()): {
        c = s[i]
        #{overflow=wrap}
        c >= "0" && c <= "9" -> v = v * 10 + (c - "0")
    }
}

tail-run = () {
    argc = args()
    n = 10
    files []str
    i <- [2..argc): {
        a = arg(i)
        #{overflow=wrap}
        prev = arg(i - 1)
        prev == '-n' -> {
            continue
        }
        a == '-n' -> {
            #{overflow=wrap}
            i + 1 < argc -> {
                #{overflow=wrap}
                n = atoi(arg(i + 1))
            }
        }
        a.starts-with('-') -> {
            a != '-n' -> {
                a.len-bytes() > 1 -> n = atoi(a.slice(1, a.len-bytes()))
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        n < 0 -> n = 0

        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it
                nil -> {
                }
                err -> {
                }
            }
            starts []i64
            starts.push(0)
            i <- [0..content.len-bytes()): {
                content[i] == 10 -> {
                    #{overflow=wrap}
                    ns = i + 1
                    ns < content.len-bytes() -> starts.push(ns)
                }
            }
            #{overflow=wrap}
            skip = starts.len() - n
            k <- [0..starts.len()): {
                k >= skip -> {
                    end = content.len-bytes()
                    #{overflow=wrap}
                    nk = k + 1
                    nk < starts.len() -> end = starts[nk]
                    io.out(content.slice(starts[k], end))
                }
            }
        }

        files.len() > 0 -> {
            i <- [0..files.len()): {
                fs.is-file(files[i]) == false -> {
                    #{overflow=wrap}
                    io.errln('tail: ' - files[i] - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(files[i])
                r: {
                    ok -> content = it
                    nil -> {
                    }
                    err -> {
                    }
                }
                starts []i64
                starts.push(0)
                j <- [0..content.len-bytes()): {
                    content[j] == 10 -> {
                        #{overflow=wrap}
                        ns = j + 1
                        ns < content.len-bytes() -> starts.push(ns)
                    }
                }
                #{overflow=wrap}
                skip = starts.len() - n
                k <- [0..starts.len()): {
                    k >= skip -> {
                        end = content.len-bytes()
                        #{overflow=wrap}
                        nk = k + 1
                        nk < starts.len() -> end = starts[nk]
                        io.out(content.slice(starts[k], end))
                    }
                }
            }
        }
    }
}
