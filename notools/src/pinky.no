; pinky.no — pinky utility
; Lightweight who: display user information
; Usage: pinky [-l] [USER]
;   no args: show current user info (lightweight format)
;   -l: long format (login name, terminal, idle, real name)
;   USER: show info for specified user

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
pinky-cmd = () {
    argc = args()
    long-format = false
    target-user = ''
    i <- [2..argc): {
        a = arg(i)
        a == '-l' -> long-format = true
        a == '-f' -> {}
        a.starts-with('-') && a.len > 1 -> {}

        -> target-user = a
    }
    {
        target-user.len == 0 -> {
            target-user = os.get-login()
            target-user.len == 0 -> target-user = os.get-env('USER')
        }

        long-format -> {

            ; Long format: Login  Name  TTY  Idle  When  Where
            term = os.ttyname(0)
            term.len == 0 -> term = '*'
            print('Login name: ' - target-user - '  In real life: ?')
            print('  On since unknown from ' - term)
            return
        }
    }

    ; Default (lightweight): single line
    ; Format: Login    Name    TTY    Idle   When    Where
    term = os.ttyname(0)
    term.len == 0 -> term = '?'
    ; Print header
    print('Login    TTY             When')
    print(target-user - '  ' - term - '  ' - 'unknown')
}

#{win-amd64, win-arm64}
pinky-cmd = () {
    eprint('pinky-cmd: not supported on this platform')
    os.exit(1)
}
