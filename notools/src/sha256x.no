; sha256x: 完整 SHA-256 雜湊，void 函式直接印出 64 字元 hex
sha256x = (data []byte) {
    h0 = 1779033703
    h1 = 3144134277
    h2 = 1013904242
    h3 = 2773480762
    h4 = 1359893119
    h5 = 2600822924
    h6 = 528734635
    h7 = 1541459225
    mask u32 = 4294967295
    dlen = data.len
    bit-len = dlen * 8
    mod-val = (dlen + 9) % 64
    pad-len = 0
    mod-val != 0 -> pad-len = 64 - mod-val
    total-len = dlen + 1 + pad-len + 8
    padded []byte = with-len(total-len)
    i <- [0..total-len): { padded[i] = 0 }
    i <- [0..dlen): { padded[i] = data[i] }
    padded[dlen] = 128
    i <- [dlen + 1..total-len - 8): { padded[i] = 0 }
    i <- [0..8): { padded[total-len - 8 + i] = (bit-len >> (56 - i * 8)) & 255 }
    k []u32 = with-len(256)
    k[0] = 1116352408
    k[1] = 1899447441
    k[2] = 3049323471
    k[3] = 3921009573
    k[4] = 961987163
    k[5] = 1508970993
    k[6] = 2453635748
    k[7] = 2870763221
    k[8] = 3624381080
    k[9] = 310598401
    k[10] = 607225278
    k[11] = 1426881987
    k[12] = 1925078388
    k[13] = 2162078206
    k[14] = 2614888103
    k[15] = 3248222580
    k[16] = 3835390401
    k[17] = 4022224774
    k[18] = 264347078
    k[19] = 604807628
    k[20] = 770255983
    k[21] = 1249150122
    k[22] = 1555081692
    k[23] = 1996064986
    k[24] = 2554220882
    k[25] = 2821834349
    k[26] = 2952996808
    k[27] = 3210313671
    k[28] = 3336571891
    k[29] = 3584528711
    k[30] = 113926993
    k[31] = 338241895
    k[32] = 666307205
    k[33] = 773529912
    k[34] = 1294757372
    k[35] = 1396182291
    k[36] = 1695183700
    k[37] = 1986661051
    k[38] = 2177026350
    k[39] = 2456956037
    k[40] = 2730485921
    k[41] = 2820302411
    k[42] = 3259730800
    k[43] = 3345764771
    k[44] = 3516065817
    k[45] = 3600352804
    k[46] = 4094571909
    k[47] = 275423344
    k[48] = 430227734
    k[49] = 506948616
    k[50] = 659060556
    k[51] = 883997877
    k[52] = 958139571
    k[53] = 1322822218
    k[54] = 1537002063
    k[55] = 1747873779
    k[56] = 1955562222
    k[57] = 2024104815
    k[58] = 2227730452
    k[59] = 2361852424
    k[60] = 2428436474
    k[61] = 2756734187
    k[62] = 3204031479
    k[63] = 3329325298
    w []u32 = with-len(256)
    offset = 0
    {
        i <- [0..16): { w[i] = (padded[offset + i * 4] << 24) | (padded[offset + i * 4 + 1] << 16) | (padded[offset + i * 4 + 2] << 8) | padded[offset + i * 4 + 3] }
        i <- [16..64): {
            s0r7 = ((w[i - 15] >> 7) | (w[i - 15] << 25)) & mask
            s0r18 = ((w[i - 15] >> 18) | (w[i - 15] << 14)) & mask
            s0sh3 = w[i - 15] >> 3
            s0v = s0r7 ^ s0r18 ^ s0sh3
            s1r17 = ((w[i - 2] >> 17) | (w[i - 2] << 15)) & mask
            s1r19 = ((w[i - 2] >> 19) | (w[i - 2] << 13)) & mask
            s1sh10 = w[i - 2] >> 10
            s1v = s1r17 ^ s1r19 ^ s1sh10
            w[i] = (w[i - 16] + s0v + w[i - 7] + s1v) & mask
        }
        a u32 = h0
        b u32 = h1
        c u32 = h2
        d u32 = h3
        e u32 = h4
        f u32 = h5
        g u32 = h6
        hh u32 = h7
        i <- [0..64): {
            s1 = ((e >> 6) | (e << 26)) & mask
            s1 = s1 ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))
            ch = (e & f) ^ ((mask ^ e) & g)
            t1 = (hh + s1 + ch + k[i] + w[i]) & mask
            s0 = ((a >> 2) | (a << 30)) & mask
            s0 = s0 ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))
            maj = (a & b) ^ (a & c) ^ (b & c)
            t2 = (s0 + maj) & mask
            hh = g
            g = f
            f = e
            e = (d + t1) & mask
            d = c
            c = b
            b = a
            a = (t1 + t2) & mask
        }
        h0 = (h0 + a) & mask
        h1 = (h1 + b) & mask
        h2 = (h2 + c) & mask
        h3 = (h3 + d) & mask
        h4 = (h4 + e) & mask
        h5 = (h5 + f) & mask
        h6 = (h6 + g) & mask
        h7 = (h7 + hh) & mask
        offset = offset + 64
    } (offset < total-len)
    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(64)
    hex[0] = hex-chars[(h0 >> 28) & 15]
    hex[1] = hex-chars[(h0 >> 24) & 15]
    hex[2] = hex-chars[(h0 >> 20) & 15]
    hex[3] = hex-chars[(h0 >> 16) & 15]
    hex[4] = hex-chars[(h0 >> 12) & 15]
    hex[5] = hex-chars[(h0 >> 8) & 15]
    hex[6] = hex-chars[(h0 >> 4) & 15]
    hex[7] = hex-chars[(h0 >> 0) & 15]
    hex[8] = hex-chars[(h1 >> 28) & 15]
    hex[9] = hex-chars[(h1 >> 24) & 15]
    hex[10] = hex-chars[(h1 >> 20) & 15]
    hex[11] = hex-chars[(h1 >> 16) & 15]
    hex[12] = hex-chars[(h1 >> 12) & 15]
    hex[13] = hex-chars[(h1 >> 8) & 15]
    hex[14] = hex-chars[(h1 >> 4) & 15]
    hex[15] = hex-chars[(h1 >> 0) & 15]
    hex[16] = hex-chars[(h2 >> 28) & 15]
    hex[17] = hex-chars[(h2 >> 24) & 15]
    hex[18] = hex-chars[(h2 >> 20) & 15]
    hex[19] = hex-chars[(h2 >> 16) & 15]
    hex[20] = hex-chars[(h2 >> 12) & 15]
    hex[21] = hex-chars[(h2 >> 8) & 15]
    hex[22] = hex-chars[(h2 >> 4) & 15]
    hex[23] = hex-chars[(h2 >> 0) & 15]
    hex[24] = hex-chars[(h3 >> 28) & 15]
    hex[25] = hex-chars[(h3 >> 24) & 15]
    hex[26] = hex-chars[(h3 >> 20) & 15]
    hex[27] = hex-chars[(h3 >> 16) & 15]
    hex[28] = hex-chars[(h3 >> 12) & 15]
    hex[29] = hex-chars[(h3 >> 8) & 15]
    hex[30] = hex-chars[(h3 >> 4) & 15]
    hex[31] = hex-chars[(h3 >> 0) & 15]
    hex[32] = hex-chars[(h4 >> 28) & 15]
    hex[33] = hex-chars[(h4 >> 24) & 15]
    hex[34] = hex-chars[(h4 >> 20) & 15]
    hex[35] = hex-chars[(h4 >> 16) & 15]
    hex[36] = hex-chars[(h4 >> 12) & 15]
    hex[37] = hex-chars[(h4 >> 8) & 15]
    hex[38] = hex-chars[(h4 >> 4) & 15]
    hex[39] = hex-chars[(h4 >> 0) & 15]
    hex[40] = hex-chars[(h5 >> 28) & 15]
    hex[41] = hex-chars[(h5 >> 24) & 15]
    hex[42] = hex-chars[(h5 >> 20) & 15]
    hex[43] = hex-chars[(h5 >> 16) & 15]
    hex[44] = hex-chars[(h5 >> 12) & 15]
    hex[45] = hex-chars[(h5 >> 8) & 15]
    hex[46] = hex-chars[(h5 >> 4) & 15]
    hex[47] = hex-chars[(h5 >> 0) & 15]
    hex[48] = hex-chars[(h6 >> 28) & 15]
    hex[49] = hex-chars[(h6 >> 24) & 15]
    hex[50] = hex-chars[(h6 >> 20) & 15]
    hex[51] = hex-chars[(h6 >> 16) & 15]
    hex[52] = hex-chars[(h6 >> 12) & 15]
    hex[53] = hex-chars[(h6 >> 8) & 15]
    hex[54] = hex-chars[(h6 >> 4) & 15]
    hex[55] = hex-chars[(h6 >> 0) & 15]
    hex[56] = hex-chars[(h7 >> 28) & 15]
    hex[57] = hex-chars[(h7 >> 24) & 15]
    hex[58] = hex-chars[(h7 >> 20) & 15]
    hex[59] = hex-chars[(h7 >> 16) & 15]
    hex[60] = hex-chars[(h7 >> 12) & 15]
    hex[61] = hex-chars[(h7 >> 8) & 15]
    hex[62] = hex-chars[(h7 >> 4) & 15]
    hex[63] = hex-chars[(h7 >> 0) & 15]
    print(hex)
}
