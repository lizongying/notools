; sha256x: 完整 SHA-256 雜湊，返回 64 字元 hex 字串
sha256x = (data []byte) (hex str) {
    h0 u32 = 1779033703
    h1 u32 = 3144134277
    h2 u32 = 1013904242
    h3 u32 = 2773480762
    h4 u32 = 1359893119
    h5 u32 = 2600822924
    h6 u32 = 528734635
    h7 u32 = 1541459225
    mask u32 = 4294967295
    dlen = data.len()

    #{overflow=wrap}
    bit-len = dlen * 8
    mod-val = (dlen + 9) % 64
    pad-len = 0

    #{overflow=wrap}
    mod-val != 0 -> pad-len = 64 - mod-val

    #{overflow=wrap}
    total-len = dlen + 1 + pad-len + 8
    padded []byte = with-len(total-len)
    i <- [0..total-len): {
        padded[i]: {
            ok -> it = 0

            -> _
        }
    }
    i <- [0..dlen): {
        d9v1 byte = data[i]: {
            ok -> it

            -> 0
        }
        padded[i]: {
            ok -> it = d9v1

            -> _
        }
    }
    padded[dlen]: {
        ok -> it = 128

        -> _
    }
    i <- [dlen + 1..total-len - 8): {
        padded[i]: {
            ok -> it = 0

            -> _
        }
    }
    i <- [0..8): {

        #{overflow=wrap}
        padded[total-len - 8 + i]: {
            ok -> it = (bit-len >> (56 - i * 8)) & 255

            -> _
        }
    }
    k []u32 = [
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298,
    ]
    w []u32 = with-len(256)
    offset = 0
    (offset < total-len) {
        i <- [0..16): {
            d9v2 byte = padded[offset + i * 4]: {
                ok -> it

                -> 0
            }
            d9v3 byte = padded[offset + i * 4 + 1]: {
                ok -> it

                -> 0
            }
            d9v4 byte = padded[offset + i * 4 + 2]: {
                ok -> it

                -> 0
            }
            d9v5 byte = padded[offset + i * 4 + 3]: {
                ok -> it

                -> 0
            }
            w[i]: {
                ok -> it = (d9v2 << 24) | (d9v3 << 16) | (d9v4 << 8) | d9v5

                -> _
            }
        }
        i <- [16..64): {
            w15 u32 = w[i - 15]: {
                ok -> it

                -> 0
            }
            w2 u32 = w[i - 2]: {
                ok -> it

                -> 0
            }
            s0v = (math.rotate-left(w15, 25) ^ math.rotate-left(w15, 14) ^ (w15 >> 3)) & mask
            s1v = (math.rotate-left(w2, 15) ^ math.rotate-left(w2, 13) ^ (w2 >> 10)) & mask

            d9v6 u32 = w[i - 16]: {
                ok -> it

                -> 0
            }
            d9v7 u32 = w[i - 7]: {
                ok -> it

                -> 0
            }
            w[i]: {
                ok -> it = (d9v6 + s0v + d9v7 + s1v) & mask

                -> _
            }
        }
        a u32 = h0
        b u32 = h1
        c u32 = h2
        d u32 = h3
        e u32 = h4
        f u32 = h5
        g u32 = h6
        hh u32 = h7
        i <- [0..64): {
            s1 = math.rotate-left(e, 26) & mask
            s1 = s1 ^ math.rotate-left(e, 21) ^ math.rotate-left(e, 7)
            ch = (e & f) ^ ((mask ^ e) & g)
            ki u32 = k[i]: {
                ok -> it

                -> 0
            }
            wi u32 = w[i]: {
                ok -> it

                -> 0
            }
            t1 = (hh + s1 + ch + ki + wi) & mask
            s0 = math.rotate-left(a, 30) & mask
            s0 = s0 ^ math.rotate-left(a, 19) ^ math.rotate-left(a, 10)
            maj = (a & b) ^ (a & c) ^ (b & c)
            t2 = (s0 + maj) & mask
            hh = g
            g = f
            f = e
            e = (d + t1) & mask
            d = c
            c = b
            b = a
            a = (t1 + t2) & mask
        }
        h0 = (h0 + a) & mask
        h1 = (h1 + b) & mask
        h2 = (h2 + c) & mask
        h3 = (h3 + d) & mask
        h4 = (h4 + e) & mask
        h5 = (h5 + f) & mask
        h6 = (h6 + g) & mask
        h7 = (h7 + hh) & mask

        offset = offset + 64: {
            ok -> it

            -> _
        } #{overflow=wrap}
    }
    hex-chars = '0123456789abcdef'
    space = ' '
    hex = space.repeat(64)

    d9v8 str = hex-chars[(h0 >> 28) & 15]
    hex[0]: {
        ok -> it = d9v8

        -> _
    }

    d9v9 str = hex-chars[(h0 >> 24) & 15]
    hex[1]: {
        ok -> it = d9v9

        -> _
    }

    d9v10 str = hex-chars[(h0 >> 20) & 15]
    hex[2]: {
        ok -> it = d9v10

        -> _
    }

    d9v11 str = hex-chars[(h0 >> 16) & 15]
    hex[3]: {
        ok -> it = d9v11

        -> _
    }

    d9v12 str = hex-chars[(h0 >> 12) & 15]
    hex[4]: {
        ok -> it = d9v12

        -> _
    }

    d9v13 str = hex-chars[(h0 >> 8) & 15]
    hex[5]: {
        ok -> it = d9v13

        -> _
    }

    d9v14 str = hex-chars[(h0 >> 4) & 15]
    hex[6]: {
        ok -> it = d9v14

        -> _
    }

    d9v15 str = hex-chars[(h0 >> 0) & 15]
    hex[7]: {
        ok -> it = d9v15

        -> _
    }

    d9v16 str = hex-chars[(h1 >> 28) & 15]
    hex[8]: {
        ok -> it = d9v16

        -> _
    }

    d9v17 str = hex-chars[(h1 >> 24) & 15]
    hex[9]: {
        ok -> it = d9v17

        -> _
    }

    d9v18 str = hex-chars[(h1 >> 20) & 15]
    hex[10]: {
        ok -> it = d9v18

        -> _
    }

    d9v19 str = hex-chars[(h1 >> 16) & 15]
    hex[11]: {
        ok -> it = d9v19

        -> _
    }

    d9v20 str = hex-chars[(h1 >> 12) & 15]
    hex[12]: {
        ok -> it = d9v20

        -> _
    }

    d9v21 str = hex-chars[(h1 >> 8) & 15]
    hex[13]: {
        ok -> it = d9v21

        -> _
    }

    d9v22 str = hex-chars[(h1 >> 4) & 15]
    hex[14]: {
        ok -> it = d9v22

        -> _
    }

    d9v23 str = hex-chars[(h1 >> 0) & 15]
    hex[15]: {
        ok -> it = d9v23

        -> _
    }

    d9v24 str = hex-chars[(h2 >> 28) & 15]
    hex[16]: {
        ok -> it = d9v24

        -> _
    }

    d9v25 str = hex-chars[(h2 >> 24) & 15]
    hex[17]: {
        ok -> it = d9v25

        -> _
    }

    d9v26 str = hex-chars[(h2 >> 20) & 15]
    hex[18]: {
        ok -> it = d9v26

        -> _
    }

    d9v27 str = hex-chars[(h2 >> 16) & 15]
    hex[19]: {
        ok -> it = d9v27

        -> _
    }

    d9v28 str = hex-chars[(h2 >> 12) & 15]
    hex[20]: {
        ok -> it = d9v28

        -> _
    }

    d9v29 str = hex-chars[(h2 >> 8) & 15]
    hex[21]: {
        ok -> it = d9v29

        -> _
    }

    d9v30 str = hex-chars[(h2 >> 4) & 15]
    hex[22]: {
        ok -> it = d9v30

        -> _
    }

    d9v31 str = hex-chars[(h2 >> 0) & 15]
    hex[23]: {
        ok -> it = d9v31

        -> _
    }

    d9v32 str = hex-chars[(h3 >> 28) & 15]
    hex[24]: {
        ok -> it = d9v32

        -> _
    }

    d9v33 str = hex-chars[(h3 >> 24) & 15]
    hex[25]: {
        ok -> it = d9v33

        -> _
