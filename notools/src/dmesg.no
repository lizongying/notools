; dmesg.no — dmesg utility
; 顯示核心訊息緩衝區。嘗試讀取 /dev/kmsg、/proc/kmsg 或 /var/log/dmesg。
; Usage: dmesg

dmesg = () {

    ; 嘗試 /dev/kmsg（Linux 核心 3.5+）
    {
        fs.is-file('/dev/kmsg') -> {
            content = ''
            r = fs.read-str('/dev/kmsg')
            r: {
                ok -> content = it
                nil -> {
                }
                err -> {
                }
            }
            io.out(content)
            return
        }

        ; 嘗試 /proc/kmsg
        fs.is-file('/proc/kmsg') -> {
            content = ''
            r = fs.read-str('/proc/kmsg')
            r: {
                ok -> content = it
                nil -> {
                }
                err -> {
                }
            }
            io.out(content)
            return
        }

        ; 嘗試 /var/log/dmesg
        fs.is-file('/var/log/dmesg') -> {
            content = ''
            r = fs.read-str('/var/log/dmesg')
            r: {
                ok -> content = it
                nil -> {
                }
                err -> {
                }
            }
            io.out(content)
            return
        }

        ; 嘗試 /var/log/messages
        fs.is-file('/var/log/messages') -> {
            content = ''
            r = fs.read-str('/var/log/messages')
            r: {
                ok -> content = it
                nil -> {
                }
                err -> {
                }
            }
            io.out(content)
            return
        }
    }

    eprint('dmesg: cannot access kernel log (need /dev/kmsg, /proc/kmsg or /var/log/dmesg)')
    os.exit(1)
}
