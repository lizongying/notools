; getopt.no — getopt utility
; Parse command options (simplified, short options only)
; Usage: getopt OPTSTRING ARGS...
;   OPTSTRING like "ab:c:" — 'a' is a flag, 'b'/'c' take arguments.
;   Output: parsed options followed by '--' then remaining (non-option) args.
;   Each option/argument is printed on its own line for easy shell consumption.
;   Exit 0 on success, 1 on usage error, 2 on missing option argument.

getopt = () {
    argc = args()

    {
        argc < 3 -> {
            eprint('Usage: getopt OPTSTRING ARGS...')
            os.exit(1)
        }
    }

    optstring = arg(2)

    ; takes-arg[c] = true if option char c requires an argument
    takes-arg []bool = with-len(256)
    i <- [0..256): takes-arg[i] = false
    i <- [0..optstring.len-bytes()): {
        c = optstring[i]

        #{overflow=wrap}
        c == 58 && i > 0 -> takes-arg[optstring[i - 1]] = true
    }

    opts-out []str
    non-opts []str

    i = 3
    done-opts = false

    (i < argc) {
        a = arg(i)

        {
            done-opts -> {
                non-opts.push(a)

                #{overflow=wrap}
                i = i + 1
                continue
            }

            a == '--' -> {
                done-opts = true
                #{overflow=wrap}
                i = i + 1
                continue
            }

            ; lone "-" is a non-option
            a == '-' -> {
                non-opts.push(a)
                #{overflow=wrap}
                i = i + 1
                continue
            }

            a.starts-with('-') -> {

                ; parse short-option cluster: -abc, -bVALUE, -b VALUE
                j = 1
                (j < a.len-bytes()) {
                    c = a[j]
                    cstr = number.char-to-str(c)
                    #{overflow=wrap}
                    opt-str = '-' - cstr

                    {
                        takes-arg[c] -> {

                            ; option requires an argument
                            #{overflow=wrap}
                            rest = a.slice(j + 1, a.len-bytes())
                            rest.len() > 0 -> {
                                opts-out.push(opt-str)
                                opts-out.push(rest)
                                j = a.len-bytes()
                            }
                            rest.len() == 0 -> {

                                ; argument is the next argv element
                                #{overflow=wrap}
                                next-idx = i + 1
                                next-idx >= argc -> {
                                    #{overflow=wrap}
                                    eprint('getopt: option requires an argument -- ' - cstr)
                                    os.exit(2)
                                }
                                opts-out.push(opt-str)
                                opts-out.push(arg(next-idx))
                                i = next-idx
                                j = a.len-bytes()
                            }
                        }

                        -> {

                            ; flag option (no argument)
                            opts-out.push(opt-str)
                            #{overflow=wrap}
                            j = j + 1
                        }
                    }
                }
                #{overflow=wrap}
                i = i + 1
                continue
            }
        }

        ; non-option arg
        non-opts.push(a)

        #{overflow=wrap}
        i = i + 1
    }

    ; Emit one token per line: options, then "--", then non-options.
    i <- [0..opts-out.len()): print(opts-out[i])
    print('--')
    i <- [0..non-opts.len()): print(non-opts[i])
}
