; getopt.no — getopt utility
; Parse command options (simplified, short options only)
; Usage: getopt OPTSTRING ARGS...
;   OPTSTRING like "ab:c:" — 'a' is a flag, 'b'/'c' take arguments.
;   Output: parsed options followed by '--' then remaining (non-option) args.
;   Each option/argument is printed on its own line for easy shell consumption.
;   Exit 0 on success, 1 on usage error, 2 on missing option argument.

getopt = () {
    argc = os.args().len()

    {
        argc < 3 -> {
            eprint('Usage: getopt OPTSTRING ARGS...')
            exit(1)
        }
    }

    optstring-opt = os.arg(2)
    optstring = optstring-opt: {
        ok -> it

        -> ''
    }

    ; takes-arg[c] = true if option char c requires an argument
    takes-arg []bool = with-len(256)
    i <- [0..256): {
        takes-arg[i]: {
            ok -> it = false

            -> _
        }
    }
    i <- [0..optstring.len()): {
        c = optstring[i]

        #{overflow=wrap}
        c == 58 && i > 0 -> {
            takes-arg[optstring[i - 1]]: {
                ok -> it = true

                -> _
            }
        }
    }

    opts-out []str
    non-opts []str

    i = 3
    done-opts = false

    (i < argc) {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }

        {
            done-opts -> {
                non-opts.push(a)

                #{overflow=wrap}
                i = i + 1: {
                    ok -> it

                    -> _
                }
                continue
            }

            a == '--' -> {
                done-opts = true

                #{overflow=wrap}
                i = i + 1: {
                    ok -> it

                    -> _
                }
                continue
            }

            ; lone "-" is a non-option
            a == '-' -> {
                non-opts.push(a)

                #{overflow=wrap}
                i = i + 1: {
                    ok -> it

                    -> _
                }
                continue
            }

            a.starts-with('-') -> {

                ; parse short-option cluster: -abc, -bVALUE, -b VALUE
                j = 1
                rest-start i64 = 0
                (j < a.len()) {
                    c = a[j]
                    cstr = c.to-str()
                    opt-str = '-' - cstr

                    ta = takes-arg[c]: {
                        ok -> it

                        -> false
                    }
                    {
                        ta -> {

                            ; option requires an argument
                            #{overflow=wrap}
                            rest-start = j + 1: {
                                ok -> it

                                -> _
                            }
                            rest = a.slice(rest-start, a.len())
                            rest.len() > 0 -> {
                                opts-out.push(opt-str)
                                opts-out.push(rest)
                                j = a.len()
                            }
                            rest.len() == 0 -> {
                                next-idx i64 = 0

                                ; argument is the next argv element
                                #{overflow=wrap}
                                next-idx = i + 1: {
                                    ok -> it

                                    -> _
                                }
                                next-idx >= argc -> {
                                    eprint('getopt: option requires an argument -- ' - cstr)
                                    exit(2)
                                }
                                opts-out.push(opt-str)
                                oa = os.arg(next-idx): {
                                    ok -> it

                                    -> ''
                                }
                                opts-out.push(oa)
                                i = next-idx
                                j = a.len()
                            }
                        }

                        -> {

                            ; flag option (no argument)
                            opts-out.push(opt-str)

                            #{overflow=wrap}
                            j = j + 1: {
                                ok -> it

                                -> _
                            }
                        }
                    }
                }

                #{overflow=wrap}
                i = i + 1: {
                    ok -> it

                    -> _
                }
                continue
            }
        }

        ; non-option arg
        non-opts.push(a)

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }

    ; Emit one token per line: options, then "--", then non-options.
    i <- [0..opts-out.len()): {
        ot = opts-out[i]: {
            ok -> it

            -> ''
        }
        print(ot)
    }
    print('--')
    i <- [0..non-opts.len()): {
        nv = non-opts[i]: {
            ok -> it

            -> ''
        }
        print(nv)
    }
}
