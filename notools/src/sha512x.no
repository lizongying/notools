; sha512x: 完整 SHA-512 雜湊，返回 128 字元 hex 字串
sha512x = (data []byte) (hex str) {
    m u64 = 18446744073709551615
    h0 u64 = 7640891576956012808
    h1 u64 = 13503953896175478587
    h2 u64 = 4354685564936845355
    h3 u64 = 11912009170470909681
    h4 u64 = 5840696475078001361
    h5 u64 = 11170449401992604703
    h6 u64 = 2270897969802886507
    h7 u64 = 6620516959819538809
    dlen = data.len()

    #{overflow=wrap}
    bit-len = dlen * 8
    mod-val = (dlen + 17) % 128
    pad-len = 0

    #{overflow=wrap}
    mod-val != 0 -> pad-len = 128 - mod-val

    #{overflow=wrap}
    total-len = dlen + 1 + pad-len + 16
    padded []byte = with-len(total-len)
    i <- [0..total-len): {
        padded[i]: {
            ok -> it = 0
            -> _
        }
    }
    i <- [0..dlen): {

        #{index-out=zero}
        d9v1 byte = data[i]
        #{index-out=zero}
        padded[i]: {
            ok -> it = d9v1
            -> _
        }
    }
    padded[dlen]: {
        ok -> it = 128
        -> _
    }
    i <- [dlen + 1..total-len - 16): {
        padded[i]: {
            ok -> it = 0
            -> _
        }
    }
    i <- [0..8): {

        #{overflow=wrap}
        padded[total-len - 8 + i]: {
            ok -> it = (bit-len >> (56 - i * 8)) & 255
            -> _
        }
    }
    k []u64 = [
        4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156, 4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976,
        15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146, 8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548,
