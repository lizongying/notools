; dir-cmd.no — dir utility
; List directory contents (one entry per line)
; Usage: dir [PATH...]

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
dir-run = () {
    argc = os.args().len()
    paths []str
    i <- [2..argc): {
        pa = os.arg(i): {
            ok -> it

            -> ''
        }
        paths.push(pa)
    }
    paths.len() == 0 -> paths.push('.')
    i <- [0..paths.len()): {

        p = paths[i]: {
            ok -> it

            -> ''
        }
        fs.is-dir(p) -> {
            entries = fs.list-dir(p)
            j <- [0..entries.len()): {
                ent = entries[j]: {
                    ok -> it

                    -> ''
                }
                print(ent)
            }
        }
        ! fs.is-dir(p) -> print(p)
    }
}

#{win-amd64, win-arm64}
dir-run = () {
    eprint('dir-run: not supported on this platform')
    exit(1)
}
