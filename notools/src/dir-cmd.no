// dir-cmd.no — dir utility
// List directory contents (one entry per line)
// Usage: dir [PATH...]

dir-run = () {
    argc = args()
    paths []str
    i <- [2..argc): {
        paths.push(arg(i))
    }
    paths.len == 0 -> paths.push('.')
    i <- [0..paths.len): {
        p = paths[i]
        fs.is-dir(p) -> {
            entries = fs.list-dir(p)
            j <- [0..entries.len): {
                print(entries[j])
            }
        }
        fs.is-dir(p) == false -> print(p)
    }
}
