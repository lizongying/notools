; dir-cmd.no — dir utility
; List directory contents (one entry per line)
; Usage: dir [PATH...]

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
dir-run = () {
    argc = os.args()
    paths []str
    i <- [2..argc): {
        paths.push(os.arg(i))
    }
    paths.len() == 0 -> paths.push('.')
    i <- [0..paths.len()): {

        #{index-out=zero}
        p = paths[i]
        fs.is-dir(p) -> {
            entries = fs.list-dir(p)
            j <- [0..entries.len()): {
                print(entries[j])
            }
        }
        ! fs.is-dir(p) -> print(p)
    }
}

#{win-amd64, win-arm64}
dir-run = () {
    eprint('dir-run: not supported on this platform')
    os.exit(1)
}
