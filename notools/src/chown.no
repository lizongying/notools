// chown.no — chown utility
// Change file owner and group
// Usage: chown <uid:gid|uid|:gid> <file...>
//   uid:gid — change both owner and group
//   uid     — change only owner (group unchanged)
//   :gid    — change only group (owner unchanged)
//   uid and gid are numeric (decimal integers)

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
chown-run = () {
    argc = args()

    argc < 3 -> {
        print('Usage: chown <uid:gid|uid|:gid> <file...>')
        os.exit(1)
    }

    owner-str = arg(2)

    // Find first colon separator
    colon-pos = -1
    i <- [0..owner-str.len): {
        colon-pos < 0 -> {
            owner-str[i] == ':' -> colon-pos = i
        }
    }

    uid = -1
    gid = -1

    colon-pos < 0 -> {
        // No colon: whole string is uid
        uid = 0
        i <- [0..owner-str.len): {
            c = owner-str[i]
            uid = uid * 10 + (c - '0')
        }
    }
    colon-pos >= 0 -> {
        // Has colon: parse uid part [0..colon-pos)
        colon-pos > 0 -> {
            uid = 0
            i <- [0..colon-pos): {
                c = owner-str[i]
                uid = uid * 10 + (c - '0')
            }
        }
        // Parse gid part [colon-pos+1..len)
        after-colon = colon-pos + 1
        after-colon < owner-str.len -> {
            gid = 0
            i <- [after-colon..owner-str.len): {
                c = owner-str[i]
                gid = gid * 10 + (c - '0')
            }
        }
    }

    // Apply chown to each file
    i <- [3..argc): {
        path = arg(i)
        ; 獲取文件當前 owner/group（stat-* 為單值返回）
        cur-uid = fs.stat-uid(path)
        cur-gid = fs.stat-gid(path)
        ; 若目標與當前一致則跳過（非 root 用戶改為自身屬主時常見）
        uid-match = uid < 0 || uid == cur-uid
        gid-match = gid < 0 || gid == cur-gid
        uid-match && gid-match -> continue
        ok = os.chown(path, uid, gid)
        ok == false -> {
            print('chown: ' - path - ': Operation not permitted')
            os.exit(1)
        }
    }
}

#{win-amd64, win-arm64}
chown-run = () {
    eprint('chown: not supported on this platform')
    os.exit(1)
}
