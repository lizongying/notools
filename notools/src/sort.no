; sort.no — sort utility
; Sort lines alphabetically
; Usage: sort [-r] [-n] [files...]
;   -r: reverse order
;   -n: numeric sort (compare leading integer of each line)
;   files: files to sort (read from stdin if none)

; sort-num: parse the leading integer of a line for -n.
; Handles an optional sign, then digits until the first non-digit.
sort-num = (s str) (v i64) {
    v = 0
    i = 0
    len = s.len()
    sign = 1
    len > 0 -> s[0] == 45 -> {
        sign = -1
        i = 1
    }
    len > 0 -> s[0] == 43 -> i = 1
    (i < len) {
        c = s[i]
        c < 48 -> break
        c > 57 -> break

        #{overflow=wrap}
        v = v * 10 + (c - 48)

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }

    #{overflow=wrap}
    v = v * sign: {
        ok -> it

        -> _
    }
}

sort-run = () {
    argc = os.args().len()

    reverse = false
    numeric = false
    files []str
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-r' -> reverse = true
        a == '-n' -> numeric = true
        ! a.starts-with('-') -> files.push(a)
    }

    lines []str
    start = 0
    content str

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            start = 0
            i2 <- [0..content.len()): {
                content[i2] == 10 -> {
                    lines.push(content.slice(start, i2))

                    #{overflow=wrap}
                    start = i2 + 1
                }
            }
            start < content.len() -> lines.push(content.slice(start, content.len()))
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                content = ''
                fp str = files[fi]: {
                    ok -> it

                    -> _
                }
                r = fs.read-str(fp)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                start = 0
                i2 <- [0..content.len()): {
                    content[i2] == 10 -> {
                        lines.push(content.slice(start, i2))

                        #{overflow=wrap}
                        start = i2 + 1
                    }
                }
                start < content.len() -> lines.push(content.slice(start, content.len()))
            }
        }
    }

    n = lines.len()
    idx []i64
    x <- [0..n): idx.push(x)
    i <- [0..n): {
        j <- [0..n - i - 1): {

            ij i64 = idx[j]: {
                ok -> it

                -> _
            }
            #{overflow=wrap}
            ij1 = j + 1: {
                ok -> it

                -> _
            }
            ijp i64 = idx[ij1]: {
                ok -> it

                -> _
            }
            lj str = lines[ij]: {
                ok -> it

                -> _
            }
            ljp str = lines[ijp]: {
                ok -> it

                -> _
            }
            cmp = lj.compare(ljp)

            #{overflow=wrap}
            numeric -> {
                df = sort-num(lj) - sort-num(ljp): {
                    ok -> it

                    -> _
                }
                cmp = df
            }
            swap = false
            reverse -> swap = cmp < 0
            ! reverse -> swap = cmp > 0
            swap -> {

                t = idx[j]: {
                    ok -> it

                    -> _
                }

                #{overflow=wrap}
                j1 = j + 1: {
                    ok -> it

                    -> _
                }
                d9v1 i64 = idx[j1]: {
                    ok -> it

                    -> _
                }

                idx[j]: {
                    ok -> it = d9v1

                    -> _
                }

                idx[j1]: {
                    ok -> it = t

                    -> _
                }
            }
        }
    }

    k <- [0..n): {
        ik i64 = idx[k]: {
            ok -> it

            -> _
        }
        lk str = lines[ik]: {
            ok -> it

            -> _
        }
        print(lk)
    }
}
