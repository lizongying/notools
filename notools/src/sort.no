; sort.no — sort utility
; Sort lines alphabetically
; Usage: sort [-r] [-n] [files...]
;   -r: reverse order
;   -n: numeric sort (compare leading integer of each line)
;   files: files to sort (read from stdin if none)

; sort-num: parse the leading integer of a line for -n.
; Handles an optional sign, then digits until the first non-digit.
sort-num = (s str) (v i64) {
    v = 0
    i = 0
    len = s.len-bytes()
    sign = 1
    len > 0 -> s[0] == 45 -> {
        sign = -1
        i = 1
    }
    len > 0 -> s[0] == 43 -> i = 1
    (i < len) {
        c = s[i]
        c < 48 -> break
        c > 57 -> break

        #{overflow=wrap}
        v = v * 10 + (c - 48)

        #{overflow=wrap}
        i = i + 1
    }

    #{overflow=wrap}
    v = v * sign
}

sort-run = () {
    argc = args()

    reverse = false
    numeric = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        a == '-r' -> reverse = true
        a == '-n' -> numeric = true
        ! a.starts-with('-') -> files.push(a)
    }

    lines []str
    start = 0
    content str

    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            start = 0
            i2 <- [0..content.len-bytes()): {
                content[i2] == 10 -> {
                    lines.push(content.slice(start, i2))

                    #{overflow=wrap}
                    start = i2 + 1
                }
            }
            start < content.len-bytes() -> lines.push(content.slice(start, content.len-bytes()))
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                content = ''
                r = fs.read-str(files[fi])
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                start = 0
                i2 <- [0..content.len-bytes()): {
                    content[i2] == 10 -> {
                        lines.push(content.slice(start, i2))

                        #{overflow=wrap}
                        start = i2 + 1
                    }
                }
                start < content.len-bytes() -> lines.push(content.slice(start, content.len-bytes()))
            }
        }
    }

    n = lines.len()
    idx []i64
    x <- [0..n): idx.push(x)
    i <- [0..n): {
        j <- [0..n - i - 1): {

            #{overflow=wrap}
            cmp = lines[idx[j]].compare(lines[idx[j + 1]])

            #{overflow=wrap}
            numeric -> cmp = sort-num(lines[idx[j]]) - sort-num(lines[idx[j + 1]])
            swap = false
            reverse -> swap = cmp < 0
            ! reverse -> swap = cmp > 0
            swap -> {

                #{index-out=zero}
                t = idx[j]

                #{index-out=zero, overflow=wrap}
                idx[j] = idx[j + 1]

                #{overflow=wrap}
                idx[j + 1] = t
            }
        }
    }

    k <- [0..n): {
        print(lines[idx[k]])
    }
}
