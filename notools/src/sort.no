; sort.no — sort utility
; Sort lines alphabetically
; Usage: sort [-r] [files...]
;   -r: reverse order
;   files: files to sort (read from stdin if none)

sort-run = () {
    argc = args()

    reverse = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        a == '-r' -> reverse = true
        ! a.starts-with('-') -> files.push(a)
    }

    lines []str
    start = 0
    content str

    {
        files.len == 0 -> {
            content = fs.read-file('/dev/stdin').to-str()
            start = 0
            i2 <- [0..content.len): {
                content[i2] == 10 -> {
                    lines.push(content.slice(start, i2))
                    start = i2 + 1
                }
            }
            start < content.len -> lines.push(content.slice(start, content.len))
        }

        files.len > 0 -> {
            fi <- [0..files.len): {
                content = fs.read-file(files[fi]).to-str()
                start = 0
                i2 <- [0..content.len): {
                    content[i2] == 10 -> {
                        lines.push(content.slice(start, i2))
                        start = i2 + 1
                    }
                }
                start < content.len -> lines.push(content.slice(start, content.len))
            }
        }
    }

    n = lines.len
    idx []i64
    x <- [0..n): idx.push(x)
    i <- [0..n): {
        j <- [0..n - i - 1): {
            cmp = lines[idx[j]].compare(lines[idx[j + 1]])
            swap = false
            reverse -> swap = cmp < 0
            ! reverse -> swap = cmp > 0
            swap -> {
                t = idx[j]
                idx[j] = idx[j + 1]
                idx[j + 1] = t
            }
        }
    }

    k <- [0..n): {
        print(lines[idx[k]])
    }
}
