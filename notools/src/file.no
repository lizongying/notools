; file.no — file utility
; Identify file type
; Usage: file [-b] [-i] FILE...
;   -b: do not print filename prefix
;   -i: output MIME type
;   Default: print "<filename>: <type>"

; kind-to-mime: 將類型描述轉為 MIME 類型
; kind: 類型描述字串（如 'PNG image'、'ASCII text'）
; 返回對應的 MIME 類型
kind-to-mime = (kind str) (mime str) {
    {
        kind == 'directory' -> mime = 'inode/directory'
        kind == 'ASCII text' -> mime = 'text/plain'
        kind == 'Markdown text' -> mime = 'text/markdown'
        kind == 'JSON data' -> mime = 'application/json'
        kind == 'XML document' -> mime = 'application/xml'
        kind == 'CSV data' -> mime = 'text/csv'
        kind == 'HTML document' -> mime = 'text/html'
        kind == 'CSS stylesheet' -> mime = 'text/css'
        kind == 'JavaScript source' -> mime = 'text/javascript'
        kind == 'TypeScript source' -> mime = 'text/typescript'
        kind == 'Nolang source' -> mime = 'text/plain'
        kind == 'Go source' -> mime = 'text/x-go'
        kind == 'Python source' -> mime = 'text/x-python'
        kind == 'Shell script' -> mime = 'text/x-shellscript'
        kind == 'C source' -> mime = 'text/x-csrc'
        kind == 'C header' -> mime = 'text/x-chdr'
        kind == 'C++ source' -> mime = 'text/x-c++src'
        kind == 'C++ header' -> mime = 'text/x-c++hdr'
        kind == 'Rust source' -> mime = 'text/rust'
        kind == 'Java source' -> mime = 'text/x-java-source'
        kind == 'YAML document' -> mime = 'application/x-yaml'
        kind == 'TOML document' -> mime = 'application/toml'
        kind == 'INI configuration' -> mime = 'text/plain'
        kind == 'Configuration file' -> mime = 'text/plain'
        kind == 'Log file' -> mime = 'text/plain'
        kind == 'Lock file' -> mime = 'text/plain'
        kind == 'PNG image' -> mime = 'image/png'
        kind == 'JPEG image' -> mime = 'image/jpeg'
        kind == 'GIF image' -> mime = 'image/gif'
        kind == 'BMP image' -> mime = 'image/bmp'
        kind == 'SVG image' -> mime = 'image/svg+xml'
        kind == 'ICO image' -> mime = 'image/x-icon'
        kind == 'PDF document' -> mime = 'application/pdf'
        kind == 'Zip archive' -> mime = 'application/zip'
        kind == 'Gzip compressed' -> mime = 'application/gzip'
        kind == 'Tar archive' -> mime = 'application/x-tar'
        kind == 'Bzip2 compressed' -> mime = 'application/x-bzip2'
        kind == 'XZ compressed' -> mime = 'application/x-xz'
        kind == '7-Zip archive' -> mime = 'application/x-7z-compressed'
        kind == 'RAR archive' -> mime = 'application/x-rar'
        kind == 'WAV audio' -> mime = 'audio/wav'
        kind == 'MP3 audio' -> mime = 'audio/mpeg'
        kind == 'MP4 video' -> mime = 'video/mp4'
        kind == 'AVI video' -> mime = 'video/x-msvideo'
        kind == 'MKV video' -> mime = 'video/x-matroska'
        kind == 'Windows executable' -> mime = 'application/x-msdownload'
        kind == 'Windows DLL' -> mime = 'application/x-msdownload'
        kind == 'Shared library' -> mime = 'application/x-sharedlib'
        kind == 'macOS shared library' -> mime = 'application/x-sharedlib'
        kind == 'Object file' -> mime = 'application/x-object'
        kind == 'Static library' -> mime = 'application/x-archive'
        kind == 'WebAssembly module' -> mime = 'application/wasm'
        kind == 'ELF executable' -> mime = 'application/x-executable'
        kind == 'Mach-O 64-bit executable' -> mime = 'application/x-mach-binary'
        kind == 'Mach-O executable' -> mime = 'application/x-mach-binary'
        kind == 'PE executable' -> mime = 'application/x-msdownload'
        kind == 'RIFF container' -> mime = 'application/octet-stream'
        -> mime = 'application/octet-stream'
    }
}

file-run = () {
    argc = args()

    brief = false
    mime-mode = false
    files []str

    i <- [2..argc): {
        a = arg(i)
        a.starts-with('-') -> {
            a.contains('b') -> brief = true
            a.contains('i') -> mime-mode = true
        }
        -> files.push(a)
    }

    {
        files.len == 0 -> {
            eprint('Usage: file [-b] [-i] FILE...')
            os.exit(1)
        }
    }

    i <- [0..files.len): {
        p = files[i]
        kind = magic.detect-type(p)

        output = kind
        mime-mode -> output = kind-to-mime(kind)

        brief -> print(output)
        -> {
            line = p - ': ' - output
            print(line)
        }
    }
}
