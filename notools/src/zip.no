; zip.no — zip utility
; Create zip archives (stored method only — no compression)
; Usage: zip archive.zip files...
;
; Note: uses module-level state instead of a struct, because the Nolang
; codegen mishandles []byte.push / []i64.push on struct fields (it resolves
; to the undefined []byte.push builtin and mutates a copy rather than the
; original field). Local-variable push works correctly.

zw-files []str
zw-data []byte
zw-sizes []i64
zw-offsets []i64
zw-crcs []i64

; add-file: append a file's contents to the archive
add-file = (name str, content str) {
    zw-files.push(name.copy())
    zw-offsets.push(zw-data.len)
    n = content.len
    zw-sizes.push(n)
    ; compute CRC-32
    content-bytes = content.to-bytes()
    crc = crc-32.crc-32(content-bytes, n)
    zw-crcs.push(crc)
    ; local file header signature
    zw-data.push(80)
    zw-data.push(75)
    zw-data.push(3)
    zw-data.push(4)
    ; version needed (20)
    zw-data.push(20)
    zw-data.push(0)
    ; general purpose flags (0)
    zw-data.push(0)
    zw-data.push(0)
    ; compression method (0=stored)
    zw-data.push(0)
    zw-data.push(0)
    ; mod time/date (zeros)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)
    ; crc-32
    zw-data.push(crc & 255)
    zw-data.push((crc >> 8) & 255)
    zw-data.push((crc >> 16) & 255)
    zw-data.push((crc >> 24) & 255)
    ; compressed size = uncompressed size (stored)
    b0 = n & 255
    b1 = (n >> 8) & 255
    b2 = (n >> 16) & 255
    b3 = (n >> 24) & 255
    zw-data.push(b0)
    zw-data.push(b1)
    zw-data.push(b2)
    zw-data.push(b3)
    zw-data.push(b0)
    zw-data.push(b1)
    zw-data.push(b2)
    zw-data.push(b3)
    ; filename length
    nl = name.len
    nl0 = nl & 255
    nl1 = (nl >> 8) & 255
    zw-data.push(nl0)
    zw-data.push(nl1)
    ; extra field length (0)
    zw-data.push(0)
    zw-data.push(0)
    ; filename bytes
    i <- [0..nl): {
        zw-data.push(name[i])
    }
    ; file content
    i <- [0..n): {
        zw-data.push(content[i])
    }
}

; finalize: append central directory and EOCD to zw-data
finalize = () {
    cd-start = zw-data.len
    n = zw-files.len
    i <- [0..n): {
        name = zw-files[i]
        nl = name.len
        sz = zw-sizes[i]
        off = zw-offsets[i]
        crc = zw-crcs[i]
        ; central directory header signature
        zw-data.push(80)
        zw-data.push(75)
        zw-data.push(1)
        zw-data.push(2)
        ; version made by / version needed
        zw-data.push(20)
        zw-data.push(0)
        zw-data.push(20)
        zw-data.push(0)
        ; flags (0) / method (0=stored)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        ; mod time/date (zeros)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        ; crc-32
        zw-data.push(crc & 255)
        zw-data.push((crc >> 8) & 255)
        zw-data.push((crc >> 16) & 255)
        zw-data.push((crc >> 24) & 255)
        ; compressed size
        zw-data.push(sz & 255)
        zw-data.push((sz >> 8) & 255)
        zw-data.push((sz >> 16) & 255)
        zw-data.push((sz >> 24) & 255)
        ; uncompressed size
        zw-data.push(sz & 255)
        zw-data.push((sz >> 8) & 255)
        zw-data.push((sz >> 16) & 255)
        zw-data.push((sz >> 24) & 255)
        ; filename length
        nl0 = nl & 255
        nl1 = (nl >> 8) & 255
        zw-data.push(nl0)
        zw-data.push(nl1)
        ; extra/comment length (0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        ; disk number start / internal attrs / external attrs
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        ; local header offset
        zw-data.push(off & 255)
        zw-data.push((off >> 8) & 255)
        zw-data.push((off >> 16) & 255)
        zw-data.push((off >> 24) & 255)
        ; filename bytes
        j <- [0..nl): {
            zw-data.push(name[j])
        }
    }
    ; EOCD record
    cd-size = zw-data.len - cd-start
    cds0 = cd-size & 255
    cds1 = (cd-size >> 8) & 255
    cds2 = (cd-size >> 16) & 255
    cds3 = (cd-size >> 24) & 255
    cds0l = cd-start & 255
    cds1l = (cd-start >> 8) & 255
    cds2l = (cd-start >> 16) & 255
    cds3l = (cd-start >> 24) & 255
    n0 = n & 255
    n1 = (n >> 8) & 255
    zw-data.push(80)
    zw-data.push(75)
    zw-data.push(5)
    zw-data.push(6)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(n0)
    zw-data.push(n1)
    zw-data.push(n0)
    zw-data.push(n1)
    zw-data.push(cds0)
    zw-data.push(cds1)
    zw-data.push(cds2)
    zw-data.push(cds3)
    zw-data.push(cds0l)
    zw-data.push(cds1l)
    zw-data.push(cds2l)
    zw-data.push(cds3l)
    zw-data.push(0)
    zw-data.push(0)
}

; add-dir: recursively add files under dir
add-dir = (dir str) {
    entries = fs.list-dir(dir)
    i <- [0..entries.len): {
        name = entries[i]
        name == '.' -> continue
        name == '..' -> continue
        full = dir - '/' - name
        fs.is-dir(full) -> {
            add-dir(full)
        }
        fs.is-file(full) -> {
            content = fs.read-file(full)
            add-file(full, content)
        }
    }
}

create = (filename str, files []str) {
    i <- [0..files.len): {
        path = files[i]
        fs.is-file(path) -> {
            content = fs.read-file(path)
            add-file(path, content)
        }
        fs.is-dir(path) -> {
            add-dir(path)
        }
    }

    finalize()
    fs.write-file(filename, zw-data)
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
zip-run = () {
    argc = args()

    {
        argc < 3 -> {
            print('Usage: zip archive.zip files...')
            os.exit(1)
        }
    }

    filename = arg(2)
    files []str
    i <- [3..argc): {
        files.push(arg(i))
    }

    create(filename, files)
}

#{win-amd64, win-arm64}
zip-run = () {
    eprint('zip-run: not supported on this platform')
    os.exit(1)
}
