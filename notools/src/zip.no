; zip.no — zip utility
; Create zip archives (stored method only — no compression)
; Usage: zip archive.zip files...
;
; Note: uses module-level state instead of a struct, because the Nolang
; codegen mishandles []byte.push / []i64.push on struct fields (it resolves
; to the undefined []byte.push builtin and mutates a copy rather than the
; original field). Local-variable push works correctly.

zw-files []str
zw-data []byte
zw-sizes []i64
zw-offsets []i64
zw-crcs []i64

; byte-at: extract one byte (shifted) from an i64 as a plain i64 (option unwrapped)
; 0.4.24: `>>`/`&` yield ?i64, so unwrap here before pushing into []byte.
byte-at = (v i64, shift i64) (b i64) {
    sv = v >> shift: {
        ok -> it

        -> 0
    }
    b = sv & 255: {
        ok -> it

        -> 0
    }
}

; add-file: append a file's contents to the archive
add-file = (name str, content str) {
    zw-files.push(name.copy())
    zw-offsets.push(zw-data.len())
    n = content.len()
    zw-sizes.push(n)

    ; compute CRC-32
    content-bytes = content
    crc = crc-32.new(content-bytes, n)
    zw-crcs.push(crc)

    ; local file header signature
    zw-data.push(80)
    zw-data.push(75)
    zw-data.push(3)
    zw-data.push(4)

    ; version needed (20)
    zw-data.push(20)
    zw-data.push(0)

    ; general purpose flags (0)
    zw-data.push(0)
    zw-data.push(0)

    ; compression method (0=stored)
    zw-data.push(0)
    zw-data.push(0)

    ; mod time/date (zeros)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)

    ; crc-32
    zw-data.push(crc & 255)
    zw-data.push((crc >> 8) & 255)
    zw-data.push((crc >> 16) & 255)
    zw-data.push((crc >> 24) & 255)

    ; compressed size = uncompressed size (stored)
    b0 = n & 255
    b1 = (n >> 8) & 255
    b2 = (n >> 16) & 255
    b3 = (n >> 24) & 255
    zw-data.push(b0)
    zw-data.push(b1)
    zw-data.push(b2)
    zw-data.push(b3)
    zw-data.push(b0)
    zw-data.push(b1)
    zw-data.push(b2)
    zw-data.push(b3)

    ; filename length
    nl = name.len()
    nl0 = nl & 255
    nl1 = (nl >> 8) & 255
    zw-data.push(nl0)
    zw-data.push(nl1)

    ; extra field length (0)
    zw-data.push(0)
    zw-data.push(0)

    ; filename bytes
    i <- [0..nl): {
        zw-data.push(name[i])
    }

    ; file content
    i <- [0..n): {
        zw-data.push(content[i])
    }
}

; finalize: append central directory and EOCD to zw-data
finalize = () {
    cd-start = zw-data.len()
    n = zw-files.len()
    i <- [0..n): {

        ; two-stage unwrap: a raw `name = zw-files[i]` read types as ?str and
        ; poisons same-named vars in other funcs via the checker var snapshot
        fname = ''
        zw-files[i]: {
            ok -> fname = it

            -> _
        }
        nl = fname.len()
        sz = zw-sizes[i]: {
            ok -> it

            -> 0
        }
        off = zw-offsets[i]: {
            ok -> it

            -> 0
        }
        crc = zw-crcs[i]: {
            ok -> it

            -> 0
        }

        ; central directory header signature
        zw-data.push(80)
        zw-data.push(75)
        zw-data.push(1)
        zw-data.push(2)

        ; version made by / version needed
        zw-data.push(20)
        zw-data.push(0)
        zw-data.push(20)
        zw-data.push(0)

        ; flags (0) / method (0=stored)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)

        ; mod time/date (zeros)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)

        ; crc-32
        zw-data.push(byte-at(crc, 0))
        zw-data.push(byte-at(crc, 8))
        zw-data.push(byte-at(crc, 16))
        zw-data.push(byte-at(crc, 24))

        ; compressed size
        zw-data.push(byte-at(sz, 0))
        zw-data.push(byte-at(sz, 8))
        zw-data.push(byte-at(sz, 16))
        zw-data.push(byte-at(sz, 24))

        ; uncompressed size
        zw-data.push(byte-at(sz, 0))
        zw-data.push(byte-at(sz, 8))
        zw-data.push(byte-at(sz, 16))
        zw-data.push(byte-at(sz, 24))

        ; filename length
        zw-data.push(byte-at(nl, 0))
        zw-data.push(byte-at(nl, 8))

        ; extra/comment length (0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)

        ; disk number start / internal attrs / external attrs
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)
        zw-data.push(0)

        ; local header offset
        zw-data.push(byte-at(off, 0))
        zw-data.push(byte-at(off, 8))
        zw-data.push(byte-at(off, 16))
        zw-data.push(byte-at(off, 24))

        ; filename bytes
        j <- [0..nl): {
            fj = fname[j]: {
                ok -> it

                -> 0
            }
            zw-data.push(fj)
        }
    }

    ; EOCD record
    #{overflow=wrap}
    cd-size = zw-data.len() - cd-start: {
        ok -> it

        -> 0
    }
    zw-data.push(80)
    zw-data.push(75)
    zw-data.push(5)
    zw-data.push(6)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(0)
    zw-data.push(byte-at(n, 0))
    zw-data.push(byte-at(n, 8))
    zw-data.push(byte-at(n, 0))
    zw-data.push(byte-at(n, 8))
    zw-data.push(byte-at(cd-size, 0))
    zw-data.push(byte-at(cd-size, 8))
    zw-data.push(byte-at(cd-size, 16))
    zw-data.push(byte-at(cd-size, 24))
    zw-data.push(byte-at(cd-start, 0))
    zw-data.push(byte-at(cd-start, 8))
    zw-data.push(byte-at(cd-start, 16))
    zw-data.push(byte-at(cd-start, 24))
    zw-data.push(0)
    zw-data.push(0)
}

; add-dir: recursively add files under dir
add-dir = (dir str) {
    entries = fs.list-dir(dir)
    i <- [0..entries.len()): {

        ; # index-out=zero on a []str read desugars to a u64 temp — two-stage unwrap instead
        name = ''
        entries[i]: {
            ok -> name = it

            -> _
        }
        name == '.' -> continue
        name == '..' -> continue
        full = dir - '/' - name
        fs.is-dir(full) -> {
            add-dir(full)
        }
        fs.is-file(full) -> {
            content = ''
            r = fs.read-str(full)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            add-file(full, content)
        }
    }
}

create = (filename str, files []str) {
    i <- [0..files.len()): {

        ; # index-out=zero on a []str read desugars to a u64 temp — two-stage unwrap instead
        path = ''
        files[i]: {
            ok -> path = it

            -> _
        }
        fs.is-file(path) -> {
            content = ''
            r = fs.read-str(path)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            add-file(path, content)
        }
        fs.is-dir(path) -> {
            add-dir(path)
        }
    }

    finalize()
    fs.write-file(filename, zw-data)
}

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}
zip-run = () {
    argc = os.args().len()

    {
        argc < 3 -> {
            print('Usage: zip archive.zip files...')
            exit(1)
        }
    }

    filename-opt = os.arg(2)
    filename = filename-opt: {
        ok -> it

        -> ''
    }
    files []str
    i <- [3..argc): {
        fa = os.arg(i): {
            ok -> it

            -> ''
        }
        files.push(fa)
    }

    create(filename, files)
}

#{win-amd64, win-arm64}
zip-run = () {
    eprint('zip-run: not supported on this platform')
    exit(1)
}
