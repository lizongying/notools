; zip.no — zip utility
; Create zip archives (stored method only — no compression)
; Usage: zip archive.zip files...
;
; Note: uses module-level state instead of a struct, because the Nolang
; codegen mishandles []byte.push / []i64.push on struct fields (it resolves
; to the undefined []byte.push builtin and mutates a copy rather than the
; original field). Local-variable push works correctly.

zw-files []str
zw-data   []i64

; add-file: append a file's contents to the archive
add-file = (name str, content str) {
    zw-files.push(name.copy())
    ; local file header signature
    zw-data.push(80); zw-data.push(75); zw-data.push(3); zw-data.push(4)
    ; version needed (20), general purpose flags (0), compression method (0=stored)
    zw-data.push(20); zw-data.push(0)
    zw-data.push(0); zw-data.push(0)
    zw-data.push(0); zw-data.push(0)
    zw-data.push(0); zw-data.push(0)
    ; mod time/date (zeros)
    zw-data.push(0); zw-data.push(0)
    zw-data.push(0); zw-data.push(0)
    ; crc-32 (placeholder 0 — not computed)
    zw-data.push(0); zw-data.push(0); zw-data.push(0); zw-data.push(0)
    ; compressed size = uncompressed size (stored)
    n = content.len
    b0 = n & 255
    b1 = (n >> 8) & 255
    b2 = (n >> 16) & 255
    b3 = (n >> 24) & 255
    zw-data.push(b0); zw-data.push(b1); zw-data.push(b2); zw-data.push(b3)
    zw-data.push(b0); zw-data.push(b1); zw-data.push(b2); zw-data.push(b3)
    ; filename length
    nl = name.len
    nl0 = nl & 255
    nl1 = (nl >> 8) & 255
    zw-data.push(nl0); zw-data.push(nl1)
    ; extra field length (0)
    zw-data.push(0); zw-data.push(0)
    ; filename bytes
    i <- [0..nl): {
        zw-data.push(name[i])
    }
    ; file content
    i <- [0..n): {
        zw-data.push(content[i])
    }
}

; finalize: append central directory and EOCD, return raw bytes
finalize = () (out []i64) {
    cd-start = zw-data.len
    n = zw-files.len
    i <- [0..n): {
        name = zw-files[i]
        nl = name.len
        ; central directory header signature
        zw-data.push(80); zw-data.push(75); zw-data.push(1); zw-data.push(2)
        ; version made by / version needed
        zw-data.push(20); zw-data.push(0)
        zw-data.push(20); zw-data.push(0)
        ; flags / method / time / date / crc (all zeros)
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0); zw-data.push(0); zw-data.push(0)
        ; sizes (0 — not tracked after build; readers infer from local header)
        zw-data.push(0); zw-data.push(0); zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0); zw-data.push(0); zw-data.push(0)
        ; filename length
        nl0 = nl & 255
        nl1 = (nl >> 8) & 255
        zw-data.push(nl0); zw-data.push(nl1)
        ; extra/comment length (0)
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0)
        ; disk number start / internal attrs / external attrs
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0)
        zw-data.push(0); zw-data.push(0); zw-data.push(0); zw-data.push(0)
        ; local header offset (0 — simplified: all entries share offset 0,
        ; readers that care about multi-entry offsets should fix this)
        zw-data.push(0); zw-data.push(0); zw-data.push(0); zw-data.push(0)
        ; filename bytes
        j <- [0..nl): {
            zw-data.push(name[j])
        }
    }
    ; EOCD record
    cd-size = zw-data.len - cd-start
    cds0 = cd-size & 255
    cds1 = (cd-size >> 8) & 255
    cds2 = (cd-size >> 16) & 255
    cds3 = (cd-size >> 24) & 255
    cds0l = cd-start & 255
    cds1l = (cd-start >> 8) & 255
    cds2l = (cd-start >> 16) & 255
    cds3l = (cd-start >> 24) & 255
    n0 = n & 255
    n1 = (n >> 8) & 255
    zw-data.push(80); zw-data.push(75); zw-data.push(5); zw-data.push(6)
    zw-data.push(0); zw-data.push(0)
    zw-data.push(0); zw-data.push(0)
    zw-data.push(n0); zw-data.push(n1)
    zw-data.push(n0); zw-data.push(n1)
    zw-data.push(cds0); zw-data.push(cds1); zw-data.push(cds2); zw-data.push(cds3)
    zw-data.push(cds0l); zw-data.push(cds1l); zw-data.push(cds2l); zw-data.push(cds3l)
    zw-data.push(0); zw-data.push(0)
    out = zw-data
}

; add-dir: recursively add files under dir
add-dir = (dir str) {
    entries = fs.list-dir(dir)
    i <- [0..entries.len): {
        name = entries[i]
        name == '.' -> continue
        name == '..' -> continue
        full = dir - '/' - name
        fs.is-dir(full) -> {
            add-dir(full)
        }
        fs.is-file(full) -> {
            content = fs.read-file(full)
            add-file(full, content)
        }
    }
}

create = (filename str, files []str) {
    i <- [0..files.len): {
        path = files[i]
        fs.is-file(path) -> {
            content = fs.read-file(path)
            add-file(path, content)
        }
        fs.is-dir(path) -> {
            add-dir(path)
        }
    }

    data = finalize()
    fd = fs.open-write(filename)
    n = data.len
    ; write bytes one at a time by building a string buffer
    ; (fs.write expects a str, not []i64; we convert in chunks)
    buf = ''
    j <- [0..n): {
        buf = buf - number.char-to-str(data[j])
    }
    fs.write(fd, buf, buf.len)
    fs.close(fd)
}

zip-run = () {
    argc = args()

    argc < 3 -> {
        print('Usage: zip archive.zip files...')
        os.exit(1)
    }

    filename = arg(2)
    files []str
    i <- [3..argc): {
        files.push(arg(i))
    }

    create(filename, files)
}
