// zip.no — zip utility
// Create zip archives
// Usage: zip archive.zip files...
//   archive.zip: output archive filename
//   files: files to add to archive

zip-run = () {
    argc = args()

    argc < 3 -> {
        print('Usage: zip archive.zip files...')
        os.exit(1)
    }

    filename = arg(2)
    files []str
    i <- [3..argc): {
        files.push(arg(i))
    }

    zip-create(filename, files)
}

// zip-add-dir 遞迴加入目錄下的所有檔案與子目錄
zip-add-dir = (w zip-writer, dir str) {
    entries = fs.list-dir(dir)
    i <- [0..entries.len): {
        name = entries[i]
        name == '.' -> continue
        name == '..' -> continue
        full = dir - '/' - name
        fs.is-dir(full) -> {
            w.add-dir(full)
            zip-add-dir(w, full)
        }
        fs.is-file(full) -> {
            content = fs.read-file(full)
            w.add-file(full, content.to-bytes())
        }
    }
}

zip-create = (filename str, files []str) {
    w = zip-writer{}

    i <- [0..files.len): {
        path = files[i]
        fs.is-file(path) -> {
            content = fs.read-file(path)
            w.add-file(path, content.to-bytes())
        }
        fs.is-dir(path) -> {
            w.add-dir(path)
            zip-add-dir(w, path)
        }
    }

    data = w.finalize()
    fs.write-file(filename, data)
}
