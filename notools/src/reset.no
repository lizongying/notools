// reset.no — reset utility
// Reset the terminal
// Usage: reset
//   Sends a full terminal reset sequence:
//     ESC c       — full reset (RIS)
//     ESC [ 2 J   — clear screen
//     ESC [ H     — cursor home
//     ESC [ ? 2 5 h — show cursor (DECTCEM)
//   Then resets the cooked/cbreak state by emitting CR.

reset = () {
    // ESC c — full reset (RIS)
    io.out('\033c')
    // ESC[2J — clear screen
    io.out('\033[2J')
    // ESC[H — cursor home
    io.out('\033[H')
    // ESC[?25h — show cursor
    io.out('\033[?25h')
    // Trailing CR to force a fresh line in cooked mode
    io.out('\r')
    io.out('\n')
}
