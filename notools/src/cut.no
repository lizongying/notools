// cut.no — cut utility
// Remove sections from each line of files
// Usage: cut -d DELIM -f LIST | cut -c LIST [file...]

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

split-comma = (list str) (out []str) {
    start = 0
    n <- [0..list.len): {
        b = list[n]
        b == 44 -> out.push(list.slice(start, n))
        b == 44 -> start = n + 1
    }
    llen = list.len
    out.push(list.slice(start, llen))
}

split-fields = (line str, delim str) (out []str) {
    dbyte = delim[0]
    start = 0
    n <- [0..line.len): {
        b = line[n]
        b == dbyte -> out.push(line.slice(start, n))
        b == dbyte -> start = n + 1
    }
    llen = line.len
    out.push(line.slice(start, llen))
}

build-selected = (list str) (out []i64) {
    parts = split-comma(list)
    lo = 0
    hi = 0
    dash = 0
    left = ''
    right = ''
    llen = 0
    hend = 0
    p <- [0..parts.len): {
        w = parts[p]
        w.len == 0 -> continue
        dash = -1
        j <- [0..w.len): { w[j] == 45 -> dash = j }
        dash < 0 -> lo = atoi(w)
        dash < 0 -> hi = atoi(w)
        dash >= 0 -> left = w.slice(0, dash)
        dash >= 0 -> llen = w.len
        dash >= 0 -> right = w.slice(dash + 1, llen)
        dash >= 0 -> lo = 1
        dash >= 0 -> hi = 1000000000
        dash >= 0 -> left.len > 0 -> lo = atoi(left)
        dash >= 0 -> right.len > 0 -> hi = atoi(right)
        dash >= 0 -> lo < 1 -> lo = 1
        hend = hi + 1
        k <- [lo..hend): { out.push(k) }
    }
}

emit-fields = (line str, sel []i64, d str) {
    fields = split-fields(line, d)
    first = 1
    z <- [0..sel.len): {
        idx = sel[z]
        ok = 0
        idx >= 1 -> idx <= fields.len -> ok = 1
        ok == 1 -> first == 0 -> printf('%s', d)
        ok == 1 -> printf('%s', fields[idx - 1])
        ok == 1 -> first = 0
    }
    print('')
}

emit-chars = (line str, sel []i64) {
    z <- [0..sel.len): {
        pos = sel[z]
        ok = 0
        pos >= 1 -> pos <= line.len -> ok = 1
        ok == 1 -> printf('%s', char-to-str(line[pos - 1]))
    }
    print('')
}

emit = (content str, start i64, end i64, mode i64, d str, sel []i64) {
    line = content.slice(start, end)
    mode == 1 -> emit-fields(line, sel, d)
    mode == 2 -> emit-chars(line, sel)
}

cut-run = () {
    argc = args()
    mode = 0
    lists []str
    delims []str
    lists.push('')
    delims.push(char-to-str(9))
    inputs []str
    skip-next = 0
    i <- [2..argc): {
        skip-next == 1 -> { skip-next = 0; continue }
        a = arg(i)
        isflag = 0
        a.starts-with('-') -> a.len > 1 -> isflag = 1
        isflag == 1 -> {
            key = a[1]
            attached = 0
            a.len > 2 -> attached = 1
            key == 100 -> {
                attached == 1 -> delims.push(char-to-str(a[2]))
                attached == 0 -> { i + 1 <= argc -> { delims.push(arg(i + 1)); skip-next = 1 } }
            }
            key == 102 -> {
                mode = 1
                attached == 1 -> lists.push(a.slice(2, a.len))
                attached == 0 -> { i + 1 <= argc -> { lists.push(arg(i + 1)); skip-next = 1 } }
            }
            key == 99 -> {
                mode = 2
                attached == 1 -> lists.push(a.slice(2, a.len))
                attached == 0 -> { i + 1 <= argc -> { lists.push(arg(i + 1)); skip-next = 1 } }
            }
        }
        isflag == 0 -> inputs.push(a)
    }
    lidx = lists.len
    lidx = lidx - 1
    didx = delims.len
    didx = didx - 1
    mode == 0 -> io.errln('Usage: cut -d DELIM -f LIST | cut -c LIST [file...]')
    mode > 0 -> sel = build-selected(lists[lidx])
    mode > 0 -> d = delims[didx]
    mode > 0 -> inputs.len == 0 -> {
        content = fs.read-file('/dev/stdin')
        start = 0
        i <- [0..content.len): {
            content[i] == 10 -> emit(content, start, i, mode, d, sel)
            content[i] == 10 -> start = i + 1
        }
        start < content.len -> emit(content, start, content.len, mode, d, sel)
    }
    mode > 0 -> inputs.len > 0 -> {
        i <- [0..inputs.len): {
            fs.is-file(inputs[i]) == false -> {
                io.errln('cut: ' - inputs[i] - ': No such file or directory')
                continue
            }
            content = fs.read-file(inputs[i])
            start = 0
            k <- [0..content.len): {
                content[k] == 10 -> emit(content, start, k, mode, d, sel)
                content[k] == 10 -> start = k + 1
            }
            start < content.len -> emit(content, start, content.len, mode, d, sel)
        }
    }
}