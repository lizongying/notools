; yes.no — yes utility
; Repeatedly output a string until killed
; Usage: yes [string...]
;   No args: outputs 'y' repeatedly
;   Multiple args: outputs them joined by spaces

yes-run = () {
    argc = os.args()
    s = 'y'
    {
        argc >= 3 -> {
            s = os.arg(2)
            i <- [3..argc): {
                s = s - ' ' - os.arg(i)
            }
        }
    }
    !! {
        print(s)
    }
}
