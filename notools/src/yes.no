; yes.no — yes utility
; Repeatedly output a string until killed
; Usage: yes [string...]
;   No args: outputs 'y' repeatedly
;   Multiple args: outputs them joined by spaces

yes-run = () {
    argc = os.args().len()
    s = 'y'
    {
        argc >= 3 -> {
            s-opt = os.arg(2)
            s = s-opt: {
                ok -> it

                -> ''
            }
            i <- [3..argc): {
                s = s - ' ' - os.arg(i)
            }
        }
    }
    ; io.outln 返回实际写入字节数；下游关闭管道（SIGPIPE/EPIPE）时写失败，
    ; 必须退出而不是继续满速循环（T-6）。
    !! {
        n = io.outln(s)
        n <= 0 -> return
    }
}
