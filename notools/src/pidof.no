; pidof.no — pidof utility
; Find PIDs of running programs by name
; Usage: pidof [-q] NAME...
;   -q: quiet mode (no output, only exit status)
;   Exit status: 0 if at least one process found, 1 otherwise
; Note: Prints space-separated PIDs on a single line.

; pidof-atoi: parse decimal integer (unused placeholder for future -s flag)
pidof-run = () {
    argc = args()

    quiet = false
    names []str

    i <- [2..argc): {
        a = arg(i)
        {
            a == '-q' -> {
                quiet = true
            }
            a == '-s' -> {
            }
            a.starts-with('-') && a.len > 1 -> {
            }
            -> names.push(a)
        }
    }

    {
        names.len == 0 -> {
            eprint('Usage: pidof [-q] NAME...')
            os.exit(1)
        }
    }

    all-pids []i64
    i <- [0..names.len): {
        name = names[i]
        pids = process.find-by-name(name)
        j <- [0..pids.len): {
            all-pids.push(pids[j])
        }
    }

    {
        all-pids.len == 0 -> os.exit(1)
        quiet == false -> {
            line = ''
            i <- [0..all-pids.len): {
                i > 0 -> line = line - ' '
                p = all-pids[i]
                line = line - p.to-str()
            }
            print(line)
        }
    }
}
