; egrep.no — egrep utility
; grep -E 别名（扩展正则）。当前 notools 的 grep 为固定字串匹配，
; egrep 暂复用相同逻辑，待 no 标准库增加 regex 支持后升级。
; Usage: egrep [-n] pattern [files...]

egrep = () {
    argc = args()

    show-line-num = false
    pattern = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-n' -> show-line-num = true
        !a.starts-with('-') -> {
            {
                pattern.len == 0 -> pattern = a
                -> files.push(a)
            }
        }
    }

    {
        pattern.len == 0 -> {
            eprint('egrep: no pattern specified')
            os.exit(1)
        }

        files.len == 0 -> {
            content = fs.read-file('/dev/stdin')
            egrep-search(content, pattern, show-line-num, false, '')
        }
        files.len > 0 -> {
            fi <- [0..files.len): {
                ! fs.is-file(files[fi]) -> {
                    eprint('egrep: ' - files[fi] - ': No such file or directory')
                    os.exit(1)
                }
                content = fs.read-file(files[fi])
                egrep-search(content, pattern, show-line-num, files.len > 1, files[fi])
            }
        }
    }
}

egrep-search = (content str, pattern str, show-line-num bool, show-filename bool, filename str) {
    lines []str
    start = 0
    i <- [0..content.len): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i))
            start = i + 1
        }
    }
    start < content.len -> lines.push(content.slice(start, content.len))
    j <- [0..lines.len): {
        line = lines[j]
        pos = line.index(pattern)
        pos >= 0 -> {
            show-filename -> io.out(filename - ':')
            show-line-num -> {
                lineno = j + 1
                io.out(lineno.to-str() - ':')
            }
            print(line)
        }
    }
}
