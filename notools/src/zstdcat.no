; zstdcat.no — zstdcat utility: decompress .zst to stdout (native Nolang)
; Usage: zstdcat FILE...

zstdcat-cmd = () {
    argc = args()

    has-file = false

    i = 2
    {
        a = arg(i)
        {
            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    #{overflow=wrap}
                    eprint('zstdcat: ' - f - ': No such file')
                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it
                    nil -> {
                    }
                    err -> {
                    }
                }
                data = content
                out []byte = zstd.zstd-decompress(data)
                s = out.to-bytes-str()
                io.out(s)
            }
        }

        #{overflow=wrap}
        i = i + 1
    } (i < argc)

    {
        has-file == false -> {
            eprint('zstdcat: no input files')
            os.exit(1)
        }
    }
}
