; zstdcat.no — zstdcat utility: decompress .zst to stdout (native Nolang)
; Usage: zstdcat FILE...

zstdcat-cmd = () {
    argc = os.args().len()

    has-file = false

    i = 2
    (i < argc) {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            ! a.starts-with('-') -> {
                has-file = true
                f = a

                ! fs.is-file(f) -> {
                    eprint('zstdcat: ' - f - ': No such file')

                    #{overflow=wrap}
                    i = i + 1: {
                        ok -> it

                        -> _
                    }
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = content
                out []byte = zstd.decompress(data)
                tb0o = out.to-str()
                tb0v = tb0o: {
                    ok -> it
                
                    nil || err -> ''
                }
                s = tb0v
                io.out(s)
            }
        }

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }

    {
        ! has-file -> {
            eprint('zstdcat: no input files')
            exit(1)
        }
    }
}
