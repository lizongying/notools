; zstdcat.no — zstdcat utility: decompress .zst to stdout (native Nolang)
; Usage: zstdcat FILE...

zstdcat-cmd = () {
    argc = args()

    has-file = false

    i = 2
    {
        a = arg(i)
        {
            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    eprint('zstdcat: ' - f - ': No such file')
                    i = i + 1
                    continue
                }
                content = fs.read-file(f)
                data = content.to-bytes()
                out []byte = zstd.zstd-decompress(data)
                s = out.to-str()
                io.out(s)
            }
        }

        i = i + 1
    } (i < argc)

    {
        has-file == false -> {
            eprint('zstdcat: no input files')
            os.exit(1)
        }
    }
}
