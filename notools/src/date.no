; date.no — date utility
; Display or set the system date (delegates to the system `date` command)
; Usage: date [args]
;   Passes all arguments straight through to the system date, e.g.
;   notools date -u +%Y-%m-%d

date-run = () {
    argc = args()
    cmd = 'date'
    i <- [2..argc): {
        cmd = cmd - ' ' - arg(i)
    }
    process.process-system(cmd)
}
