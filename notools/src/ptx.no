; ptx.no — ptx utility (permutation index, pure Nolang)
; Generate a permuted index (keyword-in-context) from text files.
; Usage: ptx [OPTIONS] [FILE...]
;   -A N        include N words of after-context (default 0)
;   -B N        include N words of before-context (default 0)
;   -r          ignore case when sorting
; Default reads stdin if no FILE given.
; NOTE: avoids struct arrays (compiler codegen bug with str fields in structs);
; uses parallel []str arrays instead.

; is-word-char: check if byte is part of a word (letter, digit, or underscore)
is-word-char = (b byte) (yes bool) {
    yes = false
    {
        b >= 65 && b <= 90 -> yes = true

        b >= 97 && b <= 122 -> yes = true

        b >= 48 && b <= 57 -> yes = true

        b == 95 -> yes = true
    }
}

; split-words: split a line into words, return []str of words
split-words = (line str) (words []str) {
    n = line.len-bytes()
    i = 0
    (i < n) {

        ; skip non-word chars
        done-skip = false
        (! done-skip) {
            {
                i >= n -> {
                    done-skip = true
                    break
                }
            }
            wc = false
            b-opt = line.byte(i)
            b = b-opt: {
                ok -> it

                -> 0
            }
            wc = is-word-char(b)
            {
                wc -> {
                    done-skip = true
                    break
                }
            }

            #{overflow=wrap}
            i = i + 1: {
                ok -> it

                -> _
            }
        }
        i >= n -> break

        ; collect word
        start = i
        done-word = false
        (! done-word) {
            {
                i >= n -> {
                    done-word = true
                    break
                }
            }
            wc3 = false
            b3-opt = line.byte(i)
            b3 = b3-opt: {
                ok -> it

                -> 0
            }
            wc3 = is-word-char(b3)
            {
                ! wc3 -> {
                    done-word = true
                    break
                }
            }

            #{overflow=wrap}
            i = i + 1: {
                ok -> it

                -> _
            }
        }
        seg = ''
        seg-opt = line.slice(start, i)
        seg-opt: {
            ok -> seg = it

            -> _
        }
        words.push(seg)
    }
}

ptx-run = () {
    argc = os.args().len()

    before-ctx = 0
    after-ctx = 0
    ignore-case = false

    ; parse options (manual loop to skip option arguments)
    file-start = 2
    i = 2
    (i < argc) {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            a == '-A' -> {

                #{overflow=wrap}
                i + 1 < argc -> {
                    nidx-opt = i + 1
                    nidx i64 = 0
                    nidx-opt: {
                        ok -> {
                            nidx = it
                        }

                        -> {
                        }
                    }
                    ns-opt = os.arg(nidx)
                    ns = ns-opt: {
                        ok -> it

                        -> ''
                    }
                    after-ctx = 0
                    j <- [0..ns.len()): {
                        ns[j] >= 48 && ns[j] <= 57 -> after-ctx = after-ctx * 10 + (ns[j] - 48)
                    }
                }

                #{overflow=wrap}
                i = i + 2: {
                    ok -> it

                    -> _
                }
                file-start = i
                continue
            }

            a == '-B' -> {

                #{overflow=wrap}
                i + 1 < argc -> {

                    #{overflow=wrap}
                    nidx-opt = i + 1
                    nidx i64 = 0
                    nidx-opt: {
                        ok -> {
                            nidx = it
                        }

                        -> {
                        }
                    }
                    ns-opt = os.arg(nidx)
                    ns = ns-opt: {
                        ok -> it

                        -> ''
                    }
                    before-ctx = 0
                    j <- [0..ns.len()): {

                        #{overflow=wrap}
                        ns[j] >= 48 && ns[j] <= 57 -> before-ctx = before-ctx * 10 + (ns[j] - 48)
                    }
                }

                #{overflow=wrap}
                i = i + 2: {
                    ok -> it

                    -> _
                }
                file-start = i
                continue
            }

            a == '-r' -> {
                ignore-case = true

                #{overflow=wrap}
                i = i + 1: {
                    ok -> it

                    -> _
                }
                file-start = i
                continue
            }

            a.starts-with('-') -> {

                #{overflow=wrap}
                i = i + 1: {
                    ok -> it

                    -> _
                }
                file-start = i
                continue
            }
        }

        ; non-flag arg: first file
        file-start = i
        break
    }

    ; collect all text
    all-text = ''
    has-file = false
    i <- [file-start..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        ! a.starts-with('-') -> {
            has-file = true
            ! fs.is-file(a) -> {
                eprint('ptx: ' - a - ': No such file')
                exit(1)
            }
            content = ''
            r = fs.read-str(a)
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            all-text = all-text - content
        }
    }

    {
        ! has-file -> {
            all-text = ''
            r = fs.read-stdin-str()
            r: {
                ok -> all-text = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }

    ; split into lines
    lines []str
    start = 0
    j <- [0..all-text.len()): {
        all-text[j] == 10 -> {
            ln = all-text.slice(start, j): {
                ok -> it

                -> ''
            }
            lines.push(ln)

            #{overflow=wrap}
            start = j + 1
        }
    }
    start < all-text.len() -> {
        ln2 = all-text.slice(start, all-text.len()): {
            ok -> it

            -> ''
        }
        lines.push(ln2)
    }

    ; build index entries as formatted strings (avoid struct arrays)
    ; format: "word|before-context|after-context" (pipe-separated, no escape seqs)
    entries []str
    sort-keys []str

    j <- [0..lines.len()): {
        line = lines[j]: {
            ok -> it

            -> ''
        }
        words = split-words(line)
        nw = words.len()
        k <- [0..nw): {
            w = words[k]: {
                ok -> it

                -> ''
            }

            ; build before context
            before-part = ''

            #{overflow=wrap}
            bstart = k - before-ctx
            bstart < 0 -> bstart = 0
            b <- [bstart..k): {
                before-part.len() > 0 -> before-part = before-part - ' '
                wb = words[b]: {
                    ok -> it

                    -> ''
                }
                before-part = before-part - wb
            }

            ; build after context
            after-part = ''

            #{overflow=wrap}
            aend = k + after-ctx + 1
            aend > nw -> aend = nw
            b <- [k + 1..aend): {
                after-part.len() > 0 -> after-part = after-part - ' '
                wb2 = words[b]: {
                    ok -> it

                    -> ''
                }
                after-part = after-part - wb2
            }

            ; format output line
            out-line = w - '|' - before-part - '|' - after-part
            entries.push(out-line)

            ; sort key: word (lowercased if -r)
            sk = w
            ignore-case -> {
                lw = w.to-lower(): {
                    ok -> it

                    -> w
                }
                sk = lw
            }
            sort-keys.push(sk)
        }
    }

    ; simple sort by sort-keys (bubble sort on parallel arrays)
    ne = entries.len()
    si <- [0..ne): {
        sj <- [si + 1..ne): {
            ksj-opt = sort-keys[sj]
            ksj = ksj-opt: {
                ok -> it

                -> ''
            }
            ksi-opt = sort-keys[si]
            ksi = ksi-opt: {
                ok -> it

                -> ''
            }
            ksj.compare(ksi) < 0 -> {

                ; swap entries
                te = entries[si]
                tes str = ''
                te: {
                    ok -> tes = it

                    ->
                }
                tj = entries[sj]
                tjs str = ''
                tj: {
                    ok -> tjs = it

                    ->
                }
                entries[si]: {
                    ok -> it = tjs

                    -> _
                }
                entries[sj]: {
                    ok -> it = tes

                    -> _
                }

                ; swap sort keys
                ke = sort-keys[si]
                kes str = ''
                ke: {
                    ok -> kes = it

                    ->
                }
                kj = sort-keys[sj]
                kjs str = ''
                kj: {
                    ok -> kjs = it

                    ->
                }
                sort-keys[si]: {
                    ok -> it = kjs

                    -> _
                }
                sort-keys[sj]: {
                    ok -> it = kes

                    -> _
                }
            }
        }
    }

    ; output: format as "before  word  after"
    j <- [0..ne): {
        ent = entries[j]: {
            ok -> it

            -> ''
        }

        ; find first pipe (separates word from before)
        t1 = ent.index('|')
        t1 < 0 -> {
            print(ent)
            continue
        }
        word = ent.slice(0, t1)

        #{overflow=wrap}
        rest-opt = ent.slice(t1 + 1, ent.len())
        rest = rest-opt: {
            ok -> it

            -> ''
        }

        ; find second pipe (separates before from after)
        t2 = rest.index('|')
        before-part = rest
        after-part = ''
        t2 >= 0 -> {
            before-part = rest.slice(0, t2)

            #{overflow=wrap}
            after-part = rest.slice(t2 + 1, rest.len())
        }

        ; format output
        out = before-part
        out.len() > 0 -> out = out - ' '

        out = out - word
        after-part.len() > 0 -> out = out - ' ' - after-part
        print(out)
    }
}
