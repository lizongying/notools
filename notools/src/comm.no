; comm.no — comm utility
; Compare two sorted files line by line
; Usage: comm [-123] file1 file2
;   -1: suppress column 1 (lines only in file1)
;   -2: suppress column 2 (lines only in file2)
;   -3: suppress column 3 (lines in both)
; Output: three tab-separated columns by default

; split: split content into lines
; NOTE: content.slice returns a VIEW sharing content's buffer; we append `- ''`
; to force an owned copy so lines stay valid independent of content's lifetime.
split = (content str, lines []str) {
    start = 0
    i <- [0..content.len-bytes()): {
        content[i] == 10 -> {
            lines.push(content.slice(start, i) - '')

            #{overflow=wrap}
            start = i + 1
        }
    }
    start < content.len-bytes() -> lines.push(content.slice(start, content.len-bytes()) - '')
}

comm-run = () {
    argc = args()
    sup1 = false
    sup2 = false
    sup3 = false
    files []str

    i <- [2..argc): {
        a = arg(i)
        a.starts-with('-') -> {
            a.len-bytes() > 1 -> {
                j <- [1..a.len-bytes()): {
                    a[j] == 49 -> sup1 = true
                    a[j] == 50 -> sup2 = true
                    a[j] == 51 -> sup3 = true
                }
            }
        }
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len() < 2 -> {
            eprint('Usage: comm [-123] file1 file2')
            os.exit(1)
        }
    }

    ; Read both files
    content1 = ''
    r = fs.read-str(files[0])
    r: {
        ok -> content1 = it

        nil -> {
        }

        err -> {
        }
    }
    content2 = ''
    r = fs.read-str(files[1])
    r: {
        ok -> content2 = it

        nil -> {
        }

        err -> {
        }
    }
    lines1 []str
    lines2 []str
    split(content1, lines1)
    split(content2, lines2)

    ; Merge-like comparison (assumes both are sorted)
    i1 = 0
    i2 = 0
    n1 = lines1.len()
    n2 = lines2.len()

    ; Merge-like comparison (assumes both are sorted).
    ; The loop body is ONE explicit {} group: `cond -> arm` lines written as
    ; DIRECT children of a loop body are independent ifs (they all execute),
    ; NOT an if/elif chain. Only an explicit group short-circuits.
    (i1 < n1 || i2 < n2) {
        {
            i1 < n1 -> i2 < n2 -> {
                cmp = lines1[i1].compare(lines2[i2])
                {
                    cmp < 0 -> {

                        ; Only in file1 -> column 1
                        emit(1, lines1[i1], sup1, sup2, sup3)

                        #{overflow=wrap}
                        i1 = i1 + 1
                    }
                    cmp > 0 -> {

                        ; Only in file2 -> column 2
                        emit(2, lines2[i2], sup1, sup2, sup3)
                        #{overflow=wrap}
                        i2 = i2 + 1
                    }
                    cmp == 0 -> {

                        ; In both -> column 3
                        emit(3, lines1[i1], sup1, sup2, sup3)
                        #{overflow=wrap}
                        i1 = i1 + 1
                        #{overflow=wrap}
                        i2 = i2 + 1
                    }
                }
            }
            i1 < n1 -> {

                ; Only file1 remaining -> column 1
                emit(1, lines1[i1], sup1, sup2, sup3)
                #{overflow=wrap}
                i1 = i1 + 1
            }
            i1 >= n1 -> {

                ; Only file2 remaining -> column 2
                emit(2, lines2[i2], sup1, sup2, sup3)

                #{overflow=wrap}
                i2 = i2 + 1
            }
        }
    }
}

; emit: output one comm row. col is 1/2/3. BSD comm prefixes as many tabs as
; there are NON-suppressed columns before the current one (so with -1, column 3
; rows get a single tab; with -12 they get none). Self-suppression skips the row.
emit = (col i64, text str, sup1 bool, sup2 bool, sup3 bool) {
    col == 1 -> sup1 -> return
    col == 2 -> sup2 -> return
    col == 3 -> sup3 -> return
    col == 2 -> ! sup1 -> io.out('\t')
    col == 3 -> {
        ! sup1 -> io.out('\t')
        ! sup2 -> io.out('\t')
    }
    io.out(text)
    io.out('\n')
}
