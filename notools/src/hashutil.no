// hashutil.no — 哈希命令共享逻辑
// 提供：字节转十六进制、按算法计算哈希、读取输入（stdin/文件）并打印
// md5/sha224/sha384 使用本地 *x 实现（stdlib 存在 str 返回丢失缺陷）；sha1/sha256/sha512 使用 stdlib -hex
# /src/md5x.md5x
# /src/sha224x.sha224x
# /src/sha384x.sha384x

// bytes-to-hex: 将字节序列转换为小写十六进制字符串
bytes-to-hex = (data []byte) (out str) {
    hex-chars = '0123456789abcdef'
    i <- [0..data.len): {
        out = out - hex-chars[(data[i] >> 4) & 15] - hex-chars[data[i] & 15]
    }
}

// do-hash: 按算法名计算哈希并返回十六进制字符串
// 注意：参数 algo 必须在本地赋值后再做值比较（编译器对参数使用引用等同比较）
// md5/sha224/sha384 使用本地 *x（返回 str），sha1/sha256/sha512 使用 stdlib -hex
do-hash = (algo str, data []byte) (hex str) {
    al = algo
    {
        al == 'md5' -> hex = md5x(data)
        al == 'sha1' -> hex = sha1.sha1-hex(data)
        al == 'sha224' -> hex = sha224x(data)
        al == 'sha256' -> hex = sha256.sha256-hex(data)
        al == 'sha384' -> hex = sha384x(data)
        al == 'sha512' -> hex = sha512.sha512-hex(data)
        al == 'blake2b' -> hex = blake2bx(data)
        -> hex = 'unknown-algorithm'
    }
}

// hash-cmd: 读取输入（stdin 或文件参数）并计算指定算法的哈希，打印结果
//   无参数：读取 stdin，打印 <hash>
//   有文件参数：逐个计算，打印 <hash>  <path>
hash-cmd = (algo str) {
    argc = args()
    al = algo
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            // stdin 為管道時 stat 大小競態可能讀空（B18），讀空則短暫重試
            t <- [0..40): {
                inp.len == 0 -> {
                    os.sleep-us(1000)
                    inp = fs.read-file('/dev/stdin')
                }
            }
            data = inp.to-bytes()
            h = do-hash(al, data)
            print(h)
        }
        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    fs.is-file(path) == false -> {
                        emsg = al - ': ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                inp = fs.read-file(path)
                data = inp.to-bytes()
                h = do-hash(al, data)
                line = h - '  ' - path
                print(line)
            }
        }
    }
}
