// hashutil.no — 哈希命令共享逻辑
// 提供：字节转十六进制、按算法计算哈希、读取输入（stdin/文件）并打印
// 依赖标准库：sha1 / sha224 / sha256 / sha384 / sha512（自动导入，优先用 -hex 辅助函数）
// md5 由本目录的 md5x.no 提供（标准库 md5.md5 返回 [16]byte 在跨包返回时存在编译器缺陷）
# /notools/src/md5x.md5x
# /notools/src/blake2bx.blake2bx

// bytes-to-hex: 将字节序列转换为小写十六进制字符串
bytes-to-hex = (data []byte) (out str) {
    hex-chars = '0123456789abcdef'
    i <- [0..data.len): {
        out = out - hex-chars[(data[i] >> 4) & 15] - hex-chars[data[i] & 15]
    }
}

// do-hash: 按算法名计算哈希并返回十六进制字符串
// 注意：参数 algo 必须在本地赋值后再做值比较（编译器对参数使用引用等同比较）
// 优先使用标准库自带的 -hex 辅助函数（返回 str，避免读取跨包固定数组的尺寸相关 bug）；
// 仅 md5 无 -hex 辅助函数，由 md5x 处理。
do-hash = (algo str, data []byte) (hex str) {
    al = algo
    {
        al == 'md5' -> hex = md5x(data)
        al == 'sha1' -> hex = sha1.sha1-hex(data)
        al == 'sha224' -> hex = sha224.sha224-hex(data)
        al == 'sha256' -> hex = sha256.sha256-hex(data)
        al == 'sha384' -> hex = sha384.sha384-hex(data)
        al == 'sha512' -> hex = sha512.sha512-hex(data)
        al == 'blake2b' -> hex = blake2bx(data)
        -> hex = 'unknown-algorithm'
    }
}

// hash-cmd: 读取输入（stdin 或文件参数）并计算指定算法的哈希，打印结果
//   无参数：读取 stdin，打印 <hash>
//   有文件参数：逐个计算，打印 <hash>  <path>
hash-cmd = (algo str) {
    argc = args()
    al = algo
    {
        argc <= 2 -> {
            // fs.read-file('/dev/stdin') uses stat to get size, which returns 0
            // for pipes. Use fs.get-line() which uses fgets (no stat needed).
            inp, ok = fs.get-line()
            data = inp.to-bytes()
            h = do-hash(al, data)
            print(h)
        }
        -> {
            i <- [2..argc): {
                path = arg(i)
                {
                    fs.is-file(path) == false -> {
                        emsg = al - ': ' - path - ': No such file or directory'
                        io.errln(emsg)
                        os.exit(1)
                    }
                }
                inp = fs.read-file(path)
                data = inp.to-bytes()
                h = do-hash(al, data)
                line = h - '  ' - path
                print(line)
            }
        }
    }
}
