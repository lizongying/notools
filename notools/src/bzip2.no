; bzip2.no — bzip2 compression utility (native Nolang)
; Uses archive/bzip2.no for compression/decompression.
; Usage: bzip2 [-c] [-d] [-k] [-f] <file...>
;   預設：壓縮檔案，生成 .bz2 並刪除原檔
;   -c  寫到標準輸出，不改動原檔
;   -d  解壓（等同 bunzip2）
;   -k  保留原檔
;   -f  強制覆寫

bzip2-cmd = () {
    argc = args()

    to-stdout = false
    decompress = false
    keep = false
    has-file = false

    i = 2
    {
        a = arg(i)
        {
            a == '-c' -> to-stdout = true

            a == '-d' -> decompress = true

            a == '-k' -> keep = true

            a == '-f' -> {
            }

            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    eprint('bzip2: ' - f - ': No such file')
                    i = i + 1
                    continue
                }
                content = fs.read-file(f)
                data = content

                {
                    decompress -> {
                        out []byte = bzip2.bzip2-decompress(data)
                        {
                            to-stdout -> {
                                s = out.to-str()
                                io.out(s)
                            }

                            -> {
                                out-name = f
                                f.ends-with('.bz2') -> out-name = f.slice(0, f.len - 4)
                                fs.write-file(out-name, out)
                                keep == false -> fs.remove(f)
                            }
                        }
                    }

                    -> {
                        out []byte = bzip2.bzip2-compress(data)
                        {
                            to-stdout -> {
                                s = out.to-str()
                                io.out(s)
                            }

                            -> {
                                out-name = f - '.bz2'
                                fs.write-file(out-name, out)
                                keep == false -> fs.remove(f)
                            }
                        }
                    }
                }
            }
        }

        i = i + 1
    } (i < argc)

    {
        has-file == false -> {
            eprint('bzip2: no input files')
            os.exit(1)
        }
    }
}
