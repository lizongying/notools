; dos2unix.no — dos2unix utility
; Convert CRLF line endings to LF
; Usage: dos2unix [FILE...]
;   No FILE: read stdin, write stdout
;   With FILE: modify in place

; convert: append converted content into out buffer
convert = (content str, out []byte) {
    n = content.len
    i = 0
    {
        c = content[i]
        ; check for CRLF
        is-crlf = false
        {
            c == 13 -> {
                i + 1 < n -> {
                    content[i + 1] == 10 -> is-crlf = true
                }
            }

            is-crlf -> {

                ; CRLF: emit LF, skip both CR and LF
                out.push(10)
                i = i + 2
            }

            is-crlf == false -> {

                ; not CRLF: copy byte as-is
                out.push(c)
                i = i + 1
            }
        }
    } (i < n)
}

dos2unix = () {
    argc = args()
    {
        argc <= 2 -> {
            inp = fs.read-file('/dev/stdin')
            t <- [0..40): {
                inp.len == 0 -> {
                    os.sleep-us(1000)
                    inp = fs.read-file('/dev/stdin')
                }
            }
            out []byte
            convert(inp, out)
            fs.write(1, out, out.len)
        }

        -> {
            i <- [2..argc): {
                path = arg(i)
                fs.is-file(path) == false -> {
                    eprint('dos2unix: ' - path - ': No such file')
                    os.exit(1)
                }
                inp = fs.read-file(path)
                out []byte
                convert(inp, out)
                fs.write-file(path, out)
            }
        }
    }
}
