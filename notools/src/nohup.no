// nohup.no — nohup utility
// Run a command ignoring SIGHUP
// Usage: nohup COMMAND [ARGS...]
//   Ignores SIGHUP (signal 1) via os.signal(SIGHUP, SIG_IGN)
//   Redirects stdout to nohup.out when stdout is a terminal
//   Returns the command's exit status
// Note: Since Nolang's process.start only supports a single arg, the command
//   is invoked via process.process-system() using a shell-style concatenation.

#{linux-amd64, linux-arm64, mac-amd64, mac-arm64}

nohup-run = () {
    argc = args()

    {
        argc < 3 -> {
            eprint('Usage: nohup COMMAND [ARGS...]')
            os.exit(1)
        }
    }

    ; Ignore SIGHUP (1) by setting SIG_IGN (1)
    os.signal(1, 1)

    ; Build command string from remaining args
    cmd = ''
    i <- [2..argc): {
        i > 2 -> cmd = cmd - ' '
        a = arg(i)
        cmd = cmd - a
    }

    ; Run command via shell, inheriting stdout/stderr
    status = process.process-system(cmd)
    os.exit(status)
}

#{win-amd64, win-arm64}
nohup-run = () {
    eprint('nohup-run: not supported on this platform')
    os.exit(1)
}
