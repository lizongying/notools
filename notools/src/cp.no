; cp.no — copy files and directories (pure Nolang, standard library only)
; Usage: cp [-r|-R] SOURCE... DEST
;   -r, -R: recursive copy (directories)
;   Multiple sources require DEST to be a directory

; base-name: extract filename from path (last segment after '/')
; handles trailing slashes (e.g. "foo/" → "foo")
base-name = (p str) (out str) {
    end = p.len
    ; skip trailing slashes
    {
        end <= 0 -> break
        p[end - 1] != 47 -> break
        end = end - 1
    } (true)
    ; find last '/' in [0..end)
    last = -1
    i <- [0..end): {
        p[i] == 47 -> last = i
    }
    start = last + 1
    n = end - start
    out = with-len(n)
    j <- [0..n): {
        out[j] = p[start + j]
    }
}

; one-file: copy a single file from src to dst
one-file = (src str, dst str) {
    data = fs.read-file(src)
    fd = fs.open-write(dst)
    n = data.len
    fs.write(fd, data, n)
    fs.close(fd)
}

; copy-tree: recursively copy a directory tree from src to dst
copy-tree = (src str, dst str) {
    ; create target directory (ignore error if it already exists)
    os.mkdir(dst, 511)

    dirp = fs.open-dir(src)
    dirp == 0 -> return

    ok = true
    for ok == true {
        name, ok = fs.read-dir(dirp)
        ok -> {
            ; skip . and ..
            skip = name == '.' || name == '..'
            skip == false -> {
                src-full = src - '/' - name
                dst-full = dst - '/' - name

                is-d = fs.is-dir(src-full)
                is-d -> copy-tree(src-full, dst-full)
                is-d == false -> {
                    is-f = fs.is-file(src-full)
                    is-f -> one-file(src-full, dst-full)
                }
            }
        }
    }
    fs.close-dir(dirp)
}

cp-run = () {
    argc = args()

    recursive = false
    n-files = 0
    dst-idx = -1

    ; first pass: parse flags, count non-flag args, find destination index
    i <- [2..argc): {
        a = arg(i)
        a == '-r' || a == '-R' -> recursive = true
        a.starts-with('-') -> {
            a.contains('r') || a.contains('R') -> recursive = true
        }
        a.starts-with('-') == false -> {
            n-files = n-files + 1
            dst-idx = i
        }
    }

    n-files < 2 -> {
        eprint('cp: missing file operand')
        os.exit(1)
    }

    dst = arg(dst-idx)
    src-count = n-files - 1

    ; multi-source: destination must be a directory
    src-count > 1 -> {
        fs.is-dir(dst) == false -> {
            eprint('cp: target ' - dst - ' is not a directory')
            os.exit(1)
        }
    }

    had-err = false

    ; second pass: copy each source (skip flags and destination arg)
    i <- [2..argc): {
        i == dst-idx -> continue
        a = arg(i)
        a.starts-with('-') -> continue

        src = a

        ; check source exists
        exists = fs.is-file(src) || fs.is-dir(src)
        exists == false -> {
            eprint('cp: ' - src - ': No such file or directory')
            had-err = true
            continue
        }

        ; determine target path
        target = dst
        fs.is-dir(dst) -> {
            bn = base-name(src)
            target = dst - '/' - bn
        }

        ; copy
        is-d = fs.is-dir(src)
        is-d -> {
            recursive -> copy-tree(src, target)
            recursive == false -> {
                eprint('cp: ' - src - ': is a directory (use -r)')
                had-err = true
            }
        }
        is-d == false -> one-file(src, target)
    }

    ; os.exit skips scope cleanup (avoids double-free on string locals);
    ; B6: only literal i64 is reliable for os.exit.
    had-err -> os.exit(1)
    os.exit(0)
}
