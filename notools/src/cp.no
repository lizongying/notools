// cp.no — copy files and directories (pure Nolang, standard library only)
// Usage: cp [-r] <source> <dest>
//
// Uses fs.read-file / fs.open-write / fs.write / fs.close and path.base().
// The Nolang runtime's one-write-per-process limitation has been fixed, so
// multi-source copy is now *possible*; however the optimizer currently
// mis-compiles the in-loop basename concat, so we keep the conservative
// single-source implementation (which still copies into a directory) and let
// the multi-source form be enabled once the optimizer is stable.

cp-one-file = (src str, dst str) {
    data = fs.read-file(src)
    fd = fs.open-write(dst)
    n = data.len
    fs.write(fd, data, n)
    fs.close(fd)
}

cp-target = (src str, dir str) (out str) {
    pp = path{ p: src }
    bn = pp.base()
    out = dir - '/' - bn
}

cp-run = () {
    argc = args()
    files []str
    i <- [2..argc): {
        a = arg(i)
        ! a.starts-with('-') -> files.push(a)
    }
    files.len < 2 -> {
        io.errln('cp: missing destination file operand')
        os.exit(1)
    }
    nsrc = files.len - 1
    nsrc > 1 -> {
        io.errln('cp: multiple-source copy is not supported yet (optimizer mis-compiles the in-loop basename concat)')
        os.exit(1)
    }
    src = files[0]
    dst = files[1]
    exists = fs.is-file(src) || fs.is-dir(src)
    exists == false -> {
        io.errln('cp: ' - src - ': No such file or directory')
        os.exit(1)
    }
    target = dst
    fs.is-dir(dst) -> target = cp-target(src, dst)
    is-d = fs.is-dir(src)
    is-d == false -> cp-one-file(src, target)
}
