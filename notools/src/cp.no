// cp.no — cp utility
// Copy files and directories
// Usage: cp [-r] [-f] <source...> <dest>
//   -r: copy directories recursively
//   -f: force (overwrite existing destination without prompt)

cp-one-file = (src str, dst str) {
    ok = fs.copy-file(src, dst)
    ok == false -> io.errln('cp: ' - src - ': failed to copy to ' - dst)
}

cp-recursive = (src str, dst str) {
    ok = os.mkdir(dst, 493)
    ok == false -> io.errln('cp: ' - dst - ': cannot create directory')
    names = fs.list-dir(src)
    i <- [0..names.len): {
        name = names[i]
        skip = name == '.' || name == '..'
        skip == false -> {
            full = src - '/' - name
            target = dst - '/' - name
            {
                fs.is-dir(full) -> cp-recursive(full, target)
                -> cp-one-file(full, target)
            }
        }
    }
}

cp-run = () {
    argc = args()
    recursive = false
    files []str
    i <- [2..argc): {
        a = arg(i)
        a == '-r' -> recursive = true
        a == '-R' -> recursive = true
        a == '-f' -> recursive = true
        ! a.starts-with('-') -> files.push(a)
    }
    files.len < 2 -> {
        print('Usage: cp [-r] <source...> <dest>')
        os.exit(1)
    }
    dest = files[files.len - 1]
    nsrc = files.len - 1
    dest-is-dir = fs.is-dir(dest)
    i <- [0..nsrc): {
        src = files[i]
        exists = fs.is-file(src) || fs.is-dir(src)
        exists == false -> {
            io.errln('cp: ' - src - ': No such file or directory')
            continue
        }
        target = dest
        dest-is-dir || nsrc > 1 -> {
            pp = path{ p: src }
            base-name = pp.base()
            target = dest - '/' - base-name
        }
        is-d = fs.is-dir(src)
        is-d -> {
            recursive == false -> {
                io.errln('cp: ' - src - ': omitting directory')
                continue
            }
            cp-recursive(src, target)
        }
        is-d == false -> cp-one-file(src, target)
    }
}
