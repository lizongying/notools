; cp.no — copy files and directories (pure Nolang, standard library only)
; Usage: cp [-r|-R] SOURCE... DEST
;   -r, -R: recursive copy (directories)
;   Multiple sources require DEST to be a directory

; base-name: extract filename from path (last segment after '/')
; handles trailing slashes (e.g. "foo/" → "foo")
base-name = (p str) (out str) {
    end = p.len()

    ; skip trailing slashes
    !! {
        end <= 0 -> break

        #{overflow=wrap}
        p[end - 1] != 47 -> break

        #{overflow=wrap}
        end = end - 1
    }

    ; find last '/' in [0..end)
    last = -1
    i <- [0..end): {
        p[i] == 47 -> last = i
    }

    #{overflow=wrap}
    start = last + 1

    #{overflow=wrap}
    n = end - start
    out = with-len(n)
    j <- [0..n): {

        #{overflow=wrap}
        sj = start + j: {
            ok -> it

            -> _
        }
        d9v1 byte = p.byte(sj): {
            ok -> it

            -> 0
        }
        out[j]: {
            ok -> it = d9v1

            -> _
        }
    }
}

; one-file: copy a single file from src to dst
; 返回是否成功。读失败绝不写空文件覆盖目标（T-4）。
one-file = (src str, dst str) (ok bool) {
    ok = false
    data []byte
    r = fs.read-bytes(src)
    r: {
        ok -> {
            data = it
            ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    ! ok -> {
        eprint('cp: ' - src - ': read failed, refusing to write ' - dst)
        return
    }
    fd = fs.open-write(dst)
    n = data.len()
    fs.write(fd, data, n)
    fs.close(fd)
}

; copy-tree: recursively copy a directory tree from src to dst
; 返回是否成功（任一子文件读失败即失败）。
copy-tree = (src str, dst str) (all-ok bool) {
    all-ok = true
    ; 入口符号链接防护：readlink 命中的是链接，直接拒绝递归避免成环（T-4）。
    is-lnk = fs.readlink(src)
    is-lnk: {
        ok -> {
            eprint('cp: ' - src - ': symbolic link, skipped')
            all-ok = false
            return
        }

        -> {
        }
    }

    ; create target directory (ignore error if it already exists)
    os.mkdir(dst, 511)

    dirp = fs.open-dir(src)
    dirp == 0 -> return

    ok = true
    (ok) {
        name-opt = fs.read-dir(dirp)
        name = ''
        ok = false
        name-opt: {
            ok -> {
                name = it
                ok = true
            }

            -> {
            }
        }
        {
            ok -> {

                ; skip . and ..
                skip = name == '.' || name == '..'
                ! skip -> {
                    src-full = src - '/' - name
                    dst-full = dst - '/' - name

                    ; 目录内条目先判链接，避免跟随符号链接成环（T-4）。
                    lnk = fs.readlink(src-full)
                    lnk: {
                        ok -> eprint('cp: ' - src-full - ': symbolic link, skipped')

                        -> {
                            is-d = fs.is-dir(src-full)
                            is-d -> {
                                sub-ok = copy-tree(src-full, dst-full)
                                ! sub-ok -> all-ok = false
                            }
                            ! is-d -> {
                                is-f = fs.is-file(src-full)
                                is-f -> {
                                    f-ok = one-file(src-full, dst-full)
                                    ! f-ok -> all-ok = false
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    fs.close-dir(dirp)
}

cp-run = () {
    argc = os.args().len()

    recursive = false
    n-files = 0
    dst-idx = -1

    ; first pass: parse flags, count non-flag args, find destination index
    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-r' || a == '-R' -> recursive = true
        a.starts-with('-') -> {
            a.contains('r') || a.contains('R') -> recursive = true
        }
        ! a.starts-with('-') -> {

            #{overflow=wrap}
            n-files = n-files + 1: {
                ok -> it

                -> _
            }
            dst-idx = i
        }
    }

    {
        n-files < 2 -> {
            eprint('cp: missing file operand')
            exit(1)
        }
    }

    dst-opt = os.arg(dst-idx)
    dst = dst-opt: {
        ok -> it

        -> ''
    }

    #{overflow=wrap}
    src-count = n-files - 1

    ; multi-source: destination must be a directory
    {
        src-count > 1 -> {
            ! fs.is-dir(dst) -> {
                eprint('cp: target ' - dst - ' is not a directory')
                exit(1)
            }
        }
    }

    had-err = false

    ; second pass: copy each source (skip flags and destination arg)
    i <- [2..argc): {
        i == dst-idx -> continue
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a.starts-with('-') -> continue

        src = a

        ; check source exists
        exists = fs.is-file(src) || fs.is-dir(src)
        ! exists -> {
            eprint('cp: ' - src - ': No such file or directory')
            had-err = true
            continue
        }

        ; determine target path
        target = dst
        fs.is-dir(dst) -> {
            bn = base-name(src)

            target = dst - '/' - bn
        }

        ; copy
        is-d = fs.is-dir(src)
        is-d -> {
            recursive -> {
                c-ok = copy-tree(src, target)
                ! c-ok -> had-err = true
            }
            ! recursive -> {
                eprint('cp: ' - src - ': is a directory (use -r)')
                had-err = true
            }
        }
        ! is-d -> {
            f-ok = one-file(src, target)
            ! f-ok -> had-err = true
        }
    }

    had-err -> exit(1)
}

#{win-amd64, win-arm64}
cp-run-win = () {
    eprint('cp-run: not supported on this platform')
    exit(1)
}
