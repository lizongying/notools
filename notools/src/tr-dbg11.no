tr-run = () {
    argc = args()
    set1 = ''
    set2 = ''
    i <- [2..argc): { a = arg(i); a == '-d' -> { continue }; ! a.starts-with('-') -> { set1 == '' -> set1 = a; set1 != '' -> set2 = a } }
    s1 [256]i64
    s2 [256]i64
    n1 = 0
    n2 = 0
    skip = 0
    i2 = 0
    for i2 < set1.len {
        do-skip = 0
        skip == 1 -> do-skip = 1
        skip == 1 -> skip = 0
        ch = set1[i2]
        is-range = 0
        do-skip == 0 -> i2 > 0 -> i2 < set1.len - 1 -> ch == 45 -> is-range = 1
        do-skip == 0 -> is-range == 0 -> { s1[n1] = ch; n1 = n1 + 1 }
        do-skip == 0 -> is-range == 1 -> { lo = set1[i2 - 1]; hi = set1[i2 + 1]; skip = 1; lo <= hi -> hend = hi + 1; lo <= hi -> { k <- [lo..hend): { s1[n1] = k; n1 = n1 + 1 } } }
        i2 = i2 + 1
    }
    printf('n1=%d n2=%d\n', n1, n2)
    print('OK')
}
main = () { tr-run() }
