// tr.no — translate or delete characters
// Usage: tr [-d] SET1 [SET2]
//   -d     : delete characters in SET1
//   SET1   : characters to translate (ranges like a-z supported)
//   SET2   : replacement characters (ranges in SET2 are supported;
//            if shorter than SET1, last char repeats; if longer, extras ignored)

tr-run = () {
    // NOTE: in this compiler, args() returns garbage (runtime crash / wrong
    // values) and arg(i) with a loop variable triggers an opt bug. tr only
    // ever has a few argument positions, so we read them via LITERAL indices.
    a2 = arg(2)
    a3 = arg(3)
    a4 = arg(4)
    dmode = 0
    a2 == '-d' -> dmode = 1
    dmode == 0 -> {
        set1 = a2
        set2 = a3
    }
    dmode == 1 -> {
        set1 = a3
        set2 = a4
    }
    set1 == '' -> {
        io.errln('Usage: tr [-d] SET1 [SET2]')
        os.exit(1)
    }
    maxb = 256

    // ---- expand SET1 -> from-chars (ranges supported) ----
    from-chars []i64
    n <- [0..set1.len): {
        b = set1[n]
        is-dash = 0
        n > 0 -> n < set1.len - 1 -> b == 45 -> is-dash = 1
        is-range-lo = 0
        n < set1.len - 2 -> set1[n + 1] == 45 -> is-range-lo = 1
        is-range-lo == 1 -> { lo = b }
        is-range-lo == 1 -> { hi = set1[n + 2] }
        is-range-lo == 1 -> { hend = hi + 1 }
        is-range-lo == 1 -> { k <- [lo..hend): { from-chars.push(k) } }
        is-range-lo == 0 -> is-dash == 0 -> {
            skip = 0
            n > 0 -> set1[n - 1] == 45 -> skip = 1
            skip == 0 -> from-chars.push(b)
        }
    }
    n1 = from-chars.len

    // ---- expand SET2 -> to2 (ranges supported) ----
    to2 []i64
    m <- [0..set2.len): {
        b = set2[m]
        is-dash2 = 0
        m > 0 -> m < set2.len - 1 -> b == 45 -> is-dash2 = 1
        is-range-lo2 = 0
        m < set2.len - 2 -> set2[m + 1] == 45 -> is-range-lo2 = 1
        is-range-lo2 == 1 -> { lo = b }
        is-range-lo2 == 1 -> { hi = set2[m + 2] }
        is-range-lo2 == 1 -> { hend = hi + 1 }
        is-range-lo2 == 1 -> { k <- [lo..hend): { to2.push(k) } }
        is-range-lo2 == 0 -> is-dash2 == 0 -> {
            skip = 0
            m > 0 -> set2[m - 1] == 45 -> skip = 1
            skip == 0 -> to2.push(b)
        }
    }
    n2 = to2.len

    // ---- pad to2 to match n1 (repeat last char) ----
    pad = n1 - n2
    pad > 0 -> n2 > 0 -> { last = to2[n2 - 1] }
    pad > 0 -> n2 > 0 -> { q <- [0..pad): { to2.push(last) } }

    // ---- build xlat[256] (translate) and delb[256] (delete) ----
    xlat []i64
    build-xlat = 0
    n2 > 0 -> build-xlat = 1
    build-xlat == 1 -> {
        xb <- [0..maxb): {
            res []i64
            res.push(xb)
            p <- [0..n1): { from-chars[p] == xb -> res.push(to2[p]) }
            xlat.push(res[res.len - 1])
        }
    }
    build-xlat == 0 -> { xb <- [0..maxb): { xlat.push(xb) } }

    delb []i64
    db <- [0..maxb): {
        res []i64
        res.push(0)
        p <- [0..n1): { from-chars[p] == db -> res.push(1) }
        delb.push(res[res.len - 1])
    }

    // ---- process stdin ----
    content = fs.read-file('/dev/stdin')
    q <- [0..content.len): {
        c = content[q]
        dmode == 0 -> io.out(char-to-str(xlat[c]))
        dmode == 1 -> delb[c] == 0 -> io.out(char-to-str(c))
    }
    print('')
}
