; pkill.no — pkill utility
; Send a signal to processes by name
; Usage: pkill [-SIGNAL|-s SIGNAL] [-f] NAME
;   -SIGNAL:   signal by name (e.g. -TERM) or number (e.g. -9)
;   -s SIGNAL: signal by name or number
;   -f:        match against full command line (simplified: same as name match)
;   Default signal: TERM (15)
; Note: Process matching uses process.list-all() which only works on Linux.

; sig-name: parse signal name or number to signal number
; Accepts: '9', 'TERM', 'SIGTERM', 'SIG-TERM' (case-insensitive)
; Returns -1 on unknown signal name
sig-name = (s str) (sig i64) {
    sig = -1
    s.len == 0 -> return
    first = s[0]
    {
        first >= 48 && first <= 57 -> {
            v = 0
            i <- [0..s.len): {
                c = s[i]
                c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
            }
            sig = v
            return
        }
    }
    upper = s.to-upper()
    {
        upper.starts-with('SIG-') -> upper = upper.slice(4, upper.len)
        upper.starts-with('SIG') -> upper = upper.slice(3, upper.len)
    }
    {
        upper == 'HUP'    -> sig = 1
        upper == 'INT'    -> sig = 2
        upper == 'QUIT'   -> sig = 3
        upper == 'ILL'    -> sig = 4
        upper == 'TRAP'   -> sig = 5
        upper == 'ABRT'   -> sig = 6
        upper == 'BUS'    -> sig = 7
        upper == 'FPE'    -> sig = 8
        upper == 'KILL'   -> sig = 9
        upper == 'USR1'   -> sig = 10
        upper == 'SEGV'   -> sig = 11
        upper == 'USR2'   -> sig = 12
        upper == 'PIPE'   -> sig = 13
        upper == 'ALRM'   -> sig = 14
        upper == 'TERM'   -> sig = 15
        upper == 'STKFLT' -> sig = 16
        upper == 'CHLD'   -> sig = 17
        upper == 'CONT'   -> sig = 18
        upper == 'STOP'   -> sig = 19
        upper == 'TSTP'   -> sig = 20
        upper == 'TTIN'   -> sig = 21
        upper == 'TTOU'   -> sig = 22
        upper == 'URG'    -> sig = 23
        upper == 'XCPU'   -> sig = 24
        upper == 'XFSZ'   -> sig = 25
        upper == 'VTALRM' -> sig = 26
        upper == 'PROF'   -> sig = 27
        upper == 'WINCH'  -> sig = 28
        upper == 'IO'     -> sig = 29
        upper == 'PWR'    -> sig = 30
        upper == 'SYS'    -> sig = 31
    }
}

pkill-run = () {
    argc = args()

    sig = 15  ; SIG-TERM default
    next-is-signal = false
    names []str

    i <- [2..argc): {
        handled = false
        {
            next-is-signal -> {
                a = arg(i)
                parsed = sig-name(a)
                parsed < 0 -> {
                    eprint('pkill: unknown signal ' - a)
                    os.exit(1)
                }
                sig = parsed
                next-is-signal = false
                handled = true
            }
        }
        {
            handled == false -> {
                a = arg(i)
                {
                    a == '-f' -> {
                        handled = true
                    }
                    a == '-s' -> {
                        next-is-signal = true
                        handled = true
                    }
                    a.starts-with('-s') && a.len > 2 -> {
                        cand = a.slice(2, a.len)
                        parsed = sig-name(cand)
                        parsed < 0 -> {
                            eprint('pkill: unknown signal ' - cand)
                            os.exit(1)
                        }
                        sig = parsed
                        handled = true
                    }
                    a.starts-with('-') && a.len > 1 -> {
                        cand = a.slice(1, a.len)
                        parsed = sig-name(cand)
                        parsed >= 0 -> {
                            sig = parsed
                            handled = true
                        }
                    }
                }
                {
                    handled == false -> {
                        ! a.starts-with('-') -> names.push(a)
                    }
                }
            }
        }
    }

    {
        names.len == 0 -> {
            eprint('Usage: pkill [-SIGNAL|-s SIGNAL] [-f] NAME')
            os.exit(1)
        }
    }

    i <- [0..names.len): {
        name = names[i]
        pids = process.find-by-name(name)
        j <- [0..pids.len): {
            process.process-kill(pids[j], sig)
        }
    }
}
