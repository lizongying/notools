; cat.no — cat utility
; Concatenates and prints file contents to stdout
; Usage: cat [-n] [-b] [-e] [-t] [-v] [-s] [file...]
;   -n: number all output lines   ("%6d\t")
;   -b: number non-blank output lines only
;   -e: display line ends with '$' (implies -v)
;   -t: display tabs as '^I' (implies -v)
;   -v: show non-printing characters (caret / M- notation)
;   -s: squeeze adjacent blank lines into one

; PRINTABLE: bytes 32..126 in order, used to render a byte as its character.
PRINTABLE = ' !"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~'

; printable-char maps a byte (assumed in a printable range) to its 1-char str.
printable-char = (b i64) (c str) {

    #{overflow=wrap}
    c = PRINTABLE.slice-bytes(b - 32, b - 31)
}

; pad-number renders n right-aligned in 6 columns.
pad-number = (n i64) (s str) {
    raw = n.to-str()
    width = raw.len-bytes()

    #{overflow=wrap}
    pad = 6 - width
    pad < 0 -> pad = 0
    sp = ''
    p <- [0..pad): {
        sp = sp - ' '
    }
    s = sp - raw
}

; visual-b byte: caret/tilde/M- notation for non-printing bytes.
visual-b = (b i64, show-tab bool) {
    {
        b == 9 -> {
            show-tab -> io.out('^I')

            -> io.out("\t")
        }

        b < 32 -> {

            #{overflow=wrap}
            c = b + 64
            io.out('^')
            io.out(printable-char(c))
        }

        b == 127 -> {
            io.out('^')
            io.out('?')
        }

        b >= 32 && b < 127 -> io.out(printable-char(b))

        -> {
            io.out('M-')

            #{overflow=wrap}
            io.out(printable-char(b - 128))
        }
    }
}

; visual-line: print one raw line, optionally tab->^I and trailing '$'
visual-line = (content str, s i64, e i64, show-tab bool, ends-nl bool, show-dollar bool) {
    p <- [s..e): {
        visual-b(content[p], show-tab)
    }
    {
        show-dollar && ends-nl -> io.out('$') -> {}
    }
}

; cat-emit: process content applying flags.
cat-emit = (content str, number-all bool, number-nonblank bool, squeeze bool, vis-tab bool, vis-end bool, vis-ctl bool) {
    clen = content.len-bytes()
    number = number-all || number-nonblank
    show-tab = vis-tab
    show-dollar = vis-end
    line-no = 0
    blank-run = 0
    s = 0
    (s < clen) {
        nl = clen
        found = false
        q <- [s..clen): {
            ! found -> {
                {
                    content[q] == 10 -> {
                        nl = q
                        found = true
                    }

                    -> {
                    }
                }
            }
        }
        ends-nl = found
        e = nl

        #{overflow=wrap}
        next = nl + 1
        is-blank = ends-nl && e == s
        {
            squeeze && is-blank -> {

                #{overflow=wrap}
                blank-run = blank-run + 1
                {
                    blank-run >= 2 -> {
                        s = next
                        continue
                    }

                    -> {
                    }
                }
            }

            -> {
                blank-run = 0
            }
        }
        {
            number -> {
                print-no = number-all || (number-nonblank && ! is-blank)
                {
                    print-no -> {

                        #{overflow=wrap}
                        line-no = line-no + 1
                        io.out(pad-number(line-no) - "\t")
                    }

                    -> {
                    }
                }
            }

            -> {
            }
        }
        {
            vis-tab || vis-end || vis-ctl -> visual-line(content, s, e, show-tab, ends-nl, show-dollar)

            -> io.out(content.slice(s, e))
        }
        {
            ends-nl -> io.out("\n") -> {}
        }
        ! ends-nl -> s = clen
        {
            ends-nl -> s = next

            -> {
            }
        }
    }
}

cat-run = () {
    argc = os.args()
    number-all = false
    number-nonblank = false
    squeeze = false
    vis-tab = false
    vis-end = false
    vis-ctl = false
    files []str
    i <- [2..argc): {
        a = os.arg(i)
        {
            a.starts-with('-') && a != '-' -> {
                alen = a.len-bytes()
                j <- [1..alen): {
                    c = a[j]
                    {
                        c == 110 -> number-all = true

                        -> {
                        }
                    }
                    {
                        c == 110 -> number-nonblank = false

                        -> {
                        }
                    }
                    {
                        c == 98 -> number-nonblank = true

                        -> {
                        }
                    }
                    {
                        c == 98 -> number-all = false

                        -> {
                        }
                    }
                    {
                        c == 115 -> squeeze = true

                        -> {
                        }
                    }
                    {
                        c == 116 -> vis-tab = true

                        -> {
                        }
                    }
                    {
                        c == 101 -> vis-end = true

                        -> {
                        }
                    }
                    {
                        c == 118 -> vis-ctl = true

                        -> {
                        }
                    }
                }
            }

            -> files.push(a)
        }
    }
    {
        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            cat-emit(content, number-all, number-nonblank, squeeze, vis-tab, vis-end, vis-ctl)
        }

        -> {
            had-error = false
            fi <- [0..files.len()): {

                #{index-out=zero}
                path = files[fi]
                ! fs.is-file(path) -> {
                    io.errln('cat: ' - path - ': No such file or directory')
                    had-error = true
                    continue
                }
                content = ''
                r = fs.read-str(path)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                cat-emit(content, number-all, number-nonblank, squeeze, vis-tab, vis-end, vis-ctl)
            }
            had-error -> os.exit(1)

            -> {}
        }
    }
}
