// cat.no — cat utility
// Concatenates and prints file contents to stdout
// Usage: cat [file...]
//   - No args: reads stdin, writes to stdout (passthrough)
//   - One or more files: outputs each file's contents in order
//   - Non-existent files: prints error to stderr, continues with remaining files

cat-run = () {
    argc = args()

    argc <= 2 -> {
        content = fs.read-file('/dev/stdin')
        io.out(content)
    }
    argc > 2 -> {
        // File arguments: read and output each file
        i <- [2..argc): {
            path = arg(i)
            exists = fs.is-file(path)
            exists == false -> {
                msg = 'cat: ' - path - ': No such file or directory'
                io.errln(msg)
            }
            exists -> {
                content = fs.read-file(path)
                io.out(content)
            }
        }
    }
}
