; uncompress.no — uncompress utility (LZW decompression, pure Nolang)
; Decompresses .Z files created by compress(1)
; Usage: uncompress [-c] FILE...
;   -c  write to stdout

uncompress-cmd = () {
    argc = os.args().len()
    to-stdout = false
    has-file = false

    i = 2
    (i < argc) {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            a == '-c' -> to-stdout = true

            a == '-f' -> continue

            ! a.starts-with('-') -> {
                has-file = true
                f = a

                ! fs.is-file(f) -> {
                    eprint('uncompress: ' - f - ': No such file')

                    #{overflow=wrap}
                    i = i + 1: {
                        ok -> it

                        -> _
                    }
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = content
                out = lzw-decompress(data)

                out.len() == 0 -> {
                    eprint('uncompress: ' - f - ': not in compressed format')

                    #{overflow=wrap}
                    i = i + 1: {
                        ok -> it

                        -> _
                    }
                    continue
                }

                {
                    to-stdout -> {
                        tb0o = out.to-str()
                        tb0v = tb0o: {
                            ok -> it
                        
                            nil || err -> ''
                        }
                        s = tb0v
                        io.out(s)
                    }

                    -> {
                        out-name = f

                        #{overflow=wrap}
                        f.ends-with('.Z') -> out-name = f.slice(0, f.len() - 2)
                        fs.write-file(out-name, out)
                        fs.remove(f)
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }

    {
        ! has-file -> {
            content []byte
            r = fs.read-stdin()
            r: {
                ok -> content = it

                nil -> {
                }

                err -> {
                }
            }
            data = content
            out = lzw-decompress(data)
            out.len() == 0 -> {
                eprint('uncompress: not in compressed format')
                exit(1)
            }
            tb1o = out.to-str()
            tb1v = tb1o: {
                ok -> it
            
                nil || err -> ''
            }
            s = tb1v
            io.out(s)
        }
    }
}

; lzw-decompress: LZW decompression of .Z format
; data []byte: compressed data with header
; returns out []byte: decompressed data (empty if invalid)
lzw-decompress = (data []byte) (out []byte) {
    data-len = data.len()
    {
        data-len < 3 -> return

        ; Verify magic header
        d0 = data[0]: {
            ok -> it

            -> 0
        }
        d0 != 31 -> return

        d1 = data[1]: {
            ok -> it

            -> 0
        }
        d1 != 157 -> return
    }

    ; Parse flags
    d2 = data[2]: {
        ok -> it

        -> 0
    }
    flags = d2 & 255
    max-bits = (flags >> 5) & 7
    block-mode = (flags >> 4) & 1
    {
        max-bits < 9 -> return

        max-bits > 16 -> return
    }

    ; Calculate max-codes = 2^max-bits
    max-codes = 1
    j <- [0..max-bits): {

        #{overflow=wrap}
        max-codes = max-codes * 2: {
            ok -> it

            -> _
        }
    }

    ; Dictionary: prefix[code], suffix[code]
    prefix []i64 = with-len(max-codes)
    suffix []i64 = with-len(max-codes)
    j <- [0..256): {
        prefix[j]: {
            ok -> it = -1

            -> _
        }
        suffix[j]: {
            ok -> it = j

            -> _
        }
    }

    clear-code = 256
    first-code = 257
    next-code = 257
    cur-bits = 9

    ; Bit input buffer
    bit-buf = 0
    bit-count = 0
    pos = 3

    ; Codes read at current width (for alignment)
    codes-read = 0

    ; String reconstruction stack
    stack []byte

    ; Read first code
    first = true
    old-code = -1

    (pos < data-len || bit-count >= cur-bits) {

        ; Fill bit buffer
        (bit-count < cur-bits && pos < data-len) {
            dp = data[pos]: {
                ok -> it

                -> 0
            }
            bit-buf = bit-buf | ((dp & 255) << bit-count)

            #{overflow=wrap}
            bit-count = bit-count + 8: {
                ok -> it

                -> _
            }

            #{overflow=wrap}
            pos = pos + 1: {
                ok -> it

                -> _
            }
        }
        bit-count < cur-bits -> break

        ; Extract code
        code = bit-buf & ((1 << cur-bits) - 1)
        bit-buf = bit-buf >> cur-bits

        #{overflow=wrap}
        bit-count = bit-count - cur-bits: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        codes-read = codes-read + 1: {
            ok -> it

            -> _
        }

        ; Handle CLEAR code
        {
            block-mode == 1 && code == clear-code -> {

                ; Skip alignment padding
                #{overflow=wrap}
                pad = 8 - (codes-read % 8)
                pad < 8 -> {

                    #{overflow=wrap}
                    skip-bits = pad * cur-bits
                    (bit-count < skip-bits && pos < data-len) {
                        dp = data[pos]: {
                            ok -> it

                            -> 0
                        }
                        bit-buf = bit-buf | ((dp & 255) << bit-count)

                        #{overflow=wrap}
                        bit-count = bit-count + 8: {
                            ok -> it

                            -> _
                        }

                        #{overflow=wrap}
                        pos = pos + 1: {
                            ok -> it

                            -> _
                        }
                    }
                    consume = skip-bits
                    consume > bit-count -> consume = bit-count
                    bit-buf = bit-buf >> consume

                    #{overflow=wrap}
                    bit-count = bit-count - consume: {
                        ok -> it

                        -> _
                    }
                }

                ; Reset dictionary
                next-code = first-code
                cur-bits = 9
                codes-read = 0
                first = true
                continue
            }
        }

        ; Reconstruct string for code
        stack = []
        c = code

        ; Special case: code == next-code (KwKwK)
        {
            c >= next-code -> {
                ; string = old_string + first_byte(old_string)
                old-code >= 0 -> {

                    ; Follow prefix chain from old-code to get first byte
                    tc = old-code
                    pt = prefix[tc]: {
                        ok -> it

                        -> -1
                    }
                    (pt != -1) {
                        tc = pt
                        pt = prefix[tc]: {
                            ok -> it

                            -> -1
                        }
                    }

                    fb = suffix[tc]: {
                        ok -> it

                        -> 0
                    }

                    ; Build string: old_string + first_byte
                    tc = old-code
                    stack.push(fb)
                    pt = prefix[tc]: {
                        ok -> it

                        -> -1
                    }
                    (pt != -1) {
                        stc = suffix[tc]: {
                            ok -> it

                            -> 0
                        }
                        stack.push(stc)

                        tc = pt
                        pt = prefix[tc]: {
                            ok -> it

                            -> -1
                        }
                    }
                    stc2 = suffix[tc]: {
                        ok -> it

                        -> 0
                    }
                    stack.push(stc2)
                }
            }

            -> {

                ; Normal case: code is in dictionary
                pc = prefix[c]: {
                    ok -> it

                    -> -1
                }
                (pc != -1) {
                    sc = suffix[c]: {
                        ok -> it

                        -> 0
                    }
                    stack.push(sc)

                    c = pc
                    pc = prefix[c]: {
                        ok -> it

                        -> -1
                    }
                }
                sc2 = suffix[c]: {
                    ok -> it

                    -> 0
                }
                stack.push(sc2)
            }
        }

        ; Output string (stack is in reverse order)
        fi <- [0..stack.len()): {

            #{overflow=wrap}
            se = stack[stack.len() - 1 - fi]: {
                ok -> it

                -> 0
            }
            out.push(se)
        }

        ; Get first byte of output
        #{overflow=wrap}
        first-byte = stack[stack.len() - 1]: {
            ok -> it

            -> 0
        }

        ; Add to dictionary
        {
            ! first -> {
                prefix[next-code]: {
                    ok -> it = old-code

                    -> _
                }
                suffix[next-code]: {
                    ok -> it = first-byte

                    -> _
                }

                #{overflow=wrap}
                next-code = next-code + 1: {
                    ok -> it

                    -> _
                }

                ; Check code width increase
                next-code == (1 << cur-bits) -> {
                    cur-bits < max-bits -> {

                        ; Skip alignment padding
                        #{overflow=wrap}
                        pad = 8 - (codes-read % 8)
                        pad < 8 -> {

                            #{overflow=wrap}
                            skip-bits = pad * cur-bits
                            (bit-count < skip-bits && pos < data-len) {
                                dp = data[pos]: {
                                    ok -> it

                                    -> 0
                                }
                                bit-buf = bit-buf | ((dp & 255) << bit-count)

                                #{overflow=wrap}
                                bit-count = bit-count + 8: {
                                    ok -> it

                                    -> _
                                }

                                #{overflow=wrap}
                                pos = pos + 1: {
                                    ok -> it

                                    -> _
                                }
                            }
                            consume = skip-bits
                            consume > bit-count -> consume = bit-count
                            bit-buf = bit-buf >> consume

                            #{overflow=wrap}
                            bit-count = bit-count - consume: {
                                ok -> it

                                -> _
                            }
                        }

                        #{overflow=wrap}
                        cur-bits = cur-bits + 1: {
                            ok -> it

                            -> _
                        }
                        codes-read = 0
                    }
                }

                ; Check dictionary full
                next-code >= max-codes -> {
                    ; In block mode, wait for CLEAR
                    ; In non-block mode, freeze dictionary
                }
            }
        }

        old-code = code
        first = false
    }
}
