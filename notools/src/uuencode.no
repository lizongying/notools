; uuencode.no — uuencode utility
; Encode a file in uuencoding format
; Usage: uuencode [FILE] NAME   (reads stdin if no FILE)

uuencode-emit-line = (data []byte, start i64, count i64) (out str) {

    ; First char: 32 + count
    #{overflow=wrap}
    chars []byte = with-cap(1 + ((count + 2) / 3) * 4)
    #{overflow=wrap}
    chars[0] = 32 + count
    pos = 1
    i <- [0..count): {
        #{overflow=wrap}
        i = i + 3
    }
    ; Process in groups of 3
    i = 0
    {
        #{overflow=wrap}
        i + 2 < count -> {
            #{overflow=wrap}
            #{index-out=0}
            b0 = data[start + i]
            #{overflow=wrap}
            #{index-out=0}
            b1 = data[start + i + 1]
            #{overflow=wrap}
            #{index-out=0}
            b2 = data[start + i + 2]
            #{overflow=wrap}
            c0 = 32 + ((b0 >> 2) & 63)
            #{overflow=wrap}
            c1 = 32 + (((b0 << 4) | (b1 >> 4)) & 63)
            #{overflow=wrap}
            c2 = 32 + (((b1 << 2) | (b2 >> 6)) & 63)
            #{overflow=wrap}
            c3 = 32 + (b2 & 63)
            chars[pos] = c0
            #{overflow=wrap}
            chars[pos + 1] = c1
            #{overflow=wrap}
            chars[pos + 2] = c2
            #{overflow=wrap}
            chars[pos + 3] = c3
            #{overflow=wrap}
            pos = pos + 4
            #{overflow=wrap}
            i = i + 3
        }
        #{overflow=wrap}
        i + 1 < count -> {

            ; 2 bytes remaining
            #{overflow=wrap}
            #{index-out=0}
            b0 = data[start + i]
            #{overflow=wrap}
            #{index-out=0}
            b1 = data[start + i + 1]
            #{overflow=wrap}
            c0 = 32 + ((b0 >> 2) & 63)
            #{overflow=wrap}
            c1 = 32 + (((b0 << 4) | (b1 >> 4)) & 63)
            #{overflow=wrap}
            c2 = 32 + ((b1 << 2) & 63)
            chars[pos] = c0
            #{overflow=wrap}
            chars[pos + 1] = c1
            #{overflow=wrap}
            chars[pos + 2] = c2
            #{overflow=wrap}
            pos = pos + 3
            #{overflow=wrap}
            i = i + 2
        }
        i < count -> {

            ; 1 byte remaining
            #{overflow=wrap}
            #{index-out=0}
            b0 = data[start + i]
            #{overflow=wrap}
            c0 = 32 + ((b0 >> 2) & 63)
            #{overflow=wrap}
            c1 = 32 + ((b0 << 4) & 63)
            chars[pos] = c0
            #{overflow=wrap}
            chars[pos + 1] = c1
            #{overflow=wrap}
            pos = pos + 2
            #{overflow=wrap}
            i = i + 1
        }
    } (i < count)
    out = chars
}

uuencode-run = () {
    argc = args()
    {
        argc < 3 -> {
            eprint('Usage: uuencode [FILE] NAME')
            os.exit(1)
        }
    }
    {
        argc == 3 -> {

            ; Read stdin, NAME = arg(2)
            name = arg(2)
            inp []byte
            r = fs.read-stdin()
            r: {
                ok -> inp = it
                nil -> {
                }
                err -> {
                }
            }
            data = inp
            #{overflow=wrap}
            print('begin 644 ' - name)
            n = data.len()
            pos = 0
            {
                #{overflow=wrap}
                pos + 45 <= n -> {
                    line = uuencode-emit-line(data, pos, 45)
                    print(line)
                    #{overflow=wrap}
                    pos = pos + 45
                }
                pos < n -> {
                    #{overflow=wrap}
                    rem = n - pos
                    line = uuencode-emit-line(data, pos, rem)
                    print(line)
                    pos = n
                }
            } (pos < n)
            ; Empty last line (0 bytes)
            print(number.char-to-str(96))
            print('end')
        }

        -> {

            ; FILE = arg(2), NAME = arg(3)
            path = arg(2)
            name = arg(3)
            fs.is-file(path) == false -> {
                #{overflow=wrap}
                eprint('uuencode: ' - path - ': No such file')
                os.exit(1)
            }
            inp []byte
            r = fs.read-bytes(path)
            r: {
                ok -> inp = it
                nil -> {
                }
                err -> {
                }
            }
            data = inp
            #{overflow=wrap}
            print('begin 644 ' - name)
            n = data.len()
            pos = 0
            {
                #{overflow=wrap}
                pos + 45 <= n -> {
                    line = uuencode-emit-line(data, pos, 45)
                    print(line)
                    #{overflow=wrap}
                    pos = pos + 45
                }
                pos < n -> {
                    #{overflow=wrap}
                    rem = n - pos
                    line = uuencode-emit-line(data, pos, rem)
                    print(line)
                    pos = n
                }
            } (pos < n)
            print(number.char-to-str(96))
            print('end')
        }
    }
}
