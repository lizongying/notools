; uuencode.no — uuencode utility
; Encode a file in uuencoding format
; Usage: uuencode [FILE] NAME   (reads stdin if no FILE)

uuencode-emit-line = (data []byte, start i64, count i64) (out str) {

    ; First char: 32 + count
    #{overflow=wrap}
    chars []byte = with-cap(1 + ((count + 2) / 3) * 4)

    #{overflow=wrap}
    hdr = 32 + count: {
        ok -> it

        -> _
    }
    chars[0]: {
        ok -> it = hdr

        -> _
    }
    pos = 1
    i <- [0..count): {

        #{overflow=wrap}
        i = i + 3
    }

    ; Process in groups of 3
    i = 0
    (i < count) {

        #{overflow=wrap}
        i + 2 < count -> {
            b0 = data[start + i]: {
                ok -> it

                -> 0
            }

            b1 = data[start + i + 1]: {
                ok -> it

                -> 0
            }

            b2 = data[start + i + 2]: {
                ok -> it

                -> 0
            }
            c0 = 32 + ((b0 >> 2) & 63)
            c1 = 32 + (((b0 << 4) | (b1 >> 4)) & 63)
            c2 = 32 + (((b1 << 2) | (b2 >> 6)) & 63)
            c3 = 32 + (b2 & 63)
            chars[pos]: {
                ok -> it = c0

                -> _
            }
            chars[pos + 1]: {
                ok -> it = c1

                -> _
            }
            chars[pos + 2]: {
                ok -> it = c2

                -> _
            }
            chars[pos + 3]: {
                ok -> it = c3

                -> _
            }

            #{overflow=wrap}
            npos = pos + 4: {
                ok -> it

                -> _
            }
            pos = npos

            #{overflow=wrap}
            ni = i + 3: {
                ok -> it

                -> _
            }
            i = ni
        }

        #{overflow=wrap}
        i + 1 < count -> {

            ; 2 bytes remaining
            b0 = data[start + i]: {
                ok -> it

                -> 0
            }

            b1 = data[start + i + 1]: {
                ok -> it

                -> 0
            }
            c0 = 32 + ((b0 >> 2) & 63)
            c1 = 32 + (((b0 << 4) | (b1 >> 4)) & 63)
            c2 = 32 + ((b1 << 2) & 63)
            chars[pos]: {
                ok -> it = c0

                -> _
            }
            chars[pos + 1]: {
                ok -> it = c1

                -> _
            }
            chars[pos + 2]: {
                ok -> it = c2

                -> _
            }

            #{overflow=wrap}
            npos = pos + 3: {
                ok -> it

                -> _
            }
            pos = npos

            #{overflow=wrap}
            ni = i + 2: {
                ok -> it

                -> _
            }
            i = ni
        }
        i < count -> {

            ; 1 byte remaining
            b0 = data[start + i]: {
                ok -> it

                -> 0
            }

            #{overflow=wrap}
            c0 = 32 + ((b0 >> 2) & 63)

            #{overflow=wrap}
            c1 = 32 + ((b0 << 4) & 63)
            chars[pos]: {
                ok -> it = c0

                -> _
            }

            #{overflow=wrap}
            chars[pos + 1]: {
                ok -> it = c1

                -> _
            }

            #{overflow=wrap}
            npos = pos + 2: {
                ok -> it

                -> _
            }
            pos = npos

            #{overflow=wrap}
            ni = i + 1: {
                ok -> it

                -> _
            }
            i = ni
        }
    }
    out = chars
}

uuencode-run = () {
    argc = os.args().len()
    {
        argc < 3 -> {
            eprint('Usage: uuencode [FILE] NAME')
            exit(1)
        }
    }
    {
        argc == 3 -> {

            ; Read stdin, NAME = os.arg(2)
            name-opt = os.arg(2)
            name = ''
            name-opt: {
                ok -> name = it

                -> _
            }
            inp []byte
            r = fs.read-stdin()
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            data = inp
            print('begin 644 ' - name)
            n = data.len()
            pos = 0
            (pos < n) {

                #{overflow=wrap}
                pos + 45 <= n -> {
                    line = uuencode-emit-line(data, pos, 45)
                    print(line)

                    #{overflow=wrap}
                    npos = pos + 45: {
                        ok -> it

                        -> _
                    }
                    pos = npos
                }
                pos < n -> {

                    #{overflow=wrap}
                    rem = n - pos
                    line = uuencode-emit-line(data, pos, rem)
                    print(line)
                    pos = n
                }
            }

            ; Empty last line (0 bytes)
            print('`')
            print('end')
        }

        -> {

            ; FILE = os.arg(2), NAME = os.arg(3)
            path-opt = os.arg(2)
            path = path-opt: {
                ok -> it

                -> ''
            }
            name-opt = os.arg(3)
            name = ''
            name-opt: {
                ok -> name = it

                -> _
            }
            ! fs.is-file(path) -> {
                eprint('uuencode: ' - path - ': No such file')
                exit(1)
            }
            inp []byte
            r = fs.read-bytes(path)
            r: {
                ok -> inp = it

                nil -> {
                }

                err -> {
                }
            }
            data = inp
            print('begin 644 ' - name)
            n = data.len()
            pos = 0
            (pos < n) {

                #{overflow=wrap}
                pos + 45 <= n -> {
                    line = uuencode-emit-line(data, pos, 45)
                    print(line)

                    #{overflow=wrap}
                    npos = pos + 45: {
                        ok -> it

                        -> _
                    }
                    pos = npos
                }
                pos < n -> {

                    #{overflow=wrap}
                    rem = n - pos
                    line = uuencode-emit-line(data, pos, rem)
                    print(line)
                    pos = n
                }
            }
            print('`')
            print('end')
        }
    }
}
