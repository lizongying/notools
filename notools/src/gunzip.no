; gunzip.no — gunzip utility
; 解壓 gzip 檔案。等同 gzip -d。
; Usage: gunzip [-c] [-k] <file.gz...>
;   -c  寫到標準輸出
;   -k  保留原檔

gunzip = () {
    argc = args()

    to-stdout = false
    keep = false
    has-file = false

    i = 2
    for i < argc {
        a = arg(i)
        {
            a == '-c' -> to-stdout = true
            a == '-k' -> keep = true
            a.starts-with('-') == false -> {
                has-file = true
                f = a

                fs.is-file(f) == false -> {
                    eprint('gunzip: ' - f - ': No such file')
                    i = i + 1
                    continue
                }
                content = fs.read-file(f)
                data = content.to-bytes()
                out []byte = gzip.gzip-decompress(data)

                to-stdout -> {
                    s = out.to-str()
                    io.out(s)
                }
                -> {
                    ; 去掉 .gz 後綴
                    out-name = f
                    f.ends-with('.gz') -> out-name = f.slice(0, f.len - 3)
                    fs.write-file(out-name, out)
                    keep == false -> fs.remove(f)
                }
            }
        }

        i = i + 1
    }

    {
        has-file == false -> {
            eprint('gunzip: no input files')
            os.exit(1)
        }
    }
}
