; gunzip.no — gunzip utility
; 解壓 gzip 檔案。等同 gzip -d。
; Usage: gunzip [-c] [-k] <file.gz...>
;   -c  寫到標準輸出
;   -k  保留原檔

gunzip = () {
    argc = args()

    to-stdout = false
    keep = false
    has-file = false

    i = 2
    (i < argc) {
        a = arg(i)
        {
            a == '-c' -> to-stdout = true

            a == '-k' -> keep = true

            ! a.starts-with('-') -> {
                has-file = true
                f = a

                ! fs.is-file(f) -> {
                    #{overflow=wrap}
                    eprint('gunzip: ' - f - ': No such file')

                    #{overflow=wrap}
                    i = i + 1
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = content
                out []byte = gzip.gzip-decompress(data)

                {
                    to-stdout -> {
                        s = out.to-bytes-str()
                        io.out(s)
                    }

                    -> {

                        ; 去掉 .gz 後綴
                        out-name = f
                        #{overflow=wrap}
                        f.ends-with('.gz') -> out-name = f.slice(0, f.len-bytes() - 3)
                        fs.write-file(out-name, out)
                        ! keep -> fs.remove(f)
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }

    {
        ! has-file -> {
            eprint('gunzip: no input files')
            os.exit(1)
        }
    }
}
