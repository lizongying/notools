; gunzip.no — gunzip utility
; 解壓 gzip 檔案。等同 gzip -d。
; Usage: gunzip [-c] [-k] <file.gz...>
;   -c  寫到標準輸出
;   -k  保留原檔

gunzip = () {
    argc = os.args().len()

    to-stdout = false
    keep = false
    has-file = false

    i = 2
    (i < argc) {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        {
            a == '-c' -> to-stdout = true

            a == '-k' -> keep = true

            ! a.starts-with('-') -> {
                has-file = true
                f = a

                ! fs.is-file(f) -> {
                    eprint('gunzip: ' - f - ': No such file')

                    #{overflow=wrap}
                    i = i + 1: {
                        ok -> it

                        -> _
                    }
                    continue
                }
                content []byte
                r = fs.read-bytes(f)
                r: {
                    ok -> content = it

                    nil -> {
                    }

                    err -> {
                    }
                }
                data = content
                out []byte = gzip.decompress(data)

                {
                    to-stdout -> {
                        tb0o = out.to-str()
                        tb0v = tb0o: {
                            ok -> it
                        
                            nil || err -> ''
                        }
                        s = tb0v
                        io.out(s)
                    }

                    -> {

                        ; 去掉 .gz 後綴
                        out-name = f

                        #{overflow=wrap}
                        f.ends-with('.gz') -> out-name = f.slice(0, f.len() - 3)
                        fs.write-file(out-name, out)
                        ! keep -> fs.remove(f)
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + 1: {
            ok -> it

            -> _
        }
    }

    {
        ! has-file -> {
            eprint('gunzip: no input files')
            exit(1)
        }
    }
}
