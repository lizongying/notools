; cmp.no — cmp utility
; Compare two files byte by byte
; Usage: cmp [-l|-s] FILE1 FILE2
;   -l: print byte position and differing byte values (octal) for all differences
;   -s: silent mode, only exit status (0=same, 1=differ, 2=error)
; Exit: 0=identical, 1=differ, 2=error

cmp-run = () {
    argc = args()

    long-mode = false
    silent = false
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-l' -> long-mode = true
        a == '-s' -> silent = true
        a == '--silent' -> silent = true
        a == '--quiet' -> silent = true
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len < 2 -> {
            silent == false -> eprint('Usage: cmp [-l|-s] FILE1 FILE2')
            os.exit(2)
        }
    }

    ; Handle - as stdin
    c1 = fs.read-file(files[0])
    c2 = fs.read-file(files[1])

    ; Find first difference
    n1 = c1.len
    n2 = c2.len
    min-len = n1
    n2 < min-len -> min-len = n2

    ; Compare byte by byte
    first-diff = -1
    i <- [0..min-len): {
        c1[i] != c2[i] -> {
            first-diff = i
            break
        }
    }

    ; No difference in common prefix → check lengths
    {
        first-diff < 0 -> {
            n1 == n2 -> {

                ; Identical
                os.exit(0)
            }
            ; One file is prefix of the other
            first-diff = min-len
        }

        ; Files differ
        silent == true -> os.exit(1)

        long-mode == true -> {

            ; Print all differences
            pos = first-diff
            {
                pos < n1 && pos < n2 -> {
                    c1[pos] != c2[pos] -> {

                        ; byte offset (1-based, octal), val1 (octal), val2 (octal)
                        off = pos + 1
                        print(off.to-str() - ' ' - c1[pos].to-str() - ' ' - c2[pos].to-str())
                    }
                    pos = pos + 1
                }
                pos < n1 -> {

                    ; c2 exhausted, c1 has extra bytes (value vs EOF=0)
                    off = pos + 1
                    print(off.to-str() - ' ' - c1[pos].to-str() - ' 0')
                    pos = pos + 1
                }
                pos < n2 -> {

                    ; c1 exhausted, c2 has extra bytes
                    off = pos + 1
                    print(off.to-str() - ' 0 ' - c2[pos].to-str())
                    pos = pos + 1
                }
            } (pos < n1 || pos < n2)
            os.exit(1)
        }
    }

    ; Default: print first difference position
    ; Count line number up to first-diff
    line-no = 1
    i <- [0..first-diff): {
        c1[i] == 10 -> line-no = line-no + 1
    }
    byte-no = first-diff + 1

    ; Format: "FILE1 FILE2 differ: byte BYTE, line LINE"
    msg = files[0] - ' ' - files[1] - ' differ: byte ' - byte-no.to-str() - ', line ' - line-no.to-str()
    print(msg)
    os.exit(1)
}
