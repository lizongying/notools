; cmp.no — cmp utility
; Compare two files byte by byte
; Usage: cmp [-l|-s] FILE1 FILE2
;   -l: print byte position and differing byte values (octal) for all differences
;   -s: silent mode, only exit status (0=same, 1=differ, 2=error)
; Exit: 0=identical, 1=differ, 2=error

; octal3: byte value (0-255) as octal digits, no leading zeros (BSD cmp -l style)
octal3 = (v i64) (s str) {
    digits = '01234567'

    #{overflow=wrap}
    d2 = v / 64

    #{overflow=wrap}
    d1 = (v - d2 * 64) / 8

    #{overflow=wrap}
    d0 = v - d2 * 64 - d1 * 8
    s = ''
    d2 > 0 -> s = s - digits[d2].to-str()
    d2 > 0 || d1 > 0 -> s = s - digits[d1].to-str()
    s = s - digits[d0].to-str()
}

; rjw: write s right-justified in a width-w field directly to stdout.
; Padding is built in a LOCAL anchored at a literal ('' - s): mutating the
; str PARAMETER in place (`s = ' ' - s`) is a no-op — the compiler's
; buffer-aliasing bug drops in-place prepends on out-param-derived strings.
rjw = (s str, w i64) {
    pad = '' - s
    (pad.len-bytes() < w) {
        pad.len-bytes() < w -> pad = ' ' - pad
    }
    io.out(pad)
}

; diff-line: one BSD cmp -l record == printf("%6ju %3o %3o\\n", off, v1, v2)
; offset decimal (min width 6), each byte value octal (min width 3),
; single-space separators; wider-than-min values are never truncated.
diff-line = (off i64, v1 i64, v2 i64) {
    rjw(off.to-str(), 6)
    io.out(' ')
    rjw(octal3(v1), 3)
    io.out(' ')
    rjw(octal3(v2), 3)
    io.out('\n')
}

; eof-msg: BSD prints "cmp: EOF on <shorter file>" to stderr
; (first-listed file when byte values are equal).
eof-msg = (f1 str, f2 str, same bool) {
    same -> eprint('cmp: EOF on ' - f1)
    ! same -> eprint('cmp: EOF on ' - f2)
}

cmp-run = () {
    argc = os.args()

    long-mode = false
    silent = false
    files []str

    i <- [2..argc): {
        a = os.arg(i)
        a == '-l' -> long-mode = true
        a == '-s' -> silent = true
        a == '--silent' -> silent = true
        a == '--quiet' -> silent = true
        ! a.starts-with('-') -> files.push(a)
    }

    {
        files.len() < 2 -> {
            ! silent -> eprint('Usage: cmp [-l|-s] FILE1 FILE2')
            os.exit(2)
        }
    }

    ; Read raw bytes (NOT read-str: UTF-8 lossy decoding would corrupt
    ; lengths/indexes for high bytes, breaking byte-exact comparison)
    c1 []byte
    r = fs.read-bytes(files[0])
    r: {
        ok -> c1 = it

        nil -> {
        }

        err -> {
        }
    }
    c2 []byte
    r = fs.read-bytes(files[1])
    r: {
        ok -> c2 = it

        nil -> {
        }

        err -> {
        }
    }

    ; Find first difference
    n1 = c1.len()
    n2 = c2.len()
    min-len = n1
    n2 < min-len -> min-len = n2

    ; Compare byte by byte
    first-diff = -1
    i <- [0..min-len): {
        c1[i] != c2[i] -> {
            first-diff = i
            break
        }
    }

    ; No difference in common prefix → check lengths
    {
        first-diff < 0 -> {
            n1 == n2 -> {

                ; Identical
                os.exit(0)
            }

            ; One file is prefix of the other
            first-diff = min-len
        }

        ; Files differ
        silent -> os.exit(1)

        long-mode -> {

            ; Print all differences; stop at the shorter file, then EOF notice
            pos = first-diff
            (pos < n1 && pos < n2) {
                c1[pos] != c2[pos] -> {

                    #{overflow=wrap}
                    diff-line(pos + 1, c1[pos], c2[pos])
                }

                #{overflow=wrap}
                pos = pos + 1
            }

            ; EOF notice only when one file is shorter (never for equal length)
            n1 != n2 -> eof-msg(files[0], files[1], n1 < n2)
            os.exit(1)
        }
    }

    ; -l with identical prefix content but different lengths: EOF only
    {
        long-mode -> os.exit(1)
    }

    ; Default: print first difference position
    ; Count line number up to first-diff
    line-no = 1
    i <- [0..first-diff): {

        #{overflow=wrap}
        c1[i] == 10 -> line-no = line-no + 1
    }

    #{overflow=wrap}
    byte-no = first-diff + 1

    ; Format: "FILE1 FILE2 differ: char CHAR, line LINE"
    msg = files[0] - ' ' - files[1] - ' differ: char ' - byte-no.to-str() - ', line ' - line-no.to-str()
    print(msg)
    os.exit(1)
}
