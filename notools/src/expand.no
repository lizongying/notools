; expand.no — expand utility
; Convert tabs to spaces
; Usage: expand [-t N] [file...]
;   -t N:  tab stop distance (default: 8)
;   files: files to process (read from stdin if none)

atoi = (s str) (v i64) {
    v = 0
    i <- [0..s.len-bytes()): {
        c = s[i]
        #{overflow=wrap}
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
}

expand-run = () {
    argc = args()
    tabstop = 8
    files []str
    skip-next = false

    i <- [2..argc): {
        skip-next == true -> {
            skip-next = false
            continue
        }
        a = arg(i)
        a == '-t' -> {
            #{overflow=wrap}
            i + 1 < argc -> {
                #{overflow=wrap}
                tabstop = atoi(arg(i + 1))
                skip-next = true
            }
        }
        a.starts-with('-t') -> {
            a.len-bytes() > 2 -> tabstop = atoi(a.slice(2, a.len-bytes()))
        }
        ! a.starts-with('-') -> files.push(a)
    }
    {
        tabstop < 1 -> tabstop = 8

        files.len() == 0 -> {
            content = ''
            r = fs.read-stdin-str()
            r: {
                ok -> content = it
                nil -> {
                }
                err -> {
                }
            }
            process(content, tabstop)
        }

        files.len() > 0 -> {
            fi <- [0..files.len()): {
                fs.is-file(files[fi]) == false -> {
                    #{overflow=wrap}
                    io.errln('expand: ' - files[fi] - ': No such file or directory')
                    continue
                }
                content = ''
                r = fs.read-str(files[fi])
                r: {
                    ok -> content = it
                    nil -> {
                    }
                    err -> {
                    }
                }
                process(content, tabstop)
            }
        }
    }
}

; process: convert tabs to spaces in content
process = (content str, tabstop i64) {
    col = 0
    i <- [0..content.len-bytes()): {
        c = content[i]
        c == 9 -> {

            ; Tab: advance to next tab stop
            #{overflow=wrap}
            spaces = tabstop - (col % tabstop)
            sp = ' '.repeat(spaces)
            io.out(sp)
            #{overflow=wrap}
            col = col + spaces
        }
        c == 10 -> {
            io.out('\n')
            col = 0
        }

        -> {

            ; Output single character
            #{overflow=wrap}
            io.out(content.slice(i, i + 1))
            #{overflow=wrap}
            col = col + 1
        }
    }
}
