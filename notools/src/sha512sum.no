; sha512sum.no — sha512sum utility (coreutils alias)
; Compute SHA-512 checksums
; Usage: sha512sum [FILE...]   (no FILE: read stdin)
;        sha512sum -c CHECKFILE   (verify checksums)
# /notools/src/hashutil.do-hash

sha512sum-run = () {
    argc = args()
    {
        argc >= 3 -> {
            arg(2) == '-c' -> {
                checkfile = arg(3)
                content = ''
                r = fs.read-str(checkfile)
                r: {
                    ok -> content = it
                    nil -> {
                    }
                    err -> {
                    }
                }
                lines []str
                start = 0
                i <- [0..content.len): {
                    content[i] == 10 -> {
                        lines.push(content.slice(start, i))
                        start = i + 1
                    }
                }
                start < content.len -> lines.push(content.slice(start, content.len))
                any-failed = false
                i <- [0..lines.len): {
                    line = lines[i]
                    line.len == 0 -> *
                    sp = line.index('  ')
                    sp < 0 -> *
                    expected = line.slice(0, sp)
                    fname = line.slice(sp + 2, line.len)
                    fs.is-file(fname) == false -> {
                        print(fname - ': FAILED (no such file)')
                        any-failed = true
                        *
                    }
                    inp []byte
                    r = fs.read-bytes(fname)
                    r: {
                        ok -> inp = it
                        nil -> {
                        }
                        err -> {
                        }
                    }
                    data = inp
                    actual = do-hash('sha512', data)
                    {
                        actual == expected -> {
                            print(fname - ': OK')
                        }

                        -> {
                            print(fname - ': FAILED')
                            any-failed = true
                        }
                    }
                }
                any-failed -> os.exit(1)
                return
            }
        }
    }
    {
        argc <= 2 -> {
            inp []byte
            r = fs.read-stdin()
            r: {
                ok -> inp = it
                nil -> {
                }
                err -> {
                }
            }
            data = inp
            h = do-hash('sha512', data)
            print(h)
        }

        -> {
            i <- [2..argc): {
                path = arg(i)
                fs.is-file(path) == false -> {
                    eprint('sha512sum: ' - path - ': No such file')
                    os.exit(1)
                }
                inp []byte
                r = fs.read-bytes(path)
                r: {
                    ok -> inp = it
                    nil -> {
                    }
                    err -> {
                    }
                }
                data = inp
                h = do-hash('sha512', data)
                print(h - '  ' - path)
            }
        }
    }
}
