tr-run = () {
    argc = args()
    dmode = 0
    i <- [2..argc): {
        a = arg(i)
        a == '-d' -> dmode = 1
    }
    sets []str
    i <- [2..argc): {
        a = arg(i)
        a == '-d' -> { continue }
        ! a.starts-with('-') -> sets.push(a)
    }
    printf('dmode=%d sets.len=%d\n', dmode, sets.len)
    print('AFTER-LOOPS')
}
main = () { tr-run() }
