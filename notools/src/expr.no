// expr.no — expr utility
// Evaluate expressions (integer arithmetic, comparison, logical, string ops)
// Usage: expr EXPR...
//   Operators (low → high precedence):
//     |   OR  : returns arg1 if non-zero/non-empty, else arg2
//     &   AND : returns arg1 if both non-zero/non-empty, else 0
//     = != < <= > >=  comparison (1/0)
//     + -     additive
//     * / %   multiplicative
//     :       regex match (simplified: substring/anchored prefix)
//   Functions: length STR | substr STR POS LEN
//   Parentheses supported. Integer operands only for arithmetic.
// Example: expr 2 + 3 \* 4 → 14

// Token types
EXPR-TOK-NUM = 1
EXPR-TOK-STR = 2
EXPR-TOK-OP  = 3
EXPR-TOK-LP  = 4
EXPR-TOK-RP  = 5
EXPR-TOK-EOF = 6

// Tokenize the argument list into tokens.
tokenize = (out-tok []i64, out-val []str) {
    argc = args()
    i <- [2..argc): {
        s = arg(i)
        {
            s == '(' -> {
                out-tok.push(EXPR-TOK-LP)
                out-val.push(s)
            }
            s == ')' -> {
                out-tok.push(EXPR-TOK-RP)
                out-val.push(s)
            }
            s == '+' || s == '-' || s == '*' || s == '/' || s == '%' -> {
                out-tok.push(EXPR-TOK-OP)
                out-val.push(s)
            }
            s == '=' || s == '!=' || s == '<' || s == '<=' || s == '>' || s == '>=' -> {
                out-tok.push(EXPR-TOK-OP)
                out-val.push(s)
            }
            s == '|' || s == '&' || s == ':' -> {
                out-tok.push(EXPR-TOK-OP)
                out-val.push(s)
            }
            s == 'length' -> {
                out-tok.push(EXPR-TOK-OP)
                out-val.push('length')
            }
            s == 'substr' -> {
                out-tok.push(EXPR-TOK-OP)
                out-val.push('substr')
            }
            -> {
                // Try to parse as number; if fails, treat as string
                is-num = true
                j <- [0..s.len): {
                    c = s[j]
                    is-digit = c >= 48 && c <= 57
                    is-sign = j == 0 && c == 45
                    !is-digit && !is-sign -> is-num = false
                }
                is-num == true && s.len > 0 -> {
                    out-tok.push(EXPR-TOK-NUM)
                    out-val.push(s)
                }
                is-num == false -> {
                    out-tok.push(EXPR-TOK-STR)
                    out-val.push(s)
                }
            }
        }
    }
    out-tok.push(EXPR-TOK-EOF)
    out-val.push('')
}

// Parse integer from string (handles negative)
atoi = (s str) (v i64) {
    v = 0
    neg = false
    start = 0
    s.len > 0 -> {
        s[0] == 45 -> {
            neg = true
            start = 1
        }
    }
    i <- [start..s.len): {
        c = s[i]
        c >= 48 && c <= 57 -> v = v * 10 + (c - 48)
    }
    neg == true -> v = 0 - v
}

// Check if a string looks like an integer
is-num-str = (s str) (yes bool) {
    yes = false
    s.len == 0 -> return
    yes = true
    i <- [0..s.len): {
        c = s[i]
        is-digit = c >= 48 && c <= 57
        is-sign = i == 0 && c == 45
        !is-digit && !is-sign -> yes = false
    }
}

// Check if a token value is "truthy" (non-zero integer or non-empty string)
is-truthy = (tok i64, val str) (r i64) {
    r = 0
    tok == EXPR-TOK-NUM -> {
        n = atoi(val)
        n != 0 -> r = 1
    }
    tok == EXPR-TOK-STR -> {
        val.len > 0 -> r = 1
    }
}

// peek: return current token type
peek = (toks []i64, pos []i64) (t i64) {
    t = toks[pos[0]]
}

// match-op: check if current token is the given operator; if so consume it
match-op = (toks []i64, vals []str, pos []i64, op str) (yes bool) {
    yes = false
    toks[pos[0]] == EXPR-TOK-OP -> {
        vals[pos[0]] == op -> {
            pos[0] = pos[0] + 1
            yes = true
        }
    }
}

// parse-primary: number | string | '(' expr ')' | '-' primary | '+' primary | length STR | substr STR POS LEN
primary = (toks []i64, vals []str, pos []i64) (rt i64, rv str) {
    rt = 0
    rv = ''
    t = peek(toks, pos)
    t == EXPR-TOK-NUM -> {
        rt = toks[pos[0]]
        rv = vals[pos[0]] - '' - ''
        pos[0] = pos[0] + 1
        return
    }
    t == EXPR-TOK-STR -> {
        rt = toks[pos[0]]
        rv = vals[pos[0]] - '' - ''
        pos[0] = pos[0] + 1
        return
    }
    t == EXPR-TOK-LP -> {
        pos[0] = pos[0] + 1
        rt, rv = do-or(toks, vals, pos)
        rp = peek(toks, pos)
        rp == EXPR-TOK-RP -> pos[0] = pos[0] + 1
        return
    }
    t == EXPR-TOK-OP -> {
        v = vals[pos[0]] - ''
        v == '-' -> {
            pos[0] = pos[0] + 1
            ct, cv = primary(toks, vals, pos)
            n = atoi(cv)
            n = 0 - n
            rt = EXPR-TOK-NUM
            rv = n.to-str()
            return
        }
        v == '+' -> {
            pos[0] = pos[0] + 1
            rt, rv = primary(toks, vals, pos)
            return
        }
        v == 'length' -> {
            pos[0] = pos[0] + 1
            ct, cv = primary(toks, vals, pos)
            rt = EXPR-TOK-NUM
            tlen = cv.len
            rv = tlen.to-str()
            return
        }
        v == 'substr' -> {
            pos[0] = pos[0] + 1
            s-t, s-v = primary(toks, vals, pos)
            p-t, p-v = primary(toks, vals, pos)
            l-t, l-v = primary(toks, vals, pos)
            start = atoi(p-v)
            // POSIX substr: 1-based, negative start counts from end
            start > 0 -> start = start - 1
            start < 0 -> start = s-v.len + start
            length = atoi(l-v)
            end = start + length
            end > s-v.len -> end = s-v.len
            start < 0 -> start = 0
            rt = EXPR-TOK-STR
            start >= s-v.len -> rv = ''
            start < s-v.len -> rv = s-v.slice(start, end)
            return
        }
    }
}

// parse-mul: primary (('*' | '/' | '%') primary)*
// Uses local cur-t/cur-v to avoid codegen issues with output params inside loops
mul = (toks []i64, vals []str, pos []i64) (rt i64, rv str) {
    cur-t i64
    cur-v str
    cur-t, cur-v = primary(toks, vals, pos)
    !! {
        t = peek(toks, pos)
        t != EXPR-TOK-OP -> break
        v = vals[pos[0]] - ''
        v != '*' && v != '/' && v != '%' -> break
        pos[0] = pos[0] + 1
        rt2, rv2 = primary(toks, vals, pos)
        a = atoi(cur-v)
        b = atoi(rv2)
        r = 0
        v == '*' -> r = a * b
        v == '/' -> { b != 0 -> r = a / b }
        v == '%' -> { b != 0 -> r = a % b }
        cur-t = EXPR-TOK-NUM
        cur-v = r.to-str()
    }
    rt = cur-t
    rv = cur-v
}

// parse-add: mul (('+' | '-') mul)*
add = (toks []i64, vals []str, pos []i64) (rt i64, rv str) {
    cur-t i64
    cur-v str
    cur-t, cur-v = mul(toks, vals, pos)
    !! {
        t = peek(toks, pos)
        t != EXPR-TOK-OP -> break
        v = vals[pos[0]] - ''
        v != '+' && v != '-' -> break
        pos[0] = pos[0] + 1
        rt2, rv2 = mul(toks, vals, pos)
        a = atoi(cur-v)
        b = atoi(rv2)
        r = 0
        v == '+' -> r = a + b
        v == '-' -> r = a - b
        cur-t = EXPR-TOK-NUM
        cur-v = r.to-str()
    }
    rt = cur-t
    rv = cur-v
}

// parse-match: add (':' add)*  (simplified regex match → prefix match)
parse-match = (toks []i64, vals []str, pos []i64) (rt i64, rv str) {
    cur-t i64
    cur-v str
    cur-t, cur-v = add(toks, vals, pos)
    !! {
        matched = match-op(toks, vals, pos, ':')
        matched == false -> break
        rt2, rv2 = add(toks, vals, pos)
        // Simplified: count leading characters of rv that match pattern rv2
        matched-len = 0
        rv2.len > 0 -> {
            cur-v.starts-with(rv2) -> matched-len = rv2.len
        }
        cur-t = EXPR-TOK-NUM
        tml = matched-len
        cur-v = tml.to-str()
    }
    rt = cur-t
    rv = cur-v
}

// parse-cmp: match (('=' | '!=' | '<' | '<=' | '>' | '>=') match)?
cmp = (toks []i64, vals []str, pos []i64) (rt i64, rv str) {
    cur-t i64
    cur-v str
    cur-t, cur-v = parse-match(toks, vals, pos)
    t = peek(toks, pos)
    t != EXPR-TOK-OP -> {
        rt = cur-t
        rv = cur-v
        return
    }
    v = vals[pos[0]] - ''
    v != '=' && v != '!=' && v != '<' && v != '<=' && v != '>' && v != '>=' -> {
        rt = cur-t
        rv = cur-v
        return
    }
    pos[0] = pos[0] + 1
    rt2, rv2 = parse-match(toks, vals, pos)
    // Comparison: if both look like integers, compare numerically; else lexically
    rv-is-num = is-num-str(cur-v)
    rv2-is-num = is-num-str(rv2)
    cmp-result = 0
    rv-is-num && rv2-is-num -> {
        a-num = atoi(cur-v)
        b-num = atoi(rv2)
        a-num < b-num -> cmp-result = -1
        a-num > b-num -> cmp-result = 1
    }
    rv-is-num == false || rv2-is-num == false -> {
        cmp-result = cur-v.compare(rv2)
    }
    r = 0
    v == '=' -> { cmp-result == 0 -> r = 1 }
    v == '!=' -> { cmp-result != 0 -> r = 1 }
    v == '<' -> { cmp-result < 0 -> r = 1 }
    v == '<=' -> { cmp-result <= 0 -> r = 1 }
    v == '>' -> { cmp-result > 0 -> r = 1 }
    v == '>=' -> { cmp-result >= 0 -> r = 1 }
    rt = EXPR-TOK-NUM
    rv = r.to-str()
}

// parse-and: cmp ('&' cmp)*  (returns left if both truthy, else 0)
do-and = (toks []i64, vals []str, pos []i64) (rt i64, rv str) {
    cur-t i64
    cur-v str
    cur-t, cur-v = cmp(toks, vals, pos)
    !! {
        matched = match-op(toks, vals, pos, '&')
        matched == false -> break
        rt2, rv2 = cmp(toks, vals, pos)
        t1 = is-truthy(cur-t, cur-v)
        t2 = is-truthy(rt2, rv2)
        t1 == 0 || t2 == 0 -> {
            cur-t = EXPR-TOK-NUM
            cur-v = '0'
        }
    }
    rt = cur-t
    rv = cur-v
}

// parse-or: and ('|' and)*  (returns left if truthy, else right)
do-or = (toks []i64, vals []str, pos []i64) (rt i64, rv str) {
    cur-t i64
    cur-v str
    cur-t, cur-v = do-and(toks, vals, pos)
    !! {
        matched = match-op(toks, vals, pos, '|')
        matched == false -> break
        rt2, rv2 = do-and(toks, vals, pos)
        t1 = is-truthy(cur-t, cur-v)
        t1 == 0 -> {
            cur-t = rt2
            cur-v = rv2 - ''
        }
    }
    rt = cur-t
    rv = cur-v
}

expr-run = () {
    argc = args()

    argc < 3 -> {
        eprint('Usage: expr EXPR...')
        os.exit(2)
    }

    // Tokenize
    toks []i64
    vals []str
    tokenize(toks, vals)

    // Parse and evaluate
    pos []i64 = with-len(1)
    pos[0] = 0
    rt, rv = do-or(toks, vals, pos)

    // Output result
    print(rv)

    // Exit status: 0 if result is truthy, 1 if not, 2 on error
    truthy = is-truthy(rt, rv)
    truthy == 0 -> os.exit(1)
}
