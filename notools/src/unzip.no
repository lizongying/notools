// unzip.no — unzip utility
// List and extract zip archives
// Usage: unzip [-l] archive.zip [files...]
//   -l: list contents only
//   archive.zip: zip archive to extract
//   files: optional files to extract

main = () {
    argc = args()

    list-only = false
    filename = ''
    files []str

    i <- [2..argc): {
        a = arg(i)
        a == '-l' -> list-only = true
        ! a.starts-with('-') -> {
            is-filename = filename.len == 0
            is-filename -> filename = a
            ! is-filename -> files.push(a)
        }
    }

    filename.len == 0 -> {
        print('unzip: no archive specified')
        os.exit(1)
    }

    list-only -> list(filename)
    extract(filename, files)
}

list = (filename str) {
    ! fs.is-file(filename) -> {
        print('unzip: ' - filename - ': No such file or directory')
        os.exit(1)
    }
    raw = fs.read-file(filename)
    data = raw.to-bytes()

    archive = zip{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        sz = archive.size(i)
        method = archive.method(i)
        print(name - '  ' - sz.to-str() - '  ' - method.to-str())
    }
}

extract = (filename str, wanted []str) {
    ! fs.is-file(filename) -> {
        print('unzip: ' - filename - ': No such file or directory')
        os.exit(1)
    }
    raw = fs.read-file(filename)
    data = raw.to-bytes()

    archive = zip{
        data: data
    }

    n = archive.count()
    i <- [0..n): {
        name = archive.name(i)
        wanted.len > 0 -> {
            found = false
            j <- [0..wanted.len): {
                wanted[j] == name -> found = true
            }
            ! found -> {
                continue
            }
        }
        is-dir = name.ends-with('/')
        is-dir -> os.mkdir(name, 493)
        ! is-dir -> {
            content = archive.extract(i)
            fs.write-file(name, content)
        }
    }
}