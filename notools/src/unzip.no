; unzip.no — unzip utility
; List and extract zip archives
; Usage: unzip [-l] archive.zip [files...]
;   -l: list contents only
;
; NOTE: 不使用 zip 标准库结构体方法，也不使用模块级函数传递 []byte 参数。
;       Nolang 的 slice 所有权 bug 会导致传递 []byte 给函数时数据损坏。
;       使用自定义结构体方法，直接通过 .zdata 访问字节，避免传递 slice。

uz-arch {
    zdata []byte
}

; read-u32le: 读取 .zdata[off..off+4] 的小端序 u32
uz-arch.read-u32le = (off i64) (v i64) {
    off1 = (off + 1): {
        ok -> it

        -> _
    }

    off2 = (off + 2): {
        ok -> it

        -> _
    }

    off3 = (off + 3): {
        ok -> it

        -> _
    }
    d0 byte = .zdata[off]: {
        ok -> it

        -> _
    }
    d1 byte = .zdata[off1]: {
        ok -> it

        -> _
    }
    d2 byte = .zdata[off2]: {
        ok -> it

        -> _
    }
    d3 byte = .zdata[off3]: {
        ok -> it

        -> _
    }
    b0 = d0 & 255
    b1 = d1 & 255
    b2 = d2 & 255
    b3 = d3 & 255
    v = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

; read-u16le: 读取 .zdata[off..off+2] 的小端序 u16
uz-arch.read-u16le = (off i64) (v i64) {
    off1 = (off + 1): {
        ok -> it

        -> _
    }
    d0 byte = .zdata[off]: {
        ok -> it

        -> _
    }
    d1 byte = .zdata[off1]: {
        ok -> it

        -> _
    }
    b0 = d0 & 255
    b1 = d1 & 255
    v = b0 | (b1 << 8)
}

; find-eocd: 从尾部搜索 EOCD 签名 (0x06054b50)
uz-arch.find-eocd = () (off i64) {
    off = -1
    n = len(.zdata)
    n < 22 -> return

    i = (n - 22): {
        ok -> it

        -> _
    }
    (i >= 0) {
        d0 byte = .zdata[i]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        i1 = i + 1: {
            ok -> it

            -> _
        }
        d1 byte = .zdata[i1]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        i2 = i + 2: {
            ok -> it

            -> _
        }
        d2 byte = .zdata[i2]: {
            ok -> it

            -> _
        }

        #{overflow=wrap}
        i3 = i + 3: {
            ok -> it

            -> _
        }
        d3 byte = .zdata[i3]: {
            ok -> it

            -> _
        }
        b0 = d0 & 255
        b1 = d1 & 255
        b2 = d2 & 255
        b3 = d3 & 255
        sig = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        {
            sig == 101010256 -> {
                off = i
                return
            }
        }

        #{overflow=wrap}
        i = i - 1: {
            ok -> it

            -> _
        }
    }
}

; entry-offset: 计算第 idx 个 CD 条目的偏移
uz-arch.entry-offset = (idx i64) (off i64) {
    off = 0
    eocd = .find-eocd()
    eocd < 0 -> return

    #{overflow=wrap}
    off = .read-u32le(eocd + 16)
    j <- [0..idx): {

        #{overflow=wrap}
        name-len = .read-u16le(off + 28)

        #{overflow=wrap}
        extra-len = .read-u16le(off + 30)

        #{overflow=wrap}
        comment-len = .read-u16le(off + 32)

        #{overflow=wrap}
        no = off + 46 + name-len + extra-len + comment-len: {
            ok -> it

            -> _
        }
        off = no
    }
}

; read-name: 读取第 idx 个条目的档名
uz-arch.read-name = (idx i64) (name str) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    name-len = .read-u16le(off + 28)
    name = ''
    j <- [0..name-len): {

        #{overflow=wrap}
        zi = off + 46 + j: {
            ok -> it

            -> _
        }
        db byte = .zdata[zi]: {
            ok -> it

            -> _
        }
        jc char = db & 255
        name = name - jc.to-str()
    }
}

; read-size: 读取第 idx 个条目的原始大小
uz-arch.read-size = (idx i64) (sz i64) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    sz = .read-u32le(off + 24)
}

; read-method: 读取第 idx 个条目的压缩方式
uz-arch.read-method = (idx i64) (method i64) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    method = .read-u16le(off + 10)
}

; total: 读取条目总数
uz-arch.total = () (total i64) {
    total = 0
    eocd = .find-eocd()
    eocd < 0 -> return

    #{overflow=wrap}
    total = .read-u16le(eocd + 8)
}

; extract-stored: 提取 method 0 (stored) 条目，直接写文件
uz-arch.extract-stored = (idx i64, out-name str) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    sz = .read-u32le(off + 24)

    #{overflow=wrap}
    local-off = .read-u32le(off + 42)

    #{overflow=wrap}
    name-len2 = .read-u16le(local-off + 26)

    #{overflow=wrap}
    extra-len2 = .read-u16le(local-off + 28)

    #{overflow=wrap}
    data-off = local-off + 30 + name-len2 + extra-len2

    out []byte = with-len(sz)
    i <- [0..sz): {

        #{overflow=wrap}
        zi = data-off + i: {
            ok -> it

            -> _
        }
        d9v1 byte = .zdata[zi]: {
            ok -> it

            -> _
        }
        out[i]: {
            ok -> it = d9v1

            -> _
        }
    }
    fs.write-file(out-name, out)
}

; extract-deflate: 提取 method 8 (deflate) 条目，解压后写文件
uz-arch.extract-deflate = (idx i64, out-name str) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    sz = .read-u32le(off + 24)

    #{overflow=wrap}
    csz = .read-u32le(off + 20)

    #{overflow=wrap}
    local-off = .read-u32le(off + 42)

    #{overflow=wrap}
    name-len2 = .read-u16le(local-off + 26)

    #{overflow=wrap}
    extra-len2 = .read-u16le(local-off + 28)

    #{overflow=wrap}
    data-off = local-off + 30 + name-len2 + extra-len2

    compressed []byte = with-len(csz)
    i <- [0..csz): {

        #{overflow=wrap}
        zi2 = data-off + i: {
            ok -> it

            -> _
        }
        d9v2 byte = .zdata[zi2]: {
            ok -> it

            -> _
        }
        compressed[i]: {
            ok -> it = d9v2

            -> _
        }
    }
    decompressed = gzip.inflate-decompress(compressed, sz)
    fs.write-file(out-name, decompressed)
}

; make-parent-dirs: 创建父目录
make-parent-dirs = (name str) {
    n = name.len()
    i <- [1..n): {
        name[i] == '/' -> {
            dir = name.slice(0, i)
            dir.len() > 0 -> {
                ! fs.is-dir(dir) -> os.mkdir(dir, 511)
            }
        }
    }
}

unzip-run = () {
    argc = os.args().len()

    list-only = false
    filename = ''

    i <- [2..argc): {
        a-opt = os.arg(i)
        a = a-opt: {
            ok -> it

            -> ''
        }
        a == '-l' -> list-only = true
        ! a.starts-with('-') -> {
            filename.len() == 0 -> filename = a
        }
    }

    {
        filename.len() == 0 -> {
            io.errln('unzip: no archive specified')
            exit(1)
        }

        ! fs.is-file(filename) -> {
            io.errln('unzip: ' - filename - ': No such file or directory')
            exit(1)
        }
    }

    raw []byte
    r = fs.read-bytes(filename)
    r: {
        ok -> raw = it

        nil -> {
        }

        err -> {
        }
    }
    buf []byte = raw

    archive = uz-arch{
        zdata: buf
    }

    n = archive.total()
    {
        n == 0 -> {
            io.errln('unzip: ' - filename - ': not a valid zip archive')
            exit(1)
        }

        list-only -> {
            i <- [0..n): {
                name = archive.read-name(i)
                sz = archive.read-size(i)
                method = archive.read-method(i)

                io.outln(name - '  ' - sz.to-str() - '  ' - method.to-str())
            }
            exit(0)
        }
    }

    ; Extract mode
    i <- [0..n): {
        name = archive.read-name(i)
        method = archive.read-method(i)
        is-dir = name.ends-with('/')
        is-dir -> os.mkdir(name, 493)
        ! is-dir -> {
            make-parent-dirs(name)
            method == 0 -> archive.extract-stored(i, name)
            method == 8 -> archive.extract-deflate(i, name)
        }
    }
}
