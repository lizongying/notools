; ptoml.no — TOML parser and serializer
;
; A minimal TOML parser for reading and writing pyproject.toml files.
; Supports: tables, key-value pairs, strings, integers, booleans,
; arrays, inline tables, and section headers.
;
; API:
;   parse(content str) (out str) — parse TOML to flat key-string format
;   get-value(parsed str, key str) (val ?str) — get value by key
;   set-value(parsed str, key str, val str) (out str) — set value
;   serialize(parsed str) (out str) — serialize back to TOML text

# /nouv/src/utils

; ═══════════════════════════════════════════════
; parse — parse TOML content into flat key=value format
;
; content str — TOML text
; returns:
;   out str — flat representation, one key=value per line
;             keys are fully qualified (e.g. project.name, project.dependencies)
; ═══════════════════════════════════════════════

parse = (content str) (out str) {
    out = ''
    current-table = ''

    ; per-name occurrence counters for [[array-of-tables]] blocks ('name=count\n')
    arr = ''
    lines = utils.split-str(content, '\n')
    n = lines.len()
    i = 0

    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1

        ; trim whitespace
        line = utils.trim-str(line)

        ; skip empty lines and comments
        {
            line == '' -> continue

            utils.starts-with-str(line, '#') -> continue
        }

        ; section header [xxx]
        {
            utils.starts-with-str(line, '[') -> {
                utils.ends-with-str(line, ']') -> {

                    ; extract table name
                    #{overflow=wrap}
                    tname = utils.slice-str(line, 1, line.len-bytes() - 1)
                    tname = utils.trim-str(tname)
                    {
                        utils.starts-with-str(tname, '[') -> {
                            utils.ends-with-str(tname, ']') -> {

                                ; array of tables [[xxx]] — assign an instance index so
                                ; repeated blocks do not overwrite each other
                                #{overflow=wrap}
                                nm = utils.slice-str(tname, 1, tname.len-bytes() - 1)
                                nm = utils.trim-str(nm)
                                idx i64
                                idx, arr = next-arr-index(arr, nm)
                                current-table = nm - '.' - idx.to-str()
                            }
                        }

                        -> {
                            current-table = tname
                        }
                    }
                    continue
                }
            }
        }

        ; key = value
        eq-pos = utils.index-str(line, '=')
        {
            eq-pos < 0 -> continue

            -> {

                ; extract key
                key = utils.slice-str(line, 0, eq-pos)
                key = utils.trim-str(key)

                ; remove quotes from key
                {
                    utils.starts-with-str(key, '"') -> {

                        #{overflow=wrap}
                        {
                            utils.ends-with-str(key, '"') -> key = utils.slice-str(key, 1, key.len-bytes() - 1)
                        }
                    }

                    utils.starts-with-str(key, '\'') -> {

                        #{overflow=wrap}
                        utils.ends-with-str(key, '\'') -> key = utils.slice-str(key, 1, key.len-bytes() - 1)
                    }
                }

                ; extract value
                #{overflow=wrap}
                val = utils.slice-str(line, eq-pos + 1, line.len-bytes())
                val = utils.trim-str(val)

                ; remove inline comment
                hash-pos = find-unquoted-hash(val)
                {
                    hash-pos >= 0 -> val = utils.slice-str(val, 0, hash-pos)
                }
                val = utils.trim-str(val)

                ; build full key
                full-key = key
                {
                    current-table != '' -> full-key = current-table - '.' - key
                }

                ; handle multi-line arrays
                {
                    utils.starts-with-str(val, '[') -> {
                        ! utils.ends-with-str(val, ']') -> {

                            ; collect continuation lines
                            (i < n) {

                                #{index-out=zero}
                                next-line = lines[i]

                                #{overflow=wrap}
                                i = i + 1
                                tl = utils.trim-str(next-line)
                                val = val - ' ' - tl
                                {
                                    utils.ends-with-str(tl, ']') -> break
                                }
                            }
                        }
                    }
                }

                out = out - full-key - '=' - val - '\n'
            }
        }
    }
}

; ═══════════════════════════════════════════════
; next-arr-index — return the 0-based instance index for a [[array-of-tables]]
; name and the updated counter accumulator
; ═══════════════════════════════════════════════

next-arr-index = (arr str, name str) (idx i64, out str) {
    idx = 0
    out = ''
    found = false
    lines = utils.split-str(arr, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            line == '' -> continue

            utils.starts-with-str(line, name - '=') -> {
                found = true
                eq = utils.index-str(line, '=')

                #{overflow=wrap}
                vstr = utils.slice-str(line, eq + 1, line.len-bytes())
                num = vstr.to-i64()
                num: {
                    ok -> idx = it

                    nil -> idx = 0

                    err -> idx = 0
                }
                out = out - name - '=' - (idx + 1).to-str() - '\n'
            }

            -> out = out - line - '\n'
        }
    }
    ! found -> out = out - name - '=' - '1' - '\n'
}

; ═══════════════════════════════════════════════
; is-all-digits — true if the string is a non-empty run of ASCII digits
; ═══════════════════════════════════════════════

is-all-digits = (s str) (yes bool) {
    yes = false
    s.len() == 0 -> return
    n = s.len-bytes()
    i = 0
    all = true
    (i < n) {
        c = s[i]

        #{overflow=wrap}
        i = i + 1
        {
            c < 48 || c > 57 -> {
                all = false
                break
            }
        }
    }
    yes = all
}

; ═══════════════════════════════════════════════
; array-length — number of [[array-of-tables]] instances recorded for a table
; ═══════════════════════════════════════════════

array-length = (parsed str, table str) (n i64) {
    n = 0
    seen = ''
    prefix = table - '.'
    lines = utils.split-str(parsed, '\n')
    ln = lines.len()
    i = 0
    (i < ln) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            utils.starts-with-str(line, prefix) -> {
                eq = utils.index-str(line, '=')
                eq > 0 -> {
                    key = utils.slice-str(line, 0, eq)

                    rest = utils.slice-str(key, prefix.len-bytes(), key.len-bytes())
                    dot = utils.index-str(rest, '.')
                    dot > 0 -> {
                        idxstr = utils.slice-str(rest, 0, dot)
                        {
                            is-all-digits(idxstr) -> {
                                mark = idxstr - '\n'
                                ! seen.contains(mark) -> {
                                    seen = seen - mark

                                    #{overflow=wrap}
                                    n = n + 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-array-value — read a field of the idx-th [[array-of-tables]] instance
; ═══════════════════════════════════════════════

get-array-value = (parsed str, table str, idx i64, key str) (val ?str) {
    full = table - '.' - idx.to-str() - '.' - key
    val = get-value(parsed, full)
}

; ═══════════════════════════════════════════════
; find-unquoted-hash — find # not inside a string
; ═══════════════════════════════════════════════

find-unquoted-hash = (s str) (pos i64) {
    pos = -1
    in-str = false
    str-char = 0
    n = s.len-bytes()
    i = 0
    (i < n) {
        c = s[i]
        {
            in-str -> {
                c == str-char -> in-str = false
            }

            -> {
                c == 34 -> {
                    in-str = true
                    str-char = c
                }

                c == 39 -> {
                    in-str = true
                    str-char = c
                }

                c == 35 -> {
                    pos = i
                    break
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ═══════════════════════════════════════════════
; get-value — get value by fully qualified key
; ═══════════════════════════════════════════════

get-value = (parsed str, key str) (val ?str) {
    search = key - '='
    lines = utils.split-str(parsed, '\n')
    n = lines.len()
    i = 0
    (i < n) {
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            utils.starts-with-str(line, search) -> {
                eq-pos = utils.index-str(line, '=')
                {
                    eq-pos >= 0 -> {

                        #{overflow=wrap}
                        v = utils.slice-str(line, eq-pos + 1, line.len-bytes())
                        v = utils.trim-str(v)

                        ; strip quotes if present
                        {
                            utils.starts-with-str(v, '"') -> {
                                utils.ends-with-str(v, '"') -> {

                                    #{overflow=wrap}
                                    v = utils.slice-str(v, 1, v.len-bytes() - 1)
                                }
                            }
                        }
                        val = v
                        return
                    }
                }
            }
        }
    }
    val = nil
}

; ═══════════════════════════════════════════════
; set-value — set value for a key
; ═══════════════════════════════════════════════

set-value = (parsed str, key str, val str) (out str) {
    out = ''
    search = key - '='
    lines = utils.split-str(parsed, '\n')
    n = lines.len()
    i = 0
    found = false
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            utils.starts-with-str(line, search) -> {
                out = out - key - '=' - val - '\n'
                found = true
            }

            -> {
                out = out - line - '\n'
            }
        }
    }
    ! found -> {
        out = out - key - '=' - val - '\n'
    }
}

; ═══════════════════════════════════════════════
; serialize — convert parsed format back to TOML text
; ═══════════════════════════════════════════════

serialize = (parsed str) (out str) {
    out = ''
    lines = utils.split-str(parsed, '\n')
    n = lines.len()
    i = 0
    current-section = ''
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            line == '' -> continue

            -> {
                eq-pos = utils.index-str(line, '=')
                {
                    eq-pos < 0 -> continue

                    -> {
                        key = utils.slice-str(line, 0, eq-pos)

                        #{overflow=wrap}
                        val = utils.slice-str(line, eq-pos + 1, line.len-bytes())
                        val = utils.trim-str(val)

                        ; determine section
                        dot-pos = utils.rindex-str(key, '.')
                        {
                            dot-pos >= 0 -> {
                                section = utils.slice-str(key, 0, dot-pos)

                                ; sub-key
                                #{overflow=wrap}
                                sub-key = utils.slice-str(key, dot-pos + 1, key.len-bytes())

                                ; array-of-tables? the section ends with a numeric instance segment
                                sdot = utils.rindex-str(section, '.')
                                is-arr = false
                                base = ''
                                {
                                    sdot >= 0 -> {

                                        #{overflow=wrap}
                                        tail = utils.slice-str(section, sdot + 1, section.len-bytes())
                                        {
                                            is-all-digits(tail) -> {
                                                is-arr = true
                                                base = utils.slice-str(section, 0, sdot)
                                            }
                                        }
                                    }
                                }
                                {
                                    is-arr -> {
                                        marker = base - '\x00' - section
                                        {
                                            marker != current-section -> {
                                                out = out - '\n[[' - base - ']]\n'
                                                current-section = marker
                                            }
                                        }
                                    }

                                    -> {
                                        {
                                            section != current-section -> {
                                                out = out - '\n[' - section - ']\n'
                                                current-section = section
                                            }
                                        }
                                    }
                                }
                                out = out - sub-key - ' = ' - val - '\n'
                            }

                            -> {

                                ; top-level key
                                out = out - key - ' = ' - val - '\n'
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; parse-array — parse a TOML array value into newline-separated items
; val str — array value like "['foo', 'bar']"
; returns: items str — newline-separated items
; ═══════════════════════════════════════════════

parse-array = (val str) (items str) {
    items = ''
    val = utils.trim-str(val)
    {
        utils.starts-with-str(val, '[') -> val = utils.slice-str(val, 1, val.len-bytes())
    }
    {
        utils.ends-with-str(val, ']') -> {

            #{overflow=wrap}
            val = utils.slice-str(val, 0, val.len-bytes() - 1)
        }
    }
    val = utils.trim-str(val)
    {
        val == '' -> return

        -> {
            parts = utils.split-str(val, ',')
            n = parts.len()
            i = 0
            (i < n) {
                item = parts[i]
                item = utils.trim-str(item)
                {
                    utils.starts-with-str(item, '"') -> {

                        #{overflow=wrap}
                        {
                            utils.ends-with-str(item, '"') -> item = utils.slice-str(item, 1, item.len-bytes() - 1)
                        }
                    }

                    utils.starts-with-str(item, '\'') -> {

                        #{overflow=wrap}
                        utils.ends-with-str(item, '\'') -> item = utils.slice-str(item, 1, item.len-bytes() - 1)
                    }
                }
                item = utils.trim-str(item)
                item.len() > 0 -> items = items - item - '\n'

                #{overflow=wrap}
                i = i + 1
            }
        }
    }
}

; ═══════════════════════════════════════════════
; make-array-value — create a TOML array value from newline-separated items
; items str — newline-separated items
; returns: val str — TOML array like ['item1', 'item2']
; ═══════════════════════════════════════════════

make-array-value = (items str) (val str) {
    quote = '"'

    ; accumulate into a local: writing straight into the named return from
    ; inside a loop body is dropped by the MIR backend
    acc = '['
    lines = utils.split-str(items, '\n')
    n = lines.len()
    first = true
    i = 0
    (i < n) {

        #{index-out=zero}
        item = lines[i]

        #{overflow=wrap}
        i = i + 1
        item = utils.trim-str(item)
        {
            item.len-bytes() > 0 -> {
                ! first -> acc = acc - ', '

                acc = acc - quote - item - quote
                first = false
            }
        }
    }
    val = acc - ']'
}

; ═══════════════════════════════════════════════
; get-value-str — get value as str (not ?str) to avoid cross-module type issues
; returns: val str, found bool
; ═══════════════════════════════════════════════

get-value-str = (parsed str, key str) (val ?str) {
    val = nil
    search = key - '='
    lines = utils.split-str(parsed, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            utils.starts-with-str(line, search) -> {
                eq-pos = utils.index-str(line, '=')
                {
                    eq-pos >= 0 -> {

                        #{overflow=wrap}
                        v = utils.slice-str(line, eq-pos + 1, line.len-bytes())
                        v = utils.trim-str(v)

                        ; strip quotes if present
                        {
                            utils.starts-with-str(v, '"') -> {
                                utils.ends-with-str(v, '"') -> {

                                    #{overflow=wrap}
                                    v = utils.slice-str(v, 1, v.len-bytes() - 1)
                                }
                            }
                        }
                        val = v
                        return
                    }
                }
            }
        }
    }
}
