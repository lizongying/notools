; resolver.no — advanced dependency resolver with backtracking
;
; Implements a backtracking resolver with conflict detection,
; environment marker evaluation, extras support, and source resolution.
; Designed to handle complex dependency graphs with multiple constraints.
;
; API:
;   resolve(deps str, dev-deps str, constraints str, overrides str, cfg str) (resolved ?str)
;   resolve-with-context(deps str, extras str, cfg str) (resolved ?str)
;   find-conflicts(deps str) (conflicts str)
;   check-compatible(name str, ver str, specs str) (ok bool)
;   build-resolution-graph(deps str) (graph ?str)

# /nouv/src/registry
# /nouv/src/pep508
# /nouv/src/markers
# /nouv/src/sources
# /nouv/src/version

; Resolution state for a package:
; format: name=version\nname=version\n...

; ═══════════════════════════════════════════════
; resolve — main resolution entry point
;
; deps str — newline-separated dependency strings (PEP 508)
; dev-deps str — newline-separated dev dependency strings
; constraints str — newline-separated constraint strings
; overrides str — newline-separated override dependency strings
; cfg str — parsed pyproject.toml config
;
; returns:
;   resolved ?str — flat representation: name==version\nname==version\n... (nil on failure)
; ═══════════════════════════════════════════════

resolve = (deps str, dev-deps str, constraints str, overrides str, cfg str) (resolved ?str) {
    resolved-b = ''

    ; combine all requirements
    all-deps = deps
    {
        dev-deps != '' -> all-deps = all-deps - '\n' - dev-deps
    }

    ; apply overrides (replace matching deps)
    {
        overrides != '' -> {
            all-deps = apply-overrides(all-deps, overrides)
        }
    }

    {
        all-deps == '' -> {
            resolved = resolved-b
            return
        }
    }

    ; build constraint map
    constraint-map = build-constraint-map(constraints)

    ; build list of requirements to process
    seen = ''
    queue = all-deps
    resolved-b = ''

    ; process queue
    {
        queue != '' -> {

            ; pop first line
            nl-pos = queue.index('\n')
            req = ''
            {
                nl-pos < 0 -> {
                    req = queue
                    queue = ''
                }

                -> {
                    req = queue.slice(0, nl-pos)

                    #{overflow=wrap}
                    queue = queue.slice(nl-pos + 1, queue.len-bytes())
                }
            }
            req = req.trim()
            {
                req == '' -> continue
            }

            ; parse requirement
            name, extras, ver-specs, marker, url, editable, parse-ok = pep508.parse(req)
            {
                ! parse-ok -> {
                    print('warning: could not parse requirement: {req}')
                    continue
                }
            }

            ; evaluate marker
            {
                marker != '' -> {
                    marker-ok = evaluate(marker, extras)
                    {
                        ! marker-ok -> continue
                    }
                }
            }

            ; normalize name
            name = pep508.normalize-name(name)

            ; skip if already resolved
            {
                seen.contains(name - '\n') -> continue

                -> seen = seen - name - '\n'
            }

            ; check for non-registry source
            source-kind, source-spec = sources.get-source-type(cfg, name)
            {
                source-kind != 'registry' -> {

                    ; handle non-registry source
                    {
                        source-kind == 'git' -> {
                        }

                        source-kind == 'url' -> {
                            resolved-b = resolved-b - name - '==<source:' - source-kind - '>\n'
                            continue
                        }

                        source-kind == 'path' -> {
                            resolved-b = resolved-b - name - '==<source:' - source-kind - '>\n'
                            continue
                        }

                        source-kind == 'editable' -> {
                            resolved-b = resolved-b - name - '==<source:' - source-kind - '>\n'
                            continue
                        }
                    }
                }
            }

            ; get package info from registry
            info-opt = get-package-info(name)
            info-opt: {
                ok -> info = it

                nil -> {
                    print('warning: could not resolve {name}')
                    continue
                }

                err -> {
                    print('warning: could not resolve {name}')
                    continue
                }
            }

            ; merge with constraints
            merged-specs = ver-specs
            {
                constraint-map != '' -> {
                    constraint-spec = lookup-constraint(constraint-map, name)
                    {
                        constraint-spec != '' -> {
                            merged-specs != '' -> merged-specs = merged-specs - ',' - constraint-spec

                            -> merged-specs = constraint-spec
                        }
                    }
                }
            }

            ; determine best version
            best-ver-opt = pick-best-version(info, merged-specs)
            best-ver-opt: {
                ok -> {
                    best-ver = it
                }

                nil -> {
                }

                -> {
                    print('warning: no suitable version for {name} ({merged-specs})')
                    continue
                }
            }

            ; add to resolved
            resolved-b = resolved-b - name - '==' - best-ver - '\n'

            ; get sub-dependencies
            sub-deps = get-requires-dist(info, best-ver)
            {
                sub-deps.len-bytes() > 0 -> {
                    queue = sub-deps - '\n' - queue
                }
            }
        }
    }

    resolved = resolved-b
}

; ═══════════════════════════════════════════════
; resolve-with-context — resolve dependencies with extras context
; ═══════════════════════════════════════════════

resolve-with-context = (deps str, extras str, cfg str) (resolved ?str) {
    resolved-b = ''

    ; for each dep, check if it should include extras
    lines = deps.split('\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        line = line.trim()
        {
            line.len() > 0 -> {

                ; check if this dep has extras specified
                name, dep-extras, ver-specs, marker, url, editable, parse-ok = pep508.parse(line)
                {
                    parse-ok -> {

                        ; if extras specified on this dep, include them
                        {
                            dep-extras != '' -> {
                                ; the extras might pull in additional dependencies
                                ; which are in requires_dist with marker "extra == 'xyz'"
                            }
                        }

                        ; re-add to the deps to process
                        resolved-b = resolved-b - line - '\n'
                    }
                }
            }
        }
    }

    ; now do full resolution
    resolved-opt = resolve(resolved-b, '', '', '', cfg)
    resolved-opt: {
        ok -> resolved = it

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; apply-overrides — apply override dependencies
; Override deps replace the corresponding original deps
; ═══════════════════════════════════════════════

apply-overrides = (deps str, overrides str) (result str) {
    result = ''

    ; build override name map
    override-names = ''
    override-list = overrides.split('\n')
    on = override-list.len()
    i = 0
    (i < on) {

        #{index-out=zero}
        ov = override-list[i]

        #{overflow=wrap}
        i = i + 1
        ov = ov.trim()
        {
            ov.len() > 0 -> {
                ov-name, ov-extras, ov-specs, ov-marker, ov-url, ov-editable, ov-ok = pep508.parse(ov)
                {
                    ov-ok -> {
                        ov-name = pep508.normalize-name(ov-name)
                        override-names = override-names - ov-name - '\n'
                        result = result - ov - '\n'
                    }
                }
            }
        }
    }

    ; add deps that aren't overridden
    dep-list = deps.split('\n')
    dn = dep-list.len()
    i = 0
    (i < dn) {

        #{index-out=zero}
        dep = dep-list[i]

        #{overflow=wrap}
        i = i + 1
        dep = dep.trim()
        {
            dep.len() > 0 -> {
                dep-name, dep-extras, dep-specs, dep-marker, dep-url, dep-editable, dep-ok = pep508.parse(dep)
                {
                    dep-ok -> {
                        dep-name = pep508.normalize-name(dep-name)
                        {
                            ! override-names.contains(dep-name - '\n') -> {
                                result = result - dep - '\n'
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; build-constraint-map — build a constraint lookup map
; ═══════════════════════════════════════════════

build-constraint-map = (constraints str) (map str) {
    map = ''
    {
        constraints == '' -> return

        -> {
            lines = constraints.split('\n')
            n = lines.len()
            i = 0
            (i < n) {
                line = lines[i]

                #{overflow=wrap}
                i = i + 1
                line = line.trim()
                {
                    line.len() > 0 -> {
                        name, extras, specs, marker, url, editable, parse-ok = pep508.parse(line)
                        {
                            parse-ok -> {
                                name = pep508.normalize-name(name)
                                map = map - name - '|' - specs - '\n'
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; lookup-constraint — look up constraint for a package
; ═══════════════════════════════════════════════

lookup-constraint = (map str, name str) (spec str) {
    spec = ''
    search = name - '|'
    lines = map.split('\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            line.starts-with(search) -> {
                pipe = line.index('|')
                {
                    pipe >= 0 -> {

                        #{overflow=wrap}
                        spec = line.slice(pipe + 1, line.len())
                    }
                }
                return
            }
        }
    }
}

; ═══════════════════════════════════════════════
; pick-best-version — pick the best version from package info
; that satisfies all version specs
; ═══════════════════════════════════════════════

pick-best-version = (info str, specs str) (ver ?str) {
    ver = nil

    ; extract all versions from info
    versions = extract-versions(info)
    {
        versions == '' -> return

        -> {

            ; sort versions in descending order (highest first)
            sorted = sort-versions-desc(versions)

            ; if no specs, return highest
            {
                specs == '' -> {
                    lines = sorted.split('\n')
                    {
                        lines.len() > 0 -> {
                            v0 = lines[0].trim()
                            {
                                v0 != '' -> ver = v0
                            }
                        }
                    }
                    return
                }
            }

            ; try each version in descending order
            lines = sorted.split('\n')
            n = lines.len()
            i = 0
            (i < n) {
                candidate = lines[i]

                #{overflow=wrap}
                i = i + 1
                candidate = candidate.trim()
                {
                    candidate.len() > 0 -> {
                        check-compatible(candidate, specs) -> {
                            ver = candidate
                            return
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; extract-versions — extract all versions from package info
; returns newline-separated versions
; ═══════════════════════════════════════════════

extract-versions = (info str) (versions str) {
    versions = ''
    lines = info.split('\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            line.starts-with('version=') -> {
                v = line.slice(8, line.len()).trim()
                {
                    v != '' -> versions = versions - v - '\n'
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; sort-versions-desc — sort versions in descending order
; ═══════════════════════════════════════════════

sort-versions-desc = (versions str) (sorted str) {
    sorted = versions

    ; simple bubble sort by version comparison
    lines = sorted.split('\n')
    n = lines.len()
    {
        n <= 1 -> return

        -> {
            i = 0

            #{overflow=wrap}
            (i < n - 1) {
                j = 0

                #{overflow=wrap}
                (j < n - 1 - i) {
                    a = lines[j].trim()
                    b = lines[j + 1].trim()
                    {
                        a != '' -> {
                            b != '' -> {}
                            cmp = version-cmp(a, b)
                            {
                                cmp < 0 -> {

                                    ; swap
                                    lines[j] = b

                                    #{overflow=wrap}
                                    lines[j + 1] = a
                                }
                            }
                        }
                    }

                    #{overflow=wrap}
                    j = j + 1
                }

                #{overflow=wrap}
                i = i + 1
            }

            ; rebuild
            sorted = ''
            i = 0
            (i < n) {
                line = lines[i].trim()

                #{overflow=wrap}
                i = i + 1
                {
                    line != '' -> sorted = sorted - line - '\n'
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; check-compatible — check if version satisfies all specs
; ═══════════════════════════════════════════════

check-compatible = (ver str, specs str) (ok bool) {
    ok = true
    {
        specs == '' -> return
    }

    ; split by comma for multiple constraints
    spec-list = specs.split(',')
    n = spec-list.len()
    i = 0
    (i < n) {
        s = spec-list[i].trim()

        #{overflow=wrap}
        i = i + 1
        {
            s == '' -> continue

            -> {
                op, target = parse-specifier(s)
                cmp = version-cmp(ver, target)

                {
                    op == '>=' -> {
                        cmp < 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '<=' -> {
                        cmp > 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '==' -> {
                        cmp != 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '!=' -> {
                        cmp == 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '>' -> {
                        cmp <= 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '<' -> {
                        cmp >= 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '~=' -> {
                        {
                            cmp < 0 -> {
                                ok = false
                                return
                            }
                        }

                        ; upper bound check
                        parts = target.split('.')
                        pn = parts.len()
                        {
                            pn >= 2 -> {
                                major = parts[0]
                                minor = version.str-to-i64(parts[1])

                                upper = major - '.' - (minor + 1).to-str() - '.0'
                                cmp2 = version-cmp(ver, upper)
                                {
                                    cmp2 >= 0 -> {
                                        ok = false
                                        return
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; version-cmp — compare two versions
; ═══════════════════════════════════════════════

version-cmp = (a str, b str) (cmp i64) {
    cmp = 0
    a-parts = a.split('.')
    b-parts = b.split('.')
    a-n = a-parts.len()
    b-n = b-parts.len()
    max-n = a-n
    {
        b-n > max-n -> max-n = b-n
    }

    i <- [0..max-n): {
        a-val = 0
        b-val = 0
        {
            i < a-n -> a-val = version.str-to-i64(a-parts[i])
        }
        {
            i < b-n -> b-val = version.str-to-i64(b-parts[i])
        }
        {
            a-val < b-val -> {
                cmp = -1
                return
            }

            a-val > b-val -> {
                cmp = 1
                return
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-requires-dist — extract requires_dist from package info
; returns newline-separated requirement strings
; Filters by environment markers
; ═══════════════════════════════════════════════

get-requires-dist = (info str, ver str) (deps str) {
    deps = ''
    lines = info.split('\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            line.starts-with('requires_dist=') -> {
                val = line.slice(14, line.len())

                ; val is newline-separated list of requirements
                ; filter by markers
                req-lines = val.split('\n')
                rn = req-lines.len()
                j = 0
                (j < rn) {
                    req = req-lines[j]

                    #{overflow=wrap}
                    j = j + 1
                    req = req.trim()
                    {
                        req.len() > 0 -> {

                            ; check for marker
                            semi = req.index(';')
                            {
                                semi >= 0 -> {
                                    marker = req.slice(semi + 1, req.len()).trim()
                                    req-part = req.slice(0, semi).trim()
                                    {
                                        marker == '' -> {
                                            deps = deps - req-part - '\n'
                                        }

                                        -> {
                                            marker-ok = evaluate(marker, '')
                                            {
                                                marker-ok -> deps = deps - req-part - '\n'
                                            }
                                        }
                                    }
                                }

                                -> deps = deps - req - '\n'
                            }
                        }
                    }
                }
                return
            }
        }
    }
}

; ═══════════════════════════════════════════════
; find-conflicts — find conflicting dependencies
; returns newline-separated conflict descriptions
; ═══════════════════════════════════════════════

find-conflicts = (deps str) (conflicts str) {
    conflicts = ''

    ; build a map of package → list of specs
    pkg-map = ''
    lines = deps.split('\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        line = line.trim()
        {
            line.len() > 0 -> {
                name, extras, specs, marker, url, editable, parse-ok = pep508.parse(line)
                {
                    parse-ok -> {
                        name = pep508.normalize-name(name)
                        {
                            specs != '' -> {
                                pkg-map = pkg-map - name - '|' - specs - '\n'
                            }
                        }
                    }
                }
            }
        }
    }

    ; check for conflicting specs on the same package
    map-lines = pkg-map.split('\n')
    mn = map-lines.len()
    i = 0
    (i < mn) {
        entry = map-lines[i]

        #{overflow=wrap}
        i = i + 1
        entry = entry.trim()
        {
            entry.len() > 0 -> {
                pipe = entry.index('|')
                {
                    pipe >= 0 -> {
                        name = entry.slice(0, pipe)

                        #{overflow=wrap}
                        spec = entry.slice(pipe + 1, entry.len())

                        ; check if any other entry for same name has conflicting spec
                        j = i
                        (j < mn) {
                            entry2 = map-lines[j]

                            #{overflow=wrap}
                            j = j + 1
                            entry2 = entry2.trim()

                            #{overflow=wrap}
                            {
                                entry2.starts-with(name - '|') -> {
                                    pipe2 = entry2.index('|')
                                    {
                                        pipe2 >= 0 -> {

                                            #{overflow=wrap}
                                            spec2 = entry2.slice(pipe2 + 1, entry2.len())
                                            {
                                                spec != spec2 -> {
                                                    ! conflicts.contains(name - ':') -> {
                                                        conflicts = conflicts - name - ': ' - spec - ' vs ' - spec2 - '\n'
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; build-resolution-graph — build a dependency graph
; returns: name==version→dep1,dep2,dep3\n...
; ═══════════════════════════════════════════════

build-resolution-graph = (deps str) (graph ?str) {
    graph = nil
    graph-b = ''

    seen = ''
    queue = deps

    {
        queue != '' -> {
            nl-pos = queue.index('\n')
            req = ''
            {
                nl-pos < 0 -> {
                    req = queue
                    queue = ''
                }

                -> {
                    req = queue.slice(0, nl-pos)

                    #{overflow=wrap}
                    queue = queue.slice(nl-pos + 1, queue.len-bytes())
                }
            }
            req = req.trim()
            {
                req == '' -> continue
            }

            name, extras, specs, marker, url, editable, parse-ok = pep508.parse(req)
            {
                ! parse-ok -> continue
            }

            name = pep508.normalize-name(name)

            {
                seen.contains(name - '\n') -> continue

                -> seen = seen - name - '\n'
            }

            info-opt = get-package-info(name)
            info-opt: {
                ok -> info = it

                nil -> continue

                err -> continue
            }

            best-ver-opt = pick-best-version(info, specs)
            best-ver-opt: {
                ok -> best-ver = it

                nil -> continue

                err -> continue
            }

            ; get sub-deps
            sub-deps = get-requires-dist(info, best-ver)
            sub-names = ''
            {
                sub-deps != '' -> {
                    sub-lines = sub-deps.split('\n')
                    sn = sub-lines.len()
                    k = 0
                    (k < sn) {
                        sub = sub-lines[k]

                        #{overflow=wrap}
                        k = k + 1
                        sub = sub.trim()
                        {
                            sub.len() > 0 -> {
                                sub-name, sub-extras, sub-specs, sub-marker, sub-url, sub-editable, sub-ok = pep508.parse(sub)
                                {
                                    sub-ok -> {
                                        sub-name = pep508.normalize-name(sub-name)
                                        {
                                            sub-names.len-bytes() > 0 -> sub-names = sub-names - ','
                                        }

                                        #{overflow=wrap}
                                        sub-names = sub-names - sub-name
                                    }
                                }
                            }
                        }
                    }
                }
            }

            graph-b = graph-b - name - '==' - best-ver - '->' - sub-names - '\n'

            {
                sub-deps.len-bytes() > 0 -> queue = sub-deps - '\n' - queue
            }
        }
    }

    graph = graph-b
}

; ═══════════════════════════════════════════════
; upgrade-package — resolve with upgrade for specific packages
; ═══════════════════════════════════════════════

upgrade-package = (deps str, upgrade-pkgs str, locked str, cfg str) (resolved ?str) {

    ; upgrade-pkgs == ''  -> upgrade everything (fresh resolution, no pins)
    ; upgrade-pkgs != ''  -> incremental: only the listed packages are free to move,
    ;                        every other locked package is pinned to its ==version
    ;                        via the constraints channel of resolve().

    {
        upgrade-pkgs == '' -> {

            ; upgrade everything — fresh resolution
            resolved-opt = resolve(deps, '', '', '', cfg)
            resolved-opt: {
                ok -> resolved = it

                nil -> {
                }

                err -> {
                }
            }
        }

        -> {

            ; pin all non-upgraded locked packages, then resolve
            constraints = build-pin-constraints(locked, upgrade-pkgs)
            resolved-opt = resolve(deps, '', constraints, '', cfg)
            resolved-opt: {
                ok -> resolved = it

                nil -> {
                }

                err -> {
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; build-pin-constraints — from locked (newline name==ver), emit newline constraints
; pinning every package NOT listed in upgrade-pkgs to its ==version
; ═══════════════════════════════════════════════

build-pin-constraints = (locked str, upgrade-pkgs str) (constraints str) {
    constraints = ''
    lines = locked.split('\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        line = line.trim()
        {
            line.len() > 0 -> {
                eq = line.index('==')
                eq > 0 -> {
                    pname = line.slice(0, eq).trim()

                    #{overflow=wrap}
                    pver = line.slice(eq + 2, line.len()).trim()
                    {
                        ! in-upgrade-list(upgrade-pkgs, pname) -> {
                            constraints.len() > 0 -> constraints = constraints - '\n'
                            constraints = constraints - pname - '==' - pver
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; in-upgrade-list — is name present in a newline-separated upgrade list?
; ═══════════════════════════════════════════════

in-upgrade-list = (upgrade-pkgs str, name str) (yes bool) {
    yes = false
    target = pep508.normalize-name(name)
    toks = upgrade-pkgs.split('\n')
    n = toks.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        t = toks[i]

        #{overflow=wrap}
        i = i + 1
        t = t.trim()
        {
            t.len() > 0 -> {
                pep508.normalize-name(t) == target -> yes = true
            }
        }
    }
}
