; httpclient.no — minimal HTTPS/1.1 GET client over the pure-Nolang TLS module
;
; Why this exists:
;   - std http.get (src/std/net/http.no) caps responses at HTTP-MAX-RESPONSE
;     (16 KB), but PyPI JSON metadata is ~190 KB.
;   - std json is broken at runtime in this compiler build (option-match `it`
;     loses its type → silent crash on `.get`).
; So we fetch with the raw tls module (handles arbitrarily large bodies split
; across multiple TLS records) and decode the JSON with the companion `jsonx`
; module.  No curl, no python3, no external process — pure Nolang.
;
; Keep-alive safety:
;   PyPI (and many CDNs) answer with `Connection: keep-alive` and do NOT close
;   the socket after the body, so reading until EOF would block `recv` forever.
;   Instead we scan the header for `Content-Length`, then read exactly that
;   many body bytes.  All header/body parsing is done on the raw `[]byte`
;   buffer — never via `result.to-str()` + str ops, which trips a MIR codegen
;   bug in this compiler build.

# /nouv/src/utils

; ═══════════════════════════════════════════════
; http-timeout-ms — per-request wall-clock budget in milliseconds.
;
; The std tls conn reads via non-blocking recv + short sleeps, so SO_RCVTIMEO
; (MSG_DONTWAIT) would be ignored; a single recv is already bounded (~2s) but
; the outer header/body loops had no overall limit and could stall for minutes
; on a slow/half-open server. We therefore enforce an absolute deadline based
; on this budget.  Configurable via NOUV_HTTP_TIMEOUT (whole seconds);
; default 30s.
; ═══════════════════════════════════════════════

http-timeout-ms = () (ms i64) {
    ms = 30000
    env = os.get-env('NOUV_HTTP_TIMEOUT')
    env != '' -> {
        secs = env.to-i64()
        secs: {
            ok -> {

                #{overflow=wrap}
                it > 0 -> ms = it * 1000
            }

            nil -> {
            }

            err -> {
            }
        }
    }
}

; expired — true once the absolute deadline (ms since epoch) has passed
expired = (deadline i64) (yes bool) {
    yes = false
    time.now-ms() >= deadline -> yes = true
}

; ═══════════════════════════════════════════════
; http-get — fetch a URL, return (status, body-string, ok)
; The body is the full response body (after the header/body separator).
; ═══════════════════════════════════════════════

http-get = (url str) (status i64, body str, ok bool) {
    status = 0
    body = ''
    ok = false

    st, raw, good = http-get-bytes(url)
    good -> {
        status = st
        ok = true
        body = raw.to-str()
    }
}

; ═══════════════════════════════════════════════
; http-get-bytes — core fetch: returns the full body as []byte.
;
; Pure []byte implementation: header boundary, Content-Length and status code
; are all extracted with byte scans (see the helpers at the bottom).  This
; avoids the MIR `%vec`/`%str-long` codegen crash that `result.to-str()` +
; string ops trigger in this build.
; ═══════════════════════════════════════════════

http-get-bytes = (url str) (status i64, body []byte, ok bool) {
    status = 0
    body = with-len(0)
    ok = false

    ; retry on transient network failures (e.g. "connect failed: pypi.org"),
    ; which PyPI / CDNs occasionally return, especially when every request
    ; opens a fresh connection (Connection: close).  Permanent errors — bad
    ; url, or a non-2xx status the caller decides on — are not retried.
    attempts = 0
    max-attempts = 4

    ; one shared wall-clock budget across all retry attempts

    #{overflow=wrap}
    deadline = time.now-ms() + http-timeout-ms()
    (attempts < max-attempts) {
        st, raw, good = fetch-once(url, deadline)
        good -> {
            status = st
            body = raw
            ok = true
            attempts = max-attempts
        }

        -> {

            #{overflow=wrap}
            attempts = attempts + 1
            good == false -> print('httpclient: transient failure, retrying ' - url)

            ; budget exhausted: stop retrying so a slow server cannot stretch
            ; the total wait to attempts * timeout
            expired(deadline) -> attempts = max-attempts
        }
    }
}

; fetch-once — a single attempt at the full HTTPS GET (no retry).
; deadline i64: absolute ms-since-epoch budget; exceeded -> abort with ok=false.
; Returns (status, body, ok); ok is false on any network / connect failure.
fetch-once = (url str, deadline i64) (status i64, body []byte, ok bool) {
    status = 0
    body = with-len(0)
    ok = false

    expired(deadline) -> {
        print('httpclient: timeout before connect: ' - url)
        return
    }

    host, port, path, purl-ok = parse-url(url)
    purl-ok == false -> {
        print('httpclient: cannot parse url: ' - url)
        return
    }

    ; Build the request line-by-line: the compiler mis-lowers long
    ; str-concat chains (str - str - str …) into an invalid `sub`, so we
    ; keep each expression to a single binary concat.
    crlf = '\r\n'
    req = 'GET '
    req = req - path
    req = req - ' HTTP/1.1'
    req = req - crlf
    req = req - 'Host: '
    req = req - host
    req = req - crlf
    req = req - 'User-Agent: nouv/0.1.0'
    req = req - crlf
    req = req - 'Accept: */*'
    req = req - crlf
    req = req - 'Connection: close'
    req = req - crlf
    req = req - crlf

    tls-c tls.conn
    tls-c.init()
    connected = tls-c.connect(host, port)
    connected == false -> {
        print('httpclient: connect failed: ' - host)
        return
    }

    expired(deadline) -> {
        print('httpclient: timeout after connect: ' - host)
        tls-c.close()
        return
    }

    w = tls-c.send(req)
    w: {
        nil -> {
            tls-c.close()
            return
        }

        err -> {
            tls-c.close()
            return
        }

        ok -> {
        }
    }

    buf str = with-len(16640)
    result []byte = with-len(0)
    iters = 0
    header-end = -1
    content-length = -1

    ; ── Phase 1: read until the header/body separator (\r\n\r\n) is present ──
    (iters < 20000) {

        expired(deadline) -> break

        #{overflow=wrap}
        iters = iters + 1
        n = tls-c.recv(buf, 16640)
        n <= 0 -> break
        n > 0 -> {
            chunk []byte = with-len(n)
            j <- [0..n): {
                chunk[j] = buf.byte(j)
            }
            chunk.truncate(n)
            result = bytes-concat(result, chunk)
        }

        ; only re-scan once we plausibly have the full header line set
        header-end = find-crlfcrlf(result)
        header-end >= 0 -> {
            content-length = parse-content-length(result, header-end)
            break
        }
    }

    ; ── Phase 2: read exactly content-length body bytes (keep-alive safe) ──
    {
        header-end >= 0 -> {
            body-start = header-end + 4 #{overflow=wrap}
            end = body-start
            content-length >= 0 -> {

                #{overflow=wrap}
                end = body-start + content-length
            }

            ; top up the buffer until we have the whole body
            (result.len() < end) {
                expired(deadline) -> break
                n2 = tls-c.recv(buf, 16640)
                n2 <= 0 -> break
                chunk2 []byte = with-len(n2)
                j2 <- [0..n2): {
                    chunk2[j2] = buf.byte(j2)
                }
                chunk2.truncate(n2)
                result = bytes-concat(result, chunk2)
            }

            ; clamp to what we actually received (handles a short/closed body)
            result.len() < end -> end = result.len()
            body = slice-bytes(result, body-start, end)
            status = parse-status-code(result, header-end)
            ok = true
        }
    }

    tls-c.close()
}

; ═══════════════════════════════════════════════
; http-download — fetch a URL body and write it to dest (binary-safe)
; ═══════════════════════════════════════════════

http-download = (url str, dest str) (ok bool) {
    ok = false

    status, raw, good = http-get-bytes(url)
    good -> {
        status == 200 -> {
            r = fs.write-bytes(dest, raw)
            r: {
                ok -> ok = true

                nil -> {
                }

                err -> {
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; parse-url — split https://host[:port]/path
; ═══════════════════════════════════════════════

parse-url = (url str) (host str, port i64, path str, ok bool) {
    ok = false
    host = ''
    port = 443
    path = '/'

    url.starts-with('https://') == false -> return

    rest = utils.slice-str(url, 8, url.len-bytes())
    slash = rest.index('/')
    {
        slash < 0 -> {
            host = rest
            path = '/'
        }

        -> {
            host = utils.slice-str(rest, 0, slash)
            path = utils.slice-str(rest, slash, rest.len-bytes())
        }
    }

    colon = host.index(':')
    colon >= 0 -> {
        port-str = utils.slice-str(host, colon + 1, host.len-bytes()) #{overflow=wrap}
        host = utils.slice-str(host, 0, colon)
        port = atoi(port-str)
    }

    ok = true
}

; ═══════════════════════════════════════════════
; atoi — parse a non-negative decimal integer (stops at first non-digit)
; ═══════════════════════════════════════════════

atoi = (s str) (v i64) {
    v = 0
    n = s.len-bytes()
    i = 0
    (i < n) {
        d = s.byte(i)
        {
            d >= 48 -> d <= 57 -> {

                #{overflow=wrap}
                v = v * 10 + (d - 48)
            }

            -> i = n
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ═══════════════════════════════════════════════
; bytes-concat — append b to a, returning a fresh []byte
; ═══════════════════════════════════════════════

bytes-concat = (a []byte, b []byte) (out []byte) {
    an = a.len()
    bn = b.len()

    #{overflow=wrap}
    total-len = an + bn
    out = with-len(total-len)
    i <- [0..an): {

        #{index-out=zero}
        out[i] = a[i]
    }
    i <- [0..bn): {

        #{index-out=zero, overflow=wrap}
        out[an + i] = b[i]
    }
    out.truncate(total-len)
}

; ═══════════════════════════════════════════════
; Pure-[]byte HTTP parsing helpers (no str ops on the big buffer)
; ═══════════════════════════════════════════════

; find-crlfcrlf — index of the first `\r\n\r\n` (13,10,13,10) in b, else -1
; ⚠️ 外層 (n >= 4) 必須是一次性 if（→），不是 while（{ }）——
; 否則 n 不變、條件恆真，會變成無窮迴圈。
find-crlfcrlf = (b []byte) (pos i64) {
    pos = -1
    n = b.len()
    (n >= 4) -> {
        i = 0

        #{overflow=wrap}
        (i <= n - 4) {
            {
                b[i] == 13 -> {

                    #{overflow=wrap}
                    b[i + 1] == 10 -> b[i + 2] == 13 -> b[i + 3] == 10 -> {
                        pos = i
                        i = n
                    }
                }

                -> {
                }
            }

            #{overflow=wrap}
            i = i + 1
        }
    }
}

; find-substr — first occurrence of pat in b[from..to), else -1
find-substr = (b []byte, from i64, to i64, pat str) (pos i64) {
    pos = -1
    plen = pat.len-bytes()
    (plen <= 0) -> return
    (to - plen < from) -> return
    i = from

    #{overflow=wrap}
    (i <= to - plen) {
        match = true
        k = 0
        (k < plen) {

            #{overflow=wrap}
            b[i + k] == pat.byte(k) -> {

                #{overflow=wrap}
                k = k + 1
            }

            -> {
                match = false
                k = plen
            }
        }
        match -> {
            pos = i
            i = to
        }

        -> {

            #{overflow=wrap}
            i = i + 1
        }
    }
}

; parse-content-length — value of `Content-Length:` in the header b[0..header-end]
parse-content-length = (b []byte, header-end i64) (cl i64) {
    cl = -1
    key = 'Content-Length:'
    pos = find-substr(b, 0, header-end, key)
    pos >= 0 -> {
        start = pos + 15 #{overflow=wrap}

        ; skip leading spaces (0x20)
        (start < header-end) {
            b[start] == 32 -> {

                #{overflow=wrap}
                start = start + 1
            }

            -> break
        }
        val = 0
        (start < header-end) {
            c = b[start] #{index-out=0}
            {
                c >= 48 -> c <= 57 -> {

                    #{overflow=wrap}
                    val = val * 10 + (c - 48)

                    #{overflow=wrap}
                    start = start + 1
                }

                -> break
            }
        }
        cl = val
    }
}

; parse-status-code — HTTP status code from the first response line b[0..header-end]
parse-status-code = (b []byte, header-end i64) (code i64) {
    code = 0
    sp = -1
    i = 0
    (i < header-end) {
        b[i] == 32 -> {
            sp = i
            i = header-end
        }

        -> {

            #{overflow=wrap}
            i = i + 1
        }
    }
    sp >= 0 -> {
        j = sp + 1 #{overflow=wrap}
        (j < header-end) {
            c = b[j] #{index-out=0}
            {
                c >= 48 -> c <= 57 -> {

                    #{overflow=wrap}
                    code = code * 10 + (c - 48)

                    #{overflow=wrap}
                    j = j + 1
                }

                -> break
            }
        }
    }
}

; slice-bytes — b[from..to) as a fresh []byte (ranges clamped safely)
; ⚠️ 外層 (from < to) 必須是一次性 if（→），不是 while（{ }）——
; from/to 在迴圈體內不變，否則會無窮迴圈。
slice-bytes = (b []byte, from i64, to i64) (out []byte) {
    out = with-len(0)
    (from < 0) -> from = 0
    (to > b.len()) -> to = b.len()
    (from < to) -> {
        n = to - from #{overflow=wrap}
        out = with-len(n)
        i <- [0..n): {

            #{index-out=zero}
            out[i] = b[from + i]
        }
        out.truncate(n)
    }
    out
}
