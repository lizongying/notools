; requirements.no — requirements.txt parsing and generation
;
; Handles parsing requirements.txt files (including extras, hashes, markers,
; editable installs, and pip-style options) and generating them for export.
;
; API:
;   parse(path str) (deps str, ok bool) — parse requirements.txt
;   parse-content(content str) (deps str) — parse requirements content
;   write(path str, deps str, opts str) (ok bool) — write requirements.txt
;   format-output(deps str, opts str) (output str) — format deps to text
;   parse-options(line str) (options str) — parse pip options

# /nouv/src/pep508
# /nouv/src/config
# /nouv/src/installer

; ═══════════════════════════════════════════════
; format-output — format dependency list to requirements.txt text
;
; opts can include:
;   header — custom header text
;   format — output format ("requirements" or "pylock")
;   no-hashes — omit hashes (if present)
; ═══════════════════════════════════════════════

format-output = (deps str, opts str) (output str) {
    output = ''
    output = output - '# This file was generated by nouv.\n'
    output = output - '# Do not edit by hand.\n'
    output = output - '\n'

    {
        deps != '' -> {
            lines = deps.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> output = output - line - '\n'
                }
            } (i < n)
        }
    }
}

; ═══════════════════════════════════════════════
; extract-option-value — extract value from --option=value or --option value
; ═══════════════════════════════════════════════

extract-option-value = (tokens str, start i64) (val str) {
    val = ''
    ; This is a simplified version — tokens is already split
    ; In practice, the tokens are passed as space-separated string
    ; and we handle --option=value inline in parse-options
}

; ═══════════════════════════════════════════════
; parse — parse a requirements.txt file
;
; returns: deps str (newline-separated PEP 508 requirement strings), ok bool
; ═══════════════════════════════════════════════

parse = (path str) (deps str, ok bool) {
    ok = false
    deps = ''

    p = path{
        p: path,
    }
    exists = p.exists()
    {
        exists == false -> return
        -> {
            read-result = fs.read-str(path)
            read-result: {
                ok -> raw = it
                nil -> raw = ''
                err -> raw = ''
            }
            deps = parse-content(raw)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; parse-content — parse requirements.txt content
;
; Handles:
;   - Standard requirements: "requests>=2.0"
;   - Editable: "-e ./local-pkg" or "-e git+https://..."
;   - Hashes: "requests==2.0 --hash=sha256:abc..."
;   - Options: "--index-url https://..."
;   - Comments: "# comment"
;   - Line continuations: "requests \\\n  >=2.0"
;   - Recursive includes: "-r other-requirements.txt"
; ═══════════════════════════════════════════════

parse-content = (content str) (deps str) {
    deps = ''

    ; join continuation lines
    content = content.replace-str('\\\n', ' ')

    lines = content.split('\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        line = line.trim()

        ; skip empty lines and comments
        {
            line == '' -> continue
            line.starts-with('#') -> continue
        }

        ; handle -r includes
        {
            line.starts-with('-r ') -> {
                inc-path = line.slice(3, line.len).trim()
                inc-deps, inc-ok = parse(inc-path)
                {
                    inc-ok -> deps = deps - inc-deps
                }
                continue
            }
            line.starts-with('--requirement ') -> {
                inc-path = line.slice(14, line.len).trim()
                inc-deps, inc-ok = parse(inc-path)
                {
                    inc-ok -> deps = deps - inc-deps
                }
                continue
            }
        }

        ; handle pip options (--index-url, etc.) — skip for deps
        {
            line.starts-with('--') -> {
                ; options like --index-url, --extra-index-url, --find-links
                ; these are handled separately
                continue
            }
        }

        ; handle -c constraints
        {
            line.starts-with('-c ') -> {
                continue
            }
            line.starts-with('--constraint ') -> {
                continue
            }
        }

        ; parse the requirement
        ; remove inline comments
        hash-pos = line.index(' --hash=')
        {
            hash-pos >= 0 -> line = line.slice(0, hash-pos)
        }
        line = line.trim()

        {
            line.len > 0 -> deps = deps - line - '\n'
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; write — write a requirements.txt file
;
; deps str — newline-separated requirement strings
; opts str — options string (header comments, etc.)
; ═══════════════════════════════════════════════

write = (path str, deps str, opts str) (ok bool) {
    ok = false

    output = format-output(deps, opts)

    fd = fs.open-write(path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, output, output.len)
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; parse-options — parse pip options from a line
;
; Returns newline-separated key=value options
; ═══════════════════════════════════════════════

parse-options = (line str) (options str) {
    options = ''

    ; split by space
    tokens = line.split(' ')
    n = tokens.len
    i = 0
    {
        tok = tokens[i]
        i = i + 1
        {
            tok.starts-with('--index-url') -> {
                val = extract-option-value(tokens, i)
                {
                    val != '' -> options = options - 'index-url=' - val - '\n'
                }
            }
            tok.starts-with('--extra-index-url') -> {
                val = extract-option-value(tokens, i)
                {
                    val != '' -> options = options - 'extra-index-url=' - val - '\n'
                }
            }
            tok.starts-with('--find-links') -> {
                val = extract-option-value(tokens, i)
                {
                    val != '' -> options = options - 'find-links=' - val - '\n'
                }
            }
            tok.starts-with('-f') -> {
                val = extract-option-value(tokens, i)
                {
                    val != '' -> options = options - 'find-links=' - val - '\n'
                }
            }
            tok.starts-with('--no-index') -> {
                options = options - 'no-index=true\n'
            }
            tok.starts-with('--hash') -> {
                ; hash option
                {
                    tok == '--hash' -> {
                        {
                            i < n -> {
                                options = options - 'hash=' - tokens[i] - '\n'
                            }
                        }
                    }
                    tok.starts-with('--hash=') -> {
                        val = tok.slice(7, tok.len)
                        options = options - 'hash=' - val - '\n'
                    }
                }
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; compile — compile a pyproject.toml to requirements.txt
; Like `uv pip compile`
; ═══════════════════════════════════════════════

compile = (src-path str, out-path str, constraints str) (ok bool) {
    ok = false

    ; load source
    cfg, cfg-ok = config.load-config(src-path)
    {
        cfg-ok == false -> {
            ; try as requirements.txt
            deps, deps-ok = parse(src-path)
            {
                deps-ok == false -> return
                -> {
                    output = format-output(deps, '')
                    fd = fs.open-write(out-path)
                    {
                        fd <= 0 -> return
                        -> {
                            fs.write(fd, output, output.len)
                            fs.close(fd)
                            ok = true
                        }
                    }
                }
            }
            return
        }
        -> {
            deps = config.get-dependencies(cfg)
            dev-deps = config.get-dev-dependencies(cfg)

            all-deps = deps
            {
                dev-deps != '' -> all-deps = all-deps - '\n' - dev-deps
            }

            output = format-output(all-deps, '')
            fd = fs.open-write(out-path)
            {
                fd <= 0 -> return
                -> {
                    fs.write(fd, output, output.len)
                    fs.close(fd)
                    ok = true
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; diff — compute difference between two requirement lists
; returns: added str, removed str
; ═══════════════════════════════════════════════

diff = (old str, new str) (added str, removed str) {
    added = ''
    removed = ''

    ; find packages in new but not in old
    new-lines = new.split('\n')
    nn = new-lines.len
    i = 0
    {
        n = new-lines[i]
        i = i + 1
        n = n.trim()
        {
            n.len > 0 -> {
                name, extras, specs, marker, url, editable, parse-ok = pep508.parse(n)
                {
                    parse-ok -> {
                        name = pep508.normalize-name(name)
                        {
                            old.contains(name) == false -> {
                                {
                                    added.len > 0 -> added = added - '\n'
                                }
                                added = added - n
                            }
                        }
                    }
                }
            }
        }
    } (i < nn)

    ; find packages in old but not in new
    old-lines = old.split('\n')
    on = old-lines.len
    i = 0
    {
        o = old-lines[i]
        i = i + 1
        o = o.trim()
        {
            o.len > 0 -> {
                name, extras, specs, marker, url, editable, parse-ok = pep508.parse(o)
                {
                    parse-ok -> {
                        name = pep508.normalize-name(name)
                        {
                            new.contains(name) == false -> {
                                {
                                    removed.len > 0 -> removed = removed - '\n'
                                }
                                removed = removed - o
                            }
                        }
                    }
                }
            }
        }
    } (i < on)
}

; ═══════════════════════════════════════════════
; freeze — generate frozen requirements from installed packages
; Like `uv pip freeze`
; ═══════════════════════════════════════════════

freeze = (venv-path str) (output str) {
    output = ''
    installed = installer.list-installed(venv-path)
    {
        installed != '' -> {
            lines = installed.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> output = output - line - '\n'
                }
            } (i < n)
        }
    }
}

; ═══════════════════════════════════════════════
; check — check if requirements are satisfied
; ═══════════════════════════════════════════════

check = (venv-path str, reqs str) (satisfied bool, missing str) {
    satisfied = true
    missing = ''

    installed = installer.list-installed(venv-path)

    lines = reqs.split('\n')
    n = lines.len
    i = 0
    {
        req = lines[i]
        i = i + 1
        req = req.trim()
        {
            req.len > 0 -> {
                name, extras, specs, marker, url, editable, parse-ok = pep508.parse(req)
                {
                    parse-ok -> {
                        name = pep508.normalize-name(name)
                        ; check if installed
                        found = false
                        inst-lines = installed.split('\n')
                        inst-count = inst-lines.len
                        j = 0
                        for j < inst-count {
                            inst = inst-lines[j]
                            j = j + 1
                            {
                                inst.starts-with(name - '==') -> {
                                    found = true
                                    break
                                }
                            }
                        }
                        {
                            found == false -> {
                                satisfied = false
                                {
                                    missing.len > 0 -> missing = missing - '\n'
                                }
                                missing = missing - name
                            }
                        }
                    }
                }
            }
        }
    } (i < n)
}
