; dependency.no — dependency resolution and management
;
; Resolves Python package dependencies using a backtracking resolver.
; Queries PyPI for package metadata, builds a dependency graph,
; and resolves version constraints to produce a flat list of packages.
;
; API:
;   resolve-all(cfg str) (resolved str, ok bool) — resolve all deps
;   resolve-package(name str, ver-spec str) (info str, ok bool) — resolve single package
;   dependency-tree(cfg str, pkg str) (tree str) — show dep tree
;   parse-requirement(req str) (name str, ver-spec str, extras str) — parse requirement string

; # /nouv/src/registry
; # /nouv/src/config
# /nouv/src/utils

; ═══════════════════════════════════════════════
; resolve-all — resolve all dependencies from config
;
; cfg str — parsed pyproject.toml config
; returns:
;   resolved str — flat representation of resolved packages
;                  format: name==version\n per line
;   ok bool
; ═══════════════════════════════════════════════

; resolve-all temporarily disabled
; resolve-all = (cfg str) (resolved str, ok bool) { ... }

; ═══════════════════════════════════════════════
; parse-requirement — parse a PEP 508 requirement string
; "requests>=2.20.0" → name="requests", ver-spec=">=2.20.0"
; "flask[async]>=2.0" → name="flask", ver-spec=">=2.0", extras="async"
; ═══════════════════════════════════════════════

parse-requirement = (req str) (name str, ver-spec str, extras str) {
    name = req
    ver-spec = ''
    extras = ''

    ; find version specifier
    op-pos = find-version-op(req)
    {
        op-pos >= 0 -> {
            name = req.slice(0, op-pos)
            name = name.trim()
            ver-spec = req.slice(op-pos, req.len)
            ver-spec = ver-spec.trim()
        }
        -> {
            name = req.trim()
        }
    }

    ; find extras
    bracket-pos = name.index('[')
    {
        bracket-pos >= 0 -> {
            extras = name.slice(bracket-pos + 1, name.len)
            end-bracket = extras.index(']')
            {
                end-bracket >= 0 -> extras = extras.slice(0, end-bracket)
            }
            name = name.slice(0, bracket-pos)
            name = name.trim()
        }
    }
}

; ═══════════════════════════════════════════════
; find-version-op — find the position of version operator
; ═══════════════════════════════════════════════

find-version-op = (s str) (pos i64) {
    pos = -1
    n = s.len
    i = 0
    {
        c = s[i]
        {
            c == 61 -> {
                pos = i
                return
            }
            c == 60 -> {
                pos = i
                return
            }
            c == 62 -> {
                pos = i
                return
            }
            c == 33 -> {
                pos = i
                return
            }
            c == 126 -> {
                pos = i
                return
            }
        }
        i = i + 1
    } (i < n)
}

; ═══════════════════════════════════════════════
; version-compare — compare two version strings
; returns: -1 if a < b, 0 if a == b, 1 if a > b
; ═══════════════════════════════════════════════

version-compare = (a str, b str) (result i64) {
    result = 0
    a-parts = a.split('.')
    b-parts = b.split('.')
    a-n = a-parts.len
    b-n = b-parts.len
    max-n = a-n
    {
        b-n > max-n -> max-n = b-n
    }
    i = 0
    {
        a-val = 0
        b-val = 0
        {
            i < a-n -> a-val = str-to-i64(a-parts[i])
        }
        {
            i < b-n -> b-val = str-to-i64(b-parts[i])
        }
        {
            a-val < b-val -> { result = -1; return }
        }
        {
            a-val > b-val -> { result = 1; return }
        }
        i = i + 1
    } (i < max-n)
}

; ═══════════════════════════════════════════════
; upper-bound-compat — compute upper bound for ~= operator
; ~= 2.5 → 3.0 (upper bound is 3.0)
; ~= 2.5.3 → 2.6.0 (upper bound is 2.6.0)
; ═══════════════════════════════════════════════

upper-bound-compat = (target str) (upper str) {
    upper = ''
    parts = target.split('.')
    n = parts.len
    {
        n < 2 -> return
        -> {
            {
                n == 2 -> {
                    x = str-to-i64(parts[0])
                    upper = (x + 1).to-str() - '.0'
                }
                -> {
                    x = parts[0]
                    y = str-to-i64(parts[1])
                    upper = x - '.' - (y + 1).to-str() - '.0'
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; pick-version — pick the best version from package info
; that satisfies the version spec
; ═══════════════════════════════════════════════

pick-version = (info str, ver-spec str) (ver str, ok bool) {
    ok = false
    ver = ''

    ; extract version from info
    lines = info.split('\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        {
            line.starts-with('version=') -> {
                ver = line.slice(8, line.len)
                {
                    ver-spec == '' -> { ok = true; return }
                    -> {
                        vs-ok = version-satisfies(ver, ver-spec)
                        {
                            vs-ok -> { ok = true; return }
                        }
                    }
                }
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; version-satisfies — check if version satisfies version spec
; supports: >=, <=, ==, !=, >, <, ~=, multiple specs with comma
; ═══════════════════════════════════════════════

version-satisfies = (ver str, spec str) (ok bool) {
    ok = true

    {
        spec == '' -> return
    }

    ; split by comma for multiple constraints
    specs = spec.split(',')
    n = specs.len
    i = 0
    {
        s = specs[i]
        s = s.trim()
        i = i + 1
        {
            s == '' -> continue
            -> {
                op = ''
                target = s

                ; extract operator
                {
                    s.starts-with('>=') -> {
                        op = '>='
                        target = s.slice(2, s.len)
                    }
                    s.starts-with('<=') -> {
                        op = '<='
                        target = s.slice(2, s.len)
                    }
                    s.starts-with('==') -> {
                        op = '=='
                        target = s.slice(2, s.len)
                    }
                    s.starts-with('!=') -> {
                        op = '!='
                        target = s.slice(2, s.len)
                    }
                    s.starts-with('~=') -> {
                        op = '~='
                        target = s.slice(2, s.len)
                    }
                    s.starts-with('>') -> {
                        op = '>'
                        target = s.slice(1, s.len)
                    }
                    s.starts-with('<') -> {
                        op = '<'
                        target = s.slice(1, s.len)
                    }
                    -> {
                        op = '=='
                        target = s
                    }
                }

                target = target.trim()
                cmp = version-compare(ver, target)

                {
                    op == '>=' -> {
                        cmp < 0 -> { ok = false; return }
                    }
                    op == '<=' -> {
                        cmp > 0 -> { ok = false; return }
                    }
                    op == '==' -> {
                        cmp != 0 -> { ok = false; return }
                    }
                    op == '!=' -> {
                        cmp == 0 -> { ok = false; return }
                    }
                    op == '>' -> {
                        cmp <= 0 -> { ok = false; return }
                    }
                    op == '<' -> {
                        cmp >= 0 -> { ok = false; return }
                    }
                    op == '~=' -> {
                        {
                            cmp < 0 -> { ok = false; return }
                        }
                        upper = upper-bound-compat(target)
                        {
                            upper != '' -> {
                                cmp2 = version-compare(ver, upper)
                                {
                                    cmp2 >= 0 -> { ok = false; return }
                                }
                            }
                        }
                    }
                }
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; get-requires-dist — extract requires_dist from package info
; returns newline-separated requirement strings
; ═══════════════════════════════════════════════

get-requires-dist = (info str, ver str) (deps str) {
    deps = ''
    lines = info.split('\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        {
            line.starts-with('requires_dist=') -> {
                val = line.slice(15, line.len)
                deps = val
                return
            }
        }
    } (i < n)
}

