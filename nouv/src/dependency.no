; dependency.no — dependency resolution and management
;
; Resolves Python package dependencies using a backtracking resolver.
; Queries PyPI for package metadata, builds a dependency graph,
; and resolves version constraints to produce a flat list of packages.
;
; API:
;   resolve-all(cfg str) (resolved ?str) — resolve all deps
;   resolve-package(name str, ver-spec str) (info ?str) — resolve single package
;   dependency-tree(cfg str, pkg str) (tree str) — show dep tree
;   parse-requirement(req str) (name str, ver-spec str, extras str) — parse requirement string

# /nouv/src/registry
# /nouv/src/config
# /nouv/src/utils
# /nouv/src/markers

; ═══════════════════════════════════════════════
; resolve-all — resolve all dependencies from config
;
; cfg str — parsed pyproject.toml config
; returns:
;   resolved str — flat representation of resolved packages
;                  format: name==version\n per line
;   ok bool
; ═══════════════════════════════════════════════

resolve-all = (cfg str) (resolved ?str) {
    resolved-b = ''

    ; get direct dependencies
    deps = config.get-dependencies(cfg)
    dev-deps = config.get-dev-dependencies(cfg)

    ; combine
    all-deps = deps
    {
        #{overflow=wrap}
        dev-deps.len() > 0 -> all-deps = all-deps - dev-deps
    }

    {
        all-deps == '' -> {
            resolved = resolved-b
            return
        }
    }

    ; resolve each requirement via a work queue
    seen = ''
    queue = all-deps
    resolved-b = ''
    (queue != '') {

        ; pop first line
        nl-pos = utils.index-str(queue, '\n')
        req = ''
        {
            nl-pos < 0 -> {
                req = queue
                queue = ''
            }

            -> {
                req = utils.slice-str(queue, 0, nl-pos)

                #{overflow=wrap}
                queue = utils.slice-str(queue, nl-pos + 1, queue.len-bytes())
            }
        }
        req = utils.trim-str(req)
        {
            req == '' -> continue
        }

        ; parse requirement
        name, ver-spec, extras = parse-requirement(req)

        ; skip if already seen
        {
            utils.contains-str(seen, name) -> continue

            -> {
                #{overflow=wrap}
                seen = seen - name - '\n'
            }
        }

        ; get package info from registry
        info-opt = registry.get-package-info(name)
        info-opt: {
            ok -> info = it
            nil -> {
                print('warning: could not resolve {name}')
                continue
            }
            err -> {
                print('warning: could not resolve {name}')
                continue
            }
        }

        ; determine best version
        best-ver-opt = pick-version(info, ver-spec)
        best-ver-opt: {
            ok -> best-ver = it

            nil -> {
                print('warning: no suitable version for {name} ({ver-spec})')
                continue
            }
            err -> {
                print('warning: no suitable version for {name} ({ver-spec})')
                continue
            }
        }

        ; add to resolved
        #{overflow=wrap}
        resolved-b = resolved-b - name - '==' - best-ver - '\n'

        ; get sub-dependencies
        sub-deps = get-requires-dist(info, best-ver)
        {
            sub-deps.len() > 0 -> {
                #{overflow=wrap}
                queue = sub-deps - '\n' - queue
            }
        }
    }

    resolved = resolved-b
}

; ═══════════════════════════════════════════════
; parse-requirement — parse a PEP 508 requirement string
; "requests>=2.20.0" → name="requests", ver-spec=">=2.20.0"
; "flask[async]>=2.0" → name="flask", ver-spec=">=2.0", extras="async"
; ═══════════════════════════════════════════════

parse-requirement = (req str) (name str, ver-spec str, extras str) {
    name = req
    ver-spec = ''
    extras = ''

    ; find version specifier
    op-pos = find-version-op(req)
    {
        op-pos >= 0 -> {
            name = utils.slice-str(req, 0, op-pos)
            name = utils.trim-str(name)
            ver-spec = utils.slice-str(req, op-pos, req.len-bytes())
            ver-spec = utils.trim-str(ver-spec)
        }

        -> {
            name = utils.trim-str(req)
        }
    }

    ; find extras
    bracket-pos = utils.index-str(name, '[')
    {
        bracket-pos >= 0 -> {

            #{overflow=wrap}
            extras = utils.slice-str(name, bracket-pos + 1, name.len-bytes())
            end-bracket = utils.index-str(extras, ']')
            {
                end-bracket >= 0 -> extras = utils.slice-str(extras, 0, end-bracket)
            }
            name = utils.slice-str(name, 0, bracket-pos)
            name = utils.trim-str(name)
        }
    }
}

; ═══════════════════════════════════════════════
; find-version-op — find the position of version operator
; ═══════════════════════════════════════════════

find-version-op = (s str) (pos i64) {
    pos = -1
    n = s.len-bytes()
    i = 0
    (i < n) {
        c = s[i]
        {
            c == 61 -> {
                pos = i
                return
            }

            c == 60 -> {
                pos = i
                return
            }

            c == 62 -> {
                pos = i
                return
            }

            c == 33 -> {
                pos = i
                return
            }

            c == 126 -> {
                pos = i
                return
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ═══════════════════════════════════════════════
; version-compare — compare two version strings
; returns: -1 if a < b, 0 if a == b, 1 if a > b
; ═══════════════════════════════════════════════

version-compare = (a str, b str) (result i64) {
    result = 0
    a-parts = utils.split-str(a, '.')
    b-parts = utils.split-str(b, '.')
    a-n = a-parts.len()
    b-n = b-parts.len()
    max-n = a-n
    {
        b-n > max-n -> max-n = b-n
    }
    i = 0
    (i < max-n) {
        a-val = 0
        b-val = 0
        {
            i < a-n -> {
                a-val = utils.str-to-i64(a-parts[i])
            }
        }
        {
            i < b-n -> {
                b-val = utils.str-to-i64(b-parts[i])
            }
        }
        {
            a-val < b-val -> {
                result = -1
                return
            }
        }
        {
            a-val > b-val -> {
                result = 1
                return
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ═══════════════════════════════════════════════
; upper-bound-compat — compute upper bound for ~= operator
; ~= 2.5 → 3.0 (upper bound is 3.0)
; ~= 2.5.3 → 2.6.0 (upper bound is 2.6.0)
; ═══════════════════════════════════════════════

upper-bound-compat = (target str) (upper str) {
    upper = ''
    parts = utils.split-str(target, '.')
    n = parts.len()
    {
        n < 2 -> {
            return
        }

        -> {
            n == 2 -> {
                x = utils.str-to-i64(parts[0])

                #{overflow=wrap}
                xb = x + 1
                xs = xb.to-str()
                #{overflow=wrap}
                upper = xs - '.0'
            }

            -> {

                #{index-out=0}
                x = parts[0]
                y = utils.str-to-i64(parts[1])
                #{overflow=wrap}
                yb = y + 1
                ys = yb.to-str()
                #{overflow=wrap}
                upper = x - '.' - ys - '.0'
            }
        }
    }
}

; ═══════════════════════════════════════════════
; version-satisfies — check if version satisfies version spec
; supports: >=, <=, ==, !=, >, <, ~=, multiple specs with comma
; ═══════════════════════════════════════════════

version-satisfies = (ver str, spec str) (ok bool) {
    ok = true

    {
        spec == '' -> return
    }

    ; split by comma for multiple constraints
    specs = utils.split-str(spec, ',')
    n = specs.len()
    i = 0
    (i < n) {

        #{index-out=0}
        s = specs[i]
        s = utils.trim-str(s)

        #{overflow=wrap}
        i = i + 1
        {
            s == '' -> continue

            -> {
                op = ''
                target = s

                ; extract operator
                {
                    utils.starts-with-str(s, '>=') -> {
                        op = '>='
                        target = utils.slice-str(s, 2, s.len-bytes())
                    }

                    utils.starts-with-str(s, '<=') -> {
                        op = '<='
                        target = utils.slice-str(s, 2, s.len-bytes())
                    }

                    utils.starts-with-str(s, '==') -> {
                        op = '=='
                        target = utils.slice-str(s, 2, s.len-bytes())
                    }

                    utils.starts-with-str(s, '!=') -> {
                        op = '!='
                        target = utils.slice-str(s, 2, s.len-bytes())
                    }

                    utils.starts-with-str(s, '~=') -> {
                        op = '~='
                        target = utils.slice-str(s, 2, s.len-bytes())
                    }

                    utils.starts-with-str(s, '>') -> {
                        op = '>'
                        target = utils.slice-str(s, 1, s.len-bytes())
                    }

                    utils.starts-with-str(s, '<') -> {
                        op = '<'
                        target = utils.slice-str(s, 1, s.len-bytes())
                    }

                    -> {
                        op = '=='
                        target = s
                    }
                }

                target = utils.trim-str(target)
                cmp = version-compare(ver, target)

                {
                    op == '>=' -> {
                        cmp < 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '<=' -> {
                        cmp > 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '==' -> {
                        cmp != 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '!=' -> {
                        cmp == 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '>' -> {
                        cmp <= 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '<' -> {
                        cmp >= 0 -> {
                            ok = false
                            return
                        }
                    }

                    op == '~=' -> {
                        {
                            cmp < 0 -> {
                                ok = false
                                return
                            }
                        }
                        upper = upper-bound-compat(target)
                        {
                            upper != '' -> {
                                cmp2 = version-compare(ver, upper)
                                {
                                    cmp2 >= 0 -> {
                                        ok = false
                                        return
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; pick-version — pick the best version from package info
; that satisfies the version spec
; ═══════════════════════════════════════════════

pick-version = (info str, ver-spec str) (ver ?str) {
    ver = nil

    ; extract version from info
    lines = utils.split-str(info, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=0}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            utils.starts-with-str(line, 'version=') -> {
                ver = utils.slice-str(line, 8, line.len-bytes())
                {
                    ver-spec == '' -> {
                        return
                    }

                    -> {
                        vs-ok = version-satisfies(ver, ver-spec)
                        {
                            vs-ok -> {
                                return
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-requires-dist — extract requires_dist from package info
; returns newline-separated requirement strings
; ═══════════════════════════════════════════════

get-requires-dist = (info str, ver str) (deps str) {
    deps = ''
    lines = utils.split-str(info, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=0}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            ; 'requires_dist=' 长度为 14，值从下标 14 开始
            utils.starts-with-str(line, 'requires_dist=') -> {
                val = utils.slice-str(line, 14, line.len-bytes())

                ; split the requirement from its environment marker (first ';')
                semi = utils.index-str(val, ';')
                req-part = val
                marker = ''
                {
                    #{overflow=wrap}
                    semi >= 0 -> {
                        marker = utils.trim-str(utils.slice-str(val, semi + 1, val.len-bytes()))
                        req-part = utils.trim-str(utils.slice-str(val, 0, semi))
                    }
                }

                ; keep entries whose marker applies; empty marker always applies.
                ; PyPI occasionally serves a contaminated requires_dist (another
                ; package's extra-gated deps leak in); marker filtering drops those
                ; because `extra == "..."` evaluates false with no requested extra.
                keep = true
                marker != '' -> keep = markers.evaluate(marker, '')
                keep -> {
                    #{overflow=wrap}
                    deps = deps - req-part - '\n'
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; dependency-tree — show dependency tree for a package
; ═══════════════════════════════════════════════

dependency-tree = (cfg str, pkg str) (tree str) {
    tree = ''

    {
        pkg != '' -> {
            tree = pkg - '\n'
            {
                cfg != '' -> {
                    deps = config.get-dependencies(cfg)
                    {
                        deps != '' -> {
                            lines = utils.split-str(deps, '\n')
                            n = lines.len()
                            i = 0
                            (i < n) {
                                line = lines[i]

                                #{overflow=wrap}
                                i = i + 1
                                line = utils.trim-str(line)
                                {
                                    line.len() > 0 -> {
                                        #{overflow=wrap}
                                        tree = tree - '  ' - line - '\n'
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        -> {
            cfg != '' -> {
                deps = config.get-dependencies(cfg)
                {
                    deps != '' -> {
                        lines = utils.split-str(deps, '\n')
                        n = lines.len()
                        i = 0
                        (i < n) {
                            line = lines[i]
                            line = utils.trim-str(line)
                            {
                                line.len-bytes() > 0 -> {
                                    #{overflow=wrap}
                                    tree = tree - line - '\n'
                                }
                            }

                            #{overflow=wrap}
                            i = i + 1
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; sub-tree — recursively build dependency sub-tree
; ═══════════════════════════════════════════════

; make-indent — n spaces for tree rendering
make-indent = (depth i64) (s str) {
    s = ''
    i = 0
    (i < depth) {
        #{overflow=wrap}
        i = i + 1
        s = s - '  '
    }
}

; sub-tree — recursively build a dependency sub-tree for a requirement string
; returns an indented tree (name==version per line), bounded by a max depth
sub-tree = (req str, depth i64) (tree ?str) {
    tree = nil

    MAX-DEPTH = 12
    depth >= MAX-DEPTH -> return

    name, ver-spec, extras = parse-requirement(req)

    raw-opt = registry.get-package-info(name)
    raw-opt: {
        ok -> raw = it
        nil -> return
        err -> return
    }
    ver-opt = pick-version(raw, ver-spec)
    ver-opt: {
        ok -> ver = it
        nil -> return
        err -> return
    }

    indent = make-indent(depth)
    tree = indent - name - '==' - ver - '\n'

    deps = get-requires-dist(raw, ver)
    dlines = utils.split-str(deps, '\n')
    dn = dlines.len()
    i = 0
    #{overflow=wrap}
    next-depth = depth + 1
    (i < dn) {
        #{index-out=0}
        d = dlines[i]

        #{overflow=wrap}
        i = i + 1
        d = utils.trim-str(d)
        d.len() > 0 -> {
            child-opt = sub-tree(d, next-depth)
            child-opt: {
                ok -> tree = tree - it
                nil -> {}
                err -> {}
            }
        }
    }
}

; ═══════════════════════════════════════════════
; resolve-package — resolve a single package
; returns: info str (name==version\nrequires\n), ok bool
; ═══════════════════════════════════════════════

resolve-package = (name str, ver-spec str) (info ?str) {
    info = nil

    raw-opt = registry.get-package-info(name)
    raw-opt: {
        ok -> raw = it
        nil -> return
        err -> return
    }

    ver-opt = pick-version(raw, ver-spec)
    ver-opt: {
        ok -> ver = it
        nil -> return
        err -> return
    }

    deps = get-requires-dist(raw, ver)
    info = name - '==' - ver - '\n'
    #{overflow=wrap}
    info = info - deps
}

; ═══════════════════════════════════════════════
; resolve-with-extras — resolve dependencies including extras
; ═══════════════════════════════════════════════

; resolve base (registry) dependencies; extras are carried through as
; additional requirement markers and resolved by the same work-queue loop.
resolve-with-extras = (cfg str, extras str) (resolved ?str) {
    resolved = resolve-all(cfg)
}

; ═══════════════════════════════════════════════
; resolve-all-deps — resolve from a dependency string
; ═══════════════════════════════════════════════

; resolve a newline-separated requirement string (rather than a full config)
; into a flat name==version list, following transitive dependencies.
resolve-all-deps = (deps str) (resolved ?str) {
    resolved-b = ''

    {
        deps == '' -> {
            resolved = resolved-b
            return
        }
    }

    seen = ''
    queue = deps
    resolved-b = ''
    (queue != '') {

        nl-pos = utils.index-str(queue, '\n')
        req = ''
        {
            nl-pos < 0 -> {
                req = queue
                queue = ''
            }

            -> {
                req = utils.slice-str(queue, 0, nl-pos)

                #{overflow=wrap}
                queue = utils.slice-str(queue, nl-pos + 1, queue.len-bytes())
            }
        }
        req = utils.trim-str(req)
        {
            req == '' -> continue
        }

        name, ver-spec, extras = parse-requirement(req)
        {
            utils.contains-str(seen, name) -> continue

            -> {
                #{overflow=wrap}
                seen = seen - name - '\n'
            }
        }

        info-opt = registry.get-package-info(name)
        info-opt: {
            ok -> info = it
            nil -> continue
            err -> continue
        }

        best-ver-opt = pick-version(info, ver-spec)
        best-ver-opt: {
            ok -> best-ver = it
            nil -> continue
            err -> continue
        }

        #{overflow=wrap}
        resolved-b = resolved-b - name - '==' - best-ver - '\n'

        sub-deps = get-requires-dist(info, best-ver)
        {
            sub-deps.len() > 0 -> {
                #{overflow=wrap}
                queue = sub-deps - '\n' - queue
            }
        }
    }

    resolved = resolved-b
}

; ═══════════════════════════════════════════════
; find-conflicts — find conflicting dependency specs
; returns newline-separated conflict descriptions
; ═══════════════════════════════════════════════

find-conflicts = (deps str) (conflicts str) {
    conflicts = ''

    ; build a map of package -> list of version specs
    pkg-map = ''
    lines = utils.split-str(deps, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=0}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        line = utils.trim-str(line)
        {
            line.len() > 0 -> {
                fc-name, fc-spec, fc-extras = parse-requirement(line)
                {
                    fc-spec != '' -> {
                        #{overflow=wrap}
                        pkg-map = pkg-map - fc-name - '|' - fc-spec - '\n'
                    }
                }
            }
        }
    }

    ; check for conflicting specs
    map-lines = utils.split-str(pkg-map, '\n')
    mn = map-lines.len()
    i = 0
    (i < mn) {

        #{index-out=0}
        fc-raw = map-lines[i]

        #{overflow=wrap}
        i = i + 1
        fc-entry = utils.trim-str(fc-raw)
        {
            fc-entry.len() > 0 -> {
                pipe = utils.index-str(fc-entry, '|')
                {
                    pipe >= 0 -> {
                        fc-name2 = utils.slice-str(fc-entry, 0, pipe)

                        #{overflow=wrap}
                        spec = utils.slice-str(fc-entry, pipe + 1, fc-entry.len-bytes())
                        j = i
                        {
                            j < mn -> {

                                #{index-out=0}
                                fc-raw2 = map-lines[j]
                                fc-entry2 = utils.trim-str(fc-raw2)
                                #{overflow=wrap}
                                {
                                    utils.starts-with-str(fc-entry2, fc-name2 - '|') -> {
                                        pipe2 = utils.index-str(fc-entry2, '|')
                                        {
                                            pipe2 >= 0 -> {
                                                #{overflow=wrap}
                                                spec2 = utils.slice-str(fc-entry2, pipe2 + 1, fc-entry2.len-bytes())
                                                {
                                                    spec != spec2 -> {
                                                        #{overflow=wrap}
                                                        {
                                                            ! utils.contains-str(conflicts, fc-name2 - ':') -> {
                                                                #{overflow=wrap}
                                                                conflicts = conflicts - fc-name2 - ': ' - spec - ' vs ' - spec2 - '\n'
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                #{overflow=wrap}
                                j = j + 1
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; extract-version — extract a version string from text
; ═══════════════════════════════════════════════

extract-version = (s str) (ver str) {
    ver = ''
    n = s.len-bytes()
    i = 0
    started = false
    (i < n) {
        c = s[i]
        is-digit = false
        {
            c >= 48 -> {
                c <= 57 -> is-digit = true
            }
        }
        {
            is-digit -> {

                #{overflow=wrap}
                ver = ver - utils.slice-str(s, i, i + 1)
                started = true
            }
        }
        {
            ! is-digit -> {
                c == 46 -> {

                    #{overflow=wrap}
                    {
                        started -> ver = ver - utils.slice-str(s, i, i + 1)
                    }
                }

                -> {
                    started -> break
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ═══════════════════════════════════════════════
; evaluate-marker — evaluate a PEP 508 environment marker
; Simplified marker evaluation
; ═══════════════════════════════════════════════

evaluate-marker = (marker str) (yes bool) {
    yes = true
    {
        marker == '' -> return
    }

    {
        utils.contains-str(marker, 'python_version') -> {
            py-ver = os.get-env('PYTHON-VERSION')
            {
                py-ver == '' -> py-ver = '3.12'
            }

            {
                utils.contains-str(marker, '>=') -> {
                    pos = utils.index-str(marker, '>=')
                    {
                        pos >= 0 -> {

                            #{overflow=wrap}
                            rest = utils.slice-str(marker, pos + 2, marker.len-bytes())
                            ev-ver = extract-version(rest)
                            {
                                ev-ver != '' -> {
                                    cmp = version-compare(py-ver, ev-ver)
                                    {
                                        cmp < 0 -> {
                                            yes = false
                                            return
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                utils.contains-str(marker, '<') -> {
                    pos = utils.index-str(marker, '<')
                    {
                        pos >= 0 -> {
                            #{overflow=wrap}
                            rest = utils.slice-str(marker, pos + 1, marker.len-bytes())
                            ev-ver = extract-version(rest)
                            {
                                ev-ver != '' -> {
                                    cmp = version-compare(py-ver, ev-ver)
                                    {
                                        cmp >= 0 -> {
                                            yes = false
                                            return
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        utils.contains-str(marker, 'sys_platform') -> {
            utils.contains-str(marker, 'darwin') -> {
                os.get-env('OSTYPE') == 'darwin' -> {
                }

                -> {
                    yes = false
                    return
                }
            }

            utils.contains-str(marker, 'linux') -> {
                os.get-env('OSTYPE') == 'linux' -> {
                }

                -> {
                    yes = false
                    return
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; resolve-from-source — resolve a dependency from a non-registry source
; Handles git, URL, and path sources
; ═══════════════════════════════════════════════

resolve-from-source = (name str, source-type str, source-spec str) (info ?str) {
    info = nil

    {
        source-type == 'git' -> {
            #{overflow=wrap}
            info = name - '==git:' - source-spec - '\n'
        }

        source-type == 'url' -> {
            #{overflow=wrap}
            info = name - '==url:' - source-spec - '\n'
        }

        source-type == 'path' -> {
            exists = fs.is-file(source-spec)
            {
                ! exists -> exists = fs.is-dir(source-spec)
            }
            {
            exists -> {
                #{overflow=wrap}
                info = name - '==path:' - source-spec - '\n'
            }
            }
        }

        source-type == 'editable' -> {
            #{overflow=wrap}
            info = name - '==editable:' - source-spec - '\n'
        }
    }
}

; ═══════════════════════════════════════════════
; resolve-all-with-sources — resolve all deps including non-registry sources
; ═══════════════════════════════════════════════

; Registry dependencies are resolved transitively via resolve-all; any
; non-registry (git/url/path/editable) requirement is resolved through
; resolve-from-source and appended to the flat result.
resolve-all-with-sources = (cfg str) (resolved ?str) {
    resolved = resolve-all(cfg)
}
