; version.no — version information module
;
; Provides version detection and comparison utilities.
;
; API:
;   current() (ver str) — get current nouv version
;   parse(ver str) (major i64, minor i64, patch i64, pre str) — parse version
;   compare(a str, b str) (cmp i64) — compare two versions (-1, 0, 1)
;   is-prerelease(ver str) (yes bool) — check if pre-release
;   normalize(ver str) (out str) — normalize version string
;   str-to-i64(s str) (result i64) — safely convert string to i64

# /nouv/src/utils

NOUV-VERSION = '0.1.0'

; ═══════════════════════════════════════════════
; str-to-i64 — safely convert a string to i64
; Returns 0 if parsing fails
; ═══════════════════════════════════════════════

str-to-i64 = (s str) (result i64) {
    result = 0
    v = s.to-i64()
    v: {
        ok -> result = it

        nil -> result = 0

        err -> result = 0
    }
}

; ═══════════════════════════════════════════════
; current — get current nouv version
; ═══════════════════════════════════════════════

current = () (ver str) {
    ver = NOUV-VERSION
}

; ═══════════════════════════════════════════════
; parse — parse a version string into components
; "1.2.3" → major=1, minor=2, patch=3, pre=""
; "1.2.3a1" → major=1, minor=2, patch=3, pre="a1"
; ═══════════════════════════════════════════════

parse = (ver str) (major i64, minor i64, patch i64, pre str) {
    major = 0
    minor = 0
    patch = 0
    pre = ''

    v = utils.trim-str(ver)
    {
        utils.starts-with-str(v, 'v') -> v = utils.slice-str(v, 1, v.len-bytes())

        utils.starts-with-str(v, 'V') -> v = utils.slice-str(v, 1, v.len-bytes())
    }

    ; find pre-release suffix: check 'rc' first, then 'a', 'b', 'c'
    core = v
    {
        utils.index-str(v, 'rc') >= 0 -> {
            parts-rc = utils.split-str(v, 'rc')
            {
                parts-rc.len() == 2 -> {
                    p0 = parts-rc[0]: {
                        ok -> it

                        -> ''
                    }
                    p1 = parts-rc[1]: {
                        ok -> it

                        -> ''
                    }
                    core = p0
                    pre = 'rc' - p1
                }
            }
        }

        utils.index-str(v, 'a') >= 0 -> {
            parts-a = utils.split-str(v, 'a')
            {
                parts-a.len() == 2 -> {
                    p0 = parts-a[0]: {
                        ok -> it

                        -> ''
                    }
                    p1 = parts-a[1]: {
                        ok -> it

                        -> ''
                    }
                    core = p0
                    pre = 'a' - p1
                }
            }
        }

        utils.index-str(v, 'b') >= 0 -> {
            parts-b = utils.split-str(v, 'b')
            {
                parts-b.len() == 2 -> {
                    p0 = parts-b[0]: {
                        ok -> it

                        -> ''
                    }
                    p1 = parts-b[1]: {
                        ok -> it

                        -> ''
                    }
                    core = p0
                    pre = 'b' - p1
                }
            }
        }

        utils.index-str(v, 'c') >= 0 -> {
            parts-c = utils.split-str(v, 'c')
            {
                parts-c.len() == 2 -> {
                    p0 = parts-c[0]: {
                        ok -> it

                        -> ''
                    }
                    p1 = parts-c[1]: {
                        ok -> it

                        -> ''
                    }
                    core = p0
                    pre = 'c' - p1
                }
            }
        }
    }

    ; parse core version
    parts = utils.split-str(core, '.')
    n2 = parts.len()
    {
        n2 >= 1 -> {
            p0 = parts[0]: {
                ok -> it

                -> ''
            }
            major = str-to-i64(p0)
        }
    }
    {
        n2 >= 2 -> {
            p1 = parts[1]: {
                ok -> it

                -> ''
            }
            minor = str-to-i64(p1)
        }
    }
    {
        n2 >= 3 -> {
            p2 = parts[2]: {
                ok -> it

                -> ''
            }
            patch = str-to-i64(p2)
        }
    }
}

; ═══════════════════════════════════════════════
; compare — compare two version strings
; returns -1 if a < b, 0 if equal, 1 if a > b
; ═══════════════════════════════════════════════

compare = (a str, b str) (cmp i64) {
    cmp = 0

    ma, mi, pa, pre-a = parse(a)
    mb, mib, pb, pre-b = parse(b)

    {
        ma < mb -> {
            cmp = -1
            return
        }

        ma > mb -> {
            cmp = 1
            return
        }
    }

    {
        mi < mib -> {
            cmp = -1
            return
        }

        mi > mib -> {
            cmp = 1
            return
        }
    }

    {
        pa < pb -> {
            cmp = -1
            return
        }

        pa > pb -> {
            cmp = 1
            return
        }
    }

    ; compare pre-release using has-pre instead of string comparison
    ; to avoid split-based memory issues
    a-has-pre = is-prerelease(a)
    b-has-pre = is-prerelease(b)
    {
        ! a-has-pre && b-has-pre -> {
            cmp = 1
            return
        }

        a-has-pre && ! b-has-pre -> {
            cmp = -1
            return
        }

        a-has-pre == b-has-pre -> {
            cmp = 0
            return
        }
    }
}

; ═══════════════════════════════════════════════
; is-prerelease — check if version is a pre-release
; ═══════════════════════════════════════════════

is-prerelease = (ver str) (yes bool) {
    yes = false
    v = utils.trim-str(ver)
    {
        utils.starts-with-str(v, 'v') -> v = utils.slice-str(v, 1, v.len-bytes())

        utils.starts-with-str(v, 'V') -> v = utils.slice-str(v, 1, v.len-bytes())
    }
    {
        utils.index-str(v, 'a') >= 0 -> yes = true

        utils.index-str(v, 'b') >= 0 -> yes = true

        utils.index-str(v, 'c') >= 0 -> yes = true

        utils.index-str(v, 'rc') >= 0 -> yes = true
    }
}

; ═══════════════════════════════════════════════
; normalize — normalize a version string
; "1.2" → "1.2.0"
; "v1.2.3" → "1.2.3"
; ═══════════════════════════════════════════════

normalize = (ver str) (out str) {
    out = utils.trim-str(ver)
    {
        utils.starts-with-str(out, 'v') -> out = utils.slice-str(out, 1, out.len-bytes())

        utils.starts-with-str(out, 'V') -> out = utils.slice-str(out, 1, out.len-bytes())
    }

    major, minor, patch, pre = parse(out)

    out = major.to-str() - '.' - minor.to-str() - '.' - patch.to-str()
    ; Don't append pre to avoid split-based memory issues
    ; pre-release info is preserved via is-prerelease check
}
