; version.no — version information module
;
; Provides version detection and comparison utilities.
;
; API:
;   current() (ver str) — get current nouv version
;   parse(ver str) (major i64, minor i64, patch i64, pre str) — parse version
;   compare(a str, b str) (cmp i64) — compare two versions (-1, 0, 1)
;   is-prerelease(ver str) (yes bool) — check if pre-release
;   normalize(ver str) (out str) — normalize version string
;   str-to-i64(s str) (result i64) — safely convert string to i64

# /nouv/src/utils

NOUV-VERSION = '0.1.0'

; ═══════════════════════════════════════════════
; str-to-i64 — safely convert a string to i64
; Returns 0 if parsing fails
; ═══════════════════════════════════════════════

str-to-i64 = (s str) (result i64) {
    result = 0
    v = s.to-i64()
    v: {
        ok -> result = it

        nil -> result = 0

        err -> result = 0
    }
}

; ═══════════════════════════════════════════════
; current — get current nouv version
; ═══════════════════════════════════════════════

current = () (ver str) {
    ver = NOUV-VERSION
}

; ═══════════════════════════════════════════════
; split-pre — split a normalized version into numeric core and prerelease.
; The prerelease suffix is the trailing part beginning at the first character
; that is not a digit or '.', with a leading '.', '-' or '_' separator removed.
; This avoids the old whole-string searches that mis-flagged any 'a'/'b'/'c'
; appearing anywhere in the version.
; ═══════════════════════════════════════════════

split-pre = (v str) (core str, pre str) {
    core = v
    pre = ''
    n = v.len-bytes()
    i = 0
    (i < n) {
        c = v.byte(i)
        {
            (c >= 48 && c <= 57) || c == 46 -> {
                i = i + 1: {
                    ok -> it

                    -> _
                }
            }

            -> break
        }
    }
    i < n -> {
        core = utils.slice-str(v, 0, i)
        pre = utils.slice-str(v, i, n)
        ; strip a single leading separator ('.', '-', '_')
        pre.len-bytes() > 0 -> {
            pc = pre.byte(0)
            pc == 46 || pc == 45 || pc == 95 -> pre = utils.slice-str(pre, 1, pre.len-bytes())
        }
    }
}

; pre-rank — PEP 440 ordering rank of a prerelease label (a < b < rc/c).
pre-rank = (s str) (rank i64) {
    rank = 3
    s.len-bytes() == 0 -> return
    c = s.byte(0)
    c == 97 || c == 65 -> rank = 0
    c == 98 || c == 66 -> rank = 1
    c == 99 || c == 67 -> rank = 2
    c == 114 || c == 82 -> rank = 2
}

; pre-number — trailing numeric component of a prerelease (e.g. rc1 -> 1).
pre-number = (s str) (num i64) {
    num = 0
    len = s.len-bytes()
    i = 0
    (i < len) {
        c = s.byte(i)
        c >= 48 && c <= 57 -> break
        i = i + 1: {
            ok -> it

            -> _
        }
    }
    i < len -> num = str-to-i64(s.slice(i, len))
}

; pre-compare — compare two prerelease suffixes; empty means final release.
; A final release sorts above any prerelease with the same core version.
pre-compare = (a str, b str) (cmp i64) {
    cmp = 0
    a-empty = a.len-bytes() == 0
    b-empty = b.len-bytes() == 0
    a-empty && b-empty -> return
    a-empty -> {
        cmp = 1
        return
    }
    b-empty -> {
        cmp = -1
        return
    }
    ar = pre-rank(a)
    br = pre-rank(b)
    ar < br -> {
        cmp = -1
        return
    }
    ar > br -> {
        cmp = 1
        return
    }
    an = pre-number(a)
    bn = pre-number(b)
    an < bn -> {
        cmp = -1
        return
    }
    an > bn -> {
        cmp = 1
        return
    }
}

; ═══════════════════════════════════════════════
; parse — parse a version string into components
; "1.2.3" → major=1, minor=2, patch=3, pre=""
; "1.2.3a1" → major=1, minor=2, patch=3, pre="a1"
; ═══════════════════════════════════════════════

parse = (ver str) (major i64, minor i64, patch i64, pre str) {
    major = 0
    minor = 0
    patch = 0
    pre = ''

    v = utils.trim-str(ver)
    {
        utils.starts-with-str(v, 'v') -> v = utils.slice-str(v, 1, v.len-bytes())

        utils.starts-with-str(v, 'V') -> v = utils.slice-str(v, 1, v.len-bytes())
    }

    ; strip build metadata before splitting off the prerelease
    plus-pos = utils.index-str(v, '+')
    plus-pos >= 0 -> v = utils.slice-str(v, 0, plus-pos)

    core, pre = split-pre(v)

    ; parse core version
    parts = utils.split-str(core, '.')
    n2 = parts.len()
    {
        n2 >= 1 -> {
            p0 = parts[0]: {
                ok -> it

                -> ''
            }
            major = str-to-i64(p0)
        }
    }
    {
        n2 >= 2 -> {
            p1 = parts[1]: {
                ok -> it

                -> ''
            }
            minor = str-to-i64(p1)
        }
    }
    {
        n2 >= 3 -> {
            p2 = parts[2]: {
                ok -> it

                -> ''
            }
            patch = str-to-i64(p2)
        }
    }
}

; ═══════════════════════════════════════════════
; compare — compare two version strings
; returns -1 if a < b, 0 if equal, 1 if a > b
; ═══════════════════════════════════════════════

compare = (a str, b str) (cmp i64) {
    cmp = 0

    ma, mi, pa, pre-a = parse(a)
    mb, mib, pb, pre-b = parse(b)

    {
        ma < mb -> {
            cmp = -1
            return
        }

        ma > mb -> {
            cmp = 1
            return
        }
    }

    {
        mi < mib -> {
            cmp = -1
            return
        }

        mi > mib -> {
            cmp = 1
            return
        }
    }

    {
        pa < pb -> {
            cmp = -1
            return
        }

        pa > pb -> {
            cmp = 1
            return
        }
    }

    ; compare prerelease segments: a < b < rc < final release
    cmp = pre-compare(pre-a, pre-b)
}

; ═══════════════════════════════════════════════
; is-prerelease — check if version is a pre-release
; ═══════════════════════════════════════════════

is-prerelease = (ver str) (yes bool) {
    yes = false
    v = utils.trim-str(ver)
    {
        utils.starts-with-str(v, 'v') -> v = utils.slice-str(v, 1, v.len-bytes())

        utils.starts-with-str(v, 'V') -> v = utils.slice-str(v, 1, v.len-bytes())
    }
    plus-pos = utils.index-str(v, '+')
    plus-pos >= 0 -> v = utils.slice-str(v, 0, plus-pos)
    core, pre = split-pre(v)
    pre.len-bytes() > 0 -> yes = true
}

; ═══════════════════════════════════════════════
; normalize — normalize a version string
; "1.2" → "1.2.0"
; "v1.2.3" → "1.2.3"
; ═══════════════════════════════════════════════

normalize = (ver str) (out str) {
    out = utils.trim-str(ver)
    {
        utils.starts-with-str(out, 'v') -> out = utils.slice-str(out, 1, out.len-bytes())

        utils.starts-with-str(out, 'V') -> out = utils.slice-str(out, 1, out.len-bytes())
    }
    plus-pos = utils.index-str(out, '+')
    plus-pos >= 0 -> out = utils.slice-str(out, 0, plus-pos)

    major, minor, patch, pre = parse(out)

    out = major.to-str() - '.' - minor.to-str() - '.' - patch.to-str()
    ; preserve the prerelease suffix so lockfiles keep a1/b2/rc1 distinct
    pre.len-bytes() > 0 -> out = out - pre
}
