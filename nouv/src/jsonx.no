; jsonx.no — minimal JSON field extractor over []byte (pure Nolang)
;
; WHY []byte: in this compiler build, str.byte / str.slice DRIFT to wrong values
; on large strings (correct only for small offsets, e.g. < ~5KB; the real ~193KB
; PyPI body cannot be scanned via str at the `urls` region ~191KB).  []byte[j]
; indexing is reliable at every offset and []byte.len() is correct, so we parse
; the raw response bytes directly.
;
; ASCII control bytes used below:
;   '"'=34  '\\'=92  '{'=123  '}'=125  '['=91  ']'=93  ','=44
;   ' '=32  '\n'=10  '\r'=13  '\t'=9  ':'=58  '/'=47

# /nouv/src/utils

; ═════════════════════════════════════════════
; low-level primitives — all byte access via []byte[j] (reliable)
; ═════════════════════════════════════════════

; hex-to-codepoint — parse 4 hex digits (used by \uXXXX) to an i64 codepoint.
; Uses string comparisons only (no s.byte).  hex is a 4-char string.
hex-to-codepoint = (hex str) (cp i64) {
    cp = 0
    i = 0
    (i < 4) {
        ch = hex.slice(i, i + 1)
        v = 0
        ch == '0' -> v = 0
        ch == '1' -> v = 1
        ch == '2' -> v = 2
        ch == '3' -> v = 3
        ch == '4' -> v = 4
        ch == '5' -> v = 5
        ch == '6' -> v = 6
        ch == '7' -> v = 7
        ch == '8' -> v = 8
        ch == '9' -> v = 9
        ch == 'a' -> v = 10
        ch == 'b' -> v = 11
        ch == 'c' -> v = 12
        ch == 'd' -> v = 13
        ch == 'e' -> v = 14
        ch == 'f' -> v = 15
        ch == 'A' -> v = 10
        ch == 'B' -> v = 11
        ch == 'C' -> v = 12
        ch == 'D' -> v = 13
        ch == 'E' -> v = 14
        ch == 'F' -> v = 15
        #{overflow=wrap}
        cp = cp * 16 + v
        #{overflow=wrap}
        i = i + 1
    }
}

; json-skip-string — b[start]=='"', return index just after the closing quote
json-skip-string = (b []byte, start i64) (end i64) {
    end = start
    n = b.len()
    #{overflow=wrap}
    i = start + 1
    (i < n) {
        c = b[i]
        c == 34 -> {
            #{overflow=wrap}
            end = i + 1
            return
        }
        c == 92 -> {
            #{overflow=wrap}
            i = i + 2
            i >= n -> {
                end = n
                return
            }
        }
        -> {
            #{overflow=wrap}
            i = i + 1
        }
    }
    end = n
}

; json-read-string-value — b[start]=='"', return the unescaped string content
json-read-string-value = (b []byte, start i64) (value str) {
    value = ''
    n = b.len()
    #{overflow=wrap}
    i = start + 1
    (i < n) {
        c = b[i]
        c == 34 -> return
        c == 92 -> {
            #{overflow=wrap}
            i = i + 1
            e = b[i]
            {
                e == 34 -> value = value - '"'
                e == 92 -> value = value - '\\'
                e == 47 -> value = value - '/'
                e == 98 -> value = value - '\b'
                e == 102 -> value = value - '\f'
                e == 110 -> value = value - '\n'
                e == 114 -> value = value - '\r'
                e == 116 -> value = value - '\t'
                e == 117 -> {
                    (i + 5 <= n) -> {
                        hex = number.char-to-str(b[i + 1]) - number.char-to-str(b[i + 2]) - number.char-to-str(b[i + 3]) - number.char-to-str(b[i + 4])
                        cp = hex-to-codepoint(hex)
                        value = value - number.char-to-str(cp)
                        #{overflow=wrap}
                        i = i + 4
                    }
                    -> i = n
                }
                -> value = value - number.char-to-str(e)
            }
        }
        -> value = value - number.char-to-str(c)
        #{overflow=wrap}
        i = i + 1
    }
}

; json-skip-bracketed — b[start]==open, return index after matching close.
; Strings are honoured so quotes inside string values don't alter depth.
; open/close are ASCII codes: 123='{' 125='}' 91='[' 93=']'
json-skip-bracketed = (b []byte, start i64, open i64, close i64) (end i64) {
    end = start
    n = b.len()
    depth = 0
    i = start
    done = false
    (done == false) {
        i < n -> {
            c = b[i]
            {
                c == 34 -> { i = json-skip-string(b, i) }
                c == open -> {
                    #{overflow=wrap}
                    depth = depth + 1
                    #{overflow=wrap}
                    i = i + 1
                }
                c == close -> {
                    #{overflow=wrap}
                    depth = depth - 1
                    #{overflow=wrap}
                    i = i + 1
                    depth == 0 -> {
                        end = i
                        done = true
                    }
                }
                -> {
                    #{overflow=wrap}
                    i = i + 1
                }
            }
        }
        -> done = true
    }
}

; json-skip-value — skip any JSON value beginning at b[start]
json-skip-value = (b []byte, start i64) (end i64) {
    end = start
    n = b.len()
    start >= n -> return
    c = b[start]
    {
        c == 34 -> end = json-skip-string(b, start)
        c == 123 -> end = json-skip-bracketed(b, start, 123, 125)
        c == 91 -> end = json-skip-bracketed(b, start, 91, 93)
        -> {
            i = start
            (i < n) {
                ch = b[i]
                {
                    ch == 44 -> break
                    ch == 125 -> break
                    ch == 93 -> break
                    ch == 32 -> break
                    ch == 10 -> break
                    ch == 13 -> break
                    ch == 9 -> break
                }
                #{overflow=wrap}
                i = i + 1
            }
            end = i
        }
    }
}

; ═════════════════════════════════════════════
; key lookup
; ═════════════════════════════════════════════

; json-find-value-start — locate "key": and return the index just before the
; value (the caller inspects b[pos] to decide the value type).
json-find-value-start = (b []byte, key str) (pos i64, found bool) {
    n = b.len()
    pos, found = json-find-value-start-range(b, key, 0, n)
}

; json-find-value-start-range — single-level scan for "key": within b[start..end).
; Returns the index just before the value (the caller inspects b[pos]).
;
; Why this shape:
;   - s.index / utils.index-str misbehave on large strings, so we scan manually.
;   - str.byte / str.slice drift on large strings, so we read []byte[j] (reliable)
;     and compare byte-by-byte against `seek` (a small string; seek.byte is fine).
;   - No nested match loop that forces a break, to avoid the codegen hang.
json-find-value-start-range = (b []byte, key str, start i64, end i64) (pos i64, found bool) {
    pos = -1
    found = false
    seek = '"' - key - '":'
    tl = seek.len-bytes()
    #{overflow=wrap}
    maxi = end - tl
    i = start
    (i <= maxi) {
        ; byte-by-byte compare b[i..i+tl] against seek
        match = true
        k = 0
        (k < tl) {
            cb = b[i + k]
            sb = seek.byte(k)
            cb != sb -> { match = false }
            #{overflow=wrap}
            k = k + 1
        }
        match -> {
            k = i + tl
            ch = b[k]
            ch == 32 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            ch == 10 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            ch == 13 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            ch == 9 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            ch = b[k]
            ch == 32 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            ch == 10 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            ch == 13 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            ch == 9 -> { k < end -> { k = k + 1 #{overflow=wrap} } }
            pos = k
            found = true
            i = end
        }
        -> {
            #{overflow=wrap}
            i = i + 1
        }
    }
}

; ═════════════════════════════════════════════
; field extractors
; ═════════════════════════════════════════════

; json-get-string — return the string value for "key" (or nil)
json-get-string = (b []byte, key str) (val ?str) {
    val = nil
    pos, found = json-find-value-start(b, key)
    found -> {
        c = b[pos]
        c == 34 -> val = json-read-string-value(b, pos)
    }
}

; json-get-string-flat — like json-get-string but returns '' instead of nil
json-get-string-flat = (b []byte, key str) (val str) {
    val = ''
    opt = json-get-string(b, key)
    opt: {
        ok -> val = it
        nil -> {}
        err -> {}
    }
}

; json-get-object — return the [start,end) span of the {…} value for "key"
; (incl. braces) on the original []byte.  Returns ok=false if not found / not an
; object.
json-get-object = (b []byte, key str) (sub-start i64, sub-end i64, ok bool) {
    sub-start = 0
    sub-end = 0
    ok = false
    pos, found = json-find-value-start(b, key)
    found -> {
        c = b[pos]
        c == 123 -> {
            sub-end = json-skip-bracketed(b, pos, 123, 125)
            sub-start = pos
            ok = true
        }
    }
}

; json-get-object-keys — return newline-separated top-level keys of the object
; spanning b[ostart..oend).  Used to list PyPI `releases` versions.
json-get-object-keys = (b []byte, ostart i64, oend i64) (keys str) {
    keys = ''
    n = oend
    i = ostart + 1
    depth = 0
    (i < n) {
        ch = b[i]
        {
            ch == 34 -> {
                depth == 0 -> {
                    ; candidate key: read it, then check the next non-ws
                    ; char is ':' (so it's a key, not a string value)
                    v = json-read-string-value(b, i)
                    e = json-skip-string(b, i)
                    k = e
                    is-key = false
                    (k < n) {
                        w = b[k]
                        {
                            w == 32 -> { k = k + 1 #{overflow=wrap} }
                            w == 10 -> { k = k + 1 #{overflow=wrap} }
                            w == 13 -> { k = k + 1 #{overflow=wrap} }
                            w == 9 -> { k = k + 1 #{overflow=wrap} }
                            -> {
                                w == 58 -> is-key = true
                                k = n
                            }
                        }
                    }
                    is-key -> {
                        keys = keys - v - '\n'
                        i = e
                    }
                    -> i = e
                }
                -> i = json-skip-string(b, i)
            }
            ch == 123 -> {
                #{overflow=wrap}
                depth = depth + 1
                #{overflow=wrap}
                i = i + 1
            }
            ch == 125 -> {
                #{overflow=wrap}
                depth = depth - 1
                #{overflow=wrap}
                i = i + 1
            }
            ch == 91 -> { i = json-skip-bracketed(b, i, 91, 93) }
            -> {
                #{overflow=wrap}
                i = i + 1
            }
        }
    }
}

; json-get-string-array — return top-level string elements of "key":[…]
; as a newline-separated string (one element per line)
json-get-string-array = (b []byte, key str) (vals str) {
    vals = ''
    pos, found = json-find-value-start(b, key)
    found -> {
        c = b[pos]
        c == 91 -> {
            end = json-skip-bracketed(b, pos, 91, 93)
            i = pos + 1
            (i < end) {
                ch = b[i]
                {
                    ch == 34 -> {
                        v = json-read-string-value(b, i)
                        vals = vals - v - '\n'
                        i = json-skip-string(b, i)
                    }
                    -> i = i + 1
                }
            }
        }
    }
}

; url-fields — append wheel-*/sdist-* lines for one urls[] entry object.
; Takes the entry's [ustart, uend) span on the ORIGINAL []byte (not a slice)
; and searches within that span so repeated keys across entries don't collide.
url-fields = (b []byte, ustart i64, uend i64) (out str) {
    out = ''
    ptpos, ptf = json-find-value-start-range(b, 'packagetype', ustart, uend)
    ptf -> {
        pt = json-read-string-value(b, ptpos)
        tag = ''
        pt == 'bdist_wheel' -> tag = 'wheel'
        pt == 'sdist' -> tag = 'sdist'
        tag != '' -> {
            upos, uf = json-find-value-start-range(b, 'url', ustart, uend)
            uf -> {
                u = json-read-string-value(b, upos)
                out = out - tag - '-url=' - u - '\n'
            }
            fpos, ff = json-find-value-start-range(b, 'filename', ustart, uend)
            ff -> {
                fn = json-read-string-value(b, fpos)
                out = out - tag - '-filename=' - fn - '\n'
            }
            dpos, df = json-find-value-start-range(b, 'digests', ustart, uend)
            df -> {
                dend = json-skip-bracketed(b, dpos, 123, 125)
                spos, sf = json-find-value-start-range(b, 'sha256', dpos, dend)
                sf -> {
                    sha = json-read-string-value(b, spos)
                    out = out - tag - '-hash=' - sha - '\n'
                }
            }
        }
    }
}

; ═════════════════════════════════════════════
; parse-package-json-native — top-level entry used by the resolver.
; Takes the raw response body as []byte (reliable).  Produces the flat
; `name=value` string the existing resolver consumes:
;   version=<v>
;   name=<n>
;   requires_dist=<dep>     (one line per dependency)
;   wheel-url=<url>  wheel-filename=<fn>  wheel-hash=<sha256>
;   sdist-url=<url>  sdist-filename=<fn>  sdist-hash=<sha256>
; ═════════════════════════════════════════════

parse-package-json-native = (b []byte) (info str) {
    info = ''

    ; version / name / requires_dist are unique top-level keys
    vpos, vf = json-find-value-start(b, 'version')
    vf -> {
        v = json-read-string-value(b, vpos)
        info = info - 'version=' - v - '\n'
    }
    npos, nf = json-find-value-start(b, 'name')
    nf -> {
        nm = json-read-string-value(b, npos)
        info = info - 'name=' - nm - '\n'
    }

    rd = json-get-string-array(b, 'requires_dist')
    rd != '' -> {
        lines = utils.split-str(rd, '\n')
        ln = lines.len()
        i = 0
        (i < ln) {
            #{index-out=0}
            d = lines[i]
            #{overflow=wrap}
            i = i + 1
            d != '' -> {
                info = info - 'requires_dist=' - d - '\n'
            }
        }
    }

    upos, ufound = json-find-value-start(b, 'urls')
    ufound -> {
        c = b[upos]
        c == 91 -> {
            uend = json-skip-bracketed(b, upos, 91, 93)
            i = upos + 1
            (i < uend) {
                ch = b[i]
                {
                    ch == 123 -> {
                        oend = json-skip-bracketed(b, i, 123, 125)
                        info = info - url-fields(b, i, oend)
                        i = oend
                    }
                    -> i = i + 1
                }
            }
        }
    }
}
