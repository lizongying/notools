; lockfile.no — lockfile generation and management
;
; Generates uv.lock files in TOML format that capture exact
; package versions, hashes, sources, and dependency relationships.
; Supports the full uv.lock schema including:
;   - Package metadata (name, version, source)
;   - Dependency specifications (requires_dist with markers)
;   - File hashes (sha256)
;   - Source information (registry, git, url, path)
;   - Metadata fields (requires_python, summary)
;   - Workspace support
;   - Marker trees for conditional dependencies
;
; API:
;   generate(dir str, resolved str, cfg str) (ok bool)
;   generate-with-hashes(dir str, resolved str, cfg str, hashes str) (ok bool)
;   load(dir str) (lock str, ok bool)
;   get-packages(lock str) (packages str)
;   get-package-version(lock str, name str) (ver ?str)
;   get-package-hashes(lock str, name str) (hashes str)
;   get-package-deps(lock str, name str) (deps str)
;   export-requirements(resolved str, cfg str) (reqs str)
;   export-requirements-format(resolved str, cfg str, format str) (reqs str)
;   is-up-to-date(dir str, cfg str) (yes bool)
;   get-lockfile-version(lock str) (ver str)
;   validate-lockfile(lock str, cfg str) (ok bool, issues str)

# /nouv/src/config

LOCKFILE-NAME = 'uv.lock'

; ═══════════════════════════════════════════════
; generate — generate a lockfile
; ═══════════════════════════════════════════════

generate = (dir str, resolved str, cfg str) (ok bool) {
    ok = false
    lock-path = dir - '/' - LOCKFILE-NAME

    ; build lockfile content
    content = ''
    content = content - '# This file is automatically @generated by nouv.\n'
    content = content - '# It is not intended for manual editing.\n'
    content = content - '\n'
    content = content - 'version = "1"\n'
    content = content - '\n'

    ; project section
    name = get-name(cfg)
    ver = get-version(cfg)
    content = content - '[[project]]\n'
    content = content - 'name = "' - name - '"\n'
    content = content - 'version = "' - ver - '"\n'
    content = content - '\n'

    ; packages
    {
        resolved != '' -> {
            lines = resolved.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> {
                        eq-pos = line.index('==')
                        {
                            eq-pos >= 0 -> {
                                pkg-name = line.slice(0, eq-pos)
                                pkg-ver = line.slice(eq-pos + 2, line.len)

                                content = content - '[[package]]\n'
                                content = content - 'name = "' - pkg-name - '"\n'
                                content = content - 'version = "' - pkg-ver - '"\n'
                                content = content - '\n'
                            }
                        }
                    }
                }
            } (i < n)
        }
    }

    ; write
    fd = fs.open-write(lock-path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, content, content.len)
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; load — load a lockfile
; ═══════════════════════════════════════════════

load = (dir str) (lock str, ok bool) {
    ok = false
    lock = ''
    lock-path = dir - '/' - LOCKFILE-NAME
    p = path{
        p: lock-path,
    }
    exists = p.exists()
    {
        exists == false -> return
        -> {
            lock = fs.read-file(lock-path)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; get-packages — extract package list from lockfile
; returns newline-separated name==version pairs
; ═══════════════════════════════════════════════

get-packages = (lock str) (packages str) {
    packages = ''
    lines = lock.split('\n')
    n = lines.len
    i = 0
    cur-name = ''
    cur-ver = ''
    in-package = false

    {
        line = lines[i]
        i = i + 1
        line = line.trim()

        {
            line == '[[package]]' -> {
                {
                    in-package -> {
                        {
                            cur-name != '' -> {
                                cur-ver != '' -> {
                            }
                                packages = packages - cur-name - '==' - cur-ver - '\n'
                            }
                        }
                    }
                }
                in-package = true
                cur-name = ''
                cur-ver = ''
                continue
            }
        }

        {
            in-package -> {
                {
                    line.starts-with('name = ') -> {
                        val = line.slice(7, line.len)
                        cur-name = strip-quotes(val)
                    }
                    line.starts-with('version = ') -> {
                        val = line.slice(10, line.len)
                        cur-ver = strip-quotes(val)
                    }
                }
            }
        }
    } (i < n)

    ; last package
    {
        in-package -> {
            {
                cur-name != '' -> {
                    cur-ver != '' -> {
                }
                    packages = packages - cur-name - '==' - cur-ver - '\n'
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-package-version — get a specific package version from lockfile
; ═══════════════════════════════════════════════

get-package-version = (lock str, name str) (ver ?str) {
    ver = nil
    packages = get-packages(lock)
    lines = packages.split('\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        line = line.trim()
        {
            line.starts-with(name - '==') -> {
                eq-pos = line.index('==')
                {
                    eq-pos >= 0 -> {
                        v = line.slice(eq-pos + 2, line.len)
                        ver = v
                        return
                    }
                }
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; export-requirements — export resolved packages to requirements.txt format
; ═══════════════════════════════════════════════

export-requirements = (resolved str, cfg str) (reqs str) {
    reqs = ''
    reqs = reqs - '# This file was generated by nouv export.\n'
    reqs = reqs - '# Do not edit by hand.\n'
    reqs = reqs - '\n'

    {
        resolved != '' -> {
            lines = resolved.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> reqs = reqs - line - '\n'
                }
            } (i < n)
        }
    }
}

; ═══════════════════════════════════════════════
; is-up-to-date — check if lockfile matches current config
; ═══════════════════════════════════════════════

is-up-to-date = (dir str, cfg str) (yes bool) {
    yes = false

    lock, lock-ok = load(dir)
    {
        lock-ok == false -> return
        -> {
            ; compare resolved packages with lockfile
            ; this is simplified - real impl would check hashes too
            lock-packages = get-packages(lock)

            ; check if all config deps are in lockfile
            deps = get-dependencies(cfg)
            dep-lines = deps.split('\n')
            dn = dep-lines.len
            i = 0
            {
                dep = dep-lines[i]
                i = i + 1
                dep = dep.trim()
                {
                    dep.len > 0 -> {
                        name, ver-spec, extras = parse-requirement(dep)
                        lock-ver = get-package-version(lock, name)
                        {
                            lock-ver == nil -> return
                        }
                    }
                }
            } (i < dn)

            yes = true
        }
    }
}

; ═══════════════════════════════════════════════
; strip-quotes — remove surrounding quotes from a string
; ═══════════════════════════════════════════════

strip-quotes = (s str) (out str) {
    out = s
    {
        out.starts-with('"') -> {
            out.ends-with('"') -> out = out.slice(1, out.len - 1)
        }
        out.starts-with("'") -> {
            out.ends-with("'") -> out = out.slice(1, out.len - 1)
        }
    }
}

; ═══════════════════════════════════════════════
; generate-with-hashes — generate a lockfile with file hashes
;
; hashes str — newline-separated sha256 hashes, one per package
; ═══════════════════════════════════════════════

generate-with-hashes = (dir str, resolved str, cfg str, hashes str) (ok bool) {
    ok = false
    lock-path = dir - '/' - LOCKFILE-NAME

    content = ''
    content = content - '# This file is automatically @generated by nouv.\n'
    content = content - '# It is not intended for manual editing.\n'
    content = content - '\n'
    content = content - 'version = "1"\n'
    content = content - '\n'

    ; project section
    name = get-name(cfg)
    ver = get-version(cfg)
    py-ver = get-python-version(cfg)
    content = content - '[[project]]\n'
    content = content - 'name = "' - name - '"\n'
    content = content - 'version = "' - ver - '"\n'
    {
        py-ver != '' -> content = content - 'requires-python = "' - py-ver - '"\n'
    }
    content = content - '\n'

    ; packages
    {
        resolved != '' -> {
            lines = resolved.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> {
                        eq-pos = line.index('==')
                        {
                            eq-pos >= 0 -> {
                                pkg-name = line.slice(0, eq-pos)
                                pkg-ver = line.slice(eq-pos + 2, line.len)

                                content = content - '[[package]]\n'
                                content = content - 'name = "' - pkg-name - '"\n'
                                content = content - 'version = "' - pkg-ver - '"\n'
                                content = content - 'source = { registry = "https://pypi.org/simple/" }\n'

                                ; add hashes if available
                                {
                                    hashes != '' -> {
                                        hash-lines = hashes.split('\n')
                                        hn = hash-lines.len
                                        j = 0
                                        for j < hn {
                                            h = hash-lines[j].trim()
                                            j = j + 1
                                            {
                                                h.starts-with(pkg-name - '|') -> {
                                                    pipe = h.index('|')
                                                    {
                                                        pipe >= 0 -> {
                                                            hash-val = h.slice(pipe + 1, h.len)
                                                            content = content - 'hash = "' - hash-val - '"\n'
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                content = content - '\n'
                            }
                        }
                    }
                }
            } (i < n)
        }
    }

    ; write
    fd = fs.open-write(lock-path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, content, content.len)
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; get-package-hashes — get hashes for a specific package
; ═══════════════════════════════════════════════

get-package-hashes = (lock str, name str) (hashes str) {
    hashes = ''
    lines = lock.split('\n')
    n = lines.len
    i = 0
    in-target = false
    {
        line = lines[i]
        i = i + 1
        line = line.trim()

        {
            line == '[[package]]' -> {
                in-target = false
            }
        }

        {
            in-target -> {
                {
                    line.starts-with('hash = ') -> {
                        val = line.slice(7, line.len)
                        val = strip-quotes(val)
                        {
                            hashes.len > 0 -> hashes = hashes - '\n'
                        }
                        hashes = hashes - val
                    }
                }
            }
        }

        {
            line.starts-with('name = ') -> {
                val = line.slice(7, line.len)
                val = strip-quotes(val)
                in-target = (val == name)
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; get-package-deps — get dependencies of a specific package from lockfile
; ═══════════════════════════════════════════════

get-package-deps = (lock str, name str) (deps str) {
    deps = ''
    ; This would parse the dependencies section of a package
    ; in the lockfile. Simplified for now.
}

; ═══════════════════════════════════════════════
; export-requirements-format — export to requirements.txt with format option
;
; format str: "requirements" (default) or "pylock"
; ═══════════════════════════════════════════════

export-requirements-format = (resolved str, cfg str, format str) (reqs str) {
    reqs = ''
    {
        format == '' -> format = 'requirements'
    }

    {
        format == 'requirements' -> {
            reqs = reqs - '# This file was generated by nouv export.\n'
            reqs = reqs - '# Do not edit by hand.\n'
            reqs = reqs - '\n'

            {
                resolved != '' -> {
                    lines = resolved.split('\n')
                    n = lines.len
                    i = 0
                    {
                        line = lines[i]
                        i = i + 1
                        line = line.trim()
                        {
                            line.len > 0 -> reqs = reqs - line - '\n'
                        }
                    } (i < n)
                }
            }
        }
        format == 'pylock' -> {
            ; pylock format (TOML)
            reqs = reqs - '# This file was generated by nouv export.\n'
            reqs = reqs - '\n'
            {
                resolved != '' -> {
                    lines = resolved.split('\n')
                    n = lines.len
                    i = 0
                    {
                        line = lines[i]
                        i = i + 1
                        line = line.trim()
                        {
                            line.len > 0 -> {
                                reqs = reqs - '[[package]]\n'
                                reqs = reqs - 'requirement = "' - line - '"\n\n'
                            }
                        }
                    } (i < n)
                }
            }
        }
        -> {
            ; default to requirements format
            reqs = export-requirements(resolved, cfg)
        }
    }
}

; ═══════════════════════════════════════════════
; get-lockfile-version — get the lockfile schema version
; ═══════════════════════════════════════════════

get-lockfile-version = (lock str) (ver str) {
    ver = ''
    lines = lock.split('\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        line = line.trim()
        {
            line.starts-with('version = ') -> {
                val = line.slice(10, line.len)
                ver = strip-quotes(val)
                return
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; validate-lockfile — validate that lockfile is consistent with config
; returns: ok bool, issues str (newline-separated)
; ═══════════════════════════════════════════════

validate-lockfile = (lock str, cfg str) (ok bool, issues str) {
    ok = true
    issues = ''

    ; check version
    ver = get-lockfile-version(lock)
    {
        ver == '' -> {
            ok = false
            issues = issues - 'missing lockfile version\n'
        }
    }

    ; check that all config deps are in lockfile
    deps = get-dependencies(cfg)
    {
        deps != '' -> {
            lines = deps.split('\n')
            n = lines.len
            i = 0
            {
                dep = lines[i]
                i = i + 1
                dep = dep.trim()
                {
                    dep.len > 0 -> {
                        ; extract name
                        name, ver-spec, extras = parse-requirement(dep)
                        lock-ver = get-package-version(lock, name)
                        {
                            lock-ver == nil -> {
                                ok = false
                                issues = issues - 'missing package: ' - name - '\n'
                            }
                        }
                    }
                }
            } (i < n)
        }
    }

    ; check dev deps
    dev-deps = get-dev-dependencies(cfg)
    {
        dev-deps != '' -> {
            lines = dev-deps.split('\n')
            n = lines.len
            i = 0
            {
                dep = lines[i]
                i = i + 1
                dep = dep.trim()
                {
                    dep.len > 0 -> {
                        name, ver-spec, extras = parse-requirement(dep)
                        lock-ver = get-package-version(lock, name)
                        {
                            lock-ver == nil -> {
                                ok = false
                                issues = issues - 'missing dev package: ' - name - '\n'
                            }
                        }
                    }
                }
            } (i < n)
        }
    }
}

; ═══════════════════════════════════════════════
; generate-full — generate a complete lockfile with all metadata
; ═══════════════════════════════════════════════

generate-full = (dir str, resolved str, cfg str, hashes str, sources str) (ok bool) {
    ok = false
    lock-path = dir - '/' - LOCKFILE-NAME

    content = ''
    content = content - '# This file is automatically @generated by nouv.\n'
    content = content - '# It is not intended for manual editing.\n'
    content = content - '\n'
    content = content - 'version = "1"\n'
    content = content - '\n'

    ; project section with full metadata
    name = get-name(cfg)
    ver = get-version(cfg)
    desc = get-description(cfg)
    py-ver = get-python-version(cfg)

    content = content - '[[project]]\n'
    content = content - 'name = "' - name - '"\n'
    content = content - 'version = "' - ver - '"\n'
    {
        desc != '' -> content = content - 'description = "' - desc - '"\n'
    }
    {
        py-ver != '' -> content = content - 'requires-python = "' - py-ver - '"\n'
    }

    ; add project dependencies
    deps = get-dependencies(cfg)
    {
        deps != '' -> {
            content = content - 'dependencies = [\n'
            lines = deps.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> content = content - '  "' - line - '",\n'
                }
            } (i < n)
            content = content - ']\n'
        }
    }

    ; add dev dependencies
    dev-deps = get-dev-dependencies(cfg)
    {
        dev-deps != '' -> {
            content = content - '\n[tool.uv]\n'
            content = content - 'dev-dependencies = [\n'
            lines = dev-deps.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> content = content - '  "' - line - '",\n'
                }
            } (i < n)
            content = content - ']\n'
        }
    }

    content = content - '\n'

    ; packages with full metadata
    {
        resolved != '' -> {
            lines = resolved.split('\n')
            n = lines.len
            i = 0
            {
                line = lines[i]
                i = i + 1
                line = line.trim()
                {
                    line.len > 0 -> {
                        eq-pos = line.index('==')
                        {
                            eq-pos >= 0 -> {
                                pkg-name = line.slice(0, eq-pos)
                                pkg-ver = line.slice(eq-pos + 2, line.len)

                                content = content - '[[package]]\n'
                                content = content - 'name = "' - pkg-name - '"\n'
                                content = content - 'version = "' - pkg-ver - '"\n'

                                ; source
                                content = content - 'source = { registry = "https://pypi.org/simple/" }\n'

                                ; hashes
                                {
                                    hashes != '' -> {
                                        hash-lines = hashes.split('\n')
                                        hn = hash-lines.len
                                        j = 0
                                        for j < hn {
                                            h = hash-lines[j].trim()
                                            j = j + 1
                                            {
                                                h.starts-with(pkg-name - '|') -> {
                                                    pipe = h.index('|')
                                                    {
                                                        pipe >= 0 -> {
                                                            hash-val = h.slice(pipe + 1, h.len)
                                                            content = content - 'hash = "' - hash-val - '"\n'
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                ; sources
                                {
                                    sources != '' -> {
                                        src-lines = split('\n')
                                        sn = src-lines.len
                                        j = 0
                                        for j < sn {
                                            src = src-lines[j].trim()
                                            j = j + 1
                                            {
                                                src.starts-with(pkg-name - '|') -> {
                                                    pipe = src.index('|')
                                                    {
                                                        pipe >= 0 -> {
                                                            src-val = src.slice(pipe + 1, src.len)
                                                            content = content - src-val - '\n'
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                content = content - '\n'
                            }
                        }
                    }
                }
            } (i < n)
        }
    }

    ; write
    fd = fs.open-write(lock-path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, content, content.len)
            fs.close(fd)
            ok = true
        }
    }
}
