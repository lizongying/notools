; wheel.no — wheel file format handling
;
; Handles parsing and creation of wheel (`.whl`) files.

# /nouv/src/venv
# /nouv/src/cache
# /nouv/src/utils
# /nouv/src/markers

; ═══════════════════════════════════════════════
; install — install a wheel file into a virtual environment
; ═══════════════════════════════════════════════

install = (venv-path str, wheel-path str, no-cache bool) (ok bool) {
    ok = false

    sp-dir = get-site-packages(venv-path)
    p = path{
        p: sp-dir,
    }
    mk = p.make-dir()

    ; create temp dir for extraction
    #{overflow=wrap}
    tmp-dir = '/tmp/nouv-wheel-' - os.now-ms().to-str()
    p2 = path{
        p: tmp-dir,
    }
    mk2 = p2.make-dir()

    ; extract wheel using unzip
    #{overflow=wrap}
    code = run-cmd('unzip -o -q ' - wheel-path - ' -d ' - tmp-dir)
    {
        code != 0 -> {
            print('error: failed to extract wheel file: {wheel-path}')
            #{overflow=wrap}
            run-cmd('rm -rf ' - tmp-dir)
            return
        }
    }

    ; find dist-info directory
    dist-info-dir = ''
    #{overflow=wrap}
    out = run-cmd-output('ls ' - tmp-dir)
    lines = utils.split-str(out, '\n')
    n = lines.len()
    i = 0
    {
        #{index-out=0}
        line = lines[i]
        #{overflow=wrap}
        i = i + 1
        line = utils.trim-str(line)
        {
            utils.ends-with-str(line, '.dist-info') -> {
                dist-info-dir = line
            }
        }
    } (i < n)

    ; copy all extracted files to site-packages
    #{overflow=wrap}
    copy-code = run-cmd('cp -R ' - tmp-dir - '/* ' - sp-dir - '/')
    {
        copy-code == 0 -> ok = true
        -> print('error: failed to copy wheel contents')
    }

    ; create entry point scripts
    {
        ok -> {
            dist-info-dir != '' -> {
                #{overflow=wrap}
                ep-path = sp-dir - '/' - dist-info-dir - '/entry_points.txt'
                p4 = path{
                    p: ep-path,
                }
                ep-exists = p4.exists()
                {
                    ep-exists -> {
                        read-result = fs.read-str(ep-path)
                        read-result: {
                            ok -> ep-data = it
                            nil -> ep-data = ''
                            err -> ep-data = ''
                        }
                        ep-ok = create-entry-point-scripts(venv-path, ep-data)
                    }
                }
            }
        }
    }

    ; clean up
    #{overflow=wrap}
    run-cmd('rm -rf ' - tmp-dir)
}

; ═══════════════════════════════════════════════
; parse-metadata — parse METADATA file from wheel
; ═══════════════════════════════════════════════

parse-metadata = (metadata-content str) (metadata str, ok bool) {
    ok = false
    metadata = ''

    lines = utils.split-str(metadata-content, '\n')
    n = lines.len()
    i = 0
    {
        #{index-out=0}
        line = lines[i]
        #{overflow=wrap}
        i = i + 1
        {
            line == '' -> break
            -> {
                colon = utils.index-str(line, ':')
                {
                    colon >= 0 -> {
                        key = utils.slice-str(line, 0, colon)
                        key = utils.trim-str(key)
                        key = utils.to-lower-str(key)
                        #{overflow=wrap}
                        val = utils.slice-str(line, colon + 1, line.len())
                        val = utils.trim-str(val)
                        {
                            #{overflow=wrap}
                            key == 'name' -> metadata = metadata - 'name=' - val - '\n'
                            #{overflow=wrap}
                            key == 'version' -> metadata = metadata - 'version=' - val - '\n'
                            #{overflow=wrap}
                            key == 'summary' -> metadata = metadata - 'summary=' - val - '\n'
                            #{overflow=wrap}
                            key == 'requires-python' -> metadata = metadata - 'requires-python=' - val - '\n'
                            #{overflow=wrap}
                            key == 'license' -> metadata = metadata - 'license=' - val - '\n'
                            #{overflow=wrap}
                            key == 'author' -> metadata = metadata - 'author=' - val - '\n'
                            #{overflow=wrap}
                            key == 'home-page' -> metadata = metadata - 'home-page=' - val - '\n'
                            #{overflow=wrap}
                            key == 'requires-dist' -> metadata = metadata - 'requires-dist=' - val - '\n'
                            #{overflow=wrap}
                            key == 'requires-external' -> metadata = metadata - 'requires-external=' - val - '\n'
                            #{overflow=wrap}
                            key == 'project-url' -> metadata = metadata - 'project-url=' - val - '\n'
                            #{overflow=wrap}
                            key == 'classifier' -> metadata = metadata - 'classifier=' - val - '\n'
                            #{overflow=wrap}
                            key == 'provides-extra' -> metadata = metadata - 'provides-extra=' - val - '\n'
                        }
                    }
                }
            }
        }
    } (i < n)

    ok = metadata != ''
}

; ═══════════════════════════════════════════════
; parse-wheel-file — parse WHEEL file
; ═══════════════════════════════════════════════

parse-wheel-file = (wheel-content str) (info str, ok bool) {
    ok = false
    info = ''

    lines = utils.split-str(wheel-content, '\n')
    n = lines.len()
    i = 0
    {
        #{index-out=0}
        line = lines[i]
        #{overflow=wrap}
        i = i + 1
        {
            line == '' -> break
            -> {
                colon = utils.index-str(line, ':')
                {
                    colon >= 0 -> {
                        key = utils.slice-str(line, 0, colon)
                        key = utils.trim-str(key)
                        key = utils.to-lower-str(key)
                        #{overflow=wrap}
                        val = utils.slice-str(line, colon + 1, line.len())
                        val = utils.trim-str(val)
                        #{overflow=wrap}
                        info = info - key - '=' - val - '\n'
                    }
                }
            }
        }
    } (i < n)

    ok = info != ''
}

; ═══════════════════════════════════════════════
; parse-entry-points — parse entry_points.txt
; ═══════════════════════════════════════════════

parse-entry-points = (content str) (eps str) {
    eps = ''
    current-section = ''

    lines = utils.split-str(content, '\n')
    n = lines.len()
    i = 0
    {
        #{index-out=0}
        line = lines[i]
        #{overflow=wrap}
        i = i + 1
        line = utils.trim-str(line)
        {
            line == '' -> continue
            utils.starts-with-str(line, '[') -> {
                utils.ends-with-str(line, ']') -> {
                    #{overflow=wrap}
                    current-section = utils.slice-str(line, 1, line.len() - 1)
                }
            }
            -> {
                eq = utils.index-str(line, '=')
                {
                    eq >= 0 -> {
                        name = utils.trim-str(utils.slice-str(line, 0, eq))
                        #{overflow=wrap}
                        target = utils.trim-str(utils.slice-str(line, eq + 1, line.len()))
                        #{overflow=wrap}
                        eps = eps - current-section - ':' - name - '=' - target - '\n'
                    }
                }
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; get-entry-points — get entry points from a wheel file
; ═══════════════════════════════════════════════

get-entry-points = (wheel-path str) (eps str, ok bool) {
    ok = false
    eps = ''

    ; create temp dir for extraction
    #{overflow=wrap}
    tmp-dir = '/tmp/nouv-ep-' - os.now-ms().to-str()
    p = path{
        p: tmp-dir,
    }
    mk = p.make-dir()

    ; extract wheel using unzip
    #{overflow=wrap}
    code = run-cmd('unzip -o -q ' - wheel-path - ' -d ' - tmp-dir)
    {
        code != 0 -> {
            #{overflow=wrap}
            run-cmd('rm -rf ' - tmp-dir)
            return
        }
    }

    ; find entry_points.txt
    #{overflow=wrap}
    ep-out = run-cmd-output('find ' - tmp-dir - ' -name entry_points.txt')
    ep-lines = utils.split-str(ep-out, '\n')
    n = ep-lines.len()
    i = 0
    {
        #{index-out=0}
        fpath = ep-lines[i]
        #{overflow=wrap}
        i = i + 1
        fpath = utils.trim-str(fpath)
        {
            fpath.len() > 0 -> {
                        read-result = fs.read-str(fpath)
                        read-result: {
                            ok -> ep-data = it
                            nil -> ep-data = ''
                            err -> ep-data = ''
                        }
                eps = parse-entry-points(ep-data)
                ok = true
            }
        }
    } (i < n)

    ; clean up
    #{overflow=wrap}
    run-cmd('rm -rf ' - tmp-dir)
}

; ═══════════════════════════════════════════════
; create-entry-point-scripts — create executable scripts from entry points
; ═══════════════════════════════════════════════

create-entry-point-scripts = (venv-path str, ep-content str) (ok bool) {
    ok = false
    eps = parse-entry-points(ep-content)
    {
        eps == '' -> {
            ok = true
            return
        }
        -> {
            bin-dir = get-bin(venv-path)
            p = path{
                p: bin-dir,
            }
            mk = p.make-dir()

            lines = utils.split-str(eps, '\n')
            n = lines.len()
            i = 0
            {
                line = lines[i]
                #{overflow=wrap}
                i = i + 1
                line = utils.trim-str(line)
                {
                    line.len() > 0 -> {
                        colon1 = utils.index-str(line, ':')
                        {
                            colon1 >= 0 -> {
                                ep-type = utils.slice-str(line, 0, colon1)
                                #{overflow=wrap}
                                rest = utils.slice-str(line, colon1 + 1, line.len())
                                eq = utils.index-str(rest, '=')
                                {
                                    eq >= 0 -> {
                                        ep-name = utils.slice-str(rest, 0, eq)
                                        #{overflow=wrap}
                                        ep-target = utils.slice-str(rest, eq + 1, rest.len())

                                        {
                                            ep-type == 'console_scripts' -> {
                                                ep-type == 'gui_scripts' -> {
                                                    #{overflow=wrap}
                                                    script-path = bin-dir - '/' - ep-name
                                                    wfd = fs.open-write(script-path)
                                                    {
                                                        wfd > 0 -> {
                                                            script = ''
                                                            #{overflow=wrap}
                                                            script = script - '#!{venv-path}/bin/python3\n'
                                                            #{overflow=wrap}
                                                            script = script - '# -*- coding: utf-8 -*-\n'
                                                            #{overflow=wrap}
                                                            script = script - 'import sys\n'
                                                            #{overflow=wrap}
                                                            script = script - 'from {ep-target}\n'
                                                            #{overflow=wrap}
                                                            script = script - 'if __name__ == "__main__":\n'
                                                            #{overflow=wrap}
                                                            script = script - '    sys.exit(main())\n'
                                                            fs.write(wfd, script, script.len-bytes())
                                                            fs.close(wfd)
                                                            utils.chmod(script-path, '755')
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } (i < n)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; build-wheel-file-record — build RECORD file content
; ═══════════════════════════════════════════════

build-wheel-file-record = (files str, base-dir str) (record str) {
    record = ''
    lines = utils.split-str(files, '\n')
    n = lines.len()
    i = 0
    {
        #{index-out=0}
        file = lines[i]
        #{overflow=wrap}
        i = i + 1
        file = utils.trim-str(file)
        {
            file.len() > 0 -> {
                #{overflow=wrap}
                full-path = base-dir - '/' - file
                p2 = path{
                    p: full-path,
                }
                full-exists = p2.exists()
                {
                    full-exists -> {
                        file-data = fs.read-bytes(full-path)
                        file-data: {
                            ok -> content = it
                            nil -> content = []
                            err -> content = []
                        }
                        hash-hex = sha256.sha256-hex(content)
                        sz = content.len()
                        #{overflow=wrap}
                        record = record - file - ',sha256:' - hash-hex - ',' - sz.to-str() - '\n'
                    }
                }
            }
        }
    } (i < n)
    ; add RECORD itself (empty hash)
    record = record - 'RECORD,,\n'
}

; ═══════════════════════════════════════════════
; get-name-version — parse a wheel filename to extract name and version
; ═══════════════════════════════════════════════

get-name-version = (filename str) (result str) {
    result = ''
    name = ''
    ver = ''

    fname = filename
    {
        #{overflow=wrap}
        utils.ends-with-str(fname, '.whl') -> fname = utils.slice-str(fname, 0, fname.len-bytes() - 4)
    }

    ; manually find name and version (first two fields)
    dash = utils.index-str(fname, '-')
    {
        dash >= 0 -> {
            name = utils.slice-str(fname, 0, dash)
            #{overflow=wrap}
            rest = utils.slice-str(fname, dash + 1, fname.len-bytes())
            dash2 = utils.index-str(rest, '-')
            {
                dash2 >= 0 -> ver = utils.slice-str(rest, 0, dash2)
                -> ver = rest
            }
        }
        -> name = fname
    }

    name = utils.replace-char-str(name, "_", "-")
    result = name - '|' - ver
}

; ═══════════════════════════════════════════════
; is-wheel — check if a filename is a wheel
; ═══════════════════════════════════════════════

is-wheel = (filename str) (yes bool) {
    yes = false
    {
        utils.ends-with-str(filename, '.whl') -> yes = true
    }
}

; ═══════════════════════════════════════════════
; get-python-tag — get python compatibility tag from wheel filename
; ═══════════════════════════════════════════════

get-python-tag = (filename str) (tag str) {
    tag = ''
    fname = filename
    {
        #{overflow=wrap}
        utils.ends-with-str(fname, '.whl') -> fname = utils.slice-str(fname, 0, fname.len-bytes() - 4)
    }

    ; find 3rd dash-delimited field (index 2, i.e. skip 2 dashes)
    pos1 = utils.index-str(fname, '-')
    {
        pos1 < 0 -> return
    }
    #{overflow=wrap}
    rest1 = utils.slice-str(fname, pos1 + 1, fname.len-bytes())
    idx2 = utils.index-str(rest1, '-')
    {
        idx2 < 0 -> return
    }
    ; third field starts at idx2+1 in rest1
    #{overflow=wrap}
    rest2 = utils.slice-str(rest1, idx2 + 1, rest1.len())
    idx3 = utils.index-str(rest2, '-')
    {
        idx3 < 0 -> {
            tag = rest2
        }
        -> {
            tag = utils.slice-str(rest2, 0, idx3)
        }
    }
}

; ═══════════════════════════════════════════════
; is-compatible — check if wheel is compatible with the current platform
; ═══════════════════════════════════════════════

is-compatible = (filename str) (yes bool) {
    yes = false

    py-tag = get-python-tag(filename)

    {
        py-tag == 'py3' -> yes = true
        py-tag == 'py2.py3' -> yes = true
        utils.starts-with-str(py-tag, 'cp3') -> yes = true
    }

    {
        yes -> {
            {
                utils.ends-with-str(filename, 'any.whl') -> yes = true
                utils.ends-with-str(filename, 'linux_x86_64.whl') -> {
                    sys = markers.get-platform-system()
                    {
                        sys == 'Linux' -> {
                            arch = markers.get-platform-machine()
                            {
                                arch == 'x86_64' -> yes = true
                                -> yes = false
                            }
                        }
                        -> yes = false
                    }
                }
                utils.ends-with-str(filename, 'macosx_x86_64.whl') -> {
                    sys = markers.get-platform-system()
                    {
                        sys == 'Darwin' -> {
                            arch = markers.get-platform-machine()
                            {
                                arch == 'x86_64' -> yes = true
                                -> yes = false
                            }
                        }
                        -> yes = false
                    }
                }
                utils.ends-with-str(filename, 'macosx_arm64.whl') -> {
                    sys = markers.get-platform-system()
                    {
                        sys == 'Darwin' -> {
                            arch = markers.get-platform-machine()
                            {
                                arch == 'arm64' -> yes = true
                                -> yes = false
                            }
                        }
                        -> yes = false
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; build-record-for-installation — build a RECORD file for installed wheel
; ═══════════════════════════════════════════════

build-record-for-installation = (sp-dir str, dist-info-dir str, pkg-name str, pkg-ver str) (ok bool) {
    ok = false

    record-content = ''
    dist-info-path = sp-dir - '/' - dist-info-dir

    #{overflow=wrap}
    out = run-cmd-output('find ' - dist-info-path - ' -type f')
    lines = utils.split-str(out, '\n')
    nl = lines.len()
    i = 0
    {
        #{index-out=0}
        fpath = lines[i]
        #{overflow=wrap}
        i = i + 1
        fpath = utils.trim-str(fpath)
        {
                fpath.len() > 0 -> {
                    #{overflow=wrap}
                    rel = utils.slice-str(fpath, sp-dir.len-bytes() + 1, fpath.len())
                    p3 = path{
                        p: fpath,
                    }
                    f-exists = p3.exists()
                    {
                        f-exists -> {
                            file-data = fs.read-bytes(fpath)
                            file-data: {
                                ok -> content = it
                                nil -> content = []
                                err -> content = []
                            }
                            hash-hex = sha256.sha256-hex(content)
                            sz = content.len()
                            {
                                record-content.len-bytes() > 0 -> record-content = record-content - '\n'
                            }
                            #{overflow=wrap}
                            record-content = record-content - rel - ',sha256:' - hash-hex - ',' - sz.to-str()
                        }
                    }
                }
        }
    } (i < nl)

    ; also list package files
    norm-name = utils.replace-char-str(pkg-name, "-", "_")
    #{overflow=wrap}
    pkg-dir = sp-dir - '/' - norm-name
    p2 = path{
        p: pkg-dir,
    }
    pkg-exists = p2.exists()
    {
        pkg-exists -> {
            #{overflow=wrap}
            out2 = run-cmd-output('find ' - pkg-dir - ' -type f')
            pkg-lines = utils.split-str(out2, '\n')
            pln = pkg-lines.len()
            i = 0
            {
                fpath = pkg-lines[i]
                #{overflow=wrap}
                i = i + 1
                fpath = utils.trim-str(fpath)
                {
                fpath.len() > 0 -> {
                    #{overflow=wrap}
                    rel = utils.slice-str(fpath, sp-dir.len-bytes() + 1, fpath.len())
                    p3 = path{
                        p: fpath,
                    }
                    f-exists = p3.exists()
                    {
                        f-exists -> {
                            file-data = fs.read-bytes(fpath)
                            file-data: {
                                ok -> content = it
                                nil -> content = []
                                err -> content = []
                            }
                            hash-hex = sha256.sha256-hex(content)
                            sz = content.len()
                            {
                                record-content.len-bytes() > 0 -> record-content = record-content - '\n'
                            }
                            #{overflow=wrap}
                            record-content = record-content - rel - ',sha256:' - hash-hex - ',' - sz.to-str()
                        }
                    }
                }
                }
            } (i < pln)
        }
    }

    ; write RECORD file
    #{overflow=wrap}
    record-path = dist-info-path - '/RECORD'
    wfd = fs.open-write(record-path)
    {
        wfd > 0 -> {
            fs.write(wfd, record-content, record-content.len-bytes())
            fs.close(wfd)
            ok = true
        }
    }
}
