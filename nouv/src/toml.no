; toml.no — TOML parser and serializer
;
; A minimal TOML parser for reading and writing pyproject.toml files.
; Supports: tables, key-value pairs, strings, integers, booleans,
; arrays, inline tables, and section headers.
;
; API:
;   parse(content str) (out str) — parse TOML to flat key-string format
;   get-value(parsed str, key str) (val ?str) — get value by key
;   set-value(parsed str, key str, val str) (out str) — set value
;   serialize(parsed str) (out str) — serialize back to TOML text

; ═══════════════════════════════════════════════
; parse — parse TOML content into flat key=value format
;
; content str — TOML text
; returns:
;   out str — flat representation, one key=value per line
;             keys are fully qualified (e.g. project.name, project.dependencies)
; ═══════════════════════════════════════════════

parse = (content str) (out str) {
    out = ''
    current-table = ''
    lines = cs = content
cs = cs.split('\n')
    n = lines.len
    i = 0

    {
        line = lines[i]
        i = i + 1

        ; trim whitespace
        line = line.trim()

        ; skip empty lines and comments
        {
            line == '' -> continue
            line.starts-with('#') -> continue
        }

        ; section header [xxx]
        {
            line.starts-with('[') && line.ends-with(']') -> {
                ; extract table name
                tname = line.slice(1, line.len - 1)
                tname = tname.trim()
                {
                    tname.starts-with('[') && tname.ends-with(']') -> {
                        ; array of tables [[xxx]] - skip for now
                        current-table = tname.slice(1, tname.len - 1)
                    }
                    -> {
                        current-table = tname
                    }
                }
                continue
            }
        }

        ; key = value
        eq-pos = line.index('=')
        {
            eq-pos < 0 -> continue
            -> {
                ; extract key
                key = line.slice(0, eq-pos)
                key = key.trim()
                ; remove quotes from key
                {
                    key.starts-with('"') && key.ends-with('"') -> key = key.slice(1, key.len - 1)
                    key.starts-with("'") && key.ends-with("'") -> key = key.slice(1, key.len - 1)
                }

                ; extract value
                val = line.slice(eq-pos + 1, line.len)
                val = val.trim()
                ; remove inline comment
                hash-pos = find-unquoted-hash(val)
                {
                    hash-pos >= 0 -> val = val.slice(0, hash-pos)
                }
                val = val.trim()

                ; build full key
                full-key = key
                {
                    current-table != '' -> full-key = current-table - '.' - key
                }

                ; handle multi-line arrays
                {
                    val.starts-with('[') && ! val.ends-with(']') -> {
                        ; collect continuation lines
                        for i < n {
                            next-line = lines[i]
                            i = i + 1
                            val = val - ' ' - next-line.trim()
                            next-line.trim().ends-with(']') -> break
                        }
                    }
                }

                out = out - full-key - '=' - val - '\n'
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; find-unquoted-hash — find # not inside a string
; ═══════════════════════════════════════════════

find-unquoted-hash = (s str) (pos i64) {
    pos = -1
    in-str = false
    str-char = 0
    n = s.len
    i = 0
    {
        c = s[i]
        {
            in-str -> {
                c == str-char -> in-str = false
            }
            -> {
                {
                    c == 34 || c == 39 -> {
                        in-str = true
                        str-char = c
                    }
                    c == 35 -> {
                        pos = i
                        break
                    }
                }
            }
        }
        i = i + 1
    } (i < n)
}

; ═══════════════════════════════════════════════
; get-value — get value by fully qualified key
; ═══════════════════════════════════════════════

get-value = (parsed str, key str) (val ?str) {
    search = key - '='
    lines = parsed.split('\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        {
            line.starts-with(search) -> {
                eq-pos = line.index('=')
                {
                    eq-pos >= 0 -> {
                        v = line.slice(eq-pos + 1, line.len)
                        v = v.trim()
                        ; strip quotes if present
                        {
                            v.starts-with('"') && v.ends-with('"') -> {
                                v = v.slice(1, v.len - 1)
                            }
                        }
                        val = v
                        return
                    }
                }
            }
        }
    } (i < n)
    val = nil
}

; ═══════════════════════════════════════════════
; set-value — set value for a key
; ═══════════════════════════════════════════════

set-value = (parsed str, key str, val str) (out str) {
    out = ''
    search = key - '='
    lines = parsed.split('\n')
    n = lines.len
    i = 0
    found = false
    {
        line = lines[i]
        i = i + 1
        {
            line.starts-with(search) -> {
                out = out - key - '=' - val - '\n'
                found = true
            }
            -> {
                out = out - line - '\n'
            }
        }
    } (i < n)
    found == false -> {
        out = out - key - '=' - val - '\n'
    }
}

; ═══════════════════════════════════════════════
; serialize — convert parsed format back to TOML text
; ═══════════════════════════════════════════════

serialize = (parsed str) (out str) {
    out = ''
    lines = parsed.split('\n')
    n = lines.len
    i = 0
    current-section = ''
    {
        line = lines[i]
        i = i + 1
        {
            line == '' -> continue
            -> {
                eq-pos = line.index('=')
                {
                    eq-pos < 0 -> continue
                    -> {
                        key = line.slice(0, eq-pos)
                        val = line.slice(eq-pos + 1, line.len)
                        val = val.trim()

                        ; determine section
                        dot-pos = key.index('.')
                        {
                            dot-pos >= 0 -> {
                                section = key.slice(0, dot-pos)
                                {
                                    section != current-section -> {
                                        out = out - '\n[' - section - ']\n'
                                        current-section = section
                                    }
                                }
                                ; sub-key
                                sub-key = key.slice(dot-pos + 1, key.len)
                                out = out - sub-key - ' = ' - val - '\n'
                            }
                            -> {
                                ; top-level key
                                out = out - key - ' = ' - val - '\n'
                            }
                        }
                    }
                }
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; parse-array — parse a TOML array value into newline-separated items
; val str — array value like "['foo', 'bar']"
; returns: items str — newline-separated items
; ═══════════════════════════════════════════════

parse-array = (val str) (items str) {
    items = ''
    val = val.trim()
    {
        val.starts-with('[') -> val = val.slice(1, val.len)
    }
    {
        val.ends-with(']') -> val = val.slice(0, val.len - 1)
    }
    val = val.trim()
    {
        val == '' -> return
        -> {
            parts = val.split(',')
            n = parts.len
            i = 0
            {
                item = parts[i]
                item = item.trim()
                {
                    item.starts-with('"') && item.ends-with('"') -> item = item.slice(1, item.len - 1)
                    item.starts-with("'") && item.ends-with("'") -> item = item.slice(1, item.len - 1)
                }
                item = item.trim()
                item.len > 0 -> items = items - item - '\n'
                i = i + 1
            } (i < n)
        }
    }
}

; ═══════════════════════════════════════════════
; make-array-value — create a TOML array value from newline-separated items
; items str — newline-separated items
; returns: val str — TOML array like ['item1', 'item2']
; ═══════════════════════════════════════════════

make-array-value = (items str) (val str) {
    val = '['
    lines = items.split('\n')
    n = lines.len
    first = true
    i = 0
    {
        item = lines[i]
        i = i + 1
        item = item.trim()
        item.len > 0 -> {
            first == false -> val = val - ', '
            val = val - "'" - item - "'"
            first = false
        }
    } (i < n)
    val = val - ']'
}
