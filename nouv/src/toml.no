; toml.no — TOML parser and serializer
;
; A minimal TOML parser for reading and writing pyproject.toml files.
; Supports: tables, key-value pairs, strings, integers, booleans,
; arrays, inline tables, and section headers.
;
; API:
;   parse(content str) (out str) — parse TOML to flat key-string format
;   get-value(parsed str, key str) (val ?str) — get value by key
;   set-value(parsed str, key str, val str) (out str) — set value
;   serialize(parsed str) (out str) — serialize back to TOML text

# /nouv/src/utils

; ═══════════════════════════════════════════════
; parse — parse TOML content into flat key=value format
;
; content str — TOML text
; returns:
;   out str — flat representation, one key=value per line
;             keys are fully qualified (e.g. project.name, project.dependencies)
; ═══════════════════════════════════════════════

parse = (content str) (out str) {
    out = ''
    current-table = ''
    lines = utils.split-str(content, '\n')
    n = lines.len
    i = 0

    {
        line = lines[i]
        i = i + 1

        ; trim whitespace
        line = utils.trim-str(line)

        ; skip empty lines and comments
        {
            line == '' -> continue
            utils.starts-with-str(line, '#') -> continue
        }

        ; section header [xxx]
        {
            utils.starts-with-str(line, '[') -> {
                utils.ends-with-str(line, ']') -> {
                    ; extract table name
                    tname = utils.slice-str(line, 1, line.len - 1)
                    tname = utils.trim-str(tname)
                    {
                        utils.starts-with-str(tname, '[') -> {
                            utils.ends-with-str(tname, ']') -> {
                                ; array of tables [[xxx]] - skip for now
                                current-table = utils.slice-str(tname, 1, tname.len - 1)
                            }
                        }
                        -> {
                            current-table = tname
                        }
                    }
                    continue
                }
            }
        }

        ; key = value
        eq-pos = utils.index-str(line, '=')
        {
            eq-pos < 0 -> continue
            -> {
                ; extract key
                key = utils.slice-str(line, 0, eq-pos)
                key = utils.trim-str(key)
                ; remove quotes from key
                {
                    utils.starts-with-str(key, '"') -> { utils.ends-with-str(key, '"') -> key = utils.slice-str(key, 1, key.len - 1) }
                    utils.starts-with-str(key, "'") -> { utils.ends-with-str(key, "'") -> key = utils.slice-str(key, 1, key.len - 1) }
                }

                ; extract value
                val = utils.slice-str(line, eq-pos + 1, line.len)
                val = utils.trim-str(val)
                ; remove inline comment
                hash-pos = find-unquoted-hash(val)
                {
                    hash-pos >= 0 -> val = utils.slice-str(val, 0, hash-pos)
                }
                val = utils.trim-str(val)

                ; build full key
                full-key = key
                {
                    current-table != '' -> full-key = current-table - '.' - key
                }

                ; handle multi-line arrays
                {
                    utils.starts-with-str(val, '[') -> {
                        utils.ends-with-str(val, ']') == false -> {
                            ; collect continuation lines
                            {
                                next-line = lines[i]
                                i = i + 1
                                tl = utils.trim-str(next-line)
                                val = val - ' ' - tl
                                {
                                    utils.ends-with-str(tl, ']') -> break
                                }
                            } (i < n)
                        }
                    }
                }

                out = out - full-key - '=' - val - '\n'
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; find-unquoted-hash — find # not inside a string
; ═══════════════════════════════════════════════

find-unquoted-hash = (s str) (pos i64) {
    pos = -1
    in-str = false
    str-char = 0
    n = s.len
    i = 0
    {
        c = s[i]
        {
            in-str -> {
                c == str-char -> in-str = false
            }
            -> {
                {
                    c == 34 -> {
                        in-str = true
                        str-char = c
                    }
                    c == 39 -> {
                        in-str = true
                        str-char = c
                    }
                    c == 35 -> {
                        pos = i
                        break
                    }
                }
            }
        }
        i = i + 1
    } (i < n)
}

; ═══════════════════════════════════════════════
; get-value — get value by fully qualified key
; ═══════════════════════════════════════════════

get-value = (parsed str, key str) (val ?str) {
    search = key - '='
    lines = utils.split-str(parsed, '\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        {
            utils.starts-with-str(line, search) -> {
                eq-pos = utils.index-str(line, '=')
                {
                    eq-pos >= 0 -> {
                        v = utils.slice-str(line, eq-pos + 1, line.len)
                        v = utils.trim-str(v)
                        ; strip quotes if present
                        {
                            utils.starts-with-str(v, '"') -> {
                                utils.ends-with-str(v, '"') -> {
                                    v = utils.slice-str(v, 1, v.len - 1)
                                }
                            }
                        }
                        val = v
                        return
                    }
                }
            }
        }
    } (i < n)
    val = nil
}

; ═══════════════════════════════════════════════
; set-value — set value for a key
; ═══════════════════════════════════════════════

set-value = (parsed str, key str, val str) (out str) {
    out = ''
    search = key - '='
    lines = utils.split-str(parsed, '\n')
    n = lines.len
    i = 0
    found = false
    {
        line = lines[i]
        i = i + 1
        {
            utils.starts-with-str(line, search) -> {
                out = out - key - '=' - val - '\n'
                found = true
            }
            -> {
                out = out - line - '\n'
            }
        }
    } (i < n)
    found == false -> {
        out = out - key - '=' - val - '\n'
    }
}

; ═══════════════════════════════════════════════
; serialize — convert parsed format back to TOML text
; ═══════════════════════════════════════════════

serialize = (parsed str) (out str) {
    out = ''
    lines = utils.split-str(parsed, '\n')
    n = lines.len
    i = 0
    current-section = ''
    {
        line = lines[i]
        i = i + 1
        {
            line == '' -> continue
            -> {
                eq-pos = utils.index-str(line, '=')
                {
                    eq-pos < 0 -> continue
                    -> {
                        key = utils.slice-str(line, 0, eq-pos)
                        val = utils.slice-str(line, eq-pos + 1, line.len)
                        val = utils.trim-str(val)

                        ; determine section
                        dot-pos = utils.index-str(key, '.')
                        {
                            dot-pos >= 0 -> {
                                section = utils.slice-str(key, 0, dot-pos)
                                {
                                    section != current-section -> {
                                        out = out - '\n[' - section - ']\n'
                                        current-section = section
                                    }
                                }
                                ; sub-key
                                sub-key = utils.slice-str(key, dot-pos + 1, key.len)
                                out = out - sub-key - ' = ' - val - '\n'
                            }
                            -> {
                                ; top-level key
                                out = out - key - ' = ' - val - '\n'
                            }
                        }
                    }
                }
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; parse-array — parse a TOML array value into newline-separated items
; val str — array value like "['foo', 'bar']"
; returns: items str — newline-separated items
; ═══════════════════════════════════════════════

parse-array = (val str) (items str) {
    items = ''
    val = utils.trim-str(val)
    {
        utils.starts-with-str(val, '[') -> val = utils.slice-str(val, 1, val.len)
    }
    {
        utils.ends-with-str(val, ']') -> val = utils.slice-str(val, 0, val.len - 1)
    }
    val = utils.trim-str(val)
    {
        val == '' -> return
        -> {
            parts = utils.split-str(val, ',')
            n = parts.len
            i = 0
            {
                item = parts[i]
                item = utils.trim-str(item)
                {
                    utils.starts-with-str(item, '"') -> { utils.ends-with-str(item, '"') -> item = utils.slice-str(item, 1, item.len - 1) }
                    utils.starts-with-str(item, "'") -> { utils.ends-with-str(item, "'") -> item = utils.slice-str(item, 1, item.len - 1) }
                }
                item = utils.trim-str(item)
                item.len > 0 -> items = items - item - '\n'
                i = i + 1
            } (i < n)
        }
    }
}

; ═══════════════════════════════════════════════
; make-array-value — create a TOML array value from newline-separated items
; items str — newline-separated items
; returns: val str — TOML array like ['item1', 'item2']
; ═══════════════════════════════════════════════

make-array-value = (items str) (val str) {
    val = '['
    lines = utils.split-str(items, '\n')
    n = lines.len
    first = true
    i = 0
    {
        item = lines[i]
        i = i + 1
        item = utils.trim-str(item)
        item.len > 0 -> {
            first == false -> val = val - ', '
            val = val - "'" - item - "'"
            first = false
        }
    } (i < n)
    val = val - ']'
}

; ═══════════════════════════════════════════════
; get-value-str — get value as str (not ?str) to avoid cross-module type issues
; returns: val str, found bool
; ═══════════════════════════════════════════════

get-value-str = (parsed str, key str) (val str, found bool) {
    val = ''
    found = false
    search = key - '='
    lines = utils.split-str(parsed, '\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        {
            utils.starts-with-str(line, search) -> {
                eq-pos = utils.index-str(line, '=')
                {
                    eq-pos >= 0 -> {
                        v = utils.slice-str(line, eq-pos + 1, line.len)
                        v = utils.trim-str(v)
                        ; strip quotes if present
                        {
                            utils.starts-with-str(v, '"') -> {
                                utils.ends-with-str(v, '"') -> {
                                    v = utils.slice-str(v, 1, v.len - 1)
                                }
                            }
                        }
                        val = v
                        found = true
                        return
                    }
                }
            }
        }
    } (i < n)
}
