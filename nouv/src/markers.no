; markers.no — PEP 508 environment marker evaluation
;
; Evaluates environment markers used in dependency specifications.
; Supports all PEP 508/PEP 345 marker variables and comparison operators.
;
; Marker variables:
;   python_version, python_full_version, platform_system, platform_machine,
;   sys_platform, implementation_name, extra, os_name, os.name,
;   platform_release, platform_version, platform.python_implementation
;
; Operators: ==, !=, <, <=, >, >=, ~=, in, not in, and, or
;
; API:
;   evaluate(marker str, extras str) (ok bool) — evaluate marker
;   evaluate-expression(marker str, env str) (result bool, ok bool)
;   get-env-value(name str) (val str) — get environment variable value
;   tokenize(marker str) (tokens str) — tokenize marker expression

# /nouv/src/utils

; ═══════════════════════════════════════════════
; Environment variable getters
; ═══════════════════════════════════════════════

get-python-version = () (ver str) {
    ver = ''
    out = utils.run-cmd-output('python3 -c "import sys; print(f\\"{sys.version_info.major}.{sys.version_info.minor}\\")"')
    ver = utils.trim-str(out)
    {
        ver == '' -> {

            ; fallback
            out2 = utils.run-cmd-output('python3 --version')

            ; "Python 3.12.0" → "3.12"
            {
                utils.starts-with-str(out2, 'Python ') -> {
                    full = utils.slice-str(out2, 7, out2.len-bytes())
                    full = utils.trim-str(full)
                    parts = utils.split-str(full, '.')
                    {
                        parts.len() >= 2 -> {
                            ver = parts[0] - '.' - parts[1]
                        }
                    }
                }
            }
        }
    }
}

get-python-full-version = () (ver str) {
    ver = ''
    out = utils.run-cmd-output('python3 --version')
    {
        utils.starts-with-str(out, 'Python ') -> {
            ver = utils.slice-str(out, 7, out.len-bytes())
            ver = utils.trim-str(ver)
        }

        -> ver = utils.trim-str(out)
    }
}

get-platform-system = () (sys str) {
    u = os.uname()
    sys = u.sysname
}

get-platform-machine = () (arch str) {
    u = os.uname()
    arch = u.machine
}

get-sys-platform = () (plat str) {
    plat = get-platform-system()
    {
        plat == 'Darwin' -> plat = 'darwin'

        plat == 'Linux' -> plat = 'linux'
    }
}

get-os-name = () (name str) {
    name = ''
    sys = get-platform-system()
    {
        sys == 'Darwin' -> name = 'posix'

        sys == 'Linux' -> name = 'posix'

        -> name = 'posix'
    }
}

get-implementation-name = () (name str) {
    name = 'cpython'
}

get-platform-release = () (rel str) {
    u = os.uname()
    rel = u.release
}

get-platform-version = () (ver str) {
    u = os.uname()
    ver = u.version
}

get-python-implementation = () (impl str) {
    impl = 'CPython'
}

; ═══════════════════════════════════════════════
; evaluate — evaluate a marker expression
; ═══════════════════════════════════════════════

evaluate = (marker str, extras str) (ok bool) {
    ok = true
    {
        marker == '' -> return
    }

    ; parse and evaluate the expression
    result = false
    eval-ok = false
    result-opt = eval-or(marker, extras)
    result-opt: {
        ok -> {
            result = it
            eval-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        eval-ok -> ok = result

        -> ok = false
    }
}

; ═══════════════════════════════════════════════
; eval-or — evaluate OR expression (lowest precedence)
; ═══════════════════════════════════════════════

eval-or = (expr str, extras str) (result ?bool) {
    result = false

    ; split by " or " at top level (not inside quotes/parens).
    ; split-top-level returns a single string with each top-level operand
    ; separated by '\n'; split it into a real slice before indexing.
    joined = split-top-level(expr, ' or ')
    parts = utils.split-str(joined, '\n')
    n = parts.len()
    {
        n == 0 -> return

        -> {
            i = 0
            (i < n) {
                part = parts[i] #{index-out=0}

                #{overflow=wrap}
                i = i + 1
                part = utils.trim-str(part)
                {
                    part != '' -> {
                        r = false
                        part-ok = false
                        r-opt = eval-and(part, extras)
                        r-opt: {
                            ok -> {
                                r = it
                                part-ok = true
                            }

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        {
                            part-ok -> {
                                r -> {
                                    result = true
                                    return
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; eval-and — evaluate AND expression
; ═══════════════════════════════════════════════

eval-and = (expr str, extras str) (result ?bool) {
    result = false

    joined = split-top-level(expr, ' and ')
    parts = utils.split-str(joined, '\n')
    n = parts.len()
    {
        n == 0 -> return

        -> {
            i = 0
            (i < n) {
                part = parts[i] #{index-out=0}

                #{overflow=wrap}
                i = i + 1
                part = utils.trim-str(part)
                {
                    part != '' -> {
                        r = false
                        part-ok = false
                        r-opt = eval-comparison(part, extras)
                        r-opt: {
                            ok -> {
                                r = it
                                part-ok = true
                            }

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        {
                            part-ok -> {
                                ! r -> {
                                    result = false
                                    return
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; eval-comparison — evaluate a single comparison expression
; ═══════════════════════════════════════════════

eval-comparison = (expr str, extras str) (result ?bool) {
    result = false

    src = utils.trim-str(expr)
    {
        src == '' -> return
    }

    ; handle parenthesized expression
    {
        utils.starts-with-str(src, '(') -> {

            ; find matching close paren
            n = src.len()
            depth = 0
            i = 0
            close = -1
            (i < n) {
                c = src[i]
                {
                    c == 40 -> {

                        #{overflow=wrap}
                        depth = depth + 1; (
                    }

                    c == 41 -> {; )

                        #{overflow=wrap}
                        depth = depth - 1
                        {
                            depth == 0 -> {
                                close = i
                                break
                            }
                        }
                    }
                }

                #{overflow=wrap}
                i = i + 1
            }
            {
                close >= 0 -> {
                    inner = utils.slice-str(src, 1, close)

                    ; check if there's more after close paren
                    #{overflow=wrap}
                    rest = utils.slice-str(src, close + 1, n)
                    rest = utils.trim-str(rest)
                    {
                        rest == '' -> {

                            ; just a parenthesized expression
                            result = false
                            result-opt2 = eval-or(inner, extras)
                            result-opt2: {
                                ok -> {
                                    result = it
                                }

                                nil -> {
                                }

                                err -> {
                                }
                            }
                            return
                        }
                    }
                }
            }
        }
    }

    ; find comparison operator
    op, left, right = find-comparison-op(src)
    {
        op == '' -> {

            ; no operator — check for truthiness
            {
                src == 'true' -> {
                    result = true
                    return
                }

                src == 'false' -> {
                    result = false
                    return
                }
            }
            return
        }
    }

    ; resolve left side (variable)
    left = utils.trim-str(left)
    left-val = resolve-value(left, extras)

    ; resolve right side (constant, usually quoted)
    right = utils.trim-str(right)
    right-val = right
    {
        utils.starts-with-str(right, '"') -> {

            #{overflow=wrap}
            utils.ends-with-str(right, '"') -> right-val = utils.slice-str(right, 1, right.len-bytes() - 1)
        }

        utils.starts-with-str(right, '\'') -> {

            #{overflow=wrap}
            utils.ends-with-str(right, '\'') -> right-val = utils.slice-str(right, 1, right.len-bytes() - 1)
        }
    }

    ; evaluate comparison
    result = false
    ok = false
    result-opt = compare-values(left-val, op, right-val)
    result-opt: {
        ok -> {
            result = it
            ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; find-comparison-op — find the comparison operator in an expression
; ═══════════════════════════════════════════════

find-comparison-op = (haystack str) (op str, left str, right str) {
    op = ''
    left = haystack
    right = ''
    hs = haystack
    hl = hs.len-bytes()

    ; try operators in order of length (longest first)
    p1 = find-op-pos(hs, ' not in ')
    {
        p1 >= 0 -> {
            op = 'not in'
            left = utils.slice-str(hs, 0, p1)

            #{overflow=wrap}
            right = utils.slice-str(hs, p1 + 8, hl)
            return
        }
    }
    p2 = find-op-pos(hs, ' in ')
    {
        p2 >= 0 -> {
            op = 'in'
            left = utils.slice-str(hs, 0, p2)

            #{overflow=wrap}
            right = utils.slice-str(hs, p2 + 4, hl)
            return
        }
    }

    ; comparison operators — try each in order
    p3 = find-op-pos(hs, '===')
    {
        p3 >= 0 -> {
            op = '==='
            left = utils.slice-str(hs, 0, p3)

            #{overflow=wrap}
            right = utils.slice-str(hs, p3 + 3, hl)
            return
        }
    }
    p4 = find-op-pos(hs, '~=')
    {
        p4 >= 0 -> {
            op = '~='
            left = utils.slice-str(hs, 0, p4)

            #{overflow=wrap}
            right = utils.slice-str(hs, p4 + 2, hl)
            return
        }
    }
    p5 = find-op-pos(hs, '>=')
    {
        p5 >= 0 -> {
            op = '>='
            left = utils.slice-str(hs, 0, p5)

            #{overflow=wrap}
            right = utils.slice-str(hs, p5 + 2, hl)
            return
        }
    }
    p6 = find-op-pos(hs, '<=')
    {
        p6 >= 0 -> {
            op = '<='
            left = utils.slice-str(hs, 0, p6)

            #{overflow=wrap}
            right = utils.slice-str(hs, p6 + 2, hl)
            return
        }
    }
    p7 = find-op-pos(hs, '==')
    {
        p7 >= 0 -> {
            op = '=='
            left = utils.slice-str(hs, 0, p7)

            #{overflow=wrap}
            right = utils.slice-str(hs, p7 + 2, hl)
            return
        }
    }
    p8 = find-op-pos(hs, '!=')
    {
        p8 >= 0 -> {
            op = '!='
            left = utils.slice-str(hs, 0, p8)

            #{overflow=wrap}
            right = utils.slice-str(hs, p8 + 2, hl)
            return
        }
    }
    p9 = find-op-pos(hs, '>')
    {
        p9 >= 0 -> {
            op = '>'
            left = utils.slice-str(hs, 0, p9)

            #{overflow=wrap}
            right = utils.slice-str(hs, p9 + 1, hl)
            return
        }
    }
    p10 = find-op-pos(hs, '<')
    {
        p10 >= 0 -> {
            op = '<'
            left = utils.slice-str(hs, 0, p10)

            #{overflow=wrap}
            right = utils.slice-str(hs, p10 + 1, hl)
            return
        }
    }
}

; ═══════════════════════════════════════════════
; find-op-pos — find operator position (not inside quotes)
; ═══════════════════════════════════════════════

find-op-pos = (haystack str, needle str) (pos i64) {
    pos = -1
    hs = haystack
    nd = needle
    n = hs.len-bytes()
    nl = nd.len-bytes()
    i = 0
    (i < n) {

        #{overflow=wrap}
        i + nl <= n -> {
            candidate = utils.slice-str(hs, i, i + nl)
            {
                candidate == nd -> {
                    pos = i
                    return
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}

; ═══════════════════════════════════════════════
; resolve-value — resolve a marker variable to its value
; ═══════════════════════════════════════════════

resolve-value = (name str, extras str) (val str) {
    val = ''
    n = utils.trim-str(name)

    ; remove quotes if it's a string literal
    {
        utils.starts-with-str(n, '"') -> {

            #{overflow=wrap}
            val = utils.slice-str(n, 1, n.len-bytes() - 1)
            return
        }
    }
    {
        utils.starts-with-str(n, '\'') -> {

            #{overflow=wrap}
            val = utils.slice-str(n, 1, n.len-bytes() - 1)
            return
        }
    }

    ; resolve variable
    n: {
        'python_version' -> val = get-python-version()

        'python_full_version' -> val = get-python-full-version()

        'platform_system' -> val = get-platform-system()

        'platform_machine' -> val = get-platform-machine()

        'sys_platform' -> val = get-sys-platform()

        'os.name' -> val = get-os-name()

        'os_name' -> val = get-os-name()

        'implementation_name' -> val = get-implementation-name()

        'platform_release' -> val = get-platform-release()

        'platform_version' -> val = get-platform-version()

        'platform.python_implementation' -> val = get-python-implementation()

        'extra' -> {

            ; 'extra' variable checks if a specific extra is being installed
            val = extras
        }

        -> val = n
    }
}

; ═══════════════════════════════════════════════
; compare-values — compare values using the operator
; ═══════════════════════════════════════════════

compare-values = (left str, op str, right str) (result ?bool) {
    result = false

    op: {
        '==' -> result = left == right

        '!=' -> result = left != right

        '>=' -> result = version-gte(left, right)

        '<=' -> result = version-lte(left, right)

        '>' -> result = version-gt(left, right)

        '<' -> result = version-lt(left, right)

        '~=' -> result = version-compat(left, right)

        '===' -> result = left == right

        'in' -> result = utils.contains-str(right, left)

        'not in' -> {
            result = ! utils.contains-str(right, left)
        }

        -> ok = false
    }
}

; ═══════════════════════════════════════════════
; Version comparison helpers
; ═══════════════════════════════════════════════

version-gte = (a str, b str) (result bool) {
    result = false
    cmp = version-cmp(a, b)
    result = cmp >= 0
}

version-lte = (a str, b str) (result bool) {
    result = false
    cmp = version-cmp(a, b)
    result = cmp <= 0
}

version-gt = (a str, b str) (result bool) {
    result = false
    cmp = version-cmp(a, b)
    result = cmp > 0
}

version-lt = (a str, b str) (result bool) {
    result = false
    cmp = version-cmp(a, b)
    result = cmp < 0
}

version-compat = (a str, b str) (result bool) {
    result = false

    ; ~= operator: >= b and < (b with last component + 1)
    cmp = version-cmp(a, b)
    {
        cmp < 0 -> return
    }

    ; compute upper bound
    parts = utils.split-str(b, '.')
    n = parts.len()
    {
        n < 2 -> {
            result = true
            return
        }

        -> {

            #{index-out=zero}
            major = parts[0]
            minor = utils.str-to-i64(parts[1])

            upper = major - '.' - (minor + 1).to-str() - '.0'
            cmp2 = version-cmp(a, upper)
            result = cmp2 < 0
        }
    }
}

version-cmp = (a str, b str) (cmp i64) {
    cmp = 0
    a-parts = utils.split-str(a, '.')
    b-parts = utils.split-str(b, '.')
    a-n = a-parts.len()
    b-n = b-parts.len()
    max-n = a-n
    {
        b-n > max-n -> max-n = b-n
    }

    i <- [0..max-n): {
        a-val = 0
        b-val = 0
        {
            i < a-n -> a-val = utils.str-to-i64(a-parts[i])
        }
        {
            i < b-n -> b-val = utils.str-to-i64(b-parts[i])
        }
        {
            a-val < b-val -> {
                cmp = -1
                return
            }

            a-val > b-val -> {
                cmp = 1
                return
            }
        }
    }
}

; ═══════════════════════════════════════════════
; split-top-level — split expression by separator at top level
; (not inside quotes or parentheses)
; ═══════════════════════════════════════════════

split-top-level = (expr str, sep str) (parts str) {
    parts = expr
    n = expr.len-bytes()
    in-str = false
    str-char = 0
    depth = 0
    i = 0

    (i < n) {
        c = expr[i]
        {
            in-str -> {
                c == str-char -> in-str = false
            }
        }
        {
            ! in-str -> {
                c == 34 -> {
                    in-str = true
                    str-char = c
                }

                c == 39 -> {
                    in-str = true
                    str-char = c
                }

                c == 40 -> {

                    #{overflow=wrap}
                    depth = depth + 1; (
                }

                c == 41 -> {

                    #{overflow=wrap}
                    depth = depth - 1; )
                }
            }
        }
        {
            ! in-str -> {

                #{overflow=wrap}
                depth == 0 -> {
                    i + sep.len-bytes() <= n -> {
                        candidate = utils.slice-str(expr, i, i + sep.len-bytes())
                        {
                            candidate == sep -> {

                                ; replace separator with newline
                                before = utils.slice-str(expr, 0, i)
                                after = utils.slice-str(expr, i + sep.len-bytes(), n)
                                expr = before - '\n' - after
                                n = expr.len-bytes()
                                i = i; re-check this position
                            }
                        }
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }

    parts = expr
}
