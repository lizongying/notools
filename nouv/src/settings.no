; settings.no — global uv settings and configuration
;
; Manages global configuration through environment variables, config files,
; and pyproject.toml [tool.uv] sections. Mirrors uv's settings hierarchy:
;   1. Command-line flags (handled in main.no)
;   2. Environment variables (UV_*)
;   3. pyproject.toml [tool.uv] section
;   4. Default values
;
; API:
;   get-index-url() (url str) — primary index URL
;   get-extra-index-urls() (urls str) — extra index URLs
;   get-cache-dir() (dir str) — cache directory
;   get-python-version() (ver str) — required Python version
;   get-python-install-dir() (dir str) — managed Python directory
;   get-tool-dir() (dir str) — tool installation directory
;   get-no-sync() (yes bool) — whether to skip sync
;   get-frozen() (yes bool) — frozen mode (no lockfile updates)
;   get-locked() (yes bool) — locked mode (require up-to-date lockfile)
;   get-no-cache() (yes bool) — disable cache
;   get-reinstall() (yes bool) — reinstall all packages
;   get-link-mode() (mode str) — link mode (clone, copy, symlink, hardlink)
;   get-concurrent-downloads() (n i64) — concurrent download limit
;   get-index-strategy() (mode str) — index strategy (first-index, unsafe-best-match)
;   get-publish-url() (url str) — publish URL
;   get-keyring-provider() (mode str) — keyring provider (disabled, subprocess, enabled)
;   get-config-file() (path str) — config file path
;   load-config-file() (cfg ?str) — load config file
;   get-index-auth(url str) (user str, pass str) — get index credentials

# /nouv/src/ptoml
# /nouv/src/utils

DEFAULT-INDEX = 'https://pypi.org/simple/'
DEFAULT-PUBLISH-URL = 'https://upload.pypi.org/legacy/'
DEFAULT-LINK-MODE = 'clone'
DEFAULT-INDEX-STRATEGY = 'first-index'
DEFAULT-CONCURRENT-DOWNLOADS = 50

; ═══════════════════════════════════════════════
; get-index-url — get the primary index URL
; Priority: UV_INDEX_URL env > PIP_INDEX_URL env > tool.uv.index-url config > default
; ═══════════════════════════════════════════════

get-index-url = () (url str) {
    url = os.get-env('UV_INDEX_URL')
    {
        url == '' -> url = os.get-env('UV_DEFAULT_INDEX')
    }
    {
        url == '' -> url = os.get-env('PIP_INDEX_URL')
    }
    {
        url == '' -> url = DEFAULT-INDEX
    }
}

; ═══════════════════════════════════════════════
; get-extra-index-urls — get extra index URLs
; returns newline-separated URLs
; ═══════════════════════════════════════════════

get-extra-index-urls = () (urls str) {
    urls = os.get-env('UV_EXTRA_INDEX_URL')
    {
        urls == '' -> urls = os.get-env('PIP_EXTRA_INDEX_URL')
    }
}

; ═══════════════════════════════════════════════
; get-cache-dir — get cache directory
; Priority: UV_CACHE_DIR env > tool.uv.cache-dir config > default
; ═══════════════════════════════════════════════

get-cache-dir = () (dir str) {
    dir = os.get-env('UV_CACHE_DIR')
    {
        dir == '' -> {
            home = os.get-env('HOME')
            {
                home == '' -> home = '/tmp'
            }
            dir = home - '/.cache/nouv'
        }
    }
}

; ═══════════════════════════════════════════════
; get-python-version — get required Python version
; Priority: UV_PYTHON env > .python-version file > tool.uv.python-version config
; ═══════════════════════════════════════════════

get-python-version = () (ver str) {
    ver = os.get-env('UV_PYTHON')
    {
        ver == '' -> {

            ; check .python-version file
            p = path {
                p: '.python-version'
            }
            exists = p.exists()
            {
                exists -> {
                    read-result = fs.read-str('.python-version')
                    read-result: {
                        ok -> raw = it

                        nil -> raw = ''

                        err -> raw = ''
                    }
                    ver = raw.trim()
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-python-install-dir — get managed Python installation directory
; Priority: UV_PYTHON_INSTALL_DIR env > default
; ═══════════════════════════════════════════════

get-python-install-dir = () (dir str) {
    dir = os.get-env('UV_PYTHON_INSTALL_DIR')
    {
        dir == '' -> {
            home = os.get-env('HOME')
            {
                home == '' -> home = '/tmp'
            }

            ; XDG data directory
            xdg = os.get-env('XDG_DATA_HOME')
            {
                xdg != '' -> dir = xdg - '/nouv/python'

                -> dir = home - '/.local/share/nouv/python'
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-tool-dir — get tool installation directory
; Priority: UV_TOOL_DIR env > default
; ═══════════════════════════════════════════════

get-tool-dir = () (dir str) {
    dir = os.get-env('UV_TOOL_DIR')
    {
        dir == '' -> {
            home = os.get-env('HOME')
            {
                home == '' -> home = '/tmp'
            }
            xdg = os.get-env('XDG_DATA_HOME')
            {
                xdg != '' -> dir = xdg - '/nouv/tools'

                -> dir = home - '/.local/share/nouv/tools'
            }
        }
    }
}

; ═══════════════════════════════════════════════
; Boolean settings from environment variables
; ═══════════════════════════════════════════════

get-no-sync = () (yes bool) {
    yes = false
    v = os.get-env('UV_NO_SYNC')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

get-frozen = () (yes bool) {
    yes = false
    v = os.get-env('UV_FROZEN')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

get-locked = () (yes bool) {
    yes = false
    v = os.get-env('UV_LOCKED')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

get-no-cache = () (yes bool) {
    yes = false
    v = os.get-env('UV_NO_CACHE')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

get-reinstall = () (yes bool) {
    yes = false
    v = os.get-env('UV_REINSTALL')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

; ═══════════════════════════════════════════════
; Link mode — how packages are linked into venv
; Priority: UV_LINK_MODE env > default
; ═══════════════════════════════════════════════

get-link-mode = () (mode str) {
    mode = os.get-env('UV_LINK_MODE')
    {
        mode == '' -> mode = DEFAULT-LINK-MODE
    }
}

; ═══════════════════════════════════════════════
; Concurrent downloads
; ═══════════════════════════════════════════════

get-concurrent-downloads = () (n i64) {
    n = DEFAULT-CONCURRENT-DOWNLOADS
    v = os.get-env('UV_CONCURRENT_DOWNLOADS')
    {
        v != '' -> n = utils.str-to-i64(v)
    }
    {
        n < 1 -> n = 1
    }
}

; ═══════════════════════════════════════════════
; Index strategy
; Priority: UV_INDEX_STRATEGY env > default
; ═══════════════════════════════════════════════

get-index-strategy = () (mode str) {
    mode = os.get-env('UV_INDEX_STRATEGY')
    {
        mode == '' -> mode = DEFAULT-INDEX-STRATEGY
    }
}

; ═══════════════════════════════════════════════
; Publish URL
; ═══════════════════════════════════════════════

get-publish-url = () (url str) {
    url = os.get-env('UV_PUBLISH_URL')
    {
        url == '' -> url = DEFAULT-PUBLISH-URL
    }
}

; ═══════════════════════════════════════════════
; Keyring provider
; ═══════════════════════════════════════════════

get-keyring-provider = () (mode str) {
    mode = os.get-env('UV_KEYRING_PROVIDER')
    {
        mode == '' -> mode = 'disabled'
    }
}

; ═══════════════════════════════════════════════
; Config file path
; Priority: UV_CONFIG_FILE env > default
; ═══════════════════════════════════════════════

get-config-file = () (path str) {
    path = os.get-env('UV_CONFIG_FILE')
    {
        path == '' -> {

            ; check for local config
            p = path {
                p: '.nouv-config.toml'
            }
            exists = p.exists()
            {
                exists -> path = '.nouv-config.toml'

                -> path = ''
            }
        }
    }
}

; ═══════════════════════════════════════════════
; load-config-file — load the uv config file
; returns: parsed config (flat key=value), ok bool
; ═══════════════════════════════════════════════

load-config-file = () (cfg ?str) {
    cfg = nil
    cfg-path = get-config-file()
    {
        cfg-path == '' -> return

        -> {
            p = path {
                p: cfg-path
            }
            exists = p.exists()
            {
                ! exists -> return

                -> {
                    read-result = fs.read-str(cfg-path)
                    read-result: {
                        ok -> raw = it

                        nil -> raw = ''

                        err -> raw = ''
                    }
                    cfg = ptoml.parse(raw)
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-index-auth — get authentication for an index URL
; Checks UV_INDEX_USERNAME/PASSWORD and netrc
; ═══════════════════════════════════════════════

get-index-auth = (url str) (user str, pass str) {
    user = os.get-env('UV_INDEX_USERNAME')
    pass = os.get-env('UV_INDEX_PASSWORD')
    {
        user == '' -> user = os.get-env('PIP_USER')
    }
    {
        pass == '' -> pass = os.get-env('PIP_PASSWORD')
    }

    ; try netrc if no env vars
    {
        user == '' -> {
            netrc-user, netrc-pass = parse-netrc(url)
            user = netrc-user
            pass = netrc-pass
        }
    }
}

; ═══════════════════════════════════════════════
; parse-netrc — parse .netrc for credentials
; ═══════════════════════════════════════════════

parse-netrc = (url str) (user str, pass str) {
    user = ''
    pass = ''
    home = os.get-env('HOME')
    {
        home == '' -> return

        -> {
            netrc-path = home - '/.netrc'
            p = path {
                p: netrc-path
            }
            exists = p.exists()
            {
                ! exists -> {

                    ; try _netrc on Windows
                    netrc-path = home - '/_netrc'
                    p2 = path {
                        p: netrc-path
                    }
                    e2 = p2.exists()
                    {
                        ! e2 -> return
                    }
                }

                -> {

                    ; extract hostname from URL
                    host = extract-host(url)

                    ; parse netrc: machine <host> login <user> password <pass>
                    read-result = fs.read-str(netrc-path)
                    read-result: {
                        ok -> raw = it

                        nil -> raw = ''

                        err -> raw = ''
                    }
                    lines []str = raw.split('\n')
                    nl = lines.len()
                    i = 0
                    found-machine = false
                    (i < nl) {
                        line = lines[i]

                        #{overflow=wrap}
                        i = i + 1
                        tokens = line.split(' ')
                        tn = tokens.len()
                        j = 0
                        (j < tn) {
                            tok = tokens[j]
                            tok = tok.trim()

                            #{overflow=wrap}
                            j = j + 1
                            {
                                tok == 'machine' -> {
                                    j < tn -> {
                                        h = tokens[j].trim()
                                        {
                                            h == host -> found-machine = true
                                        }
                                    }
                                }

                                found-machine -> {
                                    tok == 'login' -> {
                                        j < tn -> user = tokens[j].trim()
                                    }

                                    tok == 'password' -> {
                                        j < tn -> pass = tokens[j].trim()
                                    }
                                }
                            }
                        }
                        {
                            found-machine -> {
                                user != '' -> {
                                    pass != '' -> break
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; extract-host — extract hostname from a URL
; ═══════════════════════════════════════════════

extract-host = (url str) (host str) {
    host = url

    ; remove protocol
    {
        host.starts-with('https://') -> host = host.slice(8, host.len-bytes())

        host.starts-with('http://') -> host = host.slice(7, host.len-bytes())
    }

    ; remove path
    slash = host.index('/')
    {
        slash >= 0 -> host = host.slice(0, slash)
    }
}

; ═══════════════════════════════════════════════
; get-project-config-value — get a value from [tool.uv] section
; ═══════════════════════════════════════════════

get-project-config-value = (cfg str, key str) (val ?str) {
    val = nil
    full-key = 'tool.uv.' - key
    val = get-value(cfg, full-key)
}

; ═══════════════════════════════════════════════
; get-quiet — check if quiet mode is enabled
; ═══════════════════════════════════════════════

get-quiet = () (yes bool) {
    yes = false
    v = os.get-env('UV_QUIET')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

; ═══════════════════════════════════════════════
; get-verbose — get verbosity level
; ═══════════════════════════════════════════════

get-verbose = () (level i64) {
    level = 0
    v = os.get-env('UV_VERBOSE')
    {
        v == '1' -> level = 1

        v == '2' -> level = 2

        v == '-1' -> level = -1
    }
}

; ═══════════════════════════════════════════════
; get-color — check if color output is enabled
; ═══════════════════════════════════════════════

get-color = () (yes bool) {
    yes = true
    v = os.get-env('UV_NO_COLOR')
    {
        v == '1' -> yes = false

        v == 'true' -> yes = false
    }
    v2 = os.get-env('NO_COLOR')
    {
        v2 == '1' -> yes = false

        v2 == 'true' -> yes = false
    }
}

; ═══════════════════════════════════════════════
; get-native-tls — check if native TLS is used
; ═══════════════════════════════════════════════

get-native-tls = () (yes bool) {
    yes = false
    v = os.get-env('UV_NATIVE_TLS')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

; ═══════════════════════════════════════════════
; get-preview — check if preview features are enabled
; ═══════════════════════════════════════════════

get-preview = () (yes bool) {
    yes = false
    v = os.get-env('UV_PREVIEW')
    {
        v == '1' -> yes = true

        v == 'true' -> yes = true
    }
}

; ═══════════════════════════════════════════════
; apply-global-flags — lift command-line global options into the environment
;
; Scans every argv token and mirrors the documented global options (README
; "全局选项") onto their UV_* env equivalents, so the existing env-based
; getters (get-frozen, get-no-cache, registry.get-index-url, ...) honour
; command-line flags without each call site carrying its own parser. Both the
; boolean forms (--flag / -f) and the value forms (--opt VALUE / --opt=VALUE)
; are recognised at any position; command-line values overwrite the env.
; ═══════════════════════════════════════════════

apply-global-flags = () {
    n = os.args()
    i = 1
    (i < n) {
        a = os.arg(i)

        a == '--quiet' || a == '-q' -> os.set-env('UV_QUIET', '1')
        a == '--verbose' || a == '-v' -> os.set-env('UV_VERBOSE', '1')
        a == '--no-cache' -> os.set-env('UV_NO_CACHE', '1')
        a == '--no-sync' -> os.set-env('UV_NO_SYNC', '1')
        a == '--frozen' -> os.set-env('UV_FROZEN', '1')
        a == '--locked' -> os.set-env('UV_LOCKED', '1')
        a == '--no-color' -> os.set-env('UV_NO_COLOR', '1')
        a == '--native-tls' -> os.set-env('UV_NATIVE_TLS', '1')
        a == '--preview' -> os.set-env('UV_PREVIEW', '1')

        ; --index-url VALUE | --index-url=VALUE
        {
            a.starts-with('--index-url=') -> os.set-env('UV_INDEX_URL', a.slice(12, a.len()))

            a == '--index-url' -> {
                k = i + 1
                k < n && ! os.arg(k).starts-with('-') -> {
                    os.set-env('UV_INDEX_URL', os.arg(k))

                    #{overflow=wrap}
                    i = i + 1
                }
            }
        }

        ; --extra-index-url VALUE | --extra-index-url=VALUE
        {
            a.starts-with('--extra-index-url=') -> os.set-env('UV_EXTRA_INDEX_URL', a.slice(18, a.len()))

            a == '--extra-index-url' -> {
                k = i + 1
                k < n && ! os.arg(k).starts-with('-') -> {
                    os.set-env('UV_EXTRA_INDEX_URL', os.arg(k))

                    #{overflow=wrap}
                    i = i + 1
                }
            }
        }

        ; --python VALUE | --python=VALUE
        {
            a.starts-with('--python=') -> os.set-env('UV_PYTHON', a.slice(9, a.len()))

            a == '--python' -> {
                k = i + 1
                k < n && ! os.arg(k).starts-with('-') -> {
                    os.set-env('UV_PYTHON', os.arg(k))

                    #{overflow=wrap}
                    i = i + 1
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }
}
