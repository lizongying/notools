; utils.no — utility functions for nouV
;
; Provides helpers that work around Nolang limitations.
; Uses fs.read-str/fs.read-bytes for reading and fs.open-write + fs.write for writing.

; ═══════════════════════════════════════════════
; run-cmd — execute a shell command, return exit code
; ═══════════════════════════════════════════════

run-cmd = (cmd str) (code i64) {
    code = process.process-system(cmd)
}

; ═══════════════════════════════════════════════
; run-cmd-output — execute command, return stdout via temp file
; ═══════════════════════════════════════════════

run-cmd-output = (cmd str) (out str) {
    out = ''
    tmp = '/tmp/nouv-out-' - os.now-ms().to-str()
    full-cmd = cmd - ' > ' - tmp - ' 2>/dev/null'
    process.process-system(full-cmd)
    read-result = fs.read-str(tmp)
    read-result: {
        ok -> out = it

        nil -> out = ''

        err -> out = ''
    }
    fs.remove(tmp)
}

; ═══════════════════════════════════════════════
; read-file — read entire file content
; ═══════════════════════════════════════════════

read-file = (path str) (content str) {
    read-result = fs.read-str(path)
    read-result: {
        ok -> content = it

        nil -> content = ''

        err -> content = ''
    }
}

; ═══════════════════════════════════════════════
; chmod — make file executable
; ═══════════════════════════════════════════════

chmod = (path str, mode str) {
    process.process-system('chmod ' - mode - ' ' - path)
}

; ═══════════════════════════════════════════════
; rm-rf — remove directory recursively (pure Nolang; see remove-tree)
; ═══════════════════════════════════════════════

rm-rf = (path str) {
    ok = utils.remove-tree(path)
}

; ═══════════════════════════════════════════════
; mkdir-p — create directory recursively (pure Nolang, no external `mkdir`)
;
; Walks each path prefix and creates every missing component via os.mkdir.
; Idempotent: returns true when the target already exists as a directory.
; Handles both absolute ('/a/b') and relative ('demo/src') paths, and the
; '.' base used by `nouv init .`.
; ═══════════════════════════════════════════════

mkdir-p = (dir str) (ok bool) {
    ok = false
    dir == '' -> {
        return
    }
    fs.is-dir(dir) -> {
        ok = true
        return
    }
    parts = dir.split('/')
    n = parts.len()
    abs = parts[0] == ''
    acc = ''
    i = 0
    (i < n) {

        #{index-out=0}
        seg = parts[i]

        #{overflow=wrap}
        i = i + 1
        seg.len() > 0 -> {
            acc == '' -> {
                abs -> acc = '/' - seg

                -> acc = seg
            }

            -> acc = acc - '/' - seg
            ! fs.is-dir(acc) -> {
                made = os.mkdir(acc, 511)
            }
        }
    }
    ok = fs.is-dir(dir)
}

; ═══════════════════════════════════════════════
; pure-Nolang filesystem helpers (replace external find/ls/wc/rm)
;
; These avoid shelling out to Unix-only commands (find, ls, wc, rm, du),
; which both breaks portability (no such tools on Windows) and injects the
; path into a shell string (spaces/metacharacters corrupt the command).
; All traversal uses fs.dir-entries/fs.walk, which filter '.'/'..' so a
; recursive delete can never escape upward through the parent link.
; ═══════════════════════════════════════════════

; join-path — join dir and entry name with exactly one separator
join-path = (dir str, name str) (out str) {
    out = dir
    {
        dir.ends-with('/') -> out = dir - name

        -> out = dir - '/' - name
    }
}

; list-files — all regular file paths under dir (recursive). Replaces `find dir -type f`.
list-files = (dir str) (paths []str) {
    paths = fs.walk(dir)
}

; find-by-suffix — file paths under dir whose full path ends with suffix (e.g. '.whl')
find-by-suffix = (dir str, suffix str) (paths []str) {
    all = fs.walk(dir)
    n = all.len()
    i = 0
    (i < n) {

        #{index-out=0}
        p = all[i]

        #{overflow=wrap}
        i = i + 1
        p.ends-with(suffix) -> paths.push(p)
    }
}

; count-by-suffix — number of files under dir ending with suffix. Replaces `find ... | wc -l`.
count-by-suffix = (dir str, suffix str) (c i64) {
    m = utils.find-by-suffix(dir, suffix)
    c = m.len()
}

; remove-files-by-suffix — delete matching files, return count removed. Replaces `find -name X -delete`.
remove-files-by-suffix = (dir str, suffix str) (n i64) {
    n = 0
    victims = utils.find-by-suffix(dir, suffix)
    k = victims.len()
    i = 0
    (i < k) {

        #{index-out=0}
        f = victims[i]

        #{overflow=wrap}
        i = i + 1
        gone = fs.remove(f)
        gone -> {

            #{overflow=wrap}
            n = n + 1
        }
    }
}

; remove-older-than — delete files under dir older than max-age-days. Replaces `find -mtime +N -delete`.
remove-older-than = (dir str, max-age-days i64) (n i64) {
    n = 0

    #{overflow=wrap}
    cutoff = os.now() - (max-age-days * 86400)
    all = fs.walk(dir)
    k = all.len()
    i = 0
    (i < k) {

        #{index-out=0}
        f = all[i]

        #{overflow=wrap}
        i = i + 1
        mt, present = os.stat-mtime(f)
        present && mt < cutoff -> {
            gone = fs.remove(f)
            gone -> {

                #{overflow=wrap}
                n = n + 1
            }
        }
    }
}

; remove-empty-dirs — recursively prune empty directories under dir (deepest first).
; Replaces `find dir -type d -empty -delete`.
remove-empty-dirs = (dir str) (removed i64) {
    removed = 0
    entries = fs.dir-entries(dir)
    k = entries.len()
    i = 0
    (i < k) {

        #{index-out=0}
        name = entries[i]

        #{overflow=wrap}
        i = i + 1
        child = utils.join-path(dir, name)
        fs.is-dir(child) -> {
            sub = utils.remove-empty-dirs(child)

            #{overflow=wrap}
            removed = removed + sub
            kids = fs.dir-entries(child)
            kids.len() == 0 -> {
                gone = fs.rmdir(child)
                gone -> {

                    #{overflow=wrap}
                    removed = removed + 1
                }
            }
        }
    }
}

; remove-tree — recursively delete everything under dir, then dir itself. Replaces `rm -rf`.
remove-tree = (dir str) (ok bool) {
    ok = false
    ! fs.is-dir(dir) -> {
        ok = fs.remove(dir)
        return
    }
    files = fs.walk(dir)
    k = files.len()
    i = 0
    (i < k) {

        #{index-out=0}
        f = files[i]

        #{overflow=wrap}
        i = i + 1
        gone = fs.remove(f)
    }
    utils.remove-empty-dirs(dir)
    left = fs.dir-entries(dir)
    {
        left.len() == 0 -> ok = fs.rmdir(dir)
    }
}

; ═══════════════════════════════════════════════
; du-sk — get directory size in KB
; ═══════════════════════════════════════════════

du-sk = (path str) (size-kb i64) {
    size-kb = 0
    total = 0
    files = fs.walk(path)
    n = files.len()
    i = 0
    (i < n) {

        #{index-out=0}
        f = files[i]

        #{overflow=wrap}
        i = i + 1
        sz-opt = fs.stat-size(f)
        sz-opt: {
            ok -> {

                #{overflow=wrap}
                total = total + it
            }

            nil -> {
            }

            err -> {
            }
        }
    }
    #{overflow=wrap}
    size-kb = total / 1024
}

; ═══════════════════════════════════════════════
; count-files — count files in directory
; ═══════════════════════════════════════════════

count-files = (path str) (count i64) {
    paths = fs.walk(path)
    count = paths.len()
}

; ═══════════════════════════════════════════════
; ls — list directory contents (pure Nolang; newline-separated entry names)
; ═══════════════════════════════════════════════

ls = (path str) (out str) {
    out = ''
    names = fs.dir-entries(path)
    n = names.len()
    i = 0
    (i < n) {

        #{index-out=0}
        nm = names[i]

        #{overflow=wrap}
        i = i + 1
        out = out - nm - '\n'
    }
}

; ═══════════════════════════════════════════════
; find-names — find files matching pattern, return list
; ═══════════════════════════════════════════════

find-names = (path str, pattern str) (out str) {
    out = ''

    ; support a simple leading-star glob (e.g. '*.py' => suffix match); pure fs walk
    suffix = pattern
    suffix.starts-with('*') -> suffix = pattern.slice(1, pattern.len())
    all = fs.walk(path)
    n = all.len()
    i = 0
    (i < n) {

        #{index-out=0}
        f = all[i]

        #{overflow=wrap}
        i = i + 1
        f.ends-with(suffix) -> {
            out = out - f - '\n'
        }
    }
}

; ═══════════════════════════════════════════════
; trim-str — trim whitespace from string (wrapper to avoid compiler bug)
; ═══════════════════════════════════════════════

trim-str = (s str) (out str) {

    ; `s.trim()` on a parameter yields a slice whose recorded length is 0,
    ; so force a copy to rebuild a well-formed string value
    out = s.trim() - ''
}

; ═══════════════════════════════════════════════
; split-str — split string by separator (wrapper to avoid compiler bug)
; ═══════════════════════════════════════════════

split-str = (s str, sep str) (out []str) {
    out = s.split(sep)
}

; ═══════════════════════════════════════════════
; starts-with-str — check if string starts with prefix (wrapper)
; ═══════════════════════════════════════════════

starts-with-str = (s str, prefix str) (yes bool) {
    yes = s.starts-with(prefix)
}

; ═══════════════════════════════════════════════
; ends-with-str — check if string ends with suffix (wrapper)
; ═══════════════════════════════════════════════

ends-with-str = (s str, suffix str) (yes bool) {
    yes = s.ends-with(suffix)
}

; ═══════════════════════════════════════════════
; contains-str — check if string contains substring (wrapper)
; ═══════════════════════════════════════════════

contains-str = (s str, sub str) (yes bool) {
    yes = s.contains(sub)
}

; ═══════════════════════════════════════════════
; index-str — find index of substring (wrapper)
; ═══════════════════════════════════════════════

index-str = (s str, sub str) (idx i64) {
    idx = s.index(sub)
}

; ═══════════════════════════════════════════════
; index-from-str — find index of substring from position (wrapper)
; ═══════════════════════════════════════════════

index-from-str = (s str, sub str, from i64) (idx i64) {
    idx = s.index-from(sub, from)
}

; ═══════════════════════════════════════════════
; slice-str — extract substring by start and end (wrapper)
; ═══════════════════════════════════════════════

slice-str = (s str, start i64, end i64) (out str) {
    out = s.slice(start, end)
}

; ═══════════════════════════════════════════════
; rindex-str — find last index of substring (wrapper)
; ═══════════════════════════════════════════════

rindex-str = (s str, sub str) (idx i64) {
    idx = s.rindex(sub)
}

; ═══════════════════════════════════════════════
; to-lower-str — convert string to lowercase (wrapper)
; ═══════════════════════════════════════════════

to-lower-str = (s str) (out str) {
    out = s.to-lower()
}

; ═══════════════════════════════════════════════
; replace-char-str — replace character in string (wrapper)
; ═══════════════════════════════════════════════

replace-char-str = (s str, old char, new char) (out str) {
    out = s.replace-char(old, new)
}

; ═══════════════════════════════════════════════
; extract-zip — extract a zip/wheel file to a directory (pure Nolang)
; Uses custom unzip-arch struct to avoid slice ownership bugs.
; ═══════════════════════════════════════════════

; custom zip archive struct (avoids std zip cross-module issues)
nz-arch {
    data []byte
}

nz-arch.read-u32le = (off i64) (v i64) {

    #{overflow=wrap}
    off1 = off + 1

    #{overflow=wrap}
    off2 = off + 2

    #{overflow=wrap}
    off3 = off + 3
    b0 = .data[off] & 255
    b1 = .data[off1] & 255
    b2 = .data[off2] & 255
    b3 = .data[off3] & 255
    v = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

nz-arch.read-u16le = (off i64) (v i64) {

    #{overflow=wrap}
    off1 = off + 1
    b0 = .data[off] & 255
    b1 = .data[off1] & 255
    v = b0 | (b1 << 8)
}

nz-arch.find-eocd = () (off i64) {
    off = -1
    n = len(.data)
    n < 22 -> return

    #{overflow=wrap}
    i = n - 22
    (i >= 0) {
        b0 = .data[i] & 255

        #{overflow=wrap}
        b1 = .data[i + 1] & 255

        #{overflow=wrap}
        b2 = .data[i + 2] & 255

        #{overflow=wrap}
        b3 = .data[i + 3] & 255
        sig = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        {
            sig == 101010256 -> {
                off = i
                return
            }
        }

        #{overflow=wrap}
        i = i - 1
    }
}

nz-arch.entry-offset = (idx i64) (off i64) {
    off = 0
    eocd = .find-eocd()
    eocd < 0 -> return

    #{overflow=wrap}
    off = .read-u32le(eocd + 16)
    j <- [0..idx): {

        #{overflow=wrap}
        name-len = .read-u16le(off + 28)

        #{overflow=wrap}
        extra-len = .read-u16le(off + 30)

        #{overflow=wrap}
        comment-len = .read-u16le(off + 32)

        #{overflow=wrap}
        off = off + 46 + name-len + extra-len + comment-len
    }
}

nz-arch.read-name = (idx i64) (name str) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    name-len = .read-u16le(off + 28)
    name = ''
    j <- [0..name-len): {

        #{overflow=wrap}
        jc char = .data[off + 46 + j] & 255
        name = name - jc.to-str()
    }
}

nz-arch.read-size = (idx i64) (sz i64) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    sz = .read-u32le(off + 24)
}

nz-arch.read-method = (idx i64) (method i64) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    method = .read-u16le(off + 10)
}

nz-arch.total = () (total i64) {
    total = 0
    eocd = .find-eocd()
    eocd < 0 -> return

    #{overflow=wrap}
    total = .read-u16le(eocd + 8)
}

nz-arch.extract-stored = (idx i64) (out []byte) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    sz = .read-u32le(off + 24)

    #{overflow=wrap}
    local-off = .read-u32le(off + 42)

    #{overflow=wrap}
    name-len2 = .read-u16le(local-off + 26)

    #{overflow=wrap}
    extra-len2 = .read-u16le(local-off + 28)

    #{overflow=wrap}
    data-off = local-off + 30 + name-len2 + extra-len2
    out = with-len(sz)
    i <- [0..sz): {

        #{overflow=wrap}
        out[i] = .data[data-off + i]
    }
}

nz-arch.extract-deflate = (idx i64) (out []byte) {
    off = .entry-offset(idx)

    #{overflow=wrap}
    sz = .read-u32le(off + 24)

    #{overflow=wrap}
    csz = .read-u32le(off + 20)

    #{overflow=wrap}
    local-off = .read-u32le(off + 42)

    #{overflow=wrap}
    name-len2 = .read-u16le(local-off + 26)

    #{overflow=wrap}
    extra-len2 = .read-u16le(local-off + 28)

    #{overflow=wrap}
    data-off = local-off + 30 + name-len2 + extra-len2
    compressed []byte = with-len(csz)
    i <- [0..csz): {

        #{overflow=wrap}
        compressed[i] = .data[data-off + i]
    }
    out = gzip.inflate-decompress(compressed, sz)
}

; make-parent-dirs: create parent directories for a file path
nz-make-parent-dirs = (full-path str) {
    n = full-path.len-bytes()
    i <- [1..n): {
        full-path[i] == '/' -> {
            dir = full-path.slice(0, i)
            dir.len() > 0 -> {
                ! fs.is-dir(dir) -> os.mkdir(dir, 511)
            }
        }
    }
}

extract-zip = (zip-path str, dest-dir str) (ok bool) {
    ok = false

    ; check file exists
    p = path {
        p: zip-path
    }
    zip-exists = p.exists()
    {
        ! zip-exists -> return
    }

    ; read file content as []byte
    data-result = fs.read-bytes(zip-path)
    data-result: {
        ok -> data = it

        nil -> data = []

        err -> data = []
    }

    ; create custom archive view
    archive = nz-arch {
        data: data
    }
    count = archive.total()
    {
        count == 0 -> return

        -> {

            ; ensure dest dir exists
            dp = path {
                p: dest-dir
            }
            mk = dp.make-dir()

            ; extract each entry
            i <- [0..count): {
                name = archive.read-name(i)
                method = archive.read-method(i)
                is-dir = name.ends-with('/')
                out-path = dest-dir - '/' - name

                {
                    is-dir -> {
                        dp2 = path {
                            p: out-path
                        }
                        mk2 = dp2.make-dir()
                    }

                    -> {
                        nz-make-parent-dirs(out-path)
                        {
                            method == 0 -> {
                                out = archive.extract-stored(i)
                                fs.write-file(out-path, out)
                            }

                            method == 8 -> {
                                out = archive.extract-deflate(i)
                                fs.write-file(out-path, out)
                            }
                        }
                    }
                }
            }

            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; str-to-i64 — safely convert string to i64 (returns 0 on failure)
; ═══════════════════════════════════════════════

str-to-i64 = (s str) (v i64) {
    v = 0
    opt = s.to-i64()
    opt: {
        ok -> v = it

        nil -> v = 0

        err -> v = 0
    }
}
