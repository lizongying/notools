; utils.no — utility functions for nouV
;
; Provides helpers that work around Nolang limitations.
; Uses fs.read-file (builtin) for reading and fs.open-write + fs.write for writing.

; ═══════════════════════════════════════════════
; run-cmd — execute a shell command, return exit code
; ═══════════════════════════════════════════════

run-cmd = (cmd str) (code i64) {
    code = process.process-system(cmd)
}

; ═══════════════════════════════════════════════
; run-cmd-output — execute command, return stdout via temp file
; ═══════════════════════════════════════════════

run-cmd-output = (cmd str) (out str) {
    out = ''
    tmp = '/tmp/nouv-out-' - os.now-ms().to-str()
    full-cmd = cmd - ' > ' - tmp - ' 2>/dev/null'
    process.process-system(full-cmd)
    out = fs.read-file(tmp)
    fs.remove(tmp)
}

; ═══════════════════════════════════════════════
; read-file — read entire file content
; ═══════════════════════════════════════════════

read-file = (path str) (content str) {
    content = fs.read-file(path)
}

; ═══════════════════════════════════════════════
; write-file — write string content to file
; ═══════════════════════════════════════════════

write-file = (path str, data str) (ok bool) {
    ok = false
    fd = fs.open-write(path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, data, data.len)
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; chmod — make file executable
; ═══════════════════════════════════════════════

chmod = (path str, mode str) {
    process.process-system('chmod ' - mode - ' ' - path)
}

; ═══════════════════════════════════════════════
; rm-rf — remove directory recursively
; ═══════════════════════════════════════════════

rm-rf = (path str) {
    process.process-system('rm -rf ' - path)
}

; ═══════════════════════════════════════════════
; mkdir-p — create directory recursively
; ═══════════════════════════════════════════════

mkdir-p = (path str) {
    process.process-system('mkdir -p ' - path)
}

; ═══════════════════════════════════════════════
; du-sk — get directory size in KB
; ═══════════════════════════════════════════════

du-sk = (path str) (size-kb i64) {
    size-kb = 0
    du-out = run-cmd-output('du -sk ' - path)
    {
        du-out.len > 0 -> {
            sp = du-out.index(' ')
            {
                sp > 0 -> {
                    num-str = du-out.slice(0, sp)
                    v = num-str.to-i64()
                    v: {
                        ok -> size-kb = it
                        nil -> size-kb = 0
                        err -> size-kb = 0
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; count-files — count files in directory
; ═══════════════════════════════════════════════

count-files = (path str) (count i64) {
    count = 0
    ls-out = run-cmd-output('find ' - path - ' -type f | wc -l')
    {
        ls-out.len > 0 -> {
            trimmed = ls-out.trim()
            v = trimmed.to-i64()
            v: {
                ok -> count = it
                nil -> count = 0
                err -> count = 0
            }
        }
    }
}

; ═══════════════════════════════════════════════
; ls — list directory contents
; ═══════════════════════════════════════════════

ls = (path str) (out str) {
    out = run-cmd-output('ls ' - path)
}

; ═══════════════════════════════════════════════
; find-names — find files matching pattern, return list
; ═══════════════════════════════════════════════

find-names = (path str, pattern str) (out str) {
    out = run-cmd-output('find ' - path - ' -name "' - pattern - '"')
}

; ═══════════════════════════════════════════════
; trim-str — trim whitespace from string (wrapper to avoid compiler bug)
; ═══════════════════════════════════════════════

trim-str = (s str) (out str) {
    out = s.trim()
}

; ═══════════════════════════════════════════════
; split-str — split string by separator (wrapper to avoid compiler bug)
; ═══════════════════════════════════════════════

split-str = (s str, sep str) (out []str) {
    out = s.split(sep)
}

; ═══════════════════════════════════════════════
; starts-with-str — check if string starts with prefix (wrapper)
; ═══════════════════════════════════════════════

starts-with-str = (s str, prefix str) (yes bool) {
    yes = s.starts-with(prefix)
}

; ═══════════════════════════════════════════════
; ends-with-str — check if string ends with suffix (wrapper)
; ═══════════════════════════════════════════════

ends-with-str = (s str, suffix str) (yes bool) {
    yes = s.ends-with(suffix)
}

; ═══════════════════════════════════════════════
; contains-str — check if string contains substring (wrapper)
; ═══════════════════════════════════════════════

contains-str = (s str, sub str) (yes bool) {
    yes = s.contains(sub)
}

; ═══════════════════════════════════════════════
; index-str — find index of substring (wrapper)
; ═══════════════════════════════════════════════

index-str = (s str, sub str) (idx i64) {
    idx = s.index(sub)
}

; ═══════════════════════════════════════════════
; index-from-str — find index of substring from position (wrapper)
; ═══════════════════════════════════════════════

index-from-str = (s str, sub str, from i64) (idx i64) {
    idx = s.index-from(sub, from)
}

; ═══════════════════════════════════════════════
; slice-str — extract substring by start and end (wrapper)
; ═══════════════════════════════════════════════

slice-str = (s str, start i64, end i64) (out str) {
    out = s.slice(start, end)
}

; ═══════════════════════════════════════════════
; rindex-str — find last index of substring (wrapper)
; ═══════════════════════════════════════════════

rindex-str = (s str, sub str) (idx i64) {
    idx = s.rindex(sub)
}

; ═══════════════════════════════════════════════
; to-lower-str — convert string to lowercase (wrapper)
; ═══════════════════════════════════════════════

to-lower-str = (s str) (out str) {
    out = s.to-lower()
}

; ═══════════════════════════════════════════════
; replace-char-str — replace character in string (wrapper)
; ═══════════════════════════════════════════════

replace-char-str = (s str, old i64, new i64) (out str) {
    out = s.replace-char(old, new)
}

; ═══════════════════════════════════════════════
; extract-zip — extract a zip/wheel file to a directory (pure Nolang)
; Uses custom unzip-arch struct to avoid slice ownership bugs.
; ═══════════════════════════════════════════════

; custom zip archive struct (avoids std zip cross-module issues)
nz-arch {
    data []byte
}

nz-arch.read-u32le = (off i64) (v i64) {
    off1 = off + 1
    off2 = off + 2
    off3 = off + 3
    b0 = .data[off] & 255
    b1 = .data[off1] & 255
    b2 = .data[off2] & 255
    b3 = .data[off3] & 255
    v = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

nz-arch.read-u16le = (off i64) (v i64) {
    off1 = off + 1
    b0 = .data[off] & 255
    b1 = .data[off1] & 255
    v = b0 | (b1 << 8)
}

nz-arch.find-eocd = () (off i64) {
    off = -1
    n = len(.data)
    n < 22 -> return
    i = n - 22
    {
        b0 = .data[i] & 255
        b1 = .data[i + 1] & 255
        b2 = .data[i + 2] & 255
        b3 = .data[i + 3] & 255
        sig = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        {
            sig == 101010256 -> {
                off = i
                return
            }
        }
        i = i - 1
    } (i >= 0)
}

nz-arch.entry-offset = (idx i64) (off i64) {
    off = 0
    eocd = .find-eocd()
    eocd < 0 -> return
    off = .read-u32le(eocd + 16)
    j <- [0..idx): {
        name-len = .read-u16le(off + 28)
        extra-len = .read-u16le(off + 30)
        comment-len = .read-u16le(off + 32)
        off = off + 46 + name-len + extra-len + comment-len
    }
}

nz-arch.read-name = (idx i64) (name str) {
    off = .entry-offset(idx)
    name-len = .read-u16le(off + 28)
    name = ''
    j <- [0..name-len): {
        name = name - number.char-to-str(.data[off + 46 + j] & 255)
    }
}

nz-arch.read-size = (idx i64) (sz i64) {
    off = .entry-offset(idx)
    sz = .read-u32le(off + 24)
}

nz-arch.read-method = (idx i64) (method i64) {
    off = .entry-offset(idx)
    method = .read-u16le(off + 10)
}

nz-arch.total = () (total i64) {
    total = 0
    eocd = .find-eocd()
    eocd < 0 -> return
    total = .read-u16le(eocd + 8)
}

nz-arch.extract-stored = (idx i64) (out []byte) {
    off = .entry-offset(idx)
    sz = .read-u32le(off + 24)
    local-off = .read-u32le(off + 42)
    name-len2 = .read-u16le(local-off + 26)
    extra-len2 = .read-u16le(local-off + 28)
    data-off = local-off + 30 + name-len2 + extra-len2
    out = with-len(sz)
    i <- [0..sz): {
        out[i] = .data[data-off + i]
    }
}

nz-arch.extract-deflate = (idx i64) (out []byte) {
    off = .entry-offset(idx)
    sz = .read-u32le(off + 24)
    csz = .read-u32le(off + 20)
    local-off = .read-u32le(off + 42)
    name-len2 = .read-u16le(local-off + 26)
    extra-len2 = .read-u16le(local-off + 28)
    data-off = local-off + 30 + name-len2 + extra-len2
    compressed []byte = with-len(csz)
    i <- [0..csz): {
        compressed[i] = .data[data-off + i]
    }
    out = gzip.inflate-decompress(compressed, sz)
}

; make-parent-dirs: create parent directories for a file path
nz-make-parent-dirs = (full-path str) {
    n = full-path.len
    i <- [1..n): {
        full-path[i] == '/' -> {
            dir = full-path.slice(0, i)
            dir.len > 0 -> {
                fs.is-dir(dir) == false -> os.mkdir(dir, 511)
            }
        }
    }
}

extract-zip = (zip-path str, dest-dir str) (ok bool) {
    ok = false

    ; read file content
    content = fs.read-file(zip-path)
    {
        content == '' -> return
    }

    ; convert str to []byte (avoid str.to-bytes() compiler bug)
    data []byte
    clen = content.len
    ci <- [0..clen): {
        data.push(content[ci])
    }

    ; create custom archive view
    archive = nz-arch{
        data: data,
    }
    count = archive.total()
    {
        count == 0 -> return
        -> {
            ; ensure dest dir exists
            dp = path{
                p: dest-dir,
            }
            mk = dp.make-dir()

            ; extract each entry
            i <- [0..count): {
                name = archive.read-name(i)
                method = archive.read-method(i)
                is-dir = name.ends-with('/')
                out-path = dest-dir - '/' - name

                {
                    is-dir -> {
                        dp2 = path{
                            p: out-path,
                        }
                        mk2 = dp2.make-dir()
                    }
                    -> {
                        nz-make-parent-dirs(out-path)
                        {
                            method == 0 -> {
                                out = archive.extract-stored(i)
                                fs.write-file(out-path, out)
                            }
                            method == 8 -> {
                                out = archive.extract-deflate(i)
                                fs.write-file(out-path, out)
                            }
                        }
                    }
                }
            }

            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; str-to-i64 — safely convert string to i64 (returns 0 on failure)
; ═══════════════════════════════════════════════

str-to-i64 = (s str) (v i64) {
    v = 0
    opt = s.to-i64()
    opt: {
        ok -> v = it
        nil -> v = 0
        err -> v = 0
    }
}
