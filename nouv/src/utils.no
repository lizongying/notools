; utils.no — utility functions for nouV
;
; Provides helpers that work around Nolang limitations.
; Uses fs.read-file (builtin) for reading and fs.open-write + fs.write for writing.

; ═══════════════════════════════════════════════
; run-cmd — execute a shell command, return exit code
; ═══════════════════════════════════════════════

run-cmd = (cmd str) (code i64) {
    code = process.process-system(cmd)
}

; ═══════════════════════════════════════════════
; run-cmd-output — execute command, return stdout via temp file
; ═══════════════════════════════════════════════

run-cmd-output = (cmd str) (out str) {
    out = ''
    tmp = '/tmp/nouv-out-' - os.now-ms().to-str()
    full-cmd = cmd - ' > ' - tmp - ' 2>/dev/null'
    process.process-system(full-cmd)
    out = fs.read-file(tmp)
    fs.remove(tmp)
}

; ═══════════════════════════════════════════════
; read-file — read entire file content
; ═══════════════════════════════════════════════

read-file = (path str) (content str) {
    content = fs.read-file(path)
}

; ═══════════════════════════════════════════════
; write-file — write string content to file
; ═══════════════════════════════════════════════

write-file = (path str, data str) (ok bool) {
    ok = false
    fd = fs.open-write(path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, data, data.len)
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; chmod — make file executable
; ═══════════════════════════════════════════════

chmod = (path str, mode str) {
    process.process-system('chmod ' - mode - ' ' - path)
}

; ═══════════════════════════════════════════════
; rm-rf — remove directory recursively
; ═══════════════════════════════════════════════

rm-rf = (path str) {
    process.process-system('rm -rf ' - path)
}

; ═══════════════════════════════════════════════
; mkdir-p — create directory recursively
; ═══════════════════════════════════════════════

mkdir-p = (path str) {
    process.process-system('mkdir -p ' - path)
}

; ═══════════════════════════════════════════════
; du-sk — get directory size in KB
; ═══════════════════════════════════════════════

du-sk = (path str) (size-kb i64) {
    size-kb = 0
    du-out = run-cmd-output('du -sk ' - path)
    {
        du-out.len > 0 -> {
            sp = du-out.index(' ')
            {
                sp > 0 -> {
                    num-str = du-out.slice(0, sp)
                    v = num-str.to-i64()
                    v: {
                        ok -> size-kb = it
                        nil -> size-kb = 0
                        err -> size-kb = 0
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; count-files — count files in directory
; ═══════════════════════════════════════════════

count-files = (path str) (count i64) {
    count = 0
    ls-out = run-cmd-output('find ' - path - ' -type f | wc -l')
    {
        ls-out.len > 0 -> {
            trimmed = ls-out.trim()
            v = trimmed.to-i64()
            v: {
                ok -> count = it
                nil -> count = 0
                err -> count = 0
            }
        }
    }
}

; ═══════════════════════════════════════════════
; ls — list directory contents
; ═══════════════════════════════════════════════

ls = (path str) (out str) {
    out = run-cmd-output('ls ' - path)
}

; ═══════════════════════════════════════════════
; find-names — find files matching pattern, return list
; ═══════════════════════════════════════════════

find-names = (path str, pattern str) (out str) {
    out = run-cmd-output('find ' - path - ' -name "' - pattern - '"')
}

; ═══════════════════════════════════════════════
; trim-str — trim whitespace from string (wrapper to avoid compiler bug)
; ═══════════════════════════════════════════════

trim-str = (s str) (out str) {
    out = s.trim()
}

; ═══════════════════════════════════════════════
; split-str — split string by separator (wrapper to avoid compiler bug)
; ═══════════════════════════════════════════════

split-str = (s str, sep str) (out []str) {
    out = s.split(sep)
}

; ═══════════════════════════════════════════════
; starts-with-str — check if string starts with prefix (wrapper)
; ═══════════════════════════════════════════════

starts-with-str = (s str, prefix str) (yes bool) {
    yes = s.starts-with(prefix)
}

; ═══════════════════════════════════════════════
; ends-with-str — check if string ends with suffix (wrapper)
; ═══════════════════════════════════════════════

ends-with-str = (s str, suffix str) (yes bool) {
    yes = s.ends-with(suffix)
}

; ═══════════════════════════════════════════════
; contains-str — check if string contains substring (wrapper)
; ═══════════════════════════════════════════════

contains-str = (s str, sub str) (yes bool) {
    yes = s.contains(sub)
}

; ═══════════════════════════════════════════════
; index-str — find index of substring (wrapper)
; ═══════════════════════════════════════════════

index-str = (s str, sub str) (idx i64) {
    idx = s.index(sub)
}

; ═══════════════════════════════════════════════
; index-from-str — find index of substring from position (wrapper)
; ═══════════════════════════════════════════════

index-from-str = (s str, sub str, from i64) (idx i64) {
    idx = s.index-from(sub, from)
}

; ═══════════════════════════════════════════════
; slice-str — extract substring by start and end (wrapper)
; ═══════════════════════════════════════════════

slice-str = (s str, start i64, end i64) (out str) {
    out = s.slice(start, end)
}

; ═══════════════════════════════════════════════
; rindex-str — find last index of substring (wrapper)
; ═══════════════════════════════════════════════

rindex-str = (s str, sub str) (idx i64) {
    idx = s.rindex(sub)
}

; ═══════════════════════════════════════════════
; to-lower-str — convert string to lowercase (wrapper)
; ═══════════════════════════════════════════════

to-lower-str = (s str) (out str) {
    out = s.to-lower()
}

; ═══════════════════════════════════════════════
; replace-char-str — replace character in string (wrapper)
; ═══════════════════════════════════════════════

replace-char-str = (s str, old i64, new i64) (out str) {
    out = s.replace-char(old, new)
}

; ═══════════════════════════════════════════════
; str-to-i64 — safely convert string to i64 (returns 0 on failure)
; ═══════════════════════════════════════════════

str-to-i64 = (s str) (v i64) {
    v = 0
    opt = s.to-i64()
    opt: {
        ok -> v = it
        nil -> v = 0
        err -> v = 0
    }
}
