; tool.no — tool management (uvx/pipx compatible)
;
; Runs and installs command-line tools provided by Python packages.
; Each tool gets its own isolated environment.
;
; API:
;   run-tool(cmd str) (ok bool) — run a tool in ephemeral environment
;   install-tool(pkg str) (ok bool) — install a tool
;   list-tools() (list str) — list installed tools
;   upgrade-tool(pkg str) (ok bool) — upgrade a tool
;   uninstall-tool(pkg str) (ok bool) — uninstall a tool
;   get-tool-dir() (dir str) — get tool installation directory
;   get-tool-venv(tool-name str) (venv-path str) — get tool's venv

# /nouv/src/venv
# /nouv/src/installer
# /nouv/src/registry
# /nouv/src/utils

TOOL-BASE = '.local/share/nouv/tools'

is-tool-file = (line str) (yes bool) {
    yes = true
    {
        line == 'python' -> {
            yes = false
            return
        }
    }
    {
        line == 'python3' -> {
            yes = false
            return
        }
    }
    {
        line == 'pip' -> {
            yes = false
            return
        }
    }
    {
        line == 'pip3' -> {
            yes = false
            return
        }
    }
    {
        line == 'activate' -> {
            yes = false
            return
        }
    }
    {
        line == 'Activate.ps1' -> {
            yes = false
            return
        }
    }
    {
        line.starts-with('python') -> {
            yes = false
            return
        }
    }
    {
        line.starts-with('pip') -> {
            yes = false
            return
        }
    }
}

; ═══════════════════════════════════════════════
; run-tool — run a tool in an ephemeral environment
;
; Similar to uvx/pipx run. Creates a temporary venv,
; installs the tool, runs it, then cleans up.
; ═══════════════════════════════════════════════

run-tool = (cmd str) (ok bool) {
    ok = false

    ; parse command: first token is the package, rest are args
    space-pos = cmd.index(' ')
    pkg = cmd
    args = ''
    {
        space-pos >= 0 -> {
            pkg = cmd.slice(0, space-pos)

            #{overflow=wrap}
            args = cmd.slice(space-pos + 1, cmd.len-bytes())
        }
    }
    pkg = pkg.trim()
    args = args.trim()

    ; check if tool is already installed
    tool-venv = get-tool-venv(pkg)
    p = path {
        p: tool-venv
    }
    installed = p.exists()

    {
        installed -> {

            ; run from existing venv
            bin-dir = get-bin(tool-venv)

            ep-path = bin-dir - '/' - pkg
            p2 = path {
                p: ep-path
            }
            ep-exists = p2.exists()
            {
                ep-exists -> {
                    full-cmd = ep-path
                    {
                        args != '' -> full-cmd = full-cmd - ' ' - args
                    }
                    code = run-cmd('"' - full-cmd - '"')
                    {
                        code == 0 -> ok = true
                    }
                    return
                }
            }
        }
    }

    ; create ephemeral environment
    tmp-id = os.now-ms()
    tmp-venv = '/tmp/nouv-tool-' - tmp-id.to-str()
    py-path = ''
    py-ok = false
    py-path-opt = find-python('')
    py-path-opt: {
        ok -> {
            py-path = it
            py-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! py-ok -> {
            print('error: no Python installation found')
            return
        }
    }

    print('Resolved 1 package')
    venv-ok = create-venv(tmp-venv, py-path)
    {
        ! venv-ok -> return

        -> {

            ; install the package
            inst-ok = installer.pip-install(tmp-venv, pkg)
            {
                ! inst-ok -> {
                    print('error: failed to install {pkg}')
                    return
                }

                -> {
                    print('Installed {pkg}')

                    ; find entry point
                    bin-dir = get-bin(tmp-venv)
                    out = run-cmd-output('ls' - ' ' - bin-dir)
                    lines = out.split('\n')
                    n2 = lines.len()
                    ep-name = ''
                    i = 0
                    line = lines[i]

                    #{overflow=wrap}
                    i = i + 1
                    line = line.trim()
                    is-tool = is-tool-file(line)
                    is-tool -> {}
                    {
                        ! line.starts-with('python') -> {
                            ! line.starts-with('pip') -> {}
                            ep-name = line
                            break
                        }
                    }
                }
            }
        }
        (i < n2)

        {
            ep-name == '' -> ep-name = pkg
        }

        ; run the tool
        ep-path = bin-dir - '/' - ep-name
        code = run-cmd(ep-path - ' ' - args)

        ; clean up
        remove-venv(tmp-venv)
    }
}

; ═══════════════════════════════════════════════
; install-tool — install a tool permanently
; ═══════════════════════════════════════════════

install-tool = (pkg str) (ok bool) {
    ok = false

    tool-dir = get-tool-dir()
    p = path {
        p: tool-dir
    }
    mk = p.make-dir()

    tool-venv = get-tool-venv(pkg)

    ; check if already installed
    p2 = path {
        p: tool-venv
    }
    exists = p2.exists()
    {
        exists -> {
            print('{pkg} is already installed')
            return
        }
    }

    ; create venv
    py-path = ''
    py-ok = false
    py-path-opt2 = find-python('')
    py-path-opt2: {
        ok -> {
            py-path = it
            py-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! py-ok -> {
            print('error: no Python installation found')
            return
        }
    }

    venv-ok = create-venv(tool-venv, py-path)
    {
        ! venv-ok -> return

        -> {

            ; install the package
            inst-ok = installer.pip-install(tool-venv, pkg)
            {
                ! inst-ok -> return

                -> {

                    ; create symlink to entry point in bin dir
                    bin-dir = get-bin(tool-venv)

                    ; find entry points
                    out = run-cmd-output('ls' - ' ' - bin-dir)
                    lines = out.split('\n')
                    n2 = lines.len()
                    i = 0
                    count = 0
                    (i < n2) {
                        line = lines[i]

                        #{overflow=wrap}
                        i = i + 1
                        line = line.trim()
                        {
                            line != 'python' -> {
                                line != 'python3' && line != 'pip' && line != 'pip3' && ! line.starts-with('python') && ! line.starts-with('pip') && line != 'activate' && line != 'Activate.ps1' -> {}

                                ep-path = bin-dir - '/' - line
                                link-path = tool-dir - '/bin/' - line
                                run-cmd('ln' - ' ' - '-sf ' - ep-path - ' ' - link-path)

                                #{overflow=wrap}
                                count = count + 1
                                print('Installed executable: {line}')
                            }
                        }
                    }

                    ok = true
                    {
                        count == 0 -> print('warning: no executables found')
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; list-tools — list installed tools
; ═══════════════════════════════════════════════

list-tools = () (list str) {
    list = ''
    tool-dir = get-tool-dir()
    p = path {
        p: tool-dir
    }
    exists = p.exists()
    {
        ! exists -> {
            list = 'No tools installed'
            return
        }

        -> {

            ; list venvs
            out = run-cmd-output('ls' - ' ' - tool-dir)
            lines = out.split('\n')
            n2 = lines.len()
            i = 0
            list = 'Installed tools:\n'
            (i < n2) {
                line = lines[i]

                #{overflow=wrap}
                i = i + 1
                line = line.trim()
                {
                    line.len() > 0 -> {
                        line != 'bin' -> {}
                        list = list - '  ' - line - '\n'
                    }
                }
            }
            {
                list == 'Installed tools:\n' -> list = 'No tools installed'
            }
        }
    }
}

; ═══════════════════════════════════════════════
; upgrade-tool — upgrade an installed tool
; ═══════════════════════════════════════════════

upgrade-tool = (pkg str) (ok bool) {
    ok = false
    tool-venv = get-tool-venv(pkg)

    p = path {
        p: tool-venv
    }
    exists = p.exists()
    {
        ! exists -> {
            print('error: tool {pkg} not installed')
            return
        }
    }

    ; upgrade by reinstalling
    inst-ok = installer.pip-install(tool-venv, pkg - ' --upgrade')
    {
        inst-ok -> {
            print('Upgraded {pkg}')
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; uninstall-tool — remove an installed tool
; ═══════════════════════════════════════════════

uninstall-tool = (pkg str) (ok bool) {
    ok = false
    tool-venv = get-tool-venv(pkg)

    p = path {
        p: tool-venv
    }
    exists = p.exists()
    {
        ! exists -> {
            print('error: tool {pkg} not installed')
            return
        }
    }

    ; remove venv
    rm-ok = remove-venv(tool-venv)

    ; remove symlinks
    tool-dir = get-tool-dir()
    bin-dir = tool-dir - '/bin'
    run-cmd('find' - ' ' - bin-dir - ' -type l -lname "*' - tool-venv - '*" -delete')

    ok = rm-ok
    {
        ok -> print('Uninstalled tool: {pkg}')
    }
}

; ═══════════════════════════════════════════════
; get-tool-dir — get tool installation directory
; ═══════════════════════════════════════════════

get-tool-dir = () (dir str) {
    home = os.get-env('HOME')
    {
        home == '' -> home = '/tmp'
    }

    dir = home - '/' - TOOL-BASE
}

; ═══════════════════════════════════════════════
; get-tool-venv — get a tool's venv path
; ═══════════════════════════════════════════════

get-tool-venv = (tool-name str) (venv-path str) {
    tool-dir = get-tool-dir()
    venv-path = tool-dir - '/' - tool-name
}

; ═══════════════════════════════════════════════
; run-tool-from — run a tool from a specific package
; Uses --from to specify the package to install,
; while running a different command.
; ═══════════════════════════════════════════════

run-tool-from = (from-pkg str, cmd-args str, with-pkgs str) (ok bool) {
    ok = false

    ; parse command: first token is the command name, rest are args
    space-pos = cmd-args.index(' ')
    cmd-name = cmd-args
    args = ''
    {
        space-pos >= 0 -> {
            cmd-name = cmd-args.slice(0, space-pos)

            #{overflow=wrap}
            args = cmd-args.slice(space-pos + 1, cmd-args.len-bytes())
        }
    }
    cmd-name = cmd-name.trim()
    args = args.trim()

    ; create ephemeral environment
    tmp-id = os.now-ms()
    tmp-venv = '/tmp/nouv-tool-' - tmp-id.to-str()
    py-path = ''
    py-ok = false
    py-path-opt3 = find-python('')
    py-path-opt3: {
        ok -> {
            py-path = it
            py-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! py-ok -> {
            print('error: no Python installation found')
            return
        }
    }

    print('Resolved 1 package')
    venv-ok = create-venv(tmp-venv, py-path)
    {
        ! venv-ok -> return

        -> {

            ; install the from-pkg
            inst-ok = installer.pip-install(tmp-venv, from-pkg)
            {
                ! inst-ok -> {
                    print('error: failed to install {from-pkg}')
                    remove-venv(tmp-venv)
                    return
                }

                -> {

                    ; install --with packages
                    {
                        with-pkgs != '' -> {
                            with-ok = installer.pip-install(tmp-venv, with-pkgs)
                            {
                                ! with-ok -> {
                                    print('warning: some --with packages failed to install')
                                }
                            }
                        }
                    }

                    ; find entry point
                    bin-dir = get-bin(tmp-venv)

                    ep-path = bin-dir - '/' - cmd-name
                    p = path {
                        p: ep-path
                    }
                    ep-exists = p.exists()

                    {
                        ep-exists -> {
                            code = run-cmd(ep-path - ' ' - args)
                        }

                        -> {

                            ; try running as module
                            py-bin = ''
                            p-ok = false
                            py-bin-opt = get-python(tmp-venv)
                            py-bin-opt: {
                                ok -> {
                                    py-bin = it
                                    p-ok = true
                                }

                                nil -> {
                                }

                                err -> {
                                }
                            }
                            {
                                p-ok -> {
                                    code = run-cmd(py-bin - ' -m ' - cmd-name - ' ' - args)
                                }
                            }
                        }
                    }

                    ; clean up
                    remove-venv(tmp-venv)
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; run-tool-with — run a tool with additional packages
; ═══════════════════════════════════════════════

run-tool-with = (cmd-args str, with-pkgs str) (ok bool) {
    ok = false

    ; parse command
    space-pos = cmd-args.index(' ')
    pkg = cmd-args
    args = ''
    {
        space-pos >= 0 -> {
            pkg = cmd-args.slice(0, space-pos)

            #{overflow=wrap}
            args = cmd-args.slice(space-pos + 1, cmd-args.len-bytes())
        }
    }
    pkg = pkg.trim()
    args = args.trim()

    ; create ephemeral environment
    tmp-id = os.now-ms()
    tmp-venv = '/tmp/nouv-tool-' - tmp-id.to-str()
    py-path = ''
    py-ok = false
    py-path-opt4 = find-python('')
    py-path-opt4: {
        ok -> {
            py-path = it
            py-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! py-ok -> {
            print('error: no Python installation found')
            return
        }
    }

    pkgs-lines = with-pkgs.split('\n')
    pkgs-count = pkgs-lines.len()

    ; NOTE: the MIR backend's string interpolation cannot resolve an expression
    ; inside a `{...}` field (e.g. `{pkgs-count + 1}`). Precompute into a
    ; separate variable and interpolate that instead.
    #{overflow=wrap}
    pkgs-total = pkgs-count + 1
    print('Resolved {pkgs-total} packages')
    venv-ok = create-venv(tmp-venv, py-path)
    {
        ! venv-ok -> return

        -> {

            ; install the main package
            inst-ok = installer.pip-install(tmp-venv, pkg)
            {
                ! inst-ok -> {
                    print('error: failed to install {pkg}')
                    remove-venv(tmp-venv)
                    return
                }

                -> {

                    ; install --with packages
                    with-ok = installer.pip-install(tmp-venv, with-pkgs)
                    {
                        ! with-ok -> {
                            print('warning: some --with packages failed to install')
                        }
                    }

                    ; find entry point
                    bin-dir = get-bin(tmp-venv)

                    ep-path = bin-dir - '/' - pkg
                    out = run-cmd-output('ls' - ' ' - bin-dir)
                    lines = out.split('\n')
                    n2 = lines.len()
                    ep-name = ''
                    i = 0
                    line = lines[i]

                    #{overflow=wrap}
                    i = i + 1
                    line = line.trim()
                    is-tool = is-tool-file(line)
                    is-tool -> {}
                    {
                        ! line.starts-with('python') -> {
                            ! line.starts-with('pip') -> {}
                            ep-name = line
                            break
                        }
                    }
                }
            }
        }
        (i < n2)
        {
            ep-name == '' -> ep-name = pkg
        }

        ; run the tool
        ep-path = bin-dir - '/' - ep-name
        code = run-cmd(ep-path - ' ' - args)

        ; clean up
        remove-venv(tmp-venv)
    }
}

; ═══════════════════════════════════════════════
; install-tool-with — install a tool with additional packages
; ═══════════════════════════════════════════════

install-tool-with = (pkg str, with-pkgs str) (ok bool) {
    ok = false

    tool-dir = get-tool-dir()
    p = path {
        p: tool-dir
    }
    mk = p.make-dir()

    tool-venv = get-tool-venv(pkg)

    ; create venv
    py-path = ''
    py-ok = false
    py-path-opt5 = find-python('')
    py-path-opt5: {
        ok -> {
            py-path = it
            py-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! py-ok -> {
            print('error: no Python installation found')
            return
        }
    }

    venv-ok = create-venv(tool-venv, py-path)
    {
        ! venv-ok -> return

        -> {

            ; install the main package
            inst-ok = installer.pip-install(tool-venv, pkg)
            {
                ! inst-ok -> return

                -> {

                    ; install --with packages
                    with-ok = installer.pip-install(tool-venv, with-pkgs)
                    {
                        ! with-ok -> {
                            print('warning: some --with packages failed to install')
                        }
                    }

                    ; create symlinks to entry points
                    bin-dir = get-bin(tool-venv)
                    out = run-cmd-output('ls' - ' ' - bin-dir)
                    lines = out.split('\n')
                    n2 = lines.len()
                    i = 0
                    count = 0
                    (i < n2) {
                        line = lines[i]

                        #{overflow=wrap}
                        i = i + 1
                        line = line.trim()
                        {
                            line != 'python' -> {
                                line != 'python3' && line != 'pip' && line != 'pip3' && ! line.starts-with('python') && ! line.starts-with('pip') && line != 'activate' && line != 'Activate.ps1' -> {}

                                ep-path = bin-dir - '/' - line
                                link-path = tool-dir - '/bin/' - line
                                run-cmd('ln' - ' ' - '-sf ' - ep-path - ' ' - link-path)

                                #{overflow=wrap}
                                count = count + 1
                                print('Installed executable: {line}')
                            }
                        }
                    }

                    ok = true
                    {
                        count == 0 -> print('warning: no executables found')
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; upgrade-all-tools — upgrade all installed tools
; ═══════════════════════════════════════════════

upgrade-all-tools = () (ok bool) {
    ok = true
    tool-dir = get-tool-dir()
    p = path {
        p: tool-dir
    }
    exists = p.exists()
    {
        ! exists -> return

        -> {

            ; list all tool venvs
            out = run-cmd-output('ls' - ' ' - tool-dir)
            lines = out.split('\n')
            n2 = lines.len()
            i = 0
            (i < n2) {
                line = lines[i]

                #{overflow=wrap}
                i = i + 1
                line = line.trim()
                {
                    line.len() > 0 -> {
                        line != 'bin' -> {}
                        print('Upgrading {line}...')
                        ug-ok = upgrade-tool(line)
                        {
                            ! ug-ok -> {
                                print('warning: failed to upgrade {line}')
                                ok = false
                            }
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; clear-all-tools — remove all installed tools
; ═══════════════════════════════════════════════

clear-all-tools = () (ok bool) {
    ok = false
    tool-dir = get-tool-dir()
    p = path {
        p: tool-dir
    }
    exists = p.exists()
    {
        ! exists -> {
            ok = true
            return
        }

        -> {
            code = run-cmd('rm' - ' ' - '-rf ' - tool-dir)
        }
    }
}
