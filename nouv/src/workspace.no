; workspace.no — workspace management
;
; Supports Cargo-style workspaces for multi-package Python projects.
; A workspace is defined by a [tool.uv.workspace] section in the root
; pyproject.toml, listing member packages.
;
; API:
;   find-root(dir str) (root ?str) — find workspace root
;   get-members(root str) (members ?str) — get member paths
;   load-all-members(root str) (configs ?str) — load all member configs
;   is-workspace-root(dir str) (yes bool) — check if dir is workspace root
;   get-member-config(root str, member str) (cfg ?str) — load member config

# /nouv/src/config
# /nouv/src/ptoml

; ═══════════════════════════════════════════════
; find-root — find workspace root by walking up directories
; ═══════════════════════════════════════════════

find-root = (dir str) (root ?str) {
    root = nil

    current = dir
    !! {
    }
    {
        {
            current == '' -> break

            current == '/' -> break

            -> {
                #{overflow=wrap}
                pyproject = current - '/pyproject.toml'
                p = path {
                    p: pyproject
                }
                exists = p.exists()
                {
                    exists -> {

                        ; check if it has [tool.uv.workspace]
                        cfg = ''
                        cfg-ok = false
                        cfg-opt = load-config(current)
                        cfg-opt: {
                            ok -> {
                                cfg = it
                                cfg-ok = true
                            }

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        {
                            cfg-ok -> {
                                members-val = get-value(cfg, 'tool.uv.workspace.members')
                                {
                                    members-val: {
                                        nil -> {
                                        }

                                        err -> {
                                        }

                                        ok -> {
                                            root = current
                                            return
                                        }

                                        -> {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                ; go up
                p2 = path {
                    p: current
                }
                p2.dir()
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-members — get workspace member paths
; returns newline-separated relative paths
; ═══════════════════════════════════════════════

get-members = (root str) (members ?str) {
    members = nil

    cfg = ''
    cfg-ok = false
    cfg-opt2 = load-config(root)
    cfg-opt2: {
        ok -> {
            cfg = it
            cfg-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! cfg-ok -> return

        -> {
            val = get-value(cfg, 'tool.uv.workspace.members')
            val: {
                nil -> {
                }

                err -> {
                }

                ok -> members = parse-array(it)

                -> {
                    ; no members defined
                }
            }
            return
        }
    }
}

; ═══════════════════════════════════════════════
; load-all-members — load all member configs
; returns newline-separated dir:cfg entries
; ═══════════════════════════════════════════════

load-all-members = (root str) (configs ?str) {
    configs-b = ''

    members = ''
    members-ok = false
    members-opt = get-members(root)
    members-opt: {
        ok -> {
            members = it
            members-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! members-ok -> return

        -> {
            lines = members.split('\n')
            n = lines.len()
            i = 0
            (i < n) {
                member = lines[i]

                #{overflow=wrap}
                i = i + 1
                member = member.trim()
                {
                    member.len() > 0 -> {
                        #{overflow=wrap}
                        member-dir = root - '/' - member
                        cfg = ''
                        cfg-ok = false
                        cfg-opt3 = load-config(member-dir)
                        cfg-opt3: {
                            ok -> {
                                cfg = it
                                cfg-ok = true
                            }

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        {
                            cfg-ok -> {
                                #{overflow=wrap}
                                configs-b = configs-b - member-dir - '\n' - cfg - '\n---\n'
                            }
                        }
                    }
                }
            }
            configs = configs-b
        }
    }
}

; ═══════════════════════════════════════════════
; is-workspace-root — check if directory is a workspace root
; ═══════════════════════════════════════════════

is-workspace-root = (dir str) (yes bool) {
    yes = false
    cfg = ''
    ok = false
    cfg-opt4 = load-config(dir)
    cfg-opt4: {
        ok -> {
            cfg = it
            ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ok -> {
            val = get-value(cfg, 'tool.uv.workspace.members')
            val: {
                nil -> {
                }

                err -> {
                }

                ok -> yes = true
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-member-config — load a specific member's config
; ═══════════════════════════════════════════════

get-member-config = (root str, member str) (cfg ?str) {
    member-dir = root - '/' - member
    cfg = nil
    cfg-opt5 = load-config(member-dir)
    cfg-opt5: {
        ok -> {
            cfg = it
        }

        nil -> {
        }

        err -> {
        }
    }
}

; ═══════════════════════════════════════════════
; get-all-dependencies — get all dependencies from all members
; returns newline-separated name==version pairs
; ═══════════════════════════════════════════════

get-all-dependencies = (root str) (all-deps ?str) {
    all-deps-b = ''

    members = ''
    members-ok = false
    members-opt2 = get-members(root)
    members-opt2: {
        ok -> {
            members = it
            members-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        ! members-ok -> return

        -> {
            lines = members.split('\n')
            n = lines.len()
            i = 0
            (i < n) {
                member = lines[i]

                #{overflow=wrap}
                i = i + 1
                member = member.trim()
                {
                    member.len() > 0 -> {
                        #{overflow=wrap}
                        member-dir = root - '/' - member
                        cfg = ''
                        cfg-ok = false
                        cfg-opt6 = load-config(member-dir)
                        cfg-opt6: {
                            ok -> {
                                cfg = it
                                cfg-ok = true
                            }

                            nil -> {
                            }

                            err -> {
                            }
                        }
                        {
                            cfg-ok -> {
                                deps = config.get-dependencies(cfg)
                                all-deps-b = all-deps-b - deps
                            }
                        }
                    }
                }
            }
            all-deps = all-deps-b
        }
    }
}
