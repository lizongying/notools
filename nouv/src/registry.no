; ═══════════════════════════════════════════════
; get-auth-headers — get authentication headers from environment
; ═══════════════════════════════════════════════

get-auth-headers = () (headers str) {
    headers = ''

    ; 1. check UV_TOKEN
    token = os.get-env('UV-TOKEN')
    {
        token != '' -> {
            headers = 'Authorization: Bearer ' - token - '\n'
            return
        }
    }

    ; 2. check PIP_TOKEN
    pip-token = os.get-env('PIP-TOKEN')
    {
        pip-token != '' -> {
            headers = 'Authorization: Bearer ' - pip-token - '\n'
            return
        }
    }

    ; 3. check UV_USERNAME + UV_PASSWORD
    user = os.get-env('UV-USERNAME')
    pass = os.get-env('UV-PASSWORD')
    {
        user != '' -> {
            pass != '' -> {
                cred = user - ':' - pass
                encoded = base64.encode-std(cred)
                headers = 'Authorization: Basic ' - encoded - '\n'
                return
            }
        }
    }

    ; 4. check PIP_USERNAME + PIP_PASSWORD
    pip-user = os.get-env('PIP-USERNAME')
    pip-pass = os.get-env('PIP-PASSWORD')
    {
        pip-user != '' -> {
            pip-pass != '' -> {
                cred = pip-user - ':' - pip-pass
                encoded = base64.encode-std(cred)
                headers = 'Authorization: Basic ' - encoded - '\n'
                return
            }
        }
    }

    ; 5. try netrc
    netrc-user, netrc-pass, netrc-ok = read-netrc('pypi.org')
    {
        netrc-ok -> {
            cred = netrc-user - ':' - netrc-pass
            encoded = base64.encode-std(cred)
            headers = 'Authorization: Basic ' - encoded - '\n'
        }
    }
}

; ═══════════════════════════════════════════════
; read-netrc — read credentials from ~/.netrc
; ═══════════════════════════════════════════════

read-netrc = (host str) (user str, pass str, ok bool) {
    ok = false
    user = ''
    pass = ''

    home = os.get-env('HOME')
    {
        home == '' -> return
    }

    netrc-path = home - '/.netrc'
    p = path{
        p: netrc-path,
    }
    exists = p.exists()
    {
        exists == false -> return
        -> {
            ; parse netrc: machine <host> login <user> password <pass>
            read-result = fs.read-str(netrc-path)
            read-result: {
                ok -> raw = it
                nil -> raw = ''
                err -> raw = ''
            }
            lines = utils.split-str(raw, '\n')
            nl = lines.len
            i = 0
            found-machine = false
            {
                line = lines[i]
                i = i + 1
                line = utils.trim-str(line)
                {
                    utils.starts-with-str(line, 'machine ') -> {
                        machine-host = utils.trim-str(utils.slice-str(line, 8, line.len))
                        {
                            machine-host == host -> found-machine = true
                            -> found-machine = false
                        }
                    }
                    -> {
                        found-machine -> {
                            {
                            utils.starts-with-str(line, 'login ') -> {
                                user = utils.trim-str(utils.slice-str(line, 6, line.len))
                                }
                            }
                            {
                            utils.starts-with-str(line, 'password ') -> {
                                pass = utils.trim-str(utils.slice-str(line, 9, line.len))
                                }
                            }
                            {
                                utils.starts-with-str(line, 'machine ') -> {
                                    found-machine = false
                                }
                                line == 'default' -> {
                                    found-machine = false
                                }
                            }
                        }
                    }
                }
            } (i < nl)

            ; also handle single-line format
            {
                user == '' -> {
                    i = 0
                    {
                        line = lines[i]
                        i = i + 1
                        {
                            utils.contains-str(line, 'machine ' - host) -> {
                                login-pos = utils.index-str(line, 'login ')
                                {
                                    login-pos >= 0 -> {
                                        login-end = login-pos + 6
                                        rest = utils.trim-str(utils.slice-str(line, login-end, line.len))
                                        space = utils.index-str(rest, ' ')
                                        {
                                            space > 0 -> user = utils.slice-str(rest, 0, space)
                                            -> user = rest
                                        }
                                    }
                                }
                                pass-pos = utils.index-str(line, 'password ')
                                {
                                    pass-pos >= 0 -> {
                                        pass-end = pass-pos + 9
                                        rest2 = utils.trim-str(utils.slice-str(line, pass-end, line.len))
                                        space2 = utils.index-str(rest2, ' ')
                                        {
                                            space2 > 0 -> pass = utils.slice-str(rest2, 0, space2)
                                            -> pass = rest2
                                        }
                                    }
                                }
                            }
                        }
                    } (i < nl)
                }
            }

            {
                user != '' -> {
                    pass != '' -> ok = true
                }
            }
        }
    }
}

