; ═══════════════════════════════════════════════
; search-packages — search PyPI for packages
; returns newline-separated package names
; ═══════════════════════════════════════════════

search-packages = (query str) (results str) {
    results = ''
    base = 'https://pypi.org/search/?q=' - query
    resp = http.get(base)
    resp: {
        nil -> return
        -> {
            body = it.body
            results = extract-project-names(body)
        }
    }
}

; ═══════════════════════════════════════════════
; extract-project-names — extract project names from PyPI search HTML
; ═══════════════════════════════════════════════

extract-project-names = (html str) (names str) {
    names = ''
    pos = 0
    n = html.len
    {
        idx = utils.index-from-str(html, '/project/', pos)
        {
            idx < 0 -> break
            -> {
                start = idx + 9
                end = utils.index-from-str(html, '"', start)
                {
                    end > start -> {
                        name = utils.slice-str(html, start, end)
                        name = utils.trim-str(name)
                        name.len > 0 -> names = names - name - '\n'
                        pos = end
                    }
                    -> pos = start
                }
            }
        }
    } (pos < n)
}

