; ═══════════════════════════════════════════════
; get-json-url — get the JSON API base URL
; ═══════════════════════════════════════════════

get-json-url = () (url str) {
    url = os.get-env('UV-JSON-URL')
    {
        url == '' -> url = PYPI-JSON-URL
    }
}

; ═══════════════════════════════════════════════
; get-simple-index — get the simple index page for a package
; returns the HTML content of the simple index page
; ═══════════════════════════════════════════════

get-simple-index = (name str) (index str, ok bool) {
    ok = false
    index = ''

    base = get-index-url()
    ; normalize package name (PEP 503)
    norm-name = utils.to-lower-str(name)
    norm-name = utils.replace-char-str(norm-name, 45, 95)
    url = base - norm-name - '/'

    resp = http.get(url)
    resp: {
        nil -> return
        -> {
            index = it.body
            ok = true
        }
    }
}

