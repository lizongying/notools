; registry.no — PyPI package registry HTTP client
;
; Handles communication with PyPI and other package indexes.
; Supports the Simple API (PEP 503), JSON API, authentication, and retries.

# /nouv/src/utils

;
; Authentication methods:
;   - Basic auth (username:password)
;   - Bearer token (--token / UV_TOKEN env var)
;   - Netrc file (~/.netrc)
;
; API:
;   get-package-info(name str) (info str, ok bool) — get package metadata
;   get-simple-index(name str) (index str, ok bool) — get simple index
;   get-package-versions(name str) (versions str, ok bool) — list versions
;   get-latest-version(name str) (ver str, ok bool) — get latest version
;   get-package-url(name str, ver str) (url str, ok bool) — get download URL
;   download-package(name str, ver str, dest str) (ok bool) — download package
;   get-package-info-with-auth(name str, user str, pass str) (info str, ok bool)
;   download-with-retry(name str, ver str, dest str, max-retries i64) (ok bool)
;   get-wheel-url(name str, ver str) (url str, ok bool) — get best wheel URL
;   get-sdist-url(name str, ver str) (url str, ok bool) — get sdist URL
;   search-packages(query str) (results str) — search PyPI
;   get-package-hashes(name str, ver str) (hashes str) — get file hashes
;   upload-package(file-path str, name str, ver str, token str) (ok bool)
;   get-auth-headers() (headers str) — get auth headers from env
;   read-netrc(host str) (user str, pass str, ok bool) — read netrc credentials
;   download-with-auth(name str, ver str, dest str, token str) (ok bool)

PYPI-SIMPLE-URL = 'https://pypi.org/simple/'
PYPI-JSON-URL = 'https://pypi.org/pypi/'
UV-INDEX-URL = 'https://astral.sh/uv/simple/'
DEFAULT-INDEX = 'https://pypi.org/simple/'

; ═══════════════════════════════════════════════
; get-index-url — get the configured index URL
; ═══════════════════════════════════════════════

get-index-url = () (url str) {
    url = os.get-env('UV-INDEX-URL')
    {
        url == '' -> url = os.get-env('PIP-INDEX-URL')
    }
    {
        url == '' -> url = DEFAULT-INDEX
    }
}

; ═══════════════════════════════════════════════
; get-package-info — get package metadata via JSON API
; returns a flat string with name, version, requires_dist, etc.
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; JSON API plumbing
;
; The PyPI JSON API (GET <json-url><name>/json) is decoded with the std
; `json` module.  Network fetch (fetch-package-json) is separated from the
; pure decoder (parse-package-json / parse-releases-json) so the parsing
; logic can be unit-tested offline with a fixture string.
;
; parse-package-json produces the flat info string consumed downstream:
;   version=<v>
;   requires_dist=<dep>   (one line per dependency)
;   wheel-url=<url>  wheel-hash=<sha256>  wheel-filename=<fn>
;   sdist-url=<url>  sdist-hash=<sha256>  sdist-filename=<fn>
; ═══════════════════════════════════════════════

; fetch-package-json — GET the raw JSON body for a package (nil on failure)
fetch-package-json = (name str) (body ?str) {
    body = nil

    base = get-json-url()
    #{overflow=wrap}
    url = base - name - '/json'

    resp = http.get(url)
    resp: {
        nil -> return

        err -> return

        ok -> {
            status = it.status-code
            {
                status >= 200 && status < 300 -> body = it.body
            }
        }
    }
}

; parse-package-json — decode a PyPI JSON payload into the flat info string
parse-package-json = (s str) (info ?str) {
    info = nil
    sb = ''

    root-opt = json.parse(s)
    root-opt: {
        nil -> return

        err -> return

        ok -> {
            root = it

            ; ── info section ──
            info-opt = root.get('info')
            info-opt: {
                nil -> {}

                err -> {}

                ok -> {
                    meta = it
                    ver, has-ver = meta.get-str('version')
                    has-ver -> sb = sb - 'version=' - ver - '\n'

                    pname, has-pname = meta.get-str('name')
                    has-pname -> sb = sb - 'name=' - pname - '\n'

                    rd-opt = meta.get('requires_dist')
                    rd-opt: {
                        nil -> {}

                        err -> {}

                        ok -> {
                            arr = it
                            rn = arr.arr-len()
                            k = 0
                            (k < rn) {
                                elem = arr.arr-get(k)

                                #{overflow=wrap}
                                k = k + 1
                                elem: {
                                    nil -> {}

                                    err -> {}

                                    ok -> {
                                        dep, dp-ok = it.str()
                                        dp-ok -> sb = sb - 'requires_dist=' - dep - '\n'
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ; ── urls section (wheel / sdist download metadata) ──
            urls-opt = root.get('urls')
            urls-opt: {
                nil -> {}

                err -> {}

                ok -> {
                    arr = it
                    n = arr.arr-len()
                    i = 0
                    (i < n) {
                        fel = arr.arr-get(i)

                        #{overflow=wrap}
                        i = i + 1
                        fel: {
                            nil -> {}

                            err -> {}

                            ok -> {
                                file = it
                                ptype, pt-ok = file.get-str('packagetype')
                                pt-ok -> {
                                    tag = ''
                                    ptype == 'bdist_wheel' -> tag = 'wheel'
                                    ptype == 'sdist' -> tag = 'sdist'

                                    tag != '' -> {
                                        url, u-ok = file.get-str('url')
                                        u-ok -> sb = sb - tag - '-url=' - url - '\n'

                                        fname, f-ok = file.get-str('filename')
                                        f-ok -> sb = sb - tag - '-filename=' - fname - '\n'

                                        dg-opt = file.get('digests')
                                        dg-opt: {
                                            nil -> {}

                                            err -> {}

                                            ok -> {
                                                sha, sha-ok = it.get-str('sha256')
                                                sha-ok -> sb = sb - tag - '-hash=' - sha - '\n'
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            info = sb
        }
    }
}

; parse-releases-json — decode the `releases` object keys into a
; newline-separated version list
parse-releases-json = (s str) (versions ?str) {
    versions = nil

    root-opt = json.parse(s)
    root-opt: {
        nil -> return

        err -> return

        ok -> {
            root = it
            rel-opt = root.get('releases')
            rel-opt: {
                nil -> {}

                err -> {}

                ok -> {
                    rel = it
                    versions = rel.obj-keys-str()
                }
            }
        }
    }
}

; get-info-field — read the first `key=` value from a flat info string
get-info-field = (info str, key str) (val ?str) {
    val = nil

    #{overflow=wrap}
    prefix = key - '='
    plen = prefix.len-bytes()
    lines = utils.split-str(info, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=0}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            utils.starts-with-str(line, prefix) -> {
                val = utils.trim-str(utils.slice-str(line, plen, line.len-bytes()))
                return
            }
        }
    }
}

; get-package-info — get package metadata via JSON API
get-package-info = (name str) (info ?str) {
    body-opt = fetch-package-json(name)
    body-opt: {
        ok -> info = parse-package-json(it)
        nil -> {}
        err -> {}
    }
}

; get-package-versions — list all available versions (newline-separated)
get-package-versions = (name str) (versions ?str) {
    body-opt = fetch-package-json(name)
    body-opt: {
        ok -> versions = parse-releases-json(it)
        nil -> {}
        err -> {}
    }
}

; get-latest-version — get the latest version of a package
get-latest-version = (name str) (ver ?str) {
    info-opt = get-package-info(name)
    info-opt: {
        ok -> {
            ver-opt = get-info-field(it, 'version')
            ver-opt: {
                ok -> ver = it
                nil -> {}
                err -> {}
            }
        }
        nil -> {}
        err -> {}
    }
}

; get-package-url — get the download URL for a specific version (wheel first)
get-package-url = (name str, ver str) (url ?str) {
    wheel-opt = get-wheel-url(name, ver)
    wheel-opt: {
        ok -> url = it
        nil -> url = get-sdist-url(name, ver)
        err -> url = get-sdist-url(name, ver)
    }
}

; download-package — download a package to a destination path
download-package = (name str, ver str, dest str) (ok bool) {
    ok = false

    url-opt = get-package-url(name, ver)
    url-opt: {
        ok -> url = it
        nil -> return
        err -> return
    }

    resp = http.get(url)
    resp: {
        nil -> return

        err -> return

        ok -> {
            status = it.status-code
            body = it.body
            status >= 200 && status < 300 -> {
                fd = fs.open-write(dest)
                fd > 0 -> {
                    fs.write(fd, body, body.len-bytes())
                    fs.close(fd)
                    ok = true
                }
            }
        }
    }
}

; get-wheel-url — get the wheel download URL for a package version
get-wheel-url = (name str, ver str) (url ?str) {
    info-opt = get-package-info(name)
    info-opt: {
        ok -> {
            url-opt = get-info-field(it, 'wheel-url')
            url-opt: {
                ok -> url = it
                nil -> {}
                err -> {}
            }
        }
        nil -> {}
        err -> {}
    }
}

; get-sdist-url — get the source distribution URL for a package version
get-sdist-url = (name str, ver str) (url ?str) {
    info-opt = get-package-info(name)
    info-opt: {
        ok -> {
            url-opt = get-info-field(it, 'sdist-url')
            url-opt: {
                ok -> url = it
                nil -> {}
                err -> {}
            }
        }
        nil -> {}
        err -> {}
    }
}

; get-package-hashes — get file hashes (newline-separated sha256 values)
get-package-hashes = (name str, ver str) (hashes str) {
    hashes = ''

    info-opt = get-package-info(name)
    info-opt: {
        ok -> {
            wh-opt = get-info-field(it, 'wheel-hash')
            wh-opt: {
                ok -> hashes = hashes - it - '\n'
                nil -> {}
                err -> {}
            }

            sh-opt = get-info-field(it, 'sdist-hash')
            sh-opt: {
                ok -> hashes = hashes - it - '\n'
                nil -> {}
                err -> {}
            }
        }
        nil -> {}
        err -> {}
    }
}

; get-package-info-with-auth — get package info (auth is not applied to the
; public JSON API; retained for API compatibility)
get-package-info-with-auth = (name str, user str, pass str) (info ?str) {
    info = get-package-info(name)
}

; download-with-retry — download a package with retry logic
download-with-retry = (name str, ver str, dest str, max-retries i64) (ok bool) {
    ok = false
    retries = max-retries
    retries < 1 -> retries = 3

    attempt = 0
    (attempt < retries) {

        #{overflow=wrap}
        attempt = attempt + 1
        dl-ok = download-package(name, ver, dest)
        dl-ok -> {
            ok = true
            return
        }
    }
}

; download-with-auth — download a package with an auth token
download-with-auth = (name str, ver str, dest str, token str) (ok bool) {
    ok = false
    os.set-env('UV-TOKEN', token)
    ok = download-package(name, ver, dest)
}

; get-package-info-cached — get package info (cache passthrough)
get-package-info-cached = (name str) (info ?str) {
    info = get-package-info(name)
}

; ═══════════════════════════════════════════════
; get-json-url — get the JSON API base URL
; ═══════════════════════════════════════════════

get-json-url = () (url str) {
    url = os.get-env('UV-JSON-URL')
    {
        url == '' -> url = PYPI-JSON-URL
    }
}

; ═══════════════════════════════════════════════
; get-simple-index — get the simple index page for a package
; returns the HTML content of the simple index page
; ═══════════════════════════════════════════════

get-simple-index = (name str) (index ?str) {
    index = nil

    base = get-index-url()

    ; normalize package name (PEP 503)
    norm-name = utils.to-lower-str(name)
    norm-name = utils.replace-char-str(norm-name, "-", "_")
    #{overflow=wrap}
    url = base - norm-name - '/'

    resp = http.get(url)
    resp: {
        nil -> return

        ok -> {
            index = it.body
        }

        err -> return
    }
}

