; ═══════════════════════════════════════════════
; get-index-url-for-config — get index URL from project config
; ═══════════════════════════════════════════════

get-index-url-for-config = (cfg str) (url str) {
    url = ''
    lines = utils.split-str(cfg, '\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        {
            utils.starts-with-str(line, 'index_url=') -> {
                url = utils.trim-str(utils.slice-str(line, 10, line.len))
                return
            }
            utils.starts-with-str(line, 'index-url=') -> {
                url = utils.trim-str(utils.slice-str(line, 10, line.len))
                return
            }
        }
    } (i < n)

    ; fall back to environment / default
    url = get-index-url()
}

; ═══════════════════════════════════════════════
; get-extra-index-urls — get extra index URLs from config
; ═══════════════════════════════════════════════

get-extra-index-urls = (cfg str) (urls str) {
    urls = ''
    lines = utils.split-str(cfg, '\n')
    n = lines.len
    i = 0
    {
        line = lines[i]
        i = i + 1
        {
            utils.starts-with-str(line, 'extra_index_url=') -> {
                url = utils.trim-str(utils.slice-str(line, 16, line.len))
                urls = urls - url - '\n'
            }
            utils.starts-with-str(line, 'extra-index-url=') -> {
                url = utils.trim-str(utils.slice-str(line, 16, line.len))
                urls = urls - url - '\n'
            }
        }
    } (i < n)
}

; ═══════════════════════════════════════════════
; verify-hash — verify a file hash against expected value
; ═══════════════════════════════════════════════

verify-hash = (file-path str, expected-hash str) (ok bool) {
    ok = false
    p = path{
        p: file-path,
    }
    file-exists = p.exists()
    {
        file-exists == false -> {
            print('error: could not read file {file-path}')
            return
        }
        -> {
            file-data = fs.read-bytes(file-path)
            file-data: {
                ok -> actual-hash = sha256.sha256-hex(it)
                nil -> actual-hash = ''
                err -> actual-hash = ''
            }
            {
                actual-hash == expected-hash -> ok = true
                -> {
                    print('error: hash mismatch for {file-path}')
                    print('  expected: {expected-hash}')
                    print('  actual:   {actual-hash}')
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; download-and-verify — download a package and verify its hash
; ═══════════════════════════════════════════════

download-and-verify = (name str, ver str, dest str, expected-hash str) (ok bool) {
    ok = false

    dl-ok = download-package(name, ver, dest)
    {
        dl-ok == false -> return
        -> {
            {
                expected-hash == '' -> {
                    ok = true
                }
                -> {
                    hash-ok = verify-hash(dest, expected-hash)
                    ok = hash-ok
                    {
                        hash-ok == false -> {
                            fs.remove(dest)
                        }
                    }
                }
            }
        }
    }
}
