; ═══════════════════════════════════════════════
; get-auth-headers — get authentication headers from environment
; ═══════════════════════════════════════════════

get-auth-headers = () (headers str) {
    headers = ''

    ; 1. check UV_TOKEN
    token = os.get-env('UV-TOKEN')
    {
        token != '' -> {
            #{overflow=wrap}
            headers = 'Authorization: Bearer ' - token - '\n'
            return
        }
    }

    ; 2. check PIP_TOKEN
    pip-token = os.get-env('PIP-TOKEN')
    {
        pip-token != '' -> {
            #{overflow=wrap}
            headers = 'Authorization: Bearer ' - pip-token - '\n'
            return
        }
    }

    ; 3. check UV_USERNAME + UV_PASSWORD
    user = os.get-env('UV-USERNAME')
    pass = os.get-env('UV-PASSWORD')
    {
        user != '' -> {
            pass != '' -> {

                #{overflow=wrap}
                cred = user - ':' - pass
                encoded = base64.encode-std(cred)
                #{overflow=wrap}
                headers = 'Authorization: Basic ' - encoded - '\n'
                return
            }
        }
    }

    ; 4. check PIP_USERNAME + PIP_PASSWORD
    pip-user = os.get-env('PIP-USERNAME')
    pip-pass = os.get-env('PIP-PASSWORD')
    {
        pip-user != '' -> {
            pip-pass != '' -> {

                #{overflow=wrap}
                cred = pip-user - ':' - pip-pass
                encoded = base64.encode-std(cred)
                #{overflow=wrap}
                headers = 'Authorization: Basic ' - encoded - '\n'
                return
            }
        }
    }

    ; 5. try netrc
    netrc-user, netrc-pass, netrc-ok = read-netrc('pypi.org')
    {
        netrc-ok -> {

            #{overflow=wrap}
            cred = netrc-user - ':' - netrc-pass
            encoded = base64.encode-std(cred)
            #{overflow=wrap}
            headers = 'Authorization: Basic ' - encoded - '\n'
        }
    }
}

; ═══════════════════════════════════════════════
; read-netrc — read credentials from ~/.netrc
; ═══════════════════════════════════════════════

read-netrc = (host str) (user str, pass str, ok bool) {
    ok = false
    user = ''
    pass = ''

    home = os.get-env('HOME')
    {
        home == '' -> return
    }

    #{overflow=wrap}
    netrc-path = home - '/.netrc'
    p = path {
        p: netrc-path
    }
    exists = p.exists()
    {
        ! exists -> return

        -> {

            ; parse netrc: machine <host> login <user> password <pass>
            read-result = fs.read-str(netrc-path)
            read-result: {
                ok -> raw = it

                nil -> raw = ''

                err -> raw = ''
            }
            lines = utils.split-str(raw, '\n')
            nl = lines.len()
            i = 0
            found-machine = false
            (i < nl) {
                line = lines[i]

                #{overflow=wrap}
                i = i + 1
                line = utils.trim-str(line)
                {
                    utils.starts-with-str(line, 'machine ') -> {
                        machine-host = utils.trim-str(utils.slice-str(line, 8, line.len-bytes()))
                        {
                            machine-host == host -> found-machine = true

                            -> found-machine = false
                        }
                    }

                    -> {
                        found-machine -> {
                            {
                                utils.starts-with-str(line, 'login ') -> {
                                    user = utils.trim-str(utils.slice-str(line, 6, line.len-bytes()))
                                }
                            }
                            {
                                utils.starts-with-str(line, 'password ') -> {
                                    pass = utils.trim-str(utils.slice-str(line, 9, line.len-bytes()))
                                }
                            }
                            {
                                utils.starts-with-str(line, 'machine ') -> {
                                    found-machine = false
                                }

                                line == 'default' -> {
                                    found-machine = false
                                }
                            }
                        }
                    }
                }
            }

            ; also handle single-line format
            {
                user == '' -> {
                    i = 0
                    (i < nl) {
                        line = lines[i]
                        #{overflow=wrap}
                        i = i + 1
                        {
                            utils.contains-str(line, 'machine ' - host) -> {
                                login-pos = utils.index-str(line, 'login ')
                                {
                                    login-pos >= 0 -> {
                                        #{overflow=wrap}
                                        login-end = login-pos + 6
                                        rest = utils.trim-str(utils.slice-str(line, login-end, line.len-bytes()))
                                        space = utils.index-str(rest, ' ')
                                        {
                                            space > 0 -> user = utils.slice-str(rest, 0, space)

                                            -> user = rest
                                        }
                                    }
                                }
                                pass-pos = utils.index-str(line, 'password ')
                                {
                                    pass-pos >= 0 -> {
                                        #{overflow=wrap}
                                        pass-end = pass-pos + 9
                                        rest2 = utils.trim-str(utils.slice-str(line, pass-end, line.len-bytes()))
                                        space2 = utils.index-str(rest2, ' ')
                                        {
                                            space2 > 0 -> pass = utils.slice-str(rest2, 0, space2)

                                            -> pass = rest2
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            {
                user != '' -> {
                    pass != '' -> ok = true
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; download-with-auth — download a package with authentication
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; download-with-backoff — download with exponential backoff retry
; ═══════════════════════════════════════════════

download-with-backoff = (name str, ver str, dest str, max-retries i64) (ok bool) {
    ok = false
    {
        max-retries < 1 -> max-retries = 3
    }

    attempt = 0
    delay-ms = 1000

    (attempt < max-retries) {

        #{overflow=wrap}
        attempt = attempt + 1

        dl-ok = download-package(name, ver, dest)
        {
            dl-ok -> {
                ok = true
                return
            }

            -> {
                attempt < max-retries -> {
                    print('  retry {attempt}/{max-retries} in {delay-ms}ms...')
                    os.sleep-ms(delay-ms)

                    #{overflow=wrap}
                    delay-ms = delay-ms * 2
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; upload-package — upload a package to PyPI (publish)
; ═══════════════════════════════════════════════

upload-package = (file-path str, name str, ver str, token str) (ok bool) {
    ok = false

    upload-url = os.get-env('UV-UPLOAD-URL')
    {
        upload-url == '' -> upload-url = 'https://upload.pypi.org/legacy/'
    }

    p3 = path {
        p: file-path
    }
    file-exists = p3.exists()
    {
        ! file-exists -> {
            print('error: could not read file {file-path}')
            return
        }

        -> {
            filename = file-path
            slash = utils.rindex-str(filename, '/')
            {
                slash >= 0 -> {

                    #{overflow=wrap}
                    filename = utils.slice-str(filename, slash + 1, filename.len-bytes())
                }
            }

            ; TODO: add auth header support
            read-result = fs.read-str(file-path)
            read-result: {
                ok -> raw = it

                nil -> raw = ''

                err -> raw = ''
            }
            resp = http.post(upload-url, raw)
            resp: {
                nil -> {
                    print('error: no response from upload')
                }

                ok -> {
                    status = it.status-code
                    body = it.body
                    {
                        status >= 200 -> {
                            status < 300 -> {
                                print('Uploaded {filename} to {upload-url}')
                                ok = true
                            }
                        }

                        -> {
                            print('error: upload failed with status {status}: {body}')
                        }
                    }
                }

                err -> {
                    print('error: upload request failed')
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; get-package-info-cached — get package info with caching
; ═══════════════════════════════════════════════

; ═══════════════════════════════════════════════
; get-index-url-for-config — get index URL from project config
; ═══════════════════════════════════════════════

get-index-url-for-config = (cfg str) (url str) {
    url = ''
    lines = utils.split-str(cfg, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=0}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            ; 'index_url=' / 'index-url=' 长度为 10，值从下标 10 开始
            utils.starts-with-str(line, 'index_url=') -> {
                url = utils.trim-str(utils.slice-str(line, 10, line.len-bytes()))
                return
            }

            utils.starts-with-str(line, 'index-url=') -> {
                url = utils.trim-str(utils.slice-str(line, 10, line.len-bytes()))
                return
            }
        }
    }

    ; fall back to environment / default
    url = get-index-url()
}

; ═══════════════════════════════════════════════
; get-extra-index-urls — get extra index URLs from config
; ═══════════════════════════════════════════════

get-extra-index-urls = (cfg str) (urls str) {
    urls = ''
    lines = utils.split-str(cfg, '\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=0}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            ; 'extra_index_url=' / 'extra-index-url=' 长度为 16，值从下标 16 开始
            utils.starts-with-str(line, 'extra_index_url=') -> {
                url = utils.trim-str(utils.slice-str(line, 16, line.len-bytes()))
                #{overflow=wrap}
                urls = urls - url - '\n'
            }

            utils.starts-with-str(line, 'extra-index-url=') -> {
                url = utils.trim-str(utils.slice-str(line, 16, line.len-bytes()))
                #{overflow=wrap}
                urls = urls - url - '\n'
            }
        }
    }
}

; ═══════════════════════════════════════════════
; verify-hash — verify a file hash against expected value
; ═══════════════════════════════════════════════

verify-hash = (file-path str, expected-hash str) (ok bool) {
    ok = false
    p = path {
        p: file-path
    }
    file-exists = p.exists()
    {
        ! file-exists -> {
            print('error: could not read file {file-path}')
            return
        }

        -> {
            file-data = fs.read-bytes(file-path)
            file-data: {
                ok -> actual-hash = sha256.sha256-hex(it)

                nil -> actual-hash = ''

                err -> actual-hash = ''
            }
            {
                actual-hash == expected-hash -> ok = true

                -> {
                    print('error: hash mismatch for {file-path}')
                    print('  expected: {expected-hash}')
                    print('  actual:   {actual-hash}')
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; download-and-verify — download a package and verify its hash
; ═══════════════════════════════════════════════

download-and-verify = (name str, ver str, dest str, expected-hash str) (ok bool) {
    ok = false

    dl-ok = download-package(name, ver, dest)
    {
        ! dl-ok -> return

        -> {
            expected-hash == '' -> {
                ok = true
            }

            -> {
                hash-ok = verify-hash(dest, expected-hash)
                ok = hash-ok
                {
                    ! hash-ok -> {
                        fs.remove(dest)
                    }
                }
            }
        }
    }
}
