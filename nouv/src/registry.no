; ═══════════════════════════════════════════════
; download-with-backoff — download with exponential backoff retry
; ═══════════════════════════════════════════════

download-with-backoff = (name str, ver str, dest str, max-retries i64) (ok bool) {
    ok = false
    {
        max-retries < 1 -> max-retries = 3
    }

    attempt = 0
    delay-ms = 1000

    {
        attempt = attempt + 1

        dl-ok = download-package(name, ver, dest)
        {
            dl-ok -> {
                ok = true
                return
            }
            -> {
                {
                    attempt < max-retries -> {
                        print('  retry {attempt}/{max-retries} in {delay-ms}ms...')
                        os.sleep-ms(delay-ms)
                        delay-ms = delay-ms * 2
                    }
                }
            }
        }
    } (attempt < max-retries)
}

; ═══════════════════════════════════════════════
; upload-package — upload a package to PyPI (publish)
; ═══════════════════════════════════════════════

upload-package = (file-path str, name str, ver str, token str) (ok bool) {
    ok = false

    upload-url = os.get-env('UV-UPLOAD-URL')
    {
        upload-url == '' -> upload-url = 'https://upload.pypi.org/legacy/'
    }

    p3 = path{
        p: file-path,
    }
    file-exists = p3.exists()
    {
        file-exists == false -> {
            print('error: could not read file {file-path}')
            return
        }
        -> {
            filename = file-path
            slash = utils.rindex-str(filename, '/')
            {
                slash >= 0 -> filename = utils.slice-str(filename, slash + 1, filename.len)
            }
            ; TODO: add auth header support
            read-result = fs.read-str(file-path)
            read-result: {
                ok -> raw = it
                nil -> raw = ''
                err -> raw = ''
            }
            resp = http.post(upload-url, raw)
            resp: {
                nil -> {
                    print('error: no response from upload')
                }
                -> {
                    status = it.status-code
                    {
                        status >= 200 -> {
                            status < 300 -> {
                                print('Uploaded {filename} to {upload-url}')
                                ok = true
                            }
                        }
                        -> {
                            body = it.body
                            print('error: upload failed with status {status}: {body}')
                        }
                    }
                }
            }
        }
    }
}

