; build.no — project building and packaging
;
; Builds Python project distributions (sdist and wheel) from pyproject.toml.

# /nouv/src/config
# /nouv/src/toml
# /nouv/src/utils
# /nouv/src/python

; ═══════════════════════════════════════════════
; build-project — build both sdist and wheel
; ═══════════════════════════════════════════════

build-project = (dir str, cfg str) (ok bool, dist-dir str) {
    ok = false
    dist-dir = dir - '/dist'

    p = path{
        p: dist-dir,
    }
    mk = p.make-dir()

    name = get-name(cfg)
    ver = get-version(cfg)

    ; build sdist
    #{overflow=wrap}
    sdist-path = dist-dir - '/' - name - '-' - ver - '.tar.gz'
    print('Building sdist...')
    sdist-ok = create-sdist-archive(dir, name, ver, sdist-path)

    ; build wheel
    #{overflow=wrap}
    wheel-path = dist-dir - '/' - name - '-' - ver - '-py3-none-any.whl'
    print('Building wheel...')
    wheel-ok = create-wheel-archive(dir, name, ver, wheel-path)

    {
        sdist-ok -> {
            wheel-ok -> {
        }
            ok = true
            print('Built sdist and wheel at {dist-dir}')
        }
    }
}

; ═══════════════════════════════════════════════
; build-sdist — build source distribution only
; ═══════════════════════════════════════════════

build-sdist = (dir str, cfg str) (ok bool, path str) {
    ok = false
    path = ''

    dist-dir = dir - '/dist'
    p = path{
        p: dist-dir,
    }
    mk = p.make-dir()

    name = get-name(cfg)
    ver = get-version(cfg)
    #{overflow=wrap}
    path = dist-dir - '/' - name - '-' - ver - '.tar.gz'

    ok = create-sdist-archive(dir, name, ver, path)
}

; ═══════════════════════════════════════════════
; build-wheel — build wheel distribution only
; ═══════════════════════════════════════════════

build-wheel = (dir str, cfg str) (ok bool, path str) {
    ok = false
    path = ''

    dist-dir = dir - '/dist'
    p = path{
        p: dist-dir,
    }
    mk = p.make-dir()

    name = get-name(cfg)
    ver = get-version(cfg)
    #{overflow=wrap}
    path = dist-dir - '/' - name - '-' - ver - '-py3-none-any.whl'

    ok = create-wheel-archive(dir, name, ver, path)
}

; ═══════════════════════════════════════════════
; create-sdist-archive — create source distribution tar.gz
; ═══════════════════════════════════════════════

create-sdist-archive = (src-dir str, name str, ver str, out-path str) (ok bool) {
    ok = false

    builder = tar.tar-builder{}
    base-name = name - '-' - ver

    ; add pyproject.toml
    pyproject-path = src-dir - '/pyproject.toml'
    p = path{
        p: pyproject-path,
    }
    py-exists = p.exists()
    {
        py-exists -> {
            file-data = fs.read-bytes(pyproject-path)
            file-data: {
                #{overflow=wrap}
                ok -> builder.add-file(base-name - '/pyproject.toml', it)
                #{overflow=wrap}
                nil -> builder.add-file(base-name - '/pyproject.toml', [])
                #{overflow=wrap}
                err -> builder.add-file(base-name - '/pyproject.toml', [])
            }
        }
    }

    ; add README.md
    readme-path = src-dir - '/README.md'
    p2 = path{
        p: readme-path,
    }
    readme-exists = p2.exists()
    {
        readme-exists -> {
            file-data = fs.read-bytes(readme-path)
            file-data: {
                #{overflow=wrap}
                ok -> builder.add-file(base-name - '/README.md', it)
                #{overflow=wrap}
                nil -> builder.add-file(base-name - '/README.md', [])
                #{overflow=wrap}
                err -> builder.add-file(base-name - '/README.md', [])
            }
        }
    }

    ; add source files from src/ directory
    src-dir-pkg = src-dir - '/src'
    p3 = path{
        p: src-dir-pkg,
    }
    src-exists = p3.exists()
    {
        src-exists -> {
            #{overflow=wrap}
            add-directory-to-tar(builder, src-dir-pkg, base-name - '/src')
        }
    }

    ; add PKG-INFO
    pkg-info = ''
    pkg-info = pkg-info - 'Metadata-Version: 2.1\n'
    #{overflow=wrap}
    pkg-info = pkg-info - 'Name: ' - name - '\n'
    #{overflow=wrap}
    pkg-info = pkg-info - 'Version: ' - ver - '\n'
    #{overflow=wrap}
    builder.add-file(base-name - '/PKG-INFO', pkg-info)

    ; finalize archive
    archive = builder.finish()

    ; write to file
    fd = fs.open-write(out-path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, archive, archive.len())
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; create-wheel-archive — create wheel distribution
; ═══════════════════════════════════════════════

create-wheel-archive = (src-dir str, name str, ver str, out-path str) (ok bool) {
    ok = false

    norm-name = name.replace-char(45, 95)
    #{overflow=wrap}
    dist-info-dir = norm-name - '-' - ver - '.dist-info'

    ; collect all files to include
    file-paths = ''

    ; add source files from src/
    src-dir-pkg = src-dir - '/src'
    p = path{
        p: src-dir-pkg,
    }
    src-exists = p.exists()
    {
        src-exists -> {
            #{overflow=wrap}
            out = run-cmd-output('find ' - src-dir-pkg - ' -name "*.py" -type f')
            file-paths = out
        }
    }

    ; create dist-info content
    wheel-content = ''
    wheel-content = wheel-content - 'Wheel-Version: 1.0\n'
    wheel-content = wheel-content - 'Generator: nouv (0.1.0)\n'
    wheel-content = wheel-content - 'Root-Is-Purelib: true\n'
    wheel-content = wheel-content - 'Tag: py3-none-any\n'

    metadata-content = ''
    metadata-content = metadata-content - 'Metadata-Version: 2.1\n'
    #{overflow=wrap}
    metadata-content = metadata-content - 'Name: ' - name - '\n'
    #{overflow=wrap}
    metadata-content = metadata-content - 'Version: ' - ver - '\n'

    ; write files using tar builder
    builder = tar.tar-builder{}
    #{overflow=wrap}
    builder.add-file(dist-info-dir - '/WHEEL', wheel-content)
    #{overflow=wrap}
    builder.add-file(dist-info-dir - '/METADATA', metadata-content)
    #{overflow=wrap}
    builder.add-file(dist-info-dir - '/RECORD', '')

    ; add source files
    {
        file-paths != '' -> {
            lines = file-paths.split('\n')
            n = lines.len()
            i = 0
            {
                fpath = lines[i]
                #{overflow=wrap}
                i = i + 1
                fpath = fpath.trim()
                {
                    fpath.len() > 0 -> {
                        #{overflow=wrap}
                        rel-path = fpath.slice(src-dir.len-bytes() + 5, fpath.len())
                        file-data = fs.read-bytes(fpath)
                        file-data: {
                            ok -> builder.add-file(rel-path, it)
                            nil -> builder.add-file(rel-path, [])
                            err -> builder.add-file(rel-path, [])
                        }
                    }
                }
            } (i < n)
        }
    }

    ; finalize and write
    archive = builder.finish()
    fd = fs.open-write(out-path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, archive, archive.len())
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; add-directory-to-tar — recursively add directory contents to tar builder
; ═══════════════════════════════════════════════

add-directory-to-tar = (builder tar.tar-builder, dir-path str, archive-prefix str) {
    #{overflow=wrap}
    out = run-cmd-output('find ' - dir-path - ' -type f')
    lines = out.split('\n')
    n2 = lines.len()
    i = 0
    {
        fpath = lines[i]
        #{overflow=wrap}
        i = i + 1
        fpath = fpath.trim()
        {
            fpath.len() > 0 -> {
                #{overflow=wrap}
                rel = fpath.slice(dir-path.len-bytes() + 1, fpath.len())
                #{overflow=wrap}
                archive-path = archive-prefix - '/' - rel
                file-data = fs.read-bytes(fpath)
                file-data: {
                    ok -> builder.add-file(archive-path, it)
                    nil -> builder.add-file(archive-path, [])
                    err -> builder.add-file(archive-path, [])
                }
            }
        }
    } (i < n2)
}

; ═══════════════════════════════════════════════
; publish-project — publish distributions to PyPI
; ═══════════════════════════════════════════════

publish-project = (dir str, cfg str, token str) (ok bool) {
    ok = false
    dist-dir = dir - '/dist'

    #{overflow=wrap}
    out = run-cmd-output('ls ' - dist-dir)
    lines = out.split('\n')
    n2 = lines.len()
    i = 0
    {
        line = lines[i]
        #{overflow=wrap}
        i = i + 1
        line = line.trim()
        {
            line.ends-with('.tar.gz') -> {
            line.ends-with('.whl') -> {
                #{overflow=wrap}
                file-path = dist-dir - '/' - line
                print('Uploading {line}...')

                upload-ok = upload-file(file-path, line, token)
                {
                    upload-ok == false -> {
                        print('error: failed to upload {line}')
                        return
                    }
                }
            }
        }
    } (i < n2)

    ok = true
}

; ═══════════════════════════════════════════════
; upload-file — upload a single file to PyPI
; ═══════════════════════════════════════════════

upload-file = (file-path str, filename str, token str) (ok bool) {
    ok = false

    p = path{
        p: file-path,
    }
    file-exists = p.exists()
    {
        file-exists == false -> {
            print('error: could not read file {file-path}')
            return
        }
        -> {
            url = 'https://upload.pypi.org/legacy/'

            req = http.request{
                method: 'POST',
                url: url,
                body: '',
            }
            req.add-header('Authorization', 'Basic ' - token)
            req.add-header('Content-Type', 'multipart/form-data; boundary=nouv-boundary')

            body = ''
            #{overflow=wrap}
            body = body - '--nouv-boundary\n'
            #{overflow=wrap}
            body = body - 'Content-Disposition: form-data; name="content"; filename="' - filename - '"\n'
            #{overflow=wrap}
            body = body - 'Content-Type: application/octet-stream\n'
            #{overflow=wrap}
            body = body - '\n'
            read-result = fs.read-str(file-path)
            read-result: {
                ok -> raw = it
                nil -> raw = ''
                err -> raw = ''
            }
            #{overflow=wrap}
            body = body - raw
            #{overflow=wrap}
            body = body - '\n--nouv-boundary--\n'

            resp = http.do-req(req)
            {
                resp != nil -> {
                    {
                        resp.status-code == 200 -> ok = true
                        resp.status-code == 201 -> ok = true
                        -> {
                            print('error: upload failed with status {resp.status-code}')
                        }
                    }
                }
            }
        }
    }
}

; ═══════════════════════════════════════════════
; build-with-pep517 — build using a PEP 517 build backend
; ═══════════════════════════════════════════════

build-with-pep517 = (dir str, cfg str) (ok bool, dist-dir str) {
    ok = false
    dist-dir = dir - '/dist'

    backend = get-build-backend(cfg)
    {
        backend == '' -> {
            ok, dist-dir = build-project(dir, cfg)
            return
        }
    }

    p = path{
        p: dist-dir,
    }
    mk = p.make-dir()

    py-path, py-ok = find-python('')
    {
        py-ok == false -> {
            print('error: no Python installation found')
            return
        }
    }

    #{overflow=wrap}
    code = run-cmd(py-path - ' ' - '-m build --outdir ' - dist-dir - ' ' - dir)
    {
        code == 0 -> {
            ok = true
            print('Built project using PEP 517 backend: {backend}')
        }
        -> {
            print('warning: PEP 517 build failed, falling back to built-in')
            ok, dist-dir = build-project(dir, cfg)
        }
    }
}

; ═══════════════════════════════════════════════
; build-editable — build an editable wheel (PEP 660)
; ═══════════════════════════════════════════════

build-editable = (dir str, cfg str) (ok bool, wheel-path str) {
    ok = false
    wheel-path = ''

    dist-dir = dir - '/dist'
    p = path{
        p: dist-dir,
    }
    mk = p.make-dir()

    name = get-name(cfg)
    ver = get-version(cfg)
    norm-name = name.replace-char(45, 95)
    #{overflow=wrap}
    wheel-path = dist-dir - '/' - norm-name - '-' - ver - '-py3-none-any.whl'

    backend = get-build-backend(cfg)
    {
        backend != '' -> {
            py-path, py-ok = find-python('')
            {
                py-ok -> {
                    #{overflow=wrap}
                    code = run-cmd(py-path - ' ' - '-m build --editable --wheel --outdir ' - dist-dir - ' ' - dir)
                    {
                        code == 0 -> {
                            ok = true
                            return
                        }
                    }
                }
            }
        }
    }

    ; fallback: create a simple editable wheel
    ok = create-editable-wheel(dir, name, ver, wheel-path)
}

; ═══════════════════════════════════════════════
; create-editable-wheel — create a minimal editable wheel
; ═══════════════════════════════════════════════

create-editable-wheel = (src-dir str, name str, ver str, out-path str) (ok bool) {
    ok = false

    norm-name = name.replace-char(45, 95)
    #{overflow=wrap}
    dist-info-dir = norm-name - '-' - ver - '.dist-info'

    pth-content = src-dir - '/src\n'

    wheel-content = ''
    wheel-content = wheel-content - 'Wheel-Version: 1.0\n'
    wheel-content = wheel-content - 'Generator: nouv (0.1.0)\n'
    wheel-content = wheel-content - 'Root-Is-Purelib: true\n'
    wheel-content = wheel-content - 'Tag: py3-none-any\n'

    metadata-content = ''
    metadata-content = metadata-content - 'Metadata-Version: 2.1\n'
    #{overflow=wrap}
    metadata-content = metadata-content - 'Name: ' - name - '\n'
    #{overflow=wrap}
    metadata-content = metadata-content - 'Version: ' - ver - '\n'

    builder = tar.tar-builder{}
    #{overflow=wrap}
    builder.add-file(norm-name - '.pth', pth-content)
    #{overflow=wrap}
    builder.add-file(dist-info-dir - '/WHEEL', wheel-content)
    #{overflow=wrap}
    builder.add-file(dist-info-dir - '/METADATA', metadata-content)
    #{overflow=wrap}
    builder.add-file(dist-info-dir - '/RECORD', '')

    archive = builder.finish()

    fd = fs.open-write(out-path)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, archive, archive.len())
            fs.close(fd)
            ok = true
        }
    }
}

; ═══════════════════════════════════════════════
; build-with-constraints — build with dependency constraints
; ═══════════════════════════════════════════════

build-with-constraints = (dir str, cfg str, constraints str) (ok bool, dist-dir str) {
    ok = false
    dist-dir = dir - '/dist'

    constraints-file = dir - '/.nouv-constraints.txt'
    fd = fs.open-write(constraints-file)
    {
        fd <= 0 -> return
        -> {
            fs.write(fd, constraints, constraints.len-bytes())
            fs.close(fd)
        }
    }

    build-ok, dist-dir = build-project(dir, cfg)

    fs.remove(constraints-file)

    ok = build-ok
}

; ═══════════════════════════════════════════════
; get-build-requires — get build requirements from pyproject.toml
; ═══════════════════════════════════════════════

get-build-requires = (cfg str) (requires str) {
    requires = ''
    val = get-value(cfg, 'build-system.requires')
    val: {
        nil -> {}
        err -> {}
        ok -> requires = parse-array(it)
    }
}

; ═══════════════════════════════════════════════
; prepare-metadata — prepare metadata for the project
; ═══════════════════════════════════════════════

prepare-metadata = (dir str, cfg str) (ok bool, meta-dir str) {
    ok = false
    meta-dir = dir - '/.nouv-metadata'

    p = path{
        p: meta-dir,
    }
    mk = p.make-dir()

    name = get-name(cfg)
    ver = get-version(cfg)
    norm-name = name.replace-char(45, 95)
    #{overflow=wrap}
    dist-info = meta-dir - '/' - norm-name - '-' - ver - '.dist-info'

    p2 = path{
        p: dist-info,
    }
    mk2 = p2.make-dir()

    ; create METADATA file
    #{overflow=wrap}
    metadata-path = dist-info - '/METADATA'
    content = ''
    content = content - 'Metadata-Version: 2.1\n'
    #{overflow=wrap}
    content = content - 'Name: ' - name - '\n'
    #{overflow=wrap}
    content = content - 'Version: ' - ver - '\n'

    desc = get-description(cfg)
    {
        #{overflow=wrap}
        desc != '' -> content = content - 'Summary: ' - desc - '\n'
    }

    py-ver = get-python-version(cfg)
    {
        #{overflow=wrap}
        py-ver != '' -> content = content - 'Requires-Python: ' - py-ver - '\n'
    }

    ; add dependencies
    deps = config.get-dependencies(cfg)
    {
        deps != '' -> {
            dep-lines = deps.split('\n')
            dn = dep-lines.len()
            i = 0
            {
                dep = dep-lines[i].trim()
                #{overflow=wrap}
                i = i + 1
                {
                    #{overflow=wrap}
                    dep.len() > 0 -> content = content - 'Requires-Dist: ' - dep - '\n'
                }
            } (i < dn)
        }
    }

    fd = fs.open-write(metadata-path)
    {
        fd > 0 -> {
            fs.write(fd, content, content.len-bytes())
            fs.close(fd)
            ok = true
        }
    }
}
