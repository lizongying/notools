; run-all.no — Run all nouv tests
; Usage: no run nouv/tests/run-all.no
;
; This is the test runner that executes all test files in the tests/ directory.
;
; The `no` compiler is located in this order:
;   1. $NO_BIN   (absolute path to the `no` binary)
;   2. `no` as found on $PATH

print('╔══════════════════════════════════════════════╗')
print('║         nouv Test Suite                      ║')
print('║  Pure Nolang implementation of uv           ║')
print('╚══════════════════════════════════════════════╝')
print('')

; ── locate the compiler ──────────────────────────────
no-bin = 'no'
env-bin = os.get-env('NO_BIN')
env-bin: {
    ok -> {
        v str = it
        v != '' -> no-bin = v
    }

    -> {
    }
}

probe = process {}
probe.start(no-bin, '--version')
probe.wait()
probe-code = probe.exit-code-of()
{
    probe-code != 0 -> {
        print('error: cannot execute the `no` compiler (tried "{no-bin}")')
        print('')
        print('Set NO_BIN=/absolute/path/to/no, or put `no` on PATH.')
        exit(1)
    }
}
print('compiler: {no-bin}')
print('')

; ── locate the tests directory ───────────────────────
; Allow NOUV_TESTS_DIR override; otherwise try the common layouts so the
; runner works whether it is invoked from nouv/ or from the repo root.
tests-dir str = ''
dir-ok = false
env-dir ?str = os.get-env('NOUV_TESTS_DIR')
env-dir: {
    ok -> {
        v str = it
        v != '' -> {
            d = path {
                p: v
            }
            d.exists() -> {
                tests-dir = v
                dir-ok = true
            }
        }
    }

    -> {
    }
}

dir-ok == false -> {
    c1 = path {
        p: 'tests'
    }
    c1.exists() -> {
        tests-dir = 'tests'
        dir-ok = true
    }

    dir-ok == false -> {
        c2 = path {
            p: 'nouv/tests'
        }
        c2.exists() -> {
            tests-dir = 'nouv/tests'
            dir-ok = true
        }
    }
}
dir-ok == false -> {
    print('error: cannot locate the tests/ directory')
    print('')
    print('Run from the nouv/ directory, or set NOUV_TESTS_DIR=/path/to/nouv/tests.')
    exit(1)
}
print('tests dir: {tests-dir}')
print('')

; ── test list ────────────────────────────────────────
tests = 'test-version.no\ntest-pep508.no\ntest-wheel.no\ntest-toml.no\ntest-markers.no\ntest-cache.no\ntest-venv.no\ntest-python.no\ntest-installer.no\ntest-registry.no\ntest-registry-json.no\ntest-jsonx-edge.no\ntest-sdist.no\ntest-lockfile.no\ntest-httpclient.no\ntest-init-e2e.no\n'

total-pass = 0
total-fail = 0
n-tests = 0
failed-files = ''

lines = tests.split('\n')
n = lines.len()
i <- [0..n): {

    raw-file ?str = lines[i]
    test-file = ''
    raw-file: {
        ok -> {
            v str = it
            test-file = v.trim()
        }

        -> {
        }
    }
    {
        test-file.len() > 0 -> {

            #{overflow=wrap}
            nt = n-tests + 1: {
                ok -> it

                -> _
            }
            n-tests = nt
            print('──────────────────────────────────────────────')
            print('Running: {test-file}')
            print('──────────────────────────────────────────────')

            ; resolve each test relative to the located tests dir
            test-path = tests-dir - '/' - test-file

            p = process {}
            p.start(no-bin, 'run ' - test-path)
            p.wait()

            exit-code = p.exit-code-of()
            out, n2 = p.read-all()

            print(out)

            {
                exit-code == 0 -> {

                    #{overflow=wrap}
                    npass = total-pass + 1: {
                        ok -> it

                        -> _
                    }
                    total-pass = npass
                }

                -> {

                    #{overflow=wrap}
                    nfail = total-fail + 1: {
                        ok -> it

                        -> _
                    }
                    total-fail = nfail
                    failed-files = failed-files - '  ' - test-file - '\n'
                }
            }
        }
    }
}

print('')
print('╔══════════════════════════════════════════════╗')
print('║  Test Suite Summary                          ║')
print('╚══════════════════════════════════════════════╝')
print('Tests run:     {n-tests}')
print('Tests passed:  {total-pass}')
print('Tests failed:  {total-fail}')

{
    total-fail > 0 -> {
        print('')
        print('Failed suites:')
        print(failed-files)
        exit(1)
    }

    -> {
        print('')
        print('All tests passed!')
    }
}
