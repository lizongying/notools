; run-all.no — Run all nouv tests
; Usage: no run nouv/tests/run-all.no
;
; This is the test runner that executes all test files in the tests/ directory.
;
; The `no` compiler is located in this order:
;   1. $NO_BIN   (absolute path to the `no` binary)
;   2. `no` as found on $PATH

main = () {
    print('╔══════════════════════════════════════════════╗')
    print('║         nouv Test Suite                      ║')
    print('║  Pure Nolang implementation of uv           ║')
    print('╚══════════════════════════════════════════════╝')
    print('')

    ; ── locate the compiler ──────────────────────────────
    no-bin = 'no'
    env-bin = os.get-env('NO_BIN')
    {
        env-bin != '' -> no-bin = env-bin
    }

    probe = process {}
    probe.start(no-bin, '--version')
    probe.wait()
    probe-code = probe.exit-code-of()
    {
        probe-code != 0 -> {
            print('error: cannot execute the `no` compiler (tried "{no-bin}")')
            print('')
            print('Set NO_BIN=/absolute/path/to/no, or put `no` on PATH.')
            os.exit(1)
        }
    }
    print('compiler: {no-bin}')
    print('')

    ; ── locate the tests directory ───────────────────────
    ; Allow NOUV_TESTS_DIR override; otherwise try the common layouts so the
    ; runner works whether it is invoked from nouv/ or from the repo root.
    tests-dir = os.get-env('NOUV_TESTS_DIR')
    dir-ok = false
    {
        tests-dir != '' -> {
            d = path { p: tests-dir }
            d.exists() -> dir-ok = true
        }

        -> {
            c1 = path { p: 'tests' }
            c1.exists() -> {
                tests-dir = 'tests'
                dir-ok = true
            }

            dir-ok == false -> {
                c2 = path { p: 'nouv/tests' }
                c2.exists() -> {
                    tests-dir = 'nouv/tests'
                    dir-ok = true
                }
            }
        }
    }
    dir-ok == false -> {
        print('error: cannot locate the tests/ directory')
        print('')
        print('Run from the nouv/ directory, or set NOUV_TESTS_DIR=/path/to/nouv/tests.')
        os.exit(1)
    }
    print('tests dir: {tests-dir}')
    print('')

    ; ── test list ────────────────────────────────────────
    tests = 'test-version.no\ntest-pep508.no\ntest-wheel.no\ntest-toml.no\ntest-markers.no\ntest-cache.no\ntest-venv.no\ntest-python.no\ntest-installer.no\ntest-registry.no\ntest-registry-json.no\ntest-sdist.no\ntest-lockfile.no\ntest-httpclient.no\ntest-init-e2e.no\n'

    total-pass = 0
    total-fail = 0
    n-tests = 0
    failed-files = ''

    lines = tests.split('\n')
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=zero}
        test-file = lines[i]
        test-file = test-file.trim()
        {
            test-file.len() > 0 -> {

                #{overflow=wrap}
                n-tests = n-tests + 1
                print('──────────────────────────────────────────────')
                print('Running: {test-file}')
                print('──────────────────────────────────────────────')

                ; resolve each test relative to the located tests dir
                test-path = tests-dir - '/' - test-file

                p = process {}
                p.start(no-bin, 'run ' - test-path)
                p.wait()

                exit-code = p.exit-code-of()
                out, n2 = p.read-all()

                print(out)

                {
                    exit-code == 0 -> {

                        #{overflow=wrap}
                        total-pass = total-pass + 1
                    }

                    -> {

                        #{overflow=wrap}
                        total-fail = total-fail + 1
                        failed-files = failed-files - '  ' - test-file - '\n'
                    }
                }
            }
        }

        #{overflow=wrap}
        i = i + 1
    }

    print('')
    print('╔══════════════════════════════════════════════╗')
    print('║  Test Suite Summary                          ║')
    print('╚══════════════════════════════════════════════╝')
    print('Tests run:     {n-tests}')
    print('Tests passed:  {total-pass}')
    print('Tests failed:  {total-fail}')

    {
        total-fail > 0 -> {
            print('')
            print('Failed suites:')
            print(failed-files)
            os.exit(1)
        }

        -> {
            print('')
            print('All tests passed!')
        }
    }
}
