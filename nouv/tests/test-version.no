; test-version.no — Version comparison and PEP 440 tests
; Tests: version parsing, comparison, normalization
; Run: no run nouv/test/test-version.no
;
; Mirrors uv's version comparison tests

# /nouv/src/version

main = () {
    print('--- Testing version operations ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: parse simple version
    ma, mi, pa, pre = version.parse('1.0.0')
    {
        ma == 1 && mi == 0 && pa == 0 && pre == '' -> {
            print('PASS: parse 1.0.0')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse 1.0.0 (ma={ma}, mi={mi}, pa={pa}, pre={pre})')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: parse complex version
    ma2, mi2, pa2, pre2 = version.parse('3.12.7')
    {
        ma2 == 3 && mi2 == 12 && pa2 == 7 -> {
            print('PASS: parse 3.12.7')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse 3.12.7 (ma={ma2}, mi={mi2}, pa={pa2})')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: compare versions - equal
    cmp1 = version.compare('1.0.0', '1.0.0')
    {
        cmp1 == 0 -> {
            print('PASS: compare equal')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: compare equal (got {cmp1})')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: compare versions - less than
    cmp2 = version.compare('1.0.0', '2.0.0')
    {
        cmp2 < 0 -> {
            print('PASS: compare less than')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: compare less than (got {cmp2})')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: compare versions - greater than
    cmp3 = version.compare('2.0.0', '1.0.0')
    {
        cmp3 > 0 -> {
            print('PASS: compare greater than')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: compare greater than (got {cmp3})')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: compare different minor versions
    cmp4 = version.compare('3.11.0', '3.12.0')
    {
        cmp4 < 0 -> {
            print('PASS: compare 3.11 < 3.12')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: compare 3.11 < 3.12 (got {cmp4})')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: compare different patch versions
    cmp5 = version.compare('3.12.6', '3.12.7')
    {
        cmp5 < 0 -> {
            print('PASS: compare 3.12.6 < 3.12.7')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: compare 3.12.6 < 3.12.7 (got {cmp5})')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: is-prerelease
    pre1 = version.is-prerelease('1.0.0a1')
    {
        pre1 -> {
            print('PASS: is-prerelease true for 1.0.0a1')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: is-prerelease should be true for 1.0.0a1')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: is-prerelease false for stable
    pre2 = version.is-prerelease('1.0.0')
    {
        pre2 == false -> {
            print('PASS: is-prerelease false for 1.0.0')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: is-prerelease should be false for 1.0.0')
            n-fail = n-fail + 1
        }
    }

    ; Test 10: normalize with 'v' prefix
    norm1 = version.normalize('v1.2.3')
    {
        norm1 == '1.2.3' -> {
            print('PASS: normalize v1.2.3 -> {norm1}')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: normalize v1.2.3 (got {norm1})')
            n-fail = n-fail + 1
        }
    }

    ; Test 11: normalize 1.2 -> 1.2.0
    norm2 = version.normalize('1.2')
    {
        norm2 == '1.2.0' -> {
            print('PASS: normalize 1.2 -> {norm2}')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: normalize 1.2 (got {norm2})')
            n-fail = n-fail + 1
        }
    }

    ; Test 12: normalize with V prefix
    norm3 = version.normalize('V2.0.0')
    {
        norm3 == '2.0.0' -> {
            print('PASS: normalize V2.0.0 -> {norm3}')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: normalize V2.0.0 (got {norm3})')
            n-fail = n-fail + 1
        }
    }

    ; Test 13: current version
    cur = version.current()
    {
        cur == '0.1.0' -> {
            print('PASS: current version')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: current version (got {cur})')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}
