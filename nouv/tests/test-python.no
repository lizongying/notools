; test-python.no — Python version management tests
; Tests: find, install, list, pin, resolve-version, platform detection
; Run: no run nouv/test/test-python.no
;
; Mirrors uv's tests/python/*.rs

# /nouv/src/python

main = () {
    print('--- Testing Python version management ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: find-system-python
    ; 需要本机存在可运行的 python3；若不存在则跳过（与 test-venv 一致）
    sys-path = ''
    sys-ok = false
    sys-path-opt = python.find-system-python()
    sys-path-opt: {
        ok -> {
            sys-path = it
            sys-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        sys-ok && sys-path != '' -> {
            print('PASS: find-system-python')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('SKIP: find-system-python (no runnable system Python)')
        }
    }

    ; Test 2: find-python with empty version (any)
    py-path = ''
    py-ok = false
    py-path-opt2 = python.find-python('')
    py-path-opt2: {
        ok -> {
            py-path = it
            py-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        py-ok && py-path != '' -> {
            print('PASS: find-python (any)')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: find-python (any)')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 3: detect-platform
    plat = python.detect-platform()
    {
        plat == 'x86_64-macos' || plat == 'aarch64-macos' || plat == 'x86_64-linux' || plat == 'aarch64-linux' -> {
            print('PASS: detect-platform ({plat})')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: detect-platform (got {plat})')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 4: get-python-dir
    py-dir = python.get-python-dir()
    {
        py-dir.contains('python') && py-dir.contains('/') -> {
            print('PASS: get-python-dir')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: get-python-dir (got {py-dir})')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 5: pin-version and get-pinned-version
    test-dir = '/tmp/nouv-test-py-' - os.now-ms().to-str()
    p = path {
        p: test-dir
    }
    mk = p.make-dir()

    pin-ok = python.pin-version(test-dir, '3.12.7')
    {
        pin-ok -> {
            print('PASS: pin-version')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: pin-version')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 6: get-pinned-version returns the pinned version
    pinned-ver = ''
    pinned-found = false
    pinned-ver-opt3 = python.get-pinned-version(test-dir)
    pinned-ver-opt3: {
        ok -> {
            pinned-ver = it
            pinned-found = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        pinned-found -> {
            pinned-ver == '3.12.7' -> {
                print('PASS: get-pinned-version')

                #{overflow=wrap}
                n-pass = n-pass + 1
            }

            -> {
                print('FAIL: get-pinned-version (got {pinned-ver})')

                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }

        -> {
            print('FAIL: get-pinned-version returned nil')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 7: get-pinned-version returns nil when no pin file
    no-pin-ver = ''
    no-pin-found = false
    no-pin-ver-opt4 = python.get-pinned-version('/tmp')
    no-pin-ver-opt4: {
        ok -> {
            no-pin-ver = it
            no-pin-found = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        no-pin-found -> {
            print('FAIL: get-pinned-version should return nil without pin')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        -> {
            print('PASS: get-pinned-version returns nil when no pin')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }
    }

    ; Test 8: resolve-version with full version
    full-ver = ''
    resolve-ok = false
    full-ver-opt5 = python.resolve-version('3.12.7')
    full-ver-opt5: {
        ok -> {
            full-ver = it
            resolve-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        resolve-ok && full-ver == '3.12.7' -> {
            print('PASS: resolve-version (full)')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: resolve-version (full) got {full-ver}')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 9: resolve-version with partial version
    partial-ver = ''
    partial-ok = false
    partial-ver-opt6 = python.resolve-version('3.12')
    partial-ver-opt6: {
        ok -> {
            partial-ver = it
            partial-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        partial-ok && partial-ver.starts-with('3.12.') -> {
            print('PASS: resolve-version (partial 3.12 -> {partial-ver})')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: resolve-version (partial 3.12)')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 10: resolve-version with major only
    major-ver = ''
    major-ok = false
    major-ver-opt7 = python.resolve-version('3')
    major-ver-opt7: {
        ok -> {
            major-ver = it
            major-ok = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        major-ok && major-ver.starts-with('3.') -> {
            print('PASS: resolve-version (major 3 -> {major-ver})')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: resolve-version (major 3)')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 11: get-available-versions
    available = python.get-available-versions()
    lines = available.split('\n')
    has-312 = false
    n = lines.len()
    i = 0
    (i < n) {

        #{index-out=0}
        line = lines[i]

        #{overflow=wrap}
        i = i + 1
        {
            line.trim() == '3.12.7' -> has-312 = true
        }
    }
    {
        has-312 -> {
            print('PASS: get-available-versions contains 3.12.7')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: get-available-versions missing 3.12.7')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 12: get-version-info from system python
    sys-path2 = ''
    sys-ok2 = false
    sys-path2-opt8 = python.find-system-python()
    sys-path2-opt8: {
        ok -> {
            sys-path2 = it
            sys-ok2 = true
        }

        nil -> {
        }

        err -> {
        }
    }
    {
        sys-ok2 -> {
            ver, impl = python.get-version-info(sys-path2)
            {
                ver.starts-with('3.') && impl == 'CPython' -> {
                    print('PASS: get-version-info')

                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }

                -> {
                    print('FAIL: get-version-info (ver={ver}, impl={impl})')

                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }

        -> {
            print('SKIP: get-version-info (no system python)')
        }
    }

    ; Test 13: is-version-installed for a non-installed version
    installed = python.is-version-installed('0.0.0')
    {
        ! installed -> {
            print('PASS: is-version-installed false for uninstalled')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: is-version-installed should be false')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; cleanup
    p2 = process {}
    p2.start('rm', '-rf ' - test-dir)
    p2.wait()

    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}
