; test-toml.no — TOML parsing tests
; Tests: parse pyproject.toml, get values, parse arrays
; Run: no run nouv/test/test-toml.no
;
; Mirrors uv's pyproject.toml parsing tests

# /nouv/src/ptoml

main = () {
    print('--- Testing TOML parsing ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: parse simple toml
    toml-content = '[project]\nname = "myproject"\nversion = "1.0.0"\n'
    cfg = ptoml.parse(toml-content)
    {
        cfg != nil -> {
            print('PASS: parse simple toml')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: parse simple toml')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 2: get-value for name
    name-val = ptoml.get-value(cfg, 'project.name')
    name-val: {
        ok -> {
            it == 'myproject' -> {
                print('PASS: get-value project.name')

                #{overflow=wrap}
                n-pass = n-pass + 1
            }

            -> {
                print('FAIL: get-value project.name (got {it})')

                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }

        -> {
            print('FAIL: get-value project.name returned nil')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 3: get-value for version
    ver-val = ptoml.get-value(cfg, 'project.version')
    ver-val: {
        ok -> {
            it == '1.0.0' -> {
                print('PASS: get-value project.version')

                #{overflow=wrap}
                n-pass = n-pass + 1
            }

            -> {
                print('FAIL: get-value project.version (got {it})')

                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }

        -> {
            print('FAIL: get-value project.version returned nil')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 4: parse build-system
    toml2 = '[build-system]\nrequires = ["setuptools>=61.0", "wheel"]\nbuild-backend = "setuptools.build_meta"\n'
    cfg2 = ptoml.parse(toml2)
    {
        cfg2 != nil -> {
            print('PASS: parse build-system')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: parse build-system')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 5: get-value build-backend
    backend-val = ptoml.get-value(cfg2, 'build-system.build-backend')
    backend-val: {
        ok -> {
            it == 'setuptools.build_meta' || it == '"setuptools.build_meta"' -> {
                print('PASS: get-value build-backend')

                #{overflow=wrap}
                n-pass = n-pass + 1
            }

            -> {
                print('FAIL: get-value build-backend (got {it})')

                #{overflow=wrap}
                n-fail = n-fail + 1
            }
        }

        -> {
            print('FAIL: get-value build-backend returned nil')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 6: parse-array
    req-val = ptoml.get-value(cfg2, 'build-system.requires')
    req-val: {
        ok -> {
            arr = ptoml.parse-array(it)
            {
                arr.contains('setuptools') && arr.contains('wheel') -> {
                    print('PASS: parse-array')

                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }

                -> {
                    print('FAIL: parse-array (got {arr})')

                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }

        -> {
            print('FAIL: get-value requires returned nil')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 7: get-value for non-existent key
    missing = ptoml.get-value(cfg, 'project.description')
    missing: {
        ok -> {
            print('FAIL: get-value should fail for missing key')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }

        -> {
            print('PASS: get-value nil for missing key')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }
    }

    ; Test 8: parse with dependencies
    toml3 = '[project]\nname = "myproject"\nversion = "1.0.0"\ndependencies = ["requests>=2.0", "flask"]\n'
    cfg3 = ptoml.parse(toml3)
    {
        cfg3 != nil -> {
            print('PASS: parse with dependencies')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: parse with dependencies')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 9: parse-array for dependencies
    deps-val = ptoml.get-value(cfg3, 'project.dependencies')
    deps-val: {
        ok -> {
            deps = ptoml.parse-array(it)
            {
                deps.contains('requests') && deps.contains('flask') -> {
                    print('PASS: parse-array for dependencies')

                    #{overflow=wrap}
                    n-pass = n-pass + 1
                }

                -> {
                    print('FAIL: parse-array for dependencies (got {deps})')

                    #{overflow=wrap}
                    n-fail = n-fail + 1
                }
            }
        }

        -> {
            print('FAIL: get-value dependencies returned nil')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 10: parse [[array-of-tables]] — multiple instances kept distinct
    toml4 = '[[tool.uv.index]]\nname = "pypi"\nurl = "https://pypi.org/simple"\n[[tool.uv.index]]\nname = "private"\nurl = "https://example.com/simple"\n'
    cfg4 = ptoml.parse(toml4)
    alen = ptoml.array-length(cfg4, 'tool.uv.index')
    {
        alen == 2 -> {
            print('PASS: array-length [[tool.uv.index]] == 2')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: array-length [[tool.uv.index]] (got {alen})')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 11: get-array-value reads each instance field independently
    v0 = ptoml.get-array-value(cfg4, 'tool.uv.index', 0, 'name')
    v1 = ptoml.get-array-value(cfg4, 'tool.uv.index', 1, 'url')
    ok0 = false
    s0 = ''
    v0: {
        ok -> {
            s0 = it

            it == 'pypi' -> ok0 = true
        }

        nil ->

        err ->
    }
    ok1 = false
    s1 = ''
    v1: {
        ok -> {
            s1 = it

            it.contains('example.com') -> ok1 = true
        }

        nil ->

        err ->
    }
    {
        ok0 && ok1 -> {
            print('PASS: get-array-value per instance')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: get-array-value per instance (v0={s0} v1={s1})')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    ; Test 12: serialize round-trips array-of-tables as [[...]] headers
    ser4 = ptoml.serialize(cfg4)
    {
        ser4.contains('[[tool.uv.index]]') -> {
            print('PASS: serialize emits [[tool.uv.index]]')

            #{overflow=wrap}
            n-pass = n-pass + 1
        }

        -> {
            print('FAIL: serialize missing [[tool.uv.index]] (got {ser4})')

            #{overflow=wrap}
            n-fail = n-fail + 1
        }
    }

    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}
