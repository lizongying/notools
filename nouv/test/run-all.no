; run-all.no — Run all nouv tests
; Usage: no run nouv/test/run-all.no
;
; This is the test runner that executes all test files in the test/ directory.

main = () {
    print('╔══════════════════════════════════════════════╗')
    print('║         nouv Test Suite                      ║')
    print('║  Pure Nolang implementation of uv           ║')
    print('╚══════════════════════════════════════════════╝')
    print('')

    tests = 'test-version.no\ntest-pep508.no\ntest-wheel.no\ntest-toml.no\ntest-markers.no\ntest-cache.no\ntest-venv.no\ntest-python.no\ntest-installer.no\ntest-registry.no\ntest-sdist.no'

    total-pass = 0
    total-fail = 0
    n-tests = 0

    lines = tests.split('\n')
    n = lines.len
    i = 0
    for i < n {
        test-file = lines[i]
        i = i + 1
        test-file = test-file.trim()
        {
            test-file.len > 0 -> {
                n-tests = n-tests + 1
                print('──────────────────────────────────────────────')
                print('Running: {test-file}')
                print('──────────────────────────────────────────────')

                ; Run the test using process
                p = process{}
                p.start('no', 'run ' - test-file)
                p.wait()

                exit-code = p.exit-code-of()
                out, n2 = p.read-all()

                ; Print test output
                print(out)

                {
                    exit-code == 0 -> {
                        ; extract pass/fail from output
                        total-pass = total-pass + 1
                    }
                    -> {
                        total-fail = total-fail + 1
                    }
                }
            }
        }
    }

    print('')
    print('╔══════════════════════════════════════════════╗')
    print('║  Test Suite Summary                          ║')
    print('╚══════════════════════════════════════════════╝')
    print('Tests run:     {n-tests}')
    print('Tests passed:  {total-pass}')
    print('Tests failed:  {total-fail}')

    {
        total-fail > 0 -> {
            print('')
            print('Some tests failed. See output above.')
            os.exit(1)
        }
        -> {
            print('')
            print('All tests passed!')
        }
    }
}
