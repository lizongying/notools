; test-markers.no — Environment marker tests
; Tests: platform detection, Python version, OS markers
; Run: no run nouv/test/test-markers.no
;
; Mirrors uv's PEP 508 marker evaluation tests

# /nouv/src/markers

main = () {
    print('--- Testing environment markers ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: get-platform-system
    sys = markers.get-platform-system()
    {
        sys == 'Darwin' || sys == 'Linux' || sys == 'Windows' -> {
            print('PASS: get-platform-system ({sys})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-platform-system (got {sys})')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: get-platform-machine (architecture)
    arch = markers.get-platform-machine()
    {
        arch == 'x86_64' || arch == 'arm64' || arch == 'aarch64' || arch == 'AMD64' -> {
            print('PASS: get-platform-machine ({arch})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-platform-machine (got {arch})')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: get-python-version
    py-ver = markers.get-python-version()
    {
        py-ver.starts-with('3.') -> {
            print('PASS: get-python-version ({py-ver})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-python-version (got {py-ver})')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: get-sys-platform
    sys-plat = markers.get-sys-platform()
    {
        sys-plat == 'darwin' || sys-plat == 'linux' || sys-plat == 'win32' -> {
            print('PASS: get-sys-platform ({sys-plat})')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-sys-platform (got {sys-plat})')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}
