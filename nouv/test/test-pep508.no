; test-pep508.no — PEP 508 requirement parsing tests
; Tests: parse requirements with extras, markers, version specs
; Run: no run nouv/test/test-pep508.no
;
; Mirrors uv's PEP 508 parser tests

# /nouv/src/pep508
# /nouv/src/dependency

main = () {
    print('--- Testing PEP 508 requirement parsing ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: simple package name
    name, ver-spec, extras = pep508.parse('requests')
    {
        name == 'requests' && ver-spec == '' -> {
            print('PASS: parse simple name')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse simple name (name={name}, spec={ver-spec})')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: package with exact version
    name2, spec2, extras2 = pep508.parse('requests==2.31.0')
    {
        name2 == 'requests' && spec2 == '==2.31.0' -> {
            print('PASS: parse exact version')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse exact version (name={name2}, spec={spec2})')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: package with >= version
    name3, spec3, extras3 = pep508.parse('flask>=2.0')
    {
        name3 == 'flask' && spec3 == '>=2.0' -> {
            print('PASS: parse >= version')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse >= version (name={name3}, spec={spec3})')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: package with extras
    name4, spec4, extras4 = pep508.parse('celery[redis]==5.3.0')
    {
        name4 == 'celery' && spec4 == '==5.3.0' && extras4 == 'redis' -> {
            print('PASS: parse extras')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse extras (name={name4}, spec={spec4}, extras={extras4})')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: package with multiple extras
    name5, spec5, extras5 = pep508.parse('celery[redis,auth]==5.3.0')
    {
        name5 == 'celery' && extras5.contains('redis') && extras5.contains('auth') -> {
            print('PASS: parse multiple extras')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse multiple extras (extras={extras5})')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: package with version range
    name6, spec6, extras6 = pep508.parse('django>=4.0,<5.0')
    {
        name6 == 'django' && spec6.contains('>=4.0') && spec6.contains('<5.0') -> {
            print('PASS: parse version range')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse version range (spec={spec6})')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: package with marker
    name7, spec7, extras7 = pep508.parse('importlib-metadata; python_version<"3.8"')
    {
        name7 == 'importlib-metadata' -> {
            print('PASS: parse with marker')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse with marker (name={name7})')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: normalized package name (uppercase)
    name8, spec8, extras8 = pep508.parse('Flask')
    {
        name8 == 'Flask' || name8 == 'flask' -> {
            print('PASS: parse uppercase name')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse uppercase name (got {name8})')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: package with ~= operator
    name9, spec9, extras9 = pep508.parse('pytest~=7.0')
    {
        name9 == 'pytest' && spec9.contains('7.0') -> {
            print('PASS: parse ~= operator')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse ~= operator (spec={spec9})')
            n-fail = n-fail + 1
        }
    }

    ; Test 10: package with != operator
    name10, spec10, extras10 = pep508.parse('django!=4.0.0')
    {
        name10 == 'django' && spec10.contains('!=4.0.0') -> {
            print('PASS: parse != operator')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse != operator (spec={spec10})')
            n-fail = n-fail + 1
        }
    }

    ; Test 11: URL requirement
    name11, spec11, extras11 = pep508.parse('mypackage @ https://example.com/mypackage-1.0.tar.gz')
    {
        name11 == 'mypackage' || name11 == 'mypackage @ https://example.com/mypackage-1.0.tar.gz' -> {
            print('PASS: parse URL requirement')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse URL requirement (name={name11})')
            n-fail = n-fail + 1
        }
    }

    ; Test 12: dependency.parse-requirement returns 3 values
    dep-name, dep-spec, dep-extras = dependency.parse-requirement('requests==2.31.0')
    {
        dep-name == 'requests' -> {
            print('PASS: dependency.parse-requirement')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: dependency.parse-requirement (name={dep-name})')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}
