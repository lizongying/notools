; test-wheel.no — Wheel format parsing tests
; Tests: filename parsing, metadata parsing, entry points, compatibility
; Run: no run nouv/test/test-wheel.no
;
; Mirrors uv's wheel-related unit tests

# /nouv/src/wheel

main = () {
    print('--- Testing wheel operations ---')
    n-pass = 0
    n-fail = 0

    ; Test 1: get-name-version from wheel filename
    name, ver = wheel.get-name-version('requests-2.31.0-py3-none-any.whl')
    {
        name == 'requests' && ver == '2.31.0' -> {
            print('PASS: get-name-version')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-name-version (name={name}, ver={ver})')
            n-fail = n-fail + 1
        }
    }

    ; Test 2: get-name-version with underscore name
    name2, ver2 = wheel.get-name-version('my_package-1.0.0-py3-none-any.whl')
    {
        name2 == 'my-package' && ver2 == '1.0.0' -> {
            print('PASS: get-name-version (underscore)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-name-version (underscore) got name={name2} ver={ver2}')
            n-fail = n-fail + 1
        }
    }

    ; Test 3: is-wheel
    {
        wheel.is-wheel('foo-1.0.whl') && wheel.is-wheel('bar-2.0-py3-none-any.whl') -> {
            print('PASS: is-wheel')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: is-wheel')
            n-fail = n-fail + 1
        }
    }

    ; Test 4: is-wheel false for non-wheel
    {
        wheel.is-wheel('foo-1.0.tar.gz') == false -> {
            print('PASS: is-wheel false for non-wheel')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: is-wheel should be false for .tar.gz')
            n-fail = n-fail + 1
        }
    }

    ; Test 5: get-python-tag
    tag = wheel.get-python-tag('requests-2.31.0-py3-none-any.whl')
    {
        tag == 'py3' -> {
            print('PASS: get-python-tag')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-python-tag (got {tag})')
            n-fail = n-fail + 1
        }
    }

    ; Test 6: is-compatible for py3 wheel
    {
        wheel.is-compatible('requests-2.31.0-py3-none-any.whl') -> {
            print('PASS: is-compatible (py3-none-any)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: is-compatible (py3-none-any)')
            n-fail = n-fail + 1
        }
    }

    ; Test 7: is-compatible for py2.py3 wheel
    {
        wheel.is-compatible('foo-1.0-py2.py3-none-any.whl') -> {
            print('PASS: is-compatible (py2.py3-none-any)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: is-compatible (py2.py3-none-any)')
            n-fail = n-fail + 1
        }
    }

    ; Test 8: parse-metadata
    meta-content = 'Metadata-Version: 2.1\nName: requests\nVersion: 2.31.0\nSummary: Python HTTP for Humans.\nRequires-Python: >=3.7\n'
    meta, meta-ok = wheel.parse-metadata(meta-content)
    {
        meta-ok && meta.contains('name=requests') && meta.contains('version=2.31.0') -> {
            print('PASS: parse-metadata')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse-metadata (ok={meta-ok}, meta={meta})')
            n-fail = n-fail + 1
        }
    }

    ; Test 9: parse-wheel-file
    wheel-content = 'Wheel-Version: 1.0\nGenerator: setuptools\nRoot-Is-Purelib: true\n'
    winfo, winfo-ok = wheel.parse-wheel-file(wheel-content)
    {
        winfo-ok && winfo.contains('wheel-version=1.0') -> {
            print('PASS: parse-wheel-file')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse-wheel-file (ok={winfo-ok}, info={winfo})')
            n-fail = n-fail + 1
        }
    }

    ; Test 10: parse-entry-points
    ep-content = '[console_scripts]\nmyapp=myapp.cli:main\nmyworker=myapp.worker:run\n'
    eps = wheel.parse-entry-points(ep-content)
    {
        eps.contains('console_scripts:myapp=myapp.cli:main') && eps.contains('console_scripts:myworker=myapp.worker:run') -> {
            print('PASS: parse-entry-points')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse-entry-points (got {eps})')
            n-fail = n-fail + 1
        }
    }

    ; Test 11: parse-entry-points with gui_scripts
    ep-content2 = '[gui_scripts]\nmygui=myapp.gui:main\n'
    eps2 = wheel.parse-entry-points(ep-content2)
    {
        eps2.contains('gui_scripts:mygui=myapp.gui:main') -> {
            print('PASS: parse-entry-points (gui_scripts)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: parse-entry-points (gui_scripts)')
            n-fail = n-fail + 1
        }
    }

    ; Test 12: get-name-version with multi-part name
    name3, ver3 = wheel.get-name-version('zope.interface-6.0-py3-none-any.whl')
    {
        name3 == 'zope.interface' && ver3 == '6.0' -> {
            print('PASS: get-name-version (multi-part name)')
            n-pass = n-pass + 1
        }
        -> {
            print('FAIL: get-name-version (multi-part) got name={name3} ver={ver3}')
            n-fail = n-fail + 1
        }
    }

    print('')
    print('Results: {n-pass} passed, {n-fail} failed')
    {
        n-fail > 0 -> os.exit(1)
    }
}
