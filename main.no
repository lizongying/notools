// main.no — Unix utilities dispatcher
// Entry point: routes subcommands to utility implementations
// Usage: no run main.no <command> [args]

# /src/echo.echo-run
# /src/cat.cat-run
# /src/ls.ls-run
# /src/rm.rm-run
# /src/tree.tree-run
# /src/mv.mv-run
# /src/touch.touch-run
# /src/find.find-run
# /src/grep.grep-run
# /src/wc.wc-run
# /src/sort.sort-run
# /src/uniq.uniq-run
# /src/sed.sed-run
# /src/awk.awk-run
# /src/chmod.chmod-run
# /src/tar.tar-run
# /src/zip.zip-run
# /src/unzip.unzip-run
# /src/ps.ps-run
# /src/top.top-run

print-usage = () {
    print('Usage: no run main.no <command> [args]')
    print('')
    print('Commands:')
    print('  echo    Print arguments to stdout')
    print('  cat     Concatenate and print file contents')
    print('  ls      List directory contents')
    print('  rm      Remove files or directories')
    print('  tree    Display directory tree')
    print('  mv      Move or rename files')
    print('  touch   Create empty files or update timestamps')
    print('  find    Recursively search for files')
    print('  grep    Search for patterns in files')
    print('  wc      Count lines, words, and bytes')
    print('  sort    Sort lines alphabetically')
    print('  uniq    Remove duplicate consecutive lines')
    print('  sed     Stream editor for text replacement')
    print('  awk     Pattern scanning and field extraction')
    print('  chmod   Change file permissions')
    print('  tar     Create and extract tar archives')
    print('  zip     Create zip archives')
    print('  unzip   Extract zip archives')
    print('  ps      List running processes')
    print('  top     Display system processes')
}

argc = args()

{
    argc < 2 -> {
        print-usage()
        os.exit(1)
    }
}

cmd = arg(1)

{
    cmd == 'echo' -> echo.echo-run()
    cmd == 'cat' -> cat.cat-run()
    cmd == 'ls' -> ls.ls-run()
    cmd == 'rm' -> rm.rm-run()
    cmd == 'tree' -> tree.tree-run()
    cmd == 'mv' -> mv.mv-run()
    cmd == 'touch' -> touch.touch-run()
    cmd == 'find' -> find.find-run()
    cmd == 'grep' -> grep.grep-run()
    cmd == 'wc' -> wc.wc-run()
    cmd == 'sort' -> sort.sort-run()
    cmd == 'uniq' -> uniq.uniq-run()
    cmd == 'sed' -> sed.sed-run()
    cmd == 'awk' -> awk.awk-run()
    cmd == 'chmod' -> chmod.chmod-run()
    cmd == 'tar' -> tar.tar-run()
    cmd == 'zip' -> zip.zip-run()
    cmd == 'unzip' -> unzip.unzip-run()
    cmd == 'ps' -> ps.ps-run()
    cmd == 'top' -> top.top-run()
    -> {
        print('Unknown command: ' - cmd)
        print-usage()
        os.exit(1)
    }
}