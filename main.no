// main.no — Unix utilities dispatcher
// Entry point: routes subcommands to utility implementations
// Usage: no run main.no <command> [args]

# /src/echo.echo-run
# /src/cat.cat-run
# /src/ls.ls-run
# /src/rm.rm-run
# /src/tree.tree-run
# /src/mv.mv-run
# /src/touch.touch-run

print-usage = () {
    print('Usage: no run main.no <command> [args]')
    print('')
    print('Commands:')
    print('  echo    Print arguments to stdout')
    print('  cat     Concatenate and print file contents')
    print('  ls      List directory contents')
    print('  rm      Remove files or directories')
    print('  tree    Display directory tree')
    print('  mv      Move or rename files')
    print('  touch   Create empty files or update timestamps')
}

// Entry point
argc = args()

{
    argc < 2 -> {
        print-usage()
        os.exit(1)
    }
}

cmd = arg(1)

{
    cmd == 'echo' -> echo.echo-run()
    cmd == 'cat' -> cat.cat-run()
    cmd == 'ls' -> ls.ls-run()
    cmd == 'rm' -> rm.rm-run()
    cmd == 'tree' -> tree.tree-run()
    cmd == 'mv' -> mv.mv-run()
    cmd == 'touch' -> touch.touch-run()
    -> {
        print('Unknown command: ' - cmd)
        print-usage()
        os.exit(1)
    }
}