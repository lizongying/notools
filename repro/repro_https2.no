; repro_https2.no — test http.get HTTPS with os.exit(0)

main = () {
    print('main started')
    io.errln('main stderr test')
    resp = http.do('GET', 'https://127.0.0.1:18443/', '')
    print('do returned')
    resp: {
        nil -> {
            print('resp is nil')
            os.exit(1)
        }
        err -> {
            print('resp is err')
            os.exit(1)
        }
        ok -> {
            print('status=' - it.status-code.to-str())
            body = it.body
            print('HTTPS body len=' - body.len.to-str())
            os.exit(0)
        }
    }
}
